PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>

SELECT DISTINCT ?website ?boost_graph
WHERE {
    ?dataset <http://dataid.dbpedia.org/ns/core#group> <http://kg.artsdata.ca/databus/capacoa/artsdata-planet-boost> .
    ?dataset prov:wasDerivedFrom ?website .
    ?boost_graph prov:wasDerivedFrom/foaf:primaryTopic ?dataset .
}
GROUP BY ?website ?boost_graph