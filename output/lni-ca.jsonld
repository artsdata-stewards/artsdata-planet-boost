    "https://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "Le cours qui vous intéresse est complet ? Inscrivez-vous sur notre LISTE D'ATTENTE Cours | Adultes Cours | Enfants & ados Calendrier Cours | Adultes EXPÉRIENCE REQUISE : Avoir une expérience de base en impro ou avoir complété le niveau 1 Fonce, fige, fuis. Ce sont les 3 grandes familles de réaction face à n’importe"
      }
    ],
