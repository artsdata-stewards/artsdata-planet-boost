    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Bienvenue en Patagonie, terre de légendes où montagnes, lacs et glaciers tissent un paysage envoûtant. Chaque pas est une aventure vers l'inconnu, chaque souffle, une ode à la liberté."
      }
