      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "À travers le regard de Yohann Brichet, voyagez dans le temps en partant à la rencontre de la culture amérindienne, en découvrant les vestiges de la colonisation jusqu'à la création de la base spatiale européenne qui dessine l'avenir de la Guyane."
      }
    ],
