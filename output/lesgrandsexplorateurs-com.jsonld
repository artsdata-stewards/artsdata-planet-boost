  {
    "@id": "https://lesgrandsexplorateurs.com/programmation/tokyo/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Tokyo au pays des extrêmes | Les Grands Explorateurs"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "On l’appelle le pays du Soleil-Levant, un nom qui fait souvent rêver. Pourtant, derrière cette étiquette, que de facettes à découvrir… Le Japon est multiple, tout en nuances. De Tokyo aux villages de la campagne profonde, des codes culturels à l’âme nippone, ce film vous dévoile une image du Japon que vous êtes loin de soupçonner."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://lesgrandsexplorateurs.com/programmation/tokyo/"
