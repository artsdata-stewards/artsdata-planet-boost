    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le documentaire de Cyril Isy-Schwart célèbre la beauté de la Normandie, des jardins de Giverny aux falaises d'Étretat, tout en honorant son histoire et son artisanat."
      }
    ],
