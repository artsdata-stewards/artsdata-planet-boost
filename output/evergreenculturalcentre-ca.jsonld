    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Coquitlam Bike &amp; Climb Show"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><span style='font-family: arial, helvetica, sans-serif; color: #000000;'><strong><span style='font-size: 12pt;'><span style='font-size: 14pt;'>COQUITLAM BIKE &amp; CLIMB SHOW<br /></span>Presented by the Vancouver International Mountain Film Festival</span></strong></span></p> <p><strong><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>ABOUT THE SHOW<br /></span></strong><strong><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><span style='font-weight: 400;'>Adventure changes,&nbsp;<em>but</em> the drive to explore remains. Adventure doesn’t stay the same forever. This program explores how adventure evolves across generations, disciplines, and life stages. From chasing podiums to raising kids on big walls and returning to wild places with longtime partners, these films reflect how commitment, curiosity, and purpose deepen over time.</p> <p><strong>ABOUT THE VANCOUVER INTERNATIONAL MOUNTAIN FILM FESTIVAL<br /></strong></span></span></strong><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><span style='font-weight: 400;'>The VIMFF connects our global outdoor community with international filmmakers, creators and speakers, so that we can inspire, entertain and bring mountain adventure into the homes of our viewers. We offer mountain film screenings, live multimedia presentations, photography exhibitions, workshops, seminars &amp; other special events. We invite you to join us throughout the year, as we continue to celebrate and embrace mountain film and culture, outdoor sports and environmental initiatives.</span></span><strong><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><span style='font-weight: 400;'><strong></p> <p></strong></span></span></strong></p> <p><strong style='color: #000000; font-family: arial, helvetica, sans-serif; font-size: 12pt;'>SINGLE TICKETS ON SALE!<br /></strong><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Adult: $32 | Senior &amp; Student: $30</span></p> <hr> <p><em>This is a rental event organized by VIMFF.</em></p> <p><!-- wp:pattern {'slug':'ajde_events/blocks'} /--></p> "
      }
    ],
