    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/bamming-2026/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://evergreenculturalcentre.ca/wp-content/uploads/2025/11/Arts-Education-Web-Size.png"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
