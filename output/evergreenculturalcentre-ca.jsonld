  {
    "@id": "https://evergreenculturalcentre.ca/theatre-series/event_34448_5",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/the-golden-anniversaries/var/ri-5.l-L1"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://evergreenculturalcentre.ca/wp-content/uploads/2025/04/Screenshot-2025-04-23-at-2.37.43 PM.png"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1657800"
