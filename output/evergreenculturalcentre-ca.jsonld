      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/pro-tools-recording/var/ri-2.l-L1"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "CANCELLED | Pro-Tools Recording for Voice Overs"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<h4><span style='font-family: arial, helvetica, sans-serif;'><span style='color: #000000;'><b><span style='color: #ff0000;'>CANCELLED |</span> PRO-TOOLS RECORDING FOR VOICE OVERS<br /><span style='font-size: 12pt;'>with Educator Pamela Hammond</span><br /></b></span></span></h4> <p class='p1'><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><span style='color: #ff0000;'>Unfortunately, this event has been cancelled.</span></span></p> <hr> <p class='p1'><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><br /><strong>Both the Intro To Voice Over Announcing/Acting and Advanced Voice Over Acting are a PREREQUISITE for this class.</strong></span></p> <p class='p1'><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Students must have a laptop, download the free version of Pro-Tools from the Avid website, have a microphone, interface and headphones. This course covers how to set up Pro-Tools, recording formats, editing, timing, how to send files using different formats.<span class='Apple-converted-space'>&nbsp;</span></span></p> <h4><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><strong>CLASS INFORMATION&nbsp;<br /></strong></span><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Mondays at 6:15PM | $165.00 per person<br /></span><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><span style='color: #000000; font-family: arial, helvetica, sans-serif;'><span style='font-size: 16px;'>January 12 &#8211; February 2, 2026</span></span></span></h4> <hr> <h4><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><strong>ABOUT OUR EDUCATOR<br /></strong></span><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>In 1998 Pamela got her start in voice acting by chance, voicing a short commercial for Global TV. Since then, she has voiced Internationally for TV &amp; Radio Commercials, Animation&nbsp;&amp; Gaming, Jingles, Narration &amp; Documentaries, Corporate Presentations, E-Learning, Social Media Ads and On Hold Messaging. In addition to voice acting, she has also produced spots with a few co-writing credits.<br /></span></h4> <h4><span style='color: #000000; font-family: arial, helvetica, sans-serif;'><span style='font-size: 16px;'><strong>REGISTER ONLINE OR AT THE BOX OFFICE:</strong><br /></span></span><span style='color: #000000; font-family: arial, helvetica, sans-serif; font-size: 12pt;'><strong>604.927.6555 | Open Monday – Saturday, 12 – 5PM<br /></strong><strong><br /></strong></span></h4> <p><!-- wp:pattern {'slug':'ajde_events/blocks'} /--></p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-1-26T18:15-7::00"
      }
