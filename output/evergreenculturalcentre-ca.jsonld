    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g9269900"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/young-singers-september-2025/"
