  {
    "@id": "https://evergreenculturalcentre.ca/2019-20-entertain/event_34657_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/solidaridad-tango/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://evergreenculturalcentre.ca/wp-content/uploads/2025/05/BoliMedia_SolidaridadWSarah-Col-1-scaled.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g15342920"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://evergreenculturalcentre.ca/2019-20-entertain/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Solidaridad Tango"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<h4><strong><span style='color: #000000;'>SOLIDARIDAD TANGO<br /></span></strong></h4> <div class='ewa-rteLine'> <div class='ewa-rteLine'> <p class='ewa-rteLine'><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Canada&#8217;s all-women ensemble, <strong>Solidaridad Tango</strong>, mesmerizes audiences with their evocative program of passionate rhythms and captivating melodies. Delve into the soul-stirring world of tango as these talented musicians transport you through the streets of Buenos Aires with their electrifying performance to the musical impact this style has made on a global level. Led by violinist and founder Aparna Halpé, the ensemble consists of voice with the instrumental support associated with the sounds of tango ringing through crowds and dancers. As UK’s Songlines magazine states, they are “packed with passion, oozing with originality, and played with perfection&#8230;musicians unafraid of boundaries.” Let your body and soul sway with the power and grace of female musicianship in this unforgettable music and movement.</span></p> </div> </div> <div class='ewa-rteLine'>&nbsp;</div> <hr> <p><span style='color: #000000; font-family: arial, helvetica, sans-serif;'><span style='font-size: 16px;'><strong>SINGLE TICKETS ON SALE!</strong><br /></span></span><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Adults: $43 | Seniors: $39 | Students: $16</span></p> <p><span style='color: #000000; font-family: arial, helvetica, sans-serif; font-size: 12pt;'><strong>BOX OFFICE: 604.927.6555 | Open Monday – Saturday, 12 – 5PM</strong></span></p> <p><!-- wp:pattern {'slug':'ajde_events/blocks'} /--></p> "
      }
    ],
