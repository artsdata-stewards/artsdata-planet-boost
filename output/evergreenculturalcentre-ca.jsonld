  {
    "@id": "https://evergreenculturalcentre.ca/events/stagekidz-2025/event_35309_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/stagekidz-2025/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://evergreenculturalcentre.ca/wp-content/uploads/2025/11/main-kidz-classes-1080.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g9552540"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g9552580"
