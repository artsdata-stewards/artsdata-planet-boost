  {
    "@id": "https://evergreenculturalcentre.ca/events/merry-heistmas-2025/event_35268_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/merry-heistmas-2025/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://evergreenculturalcentre.ca/wp-content/uploads/2025/10/PianoHeist-Heistmas-Evergreen-square-thumbnail-no-date.png"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g2491700"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/merry-heistmas-2025/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Piano Heist: A Very Merry Heistmas"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><strong><span style='font-size: 14pt;'>A VERY MERRY HEISTMAS</span></strong><br /><strong><span style='font-size: 14pt;'>PIANO HEIST</span></strong><br /></span></p> <p class='elementToProof'><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><b>Piano Heist</b>&nbsp;returns with a dazzling new holiday production: <b><i>A Very Merry Heistmas! </i></b>A festive romp through Christmas classics interlaced with their own brand of musical and comedic shenanigans, Nico Rhodes &amp; Patrick Courtin tackle everything “Christmas”. Whether it’s the nostalgic charm of Charlie Brown Christmas, a rock &amp; roll styled Nutcracker Suite; The Messiah on melodicas, or a rollicking ragtime Rudolph the Red Nose Reindeer, get ready for a holiday experience that’s truly one-of-a-kind! Bring your festive spirit and prepare to sing-a-long for A Very Merry Heistmas!</span></p> <div> <hr> <p><strong><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>TICKETS ON SALE!</span></strong><strong><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><br /></span></strong><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Adults: $46 | Seniors: $42 | Students: $18</span></p> </div> <p><em>This is a rental event organized by Piano Heist.</em></p> <p><!-- wp:pattern {'slug':'ajde_events/blocks'} /--></p> "
      }
    ],
