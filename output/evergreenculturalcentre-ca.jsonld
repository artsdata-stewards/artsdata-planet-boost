  {
    "@id": "https://evergreenculturalcentre.ca/events/stage-43-legally-blonde/var/event_34718_4",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/stage-43-legally-blonde/var/ri-4.l-L1"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://evergreenculturalcentre.ca/wp-content/uploads/2025/06/LEGALLY-BLONDE-v2-scaled.png"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1361380"
