  {
    "@id": "https://evergreenculturalcentre.ca/events/rhs-paco-ha/event_34706_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/rhs-paco-ha/"
