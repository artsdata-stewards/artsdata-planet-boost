  {
    "@id": "https://evergreenculturalcentre.ca/events/mike-battie/var/event_34685_1",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/mike-battie/var/ri-1.l-L1"
