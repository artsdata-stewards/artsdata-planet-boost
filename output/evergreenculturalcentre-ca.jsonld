  {
    "@id": "https://evergreenculturalcentre.ca/events/ian-maksin-new-album-release/event_35386_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/ian-maksin-new-album-release/"
      }
