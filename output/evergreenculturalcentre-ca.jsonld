  {
    "@id": "https://evergreenculturalcentre.ca/events/comic-storytelling/event_35526_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/comic-storytelling/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://evergreenculturalcentre.ca/wp-content/uploads/2025/12/Arnaktauyok-Homage-Comic-Folger-1-scaled.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g10391060"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/comic-storytelling/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Art of Comic Storytelling"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><strong><span style='color: #000000; font-family: arial, helvetica, sans-serif;'><span style='font-size: 14pt;'><i>THE ART OF COMIC STORYTELLING<br /> </i></span><span style='font-size: 16px;'>with Napatsi Folger</span></span></strong></p> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Join Inuk comic artist, <strong>Napatsi Folger</strong>, and explore your creativity using colour and patterns in her collage comic-making workshop. Inspired by the compositions and striking patterns of Sharni Pootoogook&#8217;s work, Folger will discuss how integral storytelling is to Inuit art and how to integrate visual art techniques into telling strong stories through comics.</span></p> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Age 13+ | Free to attend, pre-registration required.<br /> Image courtesy of Napatsi Folger.</span></p> <p><strong><span style='font-family: arial, helvetica, sans-serif;'><span style='font-size: 12pt; color: #000000;'>ABOUT THE EXHIBITION&nbsp;<br /> </span></span></strong><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>On tour from the Kelowna Art Gallery, this exhibition celebrates the life and work of <strong>Sharni Pootoogook</strong> (1922-2003), whose bold and balanced ink-on-paper drawings blur the boundaries between human and animal, spiritual and visceral. Pootoogook’s work draws clear connections between first-generation artists in Kinngait and the current trends in Inuit graphic art. </span></p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-2-7T14:00-7::00"
      }
