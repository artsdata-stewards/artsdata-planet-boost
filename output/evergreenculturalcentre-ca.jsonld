  {
    "@id": "https://evergreenculturalcentre.ca/events/mm-invocations/event_34689_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/mm-invocations/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://evergreenculturalcentre.ca/wp-content/uploads/2023/06/1-6.png"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g747080"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/mm-invocations/"
