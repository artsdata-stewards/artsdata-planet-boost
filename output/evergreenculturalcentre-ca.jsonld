        "@id": "https://evergreenculturalcentre.ca/events/valdy/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://evergreenculturalcentre.ca/wp-content/uploads/2025/05/Valdy-Press-Pic-HiRez.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g8965140"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/valdy/"
