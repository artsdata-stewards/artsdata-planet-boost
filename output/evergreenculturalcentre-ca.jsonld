    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Dogan Music Ensemble"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><strong><span style='font-size: 18.6667px;'>DOGAN MUSIC ENSEMBLE &#8211; LIVE IN CONCERT<br /></span></strong><br /></span><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>A multicultural music performance featuring flamenco, Middle Eastern, and contemporary fusion pieces. The ensemble brings an energetic and emotional program with guitar, percussion, vocals, and dance.</span></p> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><strong>SINGLE TICKETS ON SALE!<br /></strong>All tickets $40</span></p> <hr> <p><em>This is a rental event organized by Amirsalar Abdolhai.</em></p> <p><!-- wp:pattern {'slug':'ajde_events/blocks'} /--></p> "
      }
    ],
