        "@id": "_:g10372440"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g10372480"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/moving-mirror-people-sing-cabaret/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Do You Hear the People Sing?: A Broadway Cabaret"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><span style='font-family: arial, helvetica, sans-serif; color: #000000;'><strong><span style='font-size: 14pt;'>DO YOU HEAR THE PEOPLE SING?: A BROADWAY CABARET<br /></span><span style='font-size: 12pt;'>Presented by Moving Mirror Productions</span></strong></span></p> <p><strong><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>ABOUT THE SHOW<br /></span></strong><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Moving Mirror Production Proudly Presents &#8220;Do You Hear the People Sing? A Broadway Cabaret&#8221;.</span></p> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Join us for our annual celebration of musical theatre. Proceeds from the evening will support the Junior Broadway Programs at Moving Mirror Productions. The evening will feature performances by local actors and musicians, a silent auction, and the ever popular &#8220;Wine Wall&#8221;.</span></p> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>This year we celebrate our 10th Anniversary. Following our performance there will be a catered dessert reception in the theatre lobby, featuring a selection of cakes, sweets, and coffee/tea. All included in your ticket price!</span></p> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><strong>SINGLE TICKETS ON SALE!<br /></strong>Adults: $50 | Under 12: $45</span></p> <hr> <p><em>This is a rental event organized by Moving Mirror Productions.</em></p> <p><!-- wp:pattern {'slug':'ajde_events/blocks'} /--></p> "
      }
    ],
