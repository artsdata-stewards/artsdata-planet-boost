      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g6933780"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/flower-power-summer-2025/var/ri-2.l-L1"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Flower Power Half-Day Camp"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><span style='color: #000000;'><b><span style='font-size: 12pt;'>FLOWER POWER HALF-DAY CAMP<br /></span><span style='font-size: 12pt;'>August 11 &#8211; 15, 2025 | 1:30PM &#8211; 5PM | $175</span></b></span></p> <p><span style='font-size: 12pt; color: #000000;'><b>Ages: 6 &#8211; 8 | </b></span><span style='font-size: 12pt; color: #000000;'><b>Educators: Cyd</b></span></p> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Unleash your creativity at our Flower Power Half-Day Camp! Dive into the beauty of nature as you explore the world of flowers and plants through art. From vibrant flower collages and prints to making your own flowerpots, jewelry, and floral embroidery, you&#8217;ll create stunning botanical-inspired pieces. Learn about local and global artists who use nature as their muse and put your own spin on it with hands-on projects like floral still life paintings and bouquets. Let the natural world inspire your imagination and bring your Flower Power creations to life!</span></p> <p><span style='font-size: 12pt; color: #000000;'><b>EVERGREEN BOX OFFICE: 604-927-6555</b>&nbsp;</span><br /><span style='font-size: 12pt; color: #000000;'><b>Open Monday – Friday | 12 – 5pm</p> <p></b></span></p> <hr> <div>&nbsp;</div> <div><span style='font-size: 14pt; color: #000000;'><strong><span style='font-family: arial, helvetica, sans-serif;'>Refund/Withdrawal Policy&nbsp;&nbsp;</span></strong></span></div> <div><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>All withdrawals and refund requests must be made 14 days prior to the program start date. </span><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Withdrawals and refund requests made within 14 days of the program start date may not be eligible for a full refund.&nbsp;&nbsp;</span></div> <div>&nbsp;</div> <div><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>*Exceptions for medical or compassionate reasons may be considered upon receipt of a written request submitted at least 24 hours prior to the start date of the camp to&nbsp; <span style='color: #339966;'><u><a id='OWAfc9bdbf3-3e41-5310-9014-3dcbfc543b57' class='x_OWAAutoLink' style='color: #339966;' title='mailto:tatiana@evergreenculturalcentre.ca' href='mailto:tatiana@evergreenculturalcentre.ca' data-linkindex='0' data-outlook-id='a03e9593-efca-44b3-b530-e4f1fc63889e'>tatiana@evergreenculturalcentre.ca</a></u> </span>or <u><a id='OWA6f03482a-574b-781c-add7-6bebcf52aa0b' class='x_OWAAutoLink' style='color: #000000;' title='mailto:boxoffice@evergreenculturalcentre.ca' href='mailto:boxoffice@evergreenculturalcentre.ca' data-linkindex='1' data-outlook-id='b635d444-62d6-4bce-bb9c-184d7abbf40b'><span style='color: #339966;'>boxoffice@evergreenculturalcentre.ca</span></a></u>. A medical certificate may be required. Upon approval, a refund of the class fee will be granted.&nbsp;&nbsp;&nbsp;</span></div> <p><!-- wp:pattern {'slug':'ajde_events/blocks'} /--></p> "
      }
    ],
