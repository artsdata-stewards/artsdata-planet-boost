    "http://schema.org/headline": [
      {
        "@language": "en",
        "@value": "Evergreen Arts Camps"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "EVERGREEN ARTS CAMPSOur unique arts camps offer visual arts, performing arts, and hybrid camps for creative kids ages 6-14. Campers will get to try visual arts mediums like painting, sculpting, and drawing, performing arts skills like acting, dancing, and time spent visiting the Art Gallery at Evergreen and beautiful"
      }
    ]
  },
  {
    "@id": "https://evergreenculturalcentre.ca/events/llama-art-camp/event_35446_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/llama-art-camp/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://evergreenculturalcentre.ca/wp-content/uploads/2019/07/DSC_0936.jpg"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/llama-art-camp/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Llama Art Camp"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><span style='color: #000000;'><b><span style='font-size: 18.6667px;'>LLAMA ART CAMP: A HYBRID ARTS ADVENTURE!<br /></span><span style='font-size: 12pt;'>MARCH 16 &#8211; 20, 2026 | 9AM &#8211; 4PM | $285<br />AGE 6 &#8211; 8</span></b></span></p> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Calling all young artists and performers! Join us for a fun-filled week of creativity at Llama Art Camp, where imagination runs wild and little hands make big masterpieces.</span></p> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>In the morning, they’ll explore the colorful world of llamas through painting, drawing, and whimsical craft projects inspired by these friendly, woolly creatures.</span></p> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>In the afternoon, the fun continues with an all-animal theme, where movement, music, and storytelling bring a menagerie of creatures to life through playful performing arts activities.</span></p> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Through hands-on artmaking, creative games, and imaginative performances, kids will build confidence, make new friends, and discover the joy of expressing themselves in many different ways.</span></p> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Let your child’s creativity gallop free at Llama Art Camp—a perfect introduction to the world of art, imagination, and performance for ages 6–8!</span></p> <p><span style='font-size: 12pt; color: #000000;'><b>EVERGREEN BOX OFFICE: 604-927-6555</b>&nbsp;</span><br /><span style='font-size: 12pt; color: #000000;'><b>Open Monday – Friday | 12 – 5pm</p> <p></b></span></p> <hr> <div>&nbsp;</div> <div><span style='font-size: 14pt; color: #000000;'><strong><span style='font-family: arial, helvetica, sans-serif;'>Refund/Withdrawal Policy&nbsp;&nbsp;</span></strong></span></div> <div><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>All withdrawals and refund requests must be made 14 days prior to the program start date. </span><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Withdrawals and refund requests made within 14 days of the program start date may not be eligible for a full refund.&nbsp;&nbsp;</span></div> <div>&nbsp;</div> <div><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>*Exceptions for medical or compassionate reasons may be considered upon receipt of a written request submitted at least 24 hours prior to the start date of the camp to&nbsp; <span style='color: #339966;'><u><a id='OWAfc9bdbf3-3e41-5310-9014-3dcbfc543b57' class='x_OWAAutoLink' style='color: #339966;' title='mailto:tatiana@evergreenculturalcentre.ca' href='mailto:tatiana@evergreenculturalcentre.ca' data-linkindex='0' data-outlook-id='a03e9593-efca-44b3-b530-e4f1fc63889e'>tatiana@evergreenculturalcentre.ca</a></u> </span>or <u><a id='OWA6f03482a-574b-781c-add7-6bebcf52aa0b' class='x_OWAAutoLink' style='color: #000000;' title='mailto:boxoffice@evergreenculturalcentre.ca' href='mailto:boxoffice@evergreenculturalcentre.ca' data-linkindex='1' data-outlook-id='b635d444-62d6-4bce-bb9c-184d7abbf40b'><span style='color: #339966;'>boxoffice@evergreenculturalcentre.ca</span></a></u>. A medical certificate may be required. Upon approval, a refund of the class fee will be granted.&nbsp;&nbsp;&nbsp;</span></div> <p><!-- wp:pattern {'slug':'ajde_events/blocks'} /--></p> "
      }
    ],
