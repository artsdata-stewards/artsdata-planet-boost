    ],
    "http://schema.org/image": [
      {
        "@id": "https://evergreenculturalcentre.ca/wp-content/uploads/2025/04/Screenshot-2025-04-23-at-2.37.43 PM.png"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1750500"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/the-golden-anniversaries/var/ri-4.l-L1"
