  {
    "@id": "https://evergreenculturalcentre.ca/theatre-subscriptions/event_34525_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/gunmetal-blues/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://evergreenculturalcentre.ca/wp-content/uploads/2025/05/GMB-logo-scaled.png"
      }
    ],
    "http://schema.org/location": [
