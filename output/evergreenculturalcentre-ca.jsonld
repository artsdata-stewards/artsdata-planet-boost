    ],
    "http://schema.org/image": [
      {
        "@id": "https://evergreenculturalcentre.ca/wp-content/uploads/2025/10/Blood-Wedding-Poster-Coquitlam-scaled.jpg"
      }
    ],
    "http://schema.org/location": [
