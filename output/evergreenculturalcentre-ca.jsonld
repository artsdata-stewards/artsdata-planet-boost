  {
    "@id": "https://evergreenculturalcentre.ca/educate/life-drawing/event_35437_1",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/adult-upcycled-fashion/var/ri-1.l-L1"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://evergreenculturalcentre.ca/wp-content/uploads/2025/11/Arts-Education-Web-Size-1.png"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g2643040"
