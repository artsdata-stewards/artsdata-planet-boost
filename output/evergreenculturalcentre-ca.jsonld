  {
    "@id": "https://evergreenculturalcentre.ca/events/sharni-pootoogook-tour/var/event_35394_1",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/sharni-pootoogook-tour/var/ri-1.l-L1"
