    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><span style='font-family: arial, helvetica, sans-serif; color: #000000;'><span style='color: #000000; font-family: arial, helvetica, sans-serif;'><strong><span style='font-size: 12pt;'><i>THE LEMANCZYK/GOLICKI.SARNECKI TRIP<br /></i></span><span style='font-size: 12pt;'>with Jaques Kuba Seguin</span></strong></span></span></p> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Experience the Lemanczyk/Golicki/Sarnecki Trio with Jacques Kuba Seguin at Evergreen on April 9, 2026.</span></p> <hr> <p><span style='color: #000000; font-family: arial, helvetica, sans-serif;'><span style='font-size: 16px;'><strong>SINGLE TICKETS ON SALE:</strong><br />All tickets just $30!<br /></span></span></p> <p><span style='color: #000000; font-family: arial, helvetica, sans-serif; font-size: 12pt;'><strong>BOX OFFICE: 604.927.6555 | Open Monday – Saturday, 12 – 5PM</strong></span></p> <p><em>This is a rental event organized by Polish Stores.</em></p> <p><!-- wp:pattern {'slug':'ajde_events/blocks'} /--></p> "
