    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><strong><span style='font-size: 14pt;'>COQUITLAM COMEDY CLASSIC</span></strong><br /><strong>Jokers Canada</strong></p> <p></span><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Canada’s best comedians return to Coquitlam. These events regularly sell out! Save money by purchasing online in advance.<strong></p> <p></strong></span><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><strong>SINGLE TICKETS ON SALE!<br /></strong>All tickets: $39.90 &#8211; $49.35</span></p> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><strong>19+ Event</strong> | </span><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>No refunds<br /></span><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Questions? Email: info@jokerscanada.ca</span></p> <hr> <p><em>This is a rental event organized by Jokers Canada.</em></p> <p><!-- wp:pattern {'slug':'ajde_events/blocks'} /--></p> "
