  {
    "@id": "https://evergreenculturalcentre.ca/events/where-have-all-the-buffalo-gone/event_34679_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/where-have-all-the-buffalo-gone/"
