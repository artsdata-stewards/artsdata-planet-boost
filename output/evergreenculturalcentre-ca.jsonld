  {
    "@id": "https://evergreenculturalcentre.ca/events/moving-mirror-people-sing-cabaret/event_35573_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/moving-mirror-people-sing-cabaret/"
      }
    ],
    "http://schema.org/image": [
