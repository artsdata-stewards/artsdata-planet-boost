  {
    "@id": "https://evergreenculturalcentre.ca/events/the-arrogant-worms-2026/event_34662_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/the-arrogant-worms-2026/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://evergreenculturalcentre.ca/wp-content/uploads/2025/05/Canadian-Famous-Promo01.png"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g8376860"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/the-arrogant-worms-2026/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Arrogant Worms"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<h4><strong><span style='color: #000000;'><i>THE ARROGANT WORMS</i><br /></span></strong></h4> <div class='ewa-rteLine'> <div class='ewa-rteLine'> <p class='ewa-rteLine'><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><span class='TextRun Highlight SCXW248805207 BCX0' lang='EN-CA' xml:lang='EN-CA' data-contrast='auto'><span class='NormalTextRun SCXW248805207 BCX0'><strong>The Arrogant Worms</strong> have spent over three decades making fun of a big dumb world. Their songs have been played on the radio, the internet, and in outer space (on the space shuttle Endeavour). The Worms began at Queen’s University in 1991 when some members of the student cabaret group, The Queen’s Players, started writing songs and sketches for the campus radio station CFRC. Soon the group became The Arrogant Worms (Chris Patterson, Mike McCormick, and Trevor Strong) who have since toured ceaselessly across Canada (and select other parts of the world), released 13 albums, and recorded with the Edmonton Symphony Orchestra. Their song, The Last Saskatchewan Pirate, has been covered by bands such as Captain Tractor and The Longest Johns, and their Happy Happy birthday song is a viral sensation with over one hundred million views of the various fan videos on YouTube. More than thirty years after they began, The Arrogant Worms continue to provide tuneful and silly escapism for everyone who needs it.</span></span></span></p> </div> </div> <div class='ewa-rteLine'>&nbsp;</div> <hr> <p><span style='color: #000000; font-family: arial, helvetica, sans-serif;'><span style='font-size: 16px;'><strong>SINGLE TICKETS ON SALE!</strong><br /></span></span><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Adults: $43 | Seniors: $39 | Students: $16</span></p> <p><span style='color: #000000; font-family: arial, helvetica, sans-serif; font-size: 12pt;'><strong>BOX OFFICE: 604.927.6555 | Open Monday – Saturday, 12 – 5PM</strong></span></p> <p><!-- wp:pattern {'slug':'ajde_events/blocks'} /--></p> "
      }
    ],
