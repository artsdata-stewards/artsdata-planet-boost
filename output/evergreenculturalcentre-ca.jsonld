  {
    "@id": "https://evergreenculturalcentre.ca/td-music-series/event_34643_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/winter-morning-walks/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://evergreenculturalcentre.ca/wp-content/uploads/2023/06/6-2.png"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g2589780"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://evergreenculturalcentre.ca/td-music-series/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Winter Morning Walks"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<h4><strong><span style='color: #000000;'><i>WINTER MORNING WALKS<br /></i>musica intima &amp; Trilogy</span></strong></h4> <p><span style='color: #000000; font-family: arial, helvetica, sans-serif;'><span style='font-size: 16px;'><b>ABOUT THE SHOW<br /></b></span></span></p> <div class='page' title='Page 10'> <div class='layoutArea'> <p class='column'><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Originally written as a song cycle for American soprano Dawn Upshaw, Maria Schneider’s <em>Winter Morning Walks</em> is based on poems by Ted Kooser—what he calls ‘postcards’, written as he battled depression on pre-dawn walks alone and with his wife. Vancouver- based composer and arranger Réjean Marois arranged the musical miniatures for vocal ensemble and trio.</span></p> <p class='column'><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>In this concert, <strong>musica intima</strong> will perform Marois&#8217; version of these haunting and beautiful pieces with Vancouver-based ensemble <strong>Triology</strong> (Jodi Prozinik, Miles Black and Bill Coon), and drummer Craig Scott.</span></p> </div> </div> <p><strong>&nbsp;</strong></p> <hr> <p><span style='color: #000000; font-family: arial, helvetica, sans-serif;'><span style='font-size: 16px;'><strong>SINGLE TICKETS ON SALE!</strong><br /></span></span><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Adults: $43 | Seniors: $39 | Students: $16</span></p> <p><span style='color: #000000; font-family: arial, helvetica, sans-serif; font-size: 12pt;'><strong>BOX OFFICE: 604.927.6555 | Open Monday – Saturday, 12 – 5PM</strong></span></p> <p><!-- wp:pattern {'slug':'ajde_events/blocks'} /--></p> "
      }
    ],
