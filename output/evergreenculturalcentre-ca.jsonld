    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Open Air Performance Series: Blow More"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<h4><span style='font-family: arial, helvetica, sans-serif;'><span style='color: #000000;'><b><span style='font-size: 14pt;'><i>BLOW MORE<br /> </i></span><span style='font-size: 12pt;'>Open Air Performance Series<i><br /> </i></span></b></span></span><b><i></i></b></h4> <div class='ewa-rteLine'> <div class='ewa-rteLine'> <div class='ewa-rteLine'> <div class='ewa-rteLine'> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>From&nbsp;<strong>July 7th – August 29th, 2025</strong>&nbsp;join us for a free, 1-hour performance <strong>every Monday to Friday at 6PM</strong> as part of our Open Air Performance Series. By expanding our arts experiences into Town Centre Park, we hope these events will excite our patrons and introduce us to new faces and Lake Lafarge lovers alike. Grab your picnic basket and enjoy a free professional concert in the park!</span></p> <p><i>The Evergreen Cultural Centre Society is supported by Port Coquitlam Community Foundation Theatre Society Legacy Fund.</i></p> <p>&nbsp;</p> </div> </div> </div> <div> <hr> </div> </div> <div> <p>&nbsp;</p> <p><strong><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>ABOUT THE ARTISTS</span></strong></p> </div> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><strong>Dragana</strong> is passionate about sharing her love of music with her family; she has taught both her husband and younger daughter to play the flute. Currently, she serves as the artistic director of the amateur flutists&#8217; ensemble <strong>Blow More</strong>&nbsp;at the Long &amp; McQuade Music Education Centre, and principal Flutist of Richmond Orchestra and Choir Assosciation.&nbsp;&nbsp;</span></p> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>An avid explorer of various music genres. Even though, being a classically trained flutist, she has composed electronic music for video productions and has a deep appreciation for Balkan folk music.&nbsp;</span></p> <p><span data-contrast='auto'> </span><span data-ccp-props='{}'>&nbsp;</span></p> <p><span data-ccp-props='{}'>&nbsp;</span></p> "
      }
    ],
