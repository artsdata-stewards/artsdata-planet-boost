      }
    ],
    "article:modified_time": [
      {
        "@language": "en-us",
        "@value": "2025-08-18T23:28:52+00:00"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-us",
        "@value": "https://evergreenculturalcentre.ca/wp-content/uploads/2025/05/IMG_1416.jpg"
      }
    ],
    "http://ogp.me/ns#image:width": [
      {
        "@language": "en-us",
        "@value": "2048"
      }
    ],
    "http://ogp.me/ns#image:height": [
