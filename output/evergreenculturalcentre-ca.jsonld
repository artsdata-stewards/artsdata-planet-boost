    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/abba-blahblahblah/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://evergreenculturalcentre.ca/wp-content/uploads/2025/05/TCD-ABBAblahblahblah-scaled.png"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g866240"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/abba-blahblahblah/"
