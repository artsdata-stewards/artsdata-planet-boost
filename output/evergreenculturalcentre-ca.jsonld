  {
    "@id": "https://evergreenculturalcentre.ca/rent-our-space/event_35386_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/ian-maksin-new-album-release/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://evergreenculturalcentre.ca/wp-content/uploads/2025/11/LLB-POSTER-ART.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g2433740"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g2433780"
