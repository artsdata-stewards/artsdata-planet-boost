  {
    "@id": "https://evergreenculturalcentre.ca/events/gunmetal-blues/var/event_34525_1",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/gunmetal-blues/var/ri-1.l-L1"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://evergreenculturalcentre.ca/wp-content/uploads/2025/05/GMB-logo-scaled.png"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1786860"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/gunmetal-blues/var/ri-1.l-L1"
