  {
    "@id": "https://evergreenculturalcentre.ca/educate/life-drawing/event_35433_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/pour-decisions-spring-2026/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://evergreenculturalcentre.ca/wp-content/uploads/2025/11/Arts-Education-Web-Size-2.png"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g2641360"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
