    "http://schema.org/image": [
      {
        "@id": "https://evergreenculturalcentre.ca/wp-content/uploads/2024/12/DSC_0050-Enhanced-NR-2-scaled.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g9646300"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/sharni-pootoogook-tour/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "&quot;Sharni Pootogook: Creatures, Shadows, and Dreams&quot; Exhibition Tours"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><strong><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><span style='font-size: 14pt;'><em>SHARNI POOTOOGOOK: CREATURES, SHADOWS, AND DREAMS</em> EXHIBITION TOUR<br /> </span></span><span style='color: #000000; font-family: arial, helvetica, sans-serif;'><span style='font-size: 16px;'>at the Art Gallery at Evergreen December 12 &amp; January 10 | 1PM</span></span></strong></p> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Join Curator Katherine Dennis and Assistant Curator Anna Be for a free, drop-in tour of&nbsp;<em>Sharni Pootoogook: Creatures, Shadows, and Dreams.&nbsp;</em></span><br /> <span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Free to attend, drop-ins welcome.</span></p> <p><strong><span style='font-family: arial, helvetica, sans-serif;'><span style='font-size: 12pt; color: #000000;'>ABOUT THE EXHIBITION&nbsp;</span></span></strong></p> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>On tour from the Kelowna Art Gallery, this exhibition celebrates the life and work of <strong>Sharni Pootoogook</strong> (1922-2003), whose bold and balanced ink-on-paper drawings blur the boundaries between human and animal, spiritual and visceral. Pootoogook’s work draws clear connections between first-generation artists in Kinngait and the current trends in Inuit graphic art. </span></p> "
      }
    ],
