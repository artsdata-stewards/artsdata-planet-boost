  {
    "@id": "https://evergreenculturalcentre.ca/events/pro-tools-recording/event_35070_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/pro-tools-recording/"
      }
