    ],
    "http://schema.org/location": [
      {
        "@id": "_:g9334600"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/funny-you-dont-look-autistic/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Funny, You Don&#039;t Look Autistic"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<h4><strong><span style='color: #000000;'><i>FUNNY, YOU DON&#8217;T LOOK AUTISTIC<br /></i>Presented by Green Thumb Theatre<br />Written by Michael McCreary<br /></span></strong></h4> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><em><strong>Funny, You Don’t Look Autistic</strong></em> is a theatrical adaptation of Michael’s autobiographical book of the same name, published in 2019 by Annick Press. The show blends Michael’s trademark deadpan delivery with Green Thumb’s history for bringing socially conscious theatre to the stage. The show will touch audiences deeply, while making them laugh out loud. Michael’s story is one of challenge, growth, and ultimately triumph. Michael McCreary is an autistic comedian, author, and TEDX speaker who has been performing stand-up comedy since age 13. He has performed stand-up shows and keynote speeches in every province in Canada, Yukon territory, and across the United States. He has been featured on The National and CBC Radio’s “Laugh Out Loud&#8221;.</span></p> <div class='ewa-rteLine'>&nbsp;</div> <hr> <p><span style='color: #000000; font-family: arial, helvetica, sans-serif;'><span style='font-size: 16px;'><strong>SINGLE TICKETS ON SALE!</strong><br /></span></span><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Adults: $43 | Seniors: $39 | Students: $16</span></p> <p><span style='color: #000000; font-family: arial, helvetica, sans-serif; font-size: 12pt;'><strong>BOX OFFICE: 604.927.6555 | Open Monday – Saturday, 12 – 5PM</strong></span></p> <p><!-- wp:pattern {'slug':'ajde_events/blocks'} /--></p> "
      }
    ],
