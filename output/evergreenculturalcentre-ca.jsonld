    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Erin Ilett Solo Concert"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<h3 class='mb-0'><span style='font-size: 14pt;'><strong><span style='font-family: arial, helvetica, sans-serif;'>ERIN ILETT SOLO CONCERT</span></strong></span></h3> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Experience an unforgettable evening with dazzling singer Erin Ilett, an award-winning vocalist known for her soulful voice and multi-genre artistry, blending jazz, pop, folk, classical, and rock. Each track highlights her dynamic range and emotional depth, presenting a one-of-a-kind experience that resonates with all. Don’t miss this chance to witness a talent that shines in every musical realm.</span></p> <hr> <p><strong><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>TICKETS ON SALE!</span></strong><br /><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Orchestra: $58 | Mezzanine: $38 | Upper Mezz: $38<br /></span><em>This is a rental event organized by Erin Ilett.</em></p> <p><!-- wp:pattern {'slug':'ajde_events/blocks'} /--></p> "
      }
    ],
