  {
    "@id": "https://evergreenculturalcentre.ca/theatre-subscriptions/event_34279_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/pump-boys-dinettes/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://evergreenculturalcentre.ca/wp-content/uploads/2025/03/pb-210-scaled.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g2612520"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
