    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Join Danny Mags, host of BINGPOT! Trivia, for an electric pub quiz you won't find anywhere else when BINGPOT! Trivia Royale comes to Evergreen!"
      },
