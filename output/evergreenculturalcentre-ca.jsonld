    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<div class='et_pb_module et_pb_text et_pb_text_1 et_pb_text_align_left et_pb_bg_layout_light'> <p class='et_pb_text_inner'><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><span style='font-size: 14pt;'><strong>FAMILY DAYS<br /> <span style='font-size: 12pt;'>at the Art Gallery at Evergreen</span></strong></span></span></p> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Discover the magic of light, texture, and experimentation in this creative family workshop inspired by the photographic and material-based works of Karen Zalamea. Families will begin with a guided gallery tour, exploring how Zalamea transforms everyday materials and natural elements, like light, water, and movement, into striking visual art. Then, in the studio, participants will experiment with simple image-making techniques to create their own artworks inspired by light, shadow, and pattern.</span><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>All ages welcome! </span></p> </div> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><strong>12PM + 2PM |&nbsp; Pre-Registration Required<br /> </strong><span style='font-size: 10pt; color: #808080;'>Our Family Days Programming is graciously supported by Century Group.</span></span></p> <hr> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><b>ABOUT THE CURRENT GALLERY EXHIBITION</b></span></p> <div class='et_pb_row et_pb_row_5'> <div class='et_pb_column et_pb_column_4_4 et_pb_column_6 et_pb_css_mix_blend_mode_passthrough et-last-child'> <div class='et_pb_module et_pb_text et_pb_text_6 et_pb_text_align_left et_pb_bg_layout_light et_multi_view__hover_selector'><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>The Art Gallery at Evergreen is pleased to present <em><strong>Every Surface Is a Shrine</strong></em>, which brings together a selection of photo-based works by <strong>Karen Zalamea</strong> that traces the shifting boundaries between material, memory and place. Rooted in a critical exploration of photography’s expanded possibilities, Zalamea’s practice reimagines the medium not only as an image-making tool but as a methodology of care, labour and cultural inquiry.</p> <p></span></div> <div><span style='font-family: arial, helvetica, sans-serif; font-size: 10pt;'>This exhibition is part of the Capture Photography Festival 2026 Selected Exhibition Program.</span></div> </div> </div> "
      }
