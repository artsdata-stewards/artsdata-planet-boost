  {
    "@id": "https://evergreenculturalcentre.ca/events/open-air-2025-yesenia-florez/event_34824_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/open-air-2025-yesenia-florez/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://evergreenculturalcentre.ca/wp-content/uploads/2025/06/Diseno-sin-titulo-3-Yesenia-Amado-Florez.png"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/open-air-2025-yesenia-florez/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Open Air Performance Series: Yesenia Florez"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<h4><span style='font-family: arial, helvetica, sans-serif;'><span style='color: #000000;'><b><span style='font-size: 14pt;'><i>YESENIA FLOREZ<br /> </i></span><span style='font-size: 12pt;'>Open Air Performance Series<i><br /> </i></span></b></span></span><b><i></i></b></h4> <div class='ewa-rteLine'> <div class='ewa-rteLine'> <div class='ewa-rteLine'> <div class='ewa-rteLine'> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>From&nbsp;<strong>July 7th – August 29th, 2025</strong>&nbsp;join us for a free, 1-hour performance <strong>every Monday to Friday at 6PM</strong> as part of our Open Air Performance Series. By expanding our arts experiences into Town Centre Park, we hope these events will excite our patrons and introduce us to new faces and Lake Lafarge lovers alike. Grab your picnic basket and enjoy a free professional concert in the park!</span></p> <p><i>The Evergreen Cultural Centre Society is supported by Port Coquitlam Community Foundation Theatre Society Legacy Fund.</i></p> <p>&nbsp;</p> </div> </div> </div> <div> <hr> </div> </div> <div> <p>&nbsp;</p> <p><strong><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>ABOUT THE ARTISTS</span></strong></p> </div> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><span class='TextRun SCXW260624747 BCX0' lang='EN-CA' xml:lang='EN-CA' data-contrast='auto'><span class='NormalTextRun SCXW260624747 BCX0'><strong>Yesenia Florez</strong> is a Colombian singer-songwriter based in Vancouver, blending her Andean roots with her migrant journey. Her music is a heartfelt fusion of Latin American folk rhythms and modern sounds, inspired by nostalgia, memory, and identity. Singing with just her voice and guitar, Yesenia shares stories of resilience, migration, and womanhood — drawing from her own path and those of many like her. </span></span></span></p> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><span class='TextRun SCXW260624747 BCX0' lang='EN-CA' xml:lang='EN-CA' data-contrast='auto'><span class='NormalTextRun SCXW260624747 BCX0'>Self-taught and deeply passionate, she creates music not just for entertainment, but </span><span class='NormalTextRun AdvancedProofingIssueV2Themed SCXW260624747 BCX0'>as a way to</span><span class='NormalTextRun SCXW260624747 BCX0'> connect, heal, and honor tradition. She has graced renowned stages such as the National Museum of Bogotá, the Luis A. Calvo Auditorium in Bucaramanga, various festivals in Vancouver and Colombia, as well as intimate </span><span class='NormalTextRun SpellingErrorV2Themed SCXW260624747 BCX0'>Sofar</span><span class='NormalTextRun SCXW260624747 BCX0'> Sounds sessions and personal gatherings with devoted listeners.</span></span><span class='EOP SCXW260624747 BCX0' data-ccp-props='{}'>&nbsp;</span></span></p> <p><span data-ccp-props='{}'>&nbsp;</span></p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
