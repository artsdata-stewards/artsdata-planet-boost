    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "2025 Coquitlam Youth Orchestra Holiday Concert"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Join the<span style='text-decoration: underline;'> <span style='color: #008000; text-decoration: underline;'><a style='color: #008000; text-decoration: underline;' href='https://coquitlamyouthorchestra.ca/'>Coquitlam Youth Orchestra</a></span></span> for a night of music to celebrate the holiday season!</span></p> <div> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><strong>Junior Orchestra</strong> | 11:30AM &#8211; 12PM&nbsp;<u></u><u></u></span></p> </div> <div> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><strong>Intermediate Orchestra</strong> | 12:45 &#8211; 1:30PM<u></u><u></u></span></p> </div> <div> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><strong>Senior Orchestra</strong> | 2:15 &#8211; 3:15PM</span></p> <hr> <p><strong><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>TICKETS ON SALE!</span></strong></p> <p><strong><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Single Performance</span></strong><br /><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Adults: $17 | Seniors &amp; Students: $12 | Under 4: Free!</span></p> <p><strong><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>2 Performances</span></strong><br /><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Adults: $25 | Seniors &amp; Students: $20 | Under 4: Free! </span></p> <p><strong><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>3 Performances<br /></span></strong><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Adults: $27 | Seniors &amp; Students: $22 | Under 4:Free!</span></p> </div> <p><em>This is a rental event organized by the Coquitlam Youth Orchestra.</em></p> <p><!-- wp:pattern {'slug':'ajde_events/blocks'} /--></p> "
      }
    ],
