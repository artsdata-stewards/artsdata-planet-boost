    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Rehearsal Hall Sessions: That&#039;s Gay! Comedy"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<h4><strong><span style='color: #000000;'><i>THAT&#8217;S GAY! COMEDY<br /></i>A Queer Stand-Up Comedy Show<br /></span></strong></h4> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><strong>ABOUT THE SHOW</strong><br />The always sold out queer comedy show, <strong>That&#8217;s Gay! Comedy</strong>, is making its way to Evergreen Cultural Centre for a night of comedy featuring the Lower Mainland’s funniest &amp; gayest comedians!</span></p> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>All are welcome – whether you&#8217;re queer, straight, questioning, or just drink oat milk because you&#8217;re lactose-intolerant&#8230; you don&#8217;t have to be queer to enjoy comedy by hilarious comedians who just so happen to be gay!</span></p> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><strong>ABOUT THE ARTISTS</strong><br /></span><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><strong>That’s Gay! Comedy</strong> started back in 2022 and has sold out almost every show since. Hosted by <strong>Erin Purghart</strong>, the show features Vancouver’s best comedians who just so happen to be queer. </span><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>That&#8217;s Gay! Comedy has been presented by Just For Laughs VANCOUVER, and featured in the Georgia Straight, The Tyee, The Ubyssey &amp; Vancouver Magazine.</span></p> <div>&nbsp;</div> <div>&nbsp;</div> <hr> <p><span style='color: #000000; font-family: arial, helvetica, sans-serif;'><span style='font-size: 16px;'><strong>SINGLE TICKETS ON SALE JULY 01!</strong><br /></span></span><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Adults &amp; Seniors: $25 | Students: $16</span></p> <p><span style='color: #000000; font-family: arial, helvetica, sans-serif; font-size: 12pt;'><strong>BOX OFFICE: 604.927.6555 | Open Monday – Saturday, 12 – 5PM</strong></span></p> <p><!-- wp:pattern {'slug':'ajde_events/blocks'} /--></p> "
      }
    ],
