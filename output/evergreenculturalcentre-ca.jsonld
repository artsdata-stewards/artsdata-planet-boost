  {
    "@id": "https://evergreenculturalcentre.ca/events/art-studio-happy-hour/var/event_35073_2",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/art-studio-happy-hour/var/ri-2.l-L1"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://evergreenculturalcentre.ca/wp-content/uploads/2025/08/Screenshot-2025-09-09-165611-1.png"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g9390140"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/art-studio-happy-hour/var/ri-2.l-L1"
