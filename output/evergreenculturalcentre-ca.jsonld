    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/intro-garment-making/var/ri-1.l-L1"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "CANCELLED | MAE Craft Studio: Introduction to Garment Making"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<h4><span style='font-family: arial, helvetica, sans-serif;'><span style='color: #000000;'><b><span style='font-size: 14pt;'><span style='color: #ff0000;'>CANCELLED</span> <span style='color: #ff0000;'>|</span> <i>INTRODUCTION TO GARMENT MAKING<br /></i></span><span style='font-size: 12pt;'>with MAE Craft Studio</span></b></span></span></h4> <p class='p1'><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #ff0000;'>Unfortunately this event has been cancelled.</span></p> <p class='p1'><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Get familiar with a sewing machine and learn the basic techniques to sew your first garment! This workshop is designed for beginners as well as more advanced makers that want to practice new techniques. Whether you’re new to sewing or want a refresher, our Instructor will guide you step-by-step through the process of making a zippered bag then proceed to sew a full garment. Choose from one of our essential garment projects: Tapered Trouser, Boxy Tee, Essential Skirt or Linen Short.</span></p> <h4><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><strong>CLASS INFORMATION&nbsp;<br /></strong></span><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><span style='color: #000000; font-family: arial, helvetica, sans-serif;'><span style='font-size: 16px;'>October 4 &amp; 11, 10AM &#8211; 4:30PM | Age 18+<br /></span></span></span><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>$375.00 per person, including all materials in your choice of colour, necessary notions (thread and elastic), use of tools and equipment, a printed instruction manual to take home, and a sewing pattern for the garment.</p> <p></span></h4> <hr> <h4><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><strong>ABOUT MAE STUDIOS<br /></strong></span><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Mae Studios is on a mission to provide a fostering art and a creative environment so everyone is inspired to create their own clothes/accessories while getting curious about our handmade history. We invite kids, teens and adults into the makers shoes. In honoring their vision, we honour the environment and get a glimpse into a hand-made future</span></h4> <h4><span style='color: #000000; font-family: arial, helvetica, sans-serif;'><span style='font-size: 16px;'><strong>REGISTER ONLINE OR AT THE BOX OFFICE:</strong><br /></span></span><span style='color: #000000; font-family: arial, helvetica, sans-serif; font-size: 12pt;'><strong>604.927.6555 | Open Monday – Saturday, 12 – 5PM<br /></strong><strong><br /></strong></span></h4> <p><!-- wp:pattern {'slug':'ajde_events/blocks'} /--></p> "
      }
    ],
