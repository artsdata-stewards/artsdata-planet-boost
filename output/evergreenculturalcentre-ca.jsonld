  {
    "@id": "https://evergreenculturalcentre.ca/events/stage-43-misery/var/event_34717_2",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/stage-43-misery/var/ri-2.l-L1"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://evergreenculturalcentre.ca/wp-content/uploads/2025/06/Misery-FB-cover-banner-e1757116152532.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g9533340"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g9533380"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/stage-43-misery/var/ri-2.l-L1"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Stage 43: Misery"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<h4><strong><span style='color: #000000;'><i>MISERY<br /></i><span style='font-size: 12pt;'>Presented by Stage 43</span><br /><span style='font-size: 12pt;'>Written by William Goldman</span><br /><span style='font-size: 12pt;'>Based on the novel by Stephen King</span><br /></span></strong></h4> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><strong>ABOUT THE SHOW<br /></strong>Successful romance novelist Paul Sheldon is rescued from a car crash by his “number one fan,” Annie Wilkes, and wakes up captive in her secluded home. While Paul is convalescing, Annie reads his latest book and becomes enraged when she discovers the author has killed off her favorite character. Annie forces Paul to write a new novel, and he quickly realizes Annie has no intention of letting him go anywhere. Paul writes as if his life depends on it, and it does.</span></p> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><strong>ABOUT THE ARTIST<br /></strong></span><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><strong>Stage 43</strong>&nbsp;is a community theatre group that has been producing quality, affordable theatre in the Tri-Cities since 1983. Every year, Stage43 produces three shows at Evergreen. Stage 43 is part of the&nbsp;<a style='color: #000000;' href='https://theatrebc.org/fraser-valley-zone/' target='_blank' rel='noopener'><strong>Theatre BC Fraser Valley Zone</strong></a>&nbsp;and a member of the&nbsp;<a style='color: #000000;' href='https://www.facebook.com/groups/133888206632951/' target='_blank' rel='noopener'><strong>Community Theatre Coalition</strong></a>.</span></p> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Stage 43 is proud to call Evergreen Cultural Centre their home theatre, and continues to make community connections a priority.</span></p> <div>&nbsp;</div> <hr> <p><span style='color: #000000; font-family: arial, helvetica, sans-serif;'><span style='font-size: 16px;'><strong>SINGLE TICKETS ON SALE SEPTEMBER 1!</strong><br /></span></span><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Adults: $30 | Seniors: $25 | Students: $25</span></p> <p><span style='color: #000000; font-family: arial, helvetica, sans-serif; font-size: 12pt;'><strong>BOX OFFICE: 604.927.6555 | Open Monday – Saturday, 12 – 5PM</strong></span></p> <p><em>This is a co-presentation organized by Stage 43 Theatrical Society.</em></p> <p><!-- wp:pattern {'slug':'ajde_events/blocks'} /--></p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
