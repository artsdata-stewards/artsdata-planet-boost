    "http://schema.org/image": [
      {
        "@id": "https://evergreenculturalcentre.ca/wp-content/uploads/2025/02/Colourstrings-mh-1600x890-1.jpg"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g8744200"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/mini-music-makers-late-september/var/ri-1.l-L1"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Mini Music Makers - Late Session"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<h4><span style='font-family: arial, helvetica, sans-serif; font-size: 14pt;'><span style='color: #000000;'><b>MINI MUSIC MAKERS &#8211; LATE SESSION<br /></b></span></span><span style='font-family: arial, helvetica, sans-serif;'><span style='color: #000000;'><b><span style='font-size: 12pt;'>with the Vancouver Symphony Orchestra School of Music</span></b></span></span></h4> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Taught by experienced, trained early childhood music educators from the <span style='color: #008000;'><a style='color: #008000;' href='https://vsoschoolofmusic.ca/'>VSO School of Music</a></span>, our classes combine the best of Kodály, Dalcroze, Orff, and Colourstrings Kindergarten methods. This summer, we are bringing our instructors and program to Coquitlam community! Each music session is full of joyful singing, movement, and hands-on play with instruments, helping children build a strong foundation in music through active participation. Full of singing, moving, playing and learning, the classes guide your child through the foundations of music learning in a fun and highly interactive class!</span></p> <h4><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><strong>CLASS INFORMATION: <br /></strong></span><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><span style='color: #000000; font-family: arial, helvetica, sans-serif;'><span style='font-size: 16px;'><strong>Dates: </strong>Mondays at 11AM | September 22 &#8211; December 15, 2025 (No class October 13)<br /><strong>Cost:&nbsp;</strong></span></span></span><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><span style='color: #000000; font-family: arial, helvetica, sans-serif;'><span style='font-size: 16px;'>$300 (for 1 Child &amp; 1 Parent)&nbsp;<br /><strong>Age:</strong> 3 Months &#8211; 3 Years</span></span></span></h4> <p>&nbsp;</p> <hr> <h4><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><strong><br />ABOUT THE VSO SCHOOL OF MUSIC<br /></strong></span><span style='color: #000000; font-size: 12pt; font-family: arial, helvetica, sans-serif;'>VSO School of Music, founded in 2010, is a 25,000 square foot state of-the-art music school located adjacent to the Orpheum Theatre in downtown Vancouver. With a mission to enrich lives through the joy of learning, playing and performing the world’s great music, the VSO SoM develops experiences that are accessible to all, regardless of age, ability, playing level or economic circumstances; and by nurturing creative and engaged members of society through achievement in the musical arts at the downtown and satellite locations. With a roster of over 1900 students, the School is proud to offer individual or group instruction by members of the Vancouver Symphony and other high-quality music educators.&nbsp;</span><span style='color: #000000; font-size: 12pt; font-family: arial, helvetica, sans-serif;'>The school also features a performance theatre (Pyatt Hall) and Reception space which sees a wide range of arts, entertainment, and corporate groups utilizing the space for performances, recordings, and special events. </span></h4> <div><span style='color: #000000; font-family: arial, helvetica, sans-serif;'><span style='font-size: 16px;'><strong>REGISTER ONLINE OR AT THE BOX OFFICE:&nbsp;</strong><br /></span></span><span style='color: #000000; font-family: arial, helvetica, sans-serif; font-size: 12pt;'><strong>604.927.6555 | Open Monday – Saturday, 12 – 5PM</strong></span></div> <p><!-- wp:pattern {'slug':'ajde_events/blocks'} /--></p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-9-29T11:00-7::00"
      }
    ],
    "http://schema.org/endDate": [
