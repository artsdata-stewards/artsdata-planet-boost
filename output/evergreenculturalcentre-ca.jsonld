  {
    "@id": "https://evergreenculturalcentre.ca/event-type/youth-arts-programs/event_35439_9",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/kids-upcycled-fashion/var/ri-9.l-L1"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://evergreenculturalcentre.ca/wp-content/uploads/2025/11/Arts-Education-Web-Size-7.png"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g14683980"
