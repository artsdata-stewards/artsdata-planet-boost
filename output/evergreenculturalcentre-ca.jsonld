    "http://schema.org/image": [
      {
        "@id": "https://evergreenculturalcentre.ca/wp-content/uploads/2025/06/option-2.1-scaled.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1021880"
