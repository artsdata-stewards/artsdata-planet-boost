  {
    "@id": "https://evergreenculturalcentre.ca/events/the-trollsons/event_34683_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/the-trollsons/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://evergreenculturalcentre.ca/wp-content/uploads/2025/06/trollsons.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g976100"
