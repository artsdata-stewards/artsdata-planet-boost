    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Leslie Dala is the Associate Conductor and Chorus Director of Vancouver Opera and Music Director of the Vancouver Bach Choir."
      },
      {
        "@language": "en-us",
        "@value": "LESLIE DALA: ROMANCE TO RADIOHEAD\nABOUT THE SHOW"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://evergreenculturalcentre.ca/events/leslie-dala/"
      }
    ],
    "http://ogp.me/ns#site_name": [
