  {
    "@id": "https://evergreenculturalcentre.ca/events/dance-as-blessing/event_34715_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/dance-as-blessing/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://evergreenculturalcentre.ca/wp-content/uploads/2025/06/SCALED2_BandishNov-scaled.png"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1996360"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/dance-as-blessing/"
