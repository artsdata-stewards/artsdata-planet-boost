  {
    "@id": "https://evergreenculturalcentre.ca/events/theatrix-student-showcase-2025/event_34727_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/theatrix-student-showcase-2025/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://evergreenculturalcentre.ca/wp-content/uploads/2025/06/Theatrix-summer-generic.png"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g7549200"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/theatrix-student-showcase-2025/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Theatrix Summer Musical Theatre Revue: Student Showcase"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><span style='color: #000000; font-family: arial, helvetica, sans-serif;'><strong><span style='font-size: 18.6667px;'><i>THEATRIX SUMMER MUSICAL REVUE: STUDENT SHOWCASE<br /></i></span><span style='font-size: 12pt;'>Theatrix</span></strong></span></span></p> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Come and witness the magic as our talented young stars light up the stage in an unforgettable musical theatre revue! After a week of intense rehearsals, laughter, and learning, these budding performers are ready to dazzle you with their incredible talents.</span></p> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Featuring a delightful mix of popular musical theatre hits, this revue promises something for everyone. From toe-tapping showstoppers to heartwarming ballads, our cast of kids will take you on a musical journey full of joy and inspiration.</span></p> <hr> <p><span style='color: #000000; font-family: arial, helvetica, sans-serif;'><span style='font-size: 16px;'><strong>SINGLE TICKETS ON SALE:</strong><br />Early Bird: $6 | Regular Tickets: $10<br /></span></span></p> <p><span style='color: #000000; font-family: arial, helvetica, sans-serif; font-size: 12pt;'><strong>BOX OFFICE: 604.927.6555 | Open Monday – Saturday, 12 – 5PM</strong></span></p> <p><em>This is a rental event organized by Theatrix.</em></p> <p><!-- wp:pattern {'slug':'ajde_events/blocks'} /--></p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-8-15T19:00-7::00"
      }
    ],
