  {
    "@id": "https://evergreenculturalcentre.ca/events/mm-upright-beats/event_34690_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/mm-upright-beats/"
      }
    ],
    "http://schema.org/image": [
      {
