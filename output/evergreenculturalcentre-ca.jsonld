  {
    "@id": "https://evergreenculturalcentre.ca/events/young-singers-september-2025/event_35104_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/young-singers-september-2025/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://evergreenculturalcentre.ca/wp-content/uploads/2025/02/Young-Singers-scaled.jpeg"
