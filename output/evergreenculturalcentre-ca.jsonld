      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Get immersed in the deep sounds of Ian Maksin as he explores a collection of traditional songs from different corners of the world."
      },
      {
        "@language": "en-us",
        "@value": "NEW ALBUM RELEASE TOUR: LULLABY FOR THE WORLDIan Maksin"
