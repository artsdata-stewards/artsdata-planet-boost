  {
    "@id": "https://evergreenculturalcentre.ca/musical-matinees/event_34691_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/mm-la-valse/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://evergreenculturalcentre.ca/wp-content/uploads/2023/06/3-6.png"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g2052240"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
