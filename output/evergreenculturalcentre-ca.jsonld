  {
    "@id": "https://evergreenculturalcentre.ca/2019-20-entertain/event_35621_1",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/every-surface-is-a-shrine-exhibition-tour/var/ri-1.l-L1"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://evergreenculturalcentre.ca/wp-content/uploads/2026/02/DSC_0142-scaled.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g15345740"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://evergreenculturalcentre.ca/2019-20-entertain/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "&quot;Every Surface Is a Shrine&quot; Exhibition Tour"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><span style='color: #000000; font-family: arial, helvetica, sans-serif; font-size: 14pt;'><b>EXHIBITION TOUR<br /> </b></span><span style='color: #000000; font-family: arial, helvetica, sans-serif; font-size: 12pt;'><b><i>KAREN ZALAMEA: EVERY SURFACE IS A SHRINE </i></b></span><b></b></p> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Join curator Katherine Dennis (March 13) and Assistant Curator Anna Be (May 16) for a free, drop-in tour of <em>Karen Zalamea: Every Surface Is a Shrine.&nbsp;&nbsp;</em></span></p> <p><strong><span style='font-family: arial, helvetica, sans-serif;'><span style='font-size: 12pt; color: #000000;'>ABOUT THE EXHIBITION&nbsp;<br /> </span></span></strong><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>The Art Gallery at Evergreen is pleased to present&nbsp;<em>Every Surface&nbsp;Is a Shrine</em>,&nbsp;which brings&nbsp;together a&nbsp;selection&nbsp;of photo-based&nbsp;works by Karen Zalamea that traces&nbsp;the shifting boundaries between material,&nbsp;memory&nbsp;and place.&nbsp;Rooted in a critical exploration of photography’s expanded possibilities, Zalamea’s practice reimagines the medium not only as an image-making tool but as&nbsp;a methodology&nbsp;of care,&nbsp;labour&nbsp;and cultural inquiry.&nbsp;</span></p> <p>This exhibition is part of the 2026 Capture Photography Festival Selected Exhibition&nbsp;Program.</p> <div class='et_pb_module et_pb_text et_pb_text_2 et_pb_text_align_center et_pb_bg_layout_light'> <div class='et_pb_text_inner'>&nbsp;</div> </div> "
      }
    ],
