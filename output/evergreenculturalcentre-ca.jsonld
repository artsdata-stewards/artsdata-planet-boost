      {
        "@id": "https://evergreenculturalcentre.ca/events/salsa-dance-zone-2026/var/ri-46.l-L1"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://evergreenculturalcentre.ca/wp-content/uploads/2026/01/Salsa-Dance-Zone-Banner-2023-copy.jpg"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g11861980"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
