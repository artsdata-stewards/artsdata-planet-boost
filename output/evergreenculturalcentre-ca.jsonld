        "@value": "Steve Taddy&#039;s “Dark Jokes for Nice Folks” Stand-up Comedy Show"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><span style='font-family: arial, helvetica, sans-serif; color: #000000;'><strong><span style='font-size: 14pt;'>STEVE TADDY&#8217;S &#8220;DARK JOKES FOR NICE FOLKS&#8221; STAND UP COMEDY SHOW<br /></span><span style='font-size: 12pt;'>Presented by Steve Taddy Comedy Ltd.</span></strong></span></p> <p><strong><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>ABOUT THE SHOW<br /></span></strong><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>A stand-up comedy show for good people who need a little dark humour now and then. 19+ Event.<br /></span></p> <p><strong style='color: #000000; font-family: arial, helvetica, sans-serif; font-size: 12pt;'>SINGLE TICKETS ON SALE!<br /></strong><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>All tickets $29!<br /></span></p> <hr> <p><em>This is a rental event organized by Steve Taddy Comedy Ltd.</em></p> <p><!-- wp:pattern {'slug':'ajde_events/blocks'} /--></p> "
      }
    ],
