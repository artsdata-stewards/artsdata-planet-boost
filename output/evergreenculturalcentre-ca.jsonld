    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/adult-advanced-voice-over-2025/var/ri-5.l-L1"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://evergreenculturalcentre.ca/wp-content/uploads/2024/07/1.png"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g2640240"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
