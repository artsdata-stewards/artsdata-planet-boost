  {
    "@id": "https://evergreenculturalcentre.ca/events/coastal-sound-winter-song/event_35006_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/coastal-sound-winter-song/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://evergreenculturalcentre.ca/wp-content/uploads/2023/06/2-5.png"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g9102820"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g9102860"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/coastal-sound-winter-song/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Coastal Sound: Winter Song"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<h4><span style='font-family: arial, helvetica, sans-serif;'><span style='color: #000000;'><b><span style='font-size: 14pt;'><i>WINTER SONG<br /></i></span><span style='font-size: 12pt;'>Coastal Sound</span><br /></b></span></span></h4> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Nothing says “Winter” like the sounds of people singing joyfully together! Music can bring us together, lift our spirits and give us hope-especially during the holiday season.</span></p> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>These family-friendly concerts feature beautiful songs, whimsy, fun and warmth. Grin at the adorable youngsters, be transported by uplifting choral arrangements sung by Coastal Sound Youth Choir and DeCoro, sing-along exuberantly and get into a festive wintery mood!</span></p> <h4><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><strong>ABOUT COASTAL SOUND</strong></span></h4> <p class='p1'><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><span class='s1'>Coastal Sound’s mission is to transform lives and build community through&nbsp;</span><span class='s1'>choral music.&nbsp;</span><span class='s1'>Our goals are to inspire each singer to develop to their fullest potential as&nbsp;</span><span class='s1'>individuals, musicians and as caring, engaged citizens. We nurture healthy&nbsp;</span><span class='s1'>developing voices and musical excellence. </span><span class='s1'>Singers are grouped by age and experience. All of the choirs at Coastal Sound&nbsp;</span><span class='s1'>offer learner-centred instruction by professional choral music educators, vocal&nbsp;</span><span class='s1'>coaches and conductors. We aim to meet the unique musical, intellectual and&nbsp;</span><span class='s1'>social needs of all singers.</span></span><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><br /></span></p> <hr> <p><span style='color: #000000; font-family: arial, helvetica, sans-serif;'><span style='font-size: 16px;'><strong>SINGLE TICKETS ON SALE!</strong><br />Adult: $30 | Senior &amp; Student: $25 | Children under 12: $15</span></span></p> <p><span style='color: #000000; font-family: arial, helvetica, sans-serif; font-size: 12pt;'><strong>BOX OFFICE: 604.927.6555 | Open Monday – Saturday, 12 – 5PM<br /></strong></span><em>This is a co-presentation organized by Coastal Sound.</em></p> <p><!-- wp:pattern {'slug':'ajde_events/blocks'} /--></p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-12-7T16:00-7::00"
      }
    ],
    "http://schema.org/endDate": [
      {
