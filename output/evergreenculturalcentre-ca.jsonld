  {
    "@id": "https://evergreenculturalcentre.ca/events/adult-ceramics-spring-2026/var/event_35435_2",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/adult-ceramics-spring-2026/var/ri-2.l-L1"
