    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><span style='color: #000000; font-family: arial, helvetica, sans-serif;'><strong><span style='font-size: 18.6667px;'><i>LOVE SPEAKS #57</i></span><br /></strong></span></span></p> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Love Speaks is a series of performances celebrating Iranian art and artists, featuring poetry and music presented by a variety of performers.<br /></span><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Please note that this performance is presented in Farsi.</span></p> <hr> <p><span style='color: #000000; font-family: arial, helvetica, sans-serif;'><span style='font-size: 16px;'><strong>SINGLE TICKETS ON SALE:</strong><br />All tickets just $30!<br /></span></span></p> <p><span style='color: #000000; font-family: arial, helvetica, sans-serif; font-size: 12pt;'><strong>BOX OFFICE: 604.927.6555 | Open Monday – Saturday, 12 – 5PM</strong></span></p> <p><em>This is a rental event organized by Hafez Literature Club.</em></p> <p><!-- wp:pattern {'slug':'ajde_events/blocks'} /--></p> "
