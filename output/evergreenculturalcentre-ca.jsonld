      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Blood Wedding: A Concert-Theatre Performance"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><strong><span style='font-size: 14pt;'>BLOOD WEDDING<br /></span></strong></span><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><strong>A CONCERT-THEATRE PERFORMANCE</strong><br /></span></p> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Blood Wedding, a poetic masterpiece by Federico García Lorca, tells a haunting tale of love, fate, and deeply rooted traditions in rural Spain. This concert-theatre performance blends live Andalusian-inspired music and evocative vocals and dance with powerful dramatic narration, creating a rich sensory experience.</span></p> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Presented through the acclaimed Persian translation by Ahmad Shamlou and directed by Reza Rad, the production offers a multidimensional fusion of theatre, music, and poetry that brings Lorca’s timeless tragedy to life on stage.</span></p> <div> <hr> <p><strong><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>TICKETS ON SALE!</span></strong><strong><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><br /></span></strong><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Orchestra: $65 | Mezzanine: $55 | Upper Mezz: $45</span></p> </div> <p><em>This is a rental event organized by Reza Rad.</em></p> <p><!-- wp:pattern {'slug':'ajde_events/blocks'} /--></p> "
      }
    ],
