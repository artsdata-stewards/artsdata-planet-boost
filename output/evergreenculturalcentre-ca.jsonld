  {
    "@id": "https://evergreenculturalcentre.ca/events/erin-ilett-solo-concert/event_35344_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/erin-ilett-solo-concert/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://evergreenculturalcentre.ca/wp-content/uploads/2025/11/Erin-Ilett.png"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g2536160"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
