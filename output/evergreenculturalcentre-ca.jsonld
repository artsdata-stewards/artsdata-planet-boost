    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Rehearsal Hall Sessions: Fistful of Kicks - Intergenerational Family Dramedy"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<h4><strong><span style='color: #000000;'><i>INTERGENERATIONAL FAMILY DRAMEDY<br /></i>Fistful of Kicks</span></strong></h4> <h4><span style='color: #000000;'><span style='color: #000000;'><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt;'><strong>Fistful of Kicks</strong> has been creating comedy magic all around Vancouver and the world since 2017. They’ve performed at festivals all over North America, including Calgary, Seattle, Portland, and Austin, and are a mainstay at the Vancouver Improv Festival and Just for Laughs: Vancouver, in addition to producing sketch comedy for CBC. </span></span></span></h4> <h4><span style='color: #000000;'><span style='color: #000000;'><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt;'>They bring their unique wit and shared cultural heritage, to every show they’ve developed and produced, including improv based on East Asian legends, classic Anime series, the movie <em>Everything Everywhere All at Once</em>, 80s Hong Kong Gangster films, and, currently, a multigenerational Asian family dramedy.<strong><br /></strong></span></span></span></h4> <div>&nbsp;</div> <div>&nbsp;</div> <hr> <p><span style='color: #000000; font-family: arial, helvetica, sans-serif;'><span style='font-size: 16px;'><strong>SINGLE TICKETS ON SALE JULY 01!</strong><br /></span></span><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Adults &amp; Seniors: $25 | Students: $16</span></p> <p><span style='color: #000000; font-family: arial, helvetica, sans-serif; font-size: 12pt;'><strong>BOX OFFICE: 604.927.6555 | Open Monday – Saturday, 12 – 5PM</strong></span></p> <p><!-- wp:pattern {'slug':'ajde_events/blocks'} /--></p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
