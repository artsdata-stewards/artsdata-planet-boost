  {
    "@id": "https://evergreenculturalcentre.ca/events/yalda-night-celebration/event_35422_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/yalda-night-celebration/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://evergreenculturalcentre.ca/wp-content/uploads/2025/11/نستلیق-ساز-1.png"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g9722620"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/yalda-night-celebration/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Yalda Night Celebration"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><strong><span style='font-family: arial, helvetica, sans-serif; color: #000000; font-size: 18.6667px;'>YALDA NIGHT CELEBRATION<br /></span></strong></p> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Celebrate the longest night of the year with an unforgettable Yalda evening featuring a 3-course buffet dinner, live music, poetry, cultural performances, and a warm family-friendly atmosphere. </span><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Hosted by <strong>Araz Rismani</strong>, this special night brings together talented musicians, beautiful traditions, and joyful community moments.</span></p> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><span style='color: #008000;'><span style='color: #000000;'><b>ABOUT THE ARTIST</b></span></span><b></b><span style='color: #008000;'><span style='color: #000000;'><br /></span></span></span></p> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><span style='color: #000000;'>Araz Rismani is a Vancouver-based cultural event host, vocalist, and community organizer known for creating warm, inclusive, music-filled gatherings. His programs bring together Persian cultural traditions, live performances, and meaningful shared experiences for diverse audiences.</span><span style='text-decoration: underline;'><br /></span></span></p> <hr> <p><span style='color: #000000; font-family: arial, helvetica, sans-serif;'><span style='font-size: 16px;'><strong>SINGLE TICKETS ON SALE!</strong><br /><strong>Early Bird (until Dec. 7)—</strong>&nbsp;Adult: $90 | Kids 12 and under: $70<br /><strong>Regular—</strong> Adult: $100 | Kids 12 and under: $80</span></span></p> <div dir='auto'><span style='text-decoration: underline;'><strong><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000; text-decoration: underline;'>Tickets only available by phone or email:</span></strong></span></div> <div dir='auto'><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Phone: 778-688-7541 | </span><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Email: <a style='color: #000000;' title='mailto:araz.rismani@gmail.com' href='mailto:araz.rismani@gmail.com' data-outlook-id='58afe209-e4a1-4438-9e73-528d604d323f'>araz.rismani@gmail.com</a></span></div> <p><em>This is a rental event organized by Araz Rismani.</em></p> <p><!-- wp:pattern {'slug':'ajde_events/blocks'} /--></p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-12-21T18:30-7::00"
      }
    ],
