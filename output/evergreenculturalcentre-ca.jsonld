    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/stage-43-incompetent-jurors/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://evergreenculturalcentre.ca/wp-content/uploads/2025/06/12-Incompetent-Jurors-v2-scaled.png"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1840020"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g1840060"
