  {
    "@id": "https://evergreenculturalcentre.ca/events/rhs-las-mujeronas/event_34702_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/rhs-las-mujeronas/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://evergreenculturalcentre.ca/wp-content/uploads/2025/06/Las-Mujeronas-Nicholas-Pereira-2024.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g884480"
      }
    ],
