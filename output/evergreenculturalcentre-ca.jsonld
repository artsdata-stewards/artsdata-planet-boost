    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Warren Miller &quot;SNO-CIETY&quot; Viewing Event"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><span style='font-family: arial, helvetica, sans-serif;'><span style='font-size: 12pt; color: #000000;'><span style='color: #000000;'><strong><span style='font-size: 14pt; color: #000000;'><i>WARREN MILLER &#8220;SNO-CIETY&#8221; VIEWING EVENT<br /></i></span></strong></span></span><span style='font-size: 14pt;'><strong><span style='color: #000000;'>The Lift Ski and Board</span></strong></span></span></p> <p class='elementToProof'><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>The Lift Ski and Board is proud to present this year’s Warren Miller film, <strong><em>SNO-CIETY</em></strong>. This year’s film brings the global ski and snowboard community&nbsp;back together to celebrate the start of the season for the 76th year. From the Scottish Highlands and the streets of Finland to the back bowls of Whitewater, BC and a local hill-turned-terrain park in downtown Denver, <em>SNO-CIETY</em> celebrates the spirit of winter—wherever you ride and however you connect to the snow and the community around it.</span></p> <hr> <p><span style='color: #000000; font-family: arial, helvetica, sans-serif;'><span style='font-size: 16px;'><strong>SINGLE TICKETS ON SALE:</strong><br /><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>All tickets $35!</span><br /></span></span></p> <p><span style='color: #000000; font-family: arial, helvetica, sans-serif; font-size: 12pt;'><strong>BOX OFFICE: 604.927.6555 | Open Monday – Saturday, 12 – 5PM</strong></span></p> <p><em>This is a rental event organized by the Lift Ski and Board.</em></p> <p><!-- wp:pattern {'slug':'ajde_events/blocks'} /--></p> "
      }
    ],
