  {
    "@id": "https://evergreenculturalcentre.ca/events/stagekidz-2026-spring-recital/event_35617_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/stagekidz-2026-spring-recital/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://evergreenculturalcentre.ca/wp-content/uploads/2025/11/main-kidz-classes-1080.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g10860860"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g10860900"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/stagekidz-2026-spring-recital/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "StageKidz 2026 Spring Recital"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><strong><span style='font-family: arial, helvetica, sans-serif; font-size: 14pt; color: #000000;'>STAGEKIDZ 2026 SPRING RECITAL<br /><span style='font-size: 12pt;'>Presented by StageKidz</span></span></strong></p> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Join StageKidz for their 2026 Spring Recital, March 7 at Evergreen Cultural Centre.</span></p> <p><strong><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>ABOUT STAGEKIDZ<br /></span></strong><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>At StageKidz we offer skills that enable children to shine on stage and off stage in all aspects of their lives. </span><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>We provide excellent part-time performing arts training for children aged 4 – 14 years in Coquitlam and surrounding areas.</span></p> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><em>Where else can you get acting, singing, and dancing all-inclusive in one program?<br /></em></span><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><em>Whether you have years of experience or just trying out your talents StageKidz is for you!</em></span></p> <hr> <p><strong><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>TICKETS ON SALE!</span></strong><br /><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>All tickets just $27<br /></span><em>This is a rental event organized by StageKidz.</em></p> <p><!-- wp:pattern {'slug':'ajde_events/blocks'} /--></p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
