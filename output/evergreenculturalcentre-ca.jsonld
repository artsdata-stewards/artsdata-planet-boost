      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://evergreenculturalcentre.ca/wp-content/uploads/2024/08/2024-25-AGE-Web-Events_CM-exhibition-tour.png"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g9002440"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/nesting-curators-tour/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "&quot;Maya Beaudry: Nesting&quot; Curator&#039;s Tour"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><strong><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><span style='font-size: 14pt;'><em>MULTITUDES</em> CURATOR&#8217;S TOUR<br /> </span></span></strong><span style='color: #000000; font-family: arial, helvetica, sans-serif; font-size: 12pt;'><span class='TextRun SCXW125891495 BCX0' lang='EN-US' xml:lang='EN-US' data-contrast='auto'><span class='NormalTextRun SCXW125891495 BCX0'>Friday, </span><span class='NormalTextRun SCXW125891495 BCX0'>October </span><span class='NormalTextRun SCXW125891495 BCX0'>3, 1PM | Saturday November 1, 1PM.</span></span></span></p> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'>Join the Art Gallery at Evergreen&#8217;s curatorial team for a drop-in lunchtime tour of <em>Maya Beaudry: Nesting</em>. </span></p> <p><strong><span style='font-family: arial, helvetica, sans-serif;'><span style='font-size: 12pt; color: #000000;'>ABOUT THE EXHIBITION&nbsp;</span></span></strong></p> <p><span style='font-family: arial, helvetica, sans-serif; font-size: 12pt; color: #000000;'><span class='TextRun SCXW241592220 BCX0' lang='EN-CA' xml:lang='EN-CA' data-contrast='auto'><span class='NormalTextRun SCXW241592220 BCX0'>Maya Beaudry builds spaces that breathe. Through layered textiles, stitched architectures, and </span><span class='NormalTextRun SCXW241592220 BCX0'>photographic, </span><span class='NormalTextRun SCXW241592220 BCX0'>sculptural surfaces, she gives form to the emotional residues of place—homes lost, cities transformed, </span><span class='NormalTextRun SCXW241592220 BCX0'>and </span><span class='NormalTextRun SCXW241592220 BCX0'>bodies remembered. Her practice is rooted in the material language of cloth and the conceptual terrain of memory, navigating the threshold between the built and the felt.</span> <span class='NormalTextRun SCXW241592220 BCX0'>Drawing on the visual language of gentrified cities and vanish</span><span class='NormalTextRun SCXW241592220 BCX0'>ing</span><span class='NormalTextRun SCXW241592220 BCX0'> spaces</span><span class='NormalTextRun SCXW241592220 BCX0'>, her practice </span><span class='NormalTextRun SCXW241592220 BCX0'>recalls</span><span class='NormalTextRun SCXW241592220 BCX0'> what has been lost while imagining new forms of habitation—ones that honour slowness, decay, and renewal. In doing so, she transforms textiles into mnemonic architectures and offers viewers a place to dwell.</span></span><span class='EOP SCXW241592220 BCX0' data-ccp-props='{}'>&nbsp;</span></span></p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-10-3T13:00-7::00"
      }
