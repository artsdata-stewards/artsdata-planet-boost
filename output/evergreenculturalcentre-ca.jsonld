  {
    "@id": "https://evergreenculturalcentre.ca/events/rhs-rocky-horror/event_34692_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://evergreenculturalcentre.ca/events/rhs-rocky-horror/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://evergreenculturalcentre.ca/wp-content/uploads/2025/06/RHPS-Flat-high-Res.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g9159060"
