      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Coastal Sound inspires children, youth and adults to be their best through choral singing and through the connection of making music together! With exceptional choral music education available for ages 4 to adult, sing a wide variety of musical styles, make friends, learn vocal technique, have unique performance opportunities, gain leadership experience, and more. Coastal Sound Music Academy is a registered non-profit Society. BN: 890176043RR0001"
      }
    ],
