  {
    "@id": "https://montrealjazzfest.com/temporary/793d85df-ece4-4736-a3e7-eab3df48c98d",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
