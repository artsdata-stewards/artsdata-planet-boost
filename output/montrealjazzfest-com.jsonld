  {
    "@id": "https://montrealjazzfest.com/temporary/5f0b4ffd-c23b-4161-a9a5-bbd18b20dd3e",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-06-26T23:00:00.000Z"
      }
    ],
    "http://schema.org/isAccessibleForFree": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": "false"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://images.ctfassets.net/dv1qnlptav0x/1cP91UgcYb2asqT9AlgQFK/dd46754dcf619da911cfeccbfafc3f7a/fijm26_flore_laurentienne.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g745480"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "_:g745500"
