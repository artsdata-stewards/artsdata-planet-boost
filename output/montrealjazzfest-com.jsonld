    ],
    "http://schema.org/image": [
      {
        "@id": "https://images.ctfassets.net/dv1qnlptav0x/57eN9DEN3a1o4vuBJiJPZO/ec563162452042b24063cba541f315ae/fijm26_adrian_quesada.jpg"
      }
    ],
    "http://schema.org/location": [
