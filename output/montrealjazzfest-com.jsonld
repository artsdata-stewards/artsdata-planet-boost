      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://images.ctfassets.net/dv1qnlptav0x/3hMc3kzPqLKlzZ7Liw1bsr/67287d15feb40fc94cdf930eaac2ecf1/fijm26_sullivan_fortner.jpg"
      }
    ],
    "http://schema.org/location": [
