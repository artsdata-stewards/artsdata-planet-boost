    "http://schema.org/image": [
      {
        "@id": "https://images.ctfassets.net/dv1qnlptav0x/3XmZnMah2w6W9kHKWaDyCX/e4db8ad92944c7d8e46dca92e7e82a3b/fijm26_taj_mahal.jpg"
      }
