      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://images.ctfassets.net/dv1qnlptav0x/3NYS3BJ15xqJM61hSNtzOJ/3d69b4aad5d6c57b07e92f4d6053c2f8/fijm26_chief_adjuah.jpg"
      }
    ],
    "http://schema.org/location": [
