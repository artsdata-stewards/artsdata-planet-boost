      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://images.ctfassets.net/dv1qnlptav0x/1rqgDeEaqEq1VqGphkrncb/5928aa1cff3fdf7656c094e5d49be659/fijm26_hania_rani.jpg"
      }
    ],
    "http://schema.org/location": [
      {
