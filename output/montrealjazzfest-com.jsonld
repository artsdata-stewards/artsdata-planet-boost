      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://images.ctfassets.net/dv1qnlptav0x/1IZvib34yiaJaStaR8ZTcE/4f922ce96408dc3efa3e022eea3e09cb/fijm26_joshua_redman.jpg"
      }
    ],
    "http://schema.org/location": [
      {
