  {
    "@id": "https://montrealjazzfest.com/temporary/5ef942b5-256f-46dc-b13f-b2a0827c26f0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-06-27T01:00:00.000Z"
      }
    ],
    "http://schema.org/isAccessibleForFree": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": "false"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://images.ctfassets.net/dv1qnlptav0x/1Vf0HDTOSgt0fltEJz1Xaz/550eeda5abf03cdbd159294af2a133fd/fijm26_cecile_mclorin_salvant.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g692760"
      }
    ],
    "http://schema.org/performer": [
      {
