      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://images.ctfassets.net/dv1qnlptav0x/40y0EJamqdeNysAb3dkuRy/fde48767c1a83d3df9b84850b3fbbdfd/fijm26_stacey_kent.jpg"
      }
    ],
    "http://schema.org/location": [
