    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Platypus Theatre's Music Under a Midnight Moon | NACO Family Adventures  |  Sun, Feb 15, 2026, 3:30 pm | Southam Hall"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38383/web-listing-midnight-moon-__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Presented in partnership with the NAC’s BIG BANG Festival.\n\nMagic, music, and wonder abound as two wanderers discover beauty in unexpected places.\n\nPrepare for a heartwarming symphonic adventure where magic, music, and imagination shine bright! Join the NAC Orchestra and the internationally acclaimed Platypus Theatre for Music Under a Midnight Moon, a whimsical journey that reveals the beauty of sound in the most unexpected places. \n\nAs twilight falls, two weary wanderers stumble upon a forgotten junkyard. But what seems like a pile of..."
      }
