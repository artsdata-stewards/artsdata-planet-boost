    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Primary Colours   | Beau, bon, gratuit |   sam  8 aoû 2026, 16 h 30|  Sur le long du Canal Rideau"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41085/dscf2854_curtis_perry__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Primary Colours est un trio de piano canadien qui s’inspire des traditions du jazz, influencé par des artistes modernes comme Robert Glasper, GoGo Penguin, Tigran Hamasyan et Herbie Hancock. Mariant l’acoustique et l’électrique, le trio navigue entre grooves entraînants et mélodies profondes, découvrant l’inattendu grâce à son don pour l’improvisation. Il est composé de Deniz Lim-Sersan aux claviers, Chris Pond à la basse et José Hernandez García à la batterie. \n\nMusique sur le Canal\nLe concert se déroulera sur le canal Rideau..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
