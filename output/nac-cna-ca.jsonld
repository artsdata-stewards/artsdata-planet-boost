    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Monster Mixtape | Halloween concert with the NAC Orchestra | Oct 29 - 31, 2025 | Southam Hall"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38420/dscf5618_curtis_perry_cropped__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "This Halloween, the NAC Orchestra turns Southam Hall into a playground of sound and suspense with a night of eerie, epic, and haunted music straight out of your favourite Halloween playlist.\n\nAll ages welcome—spooky, not scary.\nCostumes encouraged—the music will do the haunting.\n\nYou’ll enjoy music from iconic films: Psycho, Signs, Jaws, Harry Potter, Aliens, Halloween, Joker, The Nightmare Before Christmas, and more—alongside dramatic classics and famous Halloween themes such as Danse macabre, “The Ride of the Valkyries,” Funeral March of a Marionette, “In the Hall of..."
      }
