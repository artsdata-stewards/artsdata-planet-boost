    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Abigail Lapell  |   sam 15 nov 2025, 20 h 00|  Quatrième Salle"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/39290/use_as_lead_abigail_lapell__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "L’auteure-compositrice-interprète et multi-instrumentiste Abigail Lapell fait son retour avec Anniversary, un nouvel album évocateur de chansons d’amour originales. Produit par Tony Dekker des Great Lake Swimmers, cet album a été enregistré dans l’église bicentenaire St Mark’s à Niagara-on-the-Lake, en Ontario. Le musicien a orchestré les séances d’enregistrement autour de l’atmosphère lugubre et de la résonance des lieux, en plus de prêter sa voix le temps de quelques duos envoûtants. Les paroles habiles d’Abigail Lapell s’éloignent des poncifs habituels des chansons d’amour pour s’attaquer à la..."
      }
    ],
