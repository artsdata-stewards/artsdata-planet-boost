  {
    "@id": "https://nac-cna.ca/temporary/1a6786e9-1862-4c12-9a89-4f395142f089",
    "@type": [
      "http://schema.org/Event",
      "http://schema.org/TheaterEvent"
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Sous la feuille: Spectacle multidisciplinaire pour tout-petits"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Ariane Voineau et Josu&eacute; Beaucage, en sympathiques interpr&egrave;tes-campeurs, nous offrent ce tendre spectacle en forme d&rsquo;herbier. On y retrouve de scintillants instants de danse, de chant, de jeux d&rsquo;ombres et de r&eacute;flexions sur le Vivant, comme tout plein de jolies feuilles d&rsquo;arbre &agrave; coller dans notre m&eacute;moire, ce livre &agrave; &eacute;merveillement.&nbsp;"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g26890520"
      }
