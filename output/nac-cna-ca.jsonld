    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "The Great Gatsby  |   8-13 sep 2026|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40616/bac_seasons26-27_nacwebsite_eventimage_productionshots_1920x1080_tgg__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "La fête bat son plein à Ottawa!\n\nTHE GREAT GATSBY est « un spectacle haut en couleur de Broadway débordant de vie et d’énergie » (Entertainment Weekly). Inspiré du roman culte de Francis Scott Fitzgerald, cette nouvelle comédie musicale primée aux prix Tony plonge le public dans l’amour, le luxe et la désillusion des Années folles.\n\nMise en scène par Marc Bruni (Beautiful: The Carole King Musical), THE GREAT GATSBY raconte une histoire d’excès et de désir, sublimée par la chorégraphie de Dominique Kelley (So You..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
