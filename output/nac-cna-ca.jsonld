    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Beaded Earring Workshop | with Jessica Dumont |  Thu, Jan 15, 2026, 5:30 pm | Atelier Shenkman Smith"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40132/fringe_earring_workshop__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Come join Jessica Dumont for this beaded earring workshop!  \nIn this 3-hour workshop, Jessica will guide you through the earring making process where you can share your process and ask questions along the way. \nSuitable for beginner beaders and experienced beaders alike, ages 16 and up. Workshop will be delivered in English.\n\nThis workshop takes place at 1 Elgin St, in the National Arts Centre's Atelier Shenkman Smith which is located across from the Box Office. "
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
