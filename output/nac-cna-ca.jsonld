    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Benin International Musical   | Le pouvoir du Vodoun au cœur de la musique moderne  |   mar 14 jui 2026, 19 h 30|  Théâtre Babs Asper"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41226/bim_salford_press_-_guillaume_robin__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le collectif Bénin International Musical (BIM) réunit cinq artistes qui donnent voix aux histoires du continent africain dans une fusion percutante de musique et de récit. Ancré dans la culture béninoise et la tradition vodun, le groupe déconstruit les idées reçues avec une philosophie tournée vers la vie, la terre et la communauté. Entre rock, rap et rythmes traditionnels, BIM fait de chaque concert un rituel contemporain incandescent. \n\nAprès un premier album défendu sur plus de 150 scènes à travers le..."
      }
    ],
