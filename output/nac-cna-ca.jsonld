    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Sooshi Mango  | 'The Home Made World Tour' |   ven  8 mai 2026, 20 h 00|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40058/static_digital_3840x2160_sooshimango_2026_regional_nationalartscentre_0508_notext__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Sooshi Mango est l'un des groupes comiques les plus populaires et les plus appréciés d'Australie, créé par les frères Joe et Carlo Salanitri et leur ami proche Andrew Manfre. Ce qui a commencé il y a seulement neuf ans comme des clips comiques décontractés filmés dans une voiture est rapidement devenu un phénomène culturel. Leur humour accessible, axé sur les personnages et ancré dans les expériences des familles d'immigrants, leur a valu des spectacles à guichets fermés, une renommée mondiale..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
