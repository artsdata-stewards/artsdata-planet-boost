    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://nac-cna.ca/fr/event/40582"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Tournée OCNA 2026 - Eskasoni, Nouvelle-Écosse  | Avec Jeremy Dutcher |   mar 14 avr 2026, 14 h 30|  Dan K. Stevens Memorial Arena"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40582/dscf3346_curtis_perry-crop_cropped__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Pour sa centième tournée depuis sa fondation en 1969, l’Orchestre du Centre national des Arts, sous la baguette de son directeur musical Alexander Shelley, se joint à l’auteur-compositeur-interprète et pianiste autochtone Jeremy Dutcher, lauréat de nombreux prix.\n\nCe programme électrisant comprend des œuvres de Dutcher ainsi que l’emblématique Symphonie no 5 de Beethoven et Polyphonic Lively du compositeur canadien Dinuk Wijeratne.\n\nEn outre, la chanteuse Emma Stevens, originaire de la Nouvelle-Écosse, partagera la scène avec l’Orchestre du CNA pour interpréter sa reprise en langue..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/event/40582"
      }
    ]
  },
