      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://nac-cna.ca/fr/event/40469"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Prix du Gouverneur général pour les arts du spectacle 2026  |   sam  6 jun 2026, 18 h 30|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40469/gg2026-nacweb_laureates__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Nous vous invitons à assister à une soirée divertissante et élégante au cours de laquelle est remise la plus haute distinction dans les arts du spectacle au Canada!\n\nNOUVEAU CETTE ANNÉE! Les projecteurs seront braqués sur la rue Elgin. Venez nous rejoindre sur le tapis rouge à l’entrée de la rue Elgin du CNA pour accueillir les lauréats et lauréates ainsi que les artistes qui se produiront sur scène cette année. Ne manquez pas cette célébration aussi éblouissante que festive!  \n\nLa soirée débutera à 18 h 30, en attendant les arrivées sur le tapis..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
