    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "La Famille Leblanc  | Beau, bon, gratuit |  18-20 aoû 2026|  Terrasse en bois"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41301/fg_7731r__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Installez-vous, le soleil se couche… et la musique commence! Notre terrasse en bois est accessible à partir de la rue Elgin, du canal Rideau et du pont Mackenzie-King. Cet été, retrouvez à Ottawa le meilleur de la musique, gratuitement!  \n\nAvec la famille LeBlanc, la musique devient un voyage : du Poitou, en France, terre d’accueil de la population acadienne au milieu du XVIIIe, jusqu’à la Louisiane, avant de revenir sur la côte est du Canada, pour une plongée vibrante au cœur..."
      }
    ],
