    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Classe du Ballet national du Canada sur scène  |   sam 25 avr 2026, 13 h 30"
      }
    ],
    "http://ogp.me/ns#image": [
