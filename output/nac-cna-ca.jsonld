    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "SoulRhythms |  Mon, Mar 9, 2026, 7:00 pm | Peter A. Herrndorf Place"
      }
    ],
    "http://ogp.me/ns#image": [
