      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Petite salle,<br/>grand éclat | Série Musique populaire et variétés"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-packages.s3.amazonaws.com/37408/24-25_fourth-stage-impact3__tablet-small.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Passez nous voir à la Quatrième Salle du CNA, un lieu privilégié pour la relève, pour les artistes qui transcendent les barrières et repoussent les limites. Cette salle à l’ambiance intime et chaleureuse est le meilleur endroit à Ottawa pour entendre des têtes d’affiche de la scène locale comme des artistes de tout le pays et le monde. Prenez une bière au bar, installez-vous confortablement et profitez du spectacle!"
      }
    ],
