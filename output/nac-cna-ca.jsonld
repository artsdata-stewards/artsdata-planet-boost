    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Capital Sessions  | Ateliers de danse house communautaires gratuits |   dim 19 avr 2026, 13 h 30|  Place Peter A. Herrndorf"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40576/capital_sessions__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Capital Sessions et le CNA vous proposent une série d’ateliers de danse house communautaires GRATUITS.\n\nCes séances sont parfaites pour les novices et pour toute la famille. Le DJ sera aux platines de 13 h 30 à 15 h 30 avec une trame deep house pleine de soul, et le danseur animera deux ateliers de 30 minutes à 13 h 30 et à 14 h 30. Ce sera l’occasion de danser, d’apprendre ou tout simplement de profiter de l’ambiance en écoutant..."
      }
    ],
