      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://nac-cna.ca/fr/event/38326"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Créatures  | Performance théâtrale et multisensorielle |  29-31 jan 2026|  Studio Azrieli"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38326/tfcna2526_creatures_1440x810__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Adultes, jeunes à partir de 12 ans bienvenu·e·s.\n\nD’une mer opaque émergent des poutres enchevêtrées, comme si des mains géantes avaient joué au Mikado avec notre monde. Cette insolite structure est occupée par onze fillettes, adolescentes et adultes, toutes affairées à... À quoi? Obsédant mystère! Sur la scène brinquebalante se réalise une fascinante chorégraphie gestuelle : on repêche des objets, on en répare, ça tremble, ça s’écroule, on recommence. Étonnant à quel point une telle mécanique de survie va lier ces femmes..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/event/38326"
      }
    ]
  },
