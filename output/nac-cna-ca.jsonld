    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Mikhail Laxton  |   sam 13 déc 2025, 20 h 00|  Quatrième Salle"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/39366/mikhail_laxton_-_promo_pic_(jen_squires)__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Mikhail Laxton interprètera sur la scène du CNA ses chansons honnêtes qui parlent de la vraie vie, tout en réchauffant les cœurs. Dans ses chansons, notamment Dirty, I Like The Way et Something’s Gonna Give, il fait appel à une soul-roots nostalgique pour parler de foi, d’amour et de ce qui nous fait tenir quand la vie nous joue des tours. Entre respiration profonde et cœur à cœur, la musique de Mikhail Laxton carbure aux grooves chauds et aux vibrations positives. "
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/event/39366"
      }
    ]
  },
