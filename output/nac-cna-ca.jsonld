      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "La tragédie d'Hamlet, Prince du Danemark  | Ex Machina | Robert Lepage + Côté Danse | Guillaume Côté |  25-26 fév 2026|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38359/_0001_guillaume_cote-_photo_de_mattt_barnes__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "L'accord parfait pour un classique revisité\n\nDeux des grands créateurs du Canada, l’un issu de la danse, l’autre du théâtre, font équipe pour nous dévoiler une version dansée d’un classique de la littérature et de son héros tourmenté et emblématique : Hamlet. Cette réinterprétation du chorégraphe Guillaume Côté et du metteur en scène Robert Lepage passe par le langage du mouvement et de la musique pour dépeindre les moments forts et les thèmes universels de cette œuvre anthologique de Shakespeare. Portée par une distribution..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/event/38359"
      }
    ]
  },
