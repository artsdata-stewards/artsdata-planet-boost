    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Andrea Lindsay  | D’or et d’argent – Le spectacle |   jeu 14 mai 2026, 20 h 00|  Quatrième Salle"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40322/web_resize_(1)__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "La décennie écoulée a été pour Andrea Lindsay une période riche en création et en moments forts sur scène. Son dernier opus, Entre le jazz et la java (2016), composé de reprises de classiques du jazz et couronné du Félix de l’Album jazz de l’année, lui a permis de se produire à plus de 60 occasions sur scène. À la même période, la parution de deux albums en duo avec Luc De Larochellière offre au couple l’occasion de donner des dizaines de représentations, encore..."
      }
    ],
