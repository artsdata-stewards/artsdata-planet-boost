      {
        "@language": "fr-ca",
        "@value": "Conférence et vitrine musicale Cranium 2026  | Événements du samedi |   sam  9 mai 2026, 12 h 00|  Centre national des Arts"
      }
    ],
    "http://ogp.me/ns#image": [
