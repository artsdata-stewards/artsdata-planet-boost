        "@value": "Les lundis des tout-petits  | Les contes de Luana |   lun 17 mar 2025, 10 h 00|  Place Peter A. Herrndorf"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
