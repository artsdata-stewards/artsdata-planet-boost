  {
    "@id": "https://nac-cna.ca/temporary/b65af4bf-7cb3-4d7b-8444-7ca904a7afac",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Camions (fant&ocirc;mes de la libert&eacute;)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Scoop&nbsp;: apr&egrave;s les manifestations de 2022, on apprend que le CNA sera de nouveau PRIS D&rsquo;ASSAUT PAR DES CAMIONS &ndash; mais plus petits! On rapporte que des enfants seront aux commandes, que le public portera des casques d&rsquo;&eacute;coute et que ce parcours d&eacute;ambulatoire interg&eacute;n&eacute;rationnel revisitera la notion de libert&eacute; de fa&ccedil;on extraludique."
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g13410980"
      }
    ],
    "http://schema.org/workPerformed": [
      {
        "@id": "https://nac-cna.ca/fr/event/38325#CreativeWork"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://nac-cna.ca/venue/azrieli-studio-foyer#Place"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "_:g13411000"
      }
    ],
