    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Nous sommes en&nbsp;2035, une d&eacute;cennie apr&egrave;s l&rsquo;effondrement du quartier de Trinity Bellwoods &agrave; Toronto. Une enqu&ecirc;te sur la myst&eacute;rieuse disparition d&rsquo;une jeune fille m&egrave;ne &agrave; une &eacute;trange demeure qui s&rsquo;est enfonc&eacute;e sous terre."
      }
