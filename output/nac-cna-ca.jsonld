    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Genna G au CNA : soirée de lancement de l'album   |   jeu 19 mar 2026, 19 h 30|  Quatrième Salle"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40553/gennagatthenacalbumlaunch__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Appel à tous les amateurs de jazz et de comédie musicale. Venez célébrer le lancement du premier album studio de Genna G et de son trio de jazz, interprété en personne pour la première fois avant sa sortie officielle. Dans la foulée d'un cabaret de Noël *presque* complet, Genna Giampaolo partage un aperçu de cette collection vulnérable de ses chansons originales (ainsi que de quelques reprises préférées) mises en musique par des collaborateurs talentueux : Nic Code, Mike Mopas et..."
      }
    ],
