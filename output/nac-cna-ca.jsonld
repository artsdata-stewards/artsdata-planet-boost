    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Tupqan | Nos territoires intérieurs  | Création d'Ondinnok avec Menuentakuan et Production AUEN |  20-22 nov 2025|  Studio Azrieli"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38351/tupquan-optimized__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Fruit d’une collaboration artistique entre Ondinnok, Menuentakuan et Production AUEN, la pièce est coproduite en partenariat avec Ondinnok, Duceppe, le Théâtre autochtone du CNA et le Fonds national de création du CNA, avec le soutien de la Fondation Cole.\n\n\nPrésenté en français avec surtitres anglais.\n\nDeux décennies se sont écoulées depuis le vol du wampum, objet sacré et symbole de cohésion pour la petite communauté de l’Est du Québec de Whitefish (Wapeyit-Nomehs). Aujourd’hui, le village est déchiré par une crise politique : deux..."
      }
    ],
