    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Daniel James McFadyen  | avec Kieran Campbell |   sam 28 mar 2026, 20 h 00|  Quatrième Salle"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40319/djm_-_oct_2024_wolfville_shoot_-_final_edits-89-min__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Artiste indie-folk primé, Daniel James McFadyen se distingue par un lyrisme évocateur, une présence scénique magnétique et un art du récit nourri par la route, qui font de lui l’une des voix contemporaines les plus marquantes au Canada. Son deuxième album, Back To The Country (LHM Records), paru en 2025, marque un tournant décisif dans son évolution artistique – un album intime, organique et affirmé, imprégné de sonorités americana et canadiana qui font désormais sa signature.\n\nL’album, enregistré en direct dans un chalet au bord..."
      }
    ],
