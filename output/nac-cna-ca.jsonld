    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Join us for an inspiring evening of live music from Oneida/Mohawk singer/songwriter Lacey Hill and opening act Aiyana Louis Debassige as we come together to celebrate and raise awareness for Minwaashin Lodge – Indigenous Women’s Support Centre. Don’t miss this special night of music, hope and connection, and the special opportunity to support Indigenous women and children. \n\nProceeds from this fundraiser will help support Minwaashin Lodge's Annual Women's Gathering. \n\nMinwaashin Lodge Indigenous Women’s Support Centre provides a range of programs and services..."
      }
