      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Thelonious  | Concert ludique ébouriffé  |  14-15 fév 2026|  Studio Azrieli"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38340/tfcna2526_thelonious_1440x810__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Jazze ta vie avec trois musiciens au talent surnaturel qui ravivent, le temps d’un spectacle-concert tapissé d’animations vidéo délirantes, la figure mythique du pianiste et compositeur afro-américain Thelonious Monk! \n\nL’expression « JOUER » de la musique n’aura jamais été aussi vraie! Le jeu est le véritable carburant de ce pétaradant trio qui s’exécute à la percussion, à la contrebasse et au piano. Improvisations musicales endiablées avec tout ce qui bouge (public, feuilles de papier, projections), décor dont vous êtes le héros : on laisse..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/event/38340"
      }
    ]
  },
