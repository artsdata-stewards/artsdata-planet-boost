        "@value": "article"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
        "@value": "https://nac-cna.ca/en/event/40109"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Music Room 2: Roots and the bassoon | Laurence Petitpas and Yana Ouellet | Feb 14 - 15, 2026 | Fountain Lobby"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40109/residence_laurencepetitpas_casteliers_web__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Where music sprouts and roots come alive!  \n\nWhat sounds would a tree make if it walked? Where would it go? \n\nThe bassoon is certainly not a tree, but it is the fruit of one, and it just might have some ideas about how to answer these questions… \n\nLaurence Petitpas and Yana Ouellet bring to life the possibility of dialogue between a bassoon and a string puppet in the form of root-like boots. Coming to us from Quebec City, Laurence is a multidisciplinary artist..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/en/event/40109"
      }
    ]
  },
