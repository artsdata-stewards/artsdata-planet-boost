    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "En compagnie des 11&#8239;interpr&egrave;tes, le chor&eacute;graphe grec Christos&#8239;Papadopoulos a cr&eacute;&eacute; une s&eacute;rie de mouvements simples et it&eacute;ratifs qui se transforment en une synchronicit&eacute; textur&eacute;e et stratifi&eacute;e sur la partition &eacute;lectro-minimaliste du compositeur grec Coti&#8239;K."
      }
    ],
