    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "La monumentale Neuvième de Schubert  | et Julie Boulianne chante Berlioz |  29-30 avr 2026|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38415/dscf0040_curtis_perry_(1)_cropped__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Trois choses à savoir :\n\n\n\tLa Neuvième Symphonie monumentale de Schubert est le cœur de la soirée, un vaste parcours symphonique qui monte en intensité jusqu’à une finale triomphale.\n\tLa première partie explore l’intimité du romantisme français avec Les Nuits d’été de Berlioz, interprétées par la mezzo-soprano Julie Boulianne.\n\tUne soirée qui passe de l’émotion à fleur de peau à la pleine puissance orchestrale, immersive, expressive et profondément évocatrice.\n\n\nLa soirée culmine avec la Symphonie no 9 de Franz Schubert, souvent appelée « La..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/event/38415"
      }
    ]
  },
