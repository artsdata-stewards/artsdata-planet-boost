    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Passion simple  | Récit intime d’une attente |   7- 9 mai 2026|  Studio Azrieli"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38337/tfcna2526_passionsimple_1440x810__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Voici un phénomène rare dans le cosmos théâtral, l’alignement parfait de trois astres : une brillante metteure en scène, une irradiante comédienne et le Soleil en personne, la grande écrivaine des petits anonymes, Annie Ernaux. Avec sa plume chirurgicale d’une incroyable simplicité, elle dépèce ici, pièce par pièce, un cœur consumé par la passion. Le sien.\n\nNous avons lu et relu l’œuvre de la récipiendaire du prix Nobel de littérature, mais au théâtre, l’avons-nous déjà entendue? L’implacable cheffe d’orchestre scénique Brigitte..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
