      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Julie Boulianne chante Berlioz  | et l'Orchestre du CNA interprète la 9e symphonie de Schubert |  29-30 avr 2026|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38415/3__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Votre concert en trois infos clés :\n\n\n\tLa chanteuse québécoise Julie Boulianne est reconnue pour la « touchante intimité » (Miami Herald) qu’elle apporte à la musique d’Hector Berlioz.\n\tDans le romantique Les Nuits d’été, Berlioz met en musique les poèmes mélancoliques de son ami Théophile Gautier.\n\tSur son lit de mort, Ludwig van Beethoven confiait à ses proches que la musique de Franz Schubert brillait de « l’étincelle divine du génie ».\n\n\nHector Berlioz est surtout connu pour le délire psychédélique de sa volcanique Symphonie fantastique, mais dans les..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/event/38415"
      }
    ]
  },
