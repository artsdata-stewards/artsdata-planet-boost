    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Musique intergalactique  | Aventures familiales avec l’Orchestre du CNA |   dim  3 mai 2026, 15 h 30|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38384/web-listing-whysyfi-edit2__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Préparez-vous à décoller avec l’Orchestre du CNA pour une aventure musicale intergalactique ! Vivez l’excitation et l’émerveillement de la science-fiction à travers les œuvres éclatantes telles que le thème de Star Wars de John Williams, Starburst de Jesse Montgomery et Clair de lune de Debussy. Ce voyage cosmique éveillera votre imagination et vous emmènera vers les étoiles et au-delà ! \n\nLes images diffusées sur l'écran géant OCNAtron pour amplifier la magie du spectacle vous permettront d’apprécier encore plus ces fabuleux concerts.\n\n----------------------------\n\nActivités préconcert\n\nArrivez 60 minutes avant le début du..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
