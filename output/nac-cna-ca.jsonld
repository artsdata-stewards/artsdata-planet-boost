    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Dystoh  |   sam 24 jan 2026, 20 h 00|  Quatrième Salle"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40177/dystoh_-4-min__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "DYSTOH est un nouveau duo dynamique formé de Ray Tabana et de Phil Motion, membres fondateurs du Souljazz Orchestra, triple finaliste aux prix JUNO. Mariant les congas percutantes, le rugissement du saxophone baryton et de splendides harmonies à deux voix, leur son se nourrit de la puissance et de la vibrance de l’afrobeat, de la musique latine et du reggae.\n\nNé en pleine pandémie de COVID-19, DYSTOH a fait ses premiers pas sur scène lors de l’édition 2022 du Dakar Music Expo au Sénégal, avant..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
