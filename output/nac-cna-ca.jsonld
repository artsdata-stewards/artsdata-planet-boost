      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "After the Rain  |  25fév- 7 mar 2026|  Studio Azrieli"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38312/nac-et_after-the-rain_event-thumbnail-1440x810__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Une reprise par le Théâtre anglais du CNA de la coproduction du Tarragon Theatre et de la Musical Stage Company\n\nEt si la musique pouvait guérir les plus vives blessures?\n\nSuzie ne va pas bien; ses parents sont sur son dos, sa vie personnelle est au point mort. Jusqu’au jour où un adolescent obsédé par l’idée de jouer la Gymnopédie no 1 d’Erik Satie au piano lui demande conseil et vient tout bouleverser. Suzie tentera alors de trouver son propre chemin sous..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/event/38312"
      }
    ]
  },
