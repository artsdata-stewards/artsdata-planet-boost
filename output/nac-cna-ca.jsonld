      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Hailing from Haleiwa, HI, Ron Artis II is an award-winning artist who brings a unique soulful-honest-songwriting style to the stage. Music is the Artis family trade. His father, Ron Artis I, was a renowned musician who mentored Ron at an early age, having him join him onstage by the age of 8. Having also received lessons from local musical legend, JP Smoketrain. Ron was a quick study and his exceptional skills as a guitar player were evident, soon seen as a..."
      }
    ],
