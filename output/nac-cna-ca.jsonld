    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Les Charbonniers de l'enfer  | F-I FI, N-I NI : La Tournée d'adieu |   jeu  1 oct 2026, 20 h 00|  Studio Azrieli"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41048/untitled_design__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "« Le temps passe et il y met le temps », disait une chanson. Et le temps a passé… après plus de 30 années à charbonner joyeusement ici comme ailleurs sur les braises ardentes du répertoire traditionnel québécois, 30 ans de rapaillages et de partage; 30 ans à chanter sans jamais déchanter sur l’accord du pied; 30 ans de camaraderie à l’unisson ou en harmonie; 30 ans à bien s’entendre et parfois à s’attendre. \n\nAprès tous ces temps de joie et une grosse peine marquée par..."
      }
    ],
