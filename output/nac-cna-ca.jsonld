    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Le Wild West Show de Gabriel Dumont |  18-21 oct 2017|  Théâtre Babs Asper"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/15948/wws_bandeauweb__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Texte\n\nJean Marc Dalpé, David Granger, Laura Lussier, Alexis Martin, Andrea Menard, Yvette Nolan, Gilles Poulin-Denis, Paula-Jean Prudat, Mansel Robinson et Kenneth T. Williams\n\nMise en scène\n\nMani Soleymanlou\n\nPrésenté en français avec des passages en anglais, métchif, cri et algonquin\n\nUne flamboyante épopée, fragmentée en tableaux, sur la lutte des Métis de l’Ouest canadien. Une saga hybride et divertissante à l’allure de rodéo, inspirée librement des spectacles à grand déploiement de Buffalo Bill.\n\nAu lendemain de la pendaison de son ami Louis Riel en 1885,..."
      }
