      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Clue  |   6-11 jan 2026|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38561/03_bac_seasons25-26_1440x810_nacwebsite_productionshots_clue__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Un manoir. Un meurtre. Un mystère.\n\nMeurtre et chantage sont au menu lorsque six mystérieux convives se réunissent au manoir Boddy pour une soirée qu’ils ne sont pas près d’oublier! Était-ce Madame Pervenche dans le bureau avec le couteau? Ou le colonel Moutarde dans la bibliothèque avec la clé anglaise? Inspiré du très populaire film de 1985 de la Paramount Pictures et du jeu de société emblématique de Hasbro, Clue est le polar par excellence qui vous fera mourir de rire et vous tiendra en..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/event/38561"
      }
    ]
