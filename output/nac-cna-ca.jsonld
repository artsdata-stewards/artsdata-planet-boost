      {
        "@language": "fr-ca",
        "@value": "Yamo! Yamo! Tambours de l’Afrique de l’Ouest avec Fana Soro     | Les Concerts Bout d'chou |   dim  5 oct 2025, 15 h 00|  Studio Azrieli"
      }
    ],
    "http://ogp.me/ns#image": [
