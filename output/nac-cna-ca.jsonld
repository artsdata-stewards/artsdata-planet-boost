        "@value": "Les lundis des tout-petits | French story time with Luana |  Mon, Apr 27, 2026, 10:00 am | Peter A. Herrndorf Place"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
