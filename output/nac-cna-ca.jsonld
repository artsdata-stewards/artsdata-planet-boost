    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Camions (fantômes de la liberté)  | Parcours déambulatoire |   8-19 avr 2026|  Foyer du Canal"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38325/tfcna2526_camions_1440x810__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Adultes, jeunes à partir de 9 ans bienvenu·e·s. \n\nPiste audio en français, avec passages en anglais.\n\nParcours déambulatoire intérieur/extérieur débutant au Foyer du canal. Chaque départ peut accueillir un maximum de trois personnes, et doit compter au moins un adulte. Les départs ont lieu toutes les 15 minutes, selon les horaires suivants: de 17h à 19h30 en semaine, et de 11h à 15h45 les week-ends. Vous pourrez choisir votre heure de départ lors de l’achat des billets.\n\nScoop de dernière heure : après les..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
