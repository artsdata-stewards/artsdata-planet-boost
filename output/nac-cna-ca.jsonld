    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "La Sélection de Anna  | avec l’Orchestre du CNA  |   mer 26 avr 2023, 20 h 00|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/30541/main_image_dscf9692_curtis_perry__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Programmatrice invitée : Anna Petersen\n\nL’Orchestre du Centre national des Arts est fier de présenter la deuxième édition de la nouvelle sélection de l’Orchestre du CNA, où Anna Petersen (deuxième hautbois et cor anglais) vous donnera un aperçu rayonnant et intime des œuvres qui ont façonné sa vie et son art. \n\nLa sélection d’Anna est à son image : « il s’agit de mes extraits préférés du répertoire de l’orchestre – ce sont des œuvres qui m’enthousiasment et me font ressentir toutes..."
      }
    ],
