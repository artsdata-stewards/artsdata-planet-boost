      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://nac-cna.ca/fr/event/38339"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Sous la feuille  | Spectacle multidisciplinaire pour tout-petits |  18-19 oct 2025|  Studio Azrieli"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38339/tfcna2526_souslafeuille_1440x810__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Bruits de criquets. La nuit va-t-elle bientôt s’installer sur la forêt? Aucun souci, nous sommes confortablement assis·e·s sur des fourrures, sous d’accueillantes tentes. Voici un tendre spectacle en forme d’herbier. Il est fait de scintillants instants de théâtre, de danse, de jeux d’ombres, de chant et de réflexions sur le Vivant, comme tout plein de jolies feuilles d’arbre à coller dans notre mémoire, ce livre à émerveillement. \n\nUn campeur et une campeuse se livrent à un intriguant chassé-croisé dans les bois...."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/event/38339"
      }
    ]
