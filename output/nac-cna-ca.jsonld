    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "THE INVISIBLE: Agents of Ungentlemanly Warfare"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Un portrait contemporain de sept femmes extraordinaires qui ont risqu&eacute; leur vie pour mener une guerre dangereuse en utilisant le sabotage, la propagande et l&rsquo;espionnage."
      }
