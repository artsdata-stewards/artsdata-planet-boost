    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Life Reflected |  Fri, Mar 8, 2019, 7:00 pm | Southam Hall"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/18736/nac_orchestra_lifereflected_eventpage_2__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "On International Women’s Day, the NAC Orchestra shines a light on remarkable Canadian women.\n\nFirst, discover the creative genius of Canadian throat singer Tanya Tagaq, winner of the 2014 Polaris Music Prize, in the performance of Qiksaaktuq where she improvises the lament for murdered and missing Indigenous women.\n\nThen through its signature new creation, Life Reflected, a richly emotional and immersive orchestral experience.\n\n“Canada’s rich and dynamic history has provided the setting for some of the most captivating, personal and yet universal stories I..."
      }
    ],
