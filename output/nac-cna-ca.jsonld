    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "William Prince  | Tournée Further From the Country avec Boy Golden |   ven 20 mar 2026, 20 h 00|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/39870/websize-2__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Pour son cinquième album, Further From the Country, William Prince nous propose un voyage générationnel, inspirant et métaphysique. Audacieux et lucide, cet album est celui d’un artiste capable d’exprimer avec justesse l’incertitude de notre époque. Le regard de William Prince, auteur-compositeur héritier de grandes traditions familiales et musicales, est à la fois singulier et incontournable. Il signe ici une œuvre remarquable qui frappe par la finesse de son regard, par ses réflexions, par son audace. Un album qui touche, autant par son humanité..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
