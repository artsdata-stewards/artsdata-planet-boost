    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Ms. Lauryn Hill   | Artist in Residence |   ven 19 déc 2025|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/39927/lauryn-hillxl__large.jpeg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "En raison de la forte demande, un deuxième spectacle a été ajouté à la tournée Artist In Residence de Ms. Lauryn Hill à Ottawa!\n\nGuidée par une curiosité éclectique et une soif inépuisable de sons, Ms. Lauryn Hill a imposé une signature unique : un mélange audacieux de genres et d’époques, où l’héritage du passé rencontre les voix d’aujourd’hui. Unique voix féminine des Fugees, elle a marqué l’histoire de la musique. Enregistrant des ventes exceptionnelles, le groupe devient le deuxième plus gros vendeur..."
      }
    ],
