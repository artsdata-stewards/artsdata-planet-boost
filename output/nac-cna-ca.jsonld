    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Rory Taillon  | Concerts du Midi Jukebox |   jeu 21 mai 2026, 12 h 10|  Place Peter A. Herrndorf"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41075/rory_taillon_credit_ethan_mitchell__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Depuis plus de 10 ans, le chanteur indie-folk alternatif Rory Taillon trace sa route sur la scène musicale canadienne, se produisant partout, des salons et cafés aux festivals et salles de concert. Sur son chemin, il a partagé la scène avec des artistes comme Stephen Fearing, Zeus, Jeff Martin (The Tea Party), Adrian Sutherland et Julian Taylor. Depuis 2012, il a publié deux microalbums et quatre albums, dont le dernier en date, Now It’s Quiet (2024). \n\nFormé au chant classique dès l’enfance, il maîtrise sa voix avec une précision impressionnante. Avec sa guitare chaleureuse, ses paroles envoûtantes, sa voix expressive, ses boucles..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
