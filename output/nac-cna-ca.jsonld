  {
    "@id": "https://nac-cna.ca/temporary/8c143e98-bd97-4695-98c8-5115a82fd12d",
    "https://nac-cna.ca/en/event/40152#name": [
      {
        "@language": "en-ca",
        "@value": "Polky | Fiddle-driven family fun | Feb 14 - 15, 2026 | Fourth Stage"
      }
    ],
