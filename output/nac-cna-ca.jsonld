    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Vitrine musicale Cranium 2026  |   sam  9 mai 2026, 19 h 00|  Quatrième Salle"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41084/nac_showcase_image__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "La vitrine musicale Cranium vous fait découvrir en primeur la relève de la scène musicale. Au programme de l’édition 2026 : huit prestations en direct d’artistes d’Ottawa, du Canada et du monde entier. Laissez-vous entraîner par les sonorités afrobeat, R&B, hip-hop, soul et plus encore de ces étoiles montantes! \n\nÀ l’image de la vitalité culturelle et musicale d’Ottawa, la vitrine Cranium propulse sur scène des talents de la relève appelés à marquer l’avenir de la musique et s’impose comme un véritable faiseur de tendances et un tremplin professionnel..."
      }
    ],
