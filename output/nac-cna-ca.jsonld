    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Soirée inaugurale avec Alexander Shelley  | Échos de l'enfance |  16-17 sep 2015|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/11241/cattroll-212_resize_for_web__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Alexander Shelley amorce son mandat avec deux tableaux contrastants : une vision enfantine du paradis évoquée par Mahler, et une transposition musicale du portrait que brosse de sa propre enfance Alice Munro, prix Nobel de littérature, dans sa nouvelle intitulée Dear Life (Rien que la vie). Méditation sur l’enfance et le souvenir, Dear Life met en relief les voix de la soprano Erin Wall et de Martha Henry, légende du théâtre."
      }
    ],
