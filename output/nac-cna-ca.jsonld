    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Shelley & Yeol Eum Son (Ottawa) | NACO Tour preview Concert | May 14 - 15, 2025 | Southam Hall"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/36121/8737_nac-japankorea_websitegraphics_image1_(1)__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Experience the NAC Orchestra’s next Tour - No Passport Required!\n\n\n\tThis special concert is your front-row ticket to the Orchestra’s upcoming international tour. Immerse yourself in the stunning sounds and energy that will soon captivate audiences across the Pacific.\n\tKorean pianist Yeol Eum Son — whose popularity at home rivals that of K-pop stars — returns to perform a jazzy masterpiece by Ravel.\n\n\nAfter shaking the foundations of Southam Hall with her fiery debut last season, pianist Yeol Eum Son makes her highly anticipated return..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
