      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://nac-cna.ca/fr/event/38316"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "THE INVISIBLE  | Agents of Ungentlemanly Warfare |  29avr- 9 mai 2026|  Théâtre Babs Asper"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38316/nac-et_the-invisible_event-thumbnail-1440x810__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le Théâtre anglais du CNA présente la production du Catalyst Theatre\n\nEt si sept agentes exceptionnelles avaient pour mission d’éliminer la plus grande menace de la seconde guerre mondiale?\n\nCette comédie musicale improbable est inspirée d’une véritable escouade internationale d’agentes secrètes membres du « Ministry of Ungentlemanly Warfare » pendant la Seconde Guerre mondiale. Le Catalyst Theatre réinvente leur combat pour le XXIe siècle tout en puisant dans les faits historiques, le film noir, les romans d’espionnage et la bande dessinée. Ce..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/event/38316"
      }
    ]
  },
