    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "The Sound of Music | Dec 29 - Jan 3, 2027 | Southam Hall"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40617/bac_seasons26-27_nacwebsite_eventimage_productionshots_1920x1080_som__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "For 65 years, The Sound of Music has been one of our “favorite things.” With its timeless story and irresistibly charming score, this Rodgers & Hammerstein classic isn’t just meant to be enjoyed - it’s meant to be shared. Directed by three-time Tony Award® winner Jack O’Brien (Hairspray), this vibrant and romantic tale of Maria and the von Trapp family features beloved songs like “Do-Re-Mi,” “Sixteen Going on Seventeen” and “Edelweiss.”"
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ],
