    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "The Book of Mormon  |   9-14 mar 2027|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40621/bac_seasons26-27_nacwebsite_eventimage_productionshots_1920x1080_bom__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Ajoutez ce favori du public à votre forfait Broadway Across Canada et profitez d’un accès anticipé aux billets.\n\nLes critiques sont unanimes : « La meilleure comédie musicale du siècle » (The New York Times), « Une soirée qui nous réconcilie avec les comédies musicales » (The Washington Post), « Une note parfaite! La comédie musicale la plus amusante de tous les temps » (Entertainment Weekly). Même Jimmy Fallon, du Tonight Show, s’enthousiasme : « Génial. Brillant. Phénoménal ». Vous l’avez deviné : il s’agit de THE BOOK OF MORMON, la production..."
      }
    ],
