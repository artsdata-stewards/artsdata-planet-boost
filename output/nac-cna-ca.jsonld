      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
        "@value": "https://nac-cna.ca/en/event/30555"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Cher Tchekhov | The latest Michel Tremblay | Nov 17 - 19, 2022 | Babs Asper Theatre"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/30555/cna_siteweb_banniere_1440x810px_chertchekhov__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "It’s fall, but the weather is still nice. A table has been set outside. The turkey is roasting in the oven. Everything is all set for a family dinner—except that the playwright wants to rework his play. He wants to comment on it and rewrite it in real time, as a group of actress siblings, their author brother and a critic engage in a verbal sparring match. \n\nSome of you have seen all of Michel Tremblay’s plays. You’ve been moved by..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/en/event/30555"
      }
    ]
