    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\tIsabelle Rivest\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t"
