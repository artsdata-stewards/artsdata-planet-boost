    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Genticorum  |   ven 12 déc 2025, 20 h 00|  Quatrième Salle"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/39260/celeste_(2)__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Avec ses nominations aux prix JUNO et à l’ADISQ et ses quatre Prix de musique folk canadienne, Genticorum est parmi les groupes phares de la musique traditionnelle québécoise. Pascal Gemme (violon) et Yann Falquet (guitare), les deux membres fondateurs du trio, sont également reconnus individuellement pour leur solide contribution à la scène musicale trad. S’est joint à eux depuis 2015 le multi-instrumentiste virtuose et compositeur Nicholas Williams (flûte, accordéon); le plaisir qu’ont ces trois musiciens à jouer et créer ensemble est palpable, autant sur..."
      }
    ],
