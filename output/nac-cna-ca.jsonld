    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Nigamon/Tunai"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "An immersive performance that brings the audience into the heart of a forest recreated on stage. Blending music, documentary, and the sharing of living knowledge, this poetic experience encourages the protection of lands&mdash;from the Amazon to Canada."
      }
    ],
