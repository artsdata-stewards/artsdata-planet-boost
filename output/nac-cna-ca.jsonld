    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Finaliste aux Prix de la musique de la capitale 2026   | Concerts du Midi Jukebox |   jeu 11 jun 2026, 12 h 10|  Place Peter A. Herrndorf"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41095/jb_placeholder04__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Qui foulera la scène? Restez à l’affût : un ou une artiste finaliste aux Prix de la musique de la capitale sera à l’affiche de l’un de nos Concerts du Midi Jukebox. Dévoilement imminent! Sur l’heure du lunch, retrouvez-nous pour un concert qui fait rayonner le meilleur de la scène musicale locale! \n\nPrix de la musique de la capitale \n\nLes Prix de la musique de la capitale soulignent le talent d’artistes, de créateurs, de créatrices et de gens de la profession qui animent la scène musicale..."
      }
    ],
