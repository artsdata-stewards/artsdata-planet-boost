    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Shelley & Yeol Eum Son (Toronto) | NACO Tour preview Concert |  Fri, May 16, 2025, 7:30 pm | Roy Thomson Hall"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/37132/8737_nac-japankorea_websitegraphics_image2_(1)__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Roy Thomson Hall - Toronto\n\nExperience classical music’s most iconic four opening notes in Beethoven’s Symphony No. 5, performed by the National Arts Centre Orchestra under the direction of conductor Alexander Shelley. Known for its powerful themes of triumph over adversity, Beethoven’s Fifth remains one of the most celebrated works in symphonic music.\n\nIn a delicate delight, pianist Yeol Eum Son performs Mozart’s expressive Piano Concerto No. 22.\nCompleting the program is Listening Underwater, a new work by Canadian composer Keiko Devaux, which adds..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ],
