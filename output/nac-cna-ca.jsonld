    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Les lundis des tout-petits  | Les contes de Luana |   lun 20 avr 2026, 10 h 00|  Place Peter A. Herrndorf"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40265/lundis_des_tout-petits__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Joignez-vous à nous les lundis! Les petites et grandes étoiles sont conviées au Centre national des Arts pour l’heure du conte en compagnie de Luana. Laissez-vous bercer par un conte où vous ferez la rencontre de personnages attachants, voyagerez dans des univers magnifiques et passerez un moment magique avec vos petits. Le tout sera accompagné d’un bricolage thématique et/ou de jeux rigolos.\n\nÀ propos de Luana:\n\nNée de la poussière d’étoiles, Luana est arrivée discrètement pour faire du bien aux petits... et..."
      }
    ],
