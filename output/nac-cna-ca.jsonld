  {
    "@id": "https://nac-cna.ca/temporary/37e433d4-17f2-43aa-ba39-d5caf7cbbdd6",
    "@type": [
      "http://schema.org/Event",
      "http://schema.org/DanceEvent"
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "LABOUR: PARTS+LABOUR"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Avec une distribution de cinq&#8239;interpr&egrave;tes, la nouvelle pi&egrave;ce LABOUR des co-chor&eacute;graphes Emily&#8239;Gualtieri et David&#8239;Albert-Toth met en lumi&egrave;re la force du travail des femmes qui a &eacute;t&eacute; historiquement n&eacute;glig&eacute;. Par le biais du corps, d&rsquo;une chor&eacute;graphie tr&egrave;s physique et d&rsquo;une trame narrative &eacute;vocatrice, ces femmes reprennent vie et reprennent leur place."
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g3703500"
      }
    ],
    "http://schema.org/workPerformed": [
