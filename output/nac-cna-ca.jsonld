    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Marché d’artisanat printanier  | Édition spéciale pour la fête des Mères |   dim 26 avr 2026, 11 h 00|  Place Peter A. Herrndorf"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40846/spring_market_01__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Prenez part au marché d’artisanat printanier, véritable vitrine des talents locaux. Vous y trouverez toute une sélection de créations originales d’artistes, artisans et artisanes de la région. Une excellente occasion de soutenir les petites entreprises de la communauté. Profitez-en pour faire vos emplettes pour la fête des Mères!\n\nLe marché est ouvert de 11 h à 16 h.\n\nEntrée gratuite. Stationnement sur place. Lieu accessible."
      }
    ],
