    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Rinse"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Rinse est un monologue irr&eacute;v&eacute;rencieux et ludique d&rsquo;Amrita Hepi, co&eacute;crit avec Mish&#8239;Grigor, reprend un mythe originel en &eacute;voquant des histoires personnelles sur la danse, l&rsquo;art, le f&eacute;minisme, le d&eacute;sir, l&rsquo;amour, la culture populaire et l&rsquo;histoire coloniale."
      }
    ],
