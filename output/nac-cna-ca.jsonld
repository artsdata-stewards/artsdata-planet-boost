    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Assistez à un cours de danse de la compagnie!\n\nClass on Stage est une occasion unique d’observer les interprètes du Ballet national du Canada lors de leur cours quotidien, transposé sur scène. Admirez leurs incroyables prouesses physiques, leur détermination et leur esprit d’équipe."
      }
    ],
