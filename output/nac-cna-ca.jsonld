    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Les Sentinelles  | Île féministe pour public trié sur le volet  |   8- 9 sep 2025|  La Nouvelle Scène Gilles Desjardins — Studio A"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/39223/leYa_magnien_-_dscf4921__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Deux jeunes femmes créent un forum en ligne, comme une petite île numérique isolée, juste pour elles. Un refuge à l’abri du monde et de sa violence, comme un rempart salutaire qui les protège toutes les deux. Ce havre de paix au féminin attire rapidement l’attention, suscitant toutes les convoitises. Plusieurs veulent s’emparer d’un morceau de cette île, cherchant carrément à envahir cet espace numérique dont le contrôle échappe peu à peu à ses créatrices.\n\nPortée par une grande distribution issue..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
