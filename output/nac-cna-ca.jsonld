      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "LABOUR  | PARTS+LABOUR |  29-30 avr 2026|  Studio Azrieli"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38365/labour_01__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "La force motrice du féminin\n\nPARTS+LABOUR est assurément une des voix audacieuses et affirmées de la danse contemporaine. S’inspirant de la littérature, de la mythologie et de la philosophie, les co-chorégraphes Emily Gualtieri et David Albert-Toth valorisent dans leur approche artistique la collision des idées, transportant le public dans des récits captivants qui évoquent le sens de la communauté, la solitude ainsi que la mémoire individuelle et collective.\n\nAvec une distribution de cinq interprètes, leur nouvelle pièce LABOUR met en lumière la force du..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
