    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Jane Siberry  |  22-23 avr 2026|  Studio Azrieli"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/39947/jane_siberry__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Jane Siberry, auteure-compositrice-interprète canadienne, a récemment été intronisée au Panthéon des auteurs et compositeurs canadiens et récompensée du Prix du patrimoine Polaris pour son album mythique The Speckless Sky. Après 10 ans loin des studios, elle signe son retour avec un 16e album, One Season: In the Thicket of Our Own Unconsciousness, à paraître en novembre 2025, suivi d’une tournée nord-américaine qui fera une halte au CNA. Connue pour ses succès Calling All Angels et Mimi On The Beach, cette artiste visionnaire continue de réinventer l’indépendance artistique. "
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
