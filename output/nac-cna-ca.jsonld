    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Atelier de dessin de danse pow-wow  |   mar  9 jun 2026, 18 h 00|  Quatrième Salle"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41352/cropped__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Sortez papiers et crayons et venez saisir toute l’énergie et la beauté des danses de pow-wow et des tenues cérémonielles. À vos côtés, des animateurs et animatrices vous aideront à recréer les corps en mouvement et les détails des costumes.\n\nSéance de deux heures pour les artistes de niveau intermédiaire et avancé. N’oubliez pas d’apporter votre matériel pour participer. Du matériel sera prêté sur place, au besoin.\n\nCet atelier est gratuit! Cet atelier est réservé aux personnes souhaitant dessiner.\n\nSi vous avez des..."
      }
    ],
