      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Storgårds, Saint-Saëns & Thibaudet | with the NAC Orchestra | Feb 11 - 12, 2026 | Southam Hall"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38409/14__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Three things to know:\n\n\n\tEmbark on a voyage of discovery with captivating music inspired by the wonder of world travel.\n\tCamille Saint-Saëns’s “The Egyptian” Concerto takes you on a journey along the Nile, where you’ll hear the boat’s engine and croaking frogs.\n\tFranz Joseph Haydn composed his final symphony, known as the “London” Symphony, 36 years after completing his First Symphony.\n\n\nWritten in Cairo during a winter holiday, Camille Saint-Saëns’s final concerto for solo piano and orchestra, “The Egyptian,” finds the composer reflecting on a lifetime of..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
