    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Shelley & Yeol Eum Son (Toronto)  | Concert prélude à la Tournée OCNA |   ven 16 mai 2025, 19 h 30|  Roy Thomson Hall"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/37132/8737_nac-japankorea_websitegraphics_image2_(1)__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Roy Thomson Hall - Toronto\n\nFaites l'expérienced des quatre notes d’ouverture les plus emblématiques de la musique classique dans la Symphonie n° 5 de Beethoven, interprétée par l’Orchestre du Centre national des Arts sous la direction du chef d’orchestre Alexander Shelley. Connue pour ses thèmes puissants de triomphe sur l’adversité, la Cinquième de Beethoven demeure l’une des œuvres les plus célèbres de la musique symphonique.\n\nDans un délice délicat, la pianiste Yeol Eum Son interprète l’expressif Concerto pour piano n° 22 de Mozart.\nLe..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
