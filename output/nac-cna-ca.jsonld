    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Katherine Levac  | Représentation supplémentaire de « L'homme de ma vie » |   sam  7 mar 2026, 19 h 30|  Théâtre Babs Asper"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40172/katherinelevac-hdmv-1600x1064-vf01_@alexisgoncalves__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Après une tournée triomphale, Katherine Levac est de retour au CNA pour une soirée de comédie pure. Si vous n’avez pas eu la chance de la voir à Gatineau en novembre, voici l’occasion rêvée! Ne manquez pas l’une des dernières représentations de son spectacle L’homme de ma vie.\n\nKatherine Levac, humoriste incontournable de sa génération remonte enfin sur les planches pour notre plus grand plaisir. Son premier spectacle Velours avait ravi unanimement public et critiques, et sa la captation de son spectacle Grosse nous a..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/event/40172"
      }
    ]
  },
