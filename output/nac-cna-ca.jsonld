    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Storgårds, Saint-Saëns et Thibaudet  | avec l'Orchestre du CNA |  11-12 fév 2026|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38409/14__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Votre concert en trois infos clés :\n\n\n\tPréparez-vous à un périple riche en découvertes dans un programme captivant inspiré des merveilles du voyage.\n\tLe Concerto « L'Égyptien » de Camille Saint-Saëns vous entraîne le long du Nil, évoquant tour à tour le bruit des hélices du navire et le coassement des grenouilles.\n\tFranz Joseph Haydn a composé sa dernière symphonie, dite « de Londres », 36 ans après sa première.\n\n\nÉcrit au Caire pendant des vacances hivernales, le dernier concerto pour piano solo et..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
