    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Marina Orsini  | Découvrez sur scène son premier album Reconstruire les saisons. |   jeu 28 mai 2026, 19 h 30|  Théâtre Babs Asper"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40093/untitled_design__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "En février dernier, Marina Orsini dévoilait enfin ses écrits à travers un premier album profondément ancré dans la tradition de la chanson francophone, Reconstruire les saisons. Dès sa sortie, l’album a rencontré un succès retentissant, atteignant le sommet des ventes francophones sur iTunes et se classant en tête des ventes au Canada cette même semaine. Salué par la critique, rappelons que l’album est le fruit d’une précieuse collaboration avec Catherine Major — réalisatrice, compositrice et pianiste —, les paroliers Jeff Moran et Nelson Minville ainsi qu’avec Paul Piché, Richard Séguin et Manuel Tadros avec qui Marina interprète respectivement trois sublimes..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
