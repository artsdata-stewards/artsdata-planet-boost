    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "GANNA  | avec DIVKA |   jeu 11 jun 2026, 20 h 00|  Quatrième Salle"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40597/untitled_design_(3)__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "D’origine ukrainienne, la chanteuse et compositrice GANNA (Ganna Gryniva) mêle traditions folk ukrainiennes, arrangements jazz, sonorités électroniques et boucles musicales en direct. Dans UTOPIA, son album acclamé à la production moderne, la Berlinoise d’adoption fait dialoguer mélodies ancestrales, chants rituels et sons captés dans les villages d’Ukraine pour explorer résilience, matriarcat et liens aux racines.\n\nGANNA s’est produite dans de grands festivals européens – jazzahead!, WOMEX et Reeperbahn – et a parcouru l’Australie, avec des prestations remarquées au Festival de Sydney et à WOMAdelaide. Elle décrit sa musique..."
      }
    ],
