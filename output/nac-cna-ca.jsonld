    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Atelier de dessin de danse pow-wow  |   mar  9 sep 2025, 18 h 00|  Salle de la lanterne Al Zaibak"
      }
    ],
    "http://ogp.me/ns#image": [
