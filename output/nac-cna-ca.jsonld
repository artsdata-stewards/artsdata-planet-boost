    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://nac-cna.ca/fr/event/38372"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Tout ce qu’il reste  | Vías |  13-14 mar 2026|  Centre Carleton Dominion-Chalmers"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38372/_0001_viYas_tout_ce_qu_il_reste_credit_robin_pineda_gould__7527__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "La poésie en mouvement\n\nDans le spectaculaire sanctuaire de l’église du Centre Carleton Dominion-Chalmers, les chorégraphes Paco Ziel et Diana León (Vías) invitent le public à redécouvrir l’œuvre de Franz Schubert sous un angle nouveau. Nourris de la complexité émotive caractéristique des lieder de Schubert, les artistes déploient la relation intime qu’entretiennent la danse, la musique et la poésie, à travers une danse physique et exaltée. S’entremêlant librement avec le chant et les sons du baryton Olivier Bergeron et de la pianiste Chloé Dumoulin, les deux interprètes..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/event/38372"
      }
    ]
  },
