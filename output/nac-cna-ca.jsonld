    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Peter and the Wolf | NACO Family Adventures |  Sun, Nov 16, 2025, 3:30 pm | Southam Hall"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38382/web-listing-peterwolf-edit2__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Embark on a musical adventure with Peter and the Wolf, where a brave young boy and his spirited animal friends come alive through the orchestra’s instruments. Listeners will buzz with excitement during Nikolai Rimsky-Korsakov’s “Flight of the Bumblebee” and meet a host of charming animal companions on this symphonic safari— perfect for curious young explorers and music lovers of all ages!    \n\nWe hope you will enjoy the giant images on the NACOtron screen as they capture and magnify the magic of these..."
      }
    ],
