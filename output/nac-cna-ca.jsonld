    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Le Ballet national du Canada – Spectacle YOU dance pour les familles  | La création d’un ballet, pas à pas |   sam 25 avr 2026, 12 h 00|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40885/2023_169_(300)-2__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le programme YOU dance du Ballet national du Canada vise à initier les jeunes et les familles à l’art théâtral du ballet.\n\nInterprétée par les artistes du programme d’apprentissage RBC du Ballet national du Canada, cette représentation d’une heure sur la scène de la Salle Southam d’œuvres classiques comme contemporaines, avec accompagnement au piano et animation, est une formidable occasion d’apprendre pour les petits et les grands.\n\nLe public aura l’occasion de rencontrer les artistes du programme d’apprentissage RBC, d’en apprendre davantage sur..."
      }
    ],
