  {
    "@id": "https://nac-cna.ca/temporary/c4a3d635-5e79-4d1b-9646-163f376d655b",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Shelley et la &laquo; R&eacute;surrection &raquo; de Mahler"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Pr&eacute;parez-vous pour une exp&eacute;rience musicale &eacute;pique s&rsquo;int&eacute;ressant &agrave; des questions intemporelles&nbsp;: Qu&rsquo;est-ce que la vie? Qu&rsquo;est-ce que la mort? Qu&rsquo;est-ce qui nous attend dans l&rsquo;au-del&agrave;?"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g11367640"
