    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Dvořák’s New World Symphony | & Kawasaki Plays Brahms | Oct 15 - 16, 2025 | Southam Hall"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38405/dscf0079_curtis_perry_cropped__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Three things to know:\n\n\n\tXian Zhang, the Seattle Symphony’s first female Music Director, returns to Ottawa to conduct a program rooted in Eastern European folk music.\n\tThe NAC Orchestra’s beloved concertmaster, Yosuke Kawasaki, steps into the spotlight to perform Johannes Brahms’s Violin Concerto in D major.\n\tAn interstellar symphony: Astronaut Neil Armstrong brought a recording of Dvořák’s Symphony No. 9, “From the New World,” aboard the Apollo 11 mission to the moon!\n\n\nIn “From the New World,” Antonín Dvořák sought to create a portrait of America, inspired..."
      }
    ],
