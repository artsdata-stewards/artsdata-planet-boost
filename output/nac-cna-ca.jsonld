    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Disney’s Beauty & The Beast  |   8-13 jun 2027|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40619/bac_seasons26-27_nacwebsite_eventimage_productionshots_1920x1080_batb__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Soyez de la fête! La comédie musicale BEAUTY AND THE BEAST de Disney est de retour en Amérique du Nord plus de 25 ans après sa dernière tournée. Entre romance et splendeur, ce conte intemporel et enchanteur se réinvente sur scène avec de nouveaux décors éblouissants, des costumes somptueux et une musique récompensée aux Oscar et finaliste aux prix Tony qui comprend les classiques « Be Our Guest » et « Beauty and the Beast ». Cette nouvelle production réunit l’équipe artistique originale primée aux..."
      }
    ],
