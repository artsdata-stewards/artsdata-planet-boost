  {
    "@id": "https://nac-cna.ca/fr/event/41087",
    "http://ogp.me/ns/fb#app_id": [
      {
        "@language": "fr-ca",
        "@value": "123254964370141"
      }
    ],
    "http://ogp.me/ns#type": [
      {
