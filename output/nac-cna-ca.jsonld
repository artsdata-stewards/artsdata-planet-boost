      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
        "@value": "https://nac-cna.ca/en/event/38417"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Carneiro, Mendelssohn & Goodyear | with the NAC Orchestra | May 27 - 28, 2026 | Southam Hall"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38417/11__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Three things to know:\n\n\n\tAfter her seismic performances of two Igor Stravinsky ballets with the NAC Orchestra, Joana Carneiro returns to conduct Felix Mendelssohn’s “Reformation” Symphony.\n\tTo commemorate an important anniversary of the Protestant Reformation, Mendelssohn quotes a popular Lutheran hymn in his symphony’s finale.\n\tStewart Goodyear is both a pianist and composer—just like Mozart, whose Piano Concerto No. 23 Goodyear will bring to life on the Southam Hall stage. \n\n\nA heartfelt work guided by the composer’s devout Protestant faith, Felix Mendelssohn’s “Reformation” Symphony..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/en/event/38417"
      }
    ]
  },
