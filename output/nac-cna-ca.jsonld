    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Turkwaz  | Beau, bon, gratuit |   mer 12 aoû 2026, 12 h 00|  Atrium O’Brien"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40975/turkwazpromo3__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Apportez votre dîner pour une pause musicale gratuite en milieu de journée au lumineux Atrium! Trouvez-vous un endroit confortable pour écouter d’incroyables artistes. De quoi vous donner une bonne dose d'énergie pour le reste de la journée!\n\nTurkwaz, c’est la rencontre de quatre musiciennes et chanteuses aux influences multiples : des chants d’amour mystiques soufis à la musique thrace exaltante. Chacune d’entre elles apporte sa touche personnelle : Maryem Hassan Tollar fait vibrer son héritage arabe, Jayne Brown et Sophia Grigoriadis..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
