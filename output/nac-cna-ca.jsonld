    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Les lundis des tout-petits | French story time with Luana |  Mon, Dec 22, 2025, 10:00 am | Peter A. Herrndorf Place"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
