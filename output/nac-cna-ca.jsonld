    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Prairie Comeau  |   sam 21 mar 2026, 20 h 00|  Quatrième Salle"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40178/web_resize__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Prairie Comeau, c’est deux amoureux de la chanson, nostalgiques, un peu anachroniques, qui trimbalent le souvenir d’un temps où la musique était un verbe, un geste qui se transmettait, un grand livre qu’on gardait précieusement dans le banc de piano.\n\nAu fil des années et des concerts, la démarche du groupe se précise. Les deux auteurs-compositeurs décident de rouvrir le banc de piano et de plonger dans les archives de La Bonne Chanson. Le microalbum L’emprunt(e), réalisé par Nicolas Boulerice (Le Vent du Nord) et..."
      }
    ],
