    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Dance for All: Movement Workshop  | For anyone 40 + |  Thu, Feb 19, 2026, 12:00 pm | Peter A. Herrndorf Place"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40245/dance_workshop_(1)__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "We invite anyone aged 40+ to join a free dance workshop over the lunch hour on February 19. This workshop will be led by Lia Witjes Poole, a Canadian-born member of the renowned Berlin-based company Dance On Ensemble.\n\nOn February 18 and 19, with its outstanding cast of 11 dancers aged 40 and over, Dance On Ensemble takes the Theatre stage with MELLOWING, a hypnotic creation by Greek choreographer Christos Papadopoulos.\n\nThis is an exceptional opportunity to learn from a pro! Don’t miss this chance..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
