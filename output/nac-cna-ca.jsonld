    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Ahmed Moneka | Moneka Arabic Jazz |  Thu, Feb 19, 2026, 8:00 pm | Fourth Stage"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40179/web_resize__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Having previously performed for NAC audiences with the larger version of his global ensemble, Ahmed Moneka returns with a rare quartet performance that highlights the intensity of his compositions and their rhythmic and melodic fusion, while giving the music a more intimate, personal focus. Joined by Selcuk Suna (saxophone), Demetrios Petsalakis (oud/keyboard), and Max Senitt (drums), Moneka channels his Afro-Sufi heritage and Baghdad roots through powerful musical storytelling. This configuration foregrounds the interplay between the musicians, the emotional depth of the..."
      }
    ],
