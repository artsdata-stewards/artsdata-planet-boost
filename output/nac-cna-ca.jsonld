    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Comedy Band Camp de Josh Johnson  |  12-13 jun 2026|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40199/3840x2160__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "À mi-chemin entre le monologue humoristique et le concert, le spectacle de Josh Johnson est une expérience collective qui respire la nostalgie des camps d’été. Comme il n’a jamais eu droit à son été au camp, il l’a monté de toutes pièces, rien que pour vous.\n\nSuivi par plus de 10 millions de personnes sur les réseaux sociaux, Josh Johnson a été qualifié par WIRED de « gars le plus drôle du Web ». Originaire de Louisiane et installé à Chicago, cet acteur, humoriste et auteur..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
