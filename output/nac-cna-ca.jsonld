    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Medusa Quartet   | Beau, bon, gratuit |   jeu 13 aoû 2026, 12 h 00|  Atrium O’Brien"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40974/medusa2025_02__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Apportez votre dîner pour une pause musicale gratuite en milieu de journée au lumineux Atrium! Trouvez-vous un endroit confortable pour écouter d’incroyables artistes. De quoi vous donner une bonne dose d'énergie pour le reste de la journée! \n\nTapez du pied, riez, vibrez et laissez-vous surprendre par des sonorités inédites avec le Medusa Quartet, un quatuor de folk de chambre aussi électrisant qu’inclassable. Armées de leurs instruments ancestraux aux allures de violon – capables de faire frissonner même les mélomanes les plus..."
      }
    ],
