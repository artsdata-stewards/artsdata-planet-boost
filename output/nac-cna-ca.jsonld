    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Récital sur le piano de Glenn Gould   | Cécile Desrosiers et Thomas Nicholson |   mer 13 mai 2026, 13 h 00|  Foyer de la Mezzanine de la salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41382/cd_318_-_photo_2__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Célébration de Glenn Gould, de son legs musical inestimable et de son cher piano Steinway CD 318, ce concert de salon met en vedette Cécile Desrosiers et Thomas Nicholson, qui interpréteront des airs de Bach, Haendel, Haydn, Jacquet de La Guerre, Debussy, et autres compositeurs. Cette sélection reflète les goûts musicaux de Gould, tout particulièrement son amour pour Bach. \n\nPiano chouchou de Gould, le CD 318 est conservé au CNA en tant qu’artefact, mais aussi en tant qu’instrument vivant depuis son transfert de Bibliothèque et Archives Canada en 2012. Ce concert, fruit d’une collaboration entre le Département des archives du CNA et l’équipe administrative de l’OCNA, témoigne à..."
      }
    ],
