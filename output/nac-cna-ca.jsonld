    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Finale de la Bourse de l'Orchestre du CNA 2026  | Instruments à vent, aux cuivres, aux timbales et aux percussions |   mar 21 avr 2026, 13 h 00|  Centre Carleton Dominion-Chalmers"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40204/dscf5974-curtis-perry-2_web__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Grâce à la générosité des membres de l’Orchestre du CNA, d’autres organismes et de particuliers, des lauréats et lauréates seront retenus comme finalistes à l’issue des demi-finales pour les distinctions suivantes :\n\n\n\tLa Bourse de l’Orchestre du CNA\n\tLe Prix de la Fondation Crabtree\n\tLe Prix des Amis de l’Orchestre du CNA\n\tLe Prix Vic Pomer de l’Orchestre du CNA\n\tLe Prix Dorothy M. Horwood\n\tLe Prix Evelyn Greenberg des Amis de l’Orchestre du CNA\n\tLe Prix Piccolo\n\tLe Prix Sturdevant Traits d’orchestre de l’Orchestre du CNA\n\n\nOrganisé pour la première fois en 1981,..."
      }
    ],
