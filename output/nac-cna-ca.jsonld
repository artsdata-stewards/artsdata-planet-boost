    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/39348/my_fair_lady_goes_to_town__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Prepare for an extraordinary evening of big band excellence! The Ottawa Jazz Orchestra presents a thrilling programme featuring two remarkable suites, each lending unique sounds and styles.\n\nOur programme begins with an exquisite “appetizer”: a delightful nonet suite penned by composer Terry Vosbein. This charming work comprises eight distinct musical creations, written for a unique nine-piece band with pairings of alto and baritone saxophones, trumpet and trombone, and French horn and tuba, all supported by a dynamic piano trio.\n\nFor our grand..."
      }
    ],
