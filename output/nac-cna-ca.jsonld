    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Nuits claires | A creative collection from sea to sea | Sep 12 - 13, 2025 | Azrieli Studio"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38335/tfcna2526_nuitsclaires_1440x810__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "This show is also part of the Zones Théâtrales programming.\n\nOver the course of a year, 12 playwrights—1 per month—from Vancouver to Caraquet were chosen by 12 theatre companies to join a writing relay with mysterious rules, the main one being to write about and during the night. This show presents a collage of these writers’ nocturnal endeavours, compiled into one thrilling theatrical happening to celebrate the dreamers we are.\n\nWhen the sun goes down, what keeps us up? The roaring engines of..."
      }
    ],
