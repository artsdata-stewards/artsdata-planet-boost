    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/39697/websize__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Joyce N’sana is a Canadian singer-songwriter originally from the Congo, whose work embodies what she refers to as “Afrobluehop,” a bold blend of blues, rock, hip hop, Afropop and a touch of reggae. Radio-Canada named her one of its Révélations, praising her “incredible intensity.” Her small stature belies the power of her voice, which carries a message of peace and strength. \n\nOver the years, N’sana has racked up achievements and awards for her performances from Syli d’Or, MUZ, Landmark, Vue sur la..."
      }
    ],
