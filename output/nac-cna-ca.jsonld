    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Inn Echo  |   ven  5 déc 2025, 20 h 00|  Quatrième Salle"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/39327/websize_inn_echo__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Qu’est-ce qui a réuni Karson McKeown (Ottawa, Ontario), Tuli Porcher (Victoria, Colombie-Britannique) et Tom Gammons (Butte, Montana) sur l’Île-du-Prince-Édouard? La dynamique scène musicale traditionnelle! Dans la plus pure tradition folk, le trio s’est rencontré lors d’une séance dans un pub local. Inn Echo a vu le jour en 2019, une histoire d’amour transcontinentale entre le violon, le violoncelle et la guitare. \n\nOutre leurs origines géographiques différentes, ce sont surtout leurs personnalités musicales singulières qui font la force du trio. Le violon de Karson est..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
