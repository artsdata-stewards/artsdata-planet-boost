    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Boubé  |   sam  7 fév 2026, 20 h 00|  Quatrième Salle"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40192/web_resize-min__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Né au Niger, Boubé a grandi à Iferouane, un village aux portes du désert du Ténéré qui accueille le plus important festival de musique touareg. C’est dans cette ambiance hypnotisante, au pied des monts Tamgak, que Boubé apprend la musique. Il s’initie au chant et aux instruments emblématiques de la musique touareg, genre connu à l’international sous le nom de « blues du désert » et chanté par les nomades berbères du Sahara central.\n\nMusicien autodidacte, il commence à tourner dès l’âge de..."
      }
    ],
