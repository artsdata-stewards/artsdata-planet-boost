    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "The Outsiders  |  20-25 jui 2027|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40620/bac_seasons26-27_nacwebsite_eventimage_productionshots_1920x1080_to__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Lauréat de quatre prix Tony en 2024, dont celui de la meilleure comédie musicale, THE OUTSIDERS vous embarque à Tulsa, dans l’Oklahoma, en 1967, où Ponyboy Curtis, son meilleur ami Johnny Cade et leur famille du clan rebelle des Greaser rêvent de s’inventer un avenir dans un monde qui ne veut pas d’eux. Sous la direction de Danya Taymor, récompensée aux prix Tony, cette comédie musicale séduit par sa mise en scène « rafraîchissante, brute et d’une efficacité redoutable » (The New York Times). Avec sa « chorégraphie..."
      }
    ],
