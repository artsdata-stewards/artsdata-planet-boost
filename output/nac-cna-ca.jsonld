      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "asses.masses | A video game for the stage  |  Sat, Sep 13, 2025, 1:00 pm | Arts Court — Theatre"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/39221/asses_masses_1__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "This show includes 4 intermissions.\n\nThe donkey (Equus asinus) has played a prominent role in the religions, colonization, warfare and economy of many important civilizations. But what role does the donkey play today? asses.masses follows a herd of donkeys who have been made redundant in a post-industrial society built on mechanization. The asses embark on an epic adventure to reclaim their jobs and, above all, their place in society. After engagements around the world, from Berlin to Vancouver by way of London..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/en/event/39221"
      }
    ]
  },
