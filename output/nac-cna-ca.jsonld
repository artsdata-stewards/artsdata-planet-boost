    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Une performance immersive qui plonge les spectateurs au c&oelig;ur d&rsquo;une for&ecirc;t recr&eacute;&eacute;e sur sc&egrave;ne. Alliant musique, documentaire et transmission savoirs vivants, cette exp&eacute;rience po&eacute;tique incite &agrave; la protection des territoires, de l&rsquo;Amazonie au Canada."
      }
