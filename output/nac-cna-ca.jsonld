    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Musique au clair de lune du Th&eacute;&acirc;tre Platypus"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Pr&eacute;parez-vous pour une aventure symphonique touchante o&ugrave; rayonnent la magie, la musique et l&rsquo;imagination! Joignez-vous &agrave; l&rsquo;Orchestre du CNA et au mondialement c&eacute;l&egrave;bre Th&eacute;&acirc;tre Platypus pour Musique au clair de lune, un p&eacute;riple fantastique qui r&eacute;v&egrave;le la beaut&eacute; des sons dans les endroits les plus inattendus.&nbsp;"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g18681260"
