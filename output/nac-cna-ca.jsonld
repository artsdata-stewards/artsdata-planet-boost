    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Sherri Harding  | Lancement de l'album Storyland avec comme invité spécial Shawn Tavenier |   mar 16 jun 2026, 19 h 30|  Studio Azrieli"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40844/sherri_harding_promo_photo_2026_(hr)__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Joignez-vous à Sherri Harding lors d’une soirée mémorable célébrant la sortie de son nouvel album fort attendu, Storyland. \n\nAccompagnée d'un groupe de douze musiciens de renom, Sherri Harding offre sur scène une performance vocale unique, riche et nuancée.\n\nÀ la source de ses influences blues, soul et R&B, le spectacle propose un mélange captivant de compositions exceptionnelles et d'une énergie hors pair.\n\nUne seule représentation. À ne pas manquer!"
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
