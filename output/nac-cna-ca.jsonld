        "@value": "Tout ce qu&rsquo;il reste"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dans le spectaculaire sanctuaire de l&rsquo;&eacute;glise du Centre Carleton Dominion-Chalmers, les chor&eacute;graphes Paco&#8239;Ziel et Diana&#8239;Le&oacute;n (V&iacute;as) invitent le public &agrave; red&eacute;couvrir l&rsquo;&oelig;uvre de Franz&#8239;Schubert sous un angle nouveau.&nbsp;"
      }
