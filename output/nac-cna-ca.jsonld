    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Al Qahwa  |   jeu 28 mai 2026, 20 h 00|  Quatrième Salle"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40837/maryem_tollar_folk_alliance_2025_choice_je7a5739_(1)__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Al Qahwa ravive l’esprit des grands cafés du Moyen-Orient – ces espaces foisonnants où musique, poésie et idées audacieuses se mêlaient jusqu’au petit matin. Entre traditions musicales arabes, jazz, rythmes du monde et improvisation audacieuse, l’ensemble torontois propose une musique à la fois ancienne et résolument actuelle – une musique de migration, de mémoire et de rencontres.\n\nMaryem Tollar, figure centrale du groupe, possède une voix qui ne connaît pas de frontières. Née au Caire et élevée au Canada, la chanteuse..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
