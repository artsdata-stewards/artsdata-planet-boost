      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Série Sicard | Série Musique populaire et variétés"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-packages.s3.amazonaws.com/40804/sicard_series_header__tablet-small.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Grâce à la générosité de John et Pina Sicard, la Quatrième Salle s’impose comme le tremplin par excellence de la relève musicale d’ici. Ce don ouvre grand les portes aux nouveaux talents de la scène musicale et leur donne la visibilité nécessaire pour franchir un nouveau cap. Venez découvrir ces artistes extraordinaires dans l’une des meilleures salles de concert d’Ottawa."
      }
    ],
