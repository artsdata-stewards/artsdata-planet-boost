    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40069/ndidi_o__5_2025_photo_credit_rachel_pick__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Deux fois finaliste aux prix JUNO et couronnée Artiste blues de l’année aux Prix de la musique de l’Ouest canadien, Ndidi Onukwulu, alias Ndidi O, compte cinq albums solos à son actif et plusieurs simples avec le duo trip-hop BOGA. De la scène locale à l’international, elle s’est produite dans de nombreux festivals et salles de concert. Ses chansons ont trouvé leur place dans les séries Orange is the New Black, The Flash (CW), Cloak & Dagger (Hulu) et Self..."
      }
    ],
