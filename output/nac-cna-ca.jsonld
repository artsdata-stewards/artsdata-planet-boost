    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Dirty Dancing en Concert  | Parce que certaines danses durent toujours |   sam  4 avr 2026, 20 h 00|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/39699/dd_1920x1080__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Vous avez été sous le charme de leur première danse, le temps est maintenant venu de renouveler ce moment magique. Dirty Dancing en Concert fait revivre l’histoire d’amour emblématique de Baby et Johnny sur grand écran, avec une touche d’originalité. Regardez le film remastérisé dans sa version numérique sur un écran géant, tandis qu’un orchestre et des chanteurs interprètent les chansons en synchronicité avec chaque scène du film. Au fur et à mesure que l’histoire de Baby et Johnny se..."
      }
    ],
