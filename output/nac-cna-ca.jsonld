    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "La reine de la soul : un hommage à Aretha Franklin  | avec l’Orchestre du CNA |  12-14 mar 2026|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38428/8789_nac_pops_aretha_gold__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Votre concert en trois infos clés :\n\n\n\tCe joyeux et vibrant hommage à Aretha Franklin comprend toutes vos chansons favorites de la reine de la soul et des artistes qui l’ont inspirée.\n\tVedette de la scène et de l’écran à la voix puissante et envoûtante, Capathia Jenkins donnera vie aux plus grands succès d’Aretha Franklin sur la scène de la Salle Southam.\n\tSelon Capathia Jenkins, Aretha Franklin « avait un talent sans égal. C’est un grand honneur de suivre ses traces et de pouvoir lui..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
