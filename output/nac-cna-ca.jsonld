  {
    "@id": "https://nac-cna.ca/temporary/a4697567-e2fc-4922-b9f2-a87392566b92",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Va falloir toujours toujours"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Deux pros de la danse et un troisi&egrave;me concurrent (qu&rsquo;on n&rsquo;attendait pas) sont d&rsquo;attaque pour remporter le grand d&eacute;fi de la famille PARFAITE! Mais &agrave; ce jeu, est-ce qu&rsquo;on a le droit de rater son coup? Ce p&eacute;tillant spectacle philosophico-pop s&egrave;me la pagaille dans nos id&eacute;aux perfectionnistes. R&eacute;flexions sur le vivre-ensemble et confessions au lave-vaisselle!&nbsp;"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g13547100"
      }
    ],
    "http://schema.org/workPerformed": [
      {
        "@id": "https://nac-cna.ca/fr/event/38341#CreativeWork"
      }
    ],
