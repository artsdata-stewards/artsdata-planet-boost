    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Classic Albums Live : Madonna  | The Immaculate Collection |   ven 21 aoû 2026, 20 h 00|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40599/web_resize__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Classic Albums Live est un projet regroupant de talentueux instrumentistes qui reprennent sur scène – note par note – les grands classiques de la musique. Classic Albums Live fait l’impasse sur les costumes et les imitations pour se concentrer exclusivement sur la musique.\n\nThe Immaculate Collection est la toute première compilation des grands succès de la chanteuse américaine Madonna, paru le 12 novembre 1990 sous l’étiquette Sire Records. On y retrouve 15 de ses titres phares des années 1980, ainsi que deux morceaux inédits, « Justify My Love » et « Rescue..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
