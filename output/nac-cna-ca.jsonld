    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Canadian Improv Games 2026  | Finales nationales |   sam 18 avr 2026, 19 h 30|  Théâtre Babs Asper"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40899/cig_cover_image__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Les jeunes talents les plus prometteurs du Canada. Une imagination sans limites. Pas de scénario.\n\nAssistez à la grande finale des Canadian Improv Games 2026! Après une semaine de compétition intense, les cinq meilleures équipes de niveau secondaire de tout le pays montent sur la scène du Centre national des Arts pour une soirée de pure magie improvisée. Du drame palpitant à la comédie hilarante, ces élèves créent des univers entiers en s’inspirant uniquement de vos suggestions.\n\nLes cinq meilleures équipes canadiennes..."
      }
    ],
