    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place à la danse : atelier de mouvement  | Pour les 40 ans et plus |   jeu 19 fév 2026, 12 h 00|  Place Peter A. Herrndorf"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40245/dance_workshop_(1)__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le jeudi 19 février, à l’heure du midi, nous invitons toutes les personnes âgées de 40 ans et plus à participer à un atelier de danse gratuit mené par Lia Witjes Poole, membre canadienne de la compagnie Dance On Ensemble établie à Berlin.\n\nLes 18 et 19 février, le Dance On Ensemble composé de 11 interprètes exceptionnels âgés de 40 ans et plus présente au Théâtre MELLOWING, une pièce signée par le chorégraphe grec Christos Papadopoulos.\n\nCet atelier est une occasion exceptionnelle..."
      }
    ],
