    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Shelley & Yeol Eum Son (Ottawa)  | Concert prélude à la Tournée OCNA |  14-15 mai 2025|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/36121/8737_nac-japankorea_websitegraphics_image1_(1)__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Embarquez pour la tournée de l’Orchestre du CNA – Pas de passeport nécessaire !\n\n\n\tCe concert exceptionnel est votre billet au premier rang pour la prochaine tournée internationale de l’Orchestre du CNA. Plongez dans des sonorités éblouissantes et une énergie qui envoûteront bientôt le public de l'autre côté du Pacifique.\n\tLa pianiste coréenne Yeol Eum Son – dont la popularité dans son pays natal rivalise avec celle des vedettes de K-pop – retrouve l’OCNA pour un chef-d’œuvre aux accents jazz de Ravel.\n\n\nAprès avoir fait..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
