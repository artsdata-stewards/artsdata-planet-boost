    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Join us at the Fourth Stage, the NAC’s home for emerging, inclusive and boundary-pushing artists. This relaxed, casual venue is Ottawa’s top spot to discover artists from across the country, across the globe, and those making waves on the local scene. Grab a drink from the bar, settle into the comfortable atmosphere and enjoy the show!"
      }
