    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "KILLABEATMAKER  | Beau, bon, gratuit |   mer  8 jui 2026, 12 h 00|  Atrium O’Brien"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40965/killabeatmaker_pic_4__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Donnez du goût à vos lunchs! Offrez-vous une pause musicale gratuite le midi à l’Atrium O’Brien. Apportez votre dîner, installez-vous confortablement et laissez-vous emporter par le talent d’artistes incroyables! \n\nÀ la croisée des rythmes colombiens, de l’afrobeat, de l’amapiano et de la cumbia,  \n\nKillabeatmaker propose sur scène une ambiance groove, mystique et électrisante mettant à l’honneur les instruments traditionnels emblématiques de sa terre natale. \n\nSur scène, un trio prend forme : Guadalupe Giraldo (batterie, gaïta colombienne, chant), Julián Ramírez (percussions, chœurs), et Hilder..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
