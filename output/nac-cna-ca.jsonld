    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Pirates des Caraïbes : La malédiction de la Perle noire de Disney, ciné-concert  | avec l’Orchestre du CNA |   9-11 jui 2026|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38422/dc_poc_12_(1)__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Présenté en version originale anglaise avec sous-titres en français\nVeuillez noter que les billets Moinsde30 sont en nombre limité pour ces représentations.\n\nL’Orchestre du Centre national des Arts présentera Pirates des Caraïbes : La malédiction de la Perle noire en concert , une projection du film accompagnée par l’orchestre qui interprète la trame sonore de Klaus Badelt et de Hans Zimmer en direct.\n\nLe compositeur primé aux Oscars et aux GRAMMY Hans Zimmer et son équipe de production sont derrière la trame sonore de chaque aventure de la série Pirates..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
