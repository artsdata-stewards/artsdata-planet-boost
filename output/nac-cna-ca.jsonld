      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://nac-cna.ca/fr/event/38564"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Mamma Mia!  |  28jui- 2 aoû 2026|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38564/01_bac_seasons25-26_1440x810_nacwebsite_productionshots_mma__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Une mère. Une fille. Trois pères possibles.\nEt un mariage que vous n’êtes pas près d’oublier!\n\nSituée sur une île grecque paradisiaque et ensoleillée, cette magnifique histoire d’amour, d’amitié et d’identité est rythmée par les plus grands succès d’ABBA. On y suit la quête d’une jeune fille qui, à la veille de son mariage, cherche à découvrir l’identité de son père qu’elle n’a jamais connu, invitant trois hommes du passé de sa mère sur l’île où ils n’ont pas mis les pieds depuis des..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/event/38564"
      }
    ]
