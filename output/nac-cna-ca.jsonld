    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Les sessions WolfGANG #28  | Une folle soirée de musique de chambre |   sam 21 mar 2026, 21 h 00|  Club SAW"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
