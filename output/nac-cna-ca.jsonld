    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Jeux théâtraux avec Chancz Perry   | Beau, bon, gratuit |   sam 11 jui 2026, 10 h 00|  Place Peter A. Herrndorf"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40951/chancz_crop__event_1440__event_1440__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Laissez libre cours à votre créativité et embarquez dans une formidable aventure faite de mouvements et d’improvisations avec notre atelier interactif gratuit! Peu importe votre niveau, le célèbre artiste de théâtre Chancz Perry saura vous outiller pour explorer le monde des jeux théâtraux comme jamais auparavant. \n\nCet atelier dynamique vous plongera dans un univers d’exploration, où le mouvement devient un moyen d’expression. Grâce à l’apprentissage fondé sur le questionnement, Chancz Perry vous guidera à travers une série d’exercices qui éveilleront votre..."
      }
    ],
