      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Se pourrait-il qu&rsquo;une peinture &eacute;trangement lumineuse r&eacute;v&egrave;le au grand jour des secrets ensevelis sous leur propri&eacute;t&eacute;?"
      }
    ],
