    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Interview with Michel Tremblay  |  Thu, Nov 17, 2022, 5:00 pm | Peter A. Herrndorf Place"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/32314/tremblay_michel---creYdit-laurent-theillet-(1)-2__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Audiences in the Ottawa–Gatineau region are invited to meet Michel Tremblay, who will be at the National Arts Centre on November 17 for a series of free public events. \n\nHost Julien Morissette, artistic director of Transistor Média and producer of French Theatre’s “Plus que du théâtre” podcasts, will talk with Michel Tremblay about the themes and characters in his most recent works, including Cher Tchekhov. And perhaps a few memories of the National Arts Centre since its opening in 1969 will emerge! \n\nThe interview will also..."
      }
    ],
