      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Atelier de fabrication de capteurs de rêves  | avec Bougie Birch |   ven 10 oct 2025, 17 h 30|  Atelier Shenkman Smith"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/39575/dreamcatcher_-_event_image_5__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Cet événement est présenté en anglais.\n\nVenez participer à l’atelier de fabrication de capteurs de rêves organisé par Bougie Birch à l’Atelier Shenkman Smith du CNA. Dans cette séance de une heure et demie à deux heures, l’artiste et formatrice autochtone Ashley Clark vous aidera à fabriquer votre propre capteur de rêves. On s’occupe du matériel; il ne manque plus que votre inspiration!\nPlongez dans l’art des Autochtones, découvrez la résilience de leurs communautés dans l’histoire et participez à une expérience manuelle..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/event/39575"
      }
    ]
