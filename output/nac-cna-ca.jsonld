    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Matteo Lane  | Tournée « We Gotta Catch Up » |   ven  6 nov 2026, 19 h 00|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41169/matteolane_ott,on_2426x1365__large.jpeg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Artiste tout-terrain, Matteo Lane propose des spectacles uniques où l’humour, la virtuosité musicale et la liberté artistique s’entremêlent avec brio. De la scène des clubs new-yorkais aux salles combles à travers le monde, l’humoriste de Chicago a conquis des lieux aussi emblématiques que le Carnegie Hall et le Kennedy Center. Son dernier spectacle d’humour a été lancé sur Hulu en mai 2025.\n\nSalué pour « son audace et son authenticité désarmante » (The Advocate) et repéré parmi les 10 humoristes à surveiller..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
