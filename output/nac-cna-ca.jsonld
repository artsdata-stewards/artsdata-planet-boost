    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Beaded Earring Workshop | with Stephanie Peltier |  Sat, Mar 14, 2026, 11:00 am | Atelier Shenkman Smith"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
