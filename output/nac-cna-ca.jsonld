    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Julie Boulianne Sings Berlioz | & the NAC Orchestra performs Schubert's 9th | Apr 29 - 30, 2026 | Southam Hall"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38415/3__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Three things to know:\n\n\n\tFrench Canadian singer Julie Boulianne is renowned for the “touching intimacy” (Miami Herald) she brings to Hector Berlioz’s music.\n\tBerlioz’s romantic collection of songs, Les Nuits d'été, sets the melancholy poetry of his friend Théophile Gautier to music.\n\tOn his deathbed, Ludwig van Beethoven told close friends that Franz Schubert’s music carried “the spark of divine genius.”\n\n\nHector Berlioz is best known for the drug-fueled fever dream he created with his volcanic Symphonie fantastique, but in his song collection Les..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ],
