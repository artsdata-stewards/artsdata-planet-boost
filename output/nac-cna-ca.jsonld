    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Book signing with Michel Tremblay |  Thu, Nov 17, 2022, 6:00 pm | Peter A. Herrndorf Place"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/32316/tremblay_michel---creYdit-laurent-theillet-(1)__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Meet the playwright and have him sign your copy of Cher Tchekhov (or another of his plays or novels)! The Librairie du Soleil will also be on hand with a selection of Michel Tremblay’s works for sale, including Cher Tchekhov and his new novel La Shéhérazade des pauvres. "
      }
    ],
