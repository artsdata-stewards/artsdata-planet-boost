    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Shelley, Ehnes, Altstaedt  | Clara, Robert, Johannes : Coda |   jeu  2 jui 2026, 20 h 00|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38433/20__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Votre concert en trois infos clés :\n\n\n\tExplorez les liens personnels et artistiques entre trois géants du romantisme allemand : Johannes Brahms et Clara et Robert Schumann.\n\tLes deux concertos au programme sont les dernières œuvres pour orchestre écrites par Johannes Brahms et Robert Schumann.\n\tClara Schumann n’était pas qu’une compositrice de talent; elle a aussi été l’une des pianistes les plus sollicités d’Europe pendant 63 ans.\n\n\nLa relation entre Johannes Brahms et les Schumann (Clara et Robert, tous deux compositeurs et pianistes) est..."
      }
    ],
