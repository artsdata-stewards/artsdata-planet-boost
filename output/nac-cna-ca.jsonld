    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Mozart’s Don Giovanni  | with the NAC Orchestra | Jun 15 - 17, 2023 | Southam Hall"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/31880/mozart__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Opera is back at the NAC with a thrilling performance of Mozart’s Don Giovanni, featuring a superstar cast of soloists and Ottawa’s amazing and ever-versatile Ewashko Singers under the direction of Laurence Ewashko. \n\nDon Giovanni is undeniably one of Mozarts’s supreme achievements, but did you know it is also widely regarded as the finest opera of all time? Overflowing with comedy, tragedy, drama, and the supernatural, Don Giovanni recounts the conquests and ultimate downfall of the womanizing Giovanni, all wrapped in..."
      }
    ],
