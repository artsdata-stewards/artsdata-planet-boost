    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Shelley, Beethoven & Korngold | with Simone Lamsma |  Tue, Jan 20, 2026, 8:00 pm | Southam Hall"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38432/metaadtemplate_6_(3)__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "PROGRAM UPDATE:\n\nDue to injury, the Kanneh-Mason Trio had to cancel their performance.\n\nWe are pleased to announce that violinist Simone Lamsma will join the NAC Orchestra to perform Korngold’s Violin Concerto. For your convenience, original ticket orders for this concert remain valid. If you wish to exchange tickets or request a refund, please contact the NAC Box Office. All exchanges or refunds must be requested no later than 24 hours before the concert.\n\nA powerful blend of innovation, virtuosity, and symphonic storytelling.\n\nViolinist Simone Lamsma steps in..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
