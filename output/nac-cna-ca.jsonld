    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Gabriel Dumont’s Wild West Show  | Oct 18 - 21, 2017 | Babs Asper Theatre"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/15948/wws_bandeauweb__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Written by\n\nJean Marc Dalpé, David Granger, Laura Lussier, Alexis Martin, Andrea Menard, Yvette Nolan, Gilles Poulin-Denis, Paula-Jean Prudat, Mansel Robinson and Kenneth T. Williams\n\nDirected by\n\nMani Soleymanlou\n\nPresented in French with passages in English, Mitchif, Cree and Algonquin\n\nA flamboyant epic, constructed as a series of tableaux, about the struggles of the Métis in the Canadian West. A multilayered and entertaining saga with a rodeo vibe, loosely based on Buffalo Bill’s legendary outdoor travelling show.\n\nIn 1885, following the hanging of his friend Louis Riel, bison hunter Gabriel Dumont fled to the United States. There he was recruited by..."
      }
    ],
