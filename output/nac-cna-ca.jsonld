    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "The Sound of Music  |  29déc- 3 jan 2027|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40617/bac_seasons26-27_nacwebsite_eventimage_productionshots_1920x1080_som__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Soixante-cinq ans après sa création, The Sound of Music continue de captiver le monde! Avec son histoire intemporelle et ses mélodies irrésistibles, ce classique de Rodgers et Hammerstein est une expérience qui se vit et se partage. Sous la direction du triple lauréat d’un prix Tony Jack O’Brien (Hairspray), Maria et la famille von Trapp prennent vie dans une fresque romantique et vibrante, portée par les chansons qui ont traversé les générations : « Do-Re-Mi », « Sixteen Going on Seventeen » et « Edelweiss »."
      }
    ],
