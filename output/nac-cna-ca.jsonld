    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Opening Night with Alexander Shelley | Echoes of Childhood | Sep 16 - 17, 2015 | Southam Hall"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/11241/cattroll-212_resize_for_web__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Alexander Shelley opens his tenure with two different takes on life and childhood: Mahler’s symphonic setting of a child’s view of heaven contrasting Nobel Prize-winner Alice Munro’s portrait of her own childhood as depicted in her short story Dear Life. Commissioned as a meditation on childhood and memory, Dear Life features soprano Erin Wall and the voice of legendary Canadian actor Martha Henry."
      }
    ],
