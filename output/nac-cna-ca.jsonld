    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "A Beautiful Noise: The Neil Diamond Musical  |   6-11 avr 2027|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40618/bac_seasons26-27_nacwebsite_eventimage_productionshots_1920x1080_abn__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Créée avec Neil Diamond, A beautiful noise raconte l’incroyable ascension d’un enfant de Brooklyn devenu icône du rock américain. Avec plus de 120 millions d’albums vendus, des classiques indémodables comme America, Forever in Blue Jeans et Sweet Caroline, une pluie de récompenses et des concerts à guichets fermés dans le monde entier, la carrière de Neil Diamond trouve son apogée sur la scène de Broadway et en tournée dans toute l’Amérique du nord."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
