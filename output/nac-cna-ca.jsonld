    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Prairie Comeau  |   sam 21 mar 2026, 20 h 00|  Quatrième Salle"
      }
    ],
    "http://ogp.me/ns#image": [
