    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Cette compagnie, compos&eacute;e d&rsquo;un ensemble&nbsp;multiethnique, pr&eacute;sente un r&eacute;pertoire diversifi&eacute; et avant-gardiste, comportant des &oelig;uvres n&eacute;oclassiques embl&eacute;matiques de George Balanchine et du directeur artistique Robert Garland &agrave; des cr&eacute;ations innovantes plus contemporaines."
      }
