    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Can we be friends? | Kinderconcerts Series |  Sun, Jan 11, 2026, 3:00 pm | Azrieli Studio"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38392/tlamitiemesamours_-jmc-tamphotography-46-scaled__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Imaginative, smart, and full of enthusiasm, three musicians go in search of the perfect chord!\n\nThree talented musicians work together to create an unusual concert. But personalities clash and conflicts arise. With the help of music and a story featuring uncomplicated puppets, they manage to resolve their conflicts and find harmony by rediscovering the profound meaning of love and friendship.\n\nPresented in association with Jeunesses Musicales Canada.\n\nPerformance in French at 3 pm\nPerformances in English at 11 am and 1:30 pm\n\nThis performance was..."
      }
    ],
