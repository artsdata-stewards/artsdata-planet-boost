      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\tMélanie Binette\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t"
      },
      {
        "@language": "fr",
        "@value": "\n\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\tMélanie Binette\n\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t"
