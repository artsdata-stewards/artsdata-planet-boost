    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Atelier de boucles d'oreilles perlées en forme de fraise  | avec Jessica Dumont |   mer 24 sep 2025, 17 h 30|  Atelier Shenkman Smith"
