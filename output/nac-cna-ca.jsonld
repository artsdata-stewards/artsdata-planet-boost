      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Procession   | Le Ballet national du Canada  |  23-25 avr 2026|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38364/procession5_(1)__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Avec l’Orchestre du CNA\n\nUne multiplicité singulière\n\nLe duo de chorégraphes Bobbi Jene Smith et Or Schraiber prend d’assaut le monde de la danse. Le Ballet national du Canada a le privilège d’être l’hôte d’une nouvelle production intégrale créée pour la compagnie afin de marquer l’ouverture de sa saison 2025–2026. Procession explore le rituel du mouvement en formation et célèbre le pouvoir de la performance. Dotée d’une nouvelle partition d’inspiration baroque, infusée d’une touche de modernité, la création est une commande audacieuse et exaltante qui..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/event/38364"
      }
    ]
  },
