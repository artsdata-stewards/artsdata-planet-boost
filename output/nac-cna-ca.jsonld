      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Turkwaz & Medusa   | Beau, bon, gratuit |  11-13 aoû 2026|  Terrasse en bois"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40970/turkwazpromo3__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Rejoignez-nous sous les étoiles! Accédez à notre terrasse en bois depuis la rue Elgin ou le pont Mackenzie King et savourez les meilleurs rythmes offerts (gratuitement!) à Ottawa cet été. \n\nQue se passe-t-il quand quatre musiciennes passionnées rencontrent quatre chanteuses extraordinaires? Une alchimie musicale inédite qui redonne voix aux gorgones et aux sorcières, réveillant tout leur pouvoir légendaire. Ensemble, Medusa et Turkwaz mêlent polyphonie, harmonie, hétérophonie et jeux rythmiques audacieux pour donner naissance à l’« hagérophonie » – un univers sonore..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/event/40970"
      }
    ]
  },
