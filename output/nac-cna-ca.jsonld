        "@language": "fr-ca",
        "@value": "Atelier de fabrication de capteurs de rêves  | avec Bougie Birch |   ven 15 mai 2026, 17 h 30|  Atelier Shenkman Smith"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
