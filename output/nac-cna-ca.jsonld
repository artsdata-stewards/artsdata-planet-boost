      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Sur Appel | Holding life in your hands  | Sep 9 - 13, 2025 | Théâtre de l’Île"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/39228/sur_appel_1__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Site-specific / outdoor performance. Meeting point: Outside Théâtre de l'Île\n\nDepartures take place every 45 minutes from 6:30pm to 9:30pm. You will be able to choose your departure time when purchasing tickets.\n\nSet inside a moving ambulance, Sur Appel (“on call”) is an immersive, intensely powerful experience. Audience members are invited to witness the fragility of human life in a race against time. When the medical world intersects with theatre, shadows, objects, and gestures interweave in a sensory journey that blurs the lines between..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ],
