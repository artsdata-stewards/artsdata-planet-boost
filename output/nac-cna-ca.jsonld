  {
    "@id": "https://nac-cna.ca/temporary/b78db11c-488e-4ade-af9c-47453d1682cd",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Rose"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le dramaturge prim&eacute; Tomson Highway cl&ocirc;t son &laquo; cycle de la r&eacute;serve &raquo; avec un dernier chapitre puissant, Rose. M&ecirc;lant humour, musique et &eacute;motions, cette premi&egrave;re mondiale suit les destins de trois Rose qui s&rsquo;unissent pour r&eacute;clamer justice et prot&eacute;ger leur identit&eacute; et l&rsquo;&acirc;me de leur communaut&eacute;."
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g1008120"
      }
    ],
    "http://schema.org/workPerformed": [
