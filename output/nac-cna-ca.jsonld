  {
    "@id": "https://nac-cna.ca/fr/event/38341",
    "http://ogp.me/ns/fb#app_id": [
      {
        "@language": "fr-ca",
        "@value": "123254964370141"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://nac-cna.ca/fr/event/38341"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Va falloir toujours toujours  | Danse-théâtre |  30-31 mai 2026|  Studio Azrieli"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38341/tfcna2526_vafalloirtoujourstoujours_1440x810__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Jonathan et Nina sont d’attaque pour remporter le grand défi! Deux pros de la danse, ça ne rigole pas! Mais un troisième concurrent déboule et ça se complique un peu. Beaucoup. Au jeu de la famille PARFAITE, est-ce qu’on a le droit de rater son coup? Ce spectacle philosophico-pop qui fusionne danse et théâtre sème la pagaille dans nos idéaux perfectionnistes. Réflexions sur le vivre-ensemble et confessions au lave-vaisselle. \n\nUne curieuse maîtresse de cérémonie a pris possession de l’appartement et impose..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/event/38341"
      }
    ]
  },
