    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Atelier de fabrication de capteurs de rêves  | avec Bougie Birch |   mer 17 sep 2025, 17 h 30|  Salon Ruddy"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
