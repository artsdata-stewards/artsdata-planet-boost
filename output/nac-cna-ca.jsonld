    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Malaka |  Wed, Feb 18, 2026, 7:30 pm | Fourth Stage"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40094/malaka_live_grand_marais_-_credit_anthony_sion__(1)__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Malaka is a duo formed by two sisters. They bring their distinctive voices to stripped-down arrangements combined with rich, intertwined vocals that explore life in its natural state. With a sound somewhere between folk and soul, every performance is an invitation to appreciate the simplicity of meaningful music. Malaka gives music a new dimension as the sisters’ voices merge to create a spellbinding musical experience, a new land to discover. "
      }
    ],
    "http://ogp.me/ns/fb#admins": [
