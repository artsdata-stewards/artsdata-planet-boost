  {
    "@id": "https://nac-cna.ca/temporary/b7d011fa-2eb7-43db-b730-567b96713e5a",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Querelle de Roberval"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Avec fulgurance, Olivier Arteau embrasse la premi&egrave;re adaptation th&eacute;&acirc;trale du sulfureux roman de Kev Lambert, portant &agrave; bras-le-corps les luttes ouvri&egrave;res, autochtones et queer. Sur fond de sexe et de r&eacute;volte, cette trag&eacute;die syndicale hautement inflammable dynamite joyeusement toutes nos forteresses id&eacute;ologiques et derniers fantasmes champ&ecirc;tres &agrave; l&rsquo;&eacute;gard des r&eacute;gions."
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g3065120"
      }
    ],
    "http://schema.org/workPerformed": [
      {
        "@id": "https://nac-cna.ca/fr/event/38338#CreativeWork"
      }
    ],
