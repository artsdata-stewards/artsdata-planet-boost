  {
    "@id": "https://nac-cna.ca/temporary/aceb0e09-8cd9-4da3-bbf4-91d86bd25b0f",
    "@type": [
      "http://schema.org/Event",
      "http://schema.org/DanceEvent"
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Karanfil/Carnation: Laura Taler / Grimm Pictures "
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Laura&#8239;Taler nous propose une aventure cin&eacute;matique&nbsp;contextuelle dans le monde th&eacute;&acirc;tral souterrain du CNA, l&agrave; o&ugrave; les r&ecirc;ves intimes prennent forme dans la sph&egrave;re publique.&nbsp;Tout en &eacute;voquant un clich&eacute; de&nbsp;Bronislava&#8239;Nijinska, vieux de 99&#8239;ans,&nbsp;l&rsquo;artiste&nbsp;s&rsquo;interroge sur la repr&eacute;sentation, les dimensions concr&egrave;tes et faillibles de la langue ainsi que l&rsquo;art consistant &agrave; exhiber son &ecirc;tre int&eacute;rieur.&nbsp;"
      }
    ],
