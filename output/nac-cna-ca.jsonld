      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "La Vida Loca  | avec l’Orchestre du CNA |  21-23 mai 2026|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38427/8956_nac_naco25-26_lavidaloca_weblistingimage_hr__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Préparez-vous à chanter et à danser sur les plus grands succès de la vague pop latine des années 1990 et 2000!\n\nLa Vida Loca rend hommage à Enrique Iglesias, Gloria Estefan, Santana, Ricky Martin et bien d’autres. Le chef d’orchestre Enrico Lopez-Yañez, les chanteurs Ender Thomas et Jackie Mendez, le trompettiste José Sibaja et le percussionniste Luisito Quintero se joignent à l’Orchestre du CNA pour un programme haut en couleur avec de tout nouveaux arrangements symphoniques de Lopez-Yañez et Sibaja."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/event/38427"
      }
    ]
  },
