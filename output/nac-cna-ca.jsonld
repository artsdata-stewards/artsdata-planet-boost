    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Gauntlet Mitt Workshop | with Colleen Nolan | Nov 4 - 6, 2025 | Atelier Shenkman Smith"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/39493/leather_gauntlet_event_image__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "The Gauntlet Mitt Workshop with Colleen Nolan offers a unique opportunity to learn the traditional art of crafting your own pair of beautifully warm, handmade gauntlet mitts.\n\nParticipants will enjoy hands-on guidance through each step of the process—from selecting materials to sewing and finishing—with optional beadwork to personalize your creation. Whether you're a beginner or an experienced crafter, all are welcome.\n\nThis workshop is more than just crafting; it’s about sharing stories, laughter, and cultural connection in a supportive, community-focused environment. Leave..."
      }
    ],
