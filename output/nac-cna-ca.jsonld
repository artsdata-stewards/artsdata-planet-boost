    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Louis-Jean Cormier  |   sam 25 avr 2026, 20 h 00|  Studio Azrieli"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40072/pheonix_pagliacci__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "C’est au sein de la formation Karkwa que Louis-Jean Cormier franchit les grandes portes de l’industrie musicale à la fin des années 1990. Une aventure qui se termine (pour mieux recommencer plus tard) avec le troisième album du groupe, Les Chemins de verre, en 2011. Son premier album solo, Le Treizième Étage, voit le jour en septembre 2012. Notamment portée par le simple Si tu reviens, Les grandes artères sort trois ans plus tard, lui permettant de poursuivre son ascension, moussée par sa présence comme coach à La Voix. En 2020, c’est le décès de son père qui..."
      }
    ],
