    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://nac-cna.ca/fr/event/39363"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Ottawa Jazz Orchestra  | Beyond the Cool |   jeu 23 avr 2026|  Quatrième Salle"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/39363/diane_with_bass_and_drums__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Ne manquez pas ce sublime programme d'un soir présenté par l'Ottawa Jazz Orchestra ! Découvrez le son somptueux de notre nonette, qui met en vedette des jumelages uniques du saxophone alto et baryton, de trompette et trombone, et de cor et tuba, le tout encadré par un trio de piano.\n\nNous commencerons par une interprétation complète de la fameuse suite « Birth of the Cool », rendue célèbre par Miles Davis, Gil Evans, Gerry Mulligan et le nonette original lors de..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/event/39363"
      }
    ]
  },
