    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Les lundis des tout-petits  | Les contes de Luana avec les Glamottes du Bal de Neige |   lun 16 fév 2026, 10 h 00|  Place Peter A. Herrndorf"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
