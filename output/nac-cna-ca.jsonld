    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Rum Ragged   | Beau, bon, gratuit |  14-15 jui 2026|  Terrasse en bois"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40948/rum_ragged_2_(credit__jeff_fasano)_(5)__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Sous les couleurs du soleil couchant, laissez la musique donner le ton à votre soirée – gratuitement! Accédez à notre terrasse en bois à partir de la rue Elgin, du canal Rideau et du pont Mackenzie-King.   \n\nFormé par Aaron Collis et Mark Manning, le groupe Rum Ragged revisite avec audace la musique folk emblématique de sa terre natale, Terre-Neuve-et-Labrador, dans l’est du Canada. Bouzouki, violon, bodhrán, banjo, guitare et accordéon à boutons à l’avant-plan, ces nouveaux porte-étendards de la musique de la..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/event/40948"
      }
    ]
  },
