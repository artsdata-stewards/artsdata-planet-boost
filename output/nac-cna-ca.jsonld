    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "In Conversation with Alexander Shelley and Jean-Jacques Van Vlasselaer | Musically Speaking | Sep 16 - 17, 2015 | Canal Lobby"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/11387/alexandershelley-cattroll-194-xl__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "These wide-ranging conversations are sure not only to expose the compelling backstories behind the season’s key works but also to reveal more about the Orchestra’s new Music Director and his vision. Musically Speaking will also feature Q&A sessions after select performances, giving you the chance to share your thoughts and ask questions of the performers."
      }
    ],
