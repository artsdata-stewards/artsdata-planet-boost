    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "& Juliet  |  24-29 mar 2026|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38562/fphz0_li__large.jpeg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Comédie musicale à succès la plus drôle de Broadway, & Juliet revisite l’une des plus belles histoires d’amour de tous les temps. Et si Juliette n’était pas tombée folle amoureuse de Roméo et avait eu une deuxième chance de vivre et d’aimer à sa façon? Ce spectacle acclamé par le public a été créé par l’auteur récompensé par un prix Emmy de Schitt’s Creek. Sa trame sonore reprend des succès pop iconiques composés par Max Martin et ses compères, dont “Since U Been..."
      }
    ],
