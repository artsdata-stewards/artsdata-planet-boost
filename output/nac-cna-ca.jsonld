      }
    ]
  },
  {
    "@id": "https://nac-cna.ca/fr/series/tf-25-26-grand-public",
    "http://ogp.me/ns/fb#app_id": [
      {
        "@language": "fr-ca",
        "@value": "123254964370141"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://nac-cna.ca/fr/series/tf-25-26-grand-public"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Grand Public | Série Théâtre français du CNA"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-packages.s3.amazonaws.com/39373/grand-public_header--david__tablet-small.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Que ce soit dans une création collective d’un océan à l’autre ou dans un terrain de jeu et de bataille, dans le portrait émouvant d’un grand clown déchu ou dans le récit intime d’une attente piégée par l’amour, dans une tragédie shakespearienne revisitée par un illustre magicien scénique ou une envoûtante œuvre chorale autour de la notion de visage humain, notre saison 2025-2026 est une invitation à retourner à l’essentiel en s’entourant de mots, de poésie, de pas de danse,..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
