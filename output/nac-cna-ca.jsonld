        "@value": "article"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://nac-cna.ca/fr/event/38350"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Nigamon/Tunai  | Productions Onishka |  10-13 sep 2025|  Théâtre Babs Asper"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38350/nigamon_web_emily_cooper__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Que signifie écouter quand la terre parle elle-même?\n\nNigamon/Tunai est un puissant manifeste poétique porté par Émilie Monnet (d’origine anishinabe et française) et Waira Nina (de la Nation Inga, dans l’Amazonie colombienne). Cette œuvre immersive réunit public et artistes sur une scène peuplée d’arbres vivants, de bassins d’eau et d’instruments en cuivre qui chantent au rythme de l’eau qui coule.\n\nNigamon/Tunai nous confronte à la pollution de l’eau et à la défiguration des territoires de l’Amazonie colombienne causées par des compagnies canadiennes..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/event/38350"
      }
    ]
  },
