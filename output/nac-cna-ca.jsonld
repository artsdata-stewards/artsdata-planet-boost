    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40066/pheonix_pagliacci__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Fièrement née au Manitoba, Jocelyne Baribeau est une voix marquante de la scène folk et roots canadienne. Autrice-compositrice-interprète, elle explore les récits de la francophonie rurale avec une plume à la fois tendre, lucide et teintée d’humour. Depuis ses débuts en 2009 avec un projet jeune public destiné aux communautés francophones de l’Ouest (Madame Diva), jusqu’à ses projets solos et collaboratifs — notamment le duo Beauséjour —, Jocelyne trace un parcours artistique engagé et profondément ancré dans son territoire. Lauréate du prix Artiste francophone de..."
      }
    ],
