      }
    ]
  },
  {
    "@id": "https://nac-cna.ca/fr/event/35375",
    "http://ogp.me/ns/fb#app_id": [
      {
        "@language": "fr-ca",
        "@value": "123254964370141"
      }
    ],
    "http://ogp.me/ns#type": [
