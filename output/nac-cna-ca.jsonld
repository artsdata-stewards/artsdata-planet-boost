      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Sechile Sedare  | Beau, bon, gratuit |   mer 29 jui 2026, 12 h 00|  Atrium O’Brien"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40973/sese_promo_2025-photo_credit_olya_shendrik_dsc09042__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Offrez-vous une pause musicale gratuite le midi à l’Atrium O’Brien. Apportez votre dîner, trouvez-vous un endroit confortable et laissez la musique faire le reste. Faites de cette expérience la vôtre! \n\nSechile Sedare propose un voyage musical où le passé et le présent se rencontrent, où l’intime dialogue avec l’universel. Formé des frère et sœur Jay et Leela Gilday, le duo de musique roots contemporaine transcende les genres et fait vibrer l’âme de sa terre natale. Sechile Sedare, dont le nom signifie..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
