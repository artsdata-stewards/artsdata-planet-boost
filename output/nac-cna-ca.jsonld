    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Jaeden Izik-Dzurko joue Rachmaninov  | et Appalachian Spring avec l'Orchestre du CNA |  18-19 mar 2026|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38410/17__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Votre concert en trois infos clés :\n\n\n\tOriginaire de la Colombie-Britannique, le pianiste Jaeden Izik-Dzurko a fait ses débuts orchestraux à l’âge de 14 ans!\n\tLe troisième concerto pour piano et orchestre de Sergueï Rachmaninov est si difficile que le pianiste pour qui il a été écrit n’a jamais osé le jouer!\n\tAppalachian Spring d’Aaron Copland dépeint l’Amérique rurale du XIXe siècle avec de grandes envolées lyriques et des danses qui vous feront taper du pied.\n\n\nLe Concerto pour piano no 3 de Sergueï Rachmaninov est adoré des mélomanes..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/event/38410"
      }
    ]
