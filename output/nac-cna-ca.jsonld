  {
    "@id": "https://nac-cna.ca/temporary/a463df49-4ae3-493d-8095-fb575c165ab8",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Passion simple"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Un ph&eacute;nom&egrave;ne rare dans le cosmos th&eacute;&acirc;tral, comme l&rsquo;alignement parfait de trois astres : une brillante metteure en sc&egrave;ne (Brigitte Haentjens), une irradiante com&eacute;dienne (Julie Le Breton) et le Soleil en personne (l&rsquo;&eacute;crivaine Annie Ernaux). Dans ce r&eacute;cit autobiographique, cette derni&egrave;re d&eacute;p&egrave;ce, pi&egrave;ce par pi&egrave;ce, un c&oelig;ur consum&eacute; par la passion."
      }
    ],
