  {
    "@id": "https://nac-cna.ca/temporary/cf0532ba-5add-4597-97a3-b36ef8be60fc",
    "@type": [
      "http://schema.org/Event",
      "http://schema.org/MusicEvent"
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "cicadas"
      }
    ],
    "http://schema.org/description": [
      {
