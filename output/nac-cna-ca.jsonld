      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Baobab  | Conte musical et marionnettique |  13-14 déc 2025|  Studio Azrieli"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38323/tfcna2526_baobab_1440x810__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Cet incontournable classique du théâtre jeunesse déboule sur notre scène, juste à temps pour les Fêtes, avec sa panoplie d’instruments traditionnels africains, ses marionnettes merveilleuses et ses chants contagieux qui font danser l’âme et le corps. On y suit d’un pas joyeux l’aventure d’un tout petit garçon chargé d’une immense mission : apaiser la colère du Soleil.  \n\nQuatre interprètes de feu, à la fois chanteur·se·s, marionnettistes et instrumentistes, font pulser le cœur battant de ce savoureux conte inspiré de la tradition orale..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/event/38323"
      }
    ]
  },
