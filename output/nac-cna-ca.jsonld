        "@language": "en-ca",
        "@value": "https://nac-cna.ca/en/event/40108"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Music Room 1: Drones & Tones | Joël Dazé and Jesse Stewart  | Feb 14 - 15, 2026 | Babs Asper Theatre"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40108/emma_campbell_schuster_2025_img_7362_bigbang_jesse_et_joel__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Keyboard melodies and percussion energy! Two incredible Ottawa artists are teaming up for a special BIG BANG Music Room. \n\nJesse Stewart is an award-winning composer and percussionist who is no stranger to this joyful festival, having performed at the inaugural Ottawa edition back in 2019. Jesse is an inventive musician cooking up the best beats to accompany the very talented Joël Dazé on synthesizer. Joël is a freelance musician and composer, as well as the Accessibility Coordinator here at the NAC.  \n\nJesse..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/en/event/40108"
      }
    ]
  },
