    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/31880/mozart__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "L’opéra est de retour au CNA avec une interprétation palpitante de Don Giovanni de Mozart, mettant en vedette une distribution de solistes vedettes et les incroyables Ewashko Singers d'Ottawa sous la direction de Laurence Ewashko.\n\nDon Giovanni est indéniablement l’une des réalisations suprêmes de Mozart, mais saviez-vous qu'il est également largement considéré comme le plus bel opéra de tous les temps? Débordant de comédie, de tragédie, de drame et de surnaturel, Don Giovanni raconte les conquêtes et la chute de Giovanni, le..."
      }
    ],
