    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Dangerous Curves Burlesque |  Fri, Feb 13, 2026, 8:00 pm | Fourth Stage"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40195/main_image_credit_to_chris_noakes_(1)__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Join us for a Valentine's Day spectacular, celebrating 10 years of Dangerous Curves Burlesque!\n\nViva Van Diva is a local powerhouse performer, producer, and dance instructor. Many cohorts of burlesque artists have emerged onto the scene under her tutelage at the Rouge Studio of Dance. An original Member of The Rougettes burlesque troupe, Viva has performed internationally appearing at six burlesque festivals. She's booty, body, and everything Naughty.\n\nHelvetica Bold is an international award-winning burlesque performer and festival producer. Helvetica arrived on..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
