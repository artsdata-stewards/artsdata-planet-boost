    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "The Tragedy of Hamlet, Prince of Denmark | Ex Machina | Robert Lepage + Côté Danse | Guillaume Côté | Feb 25 - 26, 2026 | Southam Hall"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38359/_0001_guillaume_cote-_photo_de_mattt_barnes__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Perfect pairing for a timeless classic\n\nTwo of Canada’s foremost dance and theatre creators team up to tackle the tale of one of classical literature’s most emotionally complex protagonists. Choreographer Guillaume Côté and stage director Robert Lepage’s reimagination of Shakespeare’s Hamlet employs the language of movement and music to portray the play’s pivotal moments and universal struggles. Performed by nine dancers, including Côté in the leading role, the production immerses the viewer into a metaphorical world of betrayal and trickery, one..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ],
