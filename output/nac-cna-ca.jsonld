      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Primary Colours Trio |  Thu, Jan 29, 2026, 8:00 pm | Fourth Stage"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40198/dscf9225_curtis_perry__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Join the Primary Colours Trio for an intimate night of jazz, discover the unexpected with their mixture of head-nodding grooves, soulful melodies, improvisation and virtuosity. \n\nPrimary Colours is a Canadian piano trio that builds from the traditions of jazz, with influences from modern acts like Robert Glasper, GoGo Penguin, Tigran Hamasyan and Herbie Hancock. Blending acoustic and electric elements, the trio flows between head-nodding grooves and soulful melodies, discovering the unexpected through their improvisational virtuosity. The trio features Deniz Lim-Sersan on keys,..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/en/event/40198"
      }
    ]
  },
