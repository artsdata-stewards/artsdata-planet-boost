    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Pierre et le loup  | Aventures familiales avec l’Orchestre du CNA |   dim 16 nov 2025, 15 h 30|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38382/web-listing-peterwolf-edit2__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Embarquez dans une aventure musicale avec Pierre et le loup, où un jeune garçon courageux et ses amis animaux pleins de vie prennent forme à travers les instruments de l’orchestre. Les auditeurs frissonneront d’excitation pendant Le Vol du bourdon de Nikolai Romsky-Korsakov et feront la connaissance de nombreux compagnons animaux attachants lors de ce safari symphonique — une expérience idéale pour les jeunes explorateurs curieux et les mélomanes de tous âges ! \n\nLes images diffusées sur l'écran géant OCNAtron pour amplifier la magie du spectacle..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
