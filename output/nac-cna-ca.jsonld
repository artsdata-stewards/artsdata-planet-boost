  {
    "@id": "https://nac-cna.ca/temporary/15a84b4a-49aa-44f8-bffa-fb4d468da868",
    "@type": [
      "http://schema.org/Event",
      "http://schema.org/TheaterEvent"
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Nuits claires: A creative collection from sea to sea"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Over the course of a year, 12 playwrights from Vancouver to Caraquet took part in a writing relay with mysterious rules, the main one being to write at night. This show presents a collage of these writers&rsquo; nocturnal endeavours, compiled into one thrilling theatrical happening to celebrate the dreamers we are."
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g27313560"
      }
    ],
