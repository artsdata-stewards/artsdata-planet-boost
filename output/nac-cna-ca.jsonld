    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Gabi Hartmann  |   ven 13 mar 2026, 20 h 00|  Quatrième Salle"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/39865/web_resize_(1)__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Figure montante de la scène jazz actuelle, Gabi Hartmann s’inscrit dans la lignée d’artistes comme Norah Jones ou Melody Gardot. L’auteure-compositrice-interprète parisienne façonne un univers singulier où se rencontrent jazz, soul et musique du monde, porté par une voix douce et mélancolique qui brouille les frontières entre les styles.  \n\nSon premier album éponyme, paru en 2023, a conquis la critique et le public, franchissant le cap des 20 millions d’écoutes et des 15 000 exemplaires vendus. Elle s’est produite sur les scènes des plus grands festivals, dont Jazz à Vienne, les Francofolies et le Festival international de Jazz de Montréal, et a multiplié les..."
      }
    ],
