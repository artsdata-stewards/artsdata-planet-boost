    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Music Room 3: The Sounds of Nothing | Martin Dawagne, Caroline Lefebvre, Lionel Lehouillier and Judith Poitras | Feb 14 - 15, 2026 | Fountain Lobby"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40134/2-ventilateur__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "The hidden voices of everyday objects \n\nDo knickknacks and utensils hum their own secret songs? What unique sounds hide in the quiet of everyday items? \n\nUsing microphones and a variety of sound effects, four local artists engage in an imaginative dialogue with an amusing assortment of odds and ends. As they play and experiment, the objects come to life and tell their stories in the form of musical and sound tableaux. \n\nThis playful object theatre piece created by Martin Dawagne, Caroline Lefebvre, Lionel..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ],
