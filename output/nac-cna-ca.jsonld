    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Join us as we go beyond the stage and into the heart of the community.\n\nParticipate in hands-on workshops, sketch at powwow life drawing sessions, and browse one of a kind creations at Indigenous Art Markets. Engage with perspectives across Turtle Island through artist talks, panel discussions, and digital storytelling. Join our book club featuring Indigenous literature, visit seasonal exhibitions, and participate in special events during National Indigenous History Month and the National Day for Truth and Reconciliation. Our digital offerings..."
      }
    ],
