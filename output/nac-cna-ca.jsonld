    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Mozart, Márquez & Pablo Sáinz-Villegas | with the NAC Orchestra | Jan 14 - 15, 2026 | Southam Hall"
      }
    ],
    "http://ogp.me/ns#image": [
