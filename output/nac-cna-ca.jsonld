  {
    "@id": "https://nac-cna.ca/temporary/e3cfa212-8e09-4598-8567-d3c68ab28c0c",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Agamemnon in the Ring"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Douze v&eacute;ritables brutes de sc&egrave;ne d&eacute;fendent avec panache cette &eacute;bouriffante relecture en alexandrins qu&eacute;b&eacute;cois de la guerre de Troie, imagin&eacute;e par le tr&egrave;s culott&eacute; Hilaire St-Laurent. Cette adaptation d&rsquo;une &eacute;pop&eacute;e antique en mode &laquo;&nbsp;gala de lutte&nbsp;&raquo; &eacute;lectrisant d&eacute;cha&icirc;nera la b&ecirc;te spectaculaire en vous. Du pur concentr&eacute; de catharsis!"
      }
    ],
