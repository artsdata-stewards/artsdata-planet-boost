    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Les sessions WolfGANG #29 avec Alexander Shelley  | Une folle soirée de musique de chambre |   sam 20 jun 2026, 21 h 00|  Quatrième Salle"
