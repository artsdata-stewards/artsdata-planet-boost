    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Battle of Santiago  |   sam 25 avr 2026, 20 h 00|  Quatrième Salle"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40176/web_resize-min__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Groupe torontois, Battle of Santiago se plait à fusionner les rythmes et les chants afro-cubains avec une sensibilité et un esprit art-rock résolument canadiens. Si le Canada rayonne déjà sur les scènes du rock indépendant et de l’électro, il est encore peu associé à la musique latine. Pourtant, Toronto est un carrefour vibrant de cultures en Amérique du Nord, et abrite l’une des plus grandes communautés cubaines expatriées du continent.\n\nFortement ancré dans l’incroyable vivier de talents cubains de Toronto, Battle..."
      }
    ],
