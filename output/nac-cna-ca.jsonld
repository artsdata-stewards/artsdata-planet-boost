    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "cicadas  |   7-18 avr 2026|  Studio Azrieli"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38313/cicadas_new_art__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Une coproduction du Théâtre anglais du CNA et du Tarragon Theatre en association avec fu-GEN Asian Theatre Company\nUne commande du Théâtre anglais du CNA et de l’Orchestre du CNA\n\nEt si votre maison n’en faisait qu’à sa tête?\n\nNous sommes en 2035, une décennie après l’effondrement du quartier de Trinity Bellwoods à Toronto. Une enquête sur la mystérieuse disparition d’une jeune fille mène à une étrange demeure qui s’est enfoncée sous terre. Une inondation sans fuite d’eau, une voix inquiétante et des hordes de cigales :..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/event/38313"
      }
    ]
