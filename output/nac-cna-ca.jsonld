    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Atelier de perlage de boucles d’oreilles  | avec Jessica Dumont |   jeu 15 jan 2026, 17 h 30|  Atelier Shenkman Smith"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40132/fringe_earring_workshop__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Cet atelier est présenté en anglais.\n\nJoignez-vous à Jessica Dumont pour un atelier de perlage de boucles d’oreilles!  \nPendant trois heures, Jessica vous accompagnera dans la création de vos boucles d’oreilles. Vous pourrez également lui montrer vos progrès et lui poser vos questions. \nCet atelier s’adresse aux personnes de 16 ans et plus, qu’elles soient expérimentées ou non dans le perlage. Il se déroulera en anglais.\n\nL’atelier sera offert à l’Atelier Shenkman Smith du Centre national des Arts situé en face de la Billetterie."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/event/40132"
      }
    ]
  },
