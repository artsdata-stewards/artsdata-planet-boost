    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Musique pour un dimanche après-midi: Édition d'hiver  |   dim 25 jan 2026, 15 h 30|  Centre Carleton Dominion-Chalmers"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38376/27__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Programme préparé par Darren Hicks, basson solo de l’Orchestre du Centre national des Arts.\n\nPassez un week-end des plus relaxants avec ce concert intime mettant en vedette certains de vos musiciens et musiciennes coup de cœur de l’Orchestre du CNA. Dans le sublime cadre architectural du Centre Carleton Dominion-Chalmers – célèbre pour son acoustique exceptionnelle – vous aurez droit à un véritable festin musical."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
