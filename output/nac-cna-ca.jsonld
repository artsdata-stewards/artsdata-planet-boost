    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Th&rsquo;owxiya: The Hungry Feast Dish: De Joseph A. Dandurand "
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Th&rsquo;owxiya raconte la qu&ecirc;te palpitante d&rsquo;une souris rus&eacute;e qui tente de d&eacute;jouer un esprit ancien pour sauver sa famille. Une aventure musicale pour petits et grands!"
      }
