  {
    "@id": "https://nac-cna.ca/temporary/38e8568f-bcf5-405f-8729-a52078b0b1b3",
    "@type": [
      "http://schema.org/Event",
      "http://schema.org/TheaterEvent"
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Macbeth: Tragédie shakespearienne vue par Robert Lepage"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "L&rsquo;&eacute;poque m&eacute;di&eacute;vale re&ccedil;oit la visite des gangs de motards criminels dans cette grandiose adaptation du classique shakespearien qui traite de soif de pouvoir, de parano&iuml;a et de conspiration politique. Sous le regard &eacute;clair&eacute; du magicien sc&eacute;nique Robert Lepage, cette trag&eacute;die sanguinaire transport&eacute;e dans un Qu&eacute;bec des ann&eacute;es 1990 n&rsquo;a rien perdu de sa beaut&eacute; f&eacute;roce."
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g668400"
      }
    ],
    "http://schema.org/workPerformed": [
      {
        "@id": "https://nac-cna.ca/fr/event/38334#CreativeWork"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://nac-cna.ca/venue/theatre#Place"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "_:g668420"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "_:g668440"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
