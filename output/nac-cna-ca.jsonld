    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Cartes postales de Paris : musique de la Belle Époque  | Beau, bon, gratuit |   mar 14 jui 2026, 12 h 00|  Atrium O’Brien"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41386/dscf9191_curtis_perry__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Apportez votre dîner pour une pause musicale gratuite en milieu de journée à la lumineuse l'Atrium! Trouvez-vous un endroit confortable pour écouter d’incroyables artistes. De quoi vous donner une bonne dose d'énergie pour le reste de la journée! \n\nLaissez-vous transporter dans le Paris du tournant du XXe siècle avec la flûtiste Stephanie Morin et la pianiste Sylvia Bruns lors de ce concert élégant sur l'heure du midi. Inspiré par le charme et la vitalité de la capitale française à l’aube du..."
      }
    ],
