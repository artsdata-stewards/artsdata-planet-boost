    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Diana Krall  |  10-11 avr 2026|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40011/websize_diana_krall__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Diana Krall est la seule chanteuse de jazz à avoir vu huit de ses albums débuter en tête du Billboard Jazz Albums. Lauréate de deux GRAMMY et de dix JUNO, elle compte aussi neuf disques d’or, trois albums de platine et sept albums multi-platine à son actif. Transcendant les genres musicaux, Diana Krall s’impose par sa singularité comme l’une des artistes les plus reconnaissables de notre époque. The New York Times loue sa « voix à la fois douce et sensuelle, sublimée par une maîtrise rythmique exceptionnelle. » \n\nSon dernier opus, This Dream Of You, a été salué autant par la critique que..."
      }
    ],
