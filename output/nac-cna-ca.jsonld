    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Marché estival d'artisanat autochtone  |   dim  7 jun 2026, 11 h 00|  Atrium O’Brien"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40927/summer_art_market_2025__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Venez à la rencontre des artistes et artisans autochtones dans l’Atrium Gail et David O’Brien le dimanche juin 7 11h à 17h pour le Marché estival d’artisanat autochtone au Centre national des Arts, et contribuez à faire vivre l’esprit de communauté en soutenant les artistes et en renouant avec les arts et la culture.  \n\nDe magnifiques créations d’une variété d’artistes métis, inuits et des Premières Nations seront à l’honneur : bijoux, broderies de perles, peintures, sculptures, mitaines, mocassins, café et objets artisanaux..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
