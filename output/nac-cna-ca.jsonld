    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Passez un week-end des plus relaxants avec ce concert intime mettant en vedette certains de vos musiciens et musiciennes coup de cœur de l’OCNA. Dans le sublime cadre architectural du Centre Carleton Dominion-Chalmers – célèbre pour son acoustique exceptionnelle – vous aurez droit à un véritable festin musical."
      }
    ],
