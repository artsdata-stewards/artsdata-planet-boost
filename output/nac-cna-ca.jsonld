    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Réflexions sur la vie à Vancouver  |   jeu  2 nov 2017, 19 h 30|  The Centre"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/17212/luminato-i-lost-my-talk-cattroll-2__large__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "« L’histoire riche et dynamique du Canada contient quelques-uns des récits les plus captivants, les plus personnels et aussi des plus universels qu’il m’ait été donné d’entendre. Quoi de mieux que de faire connaître ces récits par la voix de quelques-uns des meilleurs artistes et créateurs du Canada? » – Alexander Shelley\n \n\nQuatre compositeurs canadiens ont fait le portrait en musique de quatre femmes d’exception de notre pays. Roberta Bondar, Rita Joe, Alice Munro et Amanda Todd ont inspiré le spectacle Réflexions sur..."
      }
