    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Une Soirée avec Lacey Hill  | Concert-bénéfice pour Minwaashin Lodge |   jeu 26 fév 2026, 19 h 30|  Quatrième Salle"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40528/laceyhilleventphoto__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Joignez-vous à nous pour une soirée inspirante de musique live avec la chanteuse et compositrice Onéida-Mohawk Lacey Hill, avec en première partie Aiyana Louis Debassige alors que nous nous réunissons pour célébrer et sensibiliser le public au Minwaashin Lodge – Indigenous Women's Support Centre. Ne manquez pas ce concert exceptionnel qui vous donne l’occasion de soutenir les femmes et les enfants autochtones. \n\nLe concert est organisé au profit de la Annual Women's Gathering de Minwaashin Lodge. \n\nLe centre de soutien aux femmes autochtones..."
      }
    ],
