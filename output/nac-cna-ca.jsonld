    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Atelier de perlage de boucles d'oreilles  | avec Stephanie Peltier |   mar 23 sep 2025, 18 h 00|  Atelier Shenkman Smith"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
