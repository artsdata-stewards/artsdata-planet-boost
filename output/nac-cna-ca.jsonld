    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "OK Naledi   | Beau, bon, gratuit |   sam 11 jui 2026, 16 h 30|  Sur le long du Canal Rideau"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41304/ok_naledi_photo__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "OK Naledi est un groupe d’afro-fusion ultravitaminé. \n\nPuisant dans l’héritage du Botswana, ce groupe d’Ottawa transforme émotions brutes et rythmes éclatants en récits puissants autour de l’amour, des peines de cœur, de l’identité queer, de la famille et du passage à l’âge adulte. Dans cette même énergie, l’écriture se déploie à fleur de peau, depuis un entre-deux : celui d’une vie construite en Occident, traversée en filigrane par les racines et les rythmes de l’Afrique australe. De cette tension naît un..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
