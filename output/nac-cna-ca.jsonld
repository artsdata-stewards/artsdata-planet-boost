    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Les sessions WolfGANG #27  | Une folle soirée de musique de chambre |   sam 17 jan 2026, 21 h 00|  Club SAW"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38379/8789_nac_wolfgang27_teal__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Les Sessions WolfGANG au Club SAW sont des concerts qui ne manquent pas de mordant. Invitez vos amis les plus aventureux et embarquez-les dans une soirée de musique de chambre surprenante avec vos musiciens préférés de l'Orchestre du CNA."
      }
    ],
