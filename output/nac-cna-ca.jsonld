    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Shelley et la « Résurrection » de Mahler  | avec l'Orchestre du CNA |  24-25 jun 2026|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38419/22__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Votre concert en trois infos clés :\n\n\n\tÉcoutez l’œuvre épique qui marque la conclusion euphorique de Maestro (2023), le film biographique de Bradley Cooper sur Leonard Bernstein.\n\tIncroyable mais vrai : ce sera la première fois que l’Orchestre du CNA interprète l’émouvante Symphonie « Résurrection » de Mahler!\n\tLes plus grands talents artistiques canadiens seront réunis sur scène puisque l’Orchestre se joindra au Toronto Mendelssohn Choir et à la nouvelle cohorte du Programme de mentorat de l’OCNA.\n\n\nComme l’a dit Gustav Mahler : « Une symphonie se doit d’être à l’image du monde; elle doit..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/event/38419"
      }
    ]
  },
