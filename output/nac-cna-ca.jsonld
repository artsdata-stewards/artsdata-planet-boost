    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Une soirée de musique originale par le Phoenix Big Band  | Au profit de la Banque d'alimentation d'Ottawa |   mer  8 avr 2026, 20 h 00|  Quatrième Salle"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40468/phoenix-2__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Joignez-vous au Phoenix Big Band à la Quatrième Salle du CNA pour soutenir la Banque alimentaire d’Ottawa lors d’une soirée joyeuse au rythme de mélodies originales qui vous donneront envie de vous lever et de danser.\n\nUn son puissant et une forte personnalité! La musique entièrement originale du Phoenix Big Band mélange des éléments de blues, de jazz, de funk, de rock, de musique latine et de reggae pour créer une célébration qui vous fera taper du pied. Ce groupe de..."
      }
    ],
