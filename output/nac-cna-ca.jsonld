    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Kozé  |   ven 24 avr 2026, 20 h 00|  Quatrième Salle"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40760/4_1772131677_koze_3_djimillei_ally_2025__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le groupe Kozé est né de la rencontre d’artistes passionnés par le maloya, animés par l’envie de faire découvrir cette musique au Québec et à travers tout le Canada. Kozé signifie « parler, communiquer » en créole réunionnais. Fidèle à son nom, le groupe transmet ses messages et valeurs par ses textes et ses chansons. Musique de revendication, le maloya mêle percussions et chant pour faire résonner les voix du chœur au rythme des tambours et des autres instruments traditionnels..."
      }
    ],
