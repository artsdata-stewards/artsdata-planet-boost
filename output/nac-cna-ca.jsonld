    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/11258/cattroll-228__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Exile, resistance and displacement are the key themes of this powerful performance that ultimately celebrates the triumph of the human spirit over adversity.\n\nI Lost My Talk, based on the poem by Mi'kmaw elder and poet Rita Joe, C.M., commissioned for the National Arts Centre Orchestra to commemorate the 75th birthday of The Right Honourable Joe Clark, P.C., C.C., A.O.E. by his family. World premiere\n\nCASUAL FRIDAYS are available as part of the Bravo Series. However, concert times, repertoire and other details..."
      }
