    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Ahmed Moneka  | Moneka Arabic Jazz |   jeu 19 fév 2026, 20 h 00|  Quatrième Salle"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40179/web_resize__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Après un passage dans une formule élargie, Ahmed Moneka revient au CNA avec un quatuor, un format plus intime qui dévoile toute l’intensité de ses compositions. Ici, la fusion rythmique et mélodique atteint des hauteurs plus personnelles. Accompagné de Selcuk Suna (saxophone), Demetrios Petsalakis (oud et clavier) et Max Senitt (batterie), Ahmed Moneka puise dans son héritage afro-sufi et ses racines à Bagdad pour créer un univers sonore saisissant. Dans cette configuration s’installe une véritable complicité musicale, où l’émotion du..."
      }
    ],
