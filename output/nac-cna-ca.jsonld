    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Tosca  | Opéra en concert |  10-12 sep 2025|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38403/tosca_ee_visual__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Production semi-scénique présentée en italien avec surtitres en anglais et français.\n\nMusique par Giacomo Puccini\nLibretto par Giuseppe Giacosa, Luigi Illica\n\nVotre concert en trois infos clés :\n\n\n\tIntrigues, ruses et revanche : Tosca est aussi riche en suspense que les meilleurs romans ou films policiers.\n\tDerrière cet opéra en version concert se trouve la même équipe de création que pour le Don Giovanni de Mozart, présenté à guichets fermés au CNA en 2023.\n\tLa soprano de renommée internationale Ailyn Pérez incarne Floria Tosca, la plus célèbre cantatrice de Rome.\n\n\nMêlant art, politique et..."
      }
    ],
