  {
    "@id": "https://nac-cna.ca/temporary/f97ff2c7-8e0f-416e-ab4a-8dcd62555fdf",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Mozart, Marquez et Pablo S&aacute;inz-Villegas"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Au programme&nbsp;: le virtuose de la guitare espagnole pr&eacute;sente la premi&egrave;re d&rsquo;une cr&eacute;ation du compositeur mexicain Arturo M&aacute;rquez et l&rsquo;Orchestre joue une symphonie de Mozart d&eacute;bordante d&rsquo;&eacute;nergie."
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g2793680"
