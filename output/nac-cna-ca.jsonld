    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Loreena McKennitt | The Mask and Mirror: 30th Anniversary Tour |  Tue, Oct 20, 2026, 8:00 pm | Southam Hall"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40239/main_website2__large.jpg"
