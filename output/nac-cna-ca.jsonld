    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Beaded Strawberry Earring Workshop | with Jessica Dumont |  Wed, Sep 24, 2025, 5:30 pm | Atelier Shenkman Smith"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
