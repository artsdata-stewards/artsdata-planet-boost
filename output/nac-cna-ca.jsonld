    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Les lundis des tout-petits  | Les contes de Luana |   lun 10 fév 2025, 10 h 00|  Place Peter A. Herrndorf"
      }
    ],
    "http://ogp.me/ns#image": [
