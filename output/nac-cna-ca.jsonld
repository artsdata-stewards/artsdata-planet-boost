    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Bruce Cockburn  |   ven 16 oct 2026, 20 h 00|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40662/dsc05192-edit-2025-daniel-keebler__large.jpeg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Bruce Cockburn mène une carrière exceptionnelle marquée par la politique, la spiritualité et une insatiable curiosité musicale. Folk, jazz, rock et musique du monde, il a tout exploré, s’imposant comme un auteur-compositeur à la fois inspiré et prolifique, et un guitariste virtuose. Figure respectée pour son engagement et la portée humaniste de ses textes, il a su capter avec finesse, album après album, les joies, les peines, les craintes et la foi qui traversent l’expérience humaine. \n\nTreize fois récompensé aux prix JUNO, il a été intronisé au Panthéon des auteurs-compositeurs canadiens, couronné aux Prix du..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
