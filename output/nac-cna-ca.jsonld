    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Un conte de f&eacute;es en musique, riche en h&eacute;ros, en gobelins et en suspense prenant, et un concerto&nbsp;qui &eacute;voque le New&nbsp;York de l&rsquo;&egrave;re du jazz."
