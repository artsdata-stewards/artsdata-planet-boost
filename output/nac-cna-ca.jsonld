  {
    "@id": "https://nac-cna.ca/temporary/1bf21db4-24f3-4fac-805c-edd12f466a50",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Camions (fant&ocirc;mes de la libert&eacute;)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Breaking: Following the 2022 protests, we&rsquo;re hearing that the NAC is about to be INVADED BY TRUCKS again... tiny ones this time around! We&rsquo;re also learning that kids will be at the wheel, audiences will be wearing headphones and this intergenerational walkabout adventure will be a fun new look at the meaning of freedom."
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g31669700"
      }
    ],
    "http://schema.org/workPerformed": [
      {
        "@id": "https://nac-cna.ca/en/event/38325#CreativeWork"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://nac-cna.ca/venue/azrieli-studio-foyer#Place"
      }
    ],
