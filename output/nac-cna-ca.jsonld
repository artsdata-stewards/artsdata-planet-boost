    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Atelier de confection de mocassins pour tout-petits   | avec Colleen Nolan |   mer 14 jan 2026, 17 h 30|  Atelier Shenkman Smith"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40131/baby_mocs_-_event_image__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Cet événement est présenté en anglais.\n\nVenez apprendre à confectionner une paire de mocassins en cuir pour tout-petits. Une expérience conviviale et ludique qui allie créativité et savoir-faire! Nous vous fournirons le matériel et les outils nécessaires pour fabriquer une paire de mocassins originale, confortable et toute douce pour les pieds des bébés et des enfants. Un beau cadeau à offrir à votre enfant ou à un enfant de votre entourage.\n\nPointures (à titre indicatif) : nouveau-nés à 4 ans (pointure 10).\n\nCet..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/event/40131"
      }
    ]
  },
