    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://nac-cna.ca/fr/event/40049"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Soirée Black Out (BON) : Copperbelt  |   ven 16 jan 2026, 17 h 00|  Place Peter A. Herrndorf"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40049/bon_1__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "SOIRÉE BLACK OUT (BON) : Copperbelt \n\nLes soirées Black Out sont de retour, cette fois pour souligner la première mondiale de Copperbelt de Natasha Mumba au Théâtre anglais avec une expérience complète ancrée dans l’esprit de l’ubuntu : « Je suis parce que nous sommes. » \n\nLa soirée s’ouvre avec un marché et un carrefour communautaire vibrant rassemblant des entreprises locales dirigées par des femmes et des artistes des diasporas africaines et caribéennes d’Ottawa. Un espace pour se rassembler, célébrer et soutenir la communauté. \n\nAprès la représentation de Copperbelt, la fête continue avec BON Nuit, une réception..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
