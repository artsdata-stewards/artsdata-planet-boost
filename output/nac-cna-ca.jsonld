  {
    "@id": "https://nac-cna.ca/temporary/ec64257a-86d5-4aa9-a2cb-9f3eb41b9e36",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Copperbelt"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Une famille zambienne qui a fait fortune dans le secteur minier. Un pass&eacute; &agrave; d&eacute;terrer, des liens familiaux &agrave; creuser et un succ&egrave;s qui cache de lourdes v&eacute;rit&eacute;s."
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g2794940"
      }
    ],
