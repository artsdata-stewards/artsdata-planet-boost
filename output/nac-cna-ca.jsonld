    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Te Tangi a Te Tūī  | Une collaboration entre Te Rēhia Theatre et The Dust Palace |   4- 7 jun 2026|  Studio Azrieli"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38356/tangui_credit_emily_cooper__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Époustouflant spectacle de cirque, Te Tangi a Te Tūī raconte l’histoire d’Aotahi, une femme qui vit paisiblement sur les terres ancestrales d’Aotearoa (Nouvelle-Zélande), à l’orée d’une forêt mystérieuse. Dans les profondeurs s’y cachent les Patupaiarehe, des êtres féériques surnaturels, et Kōiriiri, l’homme-oiseau – une créature au destin scellé par une malédiction ancestrale. En donnant naissance à Piri, le premier garçon de la famille depuis des générations, Aotahi réveille une malédiction longtemps enfouie.\n\nDevenu grand, Piri attire la convoitise de deux êtres..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
