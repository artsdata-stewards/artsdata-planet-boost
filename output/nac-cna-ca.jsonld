    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Atelier d’écriture pour les personnes aînées de la communauté 2ELGBTQIA+  | avec Mary Ellen MacLean |  24-28 aoû 2026|  Quatrième Salle"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40987/elderqueers_2026__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Atelier d’écriture pour les personnes aînées de la communauté 2ELGBTQIA+ :\n\n\n« Vous souhaitez raconter votre histoire? Ou une histoire? Quelle est cette histoire qui vous trotte dans la tête depuis un moment? En tant que personnes aînées de la communauté queer, nos histoires sont importantes et doivent être partagées et entendues pour rester dans les mémoires. » \n– Mary Ellen MacLean\n\n\nCet atelier est l’occasion de se réunir, de renforcer vos liens avec la communauté et de créer des histoires ensemble, sous l’œil bienveillant et attentif de..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
