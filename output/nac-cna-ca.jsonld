    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Shelley, Strauss & Dharmoo | with the NAC Orchestra |  Thu, Oct 2, 2025, 8:00 pm | Southam Hall"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38431/21__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Three things to know:\n\n\n\tAlexander Shelley conducts a program highlighting two composers who use music to create mythic tales of heroes and villains.\n\tIn his massive musical poem Ein Heldenleben, Richard Strauss traces a journey of love and struggle inspired by the composer’s favourite hero—himself!\n\tGabriel Dharmoo constructs an imaginary body of folklore in Wanmansho, a theatrical work for solo vocalist and orchestra.\n\n\n“I don’t see why I shouldn’t compose a symphony about myself. I find myself quite as interesting as Napoleon,” Richard Strauss once..."
      }
