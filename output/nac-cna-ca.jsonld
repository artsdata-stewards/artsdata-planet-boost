    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "NACO Tour - Osaka Expo, Japan |  Fri, Jun 6, 2025, 5:00 am | The Shining Hat - Osaka Expo"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38084/osaka_expo_site_cropped__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "The National Arts Centre Orchestra represents Canada on the world stage at Expo 2025 Osaka, with an extraordinary concert celebrating the 100th anniversary of legendary Canadian jazz pianist and composer Oscar Peterson.\n\nThis prestigious event brings together Canadian pianist Jaeden Izik-Dzurko, the Oscar Peterson Centennial Quartet, led by acclaimed Canadian pianist Robi Botos, and a youth choir featuring performers from El Sistema Japan’s Tokyo Children’s Ensemble, OrKidstra, and Sistema New Brunswick for a once-in-a-lifetime artistic experience.\n\nAt the heart of the program are two iconic..."
      }
    ],
