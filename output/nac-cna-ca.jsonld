    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Puuluup   |   mer 15 jui 2026, 19 h 30|  Théâtre Babs Asper"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41309/puuluup-with_talharpas-34-photo_taavi_arus__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Ramo Teder et Marko Veisson forment un duo de musiciens qui détournent les vibrations des cordes en crin de la talharpa grâce à des effets électroniques et à des techniques d’archet et de rythme non conventionnelles. Les soupirs feutrés de l’instrument se fondent ainsi dans un univers sonore riche, où se mêlent échos amplifiés, percussions, craquements et textures électroniques. Ils en tirent des chansons délicieusement sinueuses, inspirées de fragments du quotidien, parfois les plus inattendus. Leurs textes, écrits en plusieurs..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
