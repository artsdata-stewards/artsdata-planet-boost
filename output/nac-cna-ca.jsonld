    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Mois de l’histoire des Noirs | Série"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-packages.s3.amazonaws.com/32851/bhm-2026-vanessa-thomas_header-2__tablet-small.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Nous rendons hommage aux artistes, à la culture et au public des communautés noires en février et toute l’année. \n\nJoignez-vous à nous en ligne, au Centre national des Arts et dans la communauté pour soutenir et célébrer l’art et les récits des communautés noires. Au programme : des spectacles, des ateliers et bien plus!\n\nSur la Lanterne Kipnes, l’œuvre Encoded in us [Ancré en nous] de l’artiste Vanessa « Nessy » Thomas, puise dans un langage visuel inspiré du littoral pour rendre..."
      }
    ],
