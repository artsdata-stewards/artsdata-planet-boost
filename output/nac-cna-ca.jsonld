    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Une soirée avec Fran Lebowitz  | Auteure, journaliste et observatrice sociale |   sam  9 mai 2026, 20 h 00|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/39972/fran_web__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Dans un paysage culturel saturé d’experts et de bavards professionnels, Fran Lebowitz se distingue comme l’une des observatrices sociales les plus lucides de notre époque. \n\nDans ses essais et entretiens cinglants, elle s’attaque autant à l’actualité et aux médias qu’à ses bêtes noires : les touristes, les carrousels à bagages, les lotions après-rasage, les adultes montés sur patins et les bronzages trop prononcés. Saluée comme « une humoriste majeure, dans la plus pure tradition classique » (The New York Times Book Review), cette ambassadrice du chic..."
      }
    ],
