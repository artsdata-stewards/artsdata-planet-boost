    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Karanfil/Carnation  | Laura Taler / Grimm Pictures  |   lun  4 mai 2026, 19 h 00|  Salle de répétition A"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40241/lt_1__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Danse CNA présente une projection spéciale en personne de l’une de ses commandes. Retrouvez Laura Taler dans les coulisses du CNA pour regarder le film qu’elle a créé… dans les coulisses du CNA! \n\nLaura Taler nous propose une aventure cinématique contextuelle dans le monde théâtral souterrain du CNA, là où les rêves intimes prennent forme dans la sphère publique. Tout en évoquant un cliché de Bronislava Nijinska, vieux de 99 ans, l’artiste s’interroge sur la représentation, les dimensions concrètes et faillibles de la langue ainsi que l’art consistant à exhiber son être intérieur. \n\nDans Karanfil/Carnation, on retrouve des spectacles musicaux de Megan Jerome et d’Expanda Fuzz, la..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
