    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Daby Touré  |   sam 30 mai 2026, 20 h 00|  Quatrième Salle"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40598/pna250711002-1152x648-fr-68264ed3__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Originaire de Mauritanie et du Sénégal, le talentueux musicien Daby Touré propose un regard neuf sur l’Afrique. Véritable citoyen du monde, il transcende les traditions pour mêler pop, folk, soul, reggae, jazz et blues dans un style résolument libre. \n\nAvec Daby Touré, un paysage sonore à la fois captivant et poétique prend forme. Inclassable et universel, il rappelle qu’être musicien africain ne se résume pas à jouer de la kora ou du djembé dans le strict respect des traditions. Depuis des décennies, de Dakar à Johannesburg, les artistes se nourrissent des courants sonores internationaux..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
