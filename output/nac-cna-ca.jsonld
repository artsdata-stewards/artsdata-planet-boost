    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "I Lost My Talk rentre au bercail  |   mer  3 mai 2017, 12 h 30|  Dan K Stevens Memorial Arena"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/16300/i-lost-my-talk-cattroll-17__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Ce concert gratuit pour les élèves et les membres de la Première Nation d’Eskasoni, dans l’île du Cap-Breton (Nouvelle-Écosse), sera un moment fort de la Tournée Canada 150 de l’Orchestre du CNA.\n\nLa chanteuse locale Kalolin Johnson ouvrira le concert en interprétant We Shall Remain accompagnée par l’orchestre complet. L’Orchestre du CNA jouera ensuite le triomphal et électrisant finale de la Symphonie du Nouveau Monde de Dvořák. Le violoniste virtuose James Ehnes suivra avec le fulgurant Troisième mouvement du concerto pour..."
      }
    ],
