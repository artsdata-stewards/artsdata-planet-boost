    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Atelier de perlage de boucles d'oreilles  | avec Stephanie Peltier |   ven 10 oct 2025, 12 h 00|  Atelier Shenkman Smith"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
