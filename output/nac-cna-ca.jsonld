    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Séance d’entraînement pow-wow  | avec Amanda Fox  |   lun 29 jun 2026, 12 h 00|  Scène du Foyer du canal"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41134/powwowfitness1__large.jpeg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Un pow-wow est un rassemblement ouvert à tout le monde qui réunit danses, chants, mets et artisanat pour célébrer les cultures des Premières Nations. D’une durée de 45 minutes, ces séances d’entraînement pow-wow à haute intensité comprendront des mouvements de tous les styles de danse pow-wow avec des rythmes de musique traditionnelle et contemporaine de pow-wow. Avec pour guide Amanda Fox, venez bouger et en apprendre plus sur les origines et le contexte culturel des pow-wow."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
