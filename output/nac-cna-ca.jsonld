    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/37964/seoul___concert_hall_(3)_cropped__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Canada’s National Arts Centre Orchestra is embarking on a monumental tour—the 99th since its founding in 1969.\n\nThe National Arts Centre Orchestra makes its debut in Seoul, Korea, with a thrilling program of timeless classics and contemporary Canadian music.\n\nRenowned Korean pianist Yeol Eum Son joins the Orchestra for Maurice Ravel’s dazzling Piano Concerto in G major. The concert also features Richard Strauss’s vivid tone poem Don Juan and Beethoven’s iconic Symphony No. 5.\n\nA highlight of the program is Canadian composer Kelly-Marie Murphy’s Dark Nights,..."
      }
    ],
