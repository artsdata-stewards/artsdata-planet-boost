    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Music for a Sunday Afternoon: Winter Edition |  Sun, Jan 25, 2026, 3:30 pm | Carleton Dominion-Chalmers Centre"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38376/27__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Program curated by Darren Hicks, Principal Bassoon of the National Arts Centre Orchestra.\n\nSink into seriously relaxing weekend vibes as you experience intimate performances from some of your favourite NAC Orchestra musicians. Surrounded by the architectural marvels of the Carleton Dominion-Chalmers Centre—revered for its top-notch acoustics—you’ll feast on a program of musical delights."
      }
    ],
