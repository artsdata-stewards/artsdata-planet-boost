  {
    "@id": "https://nac-cna.ca/temporary/020f3655-28d5-4804-8548-3bab2e129c2d",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Cr&eacute;atures"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le th&eacute;&acirc;tre est un d&eacute;luge! Sur une structure flottante pr&eacute;caire, onze com&eacute;diennes (ou non), de 5 &agrave; 70 ans, r&eacute;alisent une fascinante chor&eacute;graphie gestuelle de survie. Tout est appel&eacute; &agrave; se m&eacute;tamorphoser dans cette performance renversante qui exploite de fa&ccedil;on totalement singuli&egrave;re l&rsquo;eau comme mat&eacute;riau sc&eacute;nographique et sensoriel. Catastrophique ET magnifique!"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g2881100"
      }
    ],
