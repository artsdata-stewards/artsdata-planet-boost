    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/39260/celeste_(2)__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "With Juno and ADISQ nominations and four Canadian Folk Music Awards, Genticorum is one of the leading groups in Quebec's traditional music scene. Pascal Gemme (fiddle) and Yann Falquet (guitar), the two founding members of the trio, are also individually recognised for their solid contribution to the traditional music scene. They have been joined since 2015 by multi-instrumentalist and composer Nicholas Williams (flute, accordion); the pleasure these three musicians have in playing and creating together is palpable, both on stage and..."
      }
