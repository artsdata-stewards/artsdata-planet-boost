    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "The Collected Strands  | Beau, bon, gratuit |   mar  7 jui 2026, 12 h 00|  Atrium O’Brien"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41088/collected-strands-tone_25-26__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Apportez votre dîner et rejoignez Collected Strands pour un concert gratuit à midi dans l'Atrium ! \n\nCe groupe nouvellement formé, qui se réunit pour jouer de la musique de chambre improvisée, avec une ambiance orientée vers le groove modal, ne manquera pas de vous ravir.\n\nCollected Strands est un ensemble de musique de chambre composé de quatre formidables instrumentistes. Ces maîtres dans l’art de l’improvisation passent avec aisance de la modale-groove contemporaine au classique, au folk et à la musique d’ambiance et..."
      }
    ],
