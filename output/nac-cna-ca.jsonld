    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "L’autonomisation des femmes dans le monde de la musique  | Présentation musicale - Deuxième journée |   ven  1 mai 2026, 19 h 00|  Quatrième Salle"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40726/samantha_christ_francois__credit_to_lilien_trujillo_viton-02__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Ces concerts ont lieu dans le cadre de la Conférence sur l’autonomisation des femmes dans le monde de la musique présentée par Axé WorldFest (le site web est disponible uniquement en anglais) en partenariat avec le Centre national des Arts.\n\nProgrammation :\n\nOuverture des portes – 18 h 30\n\nSamantha Christ Quartet – 19 h\n\nSiibii – 19 h 45\n\nKazdoura –  20 h 50\n\nMireya Ramos – 21 h 40\n\nÀ propos de la conférence :\n\nPour sa sixième édition, la Conférence sur l’autonomisation des femmes dans le monde de la musique, accompagnée de sa vitrine..."
      }
    ],
