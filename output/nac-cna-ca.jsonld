    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Les sessions WolfGANG #29  | Une folle soirée de musique de chambre |   sam 20 jun 2026, 21 h 00|  Quatrième Salle"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38381/8789_nac_wolfgang29_peach__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Les Sessions WolfGANG sont des concerts qui ne manquent pas de mordant. Invitez vos amis les plus aventureux et embarquez-les dans une soirée de musique de chambre surprenante avec vos musiciens préférés de l'Orchestre du CNA.\n\n\nPour cette édition spéciale à la Quatrième Salle du CNA!"
      }
    ],
    "http://ogp.me/ns/fb#admins": [
