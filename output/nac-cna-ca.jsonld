    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Jenn Grant  | Cradled by the Waves, un spectacle multimédia unique autour de son album Queen of the Strait |   jeu 16 avr 2026, 19 h 30|  Théâtre Babs Asper"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40012/websize_(1)__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Jenn Grant, la célèbre artiste canadienne, vous invite à une immersion sensorielle unique avec Cradled by the Waves. Dans ce spectacle inédit, la musique de son album à paraître, Queen of the Strait, prend vie de manière spectaculaire, mêlant musique, cinéma, théâtre et danse pour créer une expérience multimédia immersive. Ce nouvel album, son plus personnel à ce jour, est une ode intime à son enfance sur l’Île-du-Prince-Édouard et à l’appel éternel de l’Atlantique. Sur scène, chaque chanson se transforme..."
      }
    ],
