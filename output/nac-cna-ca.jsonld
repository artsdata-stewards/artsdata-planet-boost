  {
    "@id": "https://nac-cna.ca/temporary/a143b539-e273-4e76-bdc4-95d5c8e3aee5",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Te Tangi a Te T&#363;&#299;"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "&Eacute;poustouflant spectacle de cirque d&rsquo;Aotearoa (Nouvelle-Z&eacute;lande), Te Tangi a Te T&#363;&#299; suit le destin de Piri, un gar&ccedil;on convoit&eacute; par deux forces surnaturelles d&eacute;termin&eacute;es &agrave; sceller son sort. Interpr&eacute;t&eacute;e en Te Reo M&#257;ori, cette histoire saisissante exalte l&rsquo;amour, l&rsquo;espoir et l&rsquo;h&eacute;ritage."
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g1063740"
      }
    ],
