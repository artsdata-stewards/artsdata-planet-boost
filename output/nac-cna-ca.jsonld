  {
    "@id": "https://nac-cna.ca/temporary/0e4870e2-c641-4d69-8c24-58103dd86045",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Voice of Desert"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Saburo&#8239;Teshigawara est v&eacute;n&eacute;r&eacute; par le public depuis des d&eacute;cennies. Il est un v&eacute;ritable sculpteur de l&rsquo;espace et propose une exp&eacute;rience sensible et exceptionnelle, conduisant &agrave; un sentiment de pl&eacute;nitude et d&rsquo;&eacute;quilibre.&nbsp;"
      }
