    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Mozart, Korngold et Bryan Cheng: avec l'Orchestre du CNA"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "La symphonie &laquo;&nbsp;Jupiter&nbsp;&raquo; de Mozart enflamme la sc&egrave;ne avec ses fanfares de cuivres, et le violoncelliste Bryan Cheng &eacute;voque le glamour de l&rsquo;&acirc;ge d&rsquo;or hollywoodien."
      }
