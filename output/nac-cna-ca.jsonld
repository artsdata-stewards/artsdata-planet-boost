    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place à la danse  | Atelier à l'occasion de la Journée internationale de la danse |   mer 29 avr 2026, 12 h 00|  Place Peter A. Herrndorf"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41137/d09b9ecd-bc91-4102-9125-2b30c58b8d28__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Joignez-vous à nous pour célébrer la joie du mouvement lors de la Journée internationale de la danse!\n\nL’artiste-enseignante de Danse CNA, Siôned Watkins, vous fera découvrir un échauffement simple de danse contemporaine, suivi d’une chorégraphie facile et entraînante qui vous laissera le sourire aux lèvres.\n\nApprenez une chorégraphie simple et venez danser avec nous! Ouvert à toutes et à tous, aucune expérience requise."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
