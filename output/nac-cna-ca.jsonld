    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Michael Blaustein  | La tournée « Taste Me Tour » : la dernière partie |   sam 20 jun 2026, 19 h 00|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41104/michael-blaustein_2026-may9-1130x650__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Michael Blaustein est un humoriste en pleine ascension. Ses extraits de spectacles de stand-up, devenus rapidement viraux, ont cumulé plus de 900 millions de vues sur l'ensemble des réseaux sociaux. Il vient notamment de terminer sa tournée 2025 avec plus de 70 000 billets vendus, étant clairement un artiste hors pair avec son succès mondial. Lorsqu'il n'est pas en tournée, il co-anime avec Trevor Wallace le podcast humoristique à grand succès Stiff Socks, qui est à plus de 70 millions..."
      }
    ],
