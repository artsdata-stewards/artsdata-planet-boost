  {
    "@id": "https://nac-cna.ca/temporary/a7c3a768-8f27-40cb-8f4c-46fa86c2dd45",
    "@type": [
      "http://schema.org/Event",
      "http://schema.org/TheaterEvent"
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Baobab: Conte musical et marionnettique"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Apr&egrave;s avoir fait le tour de la plan&egrave;te, ce spectacle ensoleill&eacute; se d&eacute;pose chez nous le temps d&rsquo;un chaleureux moment en famille. Avec leurs instruments et marionnettes, quatre interpr&egrave;tes de feu font pulser le c&oelig;ur de ce savoureux conte inspir&eacute; de la tradition orale africaine. Et si on troquait l&rsquo;habituel sapin pour festoyer &agrave; l&rsquo;ombre du baobab?"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g26870280"
      }
    ],
    "http://schema.org/workPerformed": [
      {
        "@id": "https://nac-cna.ca/fr/event/38323#CreativeWork"
      }
    ],
