    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Atelier de perlage de boucles d'oreilles  | avec Stephanie Peltier |   ven 10 oct 2025, 12 h 00|  Atelier Shenkman Smith"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/39491/beaded_earring_workshop2__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Cet événement est présenté en anglais.\n\nJoignez-vous à Stephanie Peltier de Deliaestelle Designs pour un atelier de perlage de boucles d’oreilles!   \nVous recevrez une trousse d’initiation au perlage comprenant tout ce qu’il vous faut pour confectionner une superbe paire de boucles d’oreilles perlées – y compris des instructions, des perles, du fil, des fermoirs de boucles d’oreilles, une perle colorée surprise et bien plus. Pendant trois heures, Stephanie Peltier vous accompagnera dans la création de vos boucles d’oreilles. Vous pourrez également..."
      }
    ],
