        "@language": "en-ca",
        "@value": "Beaded Vamp and Moccasin Workshop | with Colleen Nolan | Sep 18 - Oct 2, 2025 | Atelier Shenkman Smith"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/39488/beaded_moccasin__large.jpg"
