    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "No Codes  | Usual Suspects |   sam 31 jan 2026, 20 h 00|  Quatrième Salle"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/39698/use_as_lead_no_codes_credit_bruno_guerin_cropped__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "No Codes est un collectif jazz formé de quatre musiciens et compositeurs : Benjamin Deschamps (saxophone alto), Frank Lozano (saxophone ténor), Sébastien Pellerin (contrebasse) et Louis-Vincent Hamel (batterie). Le groupe se distingue par l’absence d’instruments harmoniques et par l’importance donnée à l’improvisation, à l’interaction et au dialogue entre les musiciens.\n\nAprès le succès de son album éponyme paru en 2018, le groupe revient en force avec Usual Suspects, lancé en novembre 2024 sous l’étiquette Sunset Hill Music. Avec ce nouvel opus, No Codes propose un jazz audacieux et..."
      }
    ],
