    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Beaded Triangle Earring Workshop | with Jessica Dumont |  Wed, Nov 12, 2025, 5:30 pm | Atelier Shenkman Smith"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/39494/triangle_earring_workshop_(1)__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Come join Jessica Dumont for this triangle beaded earring workshop!  \nIn this 3-hour workshop, Jessica will guide you through the earring making process where you can share your process and ask questions along the way. \nSuitable for beginner beaders and experienced beaders alike, ages 16 and up. Workshop will be delivered in English.\n\nThis workshop takes place at 1 Elgin St, in the National Arts Centre's Atelier Shenkman Smith which is located across from the Box Office. "
      }
