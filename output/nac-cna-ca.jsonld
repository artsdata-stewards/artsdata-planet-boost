    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Cette r&eacute;interpr&eacute;tation par le chor&eacute;graphe Guillaume&#8239;C&ocirc;t&eacute; et le metteur en sc&egrave;ne Robert&#8239;Lepage passe par le langage du mouvement et de la musique pour d&eacute;peindre les moments forts et les th&egrave;mes universels de cette &oelig;uvre anthologique de Shakespeare."
      }
