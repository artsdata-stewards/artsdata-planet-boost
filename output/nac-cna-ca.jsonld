    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Their Master's Voice  | Avec John Malkovich |   sam 10 oct 2026, 20 h 00|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40091/their-master-s-voice-omc-marco-borrelli-31__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Their Master’s Voice est un spectacle impressionnant et inclassable mettant en vedette une véritable légende, l’acteur John Malkovich. Dans cette œuvre d’envergure internationale qui se déroule en 1725, il est accompagné sur scène de deux chanteurs d’opéra, d’une actrice, de musiciens baroques et d’un chœur de 12 voix.   \n\nJohn Malkovich, reconnu mondialement pour sa personnalité et sa voix singulières, y incarne le célèbre Nicola Porpora, compositeur de 40 opéras et maître de chant des deux castrats les plus éblouissants de..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
