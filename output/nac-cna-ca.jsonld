    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Les lundis des tout-petits  | Les contes de Luana |   lun 11 mai 2026, 10 h 00|  Place Peter A. Herrndorf"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
