      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Les souvenirs du sable  | Quand la tempête est fabuleuse  |   7-11 jui 2026|  Quatrième Salle"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40969/les_souvenirs_du_sable_image1_credit-alexandre_donato__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Les souvenirs du sable est un conte sur la profondeur du deuil et la force des enfants, l’histoire d’une petite fille nommée Alma, qui devra naviguer au travers des vagues qui secouent ses paysages intérieurs.  \n\nDe retour sur ses îles natales, Alma se rappelle les moments passés avec son père, avalé par le vent et la mer. Dans sa tempête intérieure, elle cherche la clé de son trésor, cette relation perdue, son bonheur disparu. Aidée de ses alliés (une maman-mouchoir, une..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/event/40969"
      }
    ]
  },
