  {
    "@id": "https://nac-cna.ca/temporary/5b3b1bfe-c0e3-4e6b-b5c6-82fda2076b8b",
    "@type": [
      "http://schema.org/Event",
      "http://schema.org/TheaterEvent"
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Tupqan | Nos territoires int&eacute;rieurs: Création d'Ondinnok avec Menuentakuan et Production AUEN"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Tupqan se situe au croisement du thriller politique et de la qu&ecirc;te identitaire, qui suit la qu&ecirc;te de Polam Nicolas, &agrave; la recherche d&rsquo;un wampum vol&eacute;, cl&eacute; de la survie de son village. &Agrave; travers une fusion de formes artistiques, ce spectacle po&eacute;tique nous entra&icirc;ne dans une exp&eacute;rience riche, d&rsquo;o&ugrave; l&rsquo;on sort grandi&middot;e."
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g28098540"
      }
    ],
    "http://schema.org/workPerformed": [
