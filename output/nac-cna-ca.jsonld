  {
    "@id": "https://nac-cna.ca/temporary/ac5aaea0-4855-423a-b052-eb4060b4393c",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Thelonious"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Jazze ta vie avec trois fougueux musiciens au talent surnaturel qui ravivent, le temps d&rsquo;un spectacle-concert tapiss&eacute; d&rsquo;animations vid&eacute;o d&eacute;lirantes, la figure mythique de Thelonious Monk! Impros live et jeux avec le public, cette ludique performance est la preuve vivante que le jazz n&rsquo;a rien perdu de sa coolitude.&nbsp;&nbsp;"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g17453360"
      }
    ],
