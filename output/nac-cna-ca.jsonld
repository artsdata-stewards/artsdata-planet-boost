    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Flávia Nascimento et Tio Chorinho  | Beau, bon, gratuit |   mer 22 jui 2026, 12 h 00|  Atrium O’Brien"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40945/2021-tiochorinho-flavia-03-credit-zahrasalecki__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Offrez-vous une pause musicale gratuite le midi à l’Atrium O’Brien. Apportez votre dîner, trouvez-vous un endroit confortable et laissez la musique faire le reste. Une belle façon de recharger les batteries pour la suite de votre journée! \n\nFlávia Nascimento et Tio Chorinho vous proposent un spectacle vibrant et électrisant à saveur brésilienne où se rencontrent choro, samba, forró et compositions originales. Au programme : virtuosité éclatante, voix habitées, rythmes effervescents et improvisations pétillantes. Avec une présence scénique magnétique, Flávia Nascimento fait vibrer le..."
      }
    ],
