    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Resident Chef Series Gala | With Peter Hum |  Thu, Jan 29, 2026, 6:00 pm"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/39948/peter_hum_headshot_event_web__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "On January 29th, experience an unforgettable evening of storytelling and fine dining. Immerse yourself in his captivating tales while enjoying a five-course menu thoughtfully crafted in collaboration with NAC Executive Chef Kenton Leier. Each course will be beautifully presented and introduced by the storytellers themselves, offering fascinating insights into the inspiration behind every dish. To complete the experience, a sommelier will guide you through a curated wine pairing, perfectly matched to elevate each course and delight your palate.  \n\nEnjoy this unique..."
      }
    ],
