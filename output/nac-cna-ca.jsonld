    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Réflexions sur la vie à Göteborg  |   dim 26 mai 2019, 18 h 00|  Göteborgs Konserthus"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/20006/bondarsphere_credit-fred-cattroll-3__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "L’Orchestre du Centre national des Arts, sous la direction d’Alexander Shelley, conclut la tournée européenne célébrant son 50e anniversaire à Göteborg, en Suède.\n\n--\n\nSpectacle original saisissant, Réflexions sur la vie est un hymne à la jeunesse, à l’espoir et au courage qui brosse le portrait varié et captivant de quatre femmes : Alice Munro, Amanda Todd, Roberta Bondar et Rita Joe.\n\nDans le cadre du projet, Alexander Shelley, directeur musical de l’Orchestre du Centre national des Arts du Canada, a réuni quatre compositeurs..."
      }
    ],
