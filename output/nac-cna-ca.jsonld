      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://nac-cna.ca/fr/event/38335"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Nuits claires  | Création collective d’un océan à l’autre |  12-13 sep 2025|  Studio Azrieli"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38335/tfcna2526_nuitsclaires_1440x810__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Ce spectacle fait également partie de la programmation des Zones Théâtrales.\n\nDe Vancouver à Caraquet, durant un an, douze dramaturges – un·e par mois –, sélectionné·e·s par autant de compagnies de théâtre, se sont prêté·e·s à un jeu d’écriture à relais aux contraintes mystérieuses, dont la plus engageante était d’écrire la nuit. Voici un collage de toutes ces œuvres nocturnes assemblées en un exaltant happening théâtral qui célèbre les rêveurs et rêveuses que nous sommes.\n\nQu’est-ce qui nous tient éveillé·e·s quand le Soleil finit..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/event/38335"
      }
    ]
  },
