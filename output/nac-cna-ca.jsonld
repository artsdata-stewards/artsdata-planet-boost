    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Nos mères meurent (et nous n’y pouvons rien) | Carrying on with life in the midst of grief  | Sep 11 - 12, 2025 | Le LabO — University of Ottawa"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/39226/nos_mere_1b__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "What happens when the mother you’ve known forever disappears? Not a sudden disappearance, but a slow fade: a little here, a little there. In this powerful, personal work, Isabelle Rivest recounts her last moments with her mother, Francine, as the older woman gradually succumbs to dementia. Isabelle experiences ambiguous loss and grief; even though Francine is still alive, it’s as if she’s already gone, and her disappearing a little more each day may be harder to bear than her death… \n\nBlending..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ],
