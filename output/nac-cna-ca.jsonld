    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Le Taureau | How far would you go for the people you love? | Sep 12 - 13, 2025 | La Nouvelle Scène Gilles Desjardins — Studio A"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/39225/le_taureau_1__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A teenager accused of serious offences is required to meet with a social worker to explain his actions. But what really happened? The young man ducks, weaves, and dodges every question with disturbing skill. How could this quiet, studious boy have changed so dramatically? \n\nHe’s holding something back. We sense that he is loyal, deeply attached to a key figure in his life: his mother. He’s protective; he’s not talking. But how far can you go for the sake of family loyalty..."
      }
    ],
