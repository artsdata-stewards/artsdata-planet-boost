    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Hippocampe | Can starfish catch COVID too? | Sep 10 - 11, 2025 | Arts Court — Theatre"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/39222/hippocampe_1__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Summer 2020. A pandemic is raging, theatres are empty, and the future of the world as we know it is uncertain. An artist whose projects have all been cancelled is spending the summer with his six-year-old daughter. With Mom still working, the father-daughter duo grow bored, and amid pandemic anxiety, they go on a road trip from New Brunswick to Quebec. Their journey turns out to be much more than a camping adventure: it becomes an exploration of the territory..."
      }
    ],
