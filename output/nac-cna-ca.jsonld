      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Come join Jessica Dumont for this beaded strawberry earring workshop!  \nIn this 3-hour workshop, Jessica will guide you through the earring making process where you can share your process and ask questions along the way. \nSuitable for beginner beaders and experienced beaders alike, ages 16 and up. Workshop will be delivered in English.\n\nThis workshop takes place at 1 Elgin St, in the National Arts Centre's Atelier Shenkman Smith which is located across from the Box Office. "
      }
