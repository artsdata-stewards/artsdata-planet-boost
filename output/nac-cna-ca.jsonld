    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "James Ehnes en récital  | Série Grands Interprètes |   dim  3 mai 2026, 20 h 00|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38400/5__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Votre concert en trois infos clés :\n\n\n\tLe violoniste canadien mondialement célèbre est de retour à la Salle Southam pour un récital solo à l’occasion de son 50e anniversaire.\n\tDécrit comme « un violoniste dans une classe à part » (The Times), James Ehnes est le musicien classique le plus souvent récompensé aux prix JUNO, avec 12 statuettes à son actif.\n\tJames Ehnes et le pianiste Andrew Armstrong sont des collaborateurs de longue date qui se sont produits ensemble en Amérique du Nord, en Europe et en Australie.\n\n\nDepuis maintenant..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
