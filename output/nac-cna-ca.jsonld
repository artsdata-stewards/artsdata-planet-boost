    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Loreena McKennitt  | The Mask and Mirror : Tournée du 30e anniversaire |   mar 20 oct 2026, 20 h 00|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40239/main_website2__large.jpg"
