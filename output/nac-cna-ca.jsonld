    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Dance Theatre of Harlem   | Programme mixte |  29-30 jan 2026|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38358/_0000_dth_company_artists_derek_brockington_and_delaney_washington_photo_by_nir_arieli-b__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Donizetti Variations de George Balanchine (26 minutes)\nEntracte : 20 minutes\nNew Bach de Robert Garland (16 minutes)\nPause : 4 minutes\nPassage of Being (extrait) de Jodie Gates (10 minutes)\nEntracte : 20 minutes\nBlake Works IV (The Barre Project) de William Forsythe (23 minutes)\n\nAvec l’Orchestre du CNA\n\nLes variations infinies du ballet\n\nDance Theatre of Harlem (DTH) occupe une place singulière dans l’univers du ballet, incarnant et promouvant une vision audacieuse et inspirante ancrée dans le XXIᵉ siècle. Composée d’un ensemble multiethnique, cette compagnie présente un répertoire diversifié et avant-gardiste, comportant..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/event/38358"
      }
    ]
  },
