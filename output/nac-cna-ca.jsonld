    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Cher Tchekhov  | Le tout dernier Michel Tremblay |  17-19 nov 2022|  Théâtre Babs Asper"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/30555/cna_siteweb_banniere_1440x810px_chertchekhov__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "C’est l’automne, mais il fait doux. Une table a été dressée dehors. La dinde rôtit au four. Tout est prêt pour un souper de famille. Sauf que le dramaturge veut retravailler sa pièce. La commenter et la réécrire en direct, pendant qu’une fratrie d’actrices, leur frère auteur et un critique se donnent la réplique. \n\nToi qui as vu toutes les pièces de Michel Tremblay. Qui as été ému·e parce qu’elles te parlaient d’un Québec que tu connais. Toi qui as vu..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
