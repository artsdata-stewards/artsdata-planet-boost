    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Kimmortal  |   mar 28 jui 2026, 19 h 30|  Quatrième Salle"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41358/kimmortal-web__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Chez Kimmortal, tout est contraste : une énergie subversive, une vulnérabilité à vif. Une voix qui glisse entre chant et rap sur des productions hip-hop densément texturées. Son troisième album Shoebox (2023) retrace son travail de guérison des traumatismes intergénérationnels, célèbre la communauté 2ELGBTQ+ et convoque l’enfant intérieur. Son nouveau microalbum, sunniest of days (2025), a dominé le classement hip-hop !earshot pendant huit semaines. Avec Shad, Super Duty Tough Work et Junia-T en invités, le projet transforme le deuil, intime..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
