    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Rum Ragged   | Beau, bon, gratuit |  14-15 jui 2026|  Terrasse en bois"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
