    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "L’autonomisation des femmes dans le monde de la musique  | Présentation musicale - Troisième journée |   sam  2 mai 2026, 19 h 30|  Studio Azrieli"
      }
    ],
    "http://ogp.me/ns#image": [
