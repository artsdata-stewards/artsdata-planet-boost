    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Céleste Lévis  | Chante Noël |   sam 20 déc 2025, 20 h 00|  Quatrième Salle"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/39329/websize_celeste_levis__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Une tradition du temps des fêtes qui se poursuit pour une 7e année! \n\nDe retour au CNA, Céleste Lévis vous convie à une soirée magique, chaleureuse et familiale. Accompagnée de ses complices, elle interprétera avec sa voix à la fois douce et puissante des chansons de Noël originales qu’elle a créées au fil des ans, ainsi que les grands classiques incontournables du temps des fêtes. \n\nDans une ambiance intime, autour d’un piano qui évoque ses débuts chez son grand-père dans le nord de..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
