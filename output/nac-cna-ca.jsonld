    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Roxanne Goodman   | Beau, bon, gratuit |   sam 15 aoû 2026, 16 h 30|  Sur le long du Canal Rideau"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40968/roxanne_goodman_-_photo__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Préparez-vous à vivre une soirée inoubliable Roxanne Goodman! \n\nRoxanne Goodman est une artiste magnétique au timbre unique, capable de passer du jazz au gospel, du blues à la pop avec une aisance incroyable. Sur scène, son énergie communicative transforme chaque événement – mariages, soirées d’entreprise, fêtes communautaires ou rassemblements éclair géants – en moments inoubliables qui font sourire et chavirer le public. \n\nCompositrice et productrice accomplie, elle insuffle passion et créativité dans toutes ses interprétations. Diplômée en musique de l’Université Concordia, elle..."
      }
    ],
