      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Mozart, Márquez et Pablo Sáinz-Villegas  | avec l'Orchestre du CNA |  14-15 jan 2026|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38408/13__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Votre concert en trois infos clés :\n\n\n\tWolfgang Amadeus Mozart considérait la première de sa symphonie « Prague » comme l’un des plus beaux jours de sa vie.\n\tLe guitariste Pablo Sáinz-Villegas s’est produit aux quatre coins du monde – y compris lors d’un concert sur une scène flottante qui voguait sur le fleuve Amazone.\n\tLa musique d’Isidora Žebeljan a été décrite comme « une fantaisie frénétique, qui hurle et sanglote, quelque part entre Belgrade et New York ».\n\n\nAlors au sommet de sa popularité, Wolfgang Amadeus Mozart a composé la symphonie..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/event/38408"
      }
    ]
  },
