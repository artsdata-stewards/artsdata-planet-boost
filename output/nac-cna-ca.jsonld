    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Aviva Chernick et le Quatuor La Serena   | Beau, bon, gratuit |   mer 26 aoû 2026, 12 h 00|  Atrium O’Brien"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40940/aviva_chernick_and_la_serena_quartet_horizontal_3782_indoors_by_curtis_perry__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Apportez votre dîner pour une pause musicale gratuite en milieu de journée au lumineux Atrium! Trouvez-vous un endroit confortable pour écouter d’incroyables artistes. De quoi vous donner une bonne dose d'énergie pour le reste de la journée! \n\nChanteuse et leader de groupe, Aviva Chernick revisite la musique traditionnelle folk judéo-espagnole. Entourée de ses complices, elle capture avec intimité et émotion l’héritage de cette musique pour la remettre au goût du jour. \n\nElle chante en hébreu, ladino, yiddish et anglais. Sur scène, sa..."
      }
    ],
