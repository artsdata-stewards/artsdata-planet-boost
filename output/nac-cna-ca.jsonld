      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Arbres | A retrospective for the future | Sep 9 - 13, 2025 | Azrieli Studio Foyer"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/39220/arbres_1__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Departures take place every 45 minutes from 5:15pm to 9pm. You will be able to choose your departure time when purchasing tickets.\n\nA car stands motionless in a forest of poems, but despite everything, time moves on and the landscape changes. Inspired by Paul-Marie Lapointe’s poem of the same name, Arbres pays tribute to trees that have disappeared. A small ecological museum that looks at our relationship with our natural environment. \n\nA site-specific performance/installation created by André Perrier and presented inside a vehicle, Arbres is..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ],
