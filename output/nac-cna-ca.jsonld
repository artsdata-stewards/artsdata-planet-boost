      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Diyet and the Love Soldiers  |   jeu 12 mar 2026, 20 h 00|  Quatrième Salle"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40070/pheonix_pagliacci_(1)__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Liées par le territoire et transformées par la langue, les chansons organiques et authentiques de Diyet sont une invitation à écouter le monde qui nous entoure.  \n\nPour Diyet, la musique et les mots ont toujours été un refuge, le moyen idéal pour une enfant timide de se faire entendre. Après des études en musique et un bref passage dans l’édition, elle a ressenti l’appel de ses racines. De retour chez elle, elle s’est plongée dans l’écriture avec une sincérité intense. Ce virage improbable a débouché sur des collaborations internationales, de nombreuses tournées et..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/event/40070"
      }
    ]
  },
