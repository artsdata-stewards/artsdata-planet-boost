    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "L’autonomisation des femmes dans le monde de la musique  | Présentation musicale - Première journée |   jeu 30 avr 2026, 19 h 00|  Quatrième Salle"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
