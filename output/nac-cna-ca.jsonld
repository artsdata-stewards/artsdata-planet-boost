    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Moulin Rouge! The Musical  |  12-17 mai 2026|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38563/00_bac_seasons25-26_1440x810_nacwebsite_productionshots_mro__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Sortez le champagne, Moulin Rouge! The Musical a remporté 10 prix Tony, dont celui de la meilleure comédie musicale! Plongez dans un monde de splendeur et de romance, d’excentricité, de faste, de grandeur et d’éclat! Un monde où bohémiens et aristocrates se côtoient et se délectent d’un enchantement électrisant. Laissez-vous séduire par Moulin Rouge! The Musical Le film révolutionnaire de Baz Luhrmann prend vie sur scène, revisité dans une nouvelle production musicale extravagante. Mis en scène par Alex Timbers, lauréat d’un prix Tony, Moulin Rouge!..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
