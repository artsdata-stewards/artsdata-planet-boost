    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Ottawa Jazz Orchestra  | Supremely Shorter |   sam 16 mai 2026|  Quatrième Salle"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/39367/ojo__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Découvrez l'héritage durable de Wayne Shorter, lauréat de 12 prix Grammy, dont le talent colossal en tant que saxophoniste et compositeur de jazz a laissé une marque indélébile sur la musique. Depuis ses débuts, avec des rôles essentiels au sein des Jazz Messengers d'Art Blakey, du second grand quintet de Miles Davis et de l'influent groupe de jazz fusion Weather Report, Shorter n'a cessé de repousser les limites. Nombre de ses brillantes compositions sont aujourd'hui des pierres angulaires  du répertoire..."
      }
    ],
