      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Rose  | Livret, paroles et musique de Tomson Highway |  25mar- 4 avr 2026|  Théâtre Babs Asper"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/38352/rose__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le dramaturge autochtone primé Tomson Highway, à qui l’on doit The Rez Sisters et Dry Lips Oughta Move to Kapuskasing, poursuit son « cycle de la réserve » avec Rose, une comédie musicale touchante à l’humour mordant. Et c’est au Théâtre autochtone du CNA qu’aura lieu la première mondiale professionnelle!\n\nDans la réserve fictive de Wasaychigan Hill germent les récits de trois Rose. Toute jeune cheffe, la première Rose est déterminée à asseoir son autorité tout en préservant l’intégrité de sa..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/event/38352"
      }
    ]
  },
