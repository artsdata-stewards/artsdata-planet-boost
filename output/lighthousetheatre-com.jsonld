    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Motown Memories"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@language": "en",
        "@value": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "en",
        "@value": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Motown Memories is a live concert celebrating some of the biggest names in music such as Diana Ross and The Supremes, Gladys Knight and the Pips, The Shirelles, and soulful favourites such as Aretha Franklin and Stevie Wonder.\nStarring The Tonettes, Cathy and Marlene, with guest performer Selena Evangeline, this show showcases the incredible vocal harmonies of these leading ladies, together delivering a powerful and soulful performance just the way it was back in the 60s.\nAccompanied by a live band, hear your favourites – Stop! In The Name of Love, You Can’t Hurry Love, Signed Sealed Delivered, Think, Natural Woman, A Change Is Gonna Come, and many others. This timeless music will have you singing and dancing all night long.\n"
      }
    ]
  },
