    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://lighthousetheatre.com/event/voodoo-lounge/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Voodoo Lounge &#8211; Tribute To The Rolling Stones"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@language": "en",
        "@value": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "en",
        "@value": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "TIME WARP PROMOTIONS PRESENTS:\nVOODOO LOUNGE &#8211; TRIBUTE TO THE ROLLING STONES\nThe excitement and electricity when Voodoo Lounge hits the stage is palpable. You have the sensation that the Rolling Stones are right in front of you. For any Rolling Stones fan, this is a chance to go back in time and relive the Rolling Stones in their prime. For new generations of Stones fans, this will be a history lesson about the greatest rock and roll band in the world &#8211; The Rolling Stones!\n"
      }
    ]
  },
