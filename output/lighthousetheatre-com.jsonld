      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Beatle Band"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@language": "en",
        "@value": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "en",
        "@value": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The Beatle Band (formerly The FabFour Canada) is an engaging and entertaining musical tribute to one of pop-rock music&#8217;s most revered and influential bands &#8211; The Beatles!\nThe Beatle Band accurately recreates the excitement and energy of The Beatles&#8217; 1963 to 1966 &#8220;Touring Years&#8221; repertoire, the historic &#8220;Rooftop&#8221; performance of 1969 through to the historic sounds of Abbey Road.\nNever relying on any recorded backing tracks whatsoever, The Beatle Band is renowned for their attention to detail in song arrangements, costumes and gear.\nFor audiences of any age, The Beatle Band show is must-see entertainment. Indeed, &#8220;a splendid time is guaranteed for all.&#8221;\n"
      }
    ]
  },
