    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Reign: The Queens of Blues, Soul &#038; Rock &#8216;n Roll"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@language": "en",
        "@value": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "en",
        "@value": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Reign: The Queens of Blues, Soul and Rock ‘n Roll is a biographical concert showcasing a century of anthems popularized by Black female artists who revolutionized the music industry and garnered regal titles like Queen, Goddess, Mother, and Empress! If you love songs like Proud Mary, Lady Marmalade, RESPECT, Mr. Big Stuff, and I’m Coming Out, this concert is for you!\nFeaturing the music of ARETHA FRANKLIN, ETTA JAMES, PATTI LABELLE, WHITNEY HOUSTON, ROBERTA FLACK, TINA TURNER, THE SUPREMES and more, this big-band production takes you on a journey through music history and honours Black female artists who transformed music’s most popular genres!\nStarring Juno-nominee PATRICIA SHIRLEY,  soulful vocal powerhouse GERI DEFOE, Memphis International Blues Challenge finalist GARNETTA CROMWELL, with special guest, Canadian Idol judge FARLEY FLEX as the Narrator,  Reign: The Queens of Blues, Soul, and Rock ‘n Roll is a musical masterpiece and ultimate friends-night-out that will have you on your feet and dancing in the aisles!\n"
      }
    ]
  },
