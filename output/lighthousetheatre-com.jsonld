    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "This Christmas Season, Amberley Beatty is back as Patsy Cline and embracing the spirit of Christmas. Sing along to all of your favourite Patsy Cline hits including many timeless Christmas classics that will surely warm your heart.  Bringing you home for Christmas with Amberley Beatty, star of The Legendary Patsy Cline Christmas Show.\n"
      }
