    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "THAT 70&#8217;s ROCK SHOW"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@language": "en",
        "@value": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "en",
        "@value": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<strong class=x-el x-el-span c1-1d c1-1e c1-b c1-89 c1-3e c1-8a c1-8b>That 70&#8217;s Rock Show</strong> is a high-energy tribute band that brings the unforgettable sound of 1970s classic rock to life. Featuring some of Canada’s top-tier musicians—with decades of experience performing across North America&#8217;s premier venues—the band delivers an authentic, electrifying live experience.\nFrom <strong class=x-el x-el-span c1-1d c1-1e c1-b c1-89 c1-3e c1-8a c1-8b>Led Zeppelin</strong> to <strong class=x-el x-el-span c1-1d c1-1e c1-b c1-89 c1-3e c1-8a c1-8b>The Who</strong>, <strong class=x-el x-el-span c1-1d c1-1e c1-b c1-89 c1-3e c1-8a c1-8b>Eagles</strong> to <strong class=x-el x-el-span c1-1d c1-1e c1-b c1-89 c1-3e c1-8a c1-8b>Aerosmith</strong>, <strong class=x-el x-el-span c1-1d c1-1e c1-b c1-89 c1-3e c1-8a c1-8b>The Doobie Brothers</strong> to <strong class=x-el x-el-span c1-1d c1-1e c1-b c1-89 c1-3e c1-8a c1-8b>Journey</strong>, and <strong class=x-el x-el-span c1-1d c1-1e c1-b c1-89 c1-3e c1-8a c1-8b>Fleetwood Mac</strong> to <strong class=x-el x-el-span c1-1d c1-1e c1-b c1-89 c1-3e c1-8a c1-8b>The Police,</strong> That 70&#8217;s Rock Show covers the decade&#8217;s biggest rock anthems. Every performance is a nostalgic journey through the golden era of rock, capturing the spirit, sound, and raw power of 1970–1979.\nWhether you’re reliving the classics or discovering them anew, That 70’s Rock Show is your ticket back to the greatest decade in rock music.\n"
      }
    ]
  },
