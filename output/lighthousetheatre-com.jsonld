    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Amanda Keeles &#8216;Can&#8217;t Stop Me Now&#8217; Tour"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@language": "en",
        "@value": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "en",
        "@value": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Described as unstoppable and fiercely creative, Amanda Keeles has twice taken the top spot in The Canadian Open Songwriting Contest, featured on SiriusXM Canada&#8217;s Top of the Country, IHeart Radio, SiriusXm Canada Talks, Billboard Canada #5 Top CANCON Download &amp; #5 Most Active Indie for Can’t Stop Me Now, and has been added to commercial Country radio across Canada, US, Australia and UK. Recently named as CMA Ontario’s Artist of the Month, she has appeared on Canada Coast to Coast as well as international entertainment and music news podcasts. Her debut album &#8220;Can&#8217;t Stop Me Now&#8217; was released in early 2024 and has released 6 singles from the album,  that have garnered significant airplay and streams, as well as the name of Amanda’s current Album Tour.  Keeles has charted in the top 5 numerous times on the Canadian Indie Top 100 Countdown, as well as awarded Best Music Video with videographer Jake Sauve from Roadhouse Productions at the 2024 FCLMA awards &amp; 2024 Toronto Independent Film Festival for her release Saving Grace. The video was also a finalist at the Los Angeles Film Awards and the Official Selection for screening at The International New York Film Awards &amp; Montreal Independent Film Festival.\nAmanda Keeles blends country with pop sensibilities and a dash of rock to create her &#8220;Can&#8217;t Stop Me Now&#8221; album tour currently touring throughout 2024 in Ontario.  Keeles&#8217; reflective songwriting and  powerhouse vocal dexterity take centre stage with self written originals, high energy country covers and recognizable classic rock favourites. Her band consists of some of the best musicians in the industry, with Scott Szeryk (lead guitar), Brian McHugh (drums), James Vermue (Bass) &amp; Shem Jacob (rhythm/acoustic guitar) each having toured individually throughout Canada, US and Europe, opening for big shows such as Blake Shelton, Lonestar and Kim Mitchell.\n"
      }
    ]
  },
