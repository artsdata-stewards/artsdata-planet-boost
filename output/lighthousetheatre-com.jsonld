      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Memories Of The Rat Pack"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@language": "en",
        "@value": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "en",
        "@value": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Frank Sinatra, Dean Martin and Sammy Davis Jr. come to life in this nostalgic concert. Relive the days of the Rat Pack with Las Vegas’ most famous entertainers and their live big band orchestra just as they appeared live in the Sands Hotel Copa Room back in the early 1960’s! With a stellar cast of some of the finest performers in the business, The Rat Pack Show has been hailed as the next best thing to seeing the original Rat Pack themselves. Nothing but class and cool…with the occasional roast and very frequent toasts to each other! This show has played to critical and audience acclaim for over twenty years, across Canada, the US, and Europe.\n"
      }
    ]
  },
