    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "DESIRE A U2 TRIBUTE"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@language": "en",
        "@value": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "en",
        "@value": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "DESIRE, THE INTERNATIONAL U2 TRIBUTE ACT\nAudiences that have witnessed The International U2 Tribute – Desire, have been left speechless after experiencing the passion and authenticity of their performances.\nDesire followed in the footsteps of U2; unifying as friends in high school and through years and years of practice now bring to life the soul, spirit and bravado of U2’s 3 decades of ‘Magnificent’ music.\nWITNESS what people all over North America are talking about.\n"
      }
    ]
  },
