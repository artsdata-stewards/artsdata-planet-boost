    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "KEEP THE FAITH &#8211; Celebrating the music of Bon Jovi"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@language": "en",
        "@value": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "en",
        "@value": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "TIME WARP PROMOTIONS PRESENTS:\nKEEP THE FAITH\n<p class=p1>Keep The Faith is the International Tribute to Bon Jovi providing you with the unequivocal live concert experience. Every note, move and detail is carefully crafted and choreographed to deliver you the ultimate Bon Jovi experience. Keep The Faith has not only toured the Philippines, but has also been hired to perform shows at Seaside Heights, NJ by buyers that are personal friends of Bon Jovi.\n<p class=p1>This family friendly, high energy and intensively interactive journey will make you feel like you are actually part of the show like a sixth member of the band! You will hear big radio hits including songs like &#8220;You Give Love A Bad Name&#8221;, &#8220;Livin On A Prayer&#8221;, &#8220;Wanted Dead Or Alive&#8221; and &#8220;It&#8217;s My Life&#8221; to name a few! Bon Jovi is famous for their blockbuster ballads including &#8220;Bed Of Roses&#8221;, and &#8220;Always&#8221; and there are many more.\n<p class=p1>So, from Bon Jovi&#8217;s first self titled album to the new Forever album come join Keep The Faith for an amazing ride to celebrate 40 years of this incredible Legendary band called Bon Jovi!\n<p class=p1><a href=https://youtu.be/DKV_hwWi9Pk?si=ze7BJcStuD_iq4kf>https://youtu.be/DKV_hwWi9Pk?si=ze7BJcStuD_iq4kf</a>\n"
      }
    ]
  },
