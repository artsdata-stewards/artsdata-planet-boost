    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Handel&#8217;s Messiah"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@language": "en",
        "@value": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "en",
        "@value": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "On November 24, 2023, at 7:30pm, the acclaimed southwestern Ontario music ensemble, Arcady, will make its Port Colborne debut, with the triumphant sounds of Handel’s Messiah. Often regarded as the greatest musical work ever written, Messiah has long been a specialty of Arcady. The celebrated ensemble continues to keep this annual holiday tradition alive with its popular performances across South Western Ontario. This production of the Messiah will be directed by renowned conductor, Ronald Beckett.\n"
      }
    ]
  },
