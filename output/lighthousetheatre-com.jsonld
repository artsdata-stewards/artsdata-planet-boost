    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Rocky Horror Picture Show Screening + Dance Party"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@language": "en",
        "@value": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "en",
        "@value": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<span class=WdYUQQ text-decoration-none text-strikethrough-none><strong>Screening: 7:30 PM | Dance: 9:00 PM — 11:30 PM</strong></span>\n<span class=WdYUQQ text-decoration-none text-strikethrough-none>Do the time warp, literally! Join us for an evening of horror, dancing, candy and fun as we celebrate the spooky season with a viewing of the Rocky Horror Picture Show and a killer Halloween dance! Groove with ghouls, dance with demons, shake with spirits and roll with Rocky! With catered food, a candy bar and the amazing DJ services of Black Creek Music, you&#8217;ll scream&#8230; you&#8217;ll laugh&#8230; and then scream again!</span>\n<span style=text-decoration: underline;><strong>Please note that this is a 19+ event. No outside food or drink allowed (Movie props such as toast and water guns are absolutely allowed). Bag Check policy will be in effect.</strong></span>\nCurious about what props to bring and when to throw them? Check out the guide <a href=https://www.rockyhorror.com/participation/proplist.php>here</a>!\n<h6 class=_04xlpA direction-ltr align-center para-style-body><strong><span class=WdYUQQ text-decoration-none text-strikethrough-none>Please bring non-perishable food and hygiene products for the </span><span class=WdYUQQ text-decoration-none text-strikethrough-none>PORT DOVER AND AREA LIFELINE FOODBANK</span></strong></h6>\n&nbsp;\n"
      }
    ]
  },
