    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "ACROBAT &#8211; The U2 Tribute Show"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@language": "en",
        "@value": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "en",
        "@value": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "ACROBAT models it&#8217;s performances after the best of U2&#8217;s live concerts over the past 40 years &#8211; playing the full repertoire of top charted hits and rarities that satisfy both casual and hardcore fans alike. The full ACROBAT experience authentically features stunning multimedia visuals unique to past U2 tours. The show also takes the audience front row and centre to relive ACROBAT’s once-in-a-lifetime experience of being personally invited onstage by Bono to perform Desire with the real U2 on July 6, 2015 at Toronto’s Air Canada Centre in front of 22,000 cheering U2 fans.\nBased in Toronto, Canada and touring internationally, ACROBAT &#8211; The U2 Tribute has presented the live U2 concert experience to thousands of fans at theatres, music halls, festivals and corporate events across the Canada, the USA, and Latin America. U2&#8217;s own record label has commissioned ACROBAT several times to provide customized theme shows for industry events and U2 fan festivals during both the U2: Innocence + Experience and The Joshua Tree 2017 tours.\n"
      }
    ]
  },
