        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "A Gentleman's Guide to Love & Murder - 2025 Community Show - Lighthouse Festival"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Failing producer Max Bialystock and his accountant, Leo Bloom, scam a group of elderly women out of their nest eggs by convincing them to invest in a horrendously offensive Third Reich-themed musical secretly intended to bomb the moment it opens. But when high-brow Broadway audiences mistakenly assume \"Springtime for Hitler\" is a satire, Bialystock finds himself with the critical acclaim that has long eluded him -- and the biggest hit of his career!"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://lighthousetheatre.com/event/a-gentlemans-guide-to-love-murder-2025-community-show/"
      }
    ],
