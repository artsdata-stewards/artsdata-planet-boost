    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "When a young real estate agent tries to persuade an old, bachelor farmer to sell his family farm, he figures that he&#8217;ll succeed where other agents have failed&#8230; until he meets the old farmer&#8217;s secretive and high-spirited great niece.\nYour health and safety is a priority when visiting our venues.<a href=https://lighthousetheatre.com/covid/> Click here to see our COVID-19 Duty of Care. </a>\n"
      }
    ]
  },
