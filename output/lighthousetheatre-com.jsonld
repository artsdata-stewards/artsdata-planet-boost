    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<div class=page title=Page 7>\n<div class=section>\n<div class=layoutArea>\n<div class=column>\nThe producers of Abbamania bring you this fantastic show. Relive the music and comedy of The Sonny &amp; Cher Show. A musical reproduction of that TV show bring you the hits of Sonny &amp; Cher and the hits of Cher. This production feature the TV commercials for that show. Plus surprise musical guests. Do not miss this live musical &#8211; A great night out!\n</div>\n</div>\n</div>\n</div>\n"
      }
    ]
  },
