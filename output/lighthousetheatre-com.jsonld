    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Pearl: A Janis Joplin Experience"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@language": "en",
        "@value": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "en",
        "@value": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "If you love Janis Joplin, the blues, and ’60s music, you must see this concert! Pearl: A Janis Joplin Experience recreates the unforgettable sound and style of Janis Joplin, the Queen of rock and blues in a sensational multi-media musical production Ontario audiences have never seen before!\nCatapulting into stardom in the mid-60s, Janis Joplin’s signature style and polyphonic sound, unmatched emotional rawness and passion, dynamic stage presence, and unique portrayal of unearthed Blues standards paved the way for female artists and continue to inspire and invigorate music lovers 50 years later – and Pearl: A Janis Joplin Experience brings it all to you LIVE on stage!\nJoin The Voice of Janis Joplin, Christina Leroux, and her 8-piece all-star band, as Pearl: A Janis Joplin Experience amazes audiences with their unforgettable journey through Joplin’s iconic catalogue including Cheap Thrills, I Got Dem Ol’ Kozmic Blues Again Mama!, and Pearl and pays homage to one of music’s greatest legends!\nFeaturing hits like Me and Bobby McGee, Piece of My Heart, and Cry Baby, this is a must-see musical sensation you won’t want to miss!\n"
      }
    ]
  },
