    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Bed & Breakfast - Lighthouse Festival"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Brett and Drew want to move out of their tiny downtown condo and into a house, but they just lost their seventh bidding war in Toronto. When Brett’s beloved Aunt Maggie dies, he unexpectedly inherits the historic family home in a quiet little tourist town. Unhappy with their careers and frustrated by life in the fast-paced city, the couple decides to make the move and start up a B & B. But when the guys face friction in their new community, they discover the simple life is more complicated than they thought…"
      }
    ],
