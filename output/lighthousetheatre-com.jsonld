    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Hill Mcgraw is a stunning tribute to country music&#8217;s most popular couple. Performing hits from the solo careers of Fatih Hill and <span class=outlook-search-highlight>Tim</span> Mcgraw as well as their most loved duets. Come see this endearing show featuring two great singers performing together.\n"
      }
    ]
  },
