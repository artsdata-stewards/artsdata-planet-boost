    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The Rotary Clubs of Norfolk are hosting a special event to recognize four outstanding citizens of Norfolk. These community leaders will be honoured as Paul Harris Fellows highlighting their commitment to making our community a better place.\nFriends, family, associates of the honourees and the general public are invited to attend this gathering to be held at Lighthouse Theatre. A mix and mingle ,starting at 6:00 PM, will take place in the Long Bar and will feature hors-d’oeuvres by chef Tracy Winkworth and a cash bar followed by the formal presentations in the main theatre.\n"
      }
    ]
  },
