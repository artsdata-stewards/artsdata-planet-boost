    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Mudmen: 25th Anniversary Tour"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@language": "en",
        "@value": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "en",
        "@value": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Red Plaid Productions Presents The Mudmen’s 25th Anniversary tour. Enjoy an all-ages family-friendly show of Celtic music &amp; stories from Canada’s Celtic Rock Warriors. The Mudmen have shared the stage  and or opened for the Irish Rovers, The Chieftains, ZZ Top, The Guess Who, Johnny Reid, John McDermott, Kim Mitchell, April Wine and many more. The Mudmen have headlined and performed  shows and festivals in 8 different countries.\nCareer highlights include meeting &amp; performing for the Queen of England on Parliament Hill, performing at the 1984 Edmonton Oilers televised Stanley Cup reunion, performing at the CBC  televised Oilers/Flames home opening ceremonies, 12 Canada’s Walk of Fame ceremonies, Bob &amp; Doug Mackenzie Brothers TWO-FOUR special on the CBC, 7 Grey Cups, 3 Memorial Cups, 8 Molson Canadian Snow Jams, 3 Edgefest’s, 3 Briers with television performances at The Governor’s General Awards, The Ted Rogers Awards, The Canadian Country Music Awards, The Special Olympics, BT Toronto, Much Music, and guesting on the CBC Hockey Night in Canada Anthem produced by Rock Icon Bob Rock where Ron MacLean said televised Mudmen we love ’em!\nWith over 3000 shows to date, Johnny Reid says, Mudmen are Canada’s best-kept Secret. Don Cherry says, they’re good Canadian Boys ,the Phantom of The Opera, Colm Wilkinson says, they’re a hard act to follow, and Polka King Walter Ostanek says he’s, proud of them.\nFor more info on Mudmen visit www.mudmen.ca\n"
      }
    ]
  },
