    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Anticipation: The Carly Simon and James Taylor Story"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@language": "en",
        "@value": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "en",
        "@value": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Anticipation: The Carly Simon and James Taylor Story is a heartfelt musical journey through one of the most iconic love stories and musical partnerships of the 1970s. This intimate concert celebrates the timeless songs, stories, and spirit of two legendary singer-songwriters whose music defined a generation.\nFeaturing beloved hits like You’re So Vain, Fire and Rain, Mockingbird, How Sweet It Is, and Anticipation, the show captures the warmth, romance, and emotional depth that made Carly Simon and James Taylor household names. With beautiful harmonies, authentic arrangements, and a touch of storytelling magic, audiences are transported back to an era when songwriting was pure poetry.\nJoin us for an unforgettable evening of nostalgia, love, and timeless music — a tribute to the enduring legacy of Carly Simon and James Taylor.\nThe band features singer-songwriter Claire Hunter on guitar, piano, and vocals, David Skolnick on guitar, piano, and vocals, Danny Zaidman on guitar and vocals, Mike Wark on sax and flute, Adam Kurgatnikov on bass, and Aaron Spink on drums and vocals.\n"
      }
    ]
  },
