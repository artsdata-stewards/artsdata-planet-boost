    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The New Canadian Curling Club"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@language": "en",
        "@value": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "en",
        "@value": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Monday nights are the Learn to Curl classes in this Ontario small-town, inspired by the local refugee resettlement program, to welcome newcomers. But when its organizer slips on the ice and breaks her hip, it’s left to the rink’s ice maker and former champion curler, Stuart MacPhail, to step in as head coach. The trouble is, Stuart has some strong opinions about immigrants… what follows is the hilarious and inspiring story of a group of unlikely athletes who faceoff against local prejudice to become a true team.\n"
      }
    ]
  },
