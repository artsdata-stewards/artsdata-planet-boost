    "http://schema.org/eventStatus": [
      {
        "@language": "en",
        "@value": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "This Christmas season, join us as we celebrate the wonderful world of Christmas with A Christmas Spectacular starring the incredible showman Pete Paquette with the Rockin’ Royals Showband, The Tonettes, and special guest performer.<br aria-hidden=true /><br aria-hidden=true />Enjoy and sing along to more than 30 greatest Christmas carols and songs of inspiration, a two hour show that will surely warm your heart this season. From Andy Williams’ classic It&#8217;s The Most Wonderful Time of The Year, Bing Crosby’s White Christmas, Elvis Presley’s Blue Christmas to inspirational songs such as Leonard Cohen’s Hallelujah and John Lennon&#8217;s &#8220;Imagine&#8221;.<br aria-hidden=true /> <br aria-hidden=true />Make this your holiday tradition, a must see Christmas show, fun for the whole family.\n"
      }
    ]
  },
