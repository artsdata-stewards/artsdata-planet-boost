        "@id": "https://lighthousetheatre.com/event/motown-gold/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Motown Gold"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@language": "en",
        "@value": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "en",
        "@value": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Motown Gold is a dazzling celebration of the timeless music that defined a generation. Audiences will he transported back back to Detroit&#8217;s iconic Motown sound, with unforgettable performances of chart-topping classics made famous by legends such as The Supremes, Stevie Wonder, The Temptations, Marvin Gaye, Smokey Robinson, and more.\nThis high-energy show combines powerhouse vocals, authentic arrangements, and vibrant choreography, creating a nostalgic yet fresh concert experience that appeals to audiences of all ages. Motown Gold features outstanding live musical performances starring the soulful lead vocalists Malia Love and Gavin Williamson and backed by the renowned Rudy &amp; the Angels band.\nWhether you grew up with these soulful hits on are discovering them for the first time, Motown Gold is guaranteed to get you moving.\n"
      }
    ]
  },
