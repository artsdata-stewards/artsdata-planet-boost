    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Classic Troubadours: The Songs of James, Joni, Jackson &#038; Carole"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@language": "en",
        "@value": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "en",
        "@value": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Classic Troubadours: an extraordinary musical journey that celebrates the timeless songs of James Taylor, Joni Mitchell, Jackson Browne, and Carole King. Performed by a talented 5-piece Canadian band led by award-winning singer-songwriter Jacob Moon, this tribute goes beyond imitation to honour the artistry of these legendary singer-songwriters.\nFeaturing heartfelt renditions of beloved classics like &#8220;You’ve Got a Friend,&#8221; &#8220;Big Yellow Taxi,&#8221; &#8220;Running on Empty,&#8221; and &#8220;Fire and Rain,&#8221; the show brings the nostalgia and magic of the ‘70s to life. With warm, authentic performances and rich storytelling, Classic Troubadours is more than a concert—it’s a heartfelt tribute to the music that defined a generation.\n"
      }
    ]
  },
