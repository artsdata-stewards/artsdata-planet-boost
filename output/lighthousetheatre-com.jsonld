    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://lighthousetheatre.com/event/redd-raven-a-tribute-to-led-zeppelin/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Redd Raven a Tribute to Led Zeppelin"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@language": "en",
        "@value": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "en",
        "@value": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Redd Raven – A Tribute to Led Zeppelin,\nFast becoming Canada’s #1 Led Zeppelin Tribute!\nPut on your Led Zeppelin T-Shirt, favorite blue jeans and gather your friends!\nTime to go back to the 70’s!!\nA fast-paced show of Led Zeppelin classics performed with interactive video! With decades of experience this Canadian band of veteran rockers created this show to keep Zeppelin fans moving and rocking to the songs they know and love. The show takes the audience on a Zep journey through all of their albums using full covers and surprise medleys that keep them on their toes. The Zeppelin sound is felt throughout the whole show and resonates with long time and newer fans alike. Paying tribute rather than an impersonation makes for a unified experience between the band and the audience, sharing a  Whole Lotta Love for one of the greatest bands of all time!\n"
      }
    ]
  },
