      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Producers &#8211; 2024 Community Show"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@language": "en",
        "@value": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "en",
        "@value": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p style=font-weight: 400;><em>The Producers</em> is Lighthouse Festival&#8217;s 2024 Community Show production!\n<p style=font-weight: 400;>Failing producer Max Bialystock and his accountant, Leo Bloom, scam a group of elderly women out of their nest eggs by convincing them to invest in a horrendously offensive Third Reich-themed musical secretly intended to bomb the moment it opens. But when high-brow Broadway audiences mistakenly assume &#8220;Springtime for Hitler&#8221; is a satire, Bialystock finds himself with the critical acclaim that has long eluded him &#8212; and the biggest hit of his career!\n<p style=font-weight: 400;>Filled with offensive musical numbers, memorable characters and some of the silliest dialogue out there, <em>The Producers</em> is a laugh-a-minute play that will have you howling in your seats and leave you wondering how something so outrageously offensive could be so funny.\n<p style=font-weight: 400;>The original Broadway production opened in April 2001 and won a record-breaking 12 Tony Awards and spawned the 2005 movie version, starring Nathan Lane &amp; Matthew Broderick.\n<em><strong><span class=ui-provider deh dei c d e f g h i j k l m n o p q r s t dej dek w x y z ab ac ae af ag ah ai aj ak dir=ltr>This play includes strong language and mature themes which may be offensive to some viewers.</span></strong></em>\n"
      }
    ]
  },
