    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://lighthousetheatre.com/event/take-me-home-celebrating-john-denver-glen-campbell/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Take Me Home: Celebrating John Denver &#038; Glen Campbell"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@language": "en",
        "@value": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "en",
        "@value": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&#8220;Take Me Home: Celebrating John Denver &amp; Glen Campbell&#8221; is a celebration of two legendary voices who shaped the sound of country and pop music.\nBlending folk, country, and pop with unmatched sincerity, Glen Campbell and John Denver wrote songs that spoke to longing, hope, love, and the pull of home, music that still feels deeply personal decades later.\nThis concert invites audiences on a journey through timeless classics and treasured gems, including Wichita Lineman, Rhinestone Cowboy, Take Me Home, Country Roads, and Annie’s Song.\nTake Me Home features a stellar cast of musicians: Roger Williamson on pedal steel and guitar, Dr. Tom Hamilton on violin, mandolin, and vocals, David Skolnick on piano, guitar, and vocals, Abbey Sholzberg on bass, and John Collin on drums.\n"
      }
    ]
  },
