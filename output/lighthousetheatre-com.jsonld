    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p style=font-weight: 400;>The King and Queen plan a huge party to celebrate the birth of the Princess Aurora, but when the Evil Fairy fails to receive an invitation, her curse changes everything! Can the King and Queen prevent the Princess from pricking her finger on the spindle of a spinning wheel, or will the entire Kingdom fall asleep for a hundred years? Will it take a handsome Prince to wake them up, or just a rubber chicken? Only DuffleBag Theatre knows for sure in this enchanting adaptation of the classic fairy tale. Come play your part in the story to find out!\n"
      }
    ]
  },
