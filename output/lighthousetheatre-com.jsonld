    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Nationally touring stand up comedian Jeff Leeson brings his brand new Comedy Tour to the Roselawn Theatre in Port Colborne on Friday March 22. With over 50 Million Views of his online videos find out why this is one of the best touring comedians in North America today!\n<em><span class=ui-provider a b c d e f g h i j k l m n o p q r s t u v w x y z ab ac ae af ag ah ai aj ak dir=ltr>*Please note this performance is being filmed.</span></em>\n"
      }
    ]
