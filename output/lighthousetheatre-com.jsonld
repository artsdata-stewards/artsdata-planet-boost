    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Tommy Youngsteen performs Fleetwood Mac&#8217;s classic 1977 album &#8220;Rumours&#8221; plus all their Greatest Hits &#8211; Along with an all-star 8 piece band! Tommy Youngsteen is a Toronto based supergroup featuring members &amp; alum from Juno winning bands &#8211; Stars, The Arkells, Sam Roberts Band, The Trews, Lowest of The Low, July Talk &amp; Serena Ryder Band. Tickets on-sale now!\n"
      }
    ]
  },
