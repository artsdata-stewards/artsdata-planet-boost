    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Great Canadian Comedy Caravan Tour"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@language": "en",
        "@value": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "en",
        "@value": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The Great Canadian Comedy Caravan tour is rolling into the Roselawn Theatre and they’re raising urgently needed funds for Port Cares!\nSaturday November 15, join television and film actors, writers and Just For Laughs veterans as they take the stage to help out local families and their children.\nHeadliner, Rick Currie from The Rick Mercer Report, Gemini Award Winner, multiple Canadian Screen Awards for writing in television, CBC’s Laugh Out Loud, CBC’s The Debater, CTV’s Comedy NOW, Just For Laughs, Winnipeg and Halifax Comedy Festivals.\nRick has also appeared on the 2014 Canadian Country Music Awards and Canada 150 Celebrations from Parliament Hill, two national CBC New Years Eve specials and the 2018 Scotiabank Giller Awards.\nHosted by Matt Watson (Just for Laughs 42, Glasgow comedy festival, the Aberdeen comedy festival, the Perth International Arts Festival, the Adelaide fringe Festival, and the Melbourne Comedy festival, and Sirius XM radio).\nTodd Reid (Just For Laughs, Sirius XM, Italian Week Festival &#8211; Main Stage and quarterfinalist in the prestigious PAGE International Screenwriting Awards).\n"
      }
    ]
  },
