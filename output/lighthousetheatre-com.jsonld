    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "March Break Magic with The Illusionist Lucas Wilson"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@language": "en",
        "@value": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "en",
        "@value": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Direct from Guinness World Records join The Illusionist: Lucas Wilson, as he brings his award-winning magic, jaw-dropping illusions, and Guinness World Record feats to Lighthouse Theatre for March Break Magic in support of Tumaini Children’s Foundation!\nBe amazed as Lucas performs his signature award-winning illusions in a show suitable for the whole family! Witness why his straitjacket escapes have earned him 4 official Guinness World Records and have been seen by millions of people around the World!\nThe show will be raising funds for Tumaini Children’s Foundation! They are a non-profit registered charity dedicated to the care, support, and education of orphaned and vulnerable children near Usa River, Tanzania. Visit their website at <a class=ms-outlook-linkify href=http://www.tumainimeanshope.org/ data-ogsc=>www.tumainimeanshope.org</a> to find out more. Tumaini means HOPE in Swahili and with hope everything is possible!\nThe magic continues after the show with an interactive magic workshop with Lucas &amp; Catherine. Learn how to perform your very own magic at home in this LIMITED VIP ONLY workshop.\nJoin the limited VIP experiences which includes:\n-30-minute interactive magic workshop\n-Autographed Poster\n-Souvenir Lanyard\n-Seats within the first 2 rows\nBring the whole family as Lucas Wilson dazzles you with March Break Magic in support of Tumaini Children’s Foundation!\n"
      }
    ]
  },
