    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Classic Seger: Bob Seger&#8217;s Greatest Hits Live"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@language": "en",
        "@value": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "en",
        "@value": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Thrilling audiences across North America, Classic Seger brings the energy, excitement, and raw power of a vintage Bob Seger concert to the stage, leaving fans singing, dancing, and screaming for more!\nClassic Seger is a world class tribute act, performing masterful renditions of Bob Seger and the Silver Bullet Band’s greatest hits featuring songs like; Night Moves, Turn the Page, Against the Wind, Old Time Rock &amp; Roll, and many more all-time favourites. Guaranteed to be a show that rock and roll fans will never forget!\n<a class=ms-outlook-linkify href=https://youtu.be/-Se6Stdrx5M target=_blank rel=noopener data-ogsc=>https://youtu.be/-Se6Stdrx5M</a>\n"
      }
    ]
  },
