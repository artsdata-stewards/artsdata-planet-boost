    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Set on adjoining balconies in a big city apartment building, the play follows John Cummings as he interacts with three women, Fay, Angel, and Gwen, who become his neighbours over a three-and-a-halfyearperiod. Hilarious and, at times, touching. A true Foster delight.\n"
      }
    ]
  },
