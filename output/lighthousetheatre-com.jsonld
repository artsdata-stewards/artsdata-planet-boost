      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<div class=page title=Page 1>\n<div class=section>\n<div class=layoutArea>\n<div class=column>\nSisters Glenda and Suzanne live a quiet retirement selling homemade jam on Manitoulin Island. This summer, their usual concerns &#8211; trying to orchestrate sightings of their handsome veterinarian neighbour and preparing for the visit of Suzanne&#8217;s grown daughter, Beth &#8211; are complicated by a secret the sisters can no longer contain. When Beth arrives with some secrets of her own, the three women face things that will change their lives forever.\n</div>\n</div>\n</div>\n</div>\n"
      }
    ]
  },
