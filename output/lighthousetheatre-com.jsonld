      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The massively popular board game comes to life as a hilarious &amp; fun-filled musical that brings the world&#8217;s best-known suspects to the stage and<strong> </strong>invites the audience to help solve the mystery: who did it, in what room and with what weapon. With 216 possible solutions, audience members must hone their sleuthing skills while enjoying a beguiling score, witty lyrics and comedic antics. In the end, only one hard-nosed detective is qualified to unravel the mayhem and help solve whodunnit!\n"
      }
    ]
  },
