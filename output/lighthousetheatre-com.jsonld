    "http://schema.org/eventStatus": [
      {
        "@language": "en",
        "@value": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<span data-ogsc=rgb(102, 102, 102) data-ogsb=white>GRAND EVOLUTION is a group of 5 world class, journeymen musicians brought together by their admiration for the legendary sounds of 2 of the biggest, multi-platinum selling acts in commercial rock….</span><span data-ogsc=rgb(102, 102, 102)>\nSTYX and JOURNEY.\nThis high energy act will take you back to the arena rock, vinyl era performing hit after hit from a catalogue of some of the most iconic and successful songs ever written. Not only are the songs performed with note for note precision, but costume changes the visuals make attending a GRAND EVOLUTION live performance even more enjoyable.\n</span>\n"
      }
    ]
  },
