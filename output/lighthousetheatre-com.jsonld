    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Hotel California is an Eagles tribute band formed in 1986 that is known for recreating the original band&#8217;s sound with vocal accuracy, precise instrumental work, and soaring harmonies. They are considered a leading tribute act, having toured internationally for decades and performing classic hits like &#8220;Hotel California&#8221; and &#8220;Take It Easy&#8221; note-for-note. Their performances are celebrated for bringing the Eagles&#8217; music to life for audiences around the world.\n"
      }
    ]
  },
