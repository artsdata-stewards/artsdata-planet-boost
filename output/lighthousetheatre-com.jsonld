    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Enchanted Wonders: A Family Magic Show"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@language": "en",
        "@value": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "en",
        "@value": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Join us in an extraordinary adventure filled with jaw-dropping magic big laughs! Enchanted Wonders is a unique, family-friendly show that brings together some of Canada’s most in-demand entertainers in a spectacular display of imagination, music and magic. This powerhouse team has captivated audiences across Canada, from The Walt Disney Company to the iconic stages of the Calgary Stampede and at major family events, they deliver a blend of charisma, whimsical illusions, and interactive magic that delights and amazes audiences of all ages. Enchanted Wonders offers more than just tricks &#8211; it&#8217;s an immersive experience where storytelling, humor, and the art of illusion converge. Perfect for family outings, this show promises an enchanting journey through a world of wonder and excitement!\n"
      }
    ]
  },
