    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Whole Lotta Love A Tribute To Led Zeppelin"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@language": "en",
        "@value": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "en",
        "@value": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Whole Lotta Love A Tribute To Led Zeppelin:\nPut on your Led Zeppelin T-Shirt and gather your friends………………..\nIt’s time to go back to the 70&#8217;s!!\nA must see show for any Led Zeppelin Fan! From a band that has lived it and loved it. This Canadian band of 5 veteran rockers are true Led Zeppelin fans themselves and deliver a fast-paced unique show of Led Zeppelin classics. Taking you on a journey through the band’s early work, while reliving and recreating some of Zep’s legendary live concert moments and ending with their biggest and most iconic songs. The show includes full-length classics along with surprise medleys that will keep the audience on edge wondering where the trip will take them.\nAll done to interactive video while sharing interesting facts on the history of the band!\nThe Zeppelin sound is felt throughout the entire show and resonates with longtime and newer fans alike. Paying tribute rather than an impersonation makes for a unified experience between the band and the audience. Sharing a Whole Lotta Love and celebrating the greatest rock band of all time!\n"
      }
    ]
  },
