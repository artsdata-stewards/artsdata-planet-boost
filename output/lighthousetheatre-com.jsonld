    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Port Colborne Beatlemania!"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@language": "en",
        "@value": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "en",
        "@value": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "NEW SHOW ANNOUNCEMENT! Beatlemania returns to Roselawn Theatre!\nTravel Through Time With The Beatles!\nFrom the electrifying Ed Sullivan debut to the soul-stirring Let It Be, The Liverpool 4 takes you on a magical journey through every iconic era of The Beatles’ legendary career. Experience the unforgettable hits live on stage — delivered with the same energy, impeccable musicianship, showmanship, fun, and cheeky humour that made the Fab Four a global sensation.\nThe Liverpool 4 — Canada’s Tribute to The Beatles — has been captivating audiences across North America for nearly 20 years. With thousands of shows under their belt, they&#8217;ve wowed crowds at venues like Maple Leaf Gardens, Massey Hall, Global TV’s Morning Show, and even Universal Pictures events — not to mention countless theatres and festivals coast to coast.\nThis live concert features two sets with a 20-minute intermission. Whether you&#8217;re singing along, dancing in the aisles, or just rattling your jewelry — you&#8217;ll feel the magic of Beatlemania all over again.\nCome Together — and relive the greatest music ever made!\n"
      }
    ]
  },
