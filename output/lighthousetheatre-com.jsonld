    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "GREEN RIVER REVIVAL, North America&#8217;s foremost tribute to CCR, constantly sells out the Lighthouse Theatre. Get your tickets now to see the greatest hits of CREEDENCE CLEARWATER REVIVAL performed live on stage by one of the most entertaining acts on the theatre circuit .\n"
      }
    ]
  },
