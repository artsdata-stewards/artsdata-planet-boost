    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "New Year&#8217;s Eve Celebration"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@language": "en",
        "@value": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "en",
        "@value": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Ring in the New Year with style at Lighthouse Festival&#8217;s New Year&#8217;s Eve Bash! Join us for an unforgettable evening of celebration, delicious food, and lively entertainment in the heart of Port Dover.\nThe festivities kick off at 8:00 PM with a sumptuous catered spread featuring an array of culinary delights, expertly prepared to please every palate. Whether you&#8217;re a foodie or simply love great food, you&#8217;ll savour every bite while mingling with friends and fellow New Year&#8217;s revellers.\nThe bar will be hopping with your favourite drinks and an amazing NYE signature cocktail.\nAs midnight approaches, raise a complimentary glass of champagne to toast the New Year in style. Feel the excitement build as we count down the final moments of 2024 and welcome in 2025 with joy, laughter, and a festive spirit.\nGet ready to hit the dance floor with our all-request dance party, where the DJ will keep the energy high and the music flowing. From classic hits to the latest chart-toppers, you&#8217;ll be grooving to your favourite tunes all night long.\nTickets are limited, so don’t miss out on this spectacular evening. Celebrate the New Year with Lighthouse Festival and make memories that will last a lifetime (or at least for 2025!)\n<strong>Please note that this is a 19+ event. No outside food or drink allowed. Bag Check policy will be in effect.</strong>\n"
      }
    ]
  },
