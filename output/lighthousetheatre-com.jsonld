    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Tommy Youngsteen- The Very Best of &#8220;The Band&#8221;"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@language": "en",
        "@value": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "en",
        "@value": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Tommy Youngsteen returns to Port Colborne with The Very Best of Canadian Rock Legends &#8220;The Band&#8221; Featuring 11 musicians on-stage.\nRising to fame backing the Legendary Ronnie Hawkins &amp; Bob Dylan &#8211; As Grammy winners &amp; members of the Rock &amp; Roll Hall of Fame, The Band have established themselves as one of the most iconic Canadian rock bands of all time.\nTravel back in time with songs like &#8211; Up on Cripple Creek, The Weight, The Night They Drove Old Dixie Down, Ophelia, plus many more!\nTommy Youngsteen is a Toronto based supergroup featuring members &amp; alum from Juno winning bands &#8211; Stars, Sam Roberts band, The Trews, Arkells, July Talk, Lowest of The Low, Great Lake Swimmers, The Serena Ryder Band, plus the best studio and session musicians Canada has to offer. Get your tickets now!\n<a href=https://www.youtube.com/watch?v=fvxVI8_eWOk&amp;t=2s>https://www.youtube.com/watch?v=fvxVI8_eWOk&amp;t=2s</a>\n"
      }
    ]
  },
