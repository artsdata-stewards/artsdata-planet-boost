    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "André Bisson performs with his band for an evening upbeat soul/roots music! With a career spanning over 20 years, 10 Albums, and winner of this year’s Blues and Roots Radio International Song Competition for Song of the Year Award, André brings a unique sound that combines retro 60’s soul with the storytelling of folk music. André will be performing songs from his latest album Latchford.\n"
      }
    ]
  },
