    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Tommy Youngsteen- Bruce Springsteen&#8217;s &#8220;Born in the USA&#8221;"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@language": "en",
        "@value": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "en",
        "@value": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Tommy Youngsteen returns to Port Colborne performing Bruce Springsteen&#8217;s 1984 classic album &#8220;Born in the USA&#8221; along with all his Greatest Hits. Live on stage featuring a 10 piece All-Star band.\nCatch the very best of Rock n Roll Hall of Famer &amp; 20 time Grammy winner, Bruce Springsteen – featuring hits like Dancing in the Dark ‘Glory Days Born to Run I&#8217;m on Fire &amp; many more!\nTommy Youngsteen is a Toronto based supergroup featuring members &amp; alum from Juno winning bands &#8211; Stars, The Arkells, Sam Roberts Band, The Trews, Lowest of The Low, July Talk &amp; Serena Ryder Band\nVideo\n<a href=https://www.youtube.com/shorts/ccEJTQyEkq4 target=_blank rel=noopener>https://www.youtube.com/shorts/ccEJTQyEkq4</a>\n"
      }
    ]
  },
