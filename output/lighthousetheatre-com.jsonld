    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://lighthousetheatre.com/event/one-man-three-legends/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "One Man, Three Legends: A Tribute to Elvis Presley, Roy Orbison &#038; Johnny Cash"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@language": "en",
        "@value": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "en",
        "@value": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "BACK BY POPULAR DEMAND! A recreation of the stage performances of Elvis Presley, Roy Orbison, and Johnny Cash, &#8216;One Man, Three Legends&#8217; stars international award-winning entertainer, Roy LeBlanc: two-time champion and long-time host of the Collingwood Elvis Festival; first Canadian to be named World’s Finest Elvis at the Elvis Extravaganza in Las Vegas, Nevada; star of the touring sell-out hit musical production, Blue Suede Shoes for six consecutive years; and co-star of the North American and Australian touring production, Sun Records All-Stars.\nThroughout his 25 year-long music career, whether paying tribute to Elvis Presley, singing his original country songs, performing as vocal powerhouse, Roy Orbison, in Canada’s own Traveling Wilburys band, touring the world as Johnny Cash, opening for or performing with Billy Ray Cyrus, The Sweet Inspirations, The Jordanairs, Elvis’s drummer DJ Fontana, Doc Walker, and Orchestra London, Roy has always brought audiences to their feet with his infectious energy and unmatched vocal prowess!\nBacked by The Royal Tribute Band, One Man, Three Legends is a theatrical concert you won’t want to miss!\n"
      }
    ]
  },
