    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "FMJ is a group of seven talented musicians dedicated to performing the iconic songs of Foreigner &amp; Journey, two of the most legendary rock acts of the 1980’s.\nWith exceptional musicianship, FMJ delivers a powerful display of 80’s rock,  transporting you back to the era of maximum pleasure and indulgence.\nThe show includes all the hits from Foreigner and Journey&#8217;s chart peaking era, with unique arrangements that breathe new life into these classic anthems.\n"
      }
    ]
  },
