    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Handel&#8217;s Messiah"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@language": "en",
        "@value": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "en",
        "@value": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Arcady is thrilled to announce that it will be returning to Lighthouse Theatre Port Dover to perform its unique version of Handel’s Messiah this holiday season on Saturday, December 20th at 7:30pm. Don’t miss your chance to see Arcady’s professional chorus of soloists and chamber ensemble once more bring to life this holiday tradition. Known for his dynamic, energetic interpretation of this triumphant work, Ronald Beckett will direct his ensemble in a uniquely jubilant Baroque-style performance. Don’t miss your chance to hear the ensemble that specializes in Messiah. For more information, please visit arcady.ca.\n"
      }
    ]
  },
