    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The world&#8217;s foremost tribute to THE ROLLING STONES is coming to Port Dover for the first time!! THE BLUSHING BRIDES have been performing internationally for over 25 years, and they look, sound and feel like the real thing!!  Don&#8217;t miss this amazing show that will take you back to the rock &amp; roll days of your youth!!\n"
      }
    ]
  },
