    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Seventy year-old Robert and sixty-eight year old Christina have just met. In fact, they are practically strangers. They are both single, and at their ages, both have doubts about their appeal to the opposite sex. So, they decide to test out their appeal, by boldly renting a lakefront cabin and spending a ‘wild’ weekend together. What can go wrong?\n"
      }
    ]
  },
