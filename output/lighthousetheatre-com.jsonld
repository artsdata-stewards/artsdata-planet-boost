    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://lighthousetheatre.com/event/buddy-holly/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "BUDDY HOLLY&#8217;S RHYTHM REVIEW"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@language": "en",
        "@value": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "en",
        "@value": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "As a child, Jeff Giles was mesmerized by the sounds of 1950s rock and roll. As a teenager, an interest in acting and theatre developed alongside an interest in singing, songwriting, the guitar, and other folk instruments. All these influences came together during the early days of his professional performance career, when he landed the leading role in the smash hit Rock &amp; Roll musical <i>Buddy: The Buddy Holly Story</i>. Called perfectly-cast, a musical dynamo, and red hot by critics, hundreds of performances across the country left audiences dancing in the aisles. From there, Jeff became one of the most in-demand tribute entertainers in the country, celebrating the music not only of Buddy Holly, but the Everly Brothers, the Beach Boys, Simon &amp; Garfunkel, and so many more of popular music’s most well-loved artists.\n"
      }
    ]
  },
