    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Off the Rock: A Great Big Sea Tribute"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@language": "en",
        "@value": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "en",
        "@value": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Get ready for a night of toe-tapping tunes, roaring singalongs, and pure East Coast energy as Off The Rock brings their Kitchen Party to Port Colborne!\nInspired by the spirit of Great Big Sea and Newfoundland kitchen parties, Off The Rock delivers a high-energy show filled with traditional folk favourites, Irish-inspired melodies, and crowd-pleasing anthems that will have you clapping, laughing, and singing along all night long. 🍻🎻\nThis is more than a concert — it’s a celebration. Expect infectious rhythms, playful storytelling, and the kind of atmosphere that turns strangers into friends before the night is over.\n"
      }
    ]
  },
