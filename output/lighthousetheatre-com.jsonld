      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Destroyer"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@language": "en",
        "@value": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "en",
        "@value": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Destroyer. An Evening of Full-On KISS!\nShout it out loud! Destroyer teleports you to the thunder and lightning that is a live KISS concert experience of the 70s as only the most celebrated KISS tribute band on the planet can.\nUnbridled mayhem saluting the original KISS lineup &#8211; Demon Gene, Space Ace, Starchild Paul and Catman Peter. Satanic bass. Searing guitars. Powerhouse vocals. Heart-pounding drums. All delivered by four world-class musicians and charter members of the KISS ARMY. From raging anthems like <em>&#8216;I Was Made For Lovin’ You&#8217;</em>  to intimate ballads like <em>&#8216;Beth&#8217;</em>, this immersive event captures the nature of the beast for you to indulge.\nYour tickets are calling! Book now to be a part of this rock-monumental, emotionally charged evening destined to be lodged in your memory cells forever.\n"
      }
    ]
  },
