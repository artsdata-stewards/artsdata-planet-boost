    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Celebrating the band’s incredible history of representing Canada with distinction and entertaining crowds both locally and around the world. This show combines traditional and innovative non-traditional music accompanied by our stage band, Pipe Down. Get ready for a night of fantastic music and fun!\n"
      }
