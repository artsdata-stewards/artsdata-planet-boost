    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Follow young medical student Arthur Conan Doyle and Professor Bell on an adventure through the underbelly of Edinburgh and over the Scottish countryside as they track down a killer. Clue by clue we watch a tale unfold that will eventually become the inspiration of Conan Doyle’s most famous and fascinating character.\nYour health and safety is a priority when visiting our venues.<a href=https://lighthousetheatre.com/covid/> Click here to see our COVID-19 Duty of Care. </a>\n<strong><span class=JsGRdQ>Please be advised that The Real Sherlock Holmes contains scenes using fog, haze, strobe lights and simulated gunshots.</span></strong>\n"
      }
    ]
  },
