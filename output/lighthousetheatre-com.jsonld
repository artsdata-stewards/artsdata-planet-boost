    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Internationally touring comedian Jeff Leeson comes to Port Colborne and Port Dover for a night of live stand-up comedy you will never forget! With 25 years of experience touring all across North America and over 150 million views online, find out why this is definitely one show you absolutely Do Not want to miss.\n"
      }
