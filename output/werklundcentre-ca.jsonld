      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "A record-breaking musician, Diana Krall is the only jazz singer to have eight albums debut at the top of the Billboard Jazz Albums chart. Her albums have garnered two GRAMMY® Awards, ten Juno® Awards and have earned nine Gold, three Platinum, and seven multi-Platinum status albums."
      }
    ],
    "http://schema.org/location": [
