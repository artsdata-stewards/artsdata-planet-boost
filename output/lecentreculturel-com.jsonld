    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Recruitment Session – Improv League"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Want to join a Francophone improv league in British Columbia? Take part in our recruitment session on September 11. Whether you're a beginner or an experienced improviser, what matters most is the desire to play, create together… and have fun!"
      }
    ],
