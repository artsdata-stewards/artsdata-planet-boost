      {
        "@language": "en",
        "@value": "Knitting Activity | Le Centre Culturel"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Are you an expert in the art of knitting, crochet or embroidery? Want to start your own project? This group is for you! Meet two Tuesdays a month at the Center, all levels welcome."
      }
    ],
