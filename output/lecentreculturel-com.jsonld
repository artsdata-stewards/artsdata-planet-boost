    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Café Philo   | Le Centre Culturel"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Un lundi par mois, le Café philo propose une réflexion permettant à chacun de s'exprimer et d'échanger sur un thème défini. Cette rencontre a pour but de démythifier la philosophie et de renouveler les connaissances de chacun, le tout en langue française."
      }
    ],
