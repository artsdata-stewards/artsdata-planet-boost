        "@language": "fr",
        "@value": "Café Littéraire | Le Centre Culturel"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Vous aimez les livres ? Vous aimez la littérature francophone ? Vous aimez parler de littérature en français ? Rejoignez le Café littéraire du Centre !"
      }
    ],
    "http://ogp.me/ns#image": [
