        "@language": "en",
        "@value": "Philosopher's Café"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "One Monday a month, the Café philo offers an opportunity for everyone to express themselves and exchange ideas on a defined theme. The aim is to demystify philosophy and renew our knowledge of it, all in French."
      }
    ],
