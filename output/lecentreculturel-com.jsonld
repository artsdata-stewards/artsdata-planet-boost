  {
    "@id": "https://www.lecentreculturel.com/en/event-details/lheure-du-conte-2025-03-01-11-00",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Storytelling | Le Centre Culturel"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Once a month, Le Centre invites children aged 2 and over to come and explore the imaginary world of fairy tales. Children are encouraged to give free rein to their imagination, thanks to the many illustrated books in the library."
