  {
    "@id": "https://www.lecentreculturel.com/en/event-details/cafe-philo-2025-04-14-18-30",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Philosopher's Café | Le Centre Culturel"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "One Monday a month, the Café philo offers an opportunity for everyone to express themselves and exchange ideas on a defined theme. The aim is to demystify philosophy and renew our knowledge of it, all in French."
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://static.wixstatic.com/media/193812_51e36b4a4d7d4ebe81981b2eb3873e10~mv2.jpg/v1/fill/w_2379,h_1090,al_c,q_90/193812_51e36b4a4d7d4ebe81981b2eb3873e10~mv2.jpg"
      }
    ],
    "http://ogp.me/ns#image:width": [
