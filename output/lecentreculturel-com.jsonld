    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "On the occasion of Iranian Calligraphy Week (October 2025), take part in a one-hour workshop to discover the art of Iranian calligraphy."
      }
    ],
    "http://ogp.me/ns#image": [
