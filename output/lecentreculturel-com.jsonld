  {
    "@id": "https://www.lecentreculturel.com/event-details/cercle-fil-en-aiguille-2024-10-08-19-00",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Cercle fil en aiguille | Le Centre Culturel"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Expert(e) dans l'art du tricot, du crochet ou de la broderie ? Envie de de commencer ton projet? Ce groupe est fait pour toi ! Rendez-vous deux mardis par mois au Centre, tous les niveaux sont acceptés."
      }
    ],
    "http://ogp.me/ns#image": [
