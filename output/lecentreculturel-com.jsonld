  {
    "@id": "https://www.lecentreculturel.com/event-details/cercle-fil-en-aiguille-2025-01-28-19-00",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Cercle fil en aiguille | Le Centre Culturel"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
