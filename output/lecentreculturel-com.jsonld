  {
    "@id": "https://www.lecentreculturel.com/event-details/cafe-philo-2025-10-06-18-30",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Café Philo   | Le Centre Culturel"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Un lundi par mois, le Café philo propose une réflexion permettant à chacun de s'exprimer et d'échanger sur un thème défini. Cette rencontre a pour but de démythifier la philosophie et de renouveler les connaissances de chacun, le tout en langue française."
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://static.wixstatic.com/media/193812_51e36b4a4d7d4ebe81981b2eb3873e10~mv2.jpg/v1/fill/w_2379,h_1090,al_c,q_90/193812_51e36b4a4d7d4ebe81981b2eb3873e10~mv2.jpg"
      }
    ],
    "http://ogp.me/ns#image:width": [
      {
        "@language": "fr",
        "@value": "2379"
