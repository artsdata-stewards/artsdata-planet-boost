    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Les causeries arc-en-ciel is an informal conversation group moderated by Amé that will meet face-to-face and virtually on a monthly basis. We aim to create and maintain a safe space for queer francophones/francophiles and their allies."
