    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Step into the world of Persephone, a stunning spring art exhibit celebrating the work of local feminine artists: Kya Dubois, Saturna Bueckert, Kimberly Frixel, Rosalie Dureski, and Erica Van Dok. This vibrant showcase explores themes of renewal, transformation, and the power of feminine creativity."
      }
