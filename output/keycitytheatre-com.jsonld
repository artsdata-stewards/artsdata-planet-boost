    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Faces of Pride  Faces of Pride, an art exhibition that opens in June, will feature portraits of local LGBTQ2IA+ community members. Under the creative hand of local hero, Joel Robison, the portraits will provide a unique way for all of the people in our area to get to know each other a bit better."
      }
    ],
