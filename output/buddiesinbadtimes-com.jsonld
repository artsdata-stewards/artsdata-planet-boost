    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Singing Out After Dark presents our XXX anniversary Cabaret: We’re Here, We’re Queer, A Kinky Cabaret — Buddies in Bad Times Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Singing Out After Dark presents our XXX anniversary Cabaret: We’re Here, We’re Queer, A Kinky Cabaret. 30 years of Singing Out means it is time to celebrate! Come see Singing Out’s members live on stage, showing off their kinky musical talents featuring music celebrating our queer identities. Join us at Buddies In Bad times Theatre on March 18th for a show like no other."
      }
    ],
