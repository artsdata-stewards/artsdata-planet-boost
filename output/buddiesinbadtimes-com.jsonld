    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "March 21, 2025 // 8pm $5-$50 + fees Join us for the third Mask4Mask Dance: Spring Bloom! Let’s bring in the spring equinox and sow seeds of community care together! In the face of state-organized abandonment, and unrelenting distress, we …"
