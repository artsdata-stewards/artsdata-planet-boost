    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Dark Day is BACK AT BUDDIES! Come and join us again for night featuring some of Toronto's best emerging and established Music Theatre performers, backed by a three-piece band! You can count on a rowdy atmosphere, five new singers, and some damn crazy vocals each and every month!"
      }
