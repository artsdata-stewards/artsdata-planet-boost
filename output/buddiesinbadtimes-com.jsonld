  {
    "@id": "https://buddiesinbadtimes.com/event/long-live-the-kings-masquerade-party/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-ca",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
