      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Wendy Babcock Drag Show by Osgoode Hall Law School's OUTLaws — Buddies in Bad Times Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "The Wendy Babcock Drag Show is an annual drag show hosted by the Osgoode OUTLaws to fundraise money for the Wendy Babcock Social Justice Scholarship, which honours JD student Wendy Babcock who passed away in 2013 before her final year of study. We strive to hold an event that celebrates diversity and creativity within the queer Community.Our staff have been monitoring provincial and city regulations, and have used this information to create a COVID-19 Safety Package for visitors, artists, and staff while at Buddies. Additionally, all guests will be required to wear a mask to attend Buddies events."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
