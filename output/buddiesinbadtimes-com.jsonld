    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Mind, Body and Drag: Mental Wellness Fundraiser &#8212; Buddies in Bad Times Theatre"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Wellness … Mind, Body, and DRAGJoin our First Annual fundraiser to foster Mental Wellness through Mind, Body andDRAG.Come and lend your support to some brave contestants who will challenge themselvesto compete for the first time in Amateur Drag asking for your support to raise money formental-health awareness in our community. They will step out of their shoes and intoheels to gain a new perspective on life. Once a winner is crowned, we will all celebratetheir Bravery and Drag with performances by professional drag stars from ourcommunity. A fun-filled evening with live singing and exciting, entertainingperformances.Hosted by Drag/Dame Hostess with the mostess Shirley Happening. Lend us yoursupport and we will Shirley entertain you.Proceeds will go to the Supporting Our Youth program."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "en",
        "@value": "en-CA"
      }
