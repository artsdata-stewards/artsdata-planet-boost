    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Join us for an evening celebrating the launch of Probably Theatre's digital exhibition, \"This Inescapable City\". The evening will feature installations of various pieces from the online exhibition as well as performances by some of the contributing artists and 4 new pieces created especially for the event! Doors and installation begin at 7pm and performances at 8pm."
      }
    ],
