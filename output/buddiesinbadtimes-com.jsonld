    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "The Youth/Elders Program: Speed History — Buddies in Bad Times Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "  Join us for the next session our Youth/Elders Programming for the 2024/25 season: Speed History! This session will be led by Carol Thames and Franki Forte, who will guide discussions on queer histories, community resilience, and the wisdom shared …"
