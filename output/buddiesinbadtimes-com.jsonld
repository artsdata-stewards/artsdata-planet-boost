        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "LIFE….. It’s Shirley Happening — Buddies in Bad Times Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Come and join this larger than life sized board game cabaret. I, Shirley, will be waxing nostalgia through songs, and stories . A fun for all ,live singing cabaret with audience participation numbers, so be prepared to play along.Spin the Spinner , move along the Game Board and enjoy an evening with your Hostess with the Mostess in “ LIFE…. It’s SHIRLEY HAPPENING!"
      }
    ],
    "http://ogp.me/ns#url": [
