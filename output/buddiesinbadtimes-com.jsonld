    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Jingle Babz — Buddies in Bad Times Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "After a prolonged program interruption, Babz is back in all her glory with her Holiday Spectacular and this year it’s going to be Bigger and Brassier than ever. Award-winning performer, choreographer, writer, director Barbara Johnston is joined by her talented musical friends to present the show we have all needed for a very long time. “Jingle Babz: Tellin’ the Christmas Lies” offers up the true story of Christmas with laughter, sparkles, and lots of jingly good cheer.  Babz is back! Halleluia! "
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
        "@value": "https://buddiesinbadtimes.com/event/29250/2022-12-13/"
      }
