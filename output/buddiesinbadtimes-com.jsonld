    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "The Queer Comics Symposium — Buddies in Bad Times Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "This symposium focuses on today's most exciting, transdisciplinary, and international LGBTQ+ comics scholarship and creativity. At this event, we will screen the documentary No Straight Lines: The Rise of Queer Comics (Vivian Kleiman, 2021). Comics creator and academic, Justin Hall, will comment on the creation of the groundbreaking collection of queer comics work that inspired this film."
      }
    ],
