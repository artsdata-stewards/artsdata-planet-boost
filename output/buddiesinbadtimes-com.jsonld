    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Inspired by the book Wildseed by the iconic Octavia Butler, Wildseed is a sensual exploration of magical women and femmes full of survivorship, ancestor wisdom and beauty. Expressed through burlesque and performance art.Canada’s premiere Burlesque Troupe for Women of Colour. Curated and hosted by Dainty Smith."
      }
