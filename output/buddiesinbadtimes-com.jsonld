  {
    "@id": "https://buddiesinbadtimes.com/event/flamingo-market-5/2023-03-11/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-ca",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Flamingo Market — Buddies in Bad Times Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Toronto’s 3x Award-Winning LGBTQ2SIA+ Market returns to Buddies on October 23rd, 2022 for Flamingo Market x Halloween Edition! Come support our flock of 25+ LGBTQ2SIA+ artisans, businesses and nonprofits! Featuring, promoting and fostering the diverse small business and artisan talent that the LGBTQ2SIA+ community has to offer. Flamingo Market is a FREE admission market that is an all inclusive, child friendly market. All are welcome to attend!Our staff have been monitoring provincial and city regulations, and have used this information to create a COVID-19 Safety Package for visitors, artists, and staff while at Buddies. Covid safety protocols to be determined, but may include proof of vaccination, contact tracing  and/or mask mandates."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
        "@value": "https://buddiesinbadtimes.com/event/flamingo-market-5/2023-03-11/"
      }
