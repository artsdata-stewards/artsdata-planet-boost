    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Kings and Classics is one of Toronto's hottest Drag King and Gender Performer shows around! This show is definitely always one to remember so get ready for a special spooky night of RETRO HORROR! The night is RETRO HORROR THEMED SO COME DRESSED TO IMPRESS!!!**Buddies in Bad Times is an Accessible venue**https://buddiesinbadtimes.com/accessibility/https://buddiesinbadtimes.com/covid-safety/**Limited seating is available. Please reach out to a member of our staff or Buddies for reservations**Doors: 10:30 pmShow: 11:00 pmTickets: 25$ at the doorFriday, October 7th, 2022Buddies In Bad Times Theatre 12 Alexander Street, TorontoFor any further information, join our Facebook and Instagram group @ East King Productions!Thank you,Rikki"
      }
    ],
