    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "limbs and whims — Buddies in Bad Times Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "In her debut poetry collection, Muhaddisah explores the fragmented whimsies of desire. Both formally and conceptually, she writes for the era of indulgence, for those who are unafraid to Want despite not knowing what they Need. Join her and host Lauren Wolanski for a night of literary revelry: Muhaddisah will read from the collection, Lauren will facilitate a Q&A / audience discussion, attendees can partake in a quiz to determine which poem was written just for them, and more!"
      }
    ],
    "http://ogp.me/ns#url": [
