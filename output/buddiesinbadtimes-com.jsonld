    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "A Very Chris-terical Christmas Cabaret — Buddies in Bad Times Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Music director and “cabaret sensation” Chris Tsujiuchi trots out the ugly sweaters, defiles beloved carols, takes centre stage and puts on a hell of a show, as his band of merry musicians helps him raise the spirit of the season. \"Toronto's newest Cabaret sensation\" - Xtra! \"Superstar\" - twisitheatreblog.com \"Nothing is ever quite as entertaining as a Chris-terical Cabaret.\" - myentertainmentworld.ca \"Hot in the bum area.\" - Sharron Matthews \"Ridiculously talented.\" -Thom Alison"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
        "@value": "https://buddiesinbadtimes.com/event/a-very-chris-terical-christmas-cabaret-3/2022-12-15/"
