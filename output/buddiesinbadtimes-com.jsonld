    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A Golden Age Musical Duet Show! Holden & Finn will swing you through jazzy duets, musical theatre tunes & tell their (fictional) story of “making it” in the Golden Age of Music! A RatPacked swell time that’ll have you signing & dancing along ! “They want to make it to the Vegas strip, with a few stops on the way!”"
      }
