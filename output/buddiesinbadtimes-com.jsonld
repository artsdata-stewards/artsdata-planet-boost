  {
    "@id": "https://buddiesinbadtimes.com/event/come-here-often/2022-10-14/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-ca",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Come Here Often? — Buddies in Bad Times Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Shohana Sharmin doesn’t date much. There’s a reason for that. Starting at age 7, Shohana learned to divide herself into smaller parts. Being a bicultural bilingual bisexual in a world that constantly wanted her to fit into one box or another felt like too much. Then one day, she started compartmentalizing – creating neat little boxes within herself to “fit in” and make sense of her own existence. In the fast-paced darkly comedic one-woman rollercoaster show “Come Here Often?” directed by Carly Heffernan (The Second City), we catch Shohana at a speed dating night, traveling through her own memories to moments in her life when she split herself in two, and examining the ways in which she has tried to keep all the parts of her alive."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
        "@value": "https://buddiesinbadtimes.com/event/come-here-often/2022-10-14/"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en-ca",
        "@value": "Buddies in Bad Times Theatre"
      }
    ],
