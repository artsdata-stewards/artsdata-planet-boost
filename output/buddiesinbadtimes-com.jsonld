    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "The B-Girlz : JUMP! — Buddies in Bad Times Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "The B-Girlz : Jump! is a glittering fast paced multi-media comedy and musical extravaganza featuring singing, dancing and near high kicks!Our staff have been monitoring provincial and city regulations, and have used this information to create a COVID-19 Safety Package for visitors, artists, and staff while at Buddies. Covid safety protocols to be determined, but may include proof of vaccination, contact tracing  and/or mask mandates."
      }
    ],
