  {
    "@id": "https://buddiesinbadtimes.com/event/29250/2022-12-13/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-ca",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
