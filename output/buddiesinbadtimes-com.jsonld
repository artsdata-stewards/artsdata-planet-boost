    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Lavender — Buddies in Bad Times Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Lavender is back to our scheduled monthly programming on the first Saturday of every month and we're bringing it for the long weekend This is a Queer and Trans centred space. Homophobia, racism and transphobia will not be tolerated. CONSENT IS MANDATORY Lavender is an award winning, staple queer party series in Toronto for folks of all marginalized genders - Women, Trans and Nonbinary folx."
      }
    ],
