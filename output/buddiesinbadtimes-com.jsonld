    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Long Live the Kings - Masquerade Party &#8212; Buddies in Bad Times Theatre"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Long Live the Kings' for their king dumb reign is all mask for masquerade. Join us for a masquerade themed dance party where the only costume piece is a mask, mouth and/or eyes, and be greeted by the swooning royalty; Delirios, Gay Jesus, and Krēme Inakuchi with our sophisticated DJ; ESL! Produced and hosted – Oz style by Tygr Willy.Performances at 12:30 AMProof of vaccination required."
      }
    ],
