        "@value": "After Werk &#8212; Buddies in Bad Times Theatre"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Join us at Buddies for our legendary queer Halloween dance party with music by DJ Levi all night long! We’ll have a Halloween costume contest at midnight hosted by Barbie Jo Bontemps along with performances by BOA from Canada’s Drag Race season 1.Doors open at 10:30Cover is $15 before 11:00 and $20 after."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "en",
        "@value": "en-CA"
      }
