    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Forte Unzipped — Buddies in Bad Times Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "After three years, Forte is back at the Buddies cabaret space - and we're ready to unzip! Join us on Fri. March 3rd for our latest edition of our Forte Unzipped cabaret, a chance for members of the chorus to get creative and perform some fun and surprising medleys, solos and small group numbers. The theme is THERE IS NO THEME (imagine!). Come for the music, raise a glass and have a laugh. And don't forget to check your zipper."
      }
    ],
