    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Videodrome (A Video Dance Party) — Buddies in Bad Times Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Just drinks with you and your friends, Pop, Club, House, Hip Hop & Retro music videos and the dance floor all night long! It's a celebration of our artists and our own music!And there will be a request sheet next to the DJ.Let's return to the days when we danced all together as a community!"
      }
    ],
