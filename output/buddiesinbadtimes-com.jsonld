  {
    "@id": "https://buddiesinbadtimes.com/event/jaded-a-queer-black-history-as-told-by-jade-elektra/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-ca",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "JADED: A Queer Black History as told by Jade Elektra — Buddies in Bad Times Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "JADED: A Queer Black History as told by Jade Elektra is a one-woman show that chronicles Jade’s thirty-five years of performing in drag. It is seven performances with backstories…the queen and her music. This slice of Queer Black History takes you from her start in drag in Tampa, Florida to her days of being a twenty-something in New York City (where she became a member of the House of LaBeija – as seen in Paris Is Burning) and eventually meeting her husband in Montreal and relocating to Toronto."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
        "@value": "https://buddiesinbadtimes.com/event/jaded-a-queer-black-history-as-told-by-jade-elektra/"
      }
    ],
