  {
    "@id": "https://buddiesinbadtimes.com/event/les-femmes-fatales-watching-god/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-ca",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Les Femmes Fatales: Watching God — Buddies in Bad Times Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "The final installment in our sensual Storytime series. Inspired by the book, Their Eyes Were Watching God written by Zora Neale Hurston.Watching God is about love, loneliness, heartbreak and being true to yourself.This show is a sensual examination is a journey of self-love and self-actualization and following your heart.Starring...Ravyn WngzSweet DelilahViolet VixenImogenQuestSuki TsunamiGuest stars:Neena JayarajanNova bhattacharyaSukruti TirupatturMusic by Dj RelentlessCurated and produced by Dainty SmithAt Buddies In Bad Times Theatre12 Alexander StreetDoors 8:30 PMShow starts 9 PMTickets $ 30"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
        "@value": "https://buddiesinbadtimes.com/event/les-femmes-fatales-watching-god/"
      }
