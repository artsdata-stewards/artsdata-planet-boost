        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "THROB — Buddies in Bad Times Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "THROB isn’t your average Queer dance party. DJ Tom Cable spins all the underrated pop, 90s, early 2000s, and current vibes, all night long. Hosted by Makayla Couture, this dance floor is open and aims to be a safe space for everyone in our Queer communities. Featuring drag performances by Bang Cock and Las Rose!"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
        "@value": "https://buddiesinbadtimes.com/event/throb-5/"
