      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "August 21, 2025 // 8PM $10 + fees SPURS NIGHT is Toronto’s queer line dancing night. There are always two full line dance lessons every evening, a few simple follow-along dances for everyone, and lots of dances from past lessons. &hellip;"
      }
    ],
