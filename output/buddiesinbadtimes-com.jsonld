    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Tina Burner in LUV SUX — Buddies in Bad Times Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "During the slow February/March season, Tina Burner (from RuPaul's Drag Race Season 13 and National Miss Comedy Queen) is here to heat things up with her new, one-woman show LUV SUX. After the success of her previous 4 international tours, she's back at it again dealing with everyone’s favorite topic: LOVE. A combination of live singing, signature mixes, stand-up comedy, and costume reveals, LUV SUX discusses topics ranging from the problems with online dating, sex, make ups and breakups proving that Disney has set us up for failure from day one, and how we are forever looking for Prince/Princess Charming. Live music by Blake Allen."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
        "@value": "https://buddiesinbadtimes.com/event/tina-burner-in-luv-sux/"
      }
