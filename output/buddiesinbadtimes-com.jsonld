        "@id": "https://buddiesinbadtimes.com/wp-content/uploads/Show-and-Tell-Final-410x231.png"
      }
    ],
    "http://schema.org/datePublished": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2022-10-25T22:39:07+00:00"
      }
    ],
    "http://schema.org/dateModified": [
      {
        "@type": "http://schema.org/Date",
