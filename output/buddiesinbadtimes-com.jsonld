    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Doors 6:30pm // Show 7:00pm // Free Admission   Black Ties are a series of  yearly events designed to create sustainable relationships within Toronto’s community of Black Theatre Professionals. They are an opportunity for Black Actors, Directors, Playwrights, Producers, Designers, …"
      }
