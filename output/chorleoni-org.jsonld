  {
    "@id": "https://chorleoni.org/temporary/d0b1361f-cebe-4161-9aee-6b4330e9cd1b",
    "@type": [
      "http://schema.org/MusicEvent"
    ],
    "http://schema.org/image": [
      {
        "@id": "https://chorleoni.org/wp-content/uploads/2025/07/Big-Roar_Web-Banner-1.jpg"
      }
    ],
