    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "PopCappella"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "PopCappella returns to St. Andrew’s-Wesley United! Enjoy Chor Leoni’s signature pop-choral mix at one of Vancouver&#8217;s most iconic venues. Experience high-impact harmonies and dazzling lights, all backed by a band of Vancouver’s finest players. Enjoy bespoke arrangements of classics by The Beach Boys, Bruce Springsteen, Sara Bareilles, the B-52’s, and more, sung as only Chor Leoni can. Bring your friends and experience a thrill like no other!\nTickets from $20-$70\n35 and Under Ticket Pricing Available."
      }
    ],
