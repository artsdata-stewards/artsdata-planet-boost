        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "The Leonids - Chor Leoni"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "The Leonids is a new professional ensemble under the direction of Artistic Director Erick Lichte. The ensemble serves as the professional headline choir for Chor Leoni’s annual Big Roar Choral Festival and as an educational, inspirational, and aspirational force for this festival and beyond."
      }
    ],
