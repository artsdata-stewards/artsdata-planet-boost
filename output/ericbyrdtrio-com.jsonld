      {
        "@id": "https://www.ericbyrdtrio.com/product/unisex-hoodie/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.ericbyrdtrio.com/wp-content/uploads/2025/06/unisex-premium-hoodie-team-royal-front-68498ec7e98c6.jpg"
      }
    ],
    "http://schema.org/sku": [
      {
