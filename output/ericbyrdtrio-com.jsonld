    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Concert"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;June 7 - August 31, 2025 Admission is free. On October 2, 1950, three kids appeared on the funny pages of seven newspapers. Over the next 50 years, Charlie Brown, Patty, and Shermy would be joined by a whole cast of characters and forever change the landscape of the Sunday comics. Charles M. Schulz—the cartoonist...&lt;/p&gt;\\n"
      }
    ],
