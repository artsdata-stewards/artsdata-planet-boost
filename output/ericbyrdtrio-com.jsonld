      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "_:g2506640"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.ericbyrdtrio.com/product/unisex-classic-tee-2/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Echo Cover Unisex classic tee"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The 100% cotton unisex classic tee will help you land a more structured look. It sits nicely, maintains sharp lines around the edges, and goes perfectly with layered streetwear outfits. Plus, it's extra trendy now! \n• 100% cotton\n• Sport Grey is 90% cotton, 10% polyester\n• Ash Grey is 99% cotton, 1% polyester\n• Heather colors are 50% cotton, 50% polyester\n• Fabric weight: 5.0–5.3 oz/yd² (170-180 g/m²) \n• Open-end yarn\n• Tubular fabric\n• Taped neck and shoulders\n• Double seam at sleeves and bottom hem\n• Blank product sourced from Honduras, Nicaragua, Haiti, Dominican Republic, Bangladesh, Mexico\nDisclaimers: \n• Due to the fabric properties, the White color variant may appear off-white rather than bright white.\n• Dark color speckles throughout the fabric are expected for the color Natural.\nThis product is made especially for you as soon as you place an order, which is why it takes us a bit longer to deliver it to you. Making products on demand instead of in bulk helps reduce overproduction, so thank you for making thoughtful purchasing decisions!"
      }
    ]
  },
