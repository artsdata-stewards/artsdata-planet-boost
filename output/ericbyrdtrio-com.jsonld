  {
    "@id": "https://www.ericbyrdtrio.com/product/unisex-classic-tee/#product",
    "@type": [
      "http://schema.org/Product"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.ericbyrdtrio.com/product/unisex-classic-tee/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.ericbyrdtrio.com/wp-content/uploads/2025/07/fdfb3656cce7d3d10c5350e126c8bbad.jpg"
      }
    ],
    "http://schema.org/sku": [
      {
