    "http://schema.org/image": [
      {
        "@id": "https://www.ericbyrdtrio.com/wp-content/uploads/2025/07/5288ea0a724036474439415037e7cbea.jpg"
      }
    ],
    "http://schema.org/sku": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
