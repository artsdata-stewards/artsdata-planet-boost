    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "A Musical Night of Musical Music (and Questionable Casting) is a high-energy musical theatre fundraiser where performers sing songs from roles they’d never play — and the audience gets to sing along. RLOP members take the stage to flip casting expectations on their head with bold, funny, and heartfelt performances from shows like Cabaret, Wicked, [&hellip;]"
      },
      {
