  {
    "@id": "https://countingcoup.net/event/6562955/761909233/trafton-trailhead-project",
    "http://opengraphprotocol.org/schema/title": [
      {
        "@value": "Trafton Trailhead Project @ Stockman Bar & Grill - Jun 6, 2026, 4:00PM"
      }
    ],
    "http://opengraphprotocol.org/schema/description": [
      {
        "@value": "Please join us for live music featuring Counting Coup following the Jim Sandsness Memorial Car Show in Malta, MT. All proceeds will benefit the historic Trafton Trailhead 2027 project. Attendees can enjoy offerings from A&E Catering and Little Otts Snow Cones. This event is currently sponsored by First State Bank of Malta and Malta Trails Inc."
      }
    ],
