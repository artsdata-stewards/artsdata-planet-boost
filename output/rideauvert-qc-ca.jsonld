        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Sa dernière femme - Théâtre du Rideau Vert"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Etre l’épouse du roi Henri VIII a toujours constitué une position périlleuse. Qu’à cela ne tienne, Kate Parr, sa sixième et dernière femme, est bien déterminée à faire feu de tout bois."
      }
    ],
    "http://ogp.me/ns#url": [
