    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "La mort d'un commis voyageur"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "A 60 ans, Willy Loman est épuisé. Il n’a plus la force de prendre la route. Incapable de sortir de son immobilisme, il se perd dans le brouillard apaisant de ses souvenirs de gloire ancienne où l’avenir était rempli de promesses.\n"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
