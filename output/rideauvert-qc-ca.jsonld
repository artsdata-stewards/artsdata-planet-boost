  {
    "@id": "https://www.rideauvert.qc.ca/piece/le-boulevard/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
    ],
    "http://ogp.me/ns#type": [
