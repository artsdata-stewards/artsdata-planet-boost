      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Faire le bien"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "La deuxième coproduction du TRV avec le Théâtre français du CNA présentant huit interprètes de la relève – accompagnés d’une comédienne chevronnée, Eve Landry – Faire le bien présente une série de petites histoires de positivité toxique tantôt drôles, tantôt touchantes, mettant de l’avant les angoisses et les chamboulements de notre époque."
      }
    ],
