    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "2016 revue et corrigée"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Une chose est sûre : les années passent et les revues ne se ressemblent pas! Chaque saison depuis douze ans, un collectif d’auteurs vous prépare ce condensé comique de l’année, pour lequel ils repèrent les sujets les plus cocasses et les situations les plus désopilantes des scènes politique, artistique, sportive et médiatique.\n"
      }
    ],
