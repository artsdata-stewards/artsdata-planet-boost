        "@language": "fr-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Le songe d'une nuit d'été - Théâtre du Rideau Vert"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Héléna poursuit Démétrius qui n’a d’yeux que pour Hermia, qui aime tendrement Lysandre, qui le lui rend bien… Il ne s’agit pas d’une nuit comme les autres, alors que s’agitent toutes les fébrilités : l’amour, la jalousie, l’excitation."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://www.rideauvert.qc.ca/piece/le-songe-dune-nuit-dete-2/"
      }
