  {
    "@id": "https://www.rideauvert.qc.ca/piece/le-songe-dune-nuit-dete-2/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
    ],
    "http://ogp.me/ns#type": [
