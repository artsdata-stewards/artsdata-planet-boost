    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Venez passer l’année au peigne fin avec nous, en humour et en chansons ! Vous l’attendiez avec impatience : la toujours très appréciée revue de fin d’année est enfin de retour au Théâtre du Rideau Vert !"
      }
