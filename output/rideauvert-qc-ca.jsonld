    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Brel & Barbara, héros fragiles - Théâtre du Rideau Vert"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Les monstres sacrés que sont Brel et Barbara auraient célébré, respectivement en 2019 et 2020, leur 90e anniversaire de naissance. Lui, le grand, l’entier, le géant. Elle, la blessée, la généreuse, la déchirante. Entre les deux, une relation d’amitié méconnue, mais aussi passionnée et singulière… à leur image !"
      }
    ],
    "http://ogp.me/ns#url": [
