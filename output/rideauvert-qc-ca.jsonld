      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "La saison 2025-2026 du Théâtre du Rideau Vert en est une « riche d’œuvres qui font vibrer, réfléchir, découvrir et rire – bref, tout ce que l’art permet d’extraire de la vie pour mieux la goûter », selon Denise Filiatrault, directrice artistique."
      }
    ],
