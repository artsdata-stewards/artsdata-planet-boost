    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Molière, Shakespeare et moi"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Nous sommes vers 1750, à un moment charnière de l&rsquo;histoire de Montréal. Thomas Beaubien, un dramaturge fictif contemporain de cette époque &#8211; au profil d’un Woody Allen d’avant l’heure &#8211; se trouve aux prises avec les pouvoirs politiques, économiques et religieux de son temps qui ne sont pas sans rappeler l’époque actuelle.\n"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
