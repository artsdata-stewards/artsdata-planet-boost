  {
    "@id": "http://rideauvert.qc.ca/temporary/542a2636-56e5-49fb-91ca-cb9a2eadf96b",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/image": [
      {
        "@id": "https://rideauvert.qc.ca/app/uploads/2017/01/accueil-pvm_375-1-1024x488.jpg"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g8960520"
      }
    ],
    "http://schema.org/location": [
      {
