        "@language": "fr-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Le boulevard - Théâtre du Rideau Vert"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le jour où sa mère disparaît, le jeune Chris se retrouve seul et pris au dépourvu. On lui a tellement répété qu'il n'était pas très malin qu'il a fini par y croire. Autour de lui, heureusement, des mains se tendent pour lui offrir petits conseils, petits boulots, petites magouilles aussi..."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://www.rideauvert.qc.ca/piece/le-boulevard/"
      }
    ],
