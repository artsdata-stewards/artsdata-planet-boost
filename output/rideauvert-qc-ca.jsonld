      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Le songe d'une nuit d'été - Théâtre du Rideau Vert"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Est-ce le fantasme d’un espace-temps où les lois habituelles n’ont plus cours qui nous pousse toujours à revenir à l’enivrant Songe d’une nuit d’été ?"
      }
    ],
