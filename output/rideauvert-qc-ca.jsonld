    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Alain Bouchard, ﬁer Québécois, a élevé ses ﬁlles dans un esprit de tolérance. Mais il déchante lorsqu’il doit s’adapter à la nouvelle réalité multiculturelle du Québec.\n"
      }
