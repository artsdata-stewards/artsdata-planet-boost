      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Le boulevard - Théâtre du Rideau Vert"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le jour où sa mère disparaît, Chris est pris au dépourvu. Peut-être que parfois, il faut un boulevard pour soutenir un jeune homme abandonné."
      }
    ],
