    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Randle McMurphy se croit malin : il a réussi à convaincre la cour qu’il est fou et s’est fait envoyer à l’institut psychiatrique plutôt qu’aux travaux forcés.\n"
      }
    ],
