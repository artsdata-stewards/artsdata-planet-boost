  {
    "@id": "https://www.rideauvert.qc.ca/piece/faire-le-bien/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
    ],
    "http://ogp.me/ns#type": [
