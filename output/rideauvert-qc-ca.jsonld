  {
    "@id": "https://rideauvert.qc.ca/piece/glenn-gould-naissance-dun-prodige/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Glenn Gould, naissance d'un prodige"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Figure légendaire du piano, Glenn Gould a révolutionné l’interprétation musicale par son style singulier et ses excentricités. Ce portrait intime explore son ascension fulgurante, ses névroses et sa relation complexe avec sa mère, qui voyait en lui l’accomplissement de ses propres rêves brisés. Une pièce émouvante sur le prix du génie et le combat intérieur d’un artiste en quête d’absolu."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://www.rideauvert.qc.ca/piece/glenn-gould-naissance-dun-prodige/"
      }
