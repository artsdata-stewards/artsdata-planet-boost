    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "2025 revue et corrigée"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Une tradition du temps des Fêtes toujours aussi attendue, où satire et intelligence se rencontrent pour faire rire, réfléchir… et corriger 2025 à leur manière !"
      }
    ],
