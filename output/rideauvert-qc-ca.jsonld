  {
    "@id": "https://rideauvert.qc.ca/piece/parachute-libre/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Parachute libre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Alice et Marilyn, deux résidentes d’un centre pour aînés, partagent une chambre… mais pas la même vision du monde. L’une est acariâtre et solitaire, l’autre exubérante et têtue. Lorsque Marilyn défie Alice de lui prouver qu’elle n’a peur de rien, une escalade de coups pendants et de provocations s’ensuit. Parachute libre, de la comédie de haut vol !"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://www.rideauvert.qc.ca/piece/parachute-libre/"
      }
