    "http://schema.org/potentialAction": [
      {
        "@id": "_:g795920"
      },
      {
        "@id": "_:g1514180"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "2025 revue et corrigée - Théâtre du Rideau Vert"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "2025 revue et corrigée, c'est une tradition du temps des Fêtes toujours aussi attendue, où satire et intelligence se rencontrent pour faire rire, réfléchir… et corriger 2025 à leur manière ! S’inspirant des événements marquants de l’année, cette 20e édition de Revue et corrigée proposera un regard aiguisé sur l’actualité politique, culturelle et sociale, à travers une série de sketchs percutants, d’imitations hilarantes et de chansons revisitées."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
