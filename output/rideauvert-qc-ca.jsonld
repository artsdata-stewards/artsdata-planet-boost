  {
    "@id": "https://rideauvert.qc.ca/piece/a-toi-pour-toujours-ta-marie-lou/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "À toi, pour toujours, ta Marie-Lou"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Dix ans après la mort tragique de leurs parents, Carmen et Manon se retrouvent dans l’appartement familial, hanté par les fantômes du passé. Carmen, chanteuse western, s’est affranchie de l’héritage familial, tandis que Manon demeure prisonnière de son deuil et de sa vision rigide du monde. Entremêlant passé et présent, Michel Tremblay livre une œuvre bouleversante sur la transmission des blessures et l’émancipation possible."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://rideauvert.qc.ca/piece/a-toi-pour-toujours-ta-marie-lou/"
      }
