        "@language": "fr-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Chers parents - Théâtre du Rideau Vert"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Il faut accepter que le temps passe et que nos parents peuvent un jour décider de voler de leurs propres ailes. C’est l’apprentissage que doivent faire Pierre, Jules et Louise le jour où leurs parents les convoque pour un conseil familial au sommet. Il aurait suffi de ne pas parler d’argent et tout se serait probablement bien passé…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
