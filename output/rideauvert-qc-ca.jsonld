      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Faire le bien - Théâtre du Rideau Vert"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "En une douzaine de vignettes drôles, touchantes ou saisissantes, Faire le bien saisit les angoisses et les chamboulements de notre époque."
      }
    ],
