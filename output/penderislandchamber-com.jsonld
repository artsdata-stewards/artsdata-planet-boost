    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Concert Society Presents Alec Pearson"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The Pender Island Concert Society presents classical guitarist Alec Pearson from Vancouver for a solo recital featuring Spanish, Italian and Latin American composers of the last 200 years, along with some of his own music. November 5 starting at 7PM at the Community Hall. Tickets avaialble at Talisman Books and online on the Ptarmigan Arts website."
      }
