    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Enjoy an immersive short film that takes us deep into underwater ecosystems. Then, bring your questions to marine conservation experts discussing real, actionable ways to protect waters around Pender Island. RSVP on the Conservancy website. Free admission and popcorn. Sunday, October 5 at 4PM at the Community hall.&lt;/p&gt;\\n"
      }
