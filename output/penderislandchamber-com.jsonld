    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Halloween Bash"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Dinner and Hallowe'en Karaoke Night @ The Legion on October 31. Dinner at 5PM. Karaoke starts at 7PM and runs until 11PM. 1344 MacKinnon Road, Pender Island. Wear your favourite costume! By donation to the Food Bank (cash or canned food). Prizes, treats, tricks, 19+ only."
      }
