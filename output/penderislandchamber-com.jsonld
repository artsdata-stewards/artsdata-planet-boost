      },
      {
        "@id": "https://penderislandchamber.com/event/heres-to-your-good-health-speaker-series/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Here&#8217;s to Your Good Health Speaker Series"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "2025 Speakers Series: October 24 at 7pm at the Community Hall. Wildife-Transmitted Disease: The Pathogen & The Vector with Dr. Helen Schwantje, the former wildlife veterinarian for British Columbia. Topics covered will include potential for zoonoses and other public health issues in areas of high human contact with deer and their parasites/pathogens, such as Lyme Disease, and health implications for wildlife of high population density. Brought to you by the Pender Islands Health Care Society and the Pender Islands Conservancy."
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
