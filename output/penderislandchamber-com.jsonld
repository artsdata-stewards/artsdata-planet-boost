    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;The 8th annual Fall Crawl Studio Tour is happening September 26 and 27, 2026! This is your annual opportunity to enjoy touring the studios of local artists and getting up close and personal with their work and processes (the tour is completely free!).&lt;/p&gt;\\n"
      }
