    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Join the Pender Islands Health Care Society on Saturday, October 18, 2025 at 2pm for a public information meeting on rural healthcare funding challenges in BC. Learn the latest updates, ask questions, and find out how you can support this vital work—coffee and cookies provided.&lt;/p&gt;\\n"
      }
    ],
