      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Remote Bowls of Hope Gala"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Join the second annual Remote Bowls of Hope Pender Island Gala, a fundraiser for our youth’s wellness on Pender Island and during their time in Victoria.  Enjoy a delicious spread of soups, breads, and desserts prepared by our local chefs and bakers, along with fabulous entertainment from local youth performers, including the beloved The Dip band.  Every attendee will receive a beautiful painted bowl, a token of support for our youth. Tickets are $35 per person and include food, a bowl, and entertainment.  Plus, there’s a silent auction featuring amazing items donated by local businesses, artists, and community members eager to support our youth.\r\nTickets are available at Talisman Books and Gallery and by emailing admin@vyes.ca\r\n"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
