    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Author Reading by Terry Fallis"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Join celebrated Canadian author Terry Fallis in the library on October 12 at 1PM. Terry will read from his latest novel, The Marionette. Terry's 10th novel introduces readers to a new hero, James Norval, a world-famous thriller writer whose life takes an unexpected turn from the pages of his novels into the perilous world of espionage."
      }
    ],
