    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Embrace Your Roots &#8211; Herb Harvest at Raven Rock"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;On Saturday, October 4 at 10:00 AM, join Herbalist Geneva Jacobs and Farmer Matilda te Hennepe at Raven Rock Farm on Pender Island for a 5-hour hands-on herb workshop. Focused on medicinal roots, participants will harvest, process, and create a take-home tincture while learning about traditional herbal practices. For more information, see here: https://www.ravenrockfarm.com/activities. &lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
