    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Join DJ Marc for the Halloween Howl Family Dance at the Community Hall on Friday, October 31 from 6:30PM to 8:10PM. Head out for a bonfire and grab a hot dog from the Fire Hall then back to the dance. The film Beetlejuice Beetlejuice follows.&lt;/p&gt;\\n"
