      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "_:g1067020"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://penderislandchamber.com/events/2025-12-04/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Pender Island Chamber of Commerce WINTER SOCIAL"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Join us for our WINTER SOCIAL on Thursday, December 4. This is a fun, festive get together with other island business and community leaders to celebrate our collective achievements this past year. There’ll be live music, finger foods, a cash bar, prizes and a few fun surprises. &lt;/p&gt;\\n&lt;p&gt;Host: Pender Island Chamber of Commerce&lt;br /&gt;\\nDate: Thursday, December 4, 2025&lt;br /&gt;\\nTime: 5PM onwards&lt;br /&gt;\\nVenue: Franklin Castle&lt;br /&gt;\\nTicket Price Members and Guests: $25&lt;/p&gt;\\n&lt;p&gt;RSVPs open to November 29, 2025. There is a cap on the numbers at this venue, so please be sure to book your space early! To reserve your spot, please RSVP and send your payment by e-transfer to info@penderislandchamber.com. Your advance payment helps us confirm catering numbers and keep the evening running smoothly. Thank you!&lt;/p&gt;\\n&lt;p&gt;Cancellation Policy: Please note that tickets are non-refundable after November 29, 2025.&lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": "Organization"
      }
    ],
