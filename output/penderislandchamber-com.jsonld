      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Winter's Wake: A Celebration of the Seasonal Ghost Story A fireside celebration of the classic Christmas ghost story tradition with chilling tales, themed drinks, and seasonal surprises. Tickets available at winterswake.ca or at Talisman Books. Doors will open at 3:15, the show starts at 4. Full bar and menu will be available."
      }
    ],
