    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Book Signing with Wanda Gray"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Meet the author Wandy Gray at Talisman Books on Oct 11 at 2PM for a book signing for Broken Butterfly: A True Local Cautionary Tale. Broken Butterfly is the heart wrenching true story of Erin Gray, who was lured, held hostage by, and eventually escaped from a serial predator. A portion of all proceeds go to support Moms Stop the Harm."
      }
    ],
