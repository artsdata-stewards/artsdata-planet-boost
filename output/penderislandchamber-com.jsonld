  {
    "@id": "https://penderislandchamber.com/temporary/96b592c8-2405-437b-8325-7cfdd1ce1f5f",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/image": [
      {
        "@id": "https://penderislandchamber.com/wp-content/uploads/2025/11/WinterSocial.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://penderislandchamber.com/event/pender-island-chamber-of-commerce-winter-social/"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-12-04T00:00:00-08:00"
      }
    ],
    "http://schema.org/endDate": [
