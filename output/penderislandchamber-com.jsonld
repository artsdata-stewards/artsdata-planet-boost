    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Solstice Theatre presents Alice in Wonderland"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Solstice Theatre presents the 2025 Pantomime &quot;Alice in Wonderland&quot; by Ben Crocker on November 27, 28, 29 at 7PM and November 30 at 2PM. With a cash of thousands - lots of kids, a love story, wrong rabbits, chases and right rabbits. Tickets available at Talisman Books or on Ticket Tailer.&lt;/p&gt;\\n"
      }
    ],
