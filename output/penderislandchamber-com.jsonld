    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "7th Annual Hope Bay Hollow Pumpkin Carving Contest"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Calling pumpkin carvers of all ages! Pick up your free pumpkin starting October 23 at Hope Bay or the Dockside Realty office at Driftwood Centre. Create your masterpiece. Write your name, phone number and age group (under 12 or 12+) on the back in waterproof ink. Deliver your Jack O\\'Lantern to Hope Bay by October 28. Prizes will be awarded for the Scariest and Most Creative in each age group, as well as a grand prize People\\'s Choice Award. Come to Hope Bay Hollow after October 28 to view the Jack O\\'Lanterns and vote for your favourite. Enjoy the Hope Bay merchants while you\\'re here!&lt;/p&gt;\\n"
      }
    ],
