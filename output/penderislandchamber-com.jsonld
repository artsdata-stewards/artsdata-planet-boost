        "@language": "en",
        "@value": "Saturday Harvest Market"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;From 10AM to 1PM, come out to browse local food, craft and produce at the Saturday Harvest Markets at the Community Hall. Local handmade goods, farm fresh produce and a cafe led by the Youth Leadership Program are available. Support your local artisans, artists and cuisiniers.&lt;/p&gt;\\n"
      }
