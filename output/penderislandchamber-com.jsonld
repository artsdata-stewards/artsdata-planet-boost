  {
    "@id": "https://penderislandchamber.com/temporary/52bad9f0-d2b7-49d1-be10-22be9483a142",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/image": [
      {
        "@id": "https://penderislandchamber.com/wp-content/uploads/2025/10/hope-bay-hollow.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://penderislandchamber.com/event/7th-annual-hope-bay-hollow-pumpkin-carving-contest/"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-10-23T00:00:00-07:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-10-31T23:59:59-07:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1552080"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://penderislandchamber.com/events/category/non-recurring/2025-11/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "7th Annual Hope Bay Hollow Pumpkin Carving Contest"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Calling pumpkin carvers of all ages! Pick up your free pumpkin starting October 23 at Hope Bay or the Dockside Realty office at Driftwood Centre. Create your masterpiece. Write your name, phone number and age group (under 12 or 12+) on the back in waterproof ink. Deliver your Jack O\\'Lantern to Hope Bay by October 28. Prizes will be awarded for the Scariest and Most Creative in each age group, as well as a grand prize People\\'s Choice Award. Come to Hope Bay Hollow after October 28 to view the Jack O\\'Lanterns and vote for your favourite. Enjoy the Hope Bay merchants while you\\'re here!&lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": "Organization"
      }
