    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Winter\\'s Wake: A Celebration of the Seasonal Ghost Story&lt;br /&gt;\\nA fireside celebration of the classic Christmas ghost story tradition with chilling tales, themed drinks, and seasonal surprises.&lt;br /&gt;\\nTickets available at winterswake.ca or at Talisman Books.&lt;br /&gt;\\nDoors will open at 3:15, the show starts at 4. Full bar and menu will be available.&lt;/p&gt;\\n"
      }
