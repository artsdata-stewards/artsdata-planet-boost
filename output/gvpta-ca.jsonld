    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "World Theatre Day"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "GVPTA commemorates World Theatre Day (March 27) by sharing the Canadian message and campaign, raising the profile of the local theatre scene through public awareness activities, and aiding theatre companies to increase their community engagement around their related events."
      }
    ]
