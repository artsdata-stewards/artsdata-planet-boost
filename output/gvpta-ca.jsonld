    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "GVPTA's Industry & Community Development programs support arts, culture, and heritage practitioners through year-long learning processes, professional development, networking events, and community gatherings."
      }
    ]
  },
  {
    "@id": "https://www.gvpta.ca/temporary/cfcf41c7-f12b-41cf-9c7d-8495ca0e251b",
    "@type": [
      "http://schema.org/EducationalOccupationalProgram"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.gvpta.ca/programs/industry-community-development/pathways"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://cdn.prod.website-files.com/68fc082441ce8fb6555b611a/6967f24d3251bb2b147a3882_Pathways.avif"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Pathways"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The Pathways program is a year-long process that supports arts, culture, and heritage practitioners to learn, reflect, and integrate equity and access more deeply into their work. Participants are supported with individualized learning plans, peer networks, and one-on-one guidance."
      }
    ]
  },
  {
    "@id": "https://www.gvpta.ca/temporary/292a3bd4-986c-42c3-9453-7ee345f41961",
    "@type": [
      "http://schema.org/EducationalOccupationalProgram"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.gvpta.ca/programs/industry-community-development/reflect"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://cdn.prod.website-files.com/68fc082441ce8fb6555b611a/6967f24d308ab63b39b4ad4a_REFLECT.avif"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "REFLECT"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Offering community-focused cultural leaders a funded opportunity for a cohort-based learning experience to support, develop and enhance their leadership in the cultural sector. Participants are engaged in a year-long process of learning, sharing, building, rethinking, and leading alongside a community of peers."
      }
    ]
  },
