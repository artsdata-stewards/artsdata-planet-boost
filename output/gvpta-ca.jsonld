      {
        "@language": "en",
        "@value": "Offline: In-person gatherings for company leaders"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Gatherings for folks in leadership roles within the Vancouver Theatre Community to connect with each other and discuss issues in our sector. These sessions are meant to build community connectivity, and bring together local arts leaders at all stages of their careers to foster mutual support."
      }
