      }
    ]
  },
  {
    "@id": "https://confederationcentre.com/event/polka-dot-door/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Polka Dot Door - Confederation Centre of the Arts"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Peep through the Polka Dot Door with us this summer at the Confederation Centre Amphitheatre! Polka Dot Door is a FREE outdoor family musical inspired by one of Canada’s most beloved children’s shows. Join Polkaroo and friends for a joyful adventure filled with sing-along songs, playful storytelling, and plenty of laughs along the way. Perfect for young audiences and the young-at-heart, this fun and educational show brings the magic of the classic series to life in a lively outdoor performance the whole family can enjoy together. Performances run Monday–Saturday. *No performance on July 21–22 In association with TVO Media Education Group Charlottetown Festival · Summer 2026 📅 2026 Festival Schedule ●Anne of Green Gables – The Musical™ ●Come From Away ●C’mon In! An Island Kitchen Party ●Polka Dot Door Complete calendar of performances at the Sobey Family Theatre, The Mack, and Outdoor Amphitheatre. View Full Calendar →"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://confederationcentre.com/event/polka-dot-door/"
      }
    ],
