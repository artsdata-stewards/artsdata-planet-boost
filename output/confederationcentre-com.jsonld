  {
    "@id": "https://confederationcentre.com/fr/event/highland-dance-workshop/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
