    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Atelier de danse des Highlands - Centre des arts de la Confédération"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Le cours se concentrera sur la plus ancienne et la plus reconnaissable des danses traditionnelles des Highlands, le Highland Fling. Cette danse était autrefois une démonstration d'adresse et d'agilité des guerriers, exécutée sur leurs boucliers ! Aujourd'hui, le Highland Fling est une danse solo, jugée pour sa précision et son équilibre."
      }
    ],
    "http://ogp.me/ns#url": [
