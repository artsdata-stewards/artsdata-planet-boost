    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Come and join us at Confederation Centre Art Gallery for an hour of FREE art and craft activities for the whole family! Explore our current exhibitions at a leisurely pace and create fun and simple crafts to take home. All materials will be provided.⁠ Dates: January 25 February 22 March 29 April 26"
      }
