    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "C'Mon In! An Island Kitchen Party - Confederation Centre of the Arts"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "This summer, the Island’s best kitchen party is at The Mack. C’mon In! throws open the door and invites you straight into a lively Maritime kitchen, where the kettle’s always on, the stories get bigger as the night goes on, and the music keeps everyone around the table just a little longer.Led by crowd favourites Robbie Doherty and Pierce Clarke, this laugh-out-loud, music-filled night brings together the songs Islanders know by heart and visitors can’t help but join in. With surprise moments, playful banter, and a band that knows how to keep the party rolling, you never quite know who’s going to walk through the kitchen door next."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://confederationcentre.com/event/cmon-in/"
      }
    ],
