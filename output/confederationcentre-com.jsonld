    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Danse Inclusive est un espace sûr et accueillant pour les danseurs de tous niveaux. Inspiré du programme de danse adaptée du Boston Ballet, Danse Inclusive s'efforce de rendre la danse accessible aux élèves en situation de handicap, leur permettant ainsi de mettre en valeur leurs talents."
      }
    ],
