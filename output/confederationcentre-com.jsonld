      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Come From Away is based on the true story of a small town that welcomed the world. What started as an average day in Gander, Newfoundland turned into a historic moment when 38 planes carrying thousands of people were diverted there on September 11, 2001."
      }
    ],
