    "http://schema.org/url": [
      {
        "@id": "https://confederationcentre.com/fr/event/circles-of-song-a-confederation-singers-spring-concert/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Circles of Song: A Confederation Singers Spring Concert"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "A COMPASSTECH LIVE AT THE CENTRE PRESENTATION The Confederation Singers present a Spring Concert centred around the natural cycles and seasons of our world. Through a wide range of musical influences both local and global, we investigate how this patient yet persistent movement can nurture a turn toward love and healing in the circles of our own lives. Featured songs: The artists we present during CompassTech LIVE @ the Centre are terrific performers. We are so confident you’ll enjoy these shows, we’re offering a Money-Back Guarantee for the 2026 LIVE at the Centre season. Try something new without the worry. See full Money-Back Guarantee terms for details."
      }
    ],
    "http://schema.org/keywords": [
      {
        "@language": "fr",
        "@value": "Arts Education, Choral Music, Live@TheCentre"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
