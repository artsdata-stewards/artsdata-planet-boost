  {
    "@id": "https://confederationcentre.com/fr/event/forever-seger/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Forever Seger - L'expérience Silver Bullet - Centre des arts de la Confédération"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Une présentation de VaughnCo Entertainment. HOMMAGE À LA MUSIQUE DE BOB SEGER. FOREVER SEGER vous propose un voyage dynamique à travers la musique intemporelle de Bob Seger et du Silver Bullet Band. Avec des voix authentiques, un groupe de neuf musiciens et des performances exceptionnelles, le groupe recrée le son Seger inimitable. La réputation grandissante de FOREVER SEGER comme LA référence en matière d'hommage à Bob Seger les a propulsés sur les plus grandes scènes et festivals d'Amérique du Nord. Des premières notes du classique intemporel « Turn the Page » aux hymnes rock'n'roll tels que « Hollywood Nights », « Old Time Rock and Roll » et « Night Moves », il est clair que les fans de Bob Seger considèrent FOREVER SEGER comme une véritable expérience de concert, invitant le public à danser et à chanter à nouveau sur la bande-son de leur vie."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr",
        "@value": "https://confederationcentre.com/fr/event/forever-seger/"
      }
