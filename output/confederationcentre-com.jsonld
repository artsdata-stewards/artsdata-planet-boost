    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Adult Drama  6-Week Series"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "This workshop series offers opportunities to create and collaborate with others in a positive, supportive and uplifting community. Participants will work on characterization, improv and roleplay, blocking and movement techniques, scene analysis and performance, and audition prep. The creativity, self-expression, and feedback in this program will foster reflection, growth, connection and a whole lot of fun! &nbsp;"
      }
    ],
