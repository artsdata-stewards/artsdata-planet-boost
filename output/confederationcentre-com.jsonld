    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "The Rock Orchestra by Candlelight - Confederation Centre of the Arts"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "After entertaining over 700,000 fans across the UK, USA, and Europe, The Rock Orchestra by Candlelight is launching its first major tour across Canada — and it’s a concert experience like no other.In a 90-minute live show, 14 classical musicians bring a haunting beauty to iconic rock and metal anthems, all set in an atmospheric candlelit setting."
      }
    ],
