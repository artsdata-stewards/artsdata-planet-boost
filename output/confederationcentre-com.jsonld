        "@language": "fr",
        "@value": "TRASH! Talk: Underground Art Comics Readings"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Join the Charlottetown Comics Club for Trash! Talk, an evening of underground art comics read aloud in person, featuring excerpts from local comic creators plus commentary and conversation. Expect weird, wonderful, and sharp work, performed live. Free admission. No registration is required."
      }
