    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Ce cours se concentre sur le chant, la danse et le théâtre, en mettant l'accent sur le travail d'équipe et la performance d'ensemble. Les élèves développeront leurs compétences en performance et exploreront de nouveaux exercices dans un environnement stimulant. "
      }
