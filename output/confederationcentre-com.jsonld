        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Fairy Tales and Footlights: Primary and Elementary Musical Theatre - Confederation Centre of the Arts"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Join us as our Musical Theatre students take to the stage to celebrate a year of hard work, creativity, and growth. This end-of-year showcase is a joyful opportunity for students to share their passion and talent with family and friends. Featuring performances by Dance Umbrella’s Primary and Elementary Musical Theatre classes, this show will highlight their progress in singing, dancing, and acting as they journey through a world of fairytales and make-believe."
      }
    ],
