    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "PEI Symphony Orchestra Presents: Reclaimed"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Reclaimed speaks to home, and what happens when home leaves us. The PEISO is thrilled to welcome Cris Derksen, a Juno-nominated Indigenous cellist and composer, who is internationally renowned for their genre-defying music that bridges the traditional and contemporary. This moving program includes Derksen’s own works including Round Dance, Parkdale and Controlled Burn. Paired with Nat Bartsch’s introspective Hope and Margaret Bonds’ Montgomery Variations, which responds to the American civil rights movement, the program also features Smetana’s ‘Die Moldau’ from Má Vlast, a passionate tribute to national identity and personal belonging."
      }
    ],
    "http://schema.org/keywords": [
      {
        "@language": "en",
        "@value": "Music, On Stage"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
  {
    "@id": "https://confederationcentre.com/event/fairytales-footlights-elem/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
