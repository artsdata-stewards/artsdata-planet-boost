    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Camp de perfectionnement professionnel en arts - Centre des arts de la Confédération"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Les campeurs de notre camp de perfectionnement en arts du spectacle bénéficieront d'une gamme complète de formations artistiques et auront l'occasion unique d'explorer les arts par le biais d'expériences pratiques et d'observation. Le matin, nos éducateurs en arts visuels guideront les campeurs dans diverses activités artistiques, notamment le dessin, la peinture, la sculpture, les loisirs créatifs et bien plus encore. L'après-midi, ils se rendront au studio de danse pour explorer le théâtre, la musique et la danse !"
      }
    ],
