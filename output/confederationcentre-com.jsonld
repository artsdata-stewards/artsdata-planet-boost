      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Célébrant 25 ans de tournée de leur spectacle de Noël à saveur celtique très apprécié, les Barra MacNeils présentent les favoris du public et du nouveau matériel spécial au Centre de la Confédération de Charlottetown le 19 décembre dans le cadre de leur tournée nationale."
      }
    ],
