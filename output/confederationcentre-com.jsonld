    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://confederationcentre.com/fr/event/healing-through-harmony/%23tickets"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://confederationcentre.com/fr/event/healing-through-harmony/%23tickets"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Healing through Harmony"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "In a world that needs more moments of connection, singing together has a powerful way of bringing people closer. In Healing through Harmony – The Choir Connection, participants will explore the joy and energy of group singing while learning songs that reflect themes of resilience, hope, empowerment, and solidarity. Over the course of the series, we will learn traditional and contemporary songs, rounds, and simple choral arrangements in a relaxed and welcoming environment. Along the way, participants will develop vocal skills, experience the uplifting power of harmony, and discover how music can help strengthen our sense of belonging and wellbeing. This workshop series is designed for everyone, regardless of singing experience. The focus is on participation and connection rather than performance or perfection. All you need to bring is curiosity, a willingness to try something new, and a voice ready to join the chorus. Sessions take place on Mondays from 7:00 PM to 9:00 PM. Register Here"
      }
    ],
    "http://schema.org/keywords": [
      {
        "@language": "fr",
        "@value": "6 week series, Arts Education, Choral Music, Music"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
  {
    "@id": "https://confederationcentre.com/fr/event/forever-seger/%23tickets",
    "http://ogp.me/ns#locale": [
