    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Rejoignez-nous le samedi pour un cours de ballet ouvert, conçu pour les danseurs souhaitant perfectionner leur technique et approfondir leur art. Ce cours de ballet traditionnel est l'occasion idéale de mettre en pratique les apprentissages de la semaine, de consolider vos bases et de poursuivre votre développement."
      }
    ],
