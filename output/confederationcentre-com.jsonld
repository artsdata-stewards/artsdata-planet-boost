      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://confederationcentre.com/event/peiso-presents-blue/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "PEI Symphony Orchestra Presents: Blue with Guest Soloist Magdalena von Eccher"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "A PEI Symphony Orchestra Presentation The season closes with a program of unbridled joy, centered in the rhythms and character of jazz, pop, and gospel music. Tracing a remarkable musical evolution from the late 19th to the 20th century, Blue connects Ravel’s mesmerizing Bolero to Omar Thomas’ exuberant 2018 work Come Sunday, celebrating new sounds and cultural voices in classical music. PEI’s own Magdalena von Eccher performs Debussy’s seldom-heard Fantaisie for Piano and Orchestra, while Gershwin’s An American in Paris—inspired by Ravel and reimagined here as perhaps a Canadian in Paris—anchors the concert with the vibrant, cosmopolitan energy of 1920s Paris."
      }
    ],
    "http://schema.org/keywords": [
      {
        "@language": "en",
        "@value": "Music, On Stage"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
