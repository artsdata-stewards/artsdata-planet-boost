    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://confederationcentre.com/event/hollywood/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "PEI Symphony Orchestra Once Upon a Score: The Music of Hollywood"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "What makes a great story—and what does it sound like? Once Upon a Score is a witty, heartfelt symphonic experience that blurs the line between concert and theatre. Set in a bustling café, the performance follows a down-on-his-luck screenwriter who reunites with an old friend—sparking a whirlwind conversation about story arcs, artistic purpose, and the blockbuster tales that have shaped our culture. As their banter unfolds, a full orchestra brings their imagination to life with music from some of Hollywood’s most beloved scores. Created by Jaelem Bhate, award-winning conductor-composer and Music Director of the PEI Symphony Orchestra, this genre-bending production features iconic themes from Harry Potter, Star Wars, Indiana Jones, Jurassic Park, Titanic, Pirates of the Caribbean, The Avengers, and more. Each musical moment becomes part of the narrative itself—underscoring the emotional arc, adding punchlines, and stirring the soul. Smart, funny, and surprisingly moving, Once Upon a Score is a celebration of cinema, creativity, and the universal power of storytelling. Whether you’re a film buff, music lover, or just someone who’s ever wrestled with their own creative voice, this unique concert-theatre hybrid will leave you laughing, reflecting— and maybe even inspired to write your own next chapter. This performance is a co-production and not eligible for a Money-Back Guarantee (but we&#8217;re sure [&hellip;]"
      }
    ],
    "http://schema.org/keywords": [
      {
        "@language": "en",
        "@value": "Live@TheCentre, Music, On Stage"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
