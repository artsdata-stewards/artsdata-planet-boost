    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "PD Day Teen Animation"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Get hands on with the art of animation! In this workshop, students will create animation by hand using paper, pencils and other accessible drawing materials. Participants will learn simple techniques to make their drawings move, loop and morph, and get a glimpse into the history of animation before the digital era. Students will take home their original drawings, and parents/guardians will receive digital copies of the completed animations by email. All supplies are provided, but students are welcome to bring their favourite markers or pencils. A fun, low-pressure way for creative teens to try animation in its most tactile form &#8211; no previous experience required. February 2nd, 2pm Instructor: Andreas Fobes is a filmmaker and educator originally from Ottawa, Ontario. He holds a BFA from Mount Allison University and an MA in Animation from the University of the West of England. As the Visual Arts Educator, he works to make both creating and experiencing visual art engaging, accessible, and fun for all ages."
      }
    ],
    "http://schema.org/keywords": [
      {
        "@language": "fr",
        "@value": "Arts Education, PD Day, Visual Arts"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
  {
