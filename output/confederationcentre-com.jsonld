      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Contes de fées et feux de la rampe : Théâtre musical pour les élèves du primaire et du secondaire – Centre des arts de la Confédération"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Rejoignez-nous pour une année de travail acharné, de créativité et de développement personnel pour nos élèves de théâtre musical. Ce spectacle de fin d'année est une occasion unique pour les élèves de partager leur passion et leur talent avec leurs proches. Avec des performances des classes de théâtre musical de Dance Umbrella pour les niveaux primaire et élémentaire, ce spectacle mettra en lumière leurs progrès en chant, danse et théâtre, tandis qu'ils voyageront dans un monde de contes de fées et de fantaisie."
      }
    ],
