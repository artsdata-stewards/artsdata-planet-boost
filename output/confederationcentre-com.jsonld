        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Ressentez le rythme : un voyage au cœur de la danse ouest-africaine | Cours de 6 semaines - Centre des arts de la Confédération"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Venez découvrir les bases de la danse ouest-africaine au rythme de percussions énergiques. Ce cours vous initiera aux rythmes percussifs, à la synchronisation et vous fera apprécier l'importance du mouvement plutôt que de l'apparence, ainsi que l'expression individuelle."
      }
    ],
    "http://ogp.me/ns#url": [
