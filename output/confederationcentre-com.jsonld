    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://confederationcentre.com/fr/event/yesterday-the-magic-of-the-beatles/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Yesterday: The Magic of the Beatles"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Running Time:Act 1 – 45 minutes, Act 2 – 40 minutes (approx. 1 hour 25 minutes total) Lighting / Effects Warning:This performance includes strobe/flashing lights and smoke/haze effects. Join us for an unforgettable journey through the music of the most legendary group of all time — The Beatles. Step aboard this Magical Mystery Tour as we travel from their very first album all the way to the iconic finale of Abbey Road.  With more production elements than any Craig Fair Productions show to date, we’ll bring new life to the extraordinary catalog of a band that changed the face of music forever. Over 60 years later, their magic still moves us — and this show will remind you why.  Don’t miss this one-of-a-kind experience, filled with heart, nostalgia, and timeless music that continues to inspire generations.  &#8220;And in the end, the love you take is equal to the love you make.&#8221; — The Beatles "
      }
    ],
    "http://schema.org/keywords": [
      {
        "@language": "fr",
        "@value": "Music, On Stage"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
  {
    "@id": "https://confederationcentre.com/fr/event/feel-the-rhythm-a-west-african-dance-journey-6-week-series/",
    "http://ogp.me/ns#locale": [
