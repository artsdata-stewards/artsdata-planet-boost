    "http://schema.org/url": [
      {
        "@id": "https://confederationcentre.com/event/alex-mackenzie-never-been-better-tour/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Alex Mackenzie- Never Been Better Tour"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "ECL Productions Inc. Presents Alex Mackenzie is taking the comedy world by storm, and his Never Been Better tour proves why. He gave up everything—his house, his job, even the respect of his family—to pursue stand-up, and he’s never looked back. After years of relentless hustle, that gamble is paying off. As an independent artist from Prince George, BC, Alex has self-produced all of his shows without the backing of a major label, and the results speak for themselves. He’s earned over 100 million views online, landed a feature on Amazon Prime, sold out theatres across Canada and Australia, and even performed in an arena for more than 2,000 fans. He’s showing the world that betting on yourself can lead to something incredible. What really sets Alex apart is the experience he creates. Known as the “happiness cheerleader” of comedy, his shows feel like hanging out with your best friend—positive, interactive, and full of life. Every night is unique, blending crowd work, fresh material, deep life lessons, and the unmistakable passion of someone who risked everything to follow a dream. You may not remember every single joke, but you’ll remember how the show made you feel. Everyone leaves happier than [&hellip;]"
      }
    ],
    "http://schema.org/keywords": [
      {
        "@language": "en",
        "@value": "Comedy, On Stage"
      }
    ],
