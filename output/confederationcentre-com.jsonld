    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Au cœur de l'histoire de l'Île - Centre des arts de la Confédération"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Plongez dans l'histoire fascinante de l'Île-du-Prince-Édouard lors de cette présentation captivante, digne d'un cabaret. Un expert en histoire insulaire vous guidera à travers des récits passionnants, des images rares et des faits méconnus. Que vous soyez un féru d'histoire, un visiteur curieux ou un insulaire fier de l'être, vous repartirez avec une meilleure compréhension des personnes, des événements et des forces qui ont façonné ce lieu remarquable."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr",
