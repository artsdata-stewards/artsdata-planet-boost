      {
        "@language": "fr",
        "@value": "Cours d'improvisation pour adolescents (6 semaines) - Centre des arts de la Confédération"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Développez votre sens de l'humour et vos compétences sociales ! Ce cours d'improvisation est axé sur la création de scènes instantanées, la création de personnages et le renforcement de la confiance en soi. La règle d'or : pas d'erreurs ! Apportez simplement votre énergie ; nous créerons les rires ensemble. Préparez-vous à jouer et à découvrir votre véritable potentiel créatif !"
      }
    ],
    "http://ogp.me/ns#url": [
      {
