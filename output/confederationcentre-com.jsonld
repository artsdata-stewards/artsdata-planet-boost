        "@language": "fr",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Cercles de chants : Concert printanier des Chanteurs de la Confédération - Centre des arts de la Confédération"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Les Chanteurs de la Confédération présentent un concert de printemps centré sur les cycles naturels et les saisons de notre monde. À travers un large éventail d'influences musicales locales et internationales, nous étudions comment ce mouvement patient mais persistant peut nourrir un tournant vers l'amour et la guérison dans nos vies."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr",
