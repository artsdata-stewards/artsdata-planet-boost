    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "PD Day Visual Arts Camp"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Campers in our Visual Arts PD Day Camp will get a full range of our arts education offerings, receiving a unique opportunity to explore the arts through both hand-on and observational experiences. In the morning, our Visual Arts Educators will lead campers through a variety of art activities including (but not limited to) drawing, painting, sculpting, crafts and more. Alongside these activities campers may venture on a guided tour of the current gallery exhibitions, meet our Heritage Players, and more! Gallery and Theatre tours are subject to availability throughout the year depending on exhibition and performance schedules. &nbsp; (Early Drop off/Pick Up) 8:00am to 5:00pm &#8211; $75 per child (Regular Drop off/Pick Up) 8:45am to 4:00pm &#8211; $60 per child &nbsp; Ages 5-12  "
      }
    ],
    "http://schema.org/keywords": [
      {
        "@language": "en",
        "@value": "Arts Education, Camps"
      }
    ],
