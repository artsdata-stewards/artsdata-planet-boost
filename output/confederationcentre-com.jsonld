    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "La gravité et autres mythes : dix mille heures - Centre des arts de la Confédération"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Chacun est un maître en quelque chose. Cligner des yeux, marcher, sauter, garder l'équilibre, faire des saltos, voler. C'est une ode aux innombrables heures nécessaires pour accomplir de grandes choses. Un hommage au dévouement nécessaire pour réaliser nos ambitions physiques. Une reconnaissance d'une histoire souvent plus spectaculaire que le produit fini. "
      }
    ],
    "http://ogp.me/ns#url": [
