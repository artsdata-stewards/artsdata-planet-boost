    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://confederationcentre.com/fr/event/pd-day-arts-camp/%23tickets"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "PD Day Arts Camp"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Campers in our PD Day Arts Camp will get a full range of our arts education offerings, receiving a unique opportunity to explore the arts through both hand-on and observational experiences. In the morning, our Visual Arts Educators will lead campers through a variety of art activities including (but not limited to) drawing, painting, sculpting, crafts and more. In the afternoon, they will hop on over to the dance studio where they will explore drama, music, and dance! Alongside these activities campers may venture on a guided tour of the current gallery exhibitions, meet our Heritage Players, and more! Gallery and Theatre tours are subject to availability throughout the year depending on exhibition and performance schedules. (Early Drop off/Pick Up) 8:00am to 5:00pm &#8211; $75 per child (Regular Drop off/Pick Up) 8:45am to 4:00pm &#8211; $60 per child &nbsp; Upcoming PD Day Camp Dates November 21 Register Here February 13 Register Here April 10 Register Here"
      }
    ],
    "http://schema.org/keywords": [
      {
        "@language": "fr",
        "@value": "Arts Education, Camps"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
  {
    "@id": "https://confederationcentre.com/fr/event/march-break-camp/%23tickets",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Camp de la relâche scolaire - Centre des arts de la Confédération"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Les campeurs de notre camp d'arts du spectacle et visuels de la relâche scolaire bénéficieront d'une gamme complète de formations artistiques et auront l'occasion unique d'explorer les arts par le biais d'expériences pratiques et d'observation. Le matin, nos éducateurs en arts visuels guideront les campeurs dans diverses activités artistiques, notamment le dessin, la peinture, la sculpture, les loisirs créatifs et bien plus encore. L'après-midi, ils se rendront au studio de danse pour explorer le théâtre, la musique et la danse !"
      }
    ],
    "http://ogp.me/ns#url": [
