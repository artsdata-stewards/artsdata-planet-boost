    "http://schema.org/url": [
      {
        "@id": "https://confederationcentre.com/event/pinch-penny-fair/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Pinch Penny Fair"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Friends of Confederation Centre of the Arts are accepting donations for one of their most anticipated annual fundraising events – the Pinch Penny Fair. For over 50 years, this event has raised funds to support arts education programs at the Centre. This year’s Pinch Penny Fair will take place on Saturday, April 11, from 10 a.m. – 1 p.m. at 130 Queen Street. This giant indoor yard sale is a thrift shopper’s dream with hundreds of items for sale, including books, sporting goods, toys, plants, music, jewellery, tools, glassware, and more. Donations for the Pinch Penny Fair will be accepted at the Centre’s box office entrance at 130 Queen Street on the dates listed below. As a reminder, donations should be gently used items. Clothing, televisions, and computers cannot be accepted. Donations drop-off schedule: Saturday, March 21 from 9 a.m. – 2 p.m. Saturday, March 28 from 10 a.m. – 5 p.m. Wednesday, April 8 from 12 p.m. – 7 p.m."
      }
    ],
    "http://schema.org/keywords": [
      {
        "@language": "en",
        "@value": "Fair"
      }
    ],
