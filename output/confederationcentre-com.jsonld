    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Adult Improv Workshop 6-Week Class"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Join storyteller and improv veteran Cameron MacDonald for a lively and laughter-filled workshop designed for adults! Discover the joy of improvisation through simple, engaging games and storytelling exercises that spark creativity, boost confidence, and foster connection—no experience needed. Hosted at the Confederation Centre of the Arts Studio 1, this welcoming session invites you to play, explore, and embrace the unexpected in a relaxed and supportive environment. Whether you&#8217;re a longtime improv fan or trying it for the first time, come ready to laugh, share, and create unforgettable moments together! No scripts, no pressure—just pure fun! Wednesdays | January 7, January 14, January 21, January 28, February 4, February 11 Instructor: Cameron MacDonald has been performing on PEI from a young age. He has been trained in theatre by many over the years, from UPEI to the Confederation Centre of the Arts, but he attributes most of what he&#8217;s learned to his father of Annekenstein fame. He has been a member of Popalopalots improv for over a decade, and also leads the Heritage Players program."
      }
    ],
    "http://schema.org/keywords": [
      {
        "@language": "en",
        "@value": "6 week series, Arts Education, Workshops"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
