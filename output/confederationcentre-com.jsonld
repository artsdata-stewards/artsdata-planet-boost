      {
        "@language": "en",
        "@value": "Join us as our Musical Theatre students take to the stage to celebrate a year of hard work, creativity, and growth. This end-of-year showcase is a joyful opportunity for students to share their passion and talent with family and friends. Featuring performances by Dance Umbrella’s Intermediate  and Senior Musical Theatre classes, this show will highlight their progress in singing, dancing, and acting as they journey through a world of fairy tales… with a twist!  The artists we present during CompassTech LIVE @ the Centre are terrific performers. We are so confident you’ll enjoy these shows, we’re offering a Money-Back Guarantee for the 2026 LIVE at the Centre season. Try something new without the worry. See full Money-Back Guarantee terms for details."
      }
    ],
    "http://schema.org/keywords": [
      {
        "@language": "en",
        "@value": "Arts Education, dance umbrella, Live@TheCentre"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
