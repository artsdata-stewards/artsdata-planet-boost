    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Rejoignez le Charlottetown Comics Club pour Trash! Talk, une soirée de lecture à voix haute de bandes dessinées underground, avec des extraits d'auteurs locaux, des commentaires et des échanges. Attendez-vous à des œuvres étranges, merveilleuses et percutantes, présentées en direct. Entrée libre. Aucune inscription requise."
      }
