        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Come From Away - Centre des arts de la Confédération"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Come From Away est basé sur l'histoire vraie d'une petite ville qui a accueilli le monde. Ce qui avait commencé comme une journée ordinaire à Gander, à Terre-Neuve, s'est transformé en un moment historique lorsque 38 avions transportant des milliers de personnes ont été détournés de cette ville le 11 septembre 2001."
      }
    ],
    "http://ogp.me/ns#url": [
