  {
    "@id": "https://confederationcentre.com/fr/event/matt-andersen/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Matt Andersen : La tournée « Le Marteau et la Rose » - Centre des arts de la Confédération"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Quand Matt Andersen monte sur scène, il distille toute une vie musicale à chaque note qu'il joue. Son dernier album, The Hammer & The Rose, est un véritable jardin du cœur ; une collection (essentiellement) délicate de folk tendre et de morceaux soul émouvants où l'auteur-compositeur originaire du Nouveau-Brunswick s'occupe avec attention des choses les plus importantes de la vie."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr",
        "@value": "https://confederationcentre.com/fr/event/matt-andersen/"
      }
    ],
