      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "The Gallery will host its Winter Exhibition Opening Reception on January 31 from 2:00 to 4:00 p.m. All are welcome to attend this casual event to meet, mingle, and explore the new exhibitions. Artist and curator tours begin at 2:45 p.m. Sarah Maloney, Collapse, 2009, antique fainting couch, bronze, fabric, 74 x 66 x 194 cm. Photo: Morrow Scot-Brown."
      }
