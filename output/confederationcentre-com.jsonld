    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Tom Green-Stompin&#8217; Comedy Tour"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Please Note: This performance may contain strong language and mature, adult themes. From MTV mayhem to country calm, Canadian comedy legend Tom Green brings his wild, unpredictable style back to the stage! Known for The Tom Green Show, cult-favorite films like Freddy Got Fingered, and his offbeat series Funny Farm, Tom is blending stand-up, storytelling, and music in this hilarious new tour. Expect an unforgettable night packed with laughs, surprises, and classic Tom Green energy. 🎟️ VIP Meet &amp; Greet available! Add-on a VIP experience after purchasing your show ticket — includes a post-show meet &amp; greet and exclusive photo opportunity with Tom."
      }
    ],
    "http://schema.org/keywords": [
