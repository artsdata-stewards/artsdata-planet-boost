    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Arts Mixers at Confederation Centre Thursday, April 16th Mavor’s Lounge | 4:00–6:00 PM Come raise a glass, swap stories, and reconnect with your arts, culture and creative industries community. Register here."
      }
    ],
    "http://ogp.me/ns#url": [
