        "@value": "Open Ballet Course - Confederation Centre of the Arts"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Join us on Saturdays for an open ballet class designed for dancers looking to refine their technique and deepen their artistry. This traditionally structured ballet class offers the perfect opportunity to apply what you’ve learned throughout the week, strengthen your foundation, and continue developing your craft."
      }
    ],
