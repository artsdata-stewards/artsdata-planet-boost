      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Alan Jackson Experience"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The Alan Jackson Experience, performed by Aaron Halliday, a Nashville recording artist and two-time, including 2025, ISSA Entertainer of the Year award winner, is the ultimate tribute to Alan Jackson, boasting over three decades of performances. This dynamic tribute will transport you to an actual Alan Jackson concert, complete with the look, sound, and presence. The show promises to deliver exhilarating performances of fan-favorite songs, including CHATTAHOOCHEE, REMEMBER WHEN, GOOD TIME, SUMMERTIME BLUES, IT&#8217;S FIVE O&#8217;CLOCK SOMEWHERE, and DRIVE. Moreover, Aaron will showcase a few of his original songs that have gained international recognition through radio airplay worldwide. A meet and greet at intermission is open to all ticket holders. We eagerly anticipate your attendance."
      }
    ],
    "http://schema.org/keywords": [
      {
        "@language": "en",
        "@value": "Music, On Stage"
      }
