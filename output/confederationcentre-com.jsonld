    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Sit n&#8217; Knit at the Art Gallery"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "A casual, drop-in knitting club to be held every second Sunday between 1-3 PM in the Art Gallery. Bring your work in progress and sit amongst the art. No supplies provided and water only please. Free admission. Crocheters are also welcome. Photo credit: Robert Harris The Wool Winders, c. 1885 oil on canvas Robert Harris Tourism Collection, 1986 CAGH-7512 📅 Upcoming Dates Sunday, April 12, 1:00 – 3:00 PM Sunday, April 26, 1:00 – 3:00 PM Free admission · Drop-in welcome · Art Gallery"
      }
    ],
