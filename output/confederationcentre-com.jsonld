    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Grand Tour"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "After selling out 13 consecutive shows on PEI and many other venues throughout the Maritimes, The Grand Tour are making their first appearance in Charlottetown at the Confederation Centre! &#8220;THE GRAND TOUR&#8221; is a timeless journey through classic country music! Join us for electrifying performances of hits from the 50’s, 60’s, 70’s, and 80’s. Experience the soulful voices of George Jones, Johnny Cash, Conway Twitty, Jim Reeves, Charley Pride and much more, brought to life with fresh energy and passion. These talented musicians from PEI have taken the Maritimes classic country music fans by storm! They will have you remembering the days when you would sing along to the radio! Don&#8217;t miss this nostalgic celebration of country music&#8217;s rich heritage! For more information, visit www.thegrandtour.ca"
      }
    ],
    "http://schema.org/keywords": [
      {
        "@language": "en",
        "@value": "Music, On Stage"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
  {
    "@id": "https://confederationcentre.com/event/tom-green/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Tom Green-Stompin' Comedy Tour - Confederation Centre of the Arts"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "From MTV mayhem to country calm, Canadian comedy legend Tom Green brings his wild, unpredictable style back to the stage! Known for The Tom Green Show, cult films like Freddy Got Fingered, and his recent hit series Funny Farm, Tom is blending stand-up, storytelling, and music in this hilarious new tour.Don’t miss this one-of-a-kind night of laughs, insight, and classic Tom Green energy—live in Charlottetown, PEI on March 22!"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://confederationcentre.com/event/tom-green/"
      }
    ],
