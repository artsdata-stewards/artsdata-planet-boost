        "@id": "_:g1121260"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://confederationcentre.com/event/still-standin/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Still Standin&#8217; : A Night Of Elton John &#038; Billy Joel"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Running Time:Act 1 – 60 minutes, Act 2 – 55 minutes (approx. 1 hour 55 minutes total) Lighting / Effects Warning:This performance includes strobe/flashing lights and smoke/haze effects. Get ready for a night of music like no other! Two grand pianos take center stage, flanked by a jaw-dropping 16-piece orchestra featuring rhythm, brass, strings, and vocal sections. This production pays tribute to the legendary artistry of Elton John and Billy Joel while delivering a fresh, theatrical concert experience that will leave you spellbound. Craig Fair and Ben Aitken have wowed audiences across the province with their high-energy Dueling Pianos shows — but this time, they’re taking things to a whole new level. Bigger, bolder, and more electrifying than ever, this production is an immersive musical experience that redefines what a live concert can be. Expect to be swept away by hit after hit from two of music’s most iconic legends. From soaring ballads to driving rock anthems, every moment will have you singing, swaying, and cheering for more. This is not just a concert — it’s an unforgettable celebration of music that transcends generations."
      }
    ],
    "http://schema.org/keywords": [
      {
        "@language": "en",
        "@value": "Music, On Stage"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
