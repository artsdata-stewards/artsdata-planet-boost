      }
    ]
  },
  {
    "@id": "https://confederationcentre.com/event/pd-day-arts-camp/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "PD Day Arts Camp - Confederation Centre of the Arts"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Campers in our Performing Arts PD Day Camp will get a full range of our arts education offerings, receiving a unique opportunity to explore the arts through both hand-on and observational experiences. Our In the morning, our Visual Arts Educators will lead campers through a variety of art activities including (but not limited to) drawing, painting, sculpting, crafts and more. In the afternoon, they will hop on over to the dance studio where they will explore drama, music, and dance!"
      }
    ],
    "http://ogp.me/ns#url": [
