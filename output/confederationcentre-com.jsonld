    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Tournée humoristique Snowed In - Centre des arts de la Confédération"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "La tournée Snowed In Comedy est de retour — plus grandiose, plus audacieuse et plus drôle que jamais ! Ce qui a commencé il y a 17 ans comme une idée farfelue au cœur de l’hiver canadien est devenu un véritable phénomène national : la plus grande tournée humoristique du Canada. Cette année, les rires déferlent d’un océan à l’autre dans 70 villes, pour vous offrir un spectacle d’humour de calibre international."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr",
