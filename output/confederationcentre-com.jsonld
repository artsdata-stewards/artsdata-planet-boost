  {
    "@id": "http://www.confederationcentre.com/temporary/fba8ae77-12c0-4652-9637-57571ae19ade",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/image": [
      {
        "@id": "https://confederationcentre.com/wp-content/uploads/2025/12/STILL-STANDIN-2026.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-03-21T00:00:00+00:00"
      }
    ],
    "http://schema.org/endDate": [
