    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://confederationcentre.com/fr/event/the-wizard-of-oz/"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://confederationcentre.com/fr/event/the-wizard-of-oz/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Charlottetown Rural High School Presents: THE WIZARD OF OZ"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Follow the yellow brick road to a world of wonder as CRHS proudly presents The Wizard of Oz, a timeless musical that has enchanted audiences for generations. Based on L. Frank Baum’s beloved story, this year’s production transports audiences to the magical Land of Oz, filled with unforgettable characters, heartwarming lessons, and iconic musical moments. The adventure begins when Dorothy Gale, a spirited Kansas girl, is swept away by a cyclone and dropped into a dazzling world unlike anything she’s ever seen. Joined by her newfound friends: the Scarecrow, the Tin Man, and the Cowardly Lion, Dorothy sets out on a journey to the Emerald City hoping the Wizard can help her find her way home. Along the way, the group faces the Wicked Witch of the West and discovers what it truly means to have courage, heart, and a place to belong. The Royal Shakespeare Company’s adaptation brings this classic tale to life with vibrant staging and fresh creative energy, while remaining faithful to the beloved 1939 motion picture, owned by Turner Entertainment Co. and distributed by Warner Brothers. Families will delight in the familiar characters, memorable songs, and cinematic spirit that have made The Wizard of Oz a [&hellip;]"
      }
    ],
    "http://schema.org/keywords": [
      {
        "@language": "fr",
        "@value": "Music, On Stage, Theatre"
      }
    ],
