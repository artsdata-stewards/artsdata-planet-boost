  {
    "@id": "https://confederationcentre.com/fr/event/menofthedeeps26/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Les Hommes des Profondeurs - Circuit Diamant au Coucher du Soleil 2026 - Centre des Arts de la Confédération"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Une production d'Olive Street Entertainment. Les Men of the Deeps ont uni leurs voix pour la première fois en 1966, mais les amitiés et les épreuves qui les ont unis à leurs débuts sont nées dans les tunnels sous la côte du Cap-Breton. Des hommes forgés par la pression d'une vie souterraine, à l'abri des rayons du soleil. Aujourd'hui, l'industrie qui les a façonnés n'existe plus, et ils chantent, empreints de recueillement, de gratitude et d'une fierté discrète. Mais après le coucher du soleil naît l'aube, et leurs histoires et leurs chansons se transmettent, évoluent et trouvent toujours un nouveau départ.  "
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr",
        "@value": "https://confederationcentre.com/fr/event/menofthedeeps26/"
      }
    ],
