  {
    "@id": "https://confederationcentre.com/temporary/5b0c5113-8bb8-4f90-bfa6-2c46ba9a3675",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/image": [
      {
        "@id": "https://confederationcentre.com/wp-content/uploads/2025/07/PEISO_OnceUponAScore_.jpg"
      }
    ],
