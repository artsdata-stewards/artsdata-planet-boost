    "http://schema.org/url": [
      {
        "@id": "https://confederationcentre.com/fr/event/pd-day-arts-camp/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "PD Day Arts Camp"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Campers in our PD Day Arts Camp will get a full range of our arts education offerings, receiving a unique opportunity to explore the arts through both hand-on and observational experiences. In the morning, our Visual Arts Educators will lead campers through a variety of art activities including (but not limited to) drawing, painting, sculpting, crafts and more. In the afternoon, they will hop on over to the dance studio where they will explore drama, music, and dance! Alongside these activities campers may venture on a guided tour of the current gallery exhibitions, meet our Heritage Players, and more! Gallery and Theatre tours are subject to availability throughout the year depending on exhibition and performance schedules. (Early Drop off/Pick Up) 8:00am to 5:00pm &#8211; $75 per child (Regular Drop off/Pick Up) 8:45am to 4:00pm &#8211; $60 per child &nbsp; Upcoming PD Day Camp Dates April 10 Register Here"
      }
    ],
    "http://schema.org/keywords": [
      {
        "@language": "fr",
        "@value": "Arts Education, Camps"
      }
    ],
