      }
    ]
  },
  {
    "@id": "https://confederationcentre.com/fr/event/exploring-visual-arts-i/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
