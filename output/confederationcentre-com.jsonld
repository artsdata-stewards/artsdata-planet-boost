  {
    "@id": "https://confederationcentre.com/whats-on/anne-of-green-gables/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
