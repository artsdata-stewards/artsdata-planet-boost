    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Exploring Visual Arts for Adults - Confederation Centre of the Arts"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "No experience needed—just curiosity! In this relaxed, welcoming class, you’ll explore the basics of drawing, painting, and sculpture through hands-on projects and guided exercises. Each week introduces a new artistic concept, helping you build confidence and sharpen your visual skills in a fun, supportive environment. Activities will be supplemented by visits to the Confederation Centre Art Gallery, where students will explore a range of contemporary and historical artworks. This class is intended for students 18+. Registrants will be asked to confirm that they are at least 18 years of age Class Sessions: Feb 10 Feb 17 Feb 24 Mar 03 Mar 10 No class on March Break Mar 24 Mar 31 April 07 To register, click “Buy Tickets” For more information, please contact Andreas Fobes, Visual Arts Educator: afobes@confederationcentre.com  "
      }
    ],
