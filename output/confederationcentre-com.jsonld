    ]
  },
  {
    "@id": "https://confederationcentre.com/event/war-on-the-catwalk/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "War on the Catwalk - Confederation Centre of the Arts"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Murray & Peter present “WAR On The Catwalk”, hosted by drag superstar Alyssa Edwards. Featuring contestants who appeared on the Emmy-Award winning television show, RuPaul’s Drag Race on MTV and Canada’s Drag Race on Crave TV. Hosted by Alyssa Edwards (winner of RuPaul’s Drag Race Global All Stars 2024), the Canadian tour includes performances by Jewels Sparkles, Suzie Toot and Lexi from Drag Race Season 17, plus Bosco, Lydia B. Kollins and Daya Betty from All Stars Season 10.  All queens will perform in all 18 tour cities. All ages event. Parental discretion is advised.   Meet & Greet Ticket Details 6:00 PM meet & greet. Exclusive photo opportunity with the entire cast. Official tour clack fan A souvenir laminate with lanyard. Don’t miss this dazzling night of glamour, laughs, and unforgettable performances!"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
