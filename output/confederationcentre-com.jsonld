    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Circles of Song: A Confederation Singers Spring Concert"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "A COMPASSTECH LIVE AT THE CENTRE PRESENTATION The Confederation Singers present a Spring Concert centred around the natural cycles and seasons of our world. Through a wide range of musical influences both local and global, we investigate how this patient yet persistent movement can nurture a turn toward love and healing in the circles of our own lives. The artists we present during CompassTech LIVE @ the Centre are terrific performers. We are so confident you’ll enjoy these shows, we’re offering a Money-Back Guarantee for the 2026 LIVE at the Centre season. Try something new without the worry. See full Money-Back Guarantee terms for details."
      }
    ],
