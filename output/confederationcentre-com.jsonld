    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://confederationcentre.com/fr/event/exploring-visual-arts-for-adults-2026/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Exploring Visual Arts for Adults"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "No experience needed—just curiosity! In this relaxed, welcoming class, you&#8217;ll explore the basics of drawing, painting, and sculpture through hands-on projects and guided exercises. Each week introduces a new artistic concept, helping you build confidence and sharpen your visual skills in a fun, supportive environment. Activities will be supplemented by visits to the Confederation Centre Art Gallery, where students will explore a range of contemporary and historical artworks. This class is intended for students 18+. Registrants will be asked to confirm that they are at least 18 years of age Class Sessions: Feb 10 Feb 17 Feb 24 Mar 03 Mar 10 No class on March Break Mar 24 Mar 31 April 07 To register, click “Buy Tickets” For more information, please contact Andreas Fobes, Visual Arts Educator: afobes@confederationcentre.com &nbsp;"
      }
    ],
    "http://schema.org/keywords": [
      {
        "@language": "fr",
        "@value": "Art Gallery, Gallery Events"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
  {
    "@id": "https://confederationcentre.com/fr/event/winter-exhibition-opening-reception/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
