    "http://schema.org/url": [
      {
        "@id": "https://confederationcentre.com/event/exploring-visual-arts-ii/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Exploring Visual Arts Ages 9-12"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "In this eight-week class for young artists, students explore the elements of art through a series of drawing, painting, and sculpting activities. Through fun exercises and lessons, students will develop their visual literacy and technical abilities. Activities will be supplemented by gallery visits where students will explore a range of contemporary and historical artworks. To register, click “Buy Tickets” All Dates for 2026 Exploring Visual Arts II Spring Session: April 11, 2025 to May 30, 2026 Family Discount  A family discount is applied to two or more children from the same family attending the same session. Please note that family discounts for students in different class levels (Exploring Visual Arts I &amp; Exploring Visual Arts II) are not automatically applied; please contact us, and we will be happy to apply the discount for you.  For more information, please contact 902-628-6134 or artseducation@confederationcentre.com  Refunds are available for students up to two weeks before their program start. Students who must withdraw after this time must provide a medical note to receive a refund. "
      }
    ],
    "http://schema.org/keywords": [
      {
        "@language": "en",
        "@value": "Arts Education, Visual Arts"
      }
    ],
