      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Anne of Green Gables–The Musical™ (Sensory Friendly Performance)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "A Confederation Centre of the Arts Production Running Time: Act One 1h 10 | 20 Min Intermission | Act Two 50 Min As part of our ongoing commitment to accessibility, the Centre is offering a Sensory-Friendly Performance. This is a full, live performance featuring the complete cast and production, with thoughtful adjustments to help make the theatre environment more comfortable for those who may be sensory-sensitive, experience anxiety, or prefer a less intense theatrical setting. Sensory-friendly performances are designed to support a wide range of audience members, including those who are neurodivergent, pregnant individuals, nursing parents, seniors, people with service animals, and anyone who may benefit from reduced sensory stimulation. The performance itself remains unchanged; however, select environmental elements will be adjusted to reduce sensory impact. These modifications are intended to create a welcoming and inclusive experience without altering the artistic integrity of the show. &nbsp; Sensory-friendly adjustments: House lights remaining on at a low level throughout the performance Reduced overall sound levels Advance warnings or adjustments for sudden loud noises or rapid lighting effects Flexible seating, allowing patrons to enter or exit the theatre as needed Use of electronic devices permitted with sound turned off Audience members are welcome to move, stretch, [&hellip;]"
      }
    ],
    "http://schema.org/keywords": [
      {
        "@language": "en",
        "@value": "Dance, Music, On Stage, Theatre"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
  {
    "@id": "https://confederationcentre.com/event/fairytales-footlights-elem/",
    "http://ogp.me/ns#locale": [
