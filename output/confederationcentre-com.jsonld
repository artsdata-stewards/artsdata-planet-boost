    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Atelier d'improvisation pour adultes (6 semaines) - Centre des arts de la Confédération"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Rejoignez Cameron MacDonald, conteur et improvisateur chevronné (des Popalopalots), pour un atelier animé et hilarant, conçu pour les aînés ! Découvrez les joies de l'improvisation grâce à des jeux et des exercices de narration simples et captivants qui stimulent la créativité, renforcent la confiance et favorisent les liens – aucune expérience requise."
      }
    ],
    "http://ogp.me/ns#url": [
