    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://confederationcentre.com/fr/event/march-break-camp/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "March Break Camp"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Campers in our Performing/Visual Arts March Break Camp will get a full range of our arts education offerings, receiving a unique opportunity to explore the arts through both hand-on and observational experiences. In the morning, our Visual Arts Educators will lead campers through a variety of art activities including (but not limited to) drawing, painting, sculpting, crafts and more. In the afternoon, they will hop on over to the dance studio where they will explore drama, music, and dance! Alongside these activities campers may venture on a guided tour of the current gallery exhibitions, meet our Heritage Players, and more! Gallery and Theatre tours are subject to availability throughout the year depending on exhibition and performance schedules. March Break Camp Price &#8211; early drop off/pick up: $270 Regular: $230"
      }
    ],
    "http://schema.org/keywords": [
      {
        "@language": "fr",
        "@value": "Arts Education, Camps"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
  {
    "@id": "https://confederationcentre.com/fr/event/pd-day-vac/",
    "http://ogp.me/ns#locale": [
