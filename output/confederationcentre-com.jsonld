    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Journée pédagogique d'arts visuels - Centre des arts de la Confédération"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Les campeurs de notre camp de perfectionnement en arts visuels bénéficieront d'une gamme complète de formations artistiques et auront l'occasion unique d'explorer les arts par des expériences pratiques et d'observation. Le matin, nos éducateurs en arts visuels guideront les campeurs dans diverses activités artistiques, notamment le dessin, la peinture, la sculpture, les loisirs créatifs et bien plus encore. "
      }
    ],
    "http://ogp.me/ns#url": [
