    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Highland Dance Workshop - Confederation Centre of the Arts"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The class will focus on the oldest and most recognizable of the traditional Highland dances, the Highland Fling. This dance was historically a demonstration of skill and agility by warriors and performed on their shields! Today, the Highland Fling is performed as a solo dance, judged for its precision and poise.\""
      }
    ],
    "http://ogp.me/ns#url": [
