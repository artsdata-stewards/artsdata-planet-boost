    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Muses, Myths, and Mosaics: Dance Umbrella Year End Recital"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Confederation Centre’s dance umbrella program presents its annual year-end recital. This year’s showcase celebrates the imagination, passion, and hard work of our talented dancers of all ages and levels. Inspired by iconic figures from myth, history, and modern storytelling. The evening performance, titled Muses, Myths, and Mosaics, includes Elementary, Intermediate &amp; Senior levels in Musical Theatre levels; Intermediate, Senior &amp; ITP levels in Ballet, Jazz and Contemporary; all adult classes including Dance for Health; and our Performance Group. &nbsp; The artists we present during CompassTech LIVE @ the Centre are terrific performers. We are so confident you’ll enjoy these shows, we’re offering a Money-Back Guarantee for the 2026 LIVE at the Centre season. Try something new without the worry. See full Money-Back Guarantee terms for details."
      }
    ],
    "http://schema.org/keywords": [
      {
        "@language": "fr",
        "@value": "Dance, Live@TheCentre, On Stage, Theatre"
      }
    ],
