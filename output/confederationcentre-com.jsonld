    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Teen Improv 6-Week Class - Confederation Centre of the Arts"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Level up your social skills and your funny bone! This improv class is all about instant scenes, creating characters, and building self-confidence. The ultimate rule: there are no mistakes! Just bring your energy; we'll create the laughs together. Get ready to play and find out just how quick and creative you really are."
      }
    ],
    "http://ogp.me/ns#url": [
