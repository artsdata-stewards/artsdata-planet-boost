    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://confederationcentre.com/event/the-michael-jackson-history-show/"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://confederationcentre.com/event/the-michael-jackson-history-show/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Michael Jackson HIStory Show"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Johnny Showtime Presents The Michael Jackson HIStory Show – returning to Canada in 2026 to commemorate 30 years since Michael Jackson’s final, ground-breaking world tour: HISTORY.Celebrate Jackson’s creative genius and unsurpassed talent with riveting live performances covering his early days as a member of the Jackson 5, his groundbreaking theatrics in the 80s and his continued domination of Pop culture into the 21st century. See the famous music videos come to life, and hear all the hits performed live, including Thriller, Billie Jean, Smooth Criminal, Bad, Beat It, ABC, Don’t Stop Til You Get Enough, Human Nature, PYT, They Don’t Really Care About Us and many more. Garth Field is electrifying in his role as Jackson, accompanied by a live band, choreographed dancers, authentic costumes, state-of-the-art sound and theatrical lighting, vision and effects.  Truly a mind-blowing stage production – book now to secure your seats close to the action!  *This is a tribute show and is not associated with the Estate of Michael Jackson. &nbsp;"
      }
    ],
    "http://schema.org/keywords": [
      {
        "@language": "en",
        "@value": "Dance, Music, On Stage"
      }
    ],
