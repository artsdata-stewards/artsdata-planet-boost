    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Alex Mackenzie- Never Been Better Tour - Confederation Centre of the Arts"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Alex Mackenzie is taking the comedy world by storm, and his Never Been Better tour proves why. He gave up everything—his house, his job, even the respect of his family—to pursue stand-up, and he’s never looked back. After years of relentless hustle, that gamble is paying off."
      }
    ],
