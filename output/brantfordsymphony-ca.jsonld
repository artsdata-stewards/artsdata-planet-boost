    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Famous Overtures and Great Performers - Brantford Symphony Orchestra"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "The BSO presents a selection of favourite Overtures from the worlds of opera, operetta, ballet, oratorio, musicals, and the concert hall. You'll hear Overtures such as \"William Tell\", \"Swan Lake\", \"La Forza del Destino\", \"Messiah\" and more!"
      },
      {
        "@language": "en-ca",
        "@value": "The BSO presents a selection of favourite Overtures from the worlds of opera, operetta, ballet, oratorio, musicals, and the concert hall. You'll hear Overtures such as \"William Tell\", \"Swan Lake\", \"La Forza del Destino\", \"Messiah\" and more! For an extra bit of variety, the BSO's Harpist, Andrew Chan, will perform Vancouver composer Michael Conway Baker's"
      }
    ],
