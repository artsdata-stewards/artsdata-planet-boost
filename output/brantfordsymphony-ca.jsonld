      {
        "@language": "en-ca",
        "@value": "“When All Other Lights Go Out: Beethoven & Shore” with guest conductor Shawn Bennett - Brantford Symphony Orchestra"
      }
    ],
    "http://ogp.me/ns#url": [
      {
