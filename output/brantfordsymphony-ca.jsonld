  {
    "@id": "https://brantfordsymphony.ca/event/famous-overtures-and-great-performers/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-ca",
        "@value": "en_US"
      },
      {
        "@language": "en-ca",
