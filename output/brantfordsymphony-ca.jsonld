    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Three Amazing Performances | Three Stunning Locations\nGreat live music is set to take over Brantford on Sunday, October 20th, 2019.\n\nThe 3rd Annual Fall Music Crawl adds a thrilling live music component to the Brantford Symphony Orchestra's 2019 / 20 season. Spend the afternoon visiting three of Brantford's most stunning locations while enjoying a diverse and"
      }
