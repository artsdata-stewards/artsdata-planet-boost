      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://www.musicaintima.org/event-details/wait-list-cognitive-dissonance"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "musica intima"
      }
    ],
    "http://ogp.me/ns#type": [
