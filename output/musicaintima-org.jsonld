  {
    "@id": "https://www.musicaintima.org/event-details/confluence-2025-07-19-19-30",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "confluence | musica intima"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "<p>In an exciting departure from the traditional concert hall experience, and in partnership with Britannia Shipyards National Historical Site, Nikkei-Canadian, queer, trans non-binary, multi and interdisciplinary creator/performer Teiya Kasahara curates an interactive performance of music by composers and guest performers of various cultural backgrounds, leading the audience through the heritage buildings on the banks of the Fraser River.</p>"
      }
    ],
