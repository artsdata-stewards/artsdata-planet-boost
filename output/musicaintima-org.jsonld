    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Réjean Marois arranged the musical miniatures for vocal ensemble and trio—and we’ll perform his version of these haunting and beautiful pieces. Join musica intima to enter the space between jazz and classical music!"
      }
    ],
