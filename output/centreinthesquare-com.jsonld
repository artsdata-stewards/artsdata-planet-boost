    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "One night only. Honeymoon Suite 2025 Tour, don’t miss it!\nReturning to Centre In The Square!\nSeven studio albums, each with over 1 million copies sold.\nThe original band performing better than ever!\n\n&#8212;Ticket Info\n\nTicket prices\n\n\nBase\nWindow\nPhone/Online\n\n\n\n\n$39.50-$79.50\n$46.75-$88.75\n$51.25-"
