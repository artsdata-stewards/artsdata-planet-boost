    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Loreena McKennitt brings the 30th anniversary tour of her landmark album The Mask and The Mirror to Kitchener. Following a celebrated European festival run in 2024, this special Canadian tour stops in select cities across Eastern Canada, with Kitchener included on the itinerary.\nReleased in 1994, Th"
      }
