    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Find out why the tradition of a Bach masterwork on Good Friday has lasted more than 40 years!\n \nThe Mass in B Minor explores the full range of human emotion — from the sparkling joy of “Gloria,” through the sorrow of “Crucifixus,” to the serenity of “Dona Nobis Pacem.”\n \nFeaturing the Grand Philharm"
      }
