    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "FLEETWOOD MAGIC: The Authentic Tribute to Fleetwood Mac"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Fleetwood Magic Tribute Show masterfully transports audiences in sound and time through a musical journey performing Fleetwood Mac’s greatest hits from the 60’s to the 80’s, authentically recreating the sound, style and mystique of Fleetwood Mac’s most iconic line-up.&lt;/p&gt;\\n"
      }
    ],
