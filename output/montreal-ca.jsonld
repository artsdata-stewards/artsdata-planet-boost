      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>À travers cette œuvre audiovisuelle, la chorégraphe et interprète Nien Tzu Weng et la compositrice et artiste du numérique Myriam Bleau proposent de repenser l’écran comme un objet métamorphosé en interface tactile, en prothèse, en masque et en miroir.</p>"
      }
    ],
