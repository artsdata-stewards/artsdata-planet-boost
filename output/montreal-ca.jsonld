    "http://schema.org/name": [
      {
        "@value": "Sous les eaux - La Nef"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>La Nef présente un conte musical jeunesse avec vidéo sous-marine, inspiré de <em>Vingt mille lieues sous les mers</em> de Jules Verne. Un jeune garçon rêveur vivant sur une île explore l’univers sous-marin et rencontre des êtres énigmatiques inoubliables.</p>"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
