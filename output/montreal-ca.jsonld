    "http://schema.org/description": [
      {
        "@value": "<p>Alliant chanson, théâtre et vidéo, cette œuvre à la fois intime et foisonnante traite de la mort, de l’enfance, de l’amour et du deuil, éclairée par une lumière remarquable.</p>"
      }
