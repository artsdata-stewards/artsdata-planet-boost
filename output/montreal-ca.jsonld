    "http://schema.org/name": [
      {
        "@value": "Briell - Myriam Sutton"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Cette pièce explore le thème de la relation entre la tête et le cœur de manière absurde et humoristique. Au fil de ce voyage métaphorique, Briell nous transporte dans un monde poétique où la persévérance, l’écoute de soi et la recherche du bonheur seront abordées de manière ludique.</p>"
      }
    ],
