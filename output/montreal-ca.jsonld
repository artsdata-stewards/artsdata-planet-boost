    "http://schema.org/name": [
      {
        "@value": "Cabaret Noir - Mayday"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Du baiser d’Othello aux monologues des films de Spike Lee, les interprètes de<em> Cabaret noir</em> s’amusent à bricoler des reconstitutions de scènes emblématiques du théâtre, du cinéma et de la télévision. Ils touchent au détour aux représentations manichéennes du racisme dans l’imaginaire populaire.</p>"
      }
    ],
