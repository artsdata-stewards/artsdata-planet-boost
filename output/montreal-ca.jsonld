    "http://schema.org/name": [
      {
        "@value": "Découper le paysage - Ariane Valade"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Artiste verdunoise, Ariane Valade explore les liens entre arts textiles et imprimés à travers une démarche féministe et expérimentale. Ses œuvres hybrides interrogent la mémoire, la vulnérabilité et les enjeux environnementaux.</p>"
      }
    ],
