    "http://schema.org/description": [
      {
        "@value": "<p><strong>Concert à la visitation</strong></p><p>Chant pour sopranos et clavecin&nbsp;</p><p>Avec <em>Un amour fou,</em> l&#8217;Ensemble Mirabilia vous invitent à un voyage musical entre baroque et modernité. Des œuvres réunies par un thème intemporel&nbsp;: l’amour, dans toutes ses nuances et couleurs.</p>"
      }
    ],
