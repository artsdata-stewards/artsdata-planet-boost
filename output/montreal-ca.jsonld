      {
        "@value": "Ella - L'histoire de Cendrillon - Ballet Ouest"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Dans cette interprétation du conte de Charles Perrault, Ella, vivant avec une famille injuste et oppressive, rêve d&#8217;échapper à sa vie quotidienne sordide. Jusqu&#8217;à ce qu’un jour, sa chance change et sa gentillesse pour tout ce qui l’entoure se trouve récompensée.</p>"
      }
    ],
