      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Exposition citoyenne de peinture et d'aquarelle"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Cette exposition présente les œuvres réalisées dans l’atelier libre d’aquarelle et le cours de peinture. Une occasion de découvrir le talent de nos artistes locaux et d’échanger avec eux lors du vernissage. Venez admirer leurs créations et célébrer la créativité de notre communauté.</p>"
      }
    ],
