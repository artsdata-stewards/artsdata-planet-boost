    "http://schema.org/description": [
      {
        "@value": "<p>Étoile montante du jazz vocal et récipiendaire de deux prix Juno, Dominique Fils-Aimé est une auteure-compositrice-interprète montréalaise accordant une place fondamentale à la culture musicale afro-américaine au sein de son travail.</p>"
      }
