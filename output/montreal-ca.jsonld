    "http://schema.org/description": [
      {
        "@value": "<p>Cette exposition s&#8217;inscrit au sein de <em>Racine</em> qui est un projet collaboratif du réseau des Maisons de la culture de la Ville de Montréal. Il vise la promotion des valeurs de transmission à travers des projets artistiques qui ancrent l’expérience de l’art social au sein des communautés.</p>"
      }
