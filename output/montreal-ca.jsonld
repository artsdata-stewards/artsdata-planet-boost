    "twitter:description": [
      {
        "@language": "fr",
        "@value": "Visitez l'exposition d'Eugenia Reznik du 8 novembre au 21 décembre 2025 à la maison de la culture Maisonneuve à l'arrondissement de MHM."
      },
      {
        "@language": "fr",
        "@value": "Bd de quartier, exposition"
      },
      {
        "@language": "fr",
        "@value": "Découvrez cette exposition de bandes dessinées à l’image des quartiers."
      },
      {
        "@language": "fr",
        "@value": "Exposition Camille Lescarbeau arts visuels déchets écologie"
      },
      {
        "@language": "fr",
        "@value": "La nature en ville recèle bien des secrets. Les récits du Théâtre du Renard combinent art et science pour enchanter votre prochaine balade!"
      },
      {
        "@language": "fr",
        "@value": "Verdun, Quai 5160, Exposition, Chloé Beaulac, Photographie"
