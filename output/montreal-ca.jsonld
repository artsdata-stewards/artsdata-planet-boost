    "http://schema.org/description": [
      {
        "@value": "<p>Entre clown, marionnette et cirque, Kiki nous entraîne dans un voyage émouvant au cœur des émotions et de la communication bienveillante. Un moment ludique pour apprendre à mieux se comprendre.</p>"
      }
    ],
