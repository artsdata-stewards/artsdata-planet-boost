    "http://schema.org/description": [
      {
        "@value": "<p>Découvrez le travail de Romane Garant Chartrand, cinéaste de la relève. Ses courts métrages documentaires à l’approche intimiste donnent la parole à des femmes inspirantes et ouvrent le dialogue sur des enjeux sociaux actuels.</p>"
      }
