      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Par le montage anachronique de ses sculptures, Louis Bouvier propose des rendez-vous entre l’ancien et le nouveau, entre artéfacts du passé et formes du présent, reliant ainsi l’héritage et la tradition à certains enjeux contemporains.</p>"
      }
    ],
