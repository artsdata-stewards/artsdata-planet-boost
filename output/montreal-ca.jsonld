    "http://schema.org/description": [
      {
        "@value": "<p>Une invitation à un véritable voyage musical avec l&#8217;équipe de professeures et professeurs du programme <em>La Musique aux enfants</em>. Du baroque à la musique de film, en passant par l’un des joyaux du répertoire romantique&nbsp;: vous verrez et entendrez du violon, de l’alto, de la flûte et du violoncelle.</p>"
      }
