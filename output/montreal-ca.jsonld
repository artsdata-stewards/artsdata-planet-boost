      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Découvrez <em>Sikutsajaq </em>l&#8217;exposition solo de <strong>Mary Paningajak</strong> du 15 janvier au 8 mars 2026 qui vous plonge dans la culture inuite, sa vie et sa communauté et propose une véritable immersion dans un univers empreint d’identité, de mémoire et de création.</p>"
      }
    ],
