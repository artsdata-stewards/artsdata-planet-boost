        "@language": "fr",
        "@value": "La maison de la culture Saint-Laurent présente Tony vend des billets du Collectif Tôle le 26 novembre à 19 h 30 à la Salle Émile-Legault"
      },
      {
        "@language": "fr",
        "@value": "La maison de la culture Saint-Laurent présente le film Le dernier repas de Maryse Legagneur le 4 novembre à 19h30 à la Salle Émile-Legault"
      },
      {
        "@language": "fr",
        "@value": "La maison de la culture Saint-Laurent présente le film Aladdin du réalisateur Guy Ritchie le 30 novembre à 10 h au Centre des loisirs."
      },
      {
        "@language": "fr",
        "@value": "La maison de la culture Saint-Laurent présente The One(s) Who never Lived de Compagnie Entitey le 21 novembre à 19 h 30 à la Salle Émile-Legault"
      },
      {
        "@language": "fr",
        "@value": "La maison de la culture Saint-Laurent présente Les mini-manifestes du Théâtre Fêlé le 23 novembre à 10 h 30 au Centre des loisirs."
      },
      {
        "@language": "fr",
        "@value": "La maison de la culture Saint-Laurent présente Glob de la compagnie Les Foutoukours le 8 novembre à 19 h à la Salle Émile-Legault"
      },
      {
        "@language": "fr",
        "@value": "La maison de la culture Saint-Laurent présente L'aéronaute de François Jalbert et Jérôme Beaulieu le 26 novembre à 19 h 30 à la Salle Émile-Legault"
      }
