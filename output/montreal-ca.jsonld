    "http://schema.org/name": [
      {
        "@value": "Harmonie et dualité - une exploration artistique de l'univers"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Avec <strong>Harmonie et Dualité</strong>, Laurent Bouchard nous ouvre un dialogue entre géométrie et abstraction, où cercles, triangles et carrés deviennent des fragments d’infini. Chaque œuvre, portée par des couleurs maîtrisées ou spontanées, invite à contempler le mystère et explorer nos propres interprétations.</p>"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
