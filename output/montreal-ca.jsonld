      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Ce concert réunit des musiciens d’exception autour d&#8217;un dialogue musical novateur, mêlant les traditions musicales de l’Iran, de la Turquie et de l’Inde, à travers des compositions et arrangements originaux.</p>"
      }
    ],
