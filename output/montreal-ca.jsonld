    "http://schema.org/name": [
      {
        "@value": "Le voyage d'Aëll - Charly Mullot"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Une jeune fille fugue en voilier pour échapper à la dureté et à l’indifférence de son environnement familial. En naviguant, elle rencontre un berceur de baleine, un couple de reines heureuses et amoureuses, un peu de solitude, et même une tortue bleue.</p>"
      }
    ],
    "http://schema.org/startDate": [
