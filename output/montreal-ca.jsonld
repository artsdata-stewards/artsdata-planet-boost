      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Cette pièce, mise en scène par Marc-André Thibault, met en valeur 2 comédiens de talent qui se donnent la réplique, racontant une tranche de vie universelle qui fait rire, touche et fait réfléchir.</p>"
      }
    ],
