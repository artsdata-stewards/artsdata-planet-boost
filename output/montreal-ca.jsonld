    "http://schema.org/name": [
      {
        "@value": "Ernest Cole, photographe - Raoul Peck"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Ernest Cole, photographe sud-africain, a été le premier à exposer au monde entier les horreurs de l’apartheid. Son livre HOUSE OF BONDAGE, publié en 1967 alors qu’il n’avait que 27 ans, l’a conduit à s’exiler à New York et en Europe pour le reste de sa vie, sans jamais retrouver ses repères.</p>"
      }
    ],
