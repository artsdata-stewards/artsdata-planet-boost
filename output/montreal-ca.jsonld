      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Exposition - Chloé Beaulac | La percée d'une fenêtre miroir"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Cette exposition réunit deux séries où Chloé Beaulac explore la frontière subtile entre réel et imaginaire. Par la transformation d’images et d’objets trouvés, elle crée des compositions énigmatiques qui invitent à réfléchir au lien entre regard, mémoire et nature.</p>"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-03-25T12:00:00-04:00"
      }
