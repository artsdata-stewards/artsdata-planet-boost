      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Quand tu vois un fauteuil roulant, à quoi penses-tu? Trois interprètes tout-terrain y voient un bolide épatant aux possibilités de jeu infinies, lequel, comme eux, peut tournoyer, danser, se transformer…</p>"
      }
