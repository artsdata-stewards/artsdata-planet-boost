      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Ce film qui allie fiction et documentaire raconte l&#8217;histoire de 2 renards arctiques qui verront leur mode de vie affecté par les changements climatiques. C&#8217;est ainsi que débute leur aventure pour retrouver leur maison.</p>"
      }
