    "http://schema.org/name": [
      {
        "@value": "Sergiu Popa & Tehrani Drom"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p><strong>Concert au bout du monde</strong></p><p>Avec Tehrani Drom, embarquez pour un voyage sonore rare où traditions persanes oubliées, poésie mystique et voix féminine se rencontrent. Une célébration des cultures kurde, azérie et rom, portée par des musiciens d’exception.</p>"
      }
    ],
