    "http://schema.org/name": [
      {
        "@value": "Émeraude et le Monarque - Les Petites Géantes"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Émeraude s’ennuie: « Ici à la campagne j’ai pas d’amis avec qui jouer&#8230;». Sa Mémé a beau l&#8217;inviter à tricoter, à aller jouer dehors, Émeraude s’ennuie. Jusqu’à ce qu’elle rencontre un papillon extraordinaire. Vite, elle le met dans un pot pour le garder près d’elle. Est-ce une bonne idée&nbsp;?</p>"
      }
    ],
    "http://schema.org/startDate": [
