    "http://schema.org/name": [
      {
        "@value": "L'amour te reviendra - Collectif Ausgang"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Béa est une fillette minuscule qui habite seule dans une vieille bouilloire au milieu de la forêt. Elle cherche des amis parmi les créatures qui l’entourent. Son monde est bouleversé quand elle découvre un œuf dans le nid d&#8217;une mésange et qu&#8217;elle décide de le voler.</p>"
      }
    ],
