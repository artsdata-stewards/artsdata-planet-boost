    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Activité de lecture pour les enfants de 0 à 5 ans accompagnés par un adulte pour faciliter leur participation. De belles histoires à écouter en compagnie de notre animatrice Audrey et de Kilitou la marionnette, dans l’ambiance décontractée de notre salle d’animation.</p>"
      }
