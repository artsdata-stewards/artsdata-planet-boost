      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Bienvenue dans l’univers enchanté du Coin des Fêtes&nbsp;! Venez célébrer la magie des fêtes lors d&#8217;une fin de semaine d’activités gratuites pour toute la famille à l’arrondissement de Côte-des-Neiges–Notre-Dame-de-Grâce. Vivez des moments féeriques et plongez tête première dans l’esprit des fêtes.</p>"
      }
