    "http://schema.org/name": [
      {
        "@value": "Château Grafeneck 1940 - Trio Grafeneck 10654"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Ce concert raconte l&#8217;histoire du château Grafeneck en Allemagne, un lieu de haute culture à la Renaissance, mais un lieu d&#8217;horreur durant la Seconde Guerre mondiale. En 1940, 10&nbsp;654 personnes handicapées y ont été tuées par les nazis dans la première chambre à gaz de type industriel de l’histoire.</p>"
      }
    ],
    "http://schema.org/startDate": [
