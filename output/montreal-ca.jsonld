      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Trois musiciennes hors pair unissent chacune leur voix pour créer, émouvoir et raconter des histoires. La musique traditionnelle est ici dynamisée, actualisée et nourrie par l’influence du jazz, de l’improvisation et de la composition.</p>"
      }
    ],
