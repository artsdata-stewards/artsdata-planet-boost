    "http://schema.org/description": [
      {
        "@value": "<p>Un quintette de danseurs sur un tapis roulant explorent les limites entre contrôle et abandon. Leurs corps en mouvement constant révèlent la multitude de sentiments et de sensations qui rendent l’existence complexe.</p>"
      }
