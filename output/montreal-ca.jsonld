    "http://schema.org/description": [
      {
        "@value": "<p>Chant pour sopranos et clavecin&nbsp;</p><p>Avec UN AMOUR FOU – Ensemble Mirabilia vous invitent à un voyage musical entre baroque et modernité. Des œuvres réunies par un thème intemporel&nbsp;: l’amour, dans toutes ses nuances et couleurs.</p>"
      }
