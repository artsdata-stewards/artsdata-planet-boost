      {
        "@value": "Disgraceland - Les Tables Tournantes"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Graceland est le nom de la demeure d&#8217;Elvis Presley. Cette pièce propose de traverser les murs de ce lieu mythique pour revisiter le décès du King, représenté par une marionnette de taille humaine et animée par 4 marionnettistes se faisant passer pour les domestiques de la maison.</p>"
      }
    ],
