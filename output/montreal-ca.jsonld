      {
        "@value": "176 pas - Théâtre de l'Œil"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Octave joue merveilleusement bien du piano, mais se sent si paralysé par la peur de l&#8217;inconnu qu&#8217;il ne sort presque jamais du somptueux domaine où il vit. Pour Delphine, c&#8217;est tout l&#8217;inverse&nbsp;: elle nage, pêche et travaille pour ses parents poissonniers.</p>"
      }
    ],
