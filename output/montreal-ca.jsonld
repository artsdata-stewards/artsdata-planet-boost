    "http://schema.org/description": [
      {
        "@value": "<p>Ce&nbsp;projet chorégraphique réflexif et festif, issu d’un dialogue fécond entre le flamenco et la gigue québécoise, rassemble sur scène huit danseurs, danseuses et musiciens chevronnés.</p>"
      }
