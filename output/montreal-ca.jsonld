    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Christine Tassan et les Imposteures invitent le public à les suivre sur la route de leurs nombreuses tournées, faisant rayonner jazz manouche et chansons swing à travers des paysages grandioses et des anecdotes savoureuses.</p>"
      }
    ],
