    "http://schema.org/name": [
      {
        "@value": "La floraison des souvenirs - Théâtre de la flamme"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Sophie reçoit une correspondance à laquelle elle ne s’attendait pas&nbsp;: son père, qu’elle n’a jamais connu, souhaite faire sa rencontre. Elle replonge alors dans son passé pour se rappeler ses souvenirs d’enfance oubliés et se retrouve face à l’enfant timide, passionnée d’astronomie, qu’elle était.</p>"
      }
    ],
    "http://schema.org/startDate": [
