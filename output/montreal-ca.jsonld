      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Un quatuor unique pour un voyage musical inédit&nbsp;: entre poésie chantée, rythmes sud-américains et percussions indiennes, laissez-vous emporter par la rencontre vibrante de cultures et d’improvisations sensibles.</p>"
      }
