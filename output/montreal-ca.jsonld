    "http://schema.org/name": [
      {
        "@value": "Obvious, hackers de l’art - Thibaut Sève"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Octobre 2018. La maison Christie’s adjuge pour 432&nbsp;500&nbsp;$ une œuvre créée par le collectif français Les Obvious, en collaboration avec l’intelligence artificielle. Ce film dévoile, à travers leur carrière, les coulisses d’une révolution silencieuse qui secoue les fondements de la création artistique.</p>"
      }
    ],
