    "http://schema.org/name": [
      {
        "@value": "CONCERT À LA VISITATION | Dernier Noël - Quartom"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Un dernier Noël tout en voix et en émotions.<br>Avec élégance et humour, le quatuor vocal Quartom revisite les grands classiques des fêtes dans des arrangements somptueux signés Simon Leclerc. À cappella, entre musique classique et populaire, ils offrent un après-midi chaleureux et mémorable.</p>"
      }
    ],
