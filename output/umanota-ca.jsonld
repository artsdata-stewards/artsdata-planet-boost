    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Coming up on Friday November 11 at BSMT 254, a night of music, dance and celebration in the heart of Scorpio season with:  Bruxula (Cosmic JD + Jer) Destiny (Montreal) Musa Tender Buttons  Come dance with birthday girl Kristyn!  $15 at the door Lots of special treats!  Funded in part by Ontario Crea"
      }
