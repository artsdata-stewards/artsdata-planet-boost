    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Uma Nota Culture presents Son Rompe Pera, the marimba-smashing band of brothers from Naucalpan, Mexico, who have single-handedly defined the genre ‘Cumbia Punk’ and captivated audiences around the world.  The band’s manifesto, “Cumbia Is The New Punk” declares their devotion to and reverence for the"
      }
