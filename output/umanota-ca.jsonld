    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Live performance by Toronto's own Sérgio Xocolate &amp; Casa de Marimbondo!  Pernambuco punk with roots in traditional Afro-Brazilian and Indigenous rhythms, manifests as explosive rock, captivating and experiential performance art!  Doors at 10pm  $10 at the door!   More info on facebook!"
      }
    ],
