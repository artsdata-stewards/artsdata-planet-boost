    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Did I hear Samba?  Yes, there will be samba!!!  With a special Toronto edition celebrating 15 years of Dance Migration!  Terreiro do Samba is returning to Toronto, at Lula Lounge, on Sunday, May 15th, at 5 pm.  After successful editions in Montreal and Ottawa, we're back!  With music by:  Roda de Sa"
      }
