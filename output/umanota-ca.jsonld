    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Pioneering Afro-Peruvian sound system Novalima returns to Lula as part of their 2019 North American tour. Started by four friends from Lima with a shared passion for traditional Afro-Peruvian music and global DJ culture, Novalima stands in the common ground bridging past and future, uniting traditio"
      }
