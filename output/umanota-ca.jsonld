    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "WE’RE BACK BABY! Uma Nota is bringing an icy twist to our regular programming and producing our first ever Geary Winter Fest  Join us Feb 18 + 19 for a weekend filled with FREE live music performances, art installations, pop ups, food + drinks, and more!  Stay tuned for the full lineup and schedule"
      }
