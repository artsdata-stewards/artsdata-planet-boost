    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "The show features original compositions by both Cissoko and Tabassian, and revisits pieces from the old Mandinkan and Persian traditions."
      },
      {
        "@language": "en-ca",
        "@value": "The musicians of Constantinople, together with Ablaye Cissoko, a griot from Saint-Louis in Senegal, have been wowing"
      }
