    "http://schema.org/image": [
      {
        "@language": "fr",
        "@value": "https://constantinople.ca/wp-content/uploads/2021/01/il-ponte-3-juan-manuel-lobaton-web.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "fr",
        "@value": "2026-6-21T19:00-4:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "fr",
        "@value": "2026-6-21T23:59-4:00"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Fleeting Beauties"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\n                Dans le cadre du Festival de Musique d’Istanbul, Constantinople investit l’un des lieux les plus chargés d’histoire de la ville : le Grand Bazar. Carrefour des routes commerciales depuis des siècles, cet espace emblématique accueille le concert « Fleeting Beauties » — une invitation à vivre la musique comme une rencontre fugace et précieuse entre différentes époques et géographies.\nAu programme, des musiques allant de la Renaissance italienne aux répertoires ottoman et iranien, réunies le temps d’un soir pour révéler la beauté fragile de chaque instant musical. Aux côtés du contre-ténor Marco Beasley, Constantinople explore cette pluralité vivante où chaque œuvre n’existe pleinement que dans le moment de son interprétation.\nUn concert unique, au cœur d’un lieu unique.\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
