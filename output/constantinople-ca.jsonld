      },
      {
        "@language": "fr-ca",
        "@value": "Traversées"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Cette rencontre et ce dialogue entre la kora et le sétar semblaient sortir des entrailles de la terre, comme si ces instruments, aux côtés de la viole de gambe et des percussions, avaient toujours coexisté."
      },
      {
        "@language": "fr-ca",
        "@value": "Cette rencontre et ce dialogue entre la kora et le sétar semblaient sortir des entrailles de la terre,"
      }
    ],
