    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "TRAVERSÉES - Constantinople"
      },
      {
        "@language": "fr-ca",
        "@value": "TRAVERSÉES"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Souffles, concert qui dessine un chemin musical à travers les chants et les musiques autochtones Mi’kmaq, Khöömei de Touva, d’Iran, mais surtout à travers la nature et comment elle nous habite."
      },
      {
        "@language": "fr-ca",
        "@value": "Les musiciens de l’ensemble Constantinople et Ablaye Cissoko, griot de Saint-Louis au Sénégal, sillonnent les scènes du monde depuis 2012."
      }
    ],
    "http://ogp.me/ns#url": [
