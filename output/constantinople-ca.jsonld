  {
    "@id": "https://constantinople.ca/events/entre-byzance-et-la-perse-un-chant/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "article"
      },
      {
        "@language": "fr-ca",
        "@value": "event"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Entre Byzance et la Perse, un chant...  - Constantinople"
      },
      {
        "@language": "fr-ca",
        "@value": "Entre Byzance et la Perse, un chant... "
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Les ensembles Constantinople et En Chordais sont de nouveau réunis pour présenter une création basée sur leurs plus récentes trouvailles dans les manuscrits anciens."
      },
