    "http://schema.org/image": [
      {
        "@language": "fr",
        "@value": "https://constantinople.ca/wp-content/uploads/2020/10/2021.08.05.-souffles_cp-george-berte-21-copie.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "fr",
        "@value": "2025-2-22T20:00-4:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "fr",
        "@value": "2025-2-22T22:00-4:00"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Souffles"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\n                Ce programme propose la rencontre de trois captivantes traditions musicales profondément enracinées dans l’essence du souffle, de la force vitale qui relie toutes les cultures et tous les peuples.\nLes chants et tambours mi’kmaq, et les sons profonds et évocateurs des musiciens de Constantinople se retrouvent dans ce concert qui célèbre le pouvoir de la respiration dans la musique. Les sons de la nature sont portés par une grande héritière de traditions autochtones vivantes, Darlene Gijuminag. \n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
