    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "This meeting and dialogue between the kora and the setar seemed to come from the depths of the earthalong, with the viola da gamba and percussion."
      },
      {
        "@language": "en-ca",
        "@value": "Five years ago, we embarked upon the creation of our first concert and album, which we named our Itinerant Gardens."
      }
    ],
