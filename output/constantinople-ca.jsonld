    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Across the Andes"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n                This concert revisits Andean and South American music through 17th– and 18th-century manuscripts, including Codice Trujillo and Codice Luz y Norte. Some popular oral traditions are added to the above sources to enrich the musical repertoire, in the image of these bright and colorful people.\nThis project is supported financially by the Conseil des Arts et des Lettres du Québec, the Conseil des Arts du Canada, and the Asociación ZINIA in Peru.\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
