    "http://schema.org/image": [
      {
        "@language": "fr",
        "@value": "https://constantinople.ca/wp-content/uploads/2023/03/constantinople_3gary-payne-copie.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "fr",
        "@value": "2024-3-14T20:00-4:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "fr",
        "@value": "2024-3-14T23:50-4:00"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Tres Culturas"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\n                Dans cette nouvelle création, les membres de l’ensemble Constantinople sont accompagnés par la soprane Ángeles Núñez pour interpréter des œuvres séfarades et médiévales en dialogue avec la musique contemporaine. Le projet OCNOS, acteur dynamique de la musique contemporaine en Espagne, contribue à cette aventure créative. Tres Culturas inclut également la première du Cancionero du compositeur sévillan Alberto Carretero.\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
