    "http://schema.org/image": [
      {
        "@language": "fr",
        "@value": "https://constantinople.ca/wp-content/uploads/2023/05/constantinople_cantemirconstantinople.png"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "fr",
        "@value": "2024-4-20T20:00-4:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "fr",
        "@value": "2024-4-20T23:59-4:00"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Cantemir, Le Prince Compositeur"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\n                Passeur d’histoires, l’ensemble Constantinople se consacre ici à l’œuvre de Dimitrie Cantemir, une figure emblématique qui fit le pont entre la culture européenne et celle du Moyen-Orient à l’orée du XVIIIe siècle. Cantemir n’était pas seulement un prince et un érudit, mais aussi un compositeur et un diplomate de grand renom, dont le talent a traversé les frontières et les siècles. Ses compositions sont des joyaux de la musique ottomane, reflétant la richesse et la diversité de cet empire à son apogée. L’ensemble Constantinople, sous la direction artistique de Kiya Tabassian, interprétera les compositions de Cantemir et de ses contemporains, tels le Français Marin Marais et l’Italien Antonio Bertali.\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
