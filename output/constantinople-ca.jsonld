    "http://schema.org/image": [
      {
        "@language": "fr",
        "@value": "https://constantinople.ca/wp-content/uploads/2026/03/khayyam_oukalthoumjefberhin_halo-1.png"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "fr",
        "@value": "2026-7-3T19:00-4:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "fr",
        "@value": "2026-7-3T23:59-4:00"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Khayyam & Oum Kalthoum"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\n                Kiya Tabassian et son ensemble Constantinople présentent une relecture contemporaine des Rubaiyat, le célèbre recueil de poèmes du poète, astronome et mathématicien persan Omar Khayyam. En collaboration avec la chanteuse Ghalia Benali, ils rendent hommage à l’héritage d’Oum Kalthoum, icône de la musique du Moyen-Orient, en revisitant les compositions de Riad Al Sunbati qui ont marqué l’interprétation musicale de ces quatrains. À travers de nouveaux arrangements et des compositions originales de Tabassian, ce projet fait dialoguer la poésie soufie millénaire avec les sonorités d’aujourd’hui, dans un pont vibrant entre traditions arabes et persanes.\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
