  {
    "@id": "https://constantinople.ca/events/lodyssee-de-krystof-harant-2/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
    ],
    "http://ogp.me/ns#locale:alternate": [
      {
        "@language": "fr-ca",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "article"
      },
      {
        "@language": "fr-ca",
        "@value": "event"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "L'odyssée de Krystof Harant - Constantinople"
      },
      {
        "@language": "fr-ca",
        "@value": "L'odyssée de Krystof Harant"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Un périple musical dans l’univers du compositeur tchèque Kryštof Harant (1564-1621), et ses carnets de voyage décrivant en détail ses odyssées, depuis Prague vers Jérusalem, en passant par Venise, Chypre, Sinai et Caire."
      },
