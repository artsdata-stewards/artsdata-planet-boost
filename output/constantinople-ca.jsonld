    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Kiya Tabassian and Patrick Graham duo - Constantinople"
      },
      {
        "@language": "en-ca",
        "@value": "Kiya Tabassian and Patrick Graham duo"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "The musicians of Constantinople, together with Ablaye Cissoko, a griot from Saint-Louis in Senegal, have been wowing audiences around the world since 2012. Traversées is the fruit of dialogue and exemplary collaboration between two artists. The concert features original compositions by both Cissoko and Tabassian, and revisits pieces from the old Mandinkan and Persian traditions."
      },
      {
        "@language": "en-ca",
        "@value": "THIS CONCERT, INITIALLY PLANNED AS A TRIO, WILL BE A SETAR / PERCUSSIONS DUO WITH KIYA TABASSIAN AND PATRICK GRAHAM."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
