      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Khayyam &amp; Oum Kalthoum | SOLD OUT!"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Iranian musician Kiya Tabassian and his ensemble Constantinople present a contemporary reinterpretation of the <em data-start='111' data-end='121'>Rubaiyat</em>, the renowned collection of poems by Persian poet, astronomer, and mathematician Omar Khayyam. In collaboration with singer Ghalia Benali, they pay tribute to the legacy of Umm Kulthum, the iconic voice of Middle Eastern music, by revisiting the compositions of Riad Al Sunbati that brought these quatrains to life. Through new arrangements and original compositions by Tabassian, the project creates a vibrant dialogue between centuries-old Sufi poetry and the sounds of today, bridging Arab and Persian musical traditions.</p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-12-13T20:00-4::00"
      }
