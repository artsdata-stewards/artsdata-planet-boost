    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n                This meeting and dialogue between the kora and the setar seemed to come from the depths of the earth, as though these instruments, along with the viola da gamba and percussion, had always existed side by side.\n            "
      }
    ],
