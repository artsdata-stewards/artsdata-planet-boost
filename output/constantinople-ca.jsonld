    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "CANCELLED // In the Footsteps of Rumi - Constantinople"
      },
      {
        "@language": "en-ca",
        "@value": "CANCELLED // In the Footsteps of Rumi"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Rhythms, dances, songs of love and lament, divine mysticism and wonder are omnipresent in the Arabic & Farsi verses of Rumi."
      },
      {
        "@language": "en-ca",
        "@value": "This performance takes us on a journey into the shimmering world of the timeless poems of Rumi, the great Master"
      }
    ],
