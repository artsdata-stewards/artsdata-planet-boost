    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Ciel de l'Iran COMPLET - Constantinople"
      },
      {
        "@language": "fr-ca",
        "@value": "Ciel de l'Iran COMPLET"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Deux libres penseurs et explorateurs des musiques, Kalhor et Tabassian invitent les auditeurs aux confluents de leurs univers créatifs, pour un voyage musical passionnant au cœur de leur art, aux racines persanes."
      },
      {
        "@language": "fr-ca",
        "@value": "De la lueur du jour au crépitement du crépuscule, la musique règne parmi les astres de la civilisation"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
