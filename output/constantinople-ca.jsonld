      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "L'Odyssée de Krystof Harant"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\n                Un périple musical dans l’univers du compositeur tchèque Kryštof Harant (1564-1621), et ses carnets de voyage décrivant en détail ses odyssées, depuis Prague vers Jérusalem, en passant par Venise, Chypre, Sinai et Caire. L’ensemble vocal de renommée internationale, Cappella Mariana et l’ensemble Constantinople unissent leurs voix pour revisiter la musique de Harant et les musiques qu’il aurait entendues lors de son fabuleux périple au XVIIe siècle.\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
