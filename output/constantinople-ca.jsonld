        "@language": "en-ca",
        "@value": "article"
      },
      {
        "@language": "en-ca",
        "@value": "event"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "TRAVERSÉES - Constantinople"
      },
      {
        "@language": "en-ca",
        "@value": "TRAVERSÉES"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Breathings is a celebration of our intimate relationship with nature, a concert that places the breath at the centre of the musical act. The pulsing of a heartbeat and the human voice in all its forms are breath-related phenomena that will serve to guide Constantinople’s musicians and their guests from indigenous communities from both here and abroad in this new creation."
      },
      {
        "@language": "en-ca",
        "@value": "The musicians of Constantinople, together with Ablaye Cissoko, a griot from Saint-Louis in Senegal, have been wowing audiences around the world since"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
        "@value": "https://constantinople.ca/en/events/traversees-122/"
      }
    ],
