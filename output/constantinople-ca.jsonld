      },
      {
        "@language": "fr-ca",
        "@value": "Lumières Nordiques"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Benedicte Maurseth, virtuose et ambassadrice de la vièle Hardanger, se joint à Constantinople pour créer une musique fortement influencée par la nature et les paysages vastes du Nord."
      },
      {
        "@language": "fr-ca",
        "@value": "Cette collaboration émane d’un intérêt profond pour l’exploration des sonorités et des gestes musicaux des musiques nordiques. Benedicte Maurseth, virtuose"
      }
    ],
