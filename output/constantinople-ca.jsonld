    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Tres Culturas"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p class='p1'>Dans cette nouvelle création, les membres de l’ensemble Constantinople sont accompagnés par la soprane Ángeles Núñez pour interpréter des œuvres séfarades et médiévales en dialogue avec la musique contemporaine. Le projet OCNOS, acteur dynamique de la musique contemporaine en Espagne, contribue à cette aventure créative. Tres Culturas inclut également la première du Cancionero du compositeur sévillan Alberto Carretero.</p> "
      }
    ],
