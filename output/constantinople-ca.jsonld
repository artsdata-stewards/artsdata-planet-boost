      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "The great ambassador of Afghan music Homayoun Sakhi, incomparable virtuoso of the rubab lute, is back in Montreal for a memorable concert. Accompanied by his friend and colleague Kiya Tabassian, virtuoso of another emblematic lute, the setar, they will pay tribute to the ancestral cultures of Afghanistan and Persia."
      },
      {
