      {
        "@language": "fr",
        "@value": "2025-5-1T20:00-4:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "fr",
        "@value": "2025-5-1T23:59-4:00"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Estuaire - COMPLET !"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\n                L’estuaire représente cet étonnant espace de transition et de transformation où l’eau douce rencontre l’eau salée et où se révèlent des potentiels inattendus, à l’image des rencontres imaginées par Constantinople. Cette troisième collaboration du maître de la kora Ablaye Cissoko et de l’ambassadeur du sétar persan, Kiya Tabassian, n’est autre que le point de jonction où les fleuves de leurs souvenirs musicaux se rejoignent. Leur dialogue, qui s’affine et s’enrichit d’année en année, donne lieu à des conversations musicales qui inspirent un sentiment d’émerveillement et éveillent la conscience.\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
