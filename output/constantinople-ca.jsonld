  {
    "@id": "https://constantinople.ca/en/events/songs-of-hope-13/event_19216_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://constantinople.ca/en/events/under-the-indian-musical-sky-82/var/ri-0.l-L2"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://constantinople.ca/wp-content/uploads/2024/11/kiya-et-shashank-copie-2.jpg"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g17678000"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
