    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://constantinople.ca/wp-content/uploads/2025/10/dialogos_3.png.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2026-3-17T20:00-4:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "en",
