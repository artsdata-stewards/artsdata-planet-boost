    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "La Traversée des Andes"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p style='text-align: justify;'>Ce concert revisite les musiques des Andes et de l’Amérique du Sud par l’entremise de manuscrits datant des XVIIe et XVIIIe siècles, dont <i>Codice Trujillo</i> et <i>Codice Luz y Norte</i>. À ces sources écrites s’ajoutent des pièces de traditions orale et populaire transmises de génération en génération, pour une soirée musicale au riche répertoire, à l’image de ces peuples colorés et lumineux. </p> <p>Ce projet est soutenu financièrement par le Conseil des Arts et des Lettres du Québec, le Conseil des Arts du Canada et l&rsquo;Associación ZINIA au Pérou.</p> "
      }
    ],
