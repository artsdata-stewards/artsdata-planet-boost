    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://constantinople.ca/wp-content/uploads/2021/03/il-ponte-3-juan-manuel-lobaton-web.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2026-6-21T19:00-4:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "en",
        "@value": "2026-6-21T23:59-4:00"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Fleeting Beauties"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n                As part of the Istanbul Music Festival, Constantinople takes over one of the city’s most historically rich venues: the Grand Bazaar. A crossroads of trade routes for centuries, this iconic space hosts the concert “Fleeting Beauties” — an invitation to experience music as a fleeting and precious encounter between different eras and geographies.\nThe programme features music ranging from the Italian Renaissance to Ottoman and Iranian repertoires, brought together for one evening to reveal the fragile beauty of each musical moment. Alongside counter-tenor Marco Beasley, Constantinople explores this living plurality in which each work exists fully only in the moment of its performance.\nA unique concert, at the heart of a unique place.\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
  {
    "@id": "https://constantinople.ca/temporary/189e4fae-2efc-4bca-8432-c069dbd3c82a",
