    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Saint-Saëns&#039; Egypt"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Musical traditions converge in this unique concert featuring the OSM and the ensemble Constantinople. The Mediterranean lies at the heart of this program, portrayed through the imagination and sensibility of European composers such as Saint-Saëns, whose Fifth Piano Concerto offers a stylized evocation of Egypt. As for Cantemir, a Moldovian 18th-century composer, his Ottoman influenced music promises to be a true revelation!</p> "
      }
    ],
