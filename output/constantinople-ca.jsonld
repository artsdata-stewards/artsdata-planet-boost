    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Ciel de l&#039;Iran COMPLET"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p style='text-align: justify;'>De la lueur du jour au crépitement du crépuscule, la musique règne parmi les astres de la civilisation iranienne. Phénomène unique en Orient, ce fruit de l’héritage mystique fascine par sa capacité à se régénérer constamment. À l’occasion de<em> Ciel de l’Iran</em>, le maître incontesté de cette tradition, Kayhan Kalhor, et Kiya Tabassian se promènent dans cet immense univers musical. Passeurs de mémoire et défricheurs d’avenir, ils font converser poésie des temps anciens et temps nouveaux, contribuant à une culture en pleine effervescence.</p> "
      }
    ],
