        "@value": "Clair-obscur - Constantinople"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Entre mer et montagnes, modalité et polyphonies, Clair-obscur est né du désir d’un dialogue approfondi entre les musiciens de Constantinople et les chanteurs d’A Filetta, l’ensemble phare des polyphonies corse."
      }
    ],
