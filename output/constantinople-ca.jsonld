        "@value": "event"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Clair-obscur - Constantinople"
      },
      {
        "@language": "en-ca",
        "@value": "Clair-obscur"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Between sea and mountains, between modes and polyphony — Clair-obscur is born of the desire for deeper dialogue on the part both of the musicians of Constantinople and the singers of A Filetta, the preeminent ensemble of Corsican polyphony. They have created a poetic and musical suite, mixing polyphonies created by the well-versed singers of A Filetta with songs and tunes composed and arranged by Kiya Tabassian. A profoundly touching concert."
      },
      {
        "@language": "en-ca",
        "@value": "Between sea and mountains, between modes and polyphony — Clair-obscur is born of the desire for deeper"
      }
    ],
    "http://ogp.me/ns#url": [
