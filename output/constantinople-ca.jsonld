    "http://schema.org/image": [
      {
        "@id": "https://constantinople.ca/wp-content/uploads/2025/03/dani-de-moron_131-1.jpg"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://constantinople.ca/en/events/duende-hal-5/"
