    "http://schema.org/image": [
      {
        "@id": "https://constantinople.ca/wp-content/uploads/2025/05/estuaire_constantinople_cissokonikolaj_lund_3-2.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g17682960"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g17683000"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
