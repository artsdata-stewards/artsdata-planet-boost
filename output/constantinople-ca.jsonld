  {
    "@id": "https://constantinople.ca/events/cantemir-le-prince-compositeur/event_19308_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://constantinople.ca/events/cantemir-le-prince-compositeur/"
