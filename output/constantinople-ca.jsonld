    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Clair Obscur"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n                Between sea and mountains, between modes and polyphony — Clair-obscur is born of the desire for deeper dialogue on the part both of the musicians of Constantinople and the singers of A Filetta, the preeminent ensemble of Corsican polyphony. They have created a poetic and musical suite, mixing polyphonies created by the well-versed singers of A Filetta with songs and tunes composed and arranged by Kiya Tabassian. A profoundly touching concert.\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
