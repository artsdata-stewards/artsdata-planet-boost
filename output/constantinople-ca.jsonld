  {
    "@id": "https://constantinople.ca/en/events/clair-obscur-35/event_16944_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://constantinople.ca/en/events/clair-obscur-35/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://constantinople.ca/wp-content/uploads/2021/04/clair-obscur-constantinople_afiletta-1-armand-luciani-copie-2.jpg"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://constantinople.ca/en/events/clair-obscur-35/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Clair Obscur"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><b>Constantinople </b>returns following last year’s sold-out performance at the Elora Festival! </p> <p>Between sea and mountains, between modes and polyphony — <i>Clair-obscur</i> is born of the desire for deeper dialogue on the part both of the musicians of <b>Constantinople</b> and the singers of <b>A Filetta</b>, the preeminent ensemble of Corsican polyphony. They have created a poetic and musical suite, mixing polyphonies created by the well-versed singers of <b>A Filetta </b>with songs and tunes composed and arranged by <b>Kiya Tabassian</b>. A profoundly touching concert.</p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2024-7-19T19:30-4::00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2024-7-19T23:59-4::00"
      }
    ],
