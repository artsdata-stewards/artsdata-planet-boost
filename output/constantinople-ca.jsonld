    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Duo Kayhan Kalhor & Kiya Tabassian"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\n                “Non fu mai uomo che cercasse tanto”\n700 ans de la mort de Marco Polo\nMarco Polo n’est pas allé en Asie pour chercher des richesses, du pouvoir et des honneurs, mais pour découvrir une forme de civilisation. Le Livre des Merveilles raconte un voyage de connaissance plus qu’un voyage de conquête. « Non fu mai uomo che cercasse tanto » s’inspire justement de cette conviction en créant un concert-lecture de musique, d’images et de paroles qui suit les diverses routes des voyages de Marco Polo en Extrême-Orient, passant également par la terre persane. Aux pages en langue franco-vénitienne du Livre des Merveilles, sélectionnées et lues par Sandro Cappelletto, s’alternent les improvisations musicales de deux maîtres de la musique persane : Kayhan Kalhor, légendaire joueur de kamancheh, instrument à archet de la tradition iranienne, et Kiya Tabassian, joueur de setar, le luth persan.\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
  {
    "@id": "https://constantinople.ca/temporary/eaf38f7b-bb2e-4707-b173-72b7a9cf731b",
