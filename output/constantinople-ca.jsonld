        "@value": "Constantinople and Accademia del Piacere embark on a musical journey through Iberia, Persia, and Central Asia, revisiting music notable for its sumptuous color and exceptionally rich beauty."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "en",
        "@value": "en-CA"
      }
    ]
