  {
    "@id": "https://constantinople.ca/creations/bach-khayam/event_18198_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://constantinople.ca/events/bach-khayyam-17/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://constantinople.ca/wp-content/uploads/2022/08/bach-khayyam_2022_bymoduleplus_dsc_6334-copie.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1375640"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://constantinople.ca/creations/bach-khayam/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Bach &amp; Khayyam - COMPLET !"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Même si plus de 600 ans séparent les vies de John-Sebastien Bach <span lang='EN-US'>(1685 -1715) et Omar Khayyam (1048 -1131), leurs génies étaient fait pour se rencontrer. Leur vision du monde, un parfait mélange de maîtrise des mathématiques couplé à un haut niveau de spiritualité, met en dialogue ces deux hommes en traçant un chemin vers le sublime. Dans cette nouvelle création, Constantinople propose des arrangements d’oeuvres et airs parmi les plus belles et spirituelles pièces de JS Bach, en dialogue avec des poèmes d’Omar Khayyam chantées en persan en réponses aux aria de Bach.</span></p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-3-20T20:00-4::00"
      }
    ],
