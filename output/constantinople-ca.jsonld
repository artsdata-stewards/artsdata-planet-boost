      {
        "@language": "en",
        "@value": "<p><i><span data-contrast='none'>Breathings</span></i><span data-contrast='none'> is a celebration of our intimate relationship with nature. It is a concert that places the breath at the centre of the musical act, in which Constantinople’s musicians and their guests from indigenous communities are guided by the pulsing of a heartbeat and the human voice in all its forms.</span><span data-ccp-props='{&quot;201341983&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:240}'> </span></p> "
      }
