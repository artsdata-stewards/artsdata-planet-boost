    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Consultez toutes les dates des concerts de Constantinople."
      },
      {
        "@language": "fr-ca",
        "@value": "Ce programme nous transporte sur les routes musicales sublimes et sophistiquées des anciennes civilisations d'Afghanistan, d'Inde et d'Iran."
      }
