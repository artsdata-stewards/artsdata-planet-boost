    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Under the Indian Musical Sky"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n                Under the Indian Musical Sky transports us into the sublime, refined world of an unparalleled musical civilization. Transmitted orally from one generation to the next, with its melodic ragas, precisely calculated yet highly complex rhythms and beats, and its both geometric and lyrical ornamentation, Indian music, from the north down to the south, provides an inexhaustible source of inspiration and beauty.”\n\n\n\n7. april 2026\nkl. 08:45-09:30\nØstervangskolen\nFavrskov\n\n\n7. april 2026\nkl. 10:45-11:30\nSøndervangskolen\nFavrskov\n\n\n8. april 2026\nkl. 08:30-09:15\nKirkebakkeskolen\nVejle\n\n\n8. april 2026\nkl. 12:00-12:45\nØdsted Skole\nVejle\n\n\n9. april 2026\nkl. 09:00-09:45\nVinding Skole\nVejle\n\n\n9. april 2026\nkl. 11:15-12:00\nEnglystskolen\nVejle\n\n\n9. april 2026\nkl. 12:45-13:30\nEnglystskolen\nVejle\n\n\n10. april 2026\nkl. 09:05-09:50\nRødding Skole\nVejen\n\n\n10. april 2026\nkl. 11:50-12:35\nGrønvangskolen\nVejen\n\n\n13. april 2026\nkl. 09:45-10:30\nBillund Skolen\nBillund\n\n\n13. april 2026\nkl. 12:35-13:20\nLynghedeskolen afd. Søndre\nBillund\n\n\n14. april 2026\nkl. 08:45-09:30\nSkærbæk Distriktsskole\nTønder\n\n\n14. april 2026\nkl. 12:00-12:45\nToftlund Skole\nTønder\n\n\n15. april 2026\nkl. 09:00-09:45\nAugustenborg Skole\nSønderborg\n\n\n15. april 2026\nkl. 12:00-12:45\nUlkebøl Skole\nSønderborg\n\n\n16. april 2026\nkl. 09:10-09:55\nSønderskov-Skolen\nSønderborg\n\n\n16. april 2026\nkl. 10:25-11:10\nSønderskov-Skolen\nSønderborg\n\n\n17. april 2026\nkl. 08:30-09:15\nJyderup Skole\nHolbæk\n\n\n17. april 2026\nkl. 10:50-11:35\nKildebjergskolen\nHolbæk\n\n\n20. april 2026\nkl. 08:45-09:30\nMarie Kruse Skole\nFuresø\n\n\n20. april 2026\nkl. 10:00-10:45\nMarie Kruse Skole\nFuresø\n\n\n\n            "
      }
