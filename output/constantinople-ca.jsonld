    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Souffles"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p class='p1'>Ce programme propose la rencontre de trois captivantes traditions musicales profondément enracinées dans l’essence du souffle, de la force vitale qui relie toutes les cultures et tous les peuples.</p> <p class='p1'>Les chants et tambours mi’kmaq, et les sons profonds et évocateurs des musiciens de Constantinople se retrouvent dans ce concert qui célèbre le pouvoir de la respiration dans la musique. Les sons de la nature sont portés par une grande héritière de traditions autochtones vivantes, Darlene Gijuminag. </p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
