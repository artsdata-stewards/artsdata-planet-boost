      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Cantemir, Le Prince Compositeur"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p><span class=''>Passeur d’histoires, l’ensemble </span><span class='gmail-il'>Constantinople</span><span class=''> se consacre ici à l&rsquo;œuvre de Dimitrie Cantemir, une figure emblématique qui fit le pont entre la culture européenne et celle du Moyen-Orient à l’orée du XVIIIe siècle. Cantemir n&rsquo;était pas seulement un prince et un érudit, mais aussi un compositeur et un diplomate de grand renom, dont le talent a traversé les frontières et les siècles. Ses compositions sont des joyaux de la musique ottomane, reflétant la richesse et la diversité de cet empire à son apogée. L’ensemble </span><span class='gmail-il'>Constantinople</span><span class=''>, sous la direction artistique de Kiya Tabassian, interprétera les compositions de Cantemir et de ses contemporains, tels le Français Marin Marais et l’Italien Antonio Bertali.</span></p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
