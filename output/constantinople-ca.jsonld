    ],
    "http://schema.org/image": [
      {
        "@id": "https://constantinople.ca/wp-content/uploads/2025/05/estuaire_constantinople_cissokonikolaj_lund_5.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g2130540"
      }
    ],
    "http://schema.org/organizer": [
