    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Chants d'espoir | COMPLET!"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\n                Ce concert est un cri d’espoir et de liberté qui émane de l’une des plus remarquables civilisations, celle de l’Iran.\nSi le raffinement des jardins de Chiraz et des mosaïques d’Ispahan ont fait la réputation de cette culture plurimillénaire, elle brille aussi par son admirable production musicale et poétique, qui transcendera toujours les affres de l’histoire. « Chants d’espoir » est un hymne à la richesse et à la beauté de cette culture qui met en scène des musiciens virtuoses, détenteurs de ces traditions. Kayhan Kalhor, le maître sublime du kamancheh, dialogue ici avec Kiya Tabassian au sétar et Hadi Hosseini au chant persan.\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
