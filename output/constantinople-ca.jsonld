      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Un dialogue entre la kora et le sétar, comme si ces instruments, aux côtés de la viole de gambe et des percussions, avaient toujours coexisté."
      }
    ],
