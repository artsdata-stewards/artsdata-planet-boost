    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Rythmes, danses, chants d’amour et complaintes, le divin mystique et l’émerveillement sont omniprésents dans les vers de Rumi en persan et en arabe."
      },
