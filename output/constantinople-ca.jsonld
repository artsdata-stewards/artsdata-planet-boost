    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Clair-obscur - Constantinople"
      },
      {
        "@language": "fr-ca",
        "@value": "Clair-obscur"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Constantinople s’associe à l’ensemble vocal phare de la Corse, A Filetta, pour créer un tableau sonore envoûtant où se rencontrent lumière et obscurité, à travers des chants sacrés et profanes de traditions européenne et persane."
      },
      {
        "@language": "fr-ca",
        "@value": "Entre mer et montagnes, modalité et polyphonies, Clair-obscur est né du désir d’un dialogue approfondi entre les musiciens"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://constantinople.ca/events/clair-obscur-17/"
