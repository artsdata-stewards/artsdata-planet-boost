    ],
    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://constantinople.ca/wp-content/uploads/2021/01/duocharbelkiya-scaled.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2024-8-16T17:30-4:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "en",
        "@value": "2024-8-16T23:59-4:00"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Passages"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n                This concert program is a musical voyage into the heart of Mediterranean and Middle Eastern musical traditions. Featuring some of the most pre-eminent heirs and creators from these lands, the concert presents ancient sounds and modes intertwining with new music composed by the virtuosos of the ensemble.\nThe meeting between the master-musicians from Lebanon, Iran, Turkey and Canada between strings and vocals, goes back in time to evoke the beauty of being. It is a joint passage through the common sites of the imagination, like a long breath before the inexorable march of the world and time.\nWithout doubt, this concert will transport you to a soul-stirring world of peaceful musical dialogues.\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
