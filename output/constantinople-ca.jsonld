    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Et je reverrai cette ville étrange - Constantinople"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Avec des musiciens virtuoses de plusieurs traditions musicales vivant tous à Montréal, Constantinople crée un portrait sonore de la métropole qui reflète sa diversité, autour d’une pièce de Claude Vivier, Et je reverrai cette ville étrange."
      }
    ],
