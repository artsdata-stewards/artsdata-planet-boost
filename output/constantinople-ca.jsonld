    "http://schema.org/image": [
      {
        "@language": "fr",
        "@value": "https://constantinople.ca/wp-content/uploads/2024/05/estuaire_constantinoplefederico_cavicchioli.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "fr",
        "@value": "2024-7-28T18:00-4:00"
      }
