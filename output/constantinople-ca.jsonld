      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "L'Égypte de Saint-Saëns"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\n                Les traditions musicales dialoguent dans ce concert original réunissant l’OSM et l’ensemble Constantinople. Représentée à travers l’imagination et la sensibilité de compositeurs européens, la Méditerranée est au cœur de ce programme, notamment avec le Cinquième Concerto pour piano de Saint-Saëns, évocation stylisée de l’Égypte. Quant à Cantemir, un compositeur moldave du 18e siècle, sa musique d’inspiration ottomane est une véritable révélation!\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
