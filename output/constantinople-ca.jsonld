      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "De la lueur du jour au crépitement du crépuscule, la musique règne parmi les astres de la civilisation iranienn. Kayhan Kalhor, et Kiya Tabassian se promènent dans cet immense univers musical. Passeurs de mémoire et défricheurs d’avenir, ils font converser poésie des temps anciens et temps nouveaux, contribuant à une culture en pleine effervescence."
      },
      {
        "@language": "fr-ca",
