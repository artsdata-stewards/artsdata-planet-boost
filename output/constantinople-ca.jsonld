        "@value": "https://constantinople.ca/wp-content/uploads/2025/05/estuaire_constantinople_cissokonikolaj_lund_3-2.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2026-7-14T19:30-4:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "en",
