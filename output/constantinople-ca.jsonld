    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Clair Obscur"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Between sea and mountains, between modes and polyphony — <i>Clair-obscur</i> is born of the desire for deeper dialogue on the part both of the musicians of <b>Constantinople</b> and the singers of <b>A Filetta</b>, the preeminent ensemble of Corsican polyphony. They have created a poetic and musical suite, mixing polyphonies created by the well-versed singers of <b>A Filetta </b>with songs and tunes composed and arranged by <b>Kiya Tabassian</b>. A profoundly touching concert.</p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2024-7-20T16:30-4::00"
      }
