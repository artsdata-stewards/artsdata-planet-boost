        "@language": "fr-ca",
        "@value": "Bach-Khayyam - Constantinople"
      },
      {
        "@language": "fr-ca",
        "@value": "Bach-Khayyam"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Dans cette nouvelle création, Constantinople propose des arrangements de chansons et airs parmi les plus belles et spirituelles pièces de JS Bach, en dialogue avec des poèmes d'Omar Khayyam chantées en persan en réponses aux chansons de Bach."
      },
      {
        "@language": "fr-ca",
        "@value": "Même si plus de 600 ans séparent les vies de John-Sebastien Bach (1685 -1715) et Omar Khayyam (1048 -1131),"
      }
    ],
    "http://ogp.me/ns#url": [
