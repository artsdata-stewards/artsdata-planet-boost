      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://constantinople.ca/wp-content/uploads/2025/05/estuaire_constantinople_cissokonikolaj_lund_5.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1298040"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://constantinople.ca/creations/estuaire/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Estuaire"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p class='p1' style='text-align: justify;'>L’estuaire représente cet étonnant espace de transition et de transformation où l’eau douce rencontre l’eau salée et où se révèlent des potentiels inattendus, à l’image des rencontres imaginées par Constantinople. Cette troisième collaboration du maître de la kora Ablaye Cissoko et de l’ambassadeur du sétar persan, Kiya Tabassian, n’est autre que le point de jonction où les fleuves de leurs souvenirs musicaux se rejoignent. Leur dialogue, qui s’affine et s’enrichit d’année en année, donne lieu à des conversations musicales qui inspirent un sentiment d’émerveillement et éveillent la conscience.</p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-4-28T19:30-4::00"
      }
