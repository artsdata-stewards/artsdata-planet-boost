      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Fleeting Beauties"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p class='font-claude-response-body break-words whitespace-normal leading-[1.7]'>As part of the Istanbul Music Festival, Constantinople takes over one of the city&#8217;s most historically rich venues: the Grand Bazaar. A crossroads of trade routes for centuries, this iconic space hosts the concert &#8220;Fleeting Beauties&#8221; — an invitation to experience music as a fleeting and precious encounter between different eras and geographies.</p> <p class='font-claude-response-body break-words whitespace-normal leading-[1.7]'>The programme features music ranging from the Italian Renaissance to Ottoman and Iranian repertoires, brought together for one evening to reveal the fragile beauty of each musical moment. Alongside counter-tenor Marco Beasley, Constantinople explores this living plurality in which each work exists fully only in the moment of its performance.</p> <p class='font-claude-response-body break-words whitespace-normal leading-[1.7]'>A unique concert, at the heart of a unique place.</p> "
      }
    ],
