    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "What can students of jazz and new music from Cologne learn from Tabassian’s trans-traditional approach to music? That is the question they explore in an improvisation workshop; the results can be heard in their joint lunch concert."
      },
      {
        "@language": "fr-ca",
        "@value": "Across continents and millennia, the improvisation of music and its oral reproduction from memory was the norm; composing"
      }
    ],
