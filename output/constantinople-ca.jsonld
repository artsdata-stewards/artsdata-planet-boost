  {
    "@id": "https://constantinople.ca/events/khayyam-oum-kalthoum-4/event_19546_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://constantinople.ca/events/khayyam-oum-kalthoum-4/"
      }
    ],
    "http://schema.org/image": [
      {
