  {
    "@id": "https://constantinople.ca/events/ciel-de-linde-85/event_18228_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://constantinople.ca/events/ciel-de-linde-85/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://constantinople.ca/wp-content/uploads/2024/11/kiya-et-shashank-copie-2-1.jpg"
      }
    ],
    "http://schema.org/organizer": [
