  {
    "@id": "https://constantinople.ca/en/events/clair-obscur-34/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-ca",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#locale:alternate": [
