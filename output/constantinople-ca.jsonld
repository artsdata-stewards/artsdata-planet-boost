      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1961200"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g1961240"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://constantinople.ca/events/khayyam-oum-kalthoum-4/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Khayyam &amp; Oum Kalthoum"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Kiya Tabassian et son ensemble Constantinople présentent une relecture contemporaine des <em data-start='109' data-end='119'>Rubaiyat</em>, le célèbre recueil de poèmes du poète, astronome et mathématicien persan Omar Khayyam. En collaboration avec la chanteuse Ghalia Benali, ils rendent hommage à l’héritage d’Oum Kalthoum, icône de la musique du Moyen-Orient, en revisitant les compositions de Riad Al Sunbati qui ont marqué l’interprétation musicale de ces quatrains. À travers de nouveaux arrangements et des compositions originales de Tabassian, ce projet fait dialoguer la poésie soufie millénaire avec les sonorités d’aujourd’hui, dans un pont vibrant entre traditions arabes et persanes.</p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-7-3T19:00-4::00"
      }
