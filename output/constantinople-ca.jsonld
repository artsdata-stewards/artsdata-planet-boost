    ],
    "http://schema.org/image": [
      {
        "@language": "fr",
        "@value": "https://constantinople.ca/wp-content/uploads/2025/09/traversee_andes_federico_tarazonamichael_slobodian-e1758123413112.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "fr",
        "@value": "2026-5-22T19:00-4:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "fr",
        "@value": "2026-5-22T23:59-4:00"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "La traversée des Andes"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\n                Un voyage musical riche et exceptionnel à travers les Andes anciennes — Constantinople et des musiciens maîtres péruviens explorent les codex Martínez Compañón et Zuola.\nJoignez-vous à nous pour une soirée vibrante de découvertes alors que l’ensemble Constantinople, dirigé par Kiya Tabassian, et ses prestigieux invités du Pérou explorent la mémoire musicale foisonnante de ce pays.\nLa musique des Andes et de l’Amérique du Sud est l’héritière des traditions musicales préhispaniques, enrichies par l’apport d’instruments et de répertoires des peuples qui se sont établis sur les terres de ce « Nouveau Monde ». Cette rencontre entre des cultures profondément différentes a donné naissance à des pages musicales d’une richesse exceptionnelle, aujourd’hui redécouvertes dans les codex des XVIIe et XVIIIe siècles, tels que ceux de Martínez Compañón et de Zuola.\nMais cette mémoire ne vit pas seulement dans les manuscrits : elle se prolonge dans les traditions orales et populaires, transmises de génération en génération, dont les rythmes et les mélodies continuent de vibrer à travers l’Amérique du Sud. Véritable pont entre les mondes, cette musique tisse une somptueuse tapisserie sonore où se rencontrent histoire, identité et imagination vivante.\n\nCe projet est soutenu financièrement par le Conseil des Arts et des Lettres du Québec, le Conseil des Arts du Canada et l’Associación ZINIA au Pérou.\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
