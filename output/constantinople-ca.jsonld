      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "What can students of jazz and new music from Cologne learn from Tabassian’s trans-traditional approach to music?"
      },
      {
        "@language": "en-ca",
        "@value": "Across continents and millennia, the improvisation of music and its oral reproduction from memory was the norm; composing"
      }
    ],
