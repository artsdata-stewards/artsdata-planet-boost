      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Lumières Nordiques"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Cette collaboration émane d’un intérêt profond pour l’exploration des sonorités et des gestes musicaux des musiques nordiques. Benedicte Maurseth, virtuose et ambassadrice de la vièle Hardanger, se joint à Constantinople pour créer une musique fortement influencée par la nature et les paysages vastes du Nord, ainsi que par l’évolution des rapports de l’être humain avec cette nature. À travers un dialogue « Nord-Sud », ils peignent ensemble un tableau sonore qui interpelle l’imaginaire et transporte l’auditeur dans des univers raffinés et profonds de bien être.</p> "
      }
    ],
    "http://schema.org/startDate": [
