    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Khayyam &amp; Oum Kalthoum | COMPLET !"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Le musicien iranien Kiya Tabassian et son ensemble Constantinople présentent une relecture contemporaine des <em data-start='109' data-end='119'>Rubaiyat</em>, le célèbre recueil de poèmes du poète, astronome et mathématicien persan Omar Khayyam. En collaboration avec la chanteuse Ghalia Benali, ils rendent hommage à l’héritage d’Oum Kalthoum, icône de la musique du Moyen-Orient, en revisitant les compositions de Riad Al Sunbati qui ont marqué l’interprétation musicale de ces quatrains. À travers de nouveaux arrangements et des compositions originales de Tabassian, ce projet fait dialoguer la poésie soufie millénaire avec les sonorités d’aujourd’hui, dans un pont vibrant entre traditions arabes et persanes.</p> "
      }
    ],
