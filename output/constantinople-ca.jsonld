    "http://schema.org/image": [
      {
        "@id": "https://constantinople.ca/wp-content/uploads/2021/03/il-ponte-3-juan-manuel-lobaton-web.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g17681140"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g17681180"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
