      },
      {
        "@language": "fr-ca",
        "@value": "Clair-obscur"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Polyphonies corses créées par les chanteurs érudits d’A Filetta ainsi que chant et musique savante persane orchestrés par Kiya Tabassian seront au rendez-vous, pour un concert profondément bouleversant."
      },
      {
        "@language": "fr-ca",
        "@value": "Entre mer et montagnes, modalité et polyphonies, Clair-obscur est né du désir d’un dialogue approfondi entre les musiciens"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
