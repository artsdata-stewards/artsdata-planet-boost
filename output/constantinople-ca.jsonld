  {
    "@id": "https://constantinople.ca/events/dialogos-12/event_18902_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://constantinople.ca/events/dialogos-12/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://constantinople.ca/wp-content/uploads/2025/10/dialogos_3.png-1.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g2103680"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
