    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Souffles est une célébration de notre relation intime avec la nature. C&rsquo;est un concert qui place la respiration au centre de l&rsquo;acte musical, dans lequel les musiciens de Constantinople et leurs invités des communautés autochtones sont guidés par le battement du cœur et par la voix humaine dans toutes ses formes.</p> "
      }
    ],
