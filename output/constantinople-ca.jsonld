  {
    "@id": "https://constantinople.ca/en/events/songs-of-hope-13/event_19547_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://constantinople.ca/en/events/khayyam-oum-kalthoum-3/var/ri-0.l-L2"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://constantinople.ca/wp-content/uploads/2026/03/khayyam_oukalthoumjefberhin_halo.png"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g17681860"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g17681900"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://constantinople.ca/en/events/songs-of-hope-13/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Khayyam &amp; Oum Kalthoum"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Kiya Tabassian and his ensemble Constantinople present a contemporary reinterpretation of the <em data-start='111' data-end='121'>Rubaiyat</em>, the renowned collection of poems by Persian poet, astronomer, and mathematician Omar Khayyam. In collaboration with singer Ghalia Benali, they pay tribute to the legacy of Umm Kulthum, the iconic voice of Middle Eastern music, by revisiting the compositions of Riad Al Sunbati that brought these quatrains to life. Through new arrangements and original compositions by Tabassian, the project creates a vibrant dialogue between centuries-old Sufi poetry and the sounds of today, bridging Arab and Persian musical traditions.</p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-7-3T19:00-4::00"
      }
    ],
