  {
    "@id": "https://constantinople.ca/temporary/ae322f0f-46fd-41cd-8cea-d5527b15f016",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://constantinople.ca/en/events/cantemir-the-composer-prince/var/ri-0.l-L2"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "_:g17688760"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g17688780"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g17688860"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "_:g17688920"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://constantinople.ca/en/events/songs-of-hope-13/"
      }
    ],
    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://constantinople.ca/wp-content/uploads/2023/05/constantinople_cantemirconstantinople-1.png"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2026-6-17T19:00-4:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "en",
        "@value": "2026-6-17T23:59-4:00"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Cantemir, The Composer Prince"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n                In this creation, Constantinople dedicates itself to the work of Dimitrie Cantemir, an emblematic figure bridging European and Middle Eastern cultures at the dawn of the 18th century.\n\n\n\n\nCantemir was not only a prince and scholar, but also a renowned composer and diplomat and transcended borders and centuries with his talent. His musical contributions are invaluable: his compositions are gems of Ottoman music, showcasing the empire’s richness and diversity at its peak. Moreover, Cantemir’s meticulous compilation and transcription work in the monumental “Edvar-i Musiki” stand unparalleled. With over 350 meticulously transcribed instrumental pieces, Cantemir’s collection offers a comprehensive insight into Ottoman and Middle Eastern music of the 16th and 17th centuries, making it a crucial resource for understanding these musical traditions.\nUnder the artistic direction of Kiya Tabassian, Constantinople approaches Cantemir’s treasure trove with erudite precision and creative flair. By interpreting Cantemir’s compositions alongside works by his contemporaries like the French Marin Marais and the Italian Antonio Bertali, the musicians infuse new vitality into these centuries-old pieces, rendering them vivid and tangible for modern audiences.\n\n\n\n\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
