      {
        "@language": "en-ca",
        "@value": "Under the Indian Musical Sky"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Under the Indian Musical Sky transports us into the sublime, refined world of an unparalleled musical civilization. Transmitted orally from one generation to the next, with its melodic ragas, precisely calculated yet highly complex rhythms and beats, and its both geometric and lyrical ornamentation, Indian music, from the north down to the south, provides an inexhaustible source of inspiration and beauty.”"
      },
      {
        "@language": "en-ca",
        "@value": "Under the Indian Musical Sky transports us into the sublime, refined world of an unparalleled musical civilization. Transmitted"
