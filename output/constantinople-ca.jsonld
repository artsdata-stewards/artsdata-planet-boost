    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Tres Culturas"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n                In this new creation, members of the Constantinople ensemble are accompanied by soprano Ángeles Núñez to interpret Sephardic and medieval music in dialogue with contemporary music. The OCNOS project, a dynamic player in contemporary music in Spain, contributes to this creative adventure. Tres Culturas also includes the premiere of the Cancionero by Sevillian composer Alberto Carretero.\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
