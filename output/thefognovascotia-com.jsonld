      {
        "@value": "The Fog at The Blackfly Festival @ Annapolis Royal Legion - May 16, 2026, 12:00PM"
      }
    ],
    "http://opengraphprotocol.org/schema/description": [
      {
        "@value": "We're happy to be among a long list of great local music happening at the Legion's major fundraiser! We dont know our slot time yet, but the festival starts at noon and goes until 8. Stay tuned for a schedule closer to the date. Come out and support the Legion- one of Annapolis Royal's favourite gathering places!"
      }
