      }
    ],
    "http://opengraphprotocol.org/schema/description": [
      {
        "@value": "Join us at Digby's Premier Venue for Live Music - with their dedicated Music Room! Come for Dinner and enjoy the show! Outside seating is also available on one of their lovely decks overlooking downtown Digby and the Basin. Make your reservations well in advance because the Music Room fills up fast! Call 902-245-1066 to grab your table now!"
      }
