  {
    "@id": "https://thefognovascotia.com/event/6494752/756140675/the-fog-at-the-digby-pines-grande-lounge",
    "http://opengraphprotocol.org/schema/title": [
      {
        "@value": "The Fog at The Digby Pines -  Grande Lounge @ Digby Pines Resort - Jun 12, 2026, 7:00PM"
      }
    ],
    "http://opengraphprotocol.org/schema/description": [
      {
        "@value": "Whether you are planning a stay at The Digby Pines Resort or not, everyone is welcome to enjoy an evening in the gorgeous Grande Lounge. Full Bar, comfy seating, and us to entertain you! No cover and no reservations required."
      }
    ],
