    "http://opengraphprotocol.org/schema/description": [
      {
        "@value": "We are so excited to be making our Bearly's Debut at their new Sunday Matinee: Crib and Country! You play the Crib, maybe have a bite to eat, and we'll supply the country, along with a few choice originals and covers! Standup and/or Electirc Bass, Acoustic Guitar, and Accordion! We are A Trio of the Unexpected. No Cover!"
      }
    ],
