  {
    "@id": "https://thefognovascotia.com/event/6504574/756907662/the-fog-at-cove-muisc",
    "http://opengraphprotocol.org/schema/title": [
      {
        "@value": "The Fog at Cove Muisc @ Zion United Church - Aug 6, 2026, 7:00PM"
      }
    ],
    "http://opengraphprotocol.org/schema/description": [
      {
        "@value": "It is always a treat to play at Cove Music Concerts in the beautiful little fishing village of Sandy Cove, on Digby Neck. We are honoured to be invited back . The shows are held in the Zion United Church, one of three iconic heritage churches perched on the hill over looking the cove. The acoustics in the room are amazing. The seats, on the other hand, are church-pew hard. There are a some with cushions..but you're free to bring your own. Doors 6:30 Show 7. $20 at the door. Coffee/Tea & Sweets available $5 donation."
      }
    ],
    "http://opengraphprotocol.org/schema/image": [
      {
        "@value": "https://images.zoogletools.com/s:bzglfiles/u/710168/706a77e19ba1ddf1924cdfb61484bf0d4074df9b/original/337286823-900597511219618-291917731447887875-n-1.jpg/!!/meta%3AeyJzcmNCdWNrZXQiOiJiemdsZmlsZXMifQ%3D%3D.jpg"
