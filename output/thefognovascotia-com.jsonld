    "http://opengraphprotocol.org/schema/title": [
      {
        "@value": "The Fog at Millstone Harvest Brewhouse @ Millstone Harvest Brewhouse - Sep 18, 2026, 7:00PM"
      }
    ],
    "http://opengraphprotocol.org/schema/description": [
      {
        "@value": "Come on out for some great live music at Millstone Harvest Brewhouse! A fine craft brewery nestled in the beautiful Annapolis Valley, tucked into farming country in Sheffield Mills, near Wolfville! Enjoy their wonderful 5-Star selection of beers! They are the only brewhouse in NS that produces its own malt! We always have a great time playing here! Food truck onsite."
      }
    ],
