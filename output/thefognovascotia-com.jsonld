  {
    "@id": "https://thefognovascotia.com/event/6450220/760758462/the-fog-at-lazy-bear-brewing",
    "http://opengraphprotocol.org/schema/title": [
      {
        "@value": "The Fog at Lazy Bear Brewing @ Lazy Bear Brewing - May 28, 2026, 6:00PM"
      }
    ],
    "http://opengraphprotocol.org/schema/description": [
      {
        "@value": "Join us on the lawn at Lazy Bear....snag a picnic table if you're early enough, or grab some of their onsite lawn chairs and find your favourite spot, sit by the fire or on the deck by the pond or spread out your own blanket - the options are endless! Enjoy the fine selection of their own craft brews, ciders, and non-alcoholic bevvies, artisan pizza made in The Firebox - what else could you possible need to make you decide to come out? No cover? Got that too!"
      }
    ],
    "http://opengraphprotocol.org/schema/image": [
