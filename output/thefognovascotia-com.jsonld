  {
    "@id": "https://thefognovascotia.com/event/6504633/756907737/the-fog-at-the-long-table-social-club",
    "http://opengraphprotocol.org/schema/title": [
      {
        "@value": "The Fog at The Long Table Social Club @ The Long Table Social Club - Aug 29, 2026, 7:00PM"
      }
    ],
    "http://opengraphprotocol.org/schema/description": [
      {
        "@value": "Come find us in beautiful Scott's Bay on the Shores of the Minas Basin near Cape Split! Depending on the weather we will either be playing on the deck or inside. Their Cooking With Fire events off a fine menu all cooked outside on the grill. Inside, sit at one of the Long Tables and you'll enjoy making new friends while enjoying a fabulous meal. Reservations required - call (902) 582-1393 or book through their website https://www.thelongtablesocialclub.com/"
      }
    ],
    "http://opengraphprotocol.org/schema/image": [
