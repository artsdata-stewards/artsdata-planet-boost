  {
    "@id": "https://thefognovascotia.com/event/6503373/756779337/the-fog-at-millstone-harvest-brewhouse",
    "http://opengraphprotocol.org/schema/title": [
      {
        "@value": "The Fog at Millstone Harvest Brewhouse @ Millstone Harvest Brewhouse - Jul 3, 2026, 7:00PM"
      }
    ],
    "http://opengraphprotocol.org/schema/description": [
      {
        "@value": "Back up in the beautiful countryside between Kentville and Cape Split at our favourite valley craft brewery! What a great place to spend a whole weekend....lots of hiking and great AirBnBs nearby and this wonderful Craft Brewery to boot! Add us to your the mix for your Friday night fun and you've got the perfect weekend plan! No Cover"
      }
    ],
    "http://opengraphprotocol.org/schema/image": [
      {
        "@value": "https://images.zoogletools.com/s:bzglfiles/u/710168/706a77e19ba1ddf1924cdfb61484bf0d4074df9b/original/337286823-900597511219618-291917731447887875-n-1.jpg/!!/meta%3AeyJzcmNCdWNrZXQiOiJiemdsZmlsZXMifQ%3D%3D.jpg"
