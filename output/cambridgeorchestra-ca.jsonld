  {
    "@id": "https://www.cambridgeorchestra.ca/events-1/masterworks-i-with-ken-gee-piano",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Masterworks I with Ken Gee, Piano | Cambridge Orchestra"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Our opening Masterworks concert will feature \norchestral masterpieces by Beethoven and Brahms.\nPianist Ken Gee will join us for Mozart’s popular “Elvira Madigan” concerto.\nCome and be uplifted by inspiring music from these 3 great Masters!!"
      }
