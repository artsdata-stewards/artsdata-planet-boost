    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The Road to Django traces a vibrant musical journey from India through Persia, Turkey, the Balkans, and ultimately to Spain and France: the cultural crossroads that shaped Django Reinhardt and the Hot Club of France."
      }
    ],
