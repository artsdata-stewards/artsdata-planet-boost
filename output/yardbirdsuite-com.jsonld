    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Tord Gustavsen Trio - The Yardbird Suite"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "With the release of his first recording in 2003 entitled Changing Places, Norway’s Tord Gustavsen came forth with a new and unique sound that commanded worldwide attention, an extraordinary achievement given the rich history of jazz piano."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
