    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Award-winning bassist and composer Rubim de Toledo combines the influences of his Brazilian heritage and his dedication to the jazz tradition to create an approach to music that is refreshing and uplifting."
      }
