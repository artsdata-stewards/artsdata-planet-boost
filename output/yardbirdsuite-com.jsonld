    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Rhonda Withnell returns to the Yardbird Suite stage singing the great RnB classics (think Tower of Power, Aretha) peppered with hot new material (Yebba) and joined by the cream of Edmonton's jazz scene and long-time collaborators."
      }
    ],
