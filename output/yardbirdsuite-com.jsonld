  {
    "@id": "https://yardbirdsuite.com/shows/caity-gyorgy/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Caity Gyorgy - The Yardbird Suite"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Caity Gyorgy (pronounced George) is 2 time JUNO award winning Canadian vocalist who is known for singing bebop and swing music."
