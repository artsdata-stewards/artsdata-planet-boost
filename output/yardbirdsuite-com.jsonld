    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "This swinging band features an inventive mix of voice (the divine Jocelyn Anselmo), keys (virtuoso jazzman Simon Abbott), bass (the multi-talented Andreas Wegner), and an ingenious percussion section from tireless tap-dancing diva Paige Tirs."
      }
    ],
