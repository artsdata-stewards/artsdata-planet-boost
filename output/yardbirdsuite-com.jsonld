    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Twice JUNO- nominated Al Muirhead is known as the Elder Statesman of Jazz Trumpet in Alberta and was recently inducted into the YYC Music Awards Hitmakers Hall of Fame. As one of Al Muirhead’s 90th Birthday Celebrations he will be featured with Jazz Hutch Quintet, remembering Chet Baker and more. Calgary’s Jazz Hutch Quintet, including … Continued"
      }
    ],
