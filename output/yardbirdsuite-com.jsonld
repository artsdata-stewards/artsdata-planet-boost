  {
    "@id": "https://yardbirdsuite.com/shows/roddy-ellias-trio/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Roddy Ellias Trio - The Yardbird Suite"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Prepare to be swept along on a musical journey to captivating and unexpected places, as Canadian jazz guitarist and composer Roddy Ellias joins up with long-time friends and collaborators Paul Johnston on bass and Dave Laing on drums."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://yardbirdsuite.com/shows/roddy-ellias-trio/"
      }
