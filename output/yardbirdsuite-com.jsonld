    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Drummer and bandleader Jacob Wutzke leads a fiery jazz quartet playing original music and fresh takes on classic jazz standards."
      }
    ],
    "http://ogp.me/ns#url": [
