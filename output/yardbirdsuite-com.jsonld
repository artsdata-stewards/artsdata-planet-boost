    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Tuesday Jam Hosted by Canadian Dreams Quintet - The Yardbird Suite"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The Canadian Dreams Quintet is 5 members from Edmonton’s busiest Salsa band – Manny V. Y Esquina Latina. This quintet format focuses more on Latin jazz style music – boleros, cha cha cha, danzón, son and guaracha. As Latino Canadians now established with careers, family and music in Canada we find ourselves living the Canadian … Continued"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
