  {
    "@id": "https://yardbirdsuite.com/shows/tuesday-jam-hosted-by-the-leach-quintet/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Tuesday Jam Hosted by The Leach Quintet - The Yardbird Suite"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The Leach Quintet is led by drummer and composer Jacob Tanner, a high-energy musician inspired by legends such as Art Blakey, Takehiro Shimizu, Takashi Sasaki, and Yussef Dayes."
