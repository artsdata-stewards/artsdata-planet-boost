        "@value": "The Queen's R&B Hip Hop Cabaret"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Step into an unforgettable night with Charlee Queen XO &amp; Friends for \"The Queen's R&amp;B Hip Hop Cabaret\"—a celebration of poetic flow, live music, and soulful rhythms of urban culture. This is an evening brought to life by some of the city's most talented musicians and performers."
      }
