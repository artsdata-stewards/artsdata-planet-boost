    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "This Montreal-based trio was formed in 2021, featuring the generous playing of tenor saxophonist Aaron Leaney, weaving intricate melodies and free-form explorations with bassist Nicolas Caloia laying down hypnotic unpredictable rhythms while drummer Jahsun draws from the afro-diasporic laws of space and time."
      }
    ],
