    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Josh Krushel Trio - The Yardbird Suite"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Connected to the deep roots of Black American Music while looking forward into the future of experimental theoretical techniques - Krushel’s music is just as thought provoking as it is pleasurable. Operating in many musical worlds as a jazz pianist, modern classical composer, and non-idiomatic improviser. "
      }
    ],
    "http://ogp.me/ns#url": [
