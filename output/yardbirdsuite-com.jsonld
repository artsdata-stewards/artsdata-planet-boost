  {
    "@id": "https://yardbirdsuite.com/shows/tuesday-jam-hosted-by-lisi-sommer/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Tuesday Jam Hosted by Lisi Sommer - The Yardbird Suite"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "With a passion for both jazz and traditional Latin music, Lisi Sommer is thrilled to bring these two loves together for this special Latin edition of the Tuesday jam, along with her favourite Afro-Cuban jazz musicians Chris Andrew and Rubim De Toledo."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://yardbirdsuite.com/shows/tuesday-jam-hosted-by-lisi-sommer/"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en-us",
        "@value": "The Yardbird Suite"
