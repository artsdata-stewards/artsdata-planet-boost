    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Melafrique"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Melafrique is a dynamic Afro-fusion band formed in Edmonton, Canada, in 2016, with a mission to bridge cultures and inspire global audiences through music. The name “Melafrique” blends “Melanin” and “Africa,” symbolizing the band’s celebration of African and diasporic heritage. Drawing from a rich mix of genres–Soul, R&amp;B, Reggae, Pop, Jazz, Neo-soul–and traditional African rhythms, Melafrique's unique sound is poised to continue pushing musical boundaries while contributing to a vibrant, multicultural artistic landscape. The band uses music as a powerful vehicle for storytelling, expressing their collective identities as Africans, Caribbean people, and Canadians. With members from Kenya, Nigeria, Ghana, Angola, Jamaica, and Canada, Melafrique’s diversity is embedded in every performance, showcasing the power of cultural exchange through music."
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
