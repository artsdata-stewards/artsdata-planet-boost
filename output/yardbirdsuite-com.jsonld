    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Art Blakey and the Jazz Messengers were an iconic jazz combo that influenced countless artists. Fred Mack's Sextet brings their classic pieces to life with some hard swinging tunes."
      }
    ],
