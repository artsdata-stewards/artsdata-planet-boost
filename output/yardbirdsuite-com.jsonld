    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Tuesday Jam Hosted by MINTAKA - The Yardbird Suite"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "MINTAKA is Western Canada’s newest contemporary jazz collective. Named after the six star system that comprises the westernmost star of Orion’s Belt, MINTAKA features six of Edmonton’s premier composer-musicians, all of whom contribution original compositions to the collective’s repertoire. Exploring the intersections of jazz with contemporary influences like folk, RnB, rock, and pop, sonic worlds … Continued"
      }
    ],
