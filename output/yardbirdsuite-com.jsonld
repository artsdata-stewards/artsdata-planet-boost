        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "The Gadjo Collective Quintet - The Yardbird Suite"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Balkan meets jazz! Imagine if Stephane Grapelli and Django Reinhardt travelled to Bulgaria and Romania and brought back some of the flavours of the east. The sound is original, the origins are ancient and the rhythm is hot!"
      }
    ],
    "http://ogp.me/ns#url": [
