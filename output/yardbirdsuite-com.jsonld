        "@language": "en-us",
        "@value": "Meissner/Ambrosio/Stillman Trio - The Yardbird Suite"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Based on musical relationships more than 20 years in the making, Russ Meissner, David Ambrosio and Loren Stillman and are an ensemble that explores musical conversation and spontaneity with an open sensibility, while still keeping much of the essence and tradition of classic jazz trio playing."
      }
    ],
    "http://ogp.me/ns#url": [
