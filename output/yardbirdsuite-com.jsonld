        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Craig H - The Yardbird Suite"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Craig H will be stripping back 20 years of compelling electronic songcraft with a combination of atmospheric and danceable rhythms in this very rare performance, backed by a quartet of eclectic YEG-based musicians."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://yardbirdsuite.com/shows/craig-h/"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
