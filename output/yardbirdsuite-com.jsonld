    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The AJD Trio features some of Edmonton’s most creative and versatile jazz musicians. With Aretha Tillotson on bass, Jamie Philp on guitar, and Daniel Akira Stadnicki on drums, the group has worked with one another in a variety of projects and ensembles."
      }
    ],
