    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "This spring, the multi-award-winning Nick Maclean Quartet feat. Brownman Ali embarks on their extensive, two month national tour across Canada, bringing them from their hometown of Toronto all the way to the Pacific coast and everywhere in between."
      }
