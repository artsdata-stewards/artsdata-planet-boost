    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Multi award-winning Canadian singer-songwriter, pianist and CBC Music national radio host Laila Biali has headlined festivals and venues spanning five continents from New York City's Carnegie Hall to Beijing's National Centre for the Performing Arts, and supported international icon Sting."
      }
    ],
