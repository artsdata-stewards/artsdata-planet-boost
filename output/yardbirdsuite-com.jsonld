    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://yardbirdsuite.com/shows/new-years-eve-with-rumba-caliente/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "New Year's Eve with RUMBA Caliente"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Young and old from any culture can feel the beat in their feet and jump up to dance, Salsa, Funk, Cumbia, Reggae, Cha cha, or merengue even if they don’t know how! If you have ever had that feeling when you feel like your body needs to get up and dance away all your stress and worries, then you know what Rumba Caliente is all about. Back in 2011, by initiative of Remo Priolo (Venezuelan Musician) together with family members and musician friends the name of Rumba Caliente was announced at one of the most important Latin Festivals in Alberta “THE EXPOLATINO CALGARY”, after an amazing performance. Ever since then this band has been inspiring audiences to “feel the beat” and move to the sizzling sounds of Latin culture. 7:30 pm Doors Open 8:30 pm Program 8:40 pm Music 9:25 pm Program 9:30 pm Food 10:00 pm Music 12:00am Happy New Year! 1:30am NYE Fundraiser ends"
      }
    ],
