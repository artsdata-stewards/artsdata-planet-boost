  {
    "@id": "https://yardbirdsuite.com/shows/an-intimate-evening-of-song-with-thomas-alexander-and-friends/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
