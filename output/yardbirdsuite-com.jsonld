    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "ANDY MILNE & UNISON - The Yardbird Suite"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The TD Edmonton International Jazz Festival is proud to present ANDY MILNE & UNISON at the Yardbird Suite. Andy is a two-time Juno Award winning pianist/composer who has been a distinct and respected voice at the heart of New York’s creative jazz scene for 30 years."
      }
    ],
