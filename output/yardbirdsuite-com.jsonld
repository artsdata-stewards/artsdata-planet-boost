    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Byrne McMullen is an up-and-coming jazz saxophonist, composer, and bandleader in Edmonton. He is known for his warm, full tone and commitment to creating a sound authentic to the jazz language and tradition."
      }
