  {
    "@id": "https://yardbirdsuite.com/shows/fiddle-summit-3-a-celebration-of-global-fiddle-music/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Fiddle Summit 3 A Celebration of Global Fiddle Music - The Yardbird Suite"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Fiddle Summit 3 brings together six of Canada’s most exceptional fiddlers—Cam Neufeld, Daniel Gervais, Caleb Hunt, Shannon Johnson, Jeremiah McDade, and Braden Gates—along with the rock-solid groove of Keith Rempel on bass."
      }
