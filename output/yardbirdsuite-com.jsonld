    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Following a sold-out 2025 tour, this vibrant Flamenco ensemble takes to the stage with returning special guests – Spanish Flamenco singer and percussionist Francisco Orozco “Yiyi” and Vancouver Flamenco guitarist Peter Mole – for an intimate evening of Flamenco dance, guitar, piano, and song."
      }
    ],
