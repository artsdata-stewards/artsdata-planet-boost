        "@language": "en-us",
        "@value": "The Ostara Project - The Yardbird Suite"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The Ostara Project, spear-headed by award-winning jazz musicians Jodi Proznick and Amanda Tosoff of Music Arts Collective, showcases the strength and creativity of Canadian women in jazz."
      }
    ],
