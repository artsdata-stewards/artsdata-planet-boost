    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Audrey is a trombonist, composer and vocalist based in Edmonton and is thrilled to be releasing her fifth album, \"The Sorceress\" at Yardbird Suite."
      }
