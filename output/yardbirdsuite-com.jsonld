    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "For this performance, honouring Black History Month, Mboya Nicholson and the Shortkestra (only 9 musicians, so its a short orchestra!), delves into the repertoire of several great pioneers."
      }
    ],
