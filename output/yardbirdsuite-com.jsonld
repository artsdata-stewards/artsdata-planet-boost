    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Marco Claveria was born in Santiago Chile. He started guitar lessons at the age of ten, learning to play the basics of Chilean folk music then moving on to study different styles such as Cuecas, Tonadas, and the Resbaloza as well as the Argentinian Samba."
      }
    ],
