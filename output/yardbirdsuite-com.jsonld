    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Melafrique - The Yardbird Suite"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Melafrique is a dynamic Afro-fusion band formed in Edmonton, Canada, in 2016, with a mission to bridge cultures and inspire global audiences through music. The name “Melafrique” blends “Melanin” and “Africa,” symbolizing the band’s celebration of African and diasporic heritage. Drawing from a rich mix of genres–Soul, R&B, Reggae, Pop, Jazz, Neo-soul–and traditional African rhythms, … Continued"
      }
    ],
    "http://ogp.me/ns#url": [
