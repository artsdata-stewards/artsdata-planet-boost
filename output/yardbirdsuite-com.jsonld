        "@language": "en-us",
        "@value": "Kinva - The Yardbird Suite"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "\"Kinva\" in Ukrainian means a traditional wooden mug-like vessel, used both for storing and consuming liquids. The band is such a vessel: they preserve traditional ethnic Ukrainian melodies in order to serve them in a fresh, jazz form."
      }
    ],
