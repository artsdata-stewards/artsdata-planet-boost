  {
    "@id": "https://yardbirdsuite.com/shows/josh-krushel-trio-edmonton/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
