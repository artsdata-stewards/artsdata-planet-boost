    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Running, Running is a jazz-rooted collective that traverses diverse landscapes by combining music and poetry. They take inspiration from the prairies, rustic homesteads, and still mornings as they navigate terrain that is as melancholic as it is sublime."
      }
    ],
