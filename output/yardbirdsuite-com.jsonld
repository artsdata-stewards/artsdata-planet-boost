    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Following a series of sold-out performances in the Bay Area, Ron Jackson’s “Flubby Dubby” Hammond Organ Soul-Jazz Band continues to build momentum with a monthly residency at The Django in New York City, one of NYC’s premier jazz venues."
      }
