    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The Tiegen Costa Quartet strives to bring elements of post-60s contemporary bop and combine them with strong roots in blues/soul music."
      }
    ],
    "http://ogp.me/ns#url": [
