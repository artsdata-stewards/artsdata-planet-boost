    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Evening: Jazz Hutch Quintet: Al Muirhead's 90th Birthday Celebration"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Twice JUNO- nominated Al Muirhead is known as the Elder Statesman of Jazz Trumpet in Alberta and was recently inducted into the YYC Music Awards Hitmakers Hall of Fame. As one of Al Muirhead’s 90th Birthday Celebrations he will be featured with Jazz Hutch Quintet, remembering Chet Baker and more. Calgary's Jazz Hutch Quintet, including some of Alberta’s top jazz musicians, is led by twice YYC Music Awards Nominee vocalist Jazz Hutch (aka Jim Hutchison)."
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
