    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Edmonton songstress Dana Wylie has a long history with the music of the legend of French chanson Edith Piaf, having wowed audiences with her interpretations of the Little Sparrow starting with her 2003 Fringe hit Tempo de Java."
      }
