        "@value": "Julia Vari - The Yardbird Suite"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Julia Vari is from Florida, and is regarded as “one of the top Latin American jazz singers of our time” (George Varga, San Diego Union-Tribune)."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
