    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Cikwes"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "In the spirit of truth and reconciliation Yardbird Suite presents Cikwes, a nehiyaw soul singer, JUNO nominee from Bigstone Cree Nation, and one of Canada’s unique artists; composing music with the ancient art of chanting &amp; hand drumming while deftly blending it with soul, jazz, and RnB."
      }
    ],
