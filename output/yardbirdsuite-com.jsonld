    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Innovative and electrifying, Toronto jazz drummer Ernesto Cervini has energy to burn, whether radiating it from behind his kit or working on any number of musical and educational projects."
      }
    ],
