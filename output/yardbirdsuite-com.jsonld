    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Second Cycle is the second record for the jazz ensemble led by guitarist and composer Sylvain Cossette, but the first to appear on the Les Disques du 10 Avril label."
      }
    ],
