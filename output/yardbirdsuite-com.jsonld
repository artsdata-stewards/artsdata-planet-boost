  {
    "@id": "https://yardbirdsuite.com/shows/bill-richards-quartet/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Bill Richards Quartet - The Yardbird Suite"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Bill Richards (pianist/composer/arranger) will be joined by Bob Tildesley (trumpet), Paul Johnston (bass) and Dave Laing (drums) to present several of Bill’s jazz compositions, including new works written with this quartet in mind, as well as some jazz standards."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://yardbirdsuite.com/shows/bill-richards-quartet/"
      }
    ],
