      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "This Edmonton singer, songwriter, guitar player, storyteller and funnyman will showcase material from his CKUA chart topping new album ‘The Story That Lived Here’ and from his ten-album back catalog."
      }
    ],
