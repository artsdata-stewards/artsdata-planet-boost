  {
    "@id": "https://yardbirdsuite.com/shows/naughty-nanises-next-nice-holiday-cabaret/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Naughty Nanise’s Next Nice Holiday Cabaret - The Yardbird Suite"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "This winter be sure to come cozy up at the Yardbird Suite for another rendition of Nanise’s Next Nice n Naughty Holiday Cabaret, a splendid evening of chosen family & friendships woven together via music, poetry, drag, and burlesque."
      }
    ],
    "http://ogp.me/ns#url": [
