    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "In 2001, Edmonton jazz musician Don Berner launched his debut album Sextet, a straight ahead album of original compositions in the spirit of Art Blakey's Jazz Messengers or Bobby Watson's Horizon, leading to international airplay and touring."
      }
    ],
