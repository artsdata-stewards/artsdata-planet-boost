    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "LINA ALLEMANO FOUR - The Yardbird Suite"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The TD Edmonton International Jazz Festival is proud to present the LINA ALLEMANO FOUR at the Yardbird Suite. This acoustic chamber-jazz quartet will share Allemano’s original music, written specifically for the group with a mandate of strong group interaction, improvisation, and sonic exploration."
      }
    ],
    "http://ogp.me/ns#url": [
