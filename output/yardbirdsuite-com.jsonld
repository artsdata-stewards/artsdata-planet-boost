    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "2025 JUNO Nominee for Best Jazz Album of the Year (Group), Raagaverse, led by vocalist Shruti Ramani, is a creative Indo-Jazz fusion band that pays homage to the two deeply historical and culturally-significant genres: classical Hindustani music and Jazz."
      }
    ],
