    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "During the past decade, Jessica Ackerley has established themselves on the Canadian and American music scenes as a unique and versatile guitarist, composer and improvisor. Born in Alberta, Canada, Jessica now resides in Honolulu after almost decade of being located in New York City."
      }
