    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Tuesday Jam - hosted by Up and Over Trio - The Yardbird Suite"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Up and Over Trio is Alberta’s hottest new modern jazz group featuring Galaxie Rising Star Award recipient Chris Andrew on piano, 2018 WCMA Jazz Artist of the Year winner Rubim de Toledo on bass, and Alberta’s top call jazz drummer Jamie Cooper. Between them, they have accompanied some of the world’s leading jazz artists and, as a trio, have worked extensively since 2016 backing the who’s who of Albertan talent."
      }
    ],
    "http://ogp.me/ns#url": [
