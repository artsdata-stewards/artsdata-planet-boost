    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The Ladies of Jazz blend the sophistication of traditional jazz with the playful reinvention of postmodern pop—think Ella Fitzgerald meets contemporary hits, all driven by a tap-dancing drummer who makes rhythm a visual spectacle."
      }
