        "@value": "Bones from Underground - The Yardbird Suite"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "This group embarked on their first musical journey in 2019 with the release of their debut album, Bones from Underground. But their origin goes back earlier to when the band members made significant steps in the freelancing and teaching music world."
      }
    ],
