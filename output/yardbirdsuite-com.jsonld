    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "High Society Jazz Band  Tribute to Kid Ory - The Yardbird Suite"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Edward \"Kid\" Ory was one of the most important figures in early jazz music. He had an international career and played with or mentored many of the later iconic jazz figures. The High Society Band is pleased to present this tribute, featuring Edmonton's own, Peter Filice, on the trombone."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
