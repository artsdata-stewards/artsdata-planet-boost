    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Like the the point where two rivers meet, Brett Hansen’s Confluence blends the improvisational elements of contemporary jazz with the thoughtful sensitivity of folk music to create lush compositional soundscapes."
      }
    ],
