    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Freely improvised music is all about connections. No score, no predetermined idea of what will be played, it only relies on the connection between musicians in order to communicate ideas with each other and with the audience, who are so often an integral part of the spirit of this music."
      }
    ],
