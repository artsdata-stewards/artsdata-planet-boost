      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://yardbirdsuite.com/shows/riebl-tedesco-mcgill-of-the-cat-empire/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Riebl Tedesco McGill (of The Cat Empire)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Riebl Tedesco McGill is a new collaborative project bringing together three of Australia’s most accomplished and genre-defying musicians. Felix Riebl, Richard Tedesco, and Ollie McGill share decades of experience across diverse musical worlds, now combining their talents in an intimate and compelling trio project. Blending songwriting, instrumental mastery and deep musical storytelling, the ensemble creates an immersive listening experience that’s as rich in texture as it is in spirit. Melbourne artist Felix Riebl is a globetrotting frontman and storyteller (the Cat Empire) whose latest solo album, Everyday Amen, finds joy in the contrast between stadium stages and domestic stillness. Flamenco guitarist Richard Tedesco, a pillar of the Australian flamenco scene for over three decades, brings fiery emotion and technical brilliance drawn from a lifetime of devotion to his craft. Ollie McGill, best known as the founding pianist of The Cat Empire, is a versatile composer and improviser whose work spans jazz, neo-classical, and award-winning pop. Performing under the name Riebl Tedesco McGill, the trio present a curated blend of original works and arrangements drawn from their respective solo projects and collaborations - including moments from The Cat Empire’s rich catalogue. Designed for intimate venues, their performances offer a window into&hellip;"
      }
    ],
