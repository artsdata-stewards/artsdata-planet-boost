    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Spanish Flamenco singer/percussionist Francisco Orozco \"Yiyi\" joins leading Canadian Flamenco dancers and musicians, from across the Prairies to the west coast, for an intimate evening of Flamenco dance, guitar, piano, and song."
      }
    ],
