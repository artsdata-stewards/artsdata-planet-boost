        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Tuesday Jam Hosted by J.J. Group - The Yardbird Suite"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "It can be said that the motto of the J.J. Group is “throw stuff at the wall and see what sticks!” Comprised of Jacob Tanner on drums and JUNE on piano, the group seeks to dive into the tradition of the jazz jam session and explore the exhilarating feeling of improvisation. Never fearing mistakes, the goal is to play, experiment, and above all have fun with the music."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://yardbirdsuite.com/shows/tuesday-jam-hosted-by-june-ulloa-neilson/"
      }
    ],
