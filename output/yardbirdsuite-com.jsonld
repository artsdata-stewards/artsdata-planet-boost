    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Pretzil Stex is a new jazz quartet collaboration between Jeff Presslaff (piano), Matt Steckler (sax), Eric Platz (drums) and James Hamilton (bass), borne of sessions at Brandon University."
      }
    ],
