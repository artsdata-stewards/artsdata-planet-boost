  {
    "@id": "https://yardbirdsuite.com/shows/domi-edson/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
