    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Acclaimed guitarist, singer, song writer, band leader and producer, Jack de Keyzer rarely sits still. For 46 years or roughly a couple million miles , de Keyzer has been hitting the road , air and studio to bring his brand of guitar driven blues around the globe."
      }
    ],
