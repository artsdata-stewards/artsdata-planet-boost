    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "This special night is hosted by a quartet of beloved Edmonton musicians who are home to spend the holidays with family and hang out with old friends at the Yardbird Jam, where they spent many Tuesday nights early in their careers."
