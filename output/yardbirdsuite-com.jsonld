      {
        "@language": "en-us",
        "@value": "Gabriel Zacharias Bossa Nova Quintet - The Yardbird Suite"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Gabriel Zacharias, born and raised in São Paulo, Brazil and now based in Calgary, is an artist who embodies the essence of his country’s music: the syncopated rhythms of Samba, the sophisticated harmonies and melodies of Bossa Nova, and a style that is both refined and accessible."
      }
    ],
