    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Brett Miles is returning to the Yardbird Suite to lead the first \"tribute\" show in his long career.  \"Playing the compositions of Donny Hathaway and Roberta Flack is something I always wanted to do.\""
      }
    ],
