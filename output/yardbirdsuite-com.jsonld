    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Vertrek Ensemble was born in 1997 by two like-minded musicians and friends, Vadim Budman and Ron de Jong, out of their frustration with conventional music-making and their love for ground zero free improvisation."
      }
    ],
