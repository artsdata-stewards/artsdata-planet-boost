        "@language": "en-us",
        "@value": "SOLD OUT River City Big Band Swing into Christmas - The Yardbird Suite"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Get into the Christmas season with the River City Big Band and guest vocalist Chandelle Rimmer as they perform many of your holiday favorites, including Carol of the Bells, We Three Kings, Jingle Bells, and Frosty the Snow Man."
      }
    ],
