    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Tuesday Jam Hosted by Josh Krushel - The Yardbird Suite"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Both connected to the deep roots of Black American Music while looking forward to the future of experimental, theoretical techniques - Krushel’s music is just as thought-provoking as it is pleasurable."
      }
    ],
    "http://ogp.me/ns#url": [
