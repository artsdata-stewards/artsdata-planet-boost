    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Tuesday Jam Hosted by Canadian Dreams Quintet"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The Canadian Dreams Quintet is 5 members from Edmonton’s busiest Salsa band - Manny V. Y Esquina Latina. This quintet format focuses more on Latin jazz style music - boleros, cha cha cha, danzón, son and guaracha. As Latino Canadians now established with careers, family and music in Canada we find ourselves living the Canadian Dream. The set involves very well known Puerto Rican and New York (a hub of Salsa and its origins) songs. Expect beautiful montunos, percussive and vibrant sounds to light up the Yardbird stage. Band members: Manny Valencia - Congas Alex Corzo - Piano Víctor Sánchez - Baby Bass Alessandro Cortez - Sax Edgar Cruz - Vocal Our live Tuesday Jam is hosted by a musician and a band while audience members join in on the fun by jamming along on stage. Musicians who want to participate in the Jam can purchase a \"Jam Participant\" ticket at a reduced cost. All Jam Participants need to register at the door upon entry to the event."
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
