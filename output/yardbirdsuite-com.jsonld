    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "With a voice that is at once \"soft, sweet, confident and assured\" (CBC Music: Top Canadian Jazz Musicians under 35 List), Ellen Doty combines her love of Jazz with the influences of the great songwriters of our time."
      }
    ],
