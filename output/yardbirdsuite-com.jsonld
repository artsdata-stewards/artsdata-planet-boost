        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "An intimate evening of song with Thomas Alexander and friends - The Yardbird Suite"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Thomas Alexander began his career playing with The Patchwork Quilt in 1968 to being in Edmonton’s first Fund band The Key, rocking with Southbound Freeway, and more recently, his solo work, inspired by musical legends like Jimi Hendrix, Stevie Wonder, Aretha Franklin, Billy Eckstine, Ella Fitzgerald."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://yardbirdsuite.com/shows/an-intimate-evening-of-song-with-thomas-alexander-and-friends/"
