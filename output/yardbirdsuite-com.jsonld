  {
    "@id": "https://yardbirdsuite.com/shows/yardbird-suite-virtual-series-purposefully-misleading-ingredients/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Yardbird Suite Virtual Series Purposefully Misleading Ingredients - The Yardbird Suite"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Purposefully Misleading Ingredients (Eric Weiden and Trent Wilkie) present An Evening of Music and Ideas. Weiden will play trumpet over music that he has pre-composed, while Wilkie has prepared a tickle trunk of Ideas. Together, they will walk you through a crafted thematic journey full of tasty trumpet licks and interactive humour."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://yardbirdsuite.com/shows/yardbird-suite-virtual-series-purposefully-misleading-ingredients/"
      }
