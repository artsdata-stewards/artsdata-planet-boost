  {
    "@id": "https://yardbirdsuite.com/shows/emerging-artist-presents-byrne-mcmullen/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Emerging Artist Presents The Byrne McMullen Quintet - The Yardbird Suite"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Byrne McMullen is an up-and-coming jazz saxophonist, composer, and bandleader in Edmonton. He is known for his warm, full tone and commitment to creating a sound authentic to the jazz language and tradition."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://yardbirdsuite.com/shows/emerging-artist-presents-byrne-mcmullen/"
      }
    ],
