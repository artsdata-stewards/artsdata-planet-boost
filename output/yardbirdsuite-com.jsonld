    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "The Mboya Nicholson Trio - The Yardbird Suite"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Jazz pianist Mboya Nicholson leads a trio of stellar musicians in an evening of music including original compositions from his latest solo piano recording Melodic Faces."
      }
    ],
    "http://ogp.me/ns#url": [
