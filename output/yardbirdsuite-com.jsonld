    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "We broadcast live from the Yardbird Suite. There are no audiences other than the performers and audio technicians who are physically distant, do not share the same equipment, nor come into contact with each other. Every effort has been made to comply with AHS safety guidelines."
      }
