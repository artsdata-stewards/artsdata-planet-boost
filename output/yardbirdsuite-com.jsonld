        "@language": "en-us",
        "@value": "Matinee: John Reischman & the Jaybirds - The Yardbird Suite"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Like the powerful mandolinist and composer at its helm, John Reischman and the Jaybirds fashion a stylish take on bluegrass that seamlessly blends original songs and instrumentals with Appalachian old-time music for a truly unique band sound."
      }
    ],
    "http://ogp.me/ns#url": [
