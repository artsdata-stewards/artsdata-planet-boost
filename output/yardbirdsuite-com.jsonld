  {
    "@id": "https://yardbirdsuite.com/shows/tuesday-jam-hosted-by-june-ulloa-neilson/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
