    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "It’s smart, it’s soulful, it’s jazz meets groove. Sillanpaa's vocals are expertly clear, gently raw, and intensely bold as she performs slick soul, pop and jazz to dig your heels into."
      }
    ],
