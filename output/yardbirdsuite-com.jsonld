    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Joel Jeschke is a sought-after drummer and composer not bound by genre. Having performed and recorded with countless artists including rock bands such as Royal Tusk (MNRK Records) and Whale and the Wolf, to modern jazz artists; Aretha Tillotson, Stephanie Urquhart Quartet and Brett Hansen."
      }
