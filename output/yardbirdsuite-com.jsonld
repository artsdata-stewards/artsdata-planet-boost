  {
    "@id": "https://yardbirdsuite.com/shows/the-queens-rb-hip-hop-cabaret/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
