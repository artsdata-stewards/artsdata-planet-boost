    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Queen Kong - The Yardbird Suite"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Led by Toronto drummer, composer, Lorie Wolf, Queen Kong seamlessly blends Ashkenazi Jewish idiom with jazz, free improv, rock and punk to explore new sounds and ideas."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
