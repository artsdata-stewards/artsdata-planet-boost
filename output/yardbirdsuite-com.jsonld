    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Domi Edson - The Yardbird Suite"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Domi Edson, a 26-year-old bassist, exudes a musical maturity that defies her age. Her bass-playing skills showcase a rich tone and seasoned swing, traits typically associated with artists twice her senior. Edson’s impressive resume includes performances with renowned figures like Terrell Stafford, Charles McPherson, Dawn Clement, and more, cementing her status as a rising star … Continued"
      }
    ],
    "http://ogp.me/ns#url": [
