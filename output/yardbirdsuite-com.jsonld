        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Joe Piccolo presents Louis, Louis, Louis - The Yardbird Suite"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "What could be better than 1 Louis? 3 Louis of course! Louis, Louis, Louis celebrates the music of the big 3 Louis. Louis Armstrong, Louis Jordan and Louis Prima….MOP!"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
