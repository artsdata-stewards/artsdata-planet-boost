      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Sandro Dominelli, drums Live from Yardbird Suite. Sandro Dominelli is one of Canada’s most creative, talented and tasteful drummers. Through his continuing success as a much sought-after composer, bandleader, side man, and producer, he has proven to be an established luminary in the Canadian music scene. Sandro’s musical sensibilities have caught the attention of international … Continued"
      }
    ],
