        "@language": "en-us",
        "@value": "Itamar Erez - The Yardbird Suite"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Itamar Erez's music holds a depth and sensitivity that touches listeners deeply. It blends the delicateness of Middle Eastern music, the freedom found in jazz and the passion of flamenco, creating a unique sound all his own."
      }
    ],
