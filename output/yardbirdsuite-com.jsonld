    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Tuesday Jam Hosted by Renée Vinagreiro"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Renée Vinagreiro is a jazz saxophonist and composer currently based in-between Toronto and Edmonton. With influences from a wide array of genres, both traditional and contemporary, she brings a variety of music &amp; sounds to the table. Influenced by artists such as Melissa Aldana, Seamus Blake, Joni Mitchell, and Michael Brecker; she showcases this through her own smorgasbord of modern jazz. Renée has recently completed her Bachelor of Music at MacEwan University and is currently pursuing a Master of Music at the University of Toronto with a focus in music therapy. Our live Tuesday Jam is hosted by a musician and a band while audience members join in on the fun by jamming along on stage. Musicians who want to participate in the Jam can purchase a \"Jam Participant\" ticket at a reduced cost. All Jam Participants need to register at the door upon entry to the event."
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
