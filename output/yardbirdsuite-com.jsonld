  {
    "@id": "https://yardbirdsuite.com/shows/tuesday-jam-hosted-by-quiddity/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Tuesday Jam Hosted by Quiddity - The Yardbird Suite"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The brainchild of Edmonton drummers Tony Flanagan and Braeden Detert, Quiddity is an experimental double-drum project resulting from the duo's willingness to delve into a new and challenging improvisational landscape."
