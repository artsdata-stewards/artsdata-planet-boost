      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Yardbird Suite Vocalist Tribute Show - The Yardbird Suite"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "A fitting finale to the 65th Anniversary weekend, join us as we pay tribute to Edmonton vocalists who have graced our Yardbird Stage including Judi Singh, Big Miller, Rollanda Lee, Sue Moss, and more. Band leader Joel Gray leads a star-studded group of Edmonton's finest musicians and features Edmonton vocal icons Rhonda Withnell, Shelley Jones, Dave Babcock, and Mallory Chipman, with a special appearance by the future of Edmonton jazz, the Yardbird's own Littlebirds Jazz Combo."
      }
    ],
    "http://ogp.me/ns#url": [
