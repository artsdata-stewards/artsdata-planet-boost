    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The Kent Sangster Quintet, featuring trumpet extraordinaire, Brian O’Kane, kicks off the 65th season of the Yardbird Suite, exploring the music of Cannonball Adderley, Bill Evans, Bobby Timmons, Victor Feldman, Quincy Jones and even a few originals."
      }
    ],
