    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "With a passion for both jazz and traditional Latin music, Lisi Sommer is thrilled to bring these two loves together for this special Latin edition of the Tuesday jam, along with her favourite Afro-Cuban jazz musicians Chris Andrew and Rubim De Toledo."
      }
    ],
