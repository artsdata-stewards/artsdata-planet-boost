    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "The Tricia Edwards Quintet - The Yardbird Suite"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Tricia Edwards’ musical journey has taken many diverse paths. With formative years spent training and performing as a classical pianist, to more recent years playing in the jazz idiom, to her current passion in exploring the world of latin music, Tricia seeks to incorporate all of these languages into her musical expression."
      }
    ],
