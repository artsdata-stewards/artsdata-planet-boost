  {
    "@id": "https://yardbirdsuite.com/shows/okan/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "OKAN - The Yardbird Suite"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Fusing Afro-Cuban roots with jazz, folk and global rhythms in songs about immigration, resistance and love, OKAN takes their name from the word for heart in their Afro-Cuban religion of Santeria."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://yardbirdsuite.com/shows/okan/"
      }
    ],
