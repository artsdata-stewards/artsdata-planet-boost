    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Charlie Austin, formerly of Grant MacEwan Music (retired), has been playing in Edmonton for decades, working with Tommy Banks on several iconic TV series most notably 2nd City TV in the early 80s."
      }
