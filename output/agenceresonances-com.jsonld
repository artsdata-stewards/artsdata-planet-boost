    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Arts Trail Series. Maître percussionniste, l'auteur, compositeur et interprète d'origine sénégalaise Élage Diouf crée une musique, hybride de pop, world, blues, folk et asiko. Pour la musicalité de la langue, il chante principalement en wolof, sa langue maternelle."
      }
