      {
        "@language": "fr",
        "@value": "Bloom - Châteauguay (QC) | resonances"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Bloom est un documentaire sur le processus créatif suivi d’un spectacle live, résultat scénique de ce processus documenté. Le spectateur vivra l’expérience complète des premiers balbutiements d’une idée, au travail artistique de cette idée, à l’aboutissement scénique final de ce processus."
      }
