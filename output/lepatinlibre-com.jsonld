    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Performance of the contemporary ice skating show Murmuration by Le Patin Libre. \n\nThis performance is part of the CAM en tournée program.\n\nAfter the show, skaters invite spectators for an ice dance party with a DJ and a short dance workshop."
