      {
        "@language": "fr",
        "@value": "https://static.wixstatic.com/media/9dcf47_4f7bc40dcd1c476aa2375925f8103aea~mv2.jpg/v1/fill/w_4135,h_2070,al_c,q_90/9dcf47_4f7bc40dcd1c476aa2375925f8103aea~mv2.jpg"
