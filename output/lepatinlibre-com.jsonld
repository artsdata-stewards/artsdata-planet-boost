  {
    "@id": "https://www.lepatinlibre.com/d-tails-et-inscription/murmuration-umea-sweden-2024-01-05",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Murmuration - Umea, Sweden, 2024-01-05 | Le Patin Libre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "<p>Canadian Le Patin Libre is the company that surprised the dance world with its frozen choreography. Inspired by the astonishing aerial ballets of flocks of birds, 15 skaters take us on a unique dance experience. Flying high and with dramatic changes of direction, they explore the dynamic interaction of a pack life, all in a powdery cloud of ice crystals.</p>"
      }
    ],
