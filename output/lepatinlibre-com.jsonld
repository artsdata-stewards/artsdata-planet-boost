  {
    "@id": "https://www.lepatinlibre.com/d-tails-et-inscription/auditions-a-montreal-2024-04-21-16h30",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Auditions à Montréal - 2024-04-21, 16h30 | Le Patin Libre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Pour patineurs experts seulement (hockey ou artistique).\nL'audition est gratuite mais sur invitation, seulement.  Envoyez un vidéo de votre patinage (lien ou fichier) au alex@lepatinlibre.com.  L'audition prendra la forme d'une initiation à notre technique chorégraphique qui dure 1h."
      }
    ],
