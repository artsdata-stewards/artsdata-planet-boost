    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Performance of the contemporary ice skating show Murmuration by Le Patin Libre. \n\nA co-presentation by La Rotonde and the Grand Théâtre de Québec.\n\nAfter the show, skaters invite spectators for an ice dance party with a DJ and a short dance workshop."
