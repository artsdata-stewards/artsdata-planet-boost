        "@value": "For expert skaters only (figure skaters, hockey players, freestylers).&#010;The audition is free but upon invitation only.&#010;To be invited: send a video (link or file) of your skating at alex@lepatinlibre.com.&#010;The audition is a 45 minutes workshop about the basics our choreographic technique."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
