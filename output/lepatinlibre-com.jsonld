  {
    "@id": "https://www.lepatinlibre.com/d-tails-et-inscription/16-avril",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Le Patin Libre / Murmuration"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Fascinants de rigueur, d’enthousiasme et de virtuosité, les artistes du Patin Libre sont aujourd’hui 15 et toujours aussi vites sur leurs patins ! Les voici sur les traces de nuées d’oiseaux. Du patin de haute volée, vertigineux."
      }
    ],
    "http://ogp.me/ns#image": [
