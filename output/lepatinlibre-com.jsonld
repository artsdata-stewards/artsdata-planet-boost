      {
        "@language": "en",
        "@value": "Murmuration - Vancouver, Canada, 2025-03-21"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Fascinating in their rigor, enthusiasm, and virtuosity, the Patin Libre artists are now 15 and still as fast as ever on their skates! Here they follow in the footsteps of flocks of birds. High-flying and dizzying skating.&#010;&#010;Presented with community partner Canada Ice Dance Theatre. "
      }
    ],
