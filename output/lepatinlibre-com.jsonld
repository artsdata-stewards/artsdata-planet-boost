  {
    "@id": "https://www.lepatinlibre.com/en/d-tails-et-inscription/le-patin-libre-sur-roulettes-varennes",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Le Patin Libre sur roulettes, Varennes | Le Patin Libre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Vendredi 25 juillet 2025 - 18h à 21h\nGratuit, aucune inscription nécessaire\nParc du Pré-Vert, Varennes\nLe Polydôme de Varennes se transformera en roulathèque.  Le Patin Libre fera de petites apparitions et donnera des conseils pour bien patiner, danser et fêter sur roulettes."
      }
    ],
