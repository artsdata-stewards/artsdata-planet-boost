    "@id": "https://www.lepatinlibre.com/en/d-tails-et-inscription/seminaire-seminar",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Séminaire / Seminar | Le Patin Libre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Séminaire pour patineurs avancés sur les bases chorégraphiques et techniques du Patin Libre.  2 jours, 6h on ice, 2h off ice, party.\nSeminar for advanced skaters about the choreographic and technical bases of Le Patin Libre.  2 days,  6h on ice, 3h off, party."
      }
    ],
