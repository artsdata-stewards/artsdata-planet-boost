  {
    "@id": "https://www.lepatinlibre.com/en/d-tails-et-inscription/murmuration-gatineau-canada-2025-03-29",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Murmuration - Gatineau, Canada, 2025-03-29 | Le Patin Libre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Performance of the contemporary ice skating show Murmuration by Le Patin Libre. \n\nThis show is a co-production of the National Arts Centre.\n\nAfter the show, skaters invite spectators for an ice dance party with a DJ and a short dance workshop."
      }
    ],
