        "@value": "Wheels and cello - Seoul, Korea | Le Patin Libre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Our roller-skating street show, for the Seoul Street Arts Festival.\nMultiple performances from Sept. 16th to 18th.\nFree, outdoor.\nAll info here: https://www.ssaf.or.kr/program/program/455"
      }
    ],
    "http://ogp.me/ns#image": [
