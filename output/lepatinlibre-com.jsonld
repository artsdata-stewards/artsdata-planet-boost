        "@value": "Venez faire la fête sur la glace avec les artistes-patineurs de la compagnie Le Patin Libre.&#010;Bonne musique, éclairages, ambiance festive, jeux de danse, pour toute la famille.&#010;Apportez vos patins ou empruntez les nôtres.&#010;Gratuit, réservation facultative, &quot;drop-in&quot; bienvenue."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
