      {
        "@language": "en",
        "@value": "https://static.wixstatic.com/media/4c971f_7dfc4ebd57f548b9b72de261a8225213~mv2.jpg/v1/fill/w_3307,h_1731,al_c,q_90/4c971f_7dfc4ebd57f548b9b72de261a8225213~mv2.jpg"
      }
