  {
    "@id": "https://www.lepatinlibre.com/d-tails-et-inscription/party-sur-glace-hochelaga-20h-15-nov-2024",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Party sur glace - Hochelaga, 20h, 15 nov. 2024 | Le Patin Libre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Venez faire la fête sur la glace avec les artistes-patineurs de la compagnie Le Patin Libre.\nBonne musique, éclairages, ambiance festive, jeux de danse, pour toute la famille.\nApportez vos patins ou empruntez les nôtres.\nGratuit, réservation facultative, \"drop-in\" bienvenue."
      }
    ],
