        "@value": "Over A Rainbow &#8211; Performance au 5e anniversaire du Festival Fringe d&rsquo;Azores"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "&lt;p&gt;Après un processus de candidature rigoureux, Over A Rainbow a été sélectionné pour être présenté au Festival Fringe d\\'Azores. &nbsp; 36 000 images de tous les jours, de la vie et de l\\'amour s\\'accumulent et scintillent dans l\\'ordre de l\\'arc-en-ciel...&lt;/p&gt;\\n"
      }
    ],
