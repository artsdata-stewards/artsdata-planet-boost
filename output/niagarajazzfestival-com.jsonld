        "@id": "https://niagarajazzfestival.com/wp-content/uploads/2019/01/Ellington-button.png"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://niagarajazzfestival.com/events/live-learn-jazz-women-of-the-hour-ellington/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
