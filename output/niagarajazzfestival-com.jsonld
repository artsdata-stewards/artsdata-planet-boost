        "@language": "en-ca",
        "@value": "VASILY SHUGAEV"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Vasily Shugaev was born in St. Petersburg Russia, but was raised and lived most of his life in Richmond Hill, Ontario. He first discovered his love for music with the piano which he played since…"
      }
    ],
