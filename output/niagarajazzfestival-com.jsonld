        "@value": "BUCKY BERGER"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Bucky Berger has been a professional musician for over 51 years and still going strong. He has recorded many albums over the years and has had a wide and varied career touching on many genres…"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://niagarajazzfestival.com/wp-content/uploads/2021/06/Bucky-Berger-e1622649788777.jpg"
