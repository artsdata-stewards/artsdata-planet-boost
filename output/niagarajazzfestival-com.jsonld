        "@id": "https://niagarajazzfestival.com/wp-content/uploads/2019/02/Back-yard-TSzczesniak-2019.png"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://niagarajazzfestival.com/events/in-your-own-backyard-twilight-piano-jazz-series-2nd-edition-part-one/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
