        "@id": "https://niagarajazzfestival.com/wp-content/uploads/2022/07/Tom-Szczesniak-Free-Event-Sq.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://niagarajazzfestival.com/events/jazz-crawl-tom-szczesniak-trio/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
