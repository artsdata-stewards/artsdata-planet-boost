    "http://schema.org/image": [
      {
        "@id": "https://niagarajazzfestival.com/wp-content/uploads/2025/06/Snakebite-session-ShowcaseJUNE-20-29-PRESENTED-BY-Snakebite-Session-QNA-PAY-WHAT-YOU-CAN-With-Influencer-Entertainer-Archie-J.-The-Snake-Charmer-At-the-University-of-Niagara-Falls-Canada-Mon-2.png"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://niagarajazzfestival.com/events/the-snake-charmer-snakebite-session/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://niagarajazzfestival.com/events/the-snake-charmer-snakebite-session/"
