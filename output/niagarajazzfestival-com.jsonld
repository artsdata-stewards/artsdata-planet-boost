    "http://schema.org/image": [
      {
        "@id": "https://niagarajazzfestival.com/wp-content/uploads/2024/06/Ashley-St.Pierre-Trio.png"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://niagarajazzfestival.com/events/jazz-crawl-pop-up-1/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
