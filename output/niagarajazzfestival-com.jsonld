    ],
    "http://schema.org/url": [
      {
        "@id": "https://niagarajazzfestival.com/events/livestream-love-jazz-series-42-with-bill-mays/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://niagarajazzfestival.com/events/livestream-love-jazz-series-42-with-bill-mays/"
