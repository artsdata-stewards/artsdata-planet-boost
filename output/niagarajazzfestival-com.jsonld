        "@language": "en-ca",
        "@value": "Niagara Jazz Festival"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "SAMMY JACKSON"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "JUNO Award-winning artist Sammy Jackson is an emerging Jamaican-Canadian singer-songwriter recognized for her distinct sound, fusing elements of Jazz, R&B and Pop. Growing up, she regularly found opportunities to perform and develop as a musician…"
      }
    ],
    "http://ogp.me/ns#image": [
