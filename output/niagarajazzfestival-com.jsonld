    "http://schema.org/url": [
      {
        "@id": "https://niagarajazzfestival.com/events/reg-schwager-duo-in-your-own-backyard-2020-guitar-series-part-three/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
