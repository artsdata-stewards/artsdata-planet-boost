    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "FEATURING: CINNAMON JONES and friends Date:  Saturday, July 27, 2019 Time:  8 pm – 11 pm Venue:  The Hare Wine Co. Address: 2059 Niagara Stone Rd, Niagara-on-the-Lake Website: www.theharewineco.com Price:  $59 (Regular) / $29 (Students…"
