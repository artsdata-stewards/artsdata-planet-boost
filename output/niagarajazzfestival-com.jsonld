    "http://schema.org/image": [
      {
        "@id": "https://niagarajazzfestival.com/wp-content/uploads/2020/06/Chris-Gestrin-Landscape.png"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://niagarajazzfestival.com/events/livestream-love-jazz-series-28-featuring-chris-gestrin/"
