    ],
    "http://schema.org/url": [
      {
        "@id": "https://niagarajazzfestival.com/events/livestream-love-jazz-series-44-with-ashley-st-pierre/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
