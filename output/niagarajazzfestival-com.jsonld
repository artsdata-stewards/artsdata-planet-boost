        "@id": "https://niagarajazzfestival.com/events/twlight-jazz-blues-series-alexis-baro-quartet/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://niagarajazzfestival.com/events/twlight-jazz-blues-series-alexis-baro-quartet/"
