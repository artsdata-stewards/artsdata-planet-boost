      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "DATE:            Tuesday, May 19, 2020  TIME:              6:00 pm – 7:00 pm EST  VENUE:          Shady Acres Studio (St. Catharines) and New Orleans (This event will be Live streamed)  PRICE:            FREE (Donations accepted)                    Christopher Butcher              Windex Pete      * Please note that donations accepted help the TD Niagara Jazz Festival (Registered Charity: #80107-7033-RR0001) continue to bring live music to Niagara and beyond. Thank you for supporting the arts!  [embed]https://www.youtube.com/watch?v=sgfDhb3H2XA[/embed]  &nbsp;  ABOUT CHRISTOPHER  ABOUT WINDEX PETE  To donate and help support the festival:      &nbsp;            WORKSHOP DESCRIPTION:    Join Christopher Butcher (our New Orleans correspondent) and Windex Pete (New Orleans local) to learn about the history of New Orleans and Mardi Gras as well as discover some of the sights the city has to offer. Tremé, Congo Square,the French Quarter and more!"
      }
    ],
