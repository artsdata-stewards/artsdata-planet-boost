    "http://schema.org/url": [
      {
        "@id": "https://niagarajazzfestival.com/events/in-your-own-backyard-guitar-series-featuring-roy-patterson/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
