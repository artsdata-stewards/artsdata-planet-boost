    "http://schema.org/image": [
      {
        "@id": "https://niagarajazzfestival.com/wp-content/uploads/2021/01/Vox-Violins-New-scaled-e1616166613692.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://niagarajazzfestival.com/events/twilight-jazz-series-40-years-of-making-music/"
