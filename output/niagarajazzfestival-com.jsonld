    "http://schema.org/image": [
      {
        "@id": "https://niagarajazzfestival.com/wp-content/uploads/2020/07/BERNIE-SENENSKY-1280x720-3.png"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://niagarajazzfestival.com/events/livestream-love-jazz-series-38-with-bernie-senensky/"
