    ],
    "http://schema.org/url": [
      {
        "@id": "https://niagarajazzfestival.com/events/td-njf-presents-international-jazz-day-celebrating-the-jazz-greats/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://niagarajazzfestival.com/artists/chris-northington/"
