    "http://schema.org/image": [
      {
        "@id": "https://niagarajazzfestival.com/wp-content/uploads/2026/03/Miguel-Square-SHOWPASS-8.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://niagarajazzfestival.com/events/twilight-jazz-blues-series-cuban-jazz-night-miguel-de-armas-trio/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
