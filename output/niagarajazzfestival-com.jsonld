      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://niagarajazzfestival.com/events/twilight-jazz-blues-series-get-hooked-dizzy-fay/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://niagarajazzfestival.com/events/twilight-jazz-blues-series-get-hooked-dizzy-fay/"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "  📅DATE: Monday, June 1st, 2026  🕑TIME: 7 pm – 9:30 pm  🏟️VENUE: The Hare Wine Co.  🗺️ADDRESS: 789 Niagara Stone Road, Niagara-on-the-Lake, ON  💵PRICE (REGULAR): $39 + HST + FEES  💵DISCOUNT (Promo Code - MAWSU-2026): -50% (19.50) + HST + FEES   (Musicians/Arts Workers/Students/Under 30)  🍕 FOOD: Snack foods available on site.   🍷DRINKS: Wine by the glass available  🚗 PARKING: Free on site     *Doors at 6 pm / Concert starts at 7 pm                 BUY TICKETS          BUY a SERIES PASS      ABOUT THE SHOW and the ARTISTS          🎶 GET HOOKED!🎶        Back by popular demandJoin Dizzy &amp; Fay - Mark Lalama and Amanda Walther - for a night of original songwriting. Their music sits at the intersection of contemporary jazz and singer-songwriter intimacy, resonating with both jazz enthusiasts and broader audiences. Praised for their dynamic live chemistry, Dizzy &amp; Fay create an atmosphere that feels alive, spontaneous, and deeply connected; hooking you in with every song.      Dizzy / Mark Lalama:  Piano  Fay / Amanda Walther:  Vocals                          BUY TICKETS          BUY a SERIES PASS                              Presented by    Juliet Amanda Dunn Entertainment                     In partnership with          Sponsored by:                          BUY TICKETS          BUY a SERIES PASS                                        PLEASE NOTE:      Tickets are non-refundable.    For more details, please email Darlene at admin@niagarajazzfestival.com                        "
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Twilight Jazz %26 Blues Series - Get Hooked! - Dizzy %26 Fay"
      }
    ],
