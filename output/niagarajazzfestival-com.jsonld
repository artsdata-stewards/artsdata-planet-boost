        "@id": "https://niagarajazzfestival.com/wp-content/uploads/2017/09/JBryan-cropped.png"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://niagarajazzfestival.com/events/holiday-guitar-magic-james-bryan-duo/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
