    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "EVENT: Twilight Jazz Series: St. Catharines edition – The Shea D Bunch does Sade and more...  DATE: Sunday,  April 7, 2019  TIME: 6 PM – 9 PM  LOCATION: Mahtay Cafe and Lounge  ADDRESS: 241 St. Paul St., St. Catharines, ON  TICKET PRICE: $12 + HST in advance / $15 + HST at the door / $8+ HST for Musicians and Arts Workers / $5 + HST for students        Juliet Dunn:  Vocals  Peter Shea:  Piano/Organ, Drums, Vocals  Brent Setterington:  Piano/Organ, Vocals  Steve Lucas:  Bass  Jim Gay:  Saxophone"
      }
