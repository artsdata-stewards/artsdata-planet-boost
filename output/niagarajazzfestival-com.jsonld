    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Alex George is a violin and mandolin musician from Almonte Ontario. He has been playing violin for 12 years and has a wide repertoire of music from jazz to country, classical to contemporary. He enjoys…"
