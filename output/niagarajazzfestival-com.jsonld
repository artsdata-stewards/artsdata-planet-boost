    "http://schema.org/url": [
      {
        "@id": "https://niagarajazzfestival.com/events/the-music-of-a-charlie-brown-christmas-2023/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://niagarajazzfestival.com/events/the-music-of-a-charlie-brown-christmas-2023/"
