    ],
    "http://schema.org/url": [
      {
        "@id": "https://niagarajazzfestival.com/events/jazz-crawl-tom-szczesniak-trio/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://niagarajazzfestival.com/events/jazz-crawl-tom-szczesniak-trio/"
