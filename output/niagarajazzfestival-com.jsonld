    "http://schema.org/url": [
      {
        "@id": "https://niagarajazzfestival.com/events/twilight-jazz-and-blooz-series-part-2-summer-jazz-featuring-sean-stanley-quartet/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
