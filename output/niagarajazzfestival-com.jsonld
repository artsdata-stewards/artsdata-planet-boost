    "http://schema.org/url": [
      {
        "@id": "https://niagarajazzfestival.com/events/in-your-own-backyard-piano-series-featuring-roberta-hunt/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://niagarajazzfestival.com/events/in-your-own-backyard-piano-series-featuring-roberta-hunt/"
