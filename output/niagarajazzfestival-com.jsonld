    "http://schema.org/url": [
      {
        "@id": "https://niagarajazzfestival.com/events/twilight-jazz-series-songs-in-the-city-featuring-the-jeffery-arthur-quartet/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
