        "@id": "https://niagarajazzfestival.com/wp-content/uploads/2022/06/World-Music-Beach-Sq.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://niagarajazzfestival.com/world-music-on-the-beach-2022/"
