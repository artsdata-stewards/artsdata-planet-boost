    ],
    "http://schema.org/url": [
      {
        "@id": "https://niagarajazzfestival.com/events/intro-to-new-orleans-and-mardi-gras-featuring-christopher-butcher-and-windex-pete/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
