    "http://schema.org/image": [
      {
        "@id": "https://niagarajazzfestival.com/wp-content/uploads/2025/06/DISTILL-CHILL-BBQ-WITH-NO-SPONSORS-SLIDE-1-2.png"
      }
    ],
    "http://schema.org/url": [
