    ],
    "http://schema.org/url": [
      {
        "@id": "https://niagarajazzfestival.com/events/twilight-jazz-and-blooz-series-thomas-nelson-band/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
