    "http://schema.org/url": [
      {
        "@id": "https://niagarajazzfestival.com/events/first-ladies-of-jazz-a-celebration-of-nations-program/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
