    ],
    "http://schema.org/url": [
      {
        "@id": "https://niagarajazzfestival.com/events/mardi-gras-sessions-new-orleans-creole-baby-dolls/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://niagarajazzfestival.com/events/mardi-gras-sessions-new-orleans-creole-baby-dolls/"
