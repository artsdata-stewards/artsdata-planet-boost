    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Calgary Philharmonic Orchestra - Mahler's First Symphony"
      },
      {
        "@language": "en-ca",
        "@value": "Events"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Discover Mahler's mighty First Symphony, as the Calgary Phil conducted by Earl Lee perform this orchestral epic that takes you from the joys of springtime through rustic dances to an ironic funeral march, and culminates in victory over worldly despair. Before it, relish the rich, nostalgic poetry of Robert Schumann's eloquent Cello Concerto, featuring distinguished cellist Steven Isserlis."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
