    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Calgary Philharmonic Orchestra - Romantic Ravel"
      },
      {
        "@language": "en-ca",
        "@value": "Events"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Let the enchanting music of Ravel captivate you this Valentine's Day weekend as the Calgary Phil and conductor Natalia Ponomarchuk take you from his picturesque Spanish-inspired rhapsody to the shimmering sound world of Daphnis et Chloé, topped off with Boléro's sensational orchestral crescendo. Canadian phenom Stewart Goodyear stars in Saint-Saëns's striking Fifth Piano Concerto, which he composed during a trip to Cairo."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
