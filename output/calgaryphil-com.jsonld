    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "IX: Shostakovich"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Catch the brilliance and dark humour of Shostakovich’s Ninth Symphony as your Calgary Phil with conductor Jessica Cottis reveal how its seemingly lighthearted façade is more than meets the ear. The Orchestra's own concertmaster Diana Cohen takes the spotlight in Max Bruch’s romantic First Violin Concerto that moves from riveting drama to tender passion to vigour and grandeur</p>\n"
      }
    ]
  },
