    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Calgary Philharmonic Orchestra - Tenille Townes + the Calgary Philharmonic Orchestra"
      },
      {
        "@language": "en-ca",
        "@value": "Events"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Seize this special chance to hear the sensational 17-time Canadian Country Music Award winner Tenille Townes perform her biggest hits with your Calgary Phil! Amplified by symphonic sound, experience her unfettered soul-searching songs and her raw ballads that have touched so many with their open-hearted \nlyrics and potent stories. These concerts are presented in partnership with the Taylor Family Foundation to bring the gift of great music to Calgary."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
