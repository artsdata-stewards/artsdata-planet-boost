    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Calgary Philharmonic Orchestra - Broadway Hits: Hamilton, Rent + More!"
      },
      {
        "@language": "en-ca",
        "@value": "Events"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Grab your seats for this Broadway extravaganza as your Calgary Phil brings the splendour of The Great White Way to Jack Singer Concert Hall! Juliane Gallant and three marvellous vocal stars team up with the Orchestra to perform memorable tunes from modern musicals including Hamilton and Rent, plus the great Stephen Sondheim's songs from Sweeney Todd and Company."
      }
    ],
