  {
    "@id": "https://calgaryphil.com/events/postcards-from-italy-2026-05-08-730-pm/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-ca",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-ca",
        "@value": "event"
      },
      {
        "@language": "en-ca",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Calgary Philharmonic Orchestra - Postcards from Italy"
      },
      {
        "@language": "en-ca",
        "@value": "Events"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Take a musical journey with the Calgary Phil to beautiful Italy with conductor Cosette Justo Valdés as your guide – from Stravinsky's take on Pulcinella, a traditional character of the Neapolitan stage, to Mendelssohn's Italian Symphony, inspired by impressions of the country's scenery and architecture. Respighi's evocation of three celebrated paintings by Italian Renaissance artist Sandro Botticelli rounds off the tour."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
