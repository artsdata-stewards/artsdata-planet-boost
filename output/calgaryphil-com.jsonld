      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Saddle up for the annual High Performance Rodeo as the Calgary Phil and One Yellow Rabbit join forces for this one-of-a-kind collaboration with Vivek Shraya. This multi-hyphenate Calgary phenom — recording artist-author-professor-actor — channels pop's greatest divas, including Madonna and Beyoncé, with the power of a full orchestra. Sure-to-be one of the most talked-about performances of the new year!"
      }
