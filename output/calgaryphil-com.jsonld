      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "ncounter the solemn power of Verdi's soul-stirring Requiem, a thrilling score to which the composer brought the dramatic sensibility of his famous operas. Grammy winning conductor Karen Kamensek leads the Orchestra, four soloists, and the Calgary Philharmonic Chorus in this towering work of theatrical proportions."
      }
    ],
    "http://ogp.me/ns#url": [
