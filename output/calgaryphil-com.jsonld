    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Calgary Philharmonic Orchestra - Vivaldi’s Four Seasons"
      },
      {
        "@language": "en-ca",
        "@value": "Events"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Immerse yourself in the sounds of the seasons with Vivaldi's most famous set of violin concertos. Acclaimed violinist Timothy Chooi plays and conducts the Calgary Phil in these remarkable works that evoke such seasonal phenomena as singing birds, buzzing flies, violent thunderstorms, and icy blizzards, as well as vibrant scenes portraying a sleepy goatherd and his barking dog, a harvest celebration, and a warm winter fire."
      }
    ],
