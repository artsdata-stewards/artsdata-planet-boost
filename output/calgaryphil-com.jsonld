    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Mahler's First Symphony"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Discover Mahler's mighty First Symphony, as the Calgary Phil conducted by Earl Lee perform this orchestral epic that takes you from the joys of springtime through rustic dances to an ironic funeral march, and culminates in victory over worldly despair. Before it, relish the rich, nostalgic poetry of Robert Schumann's eloquent Cello Concerto, featuring distinguished cellist Steven Isserlis.</p>\n"
      }
    ]
  },
  {
