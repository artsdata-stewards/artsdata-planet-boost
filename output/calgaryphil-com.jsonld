    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Calgary Philharmonic Orchestra - Salute to Vienna New Year's Concert"
      },
      {
        "@language": "en-ca",
        "@value": "Events"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Celebrate with this spectacular recreation of Vienna’s world-famous New Year’s Concert, performed by a brilliant cast of European singers, champion ballroom dancers, ballet and the Strauss Symphony of Canada featuring the Calgary Philharmonic! A 27-year tradition in Calgary, let the Blue Danube waltz whisk you and your family and friends into a triumphant New Year."
      }
    ],
