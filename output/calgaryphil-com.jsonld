  {
    "@id": "https://calgaryphil.com/events/it-takes-two-a-symphonic-collaboration-2026-01-23-730-pm/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-ca",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
