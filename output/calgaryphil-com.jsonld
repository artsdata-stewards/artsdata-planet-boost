    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Calgary Philharmonic Orchestra - IX: Shostakovich"
      },
      {
        "@language": "en-ca",
        "@value": "Events"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Catch the brilliance and dark humour of Shostakovich’s Ninth Symphony as your Calgary Phil with conductor Jessica Cottis reveal how its seemingly lighthearted façade is more than meets the ear. The Orchestra's own concertmaster Diana Cohen takes the spotlight in Max Bruch’s romantic First Violin Concerto that moves from riveting drama to tender passion to vigour and grandeur"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
        "@value": "https://calgaryphil.com/events/ix-shostakovich-2026-02-27-730-pm"
