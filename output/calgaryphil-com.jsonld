      },
      {
        "@language": "en-ca",
        "@value": "Events"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Boogie with your Calgary Phil in this far-out concert inspired by the sounds of legendary New York nightclub Studio 54. Daniel Bartholomew-Poyser conducts the Orchestra and a hip cast of vocalists in the disco era's grooviest hits from Donna Summer, Bee Gees, Gloria Gaynor, Boney M., Diana Ross, Chic, and more!"
      }
    ],
