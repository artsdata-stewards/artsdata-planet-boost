        "@id": "_:g625960"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://calgaryphil.com/events/vivaldis-four-seasons-2026-04-17-730-pm"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Vivaldi’s Four Seasons"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Immerse yourself in the sounds of the seasons with Vivaldi's most famous set of violin concertos. Acclaimed violinist Timothy Chooi plays and conducts the Calgary Phil in these remarkable works that evoke such seasonal phenomena as singing birds, buzzing flies, violent thunderstorms, and icy blizzards, as well as vibrant scenes portraying a sleepy goatherd and his barking dog, a harvest celebration, and a warm winter fire.</p>\n"
      }
    ]
  },
