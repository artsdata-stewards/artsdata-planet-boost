    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Calgary Philharmonic Orchestra - Symphonic Seas"
      },
      {
        "@language": "en-ca",
        "@value": "Events"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Embark on a maritime adventure with the Calgary Phil as they perform two sea-inspired works. Yue Bao conducts Four Sea Interludes from Britten's opera Peter Grimes, featuring musical portraits of the ocean that dominates life in an English coastal village. Complementing Britten's vision is Vaughan Williams's mystical epic for soprano, baritone, and chorus, setting texts from Walt Whitman's Leaves of Grass."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
