    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Verdi's Requiem"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>ncounter the solemn power of Verdi's soul-stirring Requiem, a thrilling score to which the composer brought the dramatic sensibility of his famous operas. Grammy winning conductor Karen Kamensek leads the Orchestra, four soloists, and the Calgary Philharmonic Chorus in this towering work of theatrical proportions.  </p>\n"
      }
    ]
  },
