    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Calgary Philharmonic Orchestra - Baroque at Bella with Camille Delaforge"
      },
      {
        "@language": "en-ca",
        "@value": "Events"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Surround yourself with glorious Baroque music in this potpourri program performed by the Calgary Phil in the intimate setting of the Bella Concert Hall. Camille Delaforge leads the Orchestra from the harpsichord in J.S. Bach's festive Orchestral Suite No. 3, which includes his most famous aria. Hear also grand and exquisite numbers from George Frideric Handel and Jean-Philippe Rameau."
      }
    ],
    "http://ogp.me/ns#url": [
