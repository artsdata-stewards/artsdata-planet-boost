      {
        "@language": "en-ca",
        "@value": "Calgary Philharmonic Orchestra - Hans Graf Returns: A Midsummer Night’s Dream"
      },
      {
        "@language": "en-ca",
        "@value": "Events"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Step into a magical world of woodland fairies and the lovers who encounter them as the Orchestra and Music Director Laureate Hans Graf perform Mendelssohn's iconic score for Shakespeare's beloved A Midsummer Night's Dream, including one of the most popular and recognizable pieces of music ever written, the Wedding March. Rising star pianist Sophia Liu also joins the Orchestra for Chopin's beautiful Second Piano Concerto."
      }
    ],
