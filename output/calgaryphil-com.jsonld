    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Calgary Philharmonic Orchestra - Slavonic Dances"
      },
      {
        "@language": "en-ca",
        "@value": "Events"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Immerse yourself in the fiery passion of Antonin Dvořák's Slavonic Dances, inspired by the exuberant rhythms of traditional Bohemia folk dances. The Orchestra, led by conductor Rumon Gamba, also perform Malcolm Arnold's Dvořák-inspired English Dances: Set Two and conclude with Nielsen's dynamic, expressive Fifth Symphony."
      }
    ],
