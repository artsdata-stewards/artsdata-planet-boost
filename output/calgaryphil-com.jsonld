    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Calgary Philharmonic Orchestra - Nothing Compares: The Music of Prince"
      },
      {
        "@language": "en-ca",
        "@value": "Events"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Prince fans, rejoice — this one's for you! Celebrate the unparalleled talent and impact of the legendary artist as his timeless music is taken to the next level by your Calgary Phil! Singers and dancers join the Orchestra to bring to life his massive hits, including Purple Rain, Cream, Raspberry Beret, and Nothing Compares 2 U, \nfamously performed by Sinead O'Connor."
      }
    ],
