    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Expand Your Body of Stories! Sara Porter leads a dynamic workshop of personal and professional exploration, incorporating movement improvisation, creative writing, vocal work and clown presence to generate multi- disciplinary material geared toward performance. Through guided exercises and play, you will gain fuller access to breath and vocal range, refine your writing skills , expand your movement vocabulary and explore new modes of physical presence."
      }
    ],
