    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "CONTACT IMPROVISATION AND INSTANTANEOUS COMPOSITION with Andrew Harwood - Mile Zero Dance"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Join us for a Contact Improvisation Workshop with Andrew Harwood, from April 21-23. Andrew Harwood has been dedicated to improvisation as a performing art for nearly 40 years and is recognized worldwide as a specialist in instantaneous choreography and contact improvisation."
      }
    ],
