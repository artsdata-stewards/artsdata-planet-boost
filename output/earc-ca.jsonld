        "@value": "Teagan Littlechief"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Teagan Littlechief, a proud Cree singer-songwriter from Saskatchewan, captivates audiences with her powerful vocals and heartfelt storytelling. Known for her performances at major events like the Grey Cup, she brings a blend of resilience and artistry to every stage."
      }
    ],
