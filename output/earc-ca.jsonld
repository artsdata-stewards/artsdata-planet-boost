  {
    "@id": "https://www.earc.ca/events/21-22-season-bromance",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "21/22 Season: Bromance | EA Rawlinson Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Bromance is a show with relationships at its heart, where handshakes become handstands and backslaps become backflips. Audacious, touching exhilarating, and with a great soundtrack, this is a tour-de-force of cutting edge physical heroics, wittily exploring male companionship and its limits."
      }
    ],
