    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Ella Forrest &amp; the Great Pines are a Regina-based five-piece band delivering smooth vocals, vibrant horns, and infectious R&amp;B grooves. Their award-winning debut EP Butterflies put them on the map, and with new tracks from their follow-up project Retrograde."
      }
    ],
