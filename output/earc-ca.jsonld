    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Kelly Bado’s music is a celebration of culture, language, and soul. With roots in Côte d'Ivoire and a home in Manitoba, Kelly blends Afro-pop, soul, and global rhythms into a sound that’s uniquely her own."
      }
