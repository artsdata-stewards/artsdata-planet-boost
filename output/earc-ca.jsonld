    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "A Study in Comedy - For Science"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "For Science! is a wordless, wildly funny exploration of curiosity, chaos, and the scientific method — where Bill Nye meets Blue Man Group. With Nerf guns, bad puns, and big laughs, this family-friendly show is perfect for ages 10+ and designed to delight adults too."
      }
    ],
