      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Aliya Kanani is a Toronto-based comedian, actress, and writer whose vibrant energy and comedic style have taken her from sold-out festivals around the world to acclaimed film performances. Known for her joyful mischief and dynamic storytelling, Aliya continues to captivate audiences on stage."
