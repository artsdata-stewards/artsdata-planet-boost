      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "This production is performed and presented by the Broadway North Youth Company's Senior Class (ages 12 to 18). Sometimes we choose the way the world sees us. Sometimes our box is defined by others; our parents, friends, enemies. A box built by others can feel small, confined, impossible."
      }
