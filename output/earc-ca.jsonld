    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Legendary Canadian rock band Glass Tiger brings decades of chart-topping hits, unforgettable melodies, and high-energy live shows to the stage. With a sound that defined an era, their performance is a nostalgic ride packed with passion and timeless music."
