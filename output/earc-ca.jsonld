      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Forrest Eaglespeaker is a Blackfoot singer-songwriter and multi-instrumentalist from Calgary, Alberta, now residing in Saskatoon, Saskatchewan. He is the heartbeat of Canadian roots-rock band The North Sound, presently a duo with his wife, Nevada Freistadt, who composes and performs vocal harmonies."
      }
