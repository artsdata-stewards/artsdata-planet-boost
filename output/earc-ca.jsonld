      {
        "@language": "en",
        "@value": "BNTC presents \"Rock of Ages\" | EA Rawlinson Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "1980s. Hollywood. Aspiring star Drew longs to rock the stage, and longs for small-town girl Sherri. But with megastar Stacee Jaxx on the scene and German developers keen on turning the Sunset Strip into a capitalist strip mall, life goes from carefree to chaos!"
      }
