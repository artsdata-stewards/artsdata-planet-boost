  {
    "@id": "https://www.earc.ca/events/ella-forrest",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Ella Forrest | EA Rawlinson Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Ella Forrest & the Great Pines are a Regina-based five-piece band delivering smooth vocals, vibrant horns, and infectious R&B grooves. Their award-winning debut EP Butterflies put them on the map, and with new tracks from their follow-up project Retrograde."
      }
    ],
