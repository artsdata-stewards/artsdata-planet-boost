    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "The Crosby Harle Band blends classic and modern country with rock and pop influences, powered by tight harmonies and heartfelt songwriting. Formed in 2016 by Tanner Crosby and Jared Harle, the group has built a loyal following through high-energy performances across Saskatchewan and Alberta."
