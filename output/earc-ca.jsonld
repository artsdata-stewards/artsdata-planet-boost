      {
        "@language": "en",
        "@value": "St Mary High School presents \"Joseph and the Amazing Technicolor Dreamcoat,\"  with lyrics by Tim Rice and music by Andrew Lloyd Webber."
      }
    ],
    "http://ogp.me/ns#image": [
