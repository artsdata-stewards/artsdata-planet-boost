    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "\"Bear Grease: The Musical\" | EA Rawlinson Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "\"Bear Grease\" is an Indigenous twist to the classic “Grease”. It's much more than that, it's indigenous representation done masterfully by an all-star Native cast, fusing Doo Wop, Hip Hop, Pow Wow Music, Native culture, language and comedy."
      }
