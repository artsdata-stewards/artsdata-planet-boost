  {
    "@id": "https://www.earc.ca/events/a-study-in-comedy-for-science-2025-10-29-13-30",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "A Study in Comedy - For Science | EA Rawlinson Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "For Science! is a wordless, wildly funny exploration of curiosity, chaos, and the scientific method — where Bill Nye meets Blue Man Group. With Nerf guns, bad puns, and big laughs, this family-friendly show is perfect for ages 10+ and designed to delight adults too."
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://static.wixstatic.com/media/8b327b_252608b181f0401589db7c48c8d9dd31~mv2.png/v1/fill/w_1080,h_1080,al_c/8b327b_252608b181f0401589db7c48c8d9dd31~mv2.png"
      }
    ],
