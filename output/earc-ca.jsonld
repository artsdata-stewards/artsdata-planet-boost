    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Chantal Kreviazuk – one of Canada’s most accomplished songwriters and recognizable voices –released her eighth studio album, “Get to You,” in summer of 2020. Heralded by the title track and first single, the album features 11 songs."
      }
