      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "A comedy circus powerhouse with an international flair, Kate Ryan delivers high-energy solo shows packed with circus hoops, acrobatics, and hilarious antics. With performances in 25 countries and credits ranging from Cirque Dreams to Cartoon Network, Kate is a master of physical comedy and circus."
      }
