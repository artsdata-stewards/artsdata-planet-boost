      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "The Gospel Show features local entertainers performing old traditional standard and contemporary gospel music with a country flavour. Produced by Meghan Mayer."
      }
    ],
    "http://ogp.me/ns#image": [
