        "@language": "en",
        "@value": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "If you love the music of the British Sixties including The Beatles, The Rolling Stones, The Dave Clark Five, Rod Stewart, Herman's Hermits, The Kinks, The Moody Blues, Tom Jones, The Searchers, The Shadows, The Yardbirds, The Hollies, Bee Gees, Zombies, Eric Burdon & The Animals, Van Morrison, The WHO & many other great British Bands then you'll love British Beat 66!\n"
      }
    ]
  },
