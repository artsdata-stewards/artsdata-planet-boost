    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Always entertaining and definitely unique, the Mudmen are a blast of Celtic energy whose members are known to be characters both on and off the stage. Enjoy an all-ages evening of Celtic music and Mud stories from Canada's Celtic Rock Warriors."
      }
    ]
