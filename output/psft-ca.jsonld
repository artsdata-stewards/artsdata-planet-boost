      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "British Beat 66"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@language": "en",
        "@value": "http://schema.org/OfflineEventAttendanceMode"
