      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Great Canadian Comedy Caravan"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Yarmouth, get ready for a night of hilarity that you won’t soon forget. We’ll be rolling into Th’Yarc on Friday March 27 with proceeds going to benefit Ronald McDonald House Maritimes!We’re thrilled to have This Hour Has 22 Minutes writer and on-air correspondent, Travis Lindsay headline this benefit gala!Travis was also a Canada's Got Talent Finalist, multiple appearances at Just For Laughs, Halifax Comedy Fest, and has appeared on New Wave of Stand Up on CBC GEM, Hubcap Comedy Fest and even met Rosa Parks!Travis will be joined by:Feature Act: Todd Reid (Just For Laughs, SiriusXM and Page International Screenwriting Contest Quarterfinalist)Host: Matt Watson (Just For Laughs, SiriusXM, Glasgow Comedy Festival and Melbourne Comedy Festival)\nFriday March 27th, 2026at 7:30pmTickets $24.50(plus service fees)"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
  {
    "@id": "http://www.yarcplayhouse.com/temporary/6fcd804f-3a7a-43f5-ac0f-c2f5dfa850d9",
