    "http://schema.org/image": [
      {
        "@id": "https://yarcplayhouse.com/wp-content/uploads/2025/12/BEE-GEES-Revisited-11x17-1-scaled.png"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "_:g708500"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://yarcplayhouse.com/whats-happening/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "BEE GEES REVISITED"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Tuesday October 20, 20267:30pmTickets $55 (plus service fees)\nVaughnCo Entertainment is proud to present the most outstanding Bee Gees Tribute show. Bee Gees Revisited is the ultimate tribute to the Bee Gees. Come and experience the sound, the harmonies, and the beautiful falsetto voices of the brothers Gibb. Performing with a full band the show recreates the Bee Gees 1998 Las Vegas appearance live.The costumes, the music, and the atmosphere is as close to the real thing as you can get. The show suspends belief as it weaves through hit after hit from their classic 60’s catalogue to the groove of their 70’s Disco era hits that made the band a world-wide sensation. Dance and sing along to hits like Staying Alive, Night Fever, Massachusetts, Tragedy, You Should Be Dancing, and Nights on Broadway."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
