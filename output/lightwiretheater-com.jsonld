    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Marvin the mouse wants to be popular. Constantly bullied and picked on by the \"cool\" mice, he is labeled as a loser and a geek. To get away from the continuous badgering, he retreats into his science books and a world of fantasy. He longs to have adventures, to be the hero.  Join Marvin on"
      }
