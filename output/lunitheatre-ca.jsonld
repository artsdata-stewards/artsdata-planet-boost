    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "L’autrice Karen Hines explore le côté sombre de l’immobilier dans Crawlspace : Une vraie de vraie histoire vécue d’horreur immobilière, une comédie kafkaïenne traduite de l’anglais par Mishka Lavigne qui fait le constat, déplorable, du secteur immobilier canadien, véritable champs de bataille cruel"
      }
    ],
