    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "La pièce&nbsp;Trout Stanley&nbsp;de Claudia Dey se déroule dans le nord de la Colombie-Britannique, à la périphérie d'une ville minière entre Misery Junction et Grizzly Alley. Dans ce décor inhospitalier vivent deux sœurs, des jumelles qui ne se ressemblent pas du tout : Sugar et Grace. C'es"
      }
    ],
