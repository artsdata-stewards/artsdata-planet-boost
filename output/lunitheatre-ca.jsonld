    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Lucienne, an only child, is living in perfect happiness when all of a sudden, her parents tell her great news: she is going to become a big sister! At first, Lucienne is a little worried, but her parents' enthusiasm quickly reassures her. However, as soon as her brother is born, everything changes:"
      }
