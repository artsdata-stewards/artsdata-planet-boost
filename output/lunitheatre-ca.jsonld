    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Argan, a severe hypochondriac, wishes to marry his daughter Angélique to the son of a respected doctor, Thomas Diafoirus. However, Angélique is in love with another man, Cléante. The play explores themes of love, deception, and medicine, all in a comical and wacky style."
      }
    ],
