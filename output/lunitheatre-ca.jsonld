    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Argan, un hypochondriaque sévère, souhaite marier sa fille Angélique au fils d’un médecin respecté, Thomas Diafoirus. Cependant, Angélique est amoureuse d’un autre homme, Cléante. La pièce explore les thèmes de l’amour, de la tromperie et de la médecine, le tout dans un style comique et farfelu."
      }
    ],
