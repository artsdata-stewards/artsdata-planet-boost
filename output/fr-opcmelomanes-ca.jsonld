    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Vivez le Messie de Haendel avec l'OPCM avec 75 chanteurs, 30 musiciens et 4 solistes ! Profitez de ce chef-d'œuvre dans le magnifique Saint-Jean-Baptiste sous la direction de Francis Choinière."
      }
    ],
    "http://ogp.me/ns#image": [
