    ],
    "http://schema.org/name": [
      {
        "@value": "Morgan Toney"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Mi\\'kmaq fiddler and singer Morgan Toney brings together the fiery fiddling of Cape Breton Island with the old songs of the Mi’kmaq with brilliance and heart. First Flight, Toney’s award-nominated debut album, celebrates language and heritage in Toney’s transformation of traditional songs like the Ko’jua and the Mi’kmaq Honour Song alongside highly original songcraft..&lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@value": "Organization"
      }
