    "http://schema.org/name": [
      {
        "@value": "Lethbridge Folk Club Presents Ben Sures"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Ben Sures is a guitar player who tells great stories in song. A natural performer with an instinct for humour and storytelling. Ben Sures writes songs about everything from imaginary rayguns to sandwiches prepared for him by his father when he was a child visiting on weekends. Sures is immersed in the history of roots music, the old traditions informing this contemporary songwriter’s music.&lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@value": "Organization"
      }
