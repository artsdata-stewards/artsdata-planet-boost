    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Originally from southern Alberta, veteran soldier Tim Isberg is an accomplished singer-songwriter.  From Rwanda to Afghanistan and missions in between, Tim experienced the best and worst humanity has to offer. As a performer, he has entertained audiences in many corners of the world.&lt;/p&gt;\\n"
      }
