    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Join Us at D&amp;N Kitchen in Lethbridge for an Unforgettable Dinning Experience Where Every Meal is a Celebration of Taste and Culture!&lt;br /&gt;\\nDiscover the story of D&amp;N Kitchen, where culinary passion meets the art of dining. Learn about our journey, philosophy, and the dedicated team led by Chef Dmitri Aronov and Natalia Aronov that makes our restaurant a beloved destination in Lethbridge.&lt;/p&gt;\\n"
      }
