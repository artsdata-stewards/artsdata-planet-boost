    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;With a long history of bringing live music to Lethbridge, we are moving to bring more music, to more people, in more communities. We hope you can help us reach that goal.&lt;/p&gt;\\n"
      }
    ],
