    "http://schema.org/name": [
      {
        "@value": "Horizon Ridge"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;“With a repertoire reflecting their diverse musical backgrounds – from Canadiana, east-coast kitchen parties, country &amp; blues to contemporary and traditional British folk – a Horizon Ridge concert brings you on a musical journey through tight, four-part a cappella harmonies to intricate multi-instrumental arrangements – and always with an invitation to sing along.”&lt;/p&gt;\\n&lt;p&gt;Tom Coxworth&lt;br /&gt;\\nHost of CKUA “Folk Routes”&lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@value": "Organization"
      }
    ],
