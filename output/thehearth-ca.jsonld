    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Can Helena get her man? Follow her adventures in pursuit of her heart's desire.  Join us at the Bowen Theatre for “All's Well”, the 11th annual production from Bowen's famed Bard on the Rock, but the first in the new theatre, and the first Spring production!    BUY TICKETS HERE     If you need more"
      }
