    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "After more than 20 years of performing, Norden has earned a reputation as one of the top children’s magicians in Canada. He is the only Canadian magician in history to win the national award for Children’s Magic an incredible 15 times! His high-energy, comedy-filled shows and wonderfully wacky perso"
      }
