    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The Lubben Brothers will be the live entertainment at the Guitars and Gumbo annual fundraiser for cancer caregivers. The all-you-can-eat gumbo dinner begins at 5pm and the live show starts at 6pm. The Lubben Brothers will share the stage with 70s cover band, Velvet Hammer.  Admission is free."
      }
