  {
    "@id": "https://carrefourtheatre.qc.ca/spectacles-culturels-quebec/epidermis-circus/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-fr",
        "@value": "fr_FR"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-fr",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-fr",
        "@value": "Epidermis Circus Spectacles | Festival Carrefour"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "Vous aurez mal aux joues !  Découvrez le spectacle de marionnettes le plus étrange que vous ayez jamais vu. André-Anne LeBlanc utilise ici son corps, ses mains et sa bouche dans un ingénieux jeu de caméras, miroirs et projections en direct. La star du show : Baby Tyler qui nous plonge dans cet étrange cabaret du miniature avec un humour effronté. Après une tournée mondiale triomphante, l’équipe vancouveroise vient enchanter et faire rire le public de Québec. C’est drôle, c’est coquin, […]"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-fr",
        "@value": "https://carrefourtheatre.qc.ca/spectacles-culturels-quebec/epidermis-circus/"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "fr-fr",
        "@value": "Festival Carrefour"
      }
    ],
