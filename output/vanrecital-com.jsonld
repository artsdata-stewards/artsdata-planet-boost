    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Wrapping up his four-concert musical journey into the works of Haydn, Brahms and Beethoven, Paul Lewis continues to reveal his deep understanding of, and sensitivity to, the music of these three Austro-German masters. The first of his four concerts in our 2017-18 Season set a high bar indeed, underlining the humour in Haydn and the […]"
      }
