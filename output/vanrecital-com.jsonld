    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Award-winning Hungarian cellist István Várdai is a rising star, performing to great acclaim at major international venues. In 2014, he won the ARD Cello Competition in Munich and a year later captured Hungary’s highest classical music honour, the Liszt Prize. “His playing was commendable for its fluidity and virtuosity, distinguished by both a fleet-fingered lightness […]"
      }
