    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "We are delighted to welcome back this remarkably gifted Finnish pianist after a decade away from our stage. In the intervening years, Juho has enjoyed a burgeoning career of solo and chamber music performances and orchestral engagements on both sides of the Atlantic.   MOZART: Fantasia in C minor, K. 475 MOZART: Sonata No. 14 […]"
      }
