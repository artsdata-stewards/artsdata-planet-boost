    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "NING FENG, violin"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Ning Feng has what it takes to stand out among the myriad of young violinists appearing on the world’s stages. From immaculate intonation and precise phrasing, to a luxuriously rich sound and impeccable musicianship, Ning Feng offers enthralling performances that are absolutely captivating. “A terrific performance… The fascinating effect he created was not just brilliant […]"
      }
    ],
