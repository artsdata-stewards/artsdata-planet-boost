    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Nobody describes the Danish String Quartet better than they do themselves… “We are three Danes and one Norwegian cellist, making this a truly Scandinavian endeavor. Being relatively bearded, we are often compared to the Vikings… Yes, playing string quartets is our job, and yes it is hard work, but we mostly do it for pleasure, […]"
      }
