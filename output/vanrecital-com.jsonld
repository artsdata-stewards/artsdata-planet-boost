    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "This exciting young Canadian pianist was to have made his Vancouver debut on our series last March — fortunately we have been able to reschedule him for this season. Tony was the First Prize Winner and Gold Medalist at the First China International Piano Competition.   BACH/BUSONI: Chaconne in D minor BWV 1004 BACH/BUSONI: Ich […]"
      }
