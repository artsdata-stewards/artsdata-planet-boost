    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Foiled by the Icelandic volcano in 2010, Finnish pianist Juho Pohjonen finally makes it to Vancouver for a return engagement. “A beautifully shaped and unfussy account of immaculate articulation and of crystalline quality that pointed to a major emerging talent.” –Yorkshire Post     Beethoven: Sonata No. 15 in D major, Op. 28 “Pastoral” Debussy: […]"
      }
    ],
