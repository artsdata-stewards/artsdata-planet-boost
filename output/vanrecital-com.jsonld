    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "NIKKI & TIMMY CHOOI, violins & ANGELA CHENG, piano - Vancouver Recital Society"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "We can’t think of a more wonderful way to open our 40th Season than by bringing these three illustrious musicians back to our stage. Since the beginning of their careers, Nikki, Timmy, and Angela have been frequent visitors to the VRS and all have a deep connection to our organization. And speaking of “dreams come true”… […]"
      }
    ],
