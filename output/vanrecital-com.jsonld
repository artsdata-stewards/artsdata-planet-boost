    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "After the success of their riveting performance of Schubert’s Winterreise on our 2014-15 Season, Ian Bostridge and Wenwen Du return to our stage to perform an artfully curated program of songs exploring the music and poetry of the Great War. The program ranges from songs by soldier composers George Butterworth and Ivor Gurney to Britten’s […]"
      }
