    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "DORIC STRING QUARTET"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Described by Gramophone Magazine as “one of the finest young string quartets”, whose members are “musicians with fascinating things to say”. Powerful and passionate, the Doric offers precise performances of terrific panache and perception. “The Doric String Quartet perform Haydn’s music with spirit, wit and sophistication at Wigmore Hall. Rating: ***** Haydn and the Doric […]"
      }
    ],
