    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Finnish-Dutch cellist Jonathan Roozeman is already establishing himself as an artist of exceptional musical integrity. At only 20 years of age, this award-winning performer has appeared with major orchestras and in prestigious concert halls throughout Europe and North America. Jonathan will be accompanied at the keyboard by his brother Jan-Paul. BOCCHERINI: Sonata in A major, […]"
      }
    ],
