    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Miloš Karadaglić, already hailed by fans and critics for his brilliant technique and transcendent musicality, is well on his way to joining the ranks of Segovia, Bream and John Williams. As the “new hero of classical guitar” (npr Music), 28-year-old Karadaglić is already in great demand across Europe and the USA. At his Carnegie Hall debut […]"
      }
    ],
