    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Praised as “superbly subtle and virtuosic” and “an amazingly accomplished artist”, Ksenija Sidorova is the world’s leading ambassador of the accordion. She started playing the instrument at the age of 8 in her hometown of Riga, Latvia, and as she grew older her quest for more exposure to both classical and contemporary repertoire led her […]"
      }
