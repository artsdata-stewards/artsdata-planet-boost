    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Uzbek-born pianist Roman Rabinovich’s playing has been described as compelling, dynamic and highly sensitive. Since winning the 2008 Rubinstein International Piano Competition, he has performed throughout the United States and Europe to great critical acclaim. This performance marks Roman’s Canadian debut. “He is an artist of the highest caliber; a pianist with complete technical command, […]"
      }
