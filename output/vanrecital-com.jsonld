    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Sir András Schiff was scheduled to fly to Vancouver in March, 2020 to help us celebrate our 40th Anniversary Season… instead he was detained in Japan as the world went into lockdown due to Covid-19. I can’t say how happy we are to be able to reschedule him! This performance at the Playhouse will be […]"
      }
