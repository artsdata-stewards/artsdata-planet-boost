    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "On June 10, 2017, Yekwon Sunwoo was announced as the Gold Medalist at the 15th Van Cliburn International Piano Competition. In its 55-year history, the quadrennial Cliburn has identified and ushered a host of exceptional artists to international prominence, including Barry Douglas, Olga Kern, Radu Lupu, Jon Nakamatsu, and Cristina Ortiz. 28-year-old Yekwon, from Anyang, […]"
      }
    ],
