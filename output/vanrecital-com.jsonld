    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "DANISH STRING QUARTET - Vancouver Recital Society"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "“The Great Danes” return for the fourth and final installment of their innovative Doppelgänger project, in which they pair one of Schubert’s timeless string compositions with a newly-commissioned work.   For this fourth concert, the quartet will be joined by Finnish cellist Johannes Rostamo to perform Schubert’s epic String Quintet, which was written during the final weeks […]"
      }
    ],
