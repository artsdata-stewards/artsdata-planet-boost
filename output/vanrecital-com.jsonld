    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "A BEETHOVEN CELEBRATION 16 QUARTETS IN 5 CONCERTS October 1 – 8, 2020   All performances take place at the Telus Studio Theatre, Chan Centre for the Performing Arts. Over the course of his life, Beethoven wrote 16 String Quartets in three fairly distinct blocks: the “early” quartets (Nos. 1-6) composed when he was 27 […]"
      }
