    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "South African cellist Abel Selaocoe is redefining the parameters of the cello. He moves seamlessly across a plethora of genres and styles, from collaborations with world musicians and beatboxers, to concerto performances and solo classical recitals. Heavily influenced by South Africa and with a deep rooting in classical music, Abel combines virtuosic performance with improvisation […]"
      }
    ],
