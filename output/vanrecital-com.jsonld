    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "After a gap of way too many years, Italian pianist Andrea Lucchesini returned to the VRS in 2018 and played such a wonderful concert that we immediately re-engaged him. Unfortunately, his 2021 concert was another casualty of the pandemic, but we are so pleased to welcome him back for this performance. BEETHOVEN: Sonata No. 14 in […]"
      }
