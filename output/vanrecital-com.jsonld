    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "PRE-CONCERT TALK AT 2:15PM Described as “Fearless, dazzling, exceptional” (The Guardian), Tamara Stefanovich captivates audiences worldwide with her utterly unique and eclectic programming. A passionate ambassador of broad repertoire from before Bach to beyond Boulez, she will have you on the edge of your seat! J. S. BACH: Aria variata alla maniera italiana, BWV 989 […]"
      }
