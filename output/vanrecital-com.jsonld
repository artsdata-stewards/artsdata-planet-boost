    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "PRE-CONCERT TALK AT 2:15PM Schaghajegh first appeared on our radar through Sir András Schiff, her mentor and frequent artistic partner. She made her international breakthrough in 2014 as an award winner in the International Bach Competition in Leipzig. In 2018, she made her Canadian debut at the VRS playing Bach’s Goldberg Variations. We quickly rebooked […]"
      }
