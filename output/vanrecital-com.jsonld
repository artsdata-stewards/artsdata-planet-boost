    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Pre-concert talk at 2:15pm This concert will showcase a wonderful pair of local talents. Both are acclaimed performers and both are professors at UBC School of Music. Jose Franch-Ballester is an Avery Fisher Career Grant-winner who has been praised for his “poetic eloquence” (The New York Sun) and “technical wizardry” (The New York Times). David […]"
      }
