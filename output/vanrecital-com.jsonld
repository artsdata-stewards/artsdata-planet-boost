    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "THIS CONCERT IS SOLD OUT   REFLECTIONS IN WORDS AND MUSIC Join cellist Yo-Yo Ma for an evening of music and words. In this one-night-only event, Yo-Yo will pair repertoire from the centre of his musical firmament with reflections on how it has shaped his thinking about art, human nature, and our search for meaning. Together, […]"
      }
