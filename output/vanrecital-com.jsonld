    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "A rising star at the Metropolitan Opera in New York, Rodion Pogossov is a young Russian baritone with a bright future ahead of him. “It was a rush just to be in the same room as him” —National Post   Works by Gluck, Schumann, Mendelssohn, Tchaikovsky & Mozart"
      }
    ],
