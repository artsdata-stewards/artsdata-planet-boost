    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "So captivated were we — and our audience — with the Chiaroscuro’s performance in the 2018-19 Season that we re-booked them immediately! Hear this brilliant ensemble in a program of string quartet gems. Everything they play sounds fresh and original. PURCELL: Fantasias (selection TBD) MOZART: Quartet No. 21 in D major, K. 575 SCHUBERT: Quartettsatz […]"
      }
    ],
