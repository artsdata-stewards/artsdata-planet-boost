    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "JOYCE DiDONATO, mezzo-soprano with IL POMO d'ORO CHAMBER ORCHESTRA - Vancouver Recital Society"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "In War and Peace: Harmony Through Music Vancouver debut performance – one night only! Winner of the 2012 Grammy Award for Best Classical Vocal Solo, Kansas-born Joyce DiDonato entrances audiences across the globe, and has been proclaimed “perhaps the most potent female singer of her generation” by The New Yorker. This concert explores the dichotomy […]"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
