      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Captivating stage presence combined with performances that are technically and musically masterful make accordionist Hanzhi Wang the perfect ambassador for her instrument. In addition to winning First Prize at the 2017 Young Concert Artist International Auditions in New York (where we heard her stunning performance), she also won First Prize at the Castelfidardo International Accordion […]"
      }
