    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Ready for something a little different? George Hinchliffe’s Ukulele Orchestra of Great Britain is a group of all-singing, all-strumming ukulele players whose concerts are a funny, virtuosic, foot-stomping obituary of rock-n-roll featuring the “bonsai guitar” and a menagerie of voices. Formed in 1985 as “a bit of fun”, the orchestra’s first gig was an instant […]"
      }
    ],
