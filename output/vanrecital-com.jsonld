    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "In the more than 35 years he has been performing on the concert stage, Murray Perahia has become one of the most sought-after and cherished pianists of our time. “The soul of a poet, the mind of a thinker, the hands of a virtuoso; no wonder audiences love this guy.” — Seattle Times     […]"
      }
