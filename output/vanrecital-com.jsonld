    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Post-performance Talk Back After his impressive Canadian debut on our stage in 2023, we were determined to bring this remarkable young Japanese pianist back as soon as possible. For his first VRS appearance he played an all-Mozart program at our request. We were amply rewarded… it’s quite rare to hear a performer of Mao’s age […]"
      }
    ],
