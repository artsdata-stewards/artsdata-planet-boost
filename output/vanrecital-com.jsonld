    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Twenty-year-old Israeli pianist Tom Borrow was featured in a two-page article in a 2019 edition of International Piano magazine. Charting his sudden rise to prominence and giving insight into this exciting new pianist, the article asserts: “Tom Borrow is the very definition of one to watch”. Performances take him from Israel to South Korea, and […]"
      }
