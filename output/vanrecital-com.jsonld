    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Augustin Hadelich is a very special and deeply communicative artist with a wide range of repertoire from Bach to Adès. In addition to being an in-demand performing artist, Augustin recently joined the faculty of the Yale School of Music. We are thrilled to welcome Musical America’s 2018 ‘Instrumentalist of the Year’ back to our stage […]"
      }
    ],
