    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Zlatomir Fung is the first American in four decades, and youngest musician ever to win First Prize at the International Tchaikovsky Competition, Cello Division. We first discovered this remarkable young cellist in New York, where he won the Young Concert Artists International Auditions a year before he won the Tchaikovsky Competition. Prepare to be impressed! […]"
      }
