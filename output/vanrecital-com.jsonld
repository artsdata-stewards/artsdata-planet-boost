      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "“The Ukes” are back by popular demand! This world-renowned troupe of all-singing, all-strumming ukulele players makes its much-anticipated return to the VRS to perform hilarious and astonishing interpretations of film scores, rock ’n’ roll, pop, jazz, blues and classical music. This is feel-good music at its best. Get your seats early to ensure you don’t […]"
      }
