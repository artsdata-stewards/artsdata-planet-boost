    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "To Kill a Mockingbird | Stratford Festival Classic"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Justice is pitted against bigotry when a black man is falsely accused of raping a white woman. Based on Harper Lee's Pulitzer Prize-winning novel, this enduring American classic makes a passionate plea for moral courage and truth in a world of hatred and lies."
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
