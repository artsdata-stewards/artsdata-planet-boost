        "@language": "en",
        "@value": "The Tempest | Stratford Festival Shakespeare"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "In Shakespeare's great drama of loss and reconciliation, a long-deposed ruler uses magical arts to bring within her power the enemies who robbed her of her throne and marooned her on a remote island. But what revenge does she mean to take?"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
