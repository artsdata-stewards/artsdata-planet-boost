    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "In this edge-of-your-seat thriller, the young princess Elizabeth navigates a labyrinth of political and sexual intrigue in the Tudor court that threatens her freedom – and even her life. Don’t miss this eagerly awaited companion piece to the runaway hit The Last Wife."
      }
