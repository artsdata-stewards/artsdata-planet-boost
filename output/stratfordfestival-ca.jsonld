    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "The Music Man | Stratford Festival Musical"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "A charming but fraudulent salesman arrives in River City to work his usual scam - only to find that a bill of goods can be the real deal. With melodies that include the rousing \"Seventy-Six Trombones,\" this musical-comedy classic will delight the whole family."
      }
    ],
