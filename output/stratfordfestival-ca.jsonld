    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "The Rocky Horror Show | Stratford Festival Musical"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "It's the most fun you can have in fishnets! A cult classic for more than forty years, this brilliant pastiche of B-movie horror and sci-fi tropes, with its irresistible rock-and roll score, invites us to shed our inhibitions and explore our wildest dreams and desires."
      }
    ],
    "http://ogp.me/ns#site_name": [
