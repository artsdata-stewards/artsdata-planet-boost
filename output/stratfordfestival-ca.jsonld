    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Coriolanus | Stratford Festival"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "He's fearless on the battlefield - but in the pitfall-laden world of politics, he's doomed by his contempt for the common people. This stunning production by genre-defying director Robert Lepage explores the age-old tensions that still tear at the heart of democracy."
