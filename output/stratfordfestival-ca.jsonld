      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "In a society awash in gossip, rumours and backbiting, an uncle arrives home in disguise to test the worthiness of his nephews – but truth has a way of tumbling out in this hilarious, fast-paced comedy."
      }
    ],
