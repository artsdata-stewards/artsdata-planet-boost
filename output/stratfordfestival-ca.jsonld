    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "The Komagata Maru Incident | Stratford Festival Official Site"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "In 1914, a shipload of emigrants from the British Raj were denied entry to Vancouver, then Canada’s most diverse city. The play exposes the cost not only to those newcomers but also to existing minority residents who struggled to find their place amid the systemic racism of the era."
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
