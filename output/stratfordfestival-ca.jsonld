        "@value": "Timon of Athens | Stratford Festival Play"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Timon’s compulsive generosity makes him the most popular man in Athens – until his funds run out. Now, embittered by ingratitude, what will he do when his city comes under attack?"
      }
    ],
