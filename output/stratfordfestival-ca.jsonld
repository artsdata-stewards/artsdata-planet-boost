      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Intersecting with Canada’s history from the moment of First Contact to a future ravaged by climate change, this saga follows the mythic adventures of a polar bear to a profoundly moving conclusion. Specially commissioned by the Festival to mark Canada 150."
      }
    ],
