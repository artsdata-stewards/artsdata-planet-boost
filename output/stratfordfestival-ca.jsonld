    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Napoli Milionaria | Stratford Festival Comedy"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "A Neapolitan family prospers from the black market during the Second World War. But even as the money flows, community ties are tested and a moral price must be paid. A sparkling and warm-hearted comedy from a celebrated 20th-century master."
      }
    ],
    "http://ogp.me/ns#site_name": [
