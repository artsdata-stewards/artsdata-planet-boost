  {
    "@id": "https://www.chamberfest.com/fr/event/2023/adapted-concert-shhhh-ensemble/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-fr",
        "@value": "fr_FR"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-fr",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-fr",
        "@value": "Concert adapté en direct : SHHH! Ensemble | Chamberfest"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "Concert adapté en direct : SHHH! Ensemble | Ottawa-based piano/percussion duo, SHHH!! Ensemble, share their unique style and “avant-accessible” programming in this captivating concert. Also coming this winter, families can explore with this creative duo at a Bring the Kids! show.Chamberfest’s Adapted Concerts (formerly Sensory Friendly Concerts) are adaptive performances for those with sensory sensitivities, including autistic and neurodivergent kids and adults. Family and friends are welcomed into a concert experience that has special considerations like pre-concert visual aids, storytelling, and flexible spaces for movement, ensuring a comfortable environment for all to be creative and have fun with music. Everyone is welcome."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-fr",
        "@value": "https://www.chamberfest.com/fr/event/2023/adapted-concert-shhhh-ensemble/"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "fr-fr",
        "@value": "Chamberfest"
      }
    ],
    "article:publisher": [
      {
        "@language": "fr-fr",
        "@value": "https://www.facebook.com/ottawachamberfest/"
