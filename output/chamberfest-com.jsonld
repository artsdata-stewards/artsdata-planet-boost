    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Ottawa Chamberfest’s Board of Directors includes some of Canada’s most passionate and committed music enthusiasts and community leaders who believe in changing lives through music. We are grateful that they choose to volunteer their time and talent year-round to Chamberfest. Members are listed here."
      }
