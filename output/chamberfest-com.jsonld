    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Chamberfest Introducing: Aizuri Quartet | February 24, 2023: American all-female Aizuri Quartet makes their debut at Chamberfest this concert series. Known for their cutting edge programming and music-making, Aizuri Quartet bring a thoughtfully curated program of pieces for string ensemble to the Ottawa stage."
      }
    ],
