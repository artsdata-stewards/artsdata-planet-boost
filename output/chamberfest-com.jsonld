  {
    "@id": "https://www.chamberfest.com/fr/event/2020/russell-braun-et-carolyn-maule/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-fr",
        "@value": "fr_FR"
      }
    ],
    "http://ogp.me/ns#type": [
