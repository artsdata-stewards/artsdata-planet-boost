  {
    "@id": "https://www.chamberfest.com/fr/event/2023/chamber-pints-david-marks-max-cardillid/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-fr",
        "@value": "fr_FR"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-fr",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-fr",
        "@value": "Chamber Pints: David Marks et Max Cardilli | Chamberfest"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "Chamber Pints: David Marks et Max Cardilli | David Marks et Max Cardilli, un duo de formation classique et d’inspiration folklorique, seront sur scène chez Kaffé 1870 — après après un spectacle triomphant et plein à craquer en janvier — pour notre deuxième session << Chamber Pints >> de l'année. Altiste, guitariste et auteur-compositeur-interprète, David Marks s’est associé à son collègue de l’OCNA, le bassiste Max Cardilli, pour créer un duo à cordes qui défie les genres. Ce concert de l’après-midi sera une exploration de la musique traditionnelle des Appalaches et du bluegrass, ainsi que des formes classiques et des ballades médiévales."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-fr",
