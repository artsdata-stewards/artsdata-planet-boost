  {
    "@id": "https://www.chamberfest.com/fr/event/2024/blake-pouliot-mendelssohns-octet/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-fr",
        "@value": "fr_FR"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-fr",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-fr",
        "@value": "Blake Pouliot et l'octuor de Mendelssohn | Chamberfest"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "En direct au Chamberfest! Le violoniste Blake Pouliot, originaire de Toronto, apporte sur la scène du Chamberfest son art internationalement reconnu et sa vigueur juvénile dans un programme de joyaux de la musique de chambre. En première partie, Pouliot montera sur scène dans une rafale d'étincelles de superstar, accompagné par le géant local du piano David Jalbert. Pour la clôture de la soirée, Blake remontera sur scène avec le quatuor Ironwood et ses amis pour interpréter l'ultime morceau de fête du répertoire pour ensemble à cordes : l'octuor pour cordes de Mendelssohn."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-fr",
