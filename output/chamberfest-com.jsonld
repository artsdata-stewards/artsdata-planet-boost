  {
    "@id": "https://www.chamberfest.com/event/2024/rachel-kiyo-iwaasa-pianography/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Pianography: Music by Queer and Trans Composers"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "To mark Pride Month, join celebrated Canadian pianist  Rachel Kiyo Iwaasa for an evening performance of works by by Rodney Sharman, Leslie Uyeda, Camille Georgeson-Usher and SD Holman. Hailed in the press as a \"keyboard virtuoso and avant-garde muse\" (Georgia Straight) with the “emotional intensity” to take a piece “from notes on a page to a stunning work of art” (Victoria Times Colonist), Rachel Kiyo Iwaasa is recognized among Canada’s foremost contemporary music pianists."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://www.chamberfest.com/event/2024/rachel-kiyo-iwaasa-pianography/"
      }
