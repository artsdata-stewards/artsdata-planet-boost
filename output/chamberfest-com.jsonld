    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "Chamberfest presents an evening with Julian Kytasty, one of the world's premier players of the bandura, a lute-like instrument of the Ukrainian tradition.” In September 2021, Ukrainian President Volodymyr Zelenskyy awarded Julian Kytasty the title “Honoured Artist of Ukraine” in a ceremony in New York City. Whether you're a fan of traditional music, bardic playing, or Ukrainian culture, this will be an intriguing offering."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-fr",
