  {
    "@id": "https://www.chamberfest.com/event/2023/holiday-extravaganza-let-in-the-light/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Let in the Light!"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Join us for a Holiday Extravaganza! Celebrate the joys of the winter solstice, the holidays, and the return of the light, Chamberfest style! Exploring Diwali, Hannukah and even Christmas, Ottawa Chamberfest brings you stellar musicians playing classical and modern works in a program narrated by the CBC’s Tom Allen. Holiday Extravaganza: Let in the Light! December 15th, Carleton Dominion Chalmers Centre. Tickets at Chamberfest.com."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://www.chamberfest.com/event/2023/holiday-extravaganza-let-in-the-light/"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en-us",
        "@value": "Chamberfest"
      }
    ],
