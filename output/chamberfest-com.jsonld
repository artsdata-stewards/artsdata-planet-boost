    "@id": "https://www.chamberfest.com/series/2024/chamberpride/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "ChamberPride"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Chamberfest is proud to present its first annual ChamberPride! Join us June 4–9 for fabulous free concerts celebrating the richness and diversity of our community, featuring performances by visiting and local LGBTQ2S+/queer artists and allies. This year, ChamberPride will feature three events: a special edition of Chamberfest’s City Series at Ottawa City Hall, Rachel Kiyo Iwaasa’s “Pianography” at the National Gallery of Canada, and our ChamberPride Coffeehouse at Happy Goat Coffee."
      }
    ],
    "http://ogp.me/ns#url": [
