    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Chamber Pints: Plants & Pianos | Chamberfest %"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Chamber Pints is our informal concert series at unique locations around the city. This event focuses on those with whom we share the earth — plants and animals. The Steinway Piano Gallery will host us for a lively evening — two pianos, four hands, with Olivia Adams and Nick Busch (partners at the piano and away from it) — and a pop-up plant sale with a little help from our friends at Ritchie's Feed and Seed."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://www.chamberfest.com/event/2023/chamber-pints-plants-pianos/"
      }
