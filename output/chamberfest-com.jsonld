  {
    "@id": "https://www.chamberfest.com/event/2024/city-series-uottawa-vocal-students-and-alumni/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
