  {
    "@id": "https://www.chamberfest.com/fr/series/2024/chamberpride/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-fr",
        "@value": "fr_FR"
      }
    ],
    "http://ogp.me/ns#type": [
