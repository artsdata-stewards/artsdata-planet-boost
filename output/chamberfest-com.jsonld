        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Celebrating the Musical Instrument Bank at Gala Noël"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "This year, our holiday concert Gala Noël also marks a milestone in Canadian musical heritage: 40 years of the Canada Council for the Arts Musical Instrument Bank (MIB). Since its founding, the Bank has connected Canada’s most promising musicians with some of the world’s finest instruments – violins, cellos, and bows crafted by Stradivari, Guarneri, and Gagliano."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://www.chamberfest.com/stories/40-years-musical-instrument-bank-gala-noel/"
      }
    ],
