        "@language": "fr-fr",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-fr",
        "@value": "Russell Braun et Carolyn Maule | Chamberfest"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "Le célèbre baryton canadien Russell Braun et la pianiste Carolyn Maule se partagent la scène pour vous offrir un récital intime, explorant les thèmes de la séparation, de l’isolement, de réunification, et de renaissance, et centré sur le premier cycle de lieder de Beethoven“An die Ferne Geliebte” (À la Bien-aimée lointaine)."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-fr",
        "@value": "https://www.chamberfest.com/fr/event/2020/russell-braun-et-carolyn-maule/"
