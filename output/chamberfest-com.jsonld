    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Angela Hewitt | Chamberfest"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Angela Hewitt returns for a new blockbuster summer performance, this time with the Chamberfest Anniversary Orchestra and young Canadian pianist Carter Johnson. Embarking on another milestone project after her ambitious and highly acclaimed Bach Odyssey cycle, her Mozart’s Complete Piano Concertos project launched in March 2023 and will continue in collaboration with prestigious orchestras around the world until 2026."
      }
    ],
    "http://ogp.me/ns#url": [
