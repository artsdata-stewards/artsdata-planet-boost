    "@id": "https://www.chamberfest.com/event/2024/chamberpride-coffeehouse/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "ChamberPride Coffeehouse!"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The inaugural ChamberPride Coffeehouse features performances by local LGBTQ2S+/queer artists and allies in the artful atmosphere of Happy Goat Coffee, accompanied by live art creation by KJ Forman (Luck and Lavender Studios). Various caffeinated/non-caffeinated, alcoholic/non-alcoholic drinks and snacks will be available."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://www.chamberfest.com/event/2024/chamberpride-coffeehouse/"
      }
    ],
