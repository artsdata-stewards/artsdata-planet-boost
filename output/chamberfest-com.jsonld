  {
    "@id": "https://www.chamberfest.com/event/2024/operatic-fluidity-handel-arias-with-arion-baroque/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Operatic Fluidity: Handel Arias with Arion Baroque"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Chamberfest welcomes the return of Montreal’s pioneering period instrument group, Arion Baroque Orchestra, with a program exploring the 'Operatic Fluidity' of gender through some of Handel’s most beautiful arias. In Handel’s time, these arias would have been performed by castrati—it was their golden era—but these roles have long-since been assigned to mezzos, contraltos, and tenors, showcasing interesting contrasts and unique colours.This evening, Arion gives these beloved works a current-day gender shift, illuminating different sides, facets, and faces in Handel’s characters as Amelia Keenan, contralto, and countertenor Ian Sabourin perform roles of the opposite gender.  "
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
