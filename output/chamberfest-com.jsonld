    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Themes of separation, isolation, reunification, and rebirth abound in a program centred around Beethoven’s song cycle, “An die ferne Geliebte” (To the Distant Beloved)."
      }
    ],
