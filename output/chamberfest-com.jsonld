  {
    "@id": "https://www.chamberfest.com/event/2024/gryphon-trio-breathe/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Gryphon Trio: Breathe | Chamberfest"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Chamberfest welcomes back our dear friends the Gryphon Trio, fresh off their own 30th anniversary celebration season. Creative innovators with an appetite for discovery, the Gryphons are committed to redefining chamber music for the 21st century, having commissioned over 85 new works and continually collaborating on projects that push the boundaries of classical music. For their programme, they champion living American composers Reena Esmail and Paul Wiancko, pairing two daring new works with Mendelssohn’s beloved Piano Trio in D Minor. With “ensemble and tonal control [that] can be almost breathtaking” [Analekta], these fan favourites will move you with every note."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://www.chamberfest.com/event/2024/gryphon-trio-breathe/"
      }
    ],
