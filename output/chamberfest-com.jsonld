    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Holiday Extravaganza: Let in the Light! | Chamberfest"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Join us for a Holiday Extravaganza! Celebrate the joys of the winter solstice, the holidays, and the return of the light, Chamberfest style! Exploring Diwali, Hannukah and even Christmas, Ottawa Chamberfest brings you stellar musicians playing classical and modern works in a program narrated by the CBC’s Tom Allen. Holiday Extravaganza: Let in the Light! December 15th, Carleton Dominion Chalmers Centre. Tickets at Chamberfest.com. Chamberfest Holiday Extravaganza: Let in the Light!"
      }
    ],
