    "http://ogp.me/ns#title": [
      {
        "@language": "fr-fr",
        "@value": "Donate | Chamberfest"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "Ottawa Chamberfest, under the motto Changing lives through music, presents and celebrates chamber music year-round through its three pillars: our annual summer festival, our year-round concert series, and our community engagement and education activities, including our beloved Chamber Chats. Established in 1994, the organization will celebrate 30 years in 2024. You can help us continue changing lives through music with a donation today or in the future."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-fr",
        "@value": "https://www.chamberfest.com/fr/donate/"
