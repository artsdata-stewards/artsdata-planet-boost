  {
    "@id": "https://www.chamberfest.com/event/2024/chamberfests-rising-stars-showcase-2024/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
