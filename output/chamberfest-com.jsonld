  {
    "@id": "https://www.chamberfest.com/event/2024/allison-au-migrations/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Allison Au: Migrations | Chamberfest"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Lauded as Canada’s new jazz ambassador, Allison Au is a Toronto-based award-winning saxophonist, composer, arranger, and singer. Highly regarded for her distinctive and imaginative voice as both a performer and composer, the concert will feature Au’s Juno-nominated album Migrations in its entirety. Inspired by Au’s family history of immigration to Canada and commissioned by the Royal Conservatory of Music, the Migrations suite marks the first time Au has featured both vocals and string quartet in her writing. Accompanied by her 10-piece Migrations Ensemble, their seamless performance of these complex ideas, issues, and arrangements seems effortless, “…weaving lush, mosaic-like dreamscapes with poignant, heartrending lyrics.”"
      }
    ],
    "http://ogp.me/ns#url": [
