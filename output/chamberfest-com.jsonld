        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "City Series: uOttawa Vocal Students and Alumni"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Recent graduates and students of the uOttawa School of Music voice department are on showcase with this noon hour recital. Weaving together stories of underrepresented voices in the traditional canon, this performance is also part of Chamberfest’s ChamberPride series. Don’t miss the world premiere of p. lukic’s Sappho at the coffeeshop, a piece about young love and relationships with lush harmony and captivating storytelling."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
