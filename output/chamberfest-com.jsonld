    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "Ô-Celli vous emmène prendre la température des pays du sud. De la péninsule ibérique au continent sud-américain, l'ambiance va être caliente!"
      }
    ],
