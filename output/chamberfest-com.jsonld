    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "Chamberfest Presentation d'Aizuri Quartet | 24 Février 2023 Le quatuor américain Aizuri Quartet, entièrement féminin, fait ses débuts au Chamberfest lors de cette série de concerts. Connu pour sa programmation pionnière et sa création musicale, Aizuri Quartet apporte sur la scène d’Ottawa un programme de pièces pour cordes soigneusement organisé."
      }
    ],
