    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Following human journeys and the places they cross, Óró features street dancers from Dakar, Paris and Vancouver. They explore notions of shadow, identity and hope, <a href=\"https://thedancecentre.ca/event/mandala-arts-culture-society-3/\">[...] </a>"
      },
