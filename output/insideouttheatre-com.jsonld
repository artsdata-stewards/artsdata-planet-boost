    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Melusine, the oldest daughter, of an oldest daughter, of an oldest daughter, is on trial.\n\nHer crime? Possessing a body that cannot be believed.\n\nA story of intergenerational bathtubs, mysterious chronic illness, and a barista with a top-secret brew, performed with the musical accompaniment of an ex"
      }
