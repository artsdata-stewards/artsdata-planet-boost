    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A physical theatrical journey into darkness and discovery.  Step into a magical world where light is something to be caught, protected, and understood.  The Light of the Deep is a visually stunning new work of physical theatre created and performed by acclaimed artist Landon Krentz."
      }
