    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Punch Line, a solo work by Jacques Poulin-Denis, borrows as much from the comedic style of a one man show as it does from the intimacy and depth of a confession. In the guise of an artist talk, Jacques Poulin-Denis shares his takes on life and loses himself in thought. Through stories and anecdotes"
      }
    ],
