    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Join us on “Mat Night” for this back to back Halloween double feature of the original 1978 classic Horror and the 2018 version which sees the re-appearance of Michael Myers in Laurie Strode’s life (Jamie Lee Curtis) 40 years later.   Tickets:   $10 each film or $15 for both films  Halloween (1978) •"
      }
    ],
