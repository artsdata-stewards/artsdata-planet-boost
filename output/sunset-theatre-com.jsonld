    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Based on Tom Stoppard's play, this erudite comedy rethinks Hamlet by telling the story of two of its least important characters.   The duo debates the theory of probability, the nature of Hamlet's madness, and which of them is Rosencrantz and which Guildenstern while Shakespeare's tragedy plays out"
      }
