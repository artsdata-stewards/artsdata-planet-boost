    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Synopsis:  Ever had a reoccurring dream? Paul Tedeschini has. Once a month his sleeping mind brings him back to a chunk of his life, working as an actor and clown in Toronto, locked in a race between the joys of creativity and his anxiety’s attempts to drown him.  Please join us at The Sunset Theatr"
      }
    ],
