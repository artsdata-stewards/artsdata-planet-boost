    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Arthur Conan Doyle's short story - The Lion's Mane • A Reading in One Act — Sunset Theatre"
      }
    ],
    "http://ogp.me/ns#latitude": [
      {
        "@language": "en-us",
        "@value": "40.7207559"
      }
