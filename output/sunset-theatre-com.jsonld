    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The Fugitives are an acoustic folk-roots group headed by songwriters Adrian Glynn and Brendan McLeod. They’re joined by banjo player Chris Suen (Viper Central) and violinist Carly Frey (The Coal Porters). Over their first five albums, they’ve amassed a JUNO nomination, numerous CFMA and WCMA nominat"
      }
