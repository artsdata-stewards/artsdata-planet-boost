    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "For the second time in the second of two days, Molly Wilson brings to the Sunset a high-energy, heartfelt musical comedy cabaret in a vibrant celebration of Canada’s most iconic female singers.  From  Anne Murray to Alanis Morissette, Carly Rae Jepsen to Celine Dion, and K.D. Lang to Joni Mitchell ,"
      }
    ],
