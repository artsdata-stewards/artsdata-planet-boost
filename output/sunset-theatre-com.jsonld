    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Like everything in the 80s, be it clothing, cars, interest rates, milk-based cocktails and music, everybody took the regular  vaganza ™ that marks an ordinary decade and added an excessive  extra ™ to it.   Come celebrate with us, awash in the synth-driven-artificial warmth that only the shallowest"
      }
