    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The Ebbs will take the Sunset stage on Saturday, November 20 @ 8PM. Join us for what will be a fabulous evening of live music and song.      The Ebbs    The Ebbs are an indie folk band based in Prince George, British Columbia, Canada. Singer-songwriters William Kuklis and Joe Shea, have joined force"
      }
