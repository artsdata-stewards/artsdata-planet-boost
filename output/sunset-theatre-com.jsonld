    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "A stunning tribute to the resilience of Indigenous people and their way of life, SUGARCANE, the debut feature and Oscar-nominated documentary from Julian Brave NoiseCat and Emily Kassie, is an epic cinematic portrait of a community during a moment of international reckoning. In 2021, evidence of unm"
      }
