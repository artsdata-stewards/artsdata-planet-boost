    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Tickets are still available for the Winter Film Festival at the Sunset Theatre in Wells on  Saturday February 18th, 7pm.  Our local outdoor guide, Dave Jorgenson, always puts together an entertaining selection of short films on winter, the outdoors and the people who love it. Don’t miss it!   Ticket"
      }
