    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "HALF/ASIAN with Amy the CODA are a synth pop duo that sing harmonies in English and sign language. Blending their voices and stories into a sound and performance that is truly unlike any other. A PSR 36 synthesizer from 1980 sets the tone and tempo. Their harmonious voices tell stories with heart. T"
      }
