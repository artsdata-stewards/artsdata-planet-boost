    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "This performance of Jake’s Gift will be a fundraiser for Juno Productions upcoming tour of Jake’s Gift in Normandy, France for the 75th Anniversary of D-Day. Jake’s Gift was inspired by Julia Mackey’s own journey to Normandy for the 60th anniversary of D-Day. 15 years later, they are returning to No"
      }
