    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Join us as we contemplate the year we've had so far.   As we begin the Thanksgiving Weekend , local writers and a few musicians share their reflections on what they are grateful for in a year that has been difficult for so many across the globe.   We will have the full line up of artists posted here"
      }
