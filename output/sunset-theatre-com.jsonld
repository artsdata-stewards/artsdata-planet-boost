    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The Chimney Swallows are a unique folk music duo and microtheatre troupe composed of songwriters Raghu Lokanathan and Corwin Fox. Playing music together casually, while working for (&amp; picketing at) the Victoria Public Library the friends discovered they had a mutual affinity for long convers"
      }
