  {
    "@id": "https://www.sunset-theatre.com/calendar/2020/8/13/rosencrantz-amp-guildenstern-are-dead",
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en-us",
        "@value": "Sunset Theatre"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Rosencrantz & Guildenstern are Dead — Sunset Theatre"
      }
    ],
    "http://ogp.me/ns#latitude": [
      {
        "@language": "en-us",
        "@value": "40.7207559"
      }
    ],
    "http://ogp.me/ns#longitude": [
      {
        "@language": "en-us",
        "@value": "-74.0007613"
      }
    ],
    "http://ogp.me/ns#locality": [
      {
        "@language": "en-us",
        "@value": ""
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://www.sunset-theatre.com/calendar/2020/8/13/rosencrantz-amp-guildenstern-are-dead"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Based on Tom Stoppard's play, this erudite comedy rethinks Hamlet by telling the story of two of its least important characters.   The duo debates the theory of probability, the nature of Hamlet's madness, and which of them is Rosencrantz and which Guildenstern while Shakespeare's tragedy plays out"
      }
    ],
    "http://ogp.me/ns#image": [
