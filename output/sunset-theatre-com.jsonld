    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "We had so much fun at the 80s Dance Party on January 31st that we're doing it all again for Family Day Weekend, but this time with the fabulous tunes and attire from the 1970s.&nbsp;  Get looking through those 70s duds and send us your far-out tunes for our 70s playlist.&nbsp;  Come and join"
      }
    ],
