    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Calling all game fanatics! We’re hosting a FREE Game Night this Saturday July 5 at 8pm! We’ll have giant bowling, giant connect four and lots of board games to go around. Plus the concession will be open! Bring your favourite game, some friends and join us for this fun and competitive night!&nbs"
      }
