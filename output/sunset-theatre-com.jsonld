    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Award -winning actor, writer (Happiness™- ★★★★★) and storyteller Cory Thibert, embodies his 19-year-old self as he uncovers the truth behind what sets his family apart. This coming-of-age story with a twist, explores what constitutes “normal” in our world and how having parents with (dis)abilities c"
      }
