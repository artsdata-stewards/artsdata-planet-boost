    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "After 19 months, Sunset Cabaret is BACK!   Join us for this eclectic evening of sketch comedy, music, dance and poetry - all created by the many local performing artists that live in Wells.   Tickets:   $15/each Showtime:   8:00 PM Capacity:  50 patrons max so book your seats today at sunsettheatre@"
      }
