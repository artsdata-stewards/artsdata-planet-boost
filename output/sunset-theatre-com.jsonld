    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "For the past 4 months we’ve had our Sunset Cafe running on Wednesdays and Weekends as a To Go Cafe.   For the month of April the Cafe will be closed while we work on grants and Spring Cleaning.   Stay tuned for updates, and we will open again soon!"
      }
