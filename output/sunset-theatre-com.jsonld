    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Patrick Courtin performs live piano accompaniment to a screening of three classic Buster Keaton short films: 'The Balloonatic' (1923), 'Cops' (1922), and 'One Week' (1920).  'The Balloonatic' and 'Cops' will feature classic silent film music, selected and arranged by Patrick. 'One Week' will feature"
      }
