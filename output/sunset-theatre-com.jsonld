    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Join us on Thurdsay, October 29 @ The Sunset for this one act reading of Sir Arthur Conan Doyle's, The Lion's Mane, narrated by local actor &amp; musician, JP Winslow, who himself played Sherlock Holmes in the award winning film, The Doctor's Case, directed by James Douglas.  Doors open at 7:30P"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-us",
        "@value": "http://static1.squarespace.com/static/5c7de157ca525b4147689034/5ca0375571c10b981f0260b1/5f8495b94613457a8f8a64d2/1603776673927/sherlock-holmes-the-adventure-of-the-lions-mane.jpg?format=1500w"
      }
    ],
    "http://ogp.me/ns#image:width": [
