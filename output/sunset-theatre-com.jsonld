    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Tonight, Sunday, July 2nd @ 8PM we are hosting the Prince George based band, The Ebbs. They will be helping us celebrate the Canada Day Weekend with their toe tapping tunes and stunning harmonies.   The Ebbs eclectic sound has something for everyone;&nbsp;Folk, rock, soul, bluegrass, and traditi"
      }
