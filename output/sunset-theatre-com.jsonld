    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "SYNOPSIS:   As Brazil faces the tightening grip of a military dictatorship, Eunice Paiva, a mother of five, must reinvent herself and her family when authorities abduct her husband.   CRITICAL MASS:   Carried along by Fernanda Torres' superb performance,  I'm Still Here  poignantly explores a nation"
      }
    ],
