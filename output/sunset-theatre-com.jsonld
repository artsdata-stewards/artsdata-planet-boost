    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Tickets:   $15.00/each Running Time:   65 minutes - one act  As we enter Remembrance Week 2020, please join us for the multi-award winning play, Jake’s Gift, written and performed by Julia Mackey and directed by Dirk Van Stralen.    About the Play:   Jake’s Gift tells the story of a Canadian WW2 vet"
      }
    ],
