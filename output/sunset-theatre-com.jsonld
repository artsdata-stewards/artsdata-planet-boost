    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "WELLS IS OPEN AND SO IS THE SUNSET THEATRE!       WE ARE THRILLED TO BE ABLE TO PRESENT “WHERE IS GRISE FIORD”  AT THE SUNSET  THEATRE NOW THAT OUR EVACUATION ORDER HAS BEEN DOWNGRADED.       SEE YOU AT THE SUNSET ON MONDAY, JULY 29TH AND TUESDAY, JULY 30TH!       Showtime is 8PM      Tickets are $2"
      }
    ],
