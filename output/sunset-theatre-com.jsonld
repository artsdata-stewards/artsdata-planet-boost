    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Melissa McCarthy stars as Lee Israel - a frustrated, hard-drinking author who can barely afford to pay her rent or bills in 1990s New York.  Desperate for money, Israel soon hatches a scheme to forge letters by famous writers and sell them to bookstores and collectors.  When the dealers start to cat"
      }
