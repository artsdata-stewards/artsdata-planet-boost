    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Written and performed by Duane Forrest, this enthralling show combines storytelling, music, and audience engagement, as Duane brings to life the spirit and essence of Bob Marley's music.  Tickets are $25/each for Adults • $22.50 for Sunset Theatre 2024 Members • $15.00 for Students under 19   Buy He"
      }
