      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A recent masterclass that I gave at the Academy of Music in Ivano-Frankivsk, Ukraine,&nbsp;was a great experience for me personally.&nbsp; I was pleasantly surprised how open, expressive and receptive all of the students were. In fact, I should not have been so surprised.&nbsp;"
      }
