    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Consultez les merveilleux services disponibles aux résidents de Lebel-sur-Quévillon. Découvrez cette magnifique ville du Nord-du-Québec au c?ur de la Jamésie"
      },
      {
        "@language": "fr",
        "@value": "Apprenez-en plus sur les programmes aux citoyens offerts par la ville de Lebel-sur-Quévillon. Obtenez plus d'information sur chacun de ces programmes offerts"
      },
      {
        "@language": "fr",
        "@value": "Consultez la page des autorisations de tenue d'événement de la ville de Lebel-sur-Quévillon. Remplissez notre court formulaire de demande de tenue d'événement"
      },
      {
        "@language": "fr",
        "@value": "Envoyez une demande de publication d'un événement à la ville de Lebel-sur-Quévillon. Faites nous parvenir votre demande au moins 7 jours avant l'évènement"
      },
      {
        "@language": "fr",
        "@value": "Consultez le calendrier des activités à venir de la ville de Lebel-sur-Quévillon. Facilitez votre recherche en filtrant votre recherche par type d'évènement"
      },
      {
        "@language": "fr",
        "@value": "Obtenez le calendrier de séances du conseil municipal de la ville de Lebel-sur-Quévillon. Le conseil municipal tient une séance ordinaire à tous les mois"
      },
      {
        "@language": "fr",
        "@value": "Lisez les dernières nouvelles et les actualités au sujet de la ville de Lebel-sur-Quévillon sur le site Web. Restez à l'affut des dernières informations"
      },
      {
        "@language": "fr",
        "@value": "Payer un constat d'infraction en ligne sur le site de la ville de Lebel-sur-Quévillon. C'est simple et rapide! Pour de plus amples informations, contactez nous"
      },
      {
        "@language": "fr",
        "@value": "Formulez une plainte, envoyez une requête ou soumettez une demande d'information à la ville de Lebel-sur-Quévillon. Contactez-nous pour plus d'information"
      },
      {
        "@language": "fr",
        "@value": "Apprenez-en plus sur le rôle d'évaluation d'une propriété de la ville de Lebel-sur-Quévillon. Obtenez la valeur de votre propriété au prix du marché immobilier"
      },
      {
        "@language": "fr",
        "@value": "Visitez le site pour obtenir de plus amples renseignements sur la ville de Lebel-sur-Quévillon. Consultez notre formulaire pour les nouveaux arrivants"
      },
      {
        "@language": "fr",
        "@value": "Apprenez-en plus sur l'urbanisme de la ville de Lebel-sur-Quévillon. Consultez le plan d'urbanisme de la municipalité et le cadre réglementaire qui en découle"
      },
      {
        "@language": "fr",
        "@value": "Consultez la page sur les travaux et permis de la ville de Lebel-sur-Quévillon. Obtenez de l'information concernant l'obtention d'un permis et la tarification"
      },
      {
        "@language": "fr",
        "@value": "Accéder à tous les règlements municipaux. Pour plus d'information, visitez notre page sur les règlements municipaux de la ville de Lebel-sur-Quévillon"
      },
      {
        "@language": "fr",
        "@value": "Consultez la page sur les politiques relatives aux travaux et permis de la ville de Lebel-sur-Quévillon. Contactez nous pour plus d'informations à ce sujet"
      },
      {
        "@language": "fr",
        "@value": "Apprenez-en plus sur les axes foncières et le taux de taxation en vigueur de la ville de Lebel-sur-Quévillon."
      },
      {
        "@language": "fr",
