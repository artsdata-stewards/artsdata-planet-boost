    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Un spectacle qui entre dans l’intimité d’un comique qui comme le dit la rumeur a été conçu dans les coulisses d’une salle de spectacle"
      }
    ],
