  {
    "@id": "https://www.sallealbertrousseau.com/temporary/36eb412a-e8f9-4e33-a679-0e9115281fe7",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/eve-cote/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.sallealbertrousseau.com/media/2453/eve-cote_1920x1080.png"
      }
    ],
