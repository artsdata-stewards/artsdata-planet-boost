  {
    "@id": "https://www.sallealbertrousseau.com/temporary/df7c6dad-dc95-45fe-af1c-b0eb808b59fb",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/titanique/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.sallealbertrousseau.com/media/4209/jpr25_titanique_1920x1400.png"
      }
    ],
