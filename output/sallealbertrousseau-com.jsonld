  {
    "@id": "https://www.sallealbertrousseau.com/temporary/1d94d7ac-ec85-4857-94d6-387fe2534465",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/dan-bigras/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.sallealbertrousseau.com/media/3390/cv-bannière-facebook.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
