  {
    "@id": "https://www.sallealbertrousseau.com/temporary/5a79575d-c0b2-41c3-9fec-21bc6307e44c",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/generation-musiqueplus/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.sallealbertrousseau.com/media/4431/génération-musique-plus-1200x875.png"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-09-22T20:00:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1683620"
      }
    ],
    "http://schema.org/subEvent": [
      {
        "@id": "_:g1683660"
      },
      {
        "@id": "_:g1683820"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/generation-musiqueplus/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Pour célébrer ses 40 ans, le phénomène télévisuel MusiquePlus est de retour… sur scène! Revivez la frénésie de la meilleure des époques avec le spectacle Génération MusiquePlus – 86-96 qui propose les meilleurs hits, vidéoclips, entrevues et anecdotes de cette décennie.\r\nAlors que MusiquePlus entrait dans le salon des gens, c’est maintenant à votre tour d’entrer dans l’univers de MusiquePlus pour une soirée des plus festives. Animé par les VJs vedettes Geneviève Borne et Paul Sarrasin, ce spectacle vous permet de replonger dans vos souvenirs grâce à des extraits iconiques, des confidences inédites, des expériences interactives et, surtout, les plus grands hits de l’époque, livrés par Rafaëlle Roy et Jonas Tomalty, accompagnés de talentueux musiciens. De Nirvana aux BB, du Combat des clips à SolidRok, de Madonna à Jean Leloup, du Cimetière des CD à Bouge de là… vous pourrez revivre un condensé de votre programmation préférée le temps d’une soirée.\r\nSi aujourd’hui la chaîne télé n’est plus, elle est encore bien ancrée dans la mémoire collective de toute une génération et occupe une place de choix dans son cœur. Préparez vos jeans délavés et votre perfecto parce qu’avec ce spectacle, c’est l’heure de rallumer les néons, de remonter le son et de rassembler la génération MusiquePlus!"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Génération MusiquePlus"
      }
    ]
  },
