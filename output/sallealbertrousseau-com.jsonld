  {
    "@id": "https://www.sallealbertrousseau.com/temporary/fe02fc10-fb47-4938-90fa-d3252e415c6b",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "http://sallealbertrousseau.com/programmation/mariana-mazza/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.sallealbertrousseau.com/media/3592/2410_mmaz_mev-sar_1920x1080.png"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-02-11T20:00:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1835620"
      }
    ],
    "http://schema.org/subEvent": [
      {
        "@id": "_:g1835660"
      },
      {
        "@id": "_:g1835800"
      },
      {
        "@id": "_:g1835940"
      },
      {
        "@id": "_:g1836080"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "http://sallealbertrousseau.com/evenements/mariana-mazza"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Foie gras"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Pour son troisième spectacle, Foie Gras, Mariana Mazza décide de s’exprimer avec sa tête et son cœur… pour faire changement.\r\nDans ce one-woman-show bien personnel, la jeune fille qui a grandi à Montréal-Nord, maintenant rendue une femme embourgeoisée qui vit à Saint-Lambert avec ses caniches et ses toiles invendues, se montre aussi brillante qu’hilarante.\r\nÉtant habituée à dire des choses uniquement pour provoquer un rire, elle souhaite aller plus loin cette fois et faire un coming out au public : elle est émotive et vulnérable. Le chihuahua sur le Red Bull est officiellement remplacé par le tank au cœur de porcelaine.\r\nComme elle le dit si bien : « C’est moi la meilleure tabarnak! »\r\nOui, Mariana a changé. Mais à quel point?"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Mariana Mazza"
      }
    ]
  },
  {
    "@id": "http://sallealbertrousseau.com/evenements/francois-bellefeuille",
    "http://ogp.me/ns#site_name": [
      {
