      {
        "@id": "https://www.sallealbertrousseau.com/programmation/les-39-marches/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.sallealbertrousseau.com/media/3765/les-39-marches_1200x875.png"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-01-27T20:00:00"
      }
    ],
    "http://schema.org/location": [
      {
