  {
    "@id": "https://www.sallealbertrousseau.com/temporary/238b06ba-c8a7-4941-8483-71e2c4065d49",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/dave-fenley-trio/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.sallealbertrousseau.com/media/4082/dave-fenley-trio-nouveau-visuel_1920x1400.png"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-10-10T20:00:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1256220"
      }
    ],
    "http://schema.org/subEvent": [
      {
        "@id": "_:g1256260"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/dave-fenley-trio/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Trio"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Avec près de 40 000 billets vendus et plus de 50 représentations à travers le Québec, le chouchou du public québécois est de retour avec un tout nouveau spectacle : TRIO.\r\nRévélé en 2022 grâce à l’émission En direct de l’Univers, Dave Fenley charme par sa voix puissante et son style folk-country authentique. Pour cette nouvelle aventure sur scène, il s’entoure de sa mentore Lise Dion à la direction artistique, ainsi que des talentueux musiciens québécois Gabriella Laberge et John Antony Gagnon Robinette.\r\nUn spectacle riche en émotions et parsemé de surprises, à ne pas manquer."
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Dave Fenley"
      }
    ]
  },
  {
    "@id": "https://www.sallealbertrousseau.com/programmation/zenith/",
