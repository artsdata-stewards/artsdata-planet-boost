    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/mona-de-grenoble/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "De la poudre aux yeux"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "J’aurais pu appeler ce show d’humour-là Étalon en talons ou Entre Bâton Rouge et matante, mais après j’ai désaoulé pis je me suis rendue compte que vous allez sûrement vous reconnaître dans mon personnage que certains décrivent comme étant flamboyant, grivois et solvable depuis Big Brother. Parce que, dans le fond, on le sait, les paillettes, les robes pis les grosses perruques c’est juste de la poudre aux yeux.\r\nDurée approximative du spectacle : 90 minutes sans entracte."
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Mona De Grenoble"
      }
    ]
  },
