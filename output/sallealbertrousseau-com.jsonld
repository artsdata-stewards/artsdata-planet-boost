  {
    "@id": "https://www.sallealbertrousseau.com/temporary/39cf80f3-6a08-461f-aa48-89257706874e",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/guillaume-pineault/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.sallealbertrousseau.com/media/3616/gpineault_vulnérable_1920x1400.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-01-30T20:00:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g931540"
      }
    ],
    "http://schema.org/subEvent": [
      {
        "@id": "_:g931580"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/guillaume-pineault/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Vulnérable"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Malgré l’air calme et confiant que je peux dégager sur mon affiche, derrière cette façade, se cachent plusieurs mécanismes de défense, beaucoup d’anxiété et 65 % d’eau (oui, c’est vraiment le pourcentage d’eau dans le corps adulte; je le sais, je l’ai appris à l’université, et j’adore rappeler aux gens que j’ai des connaissances biologiques grâce à mon passé académique).\r\nDans ce spectacle, il n’y a plus de filtre, aucune carapace : vous aurez accès à un Guillaume plus intime, authentique et vulnérable. Bien entendu, mon désir premier est de vous faire rire, mais également de vous faire découvrir l’humain derrière l’humoriste.\r\nAu plaisir de vous voir et de vous présenter : VULNÉRABLE\r\nDurée approximative : première partie de 15 minutes et spectacle de 90 minutes sans entracte."
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Guillaume Pineault"
      }
    ]
  },
