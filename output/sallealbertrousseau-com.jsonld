  {
    "@id": "https://www.sallealbertrousseau.com/temporary/68f9251c-5527-48e0-b93b-7b565f0a7076",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/garou/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.sallealbertrousseau.com/media/4016/garou_1920-1080.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-04-22T20:00:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1037280"
      }
    ],
    "http://schema.org/subEvent": [
      {
        "@id": "_:g1037320"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/garou/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Garou Solo"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Garou a fait paraître Un meilleur lendemain en avril 2025, son tout premier album à titre d’auteur-compositeur. L’artiste a pris la plume parce qu’il avait des choses à dire! Le résultat : dix chansons très intimes qui ont été travaillées avant tout pour la scène et qui marquent un nouveau départ, dévoilent une nouvelle vision musicale. Après des années de recherche sonore en résidence dans son studio, son nouveau spectacle Garou solo est une invitation en chansons dans un univers cinématique et théâtral.\r\nSeul en scène, Garou prend la route avec son piano et sa guitare, tout en s’accompagnant au moyen de diverses technologies. Dans une rétrospective autant autobiographique qu’éclectique, il raconte en paroles et en musique cette vie complètement folle, ces expériences extraordinaires, ces moments de solitude en pleine nature, les grandes amitiés et la richesse de l’amour qui l’entourent. Revisitant ainsi plus de 30 ans de carrière, il interprète ses chansons classiques et ses nouvelles pièces dans une mise en scène élégante, soutenue par une scénographie tout en images."
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Garou"
      }
    ]
  },
