    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Maître de l’insaisissable et raconteur hors pair, Alain Choquette revient sur scène avec une nouvelle proposition aussi divertissante qu’inspirante, Entre histoires et illusions."
      }
