      {
        "@id": "_:g1493560"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/titanique/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "La parodie musicale avec des chansons de Céline Dion"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Quand la musique de Céline Dion épouse le grand succès du film Titanic, onze fois couronné d’un Oscar®, vous obtenez TITANIQUE, un délire musical qui transforme l’une des plus grandes histoires d’amour de tous les temps en une fantaisie théâtrale complètement déjantée.\r\nVous voulez savoir ce qui est réellement arrivé à Jack et Rose lors de cette nuit fatidique? Laissez Céline Dion vous le raconter à sa façon avec son interprétation totalement farfelue, redessinant le parcours des moments cultes et des personnages bien-aimés de Titanic grâce à son répertoire de chansons emblématiques.\r\nMettant en vedette Véronique Claveau et 12 chanteurs flamboyants dont Audrey-Louise Beauséjour, Guillaume Borys et Jean-François Guevremont, TITANIQUE est une traversée musicale unique, débordante de nostalgie, d’émotion et de chaos assumé, portée par des voix puissantes, des performances renversantes des plus grandes chansons de Céline Dion My Heart Will Go On, All By Myself et To Love You More, et l’énergie de quatre musiciens sur scène.\r\nAvec ses clins d’œil savoureux à la culture pop et son humour queer assumé, ce spectacle haut en couleur présenté en français, promet de faire des vagues… et de déclencher un raz-de-marée de rires.\r\nEmbarquez à bord du navire des rêves et montez le volume pour ce joyeux naufrage!\r\nEXPÉRIENCE VIP – Prenez le large en grand luxe\r\nProfitez des meilleurs sièges en avant-scène, plongez au cœur de l’action déjantée, et savourez un verre de bulles accompagné de mignardises pour une soirée festive!\r\nCommuniquez avec notre billetterie par téléphone ou au guichet pour faire l'achat de ce forfait.\r\nDurée :\r\n100 minutes sans entracte\r\nÂge recommandé :\r\nRecommandé pour les 14 ans et plus en raison d’humour pour adultes et de langage explicite. C’est une soirée parfaite entre ami.e.s ! Toute personne entrant dans le théâtre, peu importe son âge, doit avoir un billet."
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Titanique"
      }
    ]
  },
