  {
    "@id": "https://www.sallealbertrousseau.com/temporary/3760d89c-538f-4930-8b79-6dec3f078125",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/jean-francois-mercier/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.sallealbertrousseau.com/media/4137/jf-mercier-1920x1080.png"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-04-11T20:00:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g696300"
      }
    ],
    "http://schema.org/subEvent": [
      {
        "@id": "_:g696340"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/jean-francois-mercier/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Avis d'ébullition"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Jean-François Mercier est de retour sur scène pour tester du nouveau matériel en vue de son quatrième spectacle en carrière!\r\nAvec son regard critique et pertinent, son ton souvent corrosif et parfois émouvant, il ramène son humour singulier sur les planches avec un seul objectif : brasser une fois de plus la cage de l'humour en confrontant nos convictions pour nous faire rire de nos travers, mais aussi des siens. Auteur de grand talent, animateur et comédien, c'est sur scène, nourri par les réactions du public, qu'il trouve sa voix d’humoriste pour nous faire rire et réfléchir."
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Jean-François Mercier"
      }
    ]
  },
