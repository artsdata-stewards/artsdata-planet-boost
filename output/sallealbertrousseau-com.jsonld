    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/mike-ward-modeste/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Modeste"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Grâce à la qualité de son stand-up, la popularité de son podcast et sa victoire à la cour suprême, Mike Ward est devenu une véritable icône de l’humour québécois. \nAvec plus de 100 millions de téléchargements et une diffusion au Centre Bell ayant fracassé un record Guinness pour le plus de billets vendus pour un enregistrement de podcast, Sous Écoute est non seulement le podcast d’humour francophone le plus populaire au monde, mais aussi un phénomène culturel.\nNoir, son dernier one-man-show, a été encensé par la critique et lui a permis de gagner tous les trophées possibles pour un spectacle d’humour au Gala Les Olivier.\nIl présente maintenant son tout nouveau spectacle : Modeste.\nDurée approximative du spectacle : première partie de 15 minutes / spectacle de 90 minutes sans entracte."
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Mike Ward"
      }
    ]
  },
