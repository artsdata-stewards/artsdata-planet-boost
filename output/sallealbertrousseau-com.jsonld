      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Pour une autre histoire d'un soir - Programmation | Salle Albert-Rousseau"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Joe Bocan, Marie Carmen et Marie Denise Pelletier présentent le spectacle Pour une autre histoire d’un soir à la Salle Albert-Rousseau."
      }
    ],
    "http://ogp.me/ns#image": [
