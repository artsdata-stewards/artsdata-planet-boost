        "@value": "Salle Albert-Rousseau"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr",
        "@value": "https://www.sallealbertrousseau.com/programmation/titanique/"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Titanique - Programmation | Salle Albert-Rousseau"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Quand la musique de Céline Dion épouse le grand succès du film Titanic, vous obtenez TITANIQUE, présenté à la Salle Albert-Rousseau, un délire musical et une fantaisie théâtrale complètement déjantée."
      }
    ],
    "http://ogp.me/ns#image": [
