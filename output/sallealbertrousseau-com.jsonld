      {
        "@id": "_:g1027680"
      }
    ],
    "http://schema.org/subEvent": [
      {
        "@id": "_:g1027720"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/alex-roy/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Debout"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Après plus de 100 représentations et plus de 22 000 billets vendus pour son premier one man show Des choses qui arrivent, Alex Roy nous replonge dans son univers maladroit, surprenant et hilarant avec son tout nouveau spectacle Debout !  Celui qui vous a fait hurler de rire durant les premières parties de Lise Dion, Les Grandes Crues et José Gaudet vous séduira à nouveau avec ses anecdotes personnelles et auxquelles on peut rapidement s’identifier.\r\nSi vous avez un spectacle à voir cette année, un artiste à découvrir et à faire découvrir à vos amis, c’est sans aucun doute Alex Roy ! "
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Alex Roy"
      }
    ]
  },
