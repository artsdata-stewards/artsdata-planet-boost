  {
    "@id": "https://www.sallealbertrousseau.com/temporary/de562be5-d664-4712-8a0d-298501ed1f28",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/richardson-zephir/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.sallealbertrousseau.com/media/3968/richardson-zephir_1920x1400.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-03-03T20:00:00"
      }
    ],
