  {
    "@id": "https://www.sallealbertrousseau.com/temporary/b2c0e1a5-5df0-4b52-ac2e-8685f3847b71",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/peter-pan-comedie-musicale/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.sallealbertrousseau.com/media/4273/ppan_mev-sar_1920x1400.jpg"
      }
    ],
