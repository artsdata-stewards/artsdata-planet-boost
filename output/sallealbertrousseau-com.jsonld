  {
    "@id": "https://www.sallealbertrousseau.com/temporary/6d4fc00b-b4ff-47b6-aa86-3992b251d804",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/dominic-paquet/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.sallealbertrousseau.com/media/4132/dominic-paquet_jclg_sar_1920x1400.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
