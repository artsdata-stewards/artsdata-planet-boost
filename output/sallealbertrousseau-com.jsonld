        "@value": "Québec-Montréal sur scène - Programmation | Salle Albert-Rousseau"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Le film culte du cinéma québécois Québec-Montréal fait ses débuts sur les planches et sera présenté à la Salle Albert-Rousseau!"
      }
    ],
