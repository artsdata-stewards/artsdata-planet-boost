  {
    "@id": "https://www.sallealbertrousseau.com/temporary/cc23ce4e-f577-4c25-b8ec-55effb3e05e4",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/fallait-pas-dire-ca/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.sallealbertrousseau.com/media/4243/frallait-pas-dire-ça1920x1400.png"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-06-02T20:00:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1356900"
      }
    ],
    "http://schema.org/subEvent": [
      {
        "@id": "_:g1356940"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/fallait-pas-dire-ca/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Avec Denis Bouchard et Guylaine Tremblay"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Au cours d’une fin de semaine de vacances pour fêter leurs trente ans de vie commune, Diane et Normand ont une discussion très animée sur les problèmes et sujets de société auxquels ils font face aujourd’hui. \r\nArgent, politique, famille, GPA, chirurgie esthétique ou réseaux sociaux sont autant de sujets qui sont abordés. \r\nDans cette comédie, cet échange de points de vue donne lieu à des répliques vives et spontanées. Et… ils s’en donnent à cœur joie! Qui peut dire quoi? Quand? À qui? Et dans quelles circonstances? \r\nDes petits mots du quotidien aux questions existentielles en passant par les secrets de famille, Diane et Normand n’ont de cesse de se contredire sur tout et son contraire! \r\nD’après une pièce de Salomé LelouchMise en scène et interprétée par Guylaine Tremblay et Denis Bouchard \r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\nDurée approximative du spectacle : 90 minutes sans entracte.\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n "
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Fallait pas dire ça!"
      }
    ]
  },
  {
    "@id": "https://www.sallealbertrousseau.com/programmation/gregory-charles-noir-blanc/",
