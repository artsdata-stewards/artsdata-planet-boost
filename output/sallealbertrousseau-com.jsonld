  {
    "@id": "https://www.sallealbertrousseau.com/temporary/e0c3a584-f8e1-470d-bf7d-dc09f64a6b5b",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/breen-leboeuf/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.sallealbertrousseau.com/media/3612/1920-x-1080.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-05-10T20:00:00"
      }
    ],
    "http://schema.org/location": [
      {
