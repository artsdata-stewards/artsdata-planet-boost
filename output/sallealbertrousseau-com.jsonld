  {
    "@id": "https://www.sallealbertrousseau.com/temporary/1552c445-d03a-446d-86bc-f334b29e33c3",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/roch-voisine/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.sallealbertrousseau.com/media/4288/roch-voisine-helene-35-1200x875.png"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-04-21T20:00:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1605220"
      }
    ],
    "http://schema.org/subEvent": [
      {
        "@id": "_:g1605260"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/roch-voisine/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Hélène 35"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "En nomination pour le spectacle de l’année à l’ADISQ 2025.\r\nPour fêter les 35 ans de son album Hélène, certifié diamant grâce à plus d’un million de copies vendues, un disque qui a propulsé la « Rochmania » à des sommets inégalés, Roch Voisine nous revient avec un spectacle exceptionnel et fort en émotions.\r\nAvec ses hits qui ont traversé les décennies, comme les immenses succès Hélène, Là-bas dans l’ombre et Avant de partir, L’idole a marqué toutes les générations. Vivez une immersion dans l’univers de l’une des voix les plus emblématiques de la scène musicale francophone.\r\nVous serez transportés dans le temps, revivant chaque émotion, chaque mélodie qui a fait de ses chansons des souvenirs intemporels. Une expérience unique qui ravira les fans de tous âges!"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Roch Voisine"
      }
    ]
  },
  {
