    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/brigitte-boisjoli-elvis/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Elvis, Bring Back '68"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Entourée de 4 musiciens, Brigitte Boisjoli fait revivre la fièvre Elvis Presley!\r\n« Elvis a marqué les générations par son talent, sa beauté et sa voix qui semblait sortie tout droit d’un chœur gospel. Un rock’n’roll qui a dérangé, qui s’est déhanché. Et moi, ça m’appelait déjà, étant toute jeune. Cette fougue, cette énergie qui me soulève… Ce besoin urgent de chanter qui je suis, tout comme Elvis. Aujourd’hui, je le sens, je suis prête pour le rock’n’roll d’une vie, celle d’Elvis, mon Elvis! »\r\n-Brigitte Boisjoli"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Brigitte Boisjoli"
      }
    ]
  },
