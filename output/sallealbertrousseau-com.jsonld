      }
    ],
    "http://schema.org/subEvent": [
      {
        "@id": "_:g1173880"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/dan-bigras/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Cette voix: Dan et Gerry, notre histoire"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Cette Voix se veut un témoignage d'affection de Dan Bigras envers son ami Gerry Boulet. Tout d'abord bouleversé à la première écoute de la chanson La voix que j'ai, la carrière musicale de Dan a été possible grâce à l'aide de celui qui allait devenir un grand ami : Gerry. Ce parcours unique vous sera raconté au travers d'anecdotes et de chansons gravitant autour de l'univers de ce rockeur plus grand que nature, jusqu'à ce legs incroyable que fût Jézabel, réalisé par Dan Bigras.\r\nDans ce spectacle, Dan Bigras s'est donné le défi de ramener Gerry sur scène, avec lui et ses musiciens, afin d'entremêler leurs voix et leurs instruments.\r\nDurée approximative du spectacle : 1h45 sans entracte."
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Dan Bigras"
      }
    ]
  },
  {
