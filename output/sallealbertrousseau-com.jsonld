      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1387040"
      }
    ],
    "http://schema.org/subEvent": [
      {
        "@id": "_:g1387080"
      },
      {
        "@id": "_:g1387160"
      },
      {
        "@id": "_:g1387240"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/pierre-hebert/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Grandiose"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Tous les matins, on se lève avec le même objectif : que notre vie soit grandiose! \nOn en rêve, on s’épuise, on se dénature, on se casse la gueule et parfois, pendant un court instant, on y arrive. C’est à ce moment qu’on réalise que tout ça en valait la peine. Tout ce chemin, tous ces efforts pour vivre ce moment parfait qui veut tout dire, avant que tout se termine pour de bon.\nQuatre ans après la fin de la tournée Le goût du risque, Pierre Hébert reprend enfin la route avec son nouveau spectacle : Grandiose.\nOn y retrouve l’humoriste souvent moqueur, parfois touchant, qui porte un regard plein d’humour et d’émerveillement sur le monde qui l’entoure."
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Pierre Hébert"
      }
    ]
  },
