    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Le podcast des Denis Drolet"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Rince-Crème, le podcast des Denis Drolet, enregistré devant public!\r\nLes Denis Drolet discutent ensemble de plusieurs sujets pigés au hasard. Qu’ils soient pointus ou populaires, drôles ou tabous, logiques ou fous, le duo élabore sans retenue ni censure sur les thèmes imposés.\r\nAccompagnés de leur acolyte André, aka Justo-By My-Love, et d’un invité, les Denis se lâchent lousse comme jamais, pour le plus grand plaisir de tous."
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Rince-Crème"
      }
    ]
  },
