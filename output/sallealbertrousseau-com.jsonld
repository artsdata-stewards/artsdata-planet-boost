    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "De ce qui devait être une courte aventure est née une grande passion, qui est au premier plan de ce quatrième spectacle de Simon Gouache à la Salle Albert-Rousseau."
      }
    ],
