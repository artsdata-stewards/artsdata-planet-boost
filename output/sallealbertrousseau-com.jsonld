    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Pierre Hébert - Programmation | Salle Albert-Rousseau"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Quatre ans après la fin de la tournée Le goût du risque, Pierre Hébert reprend enfin la route avec son nouveau spectacle : Grandiose."
      }
    ],
    "http://ogp.me/ns#image": [
