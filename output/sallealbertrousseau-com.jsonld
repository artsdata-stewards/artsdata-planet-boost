        "@id": "_:g1367640"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/gregory-charles-noir-blanc/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Un soir en Noir & Blanc"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Il y a un peu plus de vingt ans, Gregory Charles présentait Noir &amp; Blanc, un spectacle présenté plus de 40 fois au Centre Bell et vu par près de 2 millions de spectateurs au Québec, dans le reste du Canada, aux États-Unis, au Royaume-Uni, en France, au Japon et même en Chine. Il y racontait l'histoire métissée de ses parents et éblouissait par son talent et ses connaissances musicales infinies dans un désormais légendaire segment de demandes spéciales.Voilà que dans son nouveau spectacle, Un soir en Noir &amp; Blanc, Gregory raconte sa propre histoire, choisissant quelques moments tournants de sa vie et déclinant ces instants en surprenantes anecdotes et en une joyeuse et éclatante explosion de musique. Venez vivre des instants de pur bonheur avec Gregory et, évidemment... préparez vos demandes spéciales."
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Gregory Charles"
      }
    ]
  },
  {
    "@id": "https://www.sallealbertrousseau.com/programmation/pierre-hebert/",
