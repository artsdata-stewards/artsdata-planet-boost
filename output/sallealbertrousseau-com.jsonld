        "@id": "https://www.sallealbertrousseau.com/programmation/fondation-cegep-ste-foy-2026/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.sallealbertrousseau.com/media/4351/fondation-csf_rideau-rouge-2026-1200x675.png"
      }
    ],
