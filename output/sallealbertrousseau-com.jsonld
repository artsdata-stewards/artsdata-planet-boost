  {
    "@id": "https://www.sallealbertrousseau.com/temporary/74cf661a-9bd9-4128-9dcb-bdd3b262661a",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/messmer/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.sallealbertrousseau.com/media/3317/messmer_13hz_canada_1920x1080.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
