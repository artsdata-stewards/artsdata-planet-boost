  {
    "@id": "https://www.sallealbertrousseau.com/temporary/b539d8c6-21ea-4a8c-ad72-2356fe044b8f",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/les-bb-ludovick-bourgeois-2025/"
      }
    ],
    "http://schema.org/image": [
