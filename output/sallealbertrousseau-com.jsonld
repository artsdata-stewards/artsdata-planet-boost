  {
    "@id": "https://www.sallealbertrousseau.com/temporary/31ae092c-3f78-444a-ba47-7f1dd9543eea",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/megan-brouillard/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.sallealbertrousseau.com/media/3175/v2_1920x1080.png"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-04-17T20:00:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1153140"
      }
    ],
    "http://schema.org/subEvent": [
      {
        "@id": "_:g1153180"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/megan-brouillard/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Chiendent"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": " \"Ça pousse Comme du Chiendent!\" Ma grand-mère disait souvent ça. Je ne savais pas ce que c'était de Chiendent. \"Y faut arracher le chiendent avant qui pousse en graine!\" qu'à criait à toés étés. Pour être honnête je pensais que c'était une espèce d'expression dont seule ma grand-mère connaissait la ritournelle. Je pensais aussi que c'était peut-être une insulte. Un mélange entre \"enfant de chienne\" pi \"fendant\". Finalement j'ai appris que le Chiendent c'est juste une mauvaise herbe bien normale qui pousse un peu partout. Vous connaissiez ça? \r\nY’a plein de chiendent dans mon heure. Faut que je l’enlève avant qu’il monte en graine. \r\nAprès on va mieux voir les fleurs que j’essaye de faire pousser! \r\nJ’espère juste que ces fleurs-là sentent pas la vieille snowbird qui se parfume dans les kits qui donnent à Noël, tsé ceux qui viennent avec le lait pour le corps, le parfum pis les bulles pour le bain. \r\nVenez sentir voir. \r\nDurée approximative du spectacle : 90 minutes sans entracte."
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Mégan Brouillard"
      }
    ]
  },
  {
    "@id": "https://www.sallealbertrousseau.com/programmation/mona-de-grenoble/",
    "http://ogp.me/ns#site_name": [
      {
        "@language": "fr",
        "@value": "Salle Albert-Rousseau"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr",
        "@value": "https://www.sallealbertrousseau.com/programmation/mona-de-grenoble/"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Mona De Grenoble - Programmation | Salle Albert-Rousseau"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Parce que, dans le fond, on le sait, les paillettes, les robes pis les grosses perruques c’est juste “de la poudre aux yeux”"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "/media/3177/monadegrenoble_1920x1080.jpg"
      }
    ]
  },
