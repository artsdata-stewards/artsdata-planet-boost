    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Humoriste présente à la radio tous les jours depuis 2018, vous serez ravi de découvrir l’univers d’Eve Côté à la Salle Albert-Rousseau avec sa dégaine gaspésienne et son humour imagé."
      }
    ],
