    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Jérémy Demay, le plus québécois des humoristes français, résidant au Québec depuis plus de 17 ans, sera à la Salle Albert-Rousseau avec son tout nouveau spectacle intitulé Naturel."
