  {
    "@id": "https://www.sallealbertrousseau.com/temporary/4ec87b4b-d889-4200-8383-94dd2582e336",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/messmer/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.sallealbertrousseau.com/media/3317/messmer_13hz_canada_1920x1080.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
