  {
    "@id": "https://www.sallealbertrousseau.com/temporary/9d65f0d8-9361-4ae1-8d9e-75313d2e021f",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/rita-baga/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.sallealbertrousseau.com/media/4282/rita-baga1200x875.png"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-05-18T20:00:00"
      }
