      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr",
        "@value": "https://www.sallealbertrousseau.com/programmation/francois-bellefeuille/"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "François Bellefeuille - Programmation | Salle Albert-Rousseau"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "François Bellefeuille est de retour sur scène avec son troisième spectacle : Sauvage. Préparez-vous à avoir mal aux abdos, il est au sommet de son art!"
      }
    ],
    "http://ogp.me/ns#image": [
