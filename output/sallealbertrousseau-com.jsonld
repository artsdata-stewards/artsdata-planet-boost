  {
    "@id": "https://www.sallealbertrousseau.com/temporary/fd771d04-ead3-476d-83ec-2e4f5eca619d",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/dan-bigras/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.sallealbertrousseau.com/media/3390/cv-bannière-facebook.jpg"
      }
    ],
    "http://schema.org/startDate": [
