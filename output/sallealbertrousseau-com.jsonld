  {
    "@id": "https://www.sallealbertrousseau.com/temporary/fd0d7aa0-5e2f-448f-90bb-16fdedbf1c4b",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/maude-landry/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.sallealbertrousseau.com/media/4244/maude-landry_tropcool_1920x1400.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-04-13T20:00:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1562820"
      }
    ],
    "http://schema.org/subEvent": [
      {
        "@id": "_:g1562860"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/maude-landry/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Trop cool"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dans un monde où il faut se démarquer tout en suivant les tendances, Maude Landry se demande pourquoi elle n’a jamais fait partie de la gang des cools. C’est ce qui la rend attachante. Décontractée et pince-sans-rire, elle pose son regard taquin sur elle-même et sur la société, en passant délibérément par quatre chemins. Un spectacle moderne et assumé, pendant lequel on se dit parfois « C’est niaiseux!... Mais fallait y penser ». Maude vous invite dans un périple au cœur de ses réflexions, ses doutes et ses déboires, pour que vous sortiez de la salle en disant « C’était trop cool! »"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Maude Landry"
      }
    ]
  },
