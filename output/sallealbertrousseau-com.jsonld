  {
    "@id": "https://www.sallealbertrousseau.com/temporary/8ab95cf3-9527-47f5-997f-c623589f404c",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/michel-barrette/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.sallealbertrousseau.com/media/4379/michel-barrette-drole-depuis-1957-1200x875.png"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-22T20:00:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g773860"
      }
    ],
    "http://schema.org/subEvent": [
      {
        "@id": "_:g773900"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/michel-barrette/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Drôle depuis 1957"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\r\nDans son tout nouveau spectacle Drôle depuis 1957, Michel Barrette revient en force avec un regard hilarant et tendre sur sa génération. Il y célèbre « la revanche des baby-boomers », ces jeunes d’hier devenus les grands sages d’aujourd’hui… mais toujours aussi irrévérencieux. À travers anecdotes savoureuses, souvenirs touchants et observations mordantes, il nous raconte son époque avec une énergie contagieuse. Entre rires et réflexions, Michel prouve qu’on peut vieillir sans jamais cesser d’être drôle. Ce spectacle est une véritable lettre d’amour au passé… et un clin d’œil bien senti au présent.\r\n\r\n "
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Michel Barrette"
      }
    ]
  },
