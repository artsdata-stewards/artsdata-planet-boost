  {
    "@id": "https://www.sallealbertrousseau.com/temporary/76d3f69e-d73b-48a9-b67d-b55d280d4a3c",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/charles-brunet/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.sallealbertrousseau.com/media/4203/charles-brunet-1920x1080.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-01-21T20:00:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1477600"
      }
    ],
    "http://schema.org/subEvent": [
      {
        "@id": "_:g1477640"
      },
      {
        "@id": "_:g1477800"
      },
      {
        "@id": "_:g1477960"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/charles-brunet/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Très très bon show"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "J’ai 24 ans. J’suis extra vieux. Vraiment full mature pis profond.\nJ’comprends un peu rien à la vie mais j’commence à comprendre mon métier.\nLe nom le dit, c’est un très très bon show. \nÇa parle d’un peu de tout. Ça parle à tout le monde. Vieux, jeune. Tiktok, MSN. Gauche, Droite. Bonjour, hi. C’est surtout fucking drôle. \nC’est l'œuvre dont je suis le plus fier de ma jeune carrière.\nMerci aux gens qui me permettent de continuer à vivre mon rêve de p'tit cul. Je vous le devais et le voici, un très très bon show."
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Charles Brunet"
      }
    ]
  },
  {
    "@id": "https://www.sallealbertrousseau.com/programmation/titanique/",
    "http://ogp.me/ns#site_name": [
      {
