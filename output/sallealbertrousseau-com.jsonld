    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Pour son troisième spectacle présenté à la Salle Albert-Rousseau, Foie Gras, Mariana Mazza décide de s’exprimer avec sa tête et son cœur… pour faire changement."
      }
    ],
