        "@language": "fr",
        "@value": "Gregory Charles - Programmation | Salle Albert-Rousseau"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Voilà que dans son nouveau spectacle, Un soir en Noir & Blanc, Gregory raconte sa propre histoire, choisissant quelques moments tournants de sa vie et déclinant ces instants en surprenantes anecdotes!"
      }
    ],
