  {
    "@id": "https://www.sallealbertrousseau.com/temporary/0943ee8e-f6fd-41ad-be0d-1368bf4815d3",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/richardson-zephir/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.sallealbertrousseau.com/media/3968/richardson-zephir_1920x1400.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-03-03T20:00:00"
      }
    ],
    "http://schema.org/location": [
      {
