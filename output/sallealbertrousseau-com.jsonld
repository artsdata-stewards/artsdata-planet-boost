    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/gala-comedie-star/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le Gala Comédie Star de retour à la Salle Albert-Rousseau!\r\nUn classique, digne des plus prestigieux galas d’humour.\r\nLe seul Gala annuel en programmation régulière qui met en vedette nos grands de l’humour. Gala Comédie Star, c’est 5 humoristes chevronnés qui viennent à tour de rôle présenter un numéro de leur propre chef! Une liberté inégalée qui permet d’assurer surprises et émotions!\r\nPour l’édition 2026, l’animateur STEPHANE FALLU recevra 4 humoristes de renom.\r\nREAL BELAND – OLIVIER MARTINEAU – JF OTIS et RACHELLE ELIE!\r\nFaites vite, c’est un classique, les places pour notre Gala partent rapidement!"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Gala Comédie Star"
      }
    ]
  },
