  {
    "@id": "https://www.sallealbertrousseau.com/temporary/e4e4ab64-cdac-4b8d-8dd7-77d69fe19c00",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/lama-d-aventures-en-aventures/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.sallealbertrousseau.com/media/4424/lama-1200x875.png"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-09-24T20:00:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1655000"
      }
    ],
    "http://schema.org/subEvent": [
      {
        "@id": "_:g1655040"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/lama-d-aventures-en-aventures/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Le spectacle musical biographique"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Vivez ce spectacle musical biographique, ficelé autour de 22 chansons du répertoire de SERGE LAMA, et faites une incursion dans la vie d’un homme tenace qui a toujours su avancer. \r\nVenez partager rires et grandes émotions avec nous. \r\nSur scène, les comédiens incarnent Serge Lama ainsi que les hommes et les femmes ayant façonné sa vie. Le chanteur le dit lui-même, il est la somme de ces rencontres. Avec eux, il a contourné les pièges que lui tendait le destin. Grâce à eux, il a pu aimer, rire, chanter, composer, parler, comprendre, échanger et finalement proclamer : « Je t’aime à la folie, la vie ». \r\nCette icône française de la chanson devait faire une dernière tournée. Il n’a pas pu. Pourtant, il a promis qu’il n’avait pas dit son dernier mot.\r\nDistribution : Éric Paulhus, Stéphan Côté, Gaële, Élizabeth Duperré et Mélissa Cardona\r\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Lama, d'aventures en aventures"
      }
    ]
  },
