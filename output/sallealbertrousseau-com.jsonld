        "@value": "Mon jour de chance - Programmation | Salle Albert-Rousseau"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "La pièce Mon jour de chance, présentée à la Salle Albert-Rousseau, propose, avec humour et intelligence, une réflexion sur le destin, les hasards de la vie et la possibilité de tout recommencer."
      }
    ],
