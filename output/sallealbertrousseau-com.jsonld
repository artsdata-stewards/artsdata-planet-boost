    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Pascal Cameron présente son premier one-man-show un spectacle. à la Salle Albert-Rousseau, une représentation humoristique qui veut parler à tout le monde et de tout le monde."
      }
    ],
