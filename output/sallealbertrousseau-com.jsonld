  {
    "@id": "https://www.sallealbertrousseau.com/temporary/157ed57d-6f11-45a3-a65e-11ebe72e1c32",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/jean-francois-mercier/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.sallealbertrousseau.com/media/4137/jf-mercier-1920x1080.png"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-04-11T20:00:00"
      }
