        "@language": "fr",
        "@value": "Ménopause - Programmation | Salle Albert-Rousseau"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "La célèbre parodie musicale Ménopause arrive pour la toute première fois au Québec et sera présentée à la Salle Albert-Rousseau!"
      }
    ],
