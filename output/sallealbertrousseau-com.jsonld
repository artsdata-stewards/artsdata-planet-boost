  {
    "@id": "https://www.sallealbertrousseau.com/temporary/7c8b41c0-a23f-4cc0-b738-5e08dd9928f9",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/olivier-martineau/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.sallealbertrousseau.com/media/4305/olivier-martineau_cest-pas-moi1200x875.png"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-04-20T20:00:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g763020"
      }
    ],
    "http://schema.org/subEvent": [
      {
        "@id": "_:g763060"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/olivier-martineau/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "C'est pas moi, c'est toi"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "C’EST PAS MOI, C’EST TOI \r\nSociété, c’est fini. \r\nOui, on a eu de beaux moments, mais là, c’est trop. T’as changé. Moi, je m’en vais. Je te laisse tes règles farfelues et tes promesses en plastique. J’en ai assez de cette mascarade. \r\nC’EST PAS MOI, C’EST TOI, c’est du stand-up pur et dur, un véritable feu roulant de gags où chaque punch frappe en plein cœur. Un regard sans filtre, mordant, mais surtout hilarant, sur une société où la rupture était inévitable. \r\nAprès trois spectacles, celui-ci est le plus audacieux, le plus osé, le plus authentique. \r\nBref, c’est la fin d’une histoire… et le début d’un show qui décoiffe. Mais moi, je m’en fous, j’ai pas de cheveux."
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Olivier Martineau"
      }
    ]
  },
