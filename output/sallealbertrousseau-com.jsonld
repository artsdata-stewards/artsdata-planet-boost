    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/mario-jean/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Les imparfaits bonheurs... et autres tutti quanti de la vie"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Avec plus de 6 spectacles à son actif, 1 600 représentations livrées devant au-delà d’un million de spectateurs, des rôles importants à la télévision comme au théâtre (Je vous écoute, Le Grand Virage, Léo, Les Pays d’en haut, District 31, 30 vies) ...Mario Jean ne chôme jamais.\r\nIl reviendra plus en forme que jamais charmer son vaste public dès l’automne 2023 avec son 7e spectacle, toujours avec le style unique et rassembleur qu’on lui connaît !"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Mario Jean"
      }
    ]
  },
