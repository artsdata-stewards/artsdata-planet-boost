    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Zénith - Le spectacle - Programmation | Salle Albert-Rousseau"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Après avoir conquis le public à l’été 2025, Zénith revient en force pour enflammer le mois de décembre 2026 à la Salle Albert-Rousseau."
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "/media/4436/zénith-2-1200x675.png"
      }
    ]
