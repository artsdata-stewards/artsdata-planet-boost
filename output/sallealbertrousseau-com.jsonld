    "@id": "https://www.sallealbertrousseau.com/temporary/a6613de8-910e-475f-b9d5-04008a122d1f",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/menopause/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.sallealbertrousseau.com/media/4136/meno_commandite_sar_1920x1400.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-02-21T20:00:00"
      }
    ],
    "http://schema.org/location": [
      {
