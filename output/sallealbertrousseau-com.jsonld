        "@id": "https://www.sallealbertrousseau.com/programmation/alex-roy/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.sallealbertrousseau.com/media/3817/debout-alex-roy-sanstexte-1200x875.png"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
