  {
    "@id": "https://www.sallealbertrousseau.com/temporary/dd710b8a-1337-4811-a497-db06a0cd2898",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/pierre-hebert/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.sallealbertrousseau.com/media/3897/pierre-hebert-grandiose-ar-1920x1400.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
