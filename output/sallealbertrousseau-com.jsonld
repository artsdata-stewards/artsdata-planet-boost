      {
        "@language": "fr",
        "@value": "Slava's Snowshow - Programmation | Salle Albert-Rousseau"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "L'incroyable oeuvre d'art interactive Slava's Snowshow s'arrêtera à la Salle Albert-Rousseau pour remplir le cœur des petits et des grands. Un spectacle qui crée l'émerveillement à tous coups!"
      }
    ],
