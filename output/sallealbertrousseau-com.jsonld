  {
    "@id": "https://www.sallealbertrousseau.com/temporary/6eec044c-5bb6-455b-afce-b5e3c92c81d6",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/billy-tellier/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.sallealbertrousseau.com/media/4298/billy-tellier_kicker1200x875.png"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-01-07T20:00:00"
      }
    ],
