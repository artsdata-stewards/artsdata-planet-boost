  {
    "@id": "https://www.sallealbertrousseau.com/temporary/6460bd7a-94f8-4faa-9283-575483ef2a27",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/pierre-hebert/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.sallealbertrousseau.com/media/3897/pierre-hebert-grandiose-ar-1920x1400.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
