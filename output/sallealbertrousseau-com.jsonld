  {
    "@id": "https://www.sallealbertrousseau.com/temporary/0c27a78b-604d-437d-8b5f-09be3d42942a",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/mike-beaudoin/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.sallealbertrousseau.com/media/3742/mike-beaudoin-1200x.png"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-05-25T20:00:00"
      }
    ],
