        "@id": "_:g1264780"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/zenith/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Animé par Véronique Cloutier"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Après avoir conquis le public à l’été 2025, Zénith revient en force pour enflammer le mois de décembre 2026 ! Sous la direction de Véronique Cloutier, des artistes des générations Z, Y, X et boomers se réunissent pour une véritable explosion musicale intergénérationnelle. \r\nAu programme : performances électrisantes, medleys revisités, musiciens live et une mise en scène à couper le souffle. Entre nostalgie, émotions et plaisir, Zénith vous fera chanter et danser à plein poumons sur les grands succès que vous aimez, de Queen à Céline Dion en passant par Les BB. \r\nVivez la magie de la musique qui unit toutes les générations ! "
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Zénith - Le spectacle"
      }
    ]
  },
