  {
    "@id": "https://www.sallealbertrousseau.com/temporary/5d130e75-04ea-4a47-bf04-8e3522805f49",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/dominic-paquet/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.sallealbertrousseau.com/media/4132/dominic-paquet_jclg_sar_1920x1400.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
