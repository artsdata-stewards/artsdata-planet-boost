  {
    "@id": "https://www.sallealbertrousseau.com/temporary/d7fddd2f-3da6-4ebb-9c76-fea6ef9f1f3c",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/jo-cormier/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.sallealbertrousseau.com/media/4296/jo-cormier_machine1200x875.png"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
