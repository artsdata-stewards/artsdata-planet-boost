  {
    "@id": "https://www.sallealbertrousseau.com/temporary/f7f9f0f4-8daa-4d19-95cf-5e531deb8adb",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.sallealbertrousseau.com/programmation/chris-klafford/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.sallealbertrousseau.com/media/4330/chris-klafford-1200x875.png"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-04-10T20:00:00"
      }
    ],
