    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Un trio d’enfer    Jacques Saint-Cyr, flûte, Julien LeBlanc, piano, Dominic Painchaud, violoncelle, vous convient à un voyage entre Vienne, Rio de Janeiro et Buenos Aires. Vous pourrez y entendre un amalgame de musiques  classiques et populaires écrites pour trio&nbsp;: du classicisme enjoué de"
      }
