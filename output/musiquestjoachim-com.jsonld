  {
    "@id": "https://www.musiquestjoachim.com/events-one-2/147ptnixj8f8e6uoqghimmbia0jn2g",
    "http://ogp.me/ns#site_name": [
      {
        "@language": "fr-ca",
        "@value": "Musique Saint-Joachim"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Un après-midi avec Mozart!  — Musique Saint-Joachim"
      }
    ],
    "http://ogp.me/ns#latitude": [
      {
        "@language": "fr-ca",
        "@value": "40.7207559"
      }
    ],
    "http://ogp.me/ns#longitude": [
      {
        "@language": "fr-ca",
