    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Un retour attendu!  Son passage en 2017 nous avait étonnés et  séduits.   Après un long séjour en Chine avec le Cirque du Soleil  et visité plusieurs pays d’Asie, pas étonnant qu’elle veuille nous présenter des œuvres autour du thème «&nbsp;Carnets de voyage&nbsp;»."
      }
