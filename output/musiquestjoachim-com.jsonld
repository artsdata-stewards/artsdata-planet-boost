    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Salué pour « l’émotion de son jeu et son contrôle impeccable » (Audiophilia), le pianiste et écrivain Pierre-André Doucet a été nommé par CBC Radio 2 comme étant l’un des meilleurs musiciens canadiens sous l’âge de 30 ans. Il interprétera, entre autres, des œuvres de Haydn, Liszt et Schubert"
      }
    ],
