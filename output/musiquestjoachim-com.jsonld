    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le Chœur Louisbourg sous la direction de Monique Richard nous présente un concert de musique baroque.   Le chœur et l’orchestre interpréteront des œuvres de Zelenka (1679-1745), Telemann (1681-1767) et Hasse (1699-1783)"
      }
    ],
