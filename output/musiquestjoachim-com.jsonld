    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 26 septembre, joignez-vous à la hautboïste Christie Goodwin, au bassoniste Patrick Bolduc, au corniste Jon Fisher et au pianiste Pierre-André Doucet pour le premier concert de notre programmation d’automne 2021.    Ces musiciens unissent leur talent pour vous offrir des œuvres de Paganini, Poulen"
      }
