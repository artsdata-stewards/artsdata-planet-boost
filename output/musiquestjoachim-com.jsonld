      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://www.musiquestjoachim.com/events-one-2/147ptnixj8f8e6uoqghimmbia0jn2g"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Cet ensemble de cinq musiciens très talentueux, vous présente à passer un après-midi avec Mozart!  Sarah Harrigan et Sean Paul O’Brien, violons, Natalia Lubimova, violon alto, Jaeyoung Chong, violoncelle, et David Scott, clarinette interpréteront le  Quatuor en fa majeur, K. 370/368b  et les  Prélud"
      }
    ],
    "http://ogp.me/ns#image": [
