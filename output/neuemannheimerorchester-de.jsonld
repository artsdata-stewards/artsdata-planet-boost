    "http://ogp.me/ns#description": [
      {
        "@language": "en-gb",
        "@value": "This chamber concert explores musical connections between Offenbach, Schwetzingen, and the world of the Electoral court through the remarkable legacy of the Johann André Archive. The program celebrates Franz Danzi, born in Schwetzingen and published in Offenbach, alongside Mozart.  Performed by the"
      }
    ],
