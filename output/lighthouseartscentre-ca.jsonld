    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "How did Old Man Luedecke go from touring the world with his banjo to suddenly giving it all up to work as a deckhand on a scallop boat, and abandoning his signature instrument?  “I was just going over to my scallop farming neighbour’s house to get some scallops to have for dinner”, says Chris Luedec"
      }
    ],
