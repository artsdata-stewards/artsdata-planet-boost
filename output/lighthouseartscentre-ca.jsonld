    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Whitehorse is the prolific partnership of Melissa McClelland and Luke Doucet. Uninhibited by expectation, boldly adventurous and categorically talented, Whitehorse’s signature sound is always guitar-heavy, harmony-plentiful and lyrically deft.With an expansive run of records that freely and thrillin"
      }
