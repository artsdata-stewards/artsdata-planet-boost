    "http://schema.org/name": [
      {
        "@value": "A second date, February 20th, an opportunity for SOLO&#8217;s Artistic Director Sabatino Vacca to examine an opera classic"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Sabatino Vacca, Artistic Director of Southern Ontario Lyric Opera (SOLO), examines the themes and music of Gaetano Donizetti’s opera Lucia di Lammermoor. Based on Sir Walter Scott’s novel, The Bride of Lammermoor, &hellip; &lt;a href=&quot;https://southernontariolyricopera.com/event/an/&quot; class=&quot;more-link&quot;&gt;Continue reading&lt;span class=&quot;screen-reader-text&quot;&gt; &quot;A second date, February 20th, an opportunity for SOLO&#8217;s Artistic Director Sabatino Vacca to examine an opera classic&quot;&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;\\n"
      }
