    "http://schema.org/name": [
      {
        "@value": "SOUTHERN ONTARIO LYRIC OPERA PRESENTS: ENCORE, AN EVENING WITH GINO QUILICO"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;We are pleased to welcome world-renowned Grammy Award Winner Canadian baritone Gino Quilico O.C. C.Q. He has sung in all major opera houses including  La Scala, Paris Opera, Vienna State Opera and The Met in New York. He will, along with our Youth &amp; adult chorus and Orchestra, per-form a mixed programme of favourites. The &hellip; &lt;a href=&quot;https://southernontariolyricopera.com/event/southern-ontario-lyric-opera-presents-encore-an-evening-with-gino-quilico/&quot; class=&quot;more-link&quot;&gt;Continue reading&lt;span class=&quot;screen-reader-text&quot;&gt; &quot;SOUTHERN ONTARIO LYRIC OPERA PRESENTS: ENCORE, AN EVENING WITH GINO QUILICO&quot;&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;\\n"
      }
    ],
