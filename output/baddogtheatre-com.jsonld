    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Coming of Age-sian weaves together the struggles of growing up and finding a sense of belonging into an improvised show that will make you tear up from laughter and heartfelt moments! This show is a relatable take on coming-of-age stories, told from an Asian perspective."
      }
    ],
