    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Looking to elevate your improv?  M﻿aestro Impro™ is often described as a 'crash-and-burn-elimination-style' improv show. Maestro brings in two of Bad Dog Theatre’s top tier improvisers as two directors. Throughout the evening they will be akin to two conductors guiding an improv symphony.  The night"
      }
    ],
