    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Bad Dog Academy Presents    IMPROV FOUNDATIONS 4 GRAD SHOWCASE     Watch our talented Bad Dog Academy Graduates do Their Thing!  This brilliant showcase features performances by John Portero's Foundations 4 and Alex Kolanko's Foundations 4 Graduating Classes!  ~  Tickets: $10 | PWYC at the door"
      }
    ],
