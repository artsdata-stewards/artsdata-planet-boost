    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Get ready to laugh and be amazed as talented improvisers bring the works of Shakespeare to life in a whole new way! No scripts, just pure creativity and wit as they create worlds on the spot inspired by the Bard's famous plays. Whether you're a Shakespeare aficionado or just looking for a fun night"
      }
