    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Come watch Toronto’s Best Improv with Bad Dog Theatre’s new all-star show “Harry”. Award-winning comedians perform the iconic improv format “the Harold” starting with a suggestion from you.   HARRY Date: Every Sunday Time: 7:30pm Location: Burdock Brewery (1184 Bloor St. West) Admission: $15"
      }
    ],
