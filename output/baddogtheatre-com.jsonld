    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Hookup takes the lives, likes and dislikes, turn-ons and turn-offs of two random audience members and turns them into a fully unscripted romantic comedy. You’ll hook up, break up, live the single life, and fall in love all over again without ever leaving your seat. Hookup features an all-star cast o"
      }
    ],
