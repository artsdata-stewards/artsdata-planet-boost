    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Are you ready to treat yourself to Toronto’s newest hottest  GAYest  improv show?  That’s gonna be a —  Hard YAS !  Featuring a cast full of Toronto’s fave queer comedians, this show is for all the gays, theys, and the token straights in your life.  Including: Tyra Banda, Elanja Corosky, Stevey Hunt"
      }
