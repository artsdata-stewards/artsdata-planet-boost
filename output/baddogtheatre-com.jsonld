    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Watch our talented Bad Dog Academy Graduates do Their Thing!  This brilliant showcase features performances by John Portero's Improv Foundations 4 + Ken Hall's Clownprov Graduating Class!  PLUS  An extra special Sweet Sweet Friends - HOLIDARMANDO! Improv inspired by holiday stories.  Come check it o"
      }
