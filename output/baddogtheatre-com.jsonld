    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Get ready for this week's Sweet Sweet Wednesday! Join us Sweet Action Theatre for Big Friendly Scene! Hosted by Tim Mikula  Be the builder of worlds, the Alpha and Omega  Put your name in the bucket and build an entire universe in one show! Anyone who shows up gets to play a part (if they so choose)"
      }
    ],
