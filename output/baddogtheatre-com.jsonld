    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Get ready for a night of laughter and wild confessions in 'All of Us Are Naughty,' an improvisational comedy show that delves into the hilarious misadventures and secrets we've all hidden away. This is a great show for a night out with friends or a fun date night, where we'll be fueling the comedy w"
      }
