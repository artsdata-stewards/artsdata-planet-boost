    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Watch Bad Dog’s performance-level students strut their stuff on stage!  Our Studio Series classes work together for 6 months to generate original improvised formats while working on specific approaches to improv.  Today’s showcase features:    Harold Studio - Instructor: Alex Tindal     Shortform St"
      }
