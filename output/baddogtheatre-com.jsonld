    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Bad Dog's  Kids &amp; Guardian Drop-In  is a chance for you and loved ones to let loose, have some fun and do improv together.  This drop-in explores some of the fundamentals of improv in a low-stake environment where kids and their guardian get to experience the joys of improv together.  No pri"
      }
    ],
