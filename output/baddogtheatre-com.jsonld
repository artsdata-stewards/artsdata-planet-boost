    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Bad Dog Theatre and Mahjong Mafia are bringing the award-winning all-Filipina group, the Tita Collective, who recently won the Just For Laughs Award and runaway comedy hit show “All Of Our Parents Are Asian”, which had multiple sold out shows at the 2023 Toronto Fringe Festival, featuring Affirmativ"
      }
