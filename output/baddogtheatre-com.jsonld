    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "ATTN: Singles. It's time to FALL in love at the Bad Dog Theatre Company AGAIN! After multiple SOLD OUT runs,      @hookupimrov      is back monthly!  Want to know what it would be like to date that charming stranger sitting next to you? Hookup takes the lives, likes and dislikes, turn-ons and turn-o"
      }
    ],
