    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "\"Inspired, imaginative and first-rate coemdic theatrical magic.\" - My Entertainment World  A swashbuckling adventure comedy where no plot is untwisted, no bad guy unstabbed, and no chandelier unswung!  Starring Conor Bradbury, Julian Frid, Lowen Morrow, Seann Murray and Sharjil Rasool  Tor"
      }
    ],
