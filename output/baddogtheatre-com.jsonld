    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Come join Elanja Corosky as she leads Hard Yas's first workshop pre-show on May 3rd! We are welcoming all skills levels, even if you're never tried out improv! Have fun, play some games, and enjoy the show after with our workshop ticket, or just come for the show!! 🎉"
      }
