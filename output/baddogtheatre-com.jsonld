    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "LETTERBOXD LIVE!   Saturday, March 23, 2024 at 11pm The Assembly Theatre (1479 Queen St. West)  We take the audience's favourite movies (3-4, ideally a single member's LetterBoxd top 4) and get one specific trait from each movie. We then combine these traits to create a new, even better movie.  —"
      }
    ],
