    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "NO MORE SUNDAY SCARIES! Toronto’s best comedians are back at the Burdock Brewery to help you forget that the weekend is over!  Featuring comedy shows like our new all-star show “Harry” - award-winning comedians perform the iconic improv format “the Harold” starting with a suggestion from you. Featur"
      }
    ],
