    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Every week some of Toronto's best comedians perform different hilarious stories and sketches around a different holiday theme.  Toronto's best comedians share stories about religion, fist fights between uncles, and all the other parts of Christmas they don't include in the hallmark movies.   I HATE"
      }
