    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "They Go Low, We Go Laugh is a variety show where folx of colour and marginalized identities will do stand-up, storytelling, sketch comedy, music &amp; more! - all in the name of shining more light in this world. We invite all to celebrate our voices with us.  This month, cozy up with a drink of"
      }
    ],
