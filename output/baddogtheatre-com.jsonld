    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Christmas is a time for joy and yuletide cheer. It is unfortunately also a time to get families together. That doesn’t always lead to “good vibes.” Come share YOUR stories of the WORST CHRISTMAS EVER and we will spin it into hilarious improv scenes that will make you excited to see your weird uncles"
      }
    ],
