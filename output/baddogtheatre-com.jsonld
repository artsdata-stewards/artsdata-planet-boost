    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Bad Dog's flagship show, THEATRESPORTS mixes the thrill of improv with the energy of a sporting event, putting you in the middle of the side-splitting scenes!  One of the most popular unscripted comedy formats in the world - where sports meets comedy and the winner is always the audience! Two teams,"
      }
    ],
