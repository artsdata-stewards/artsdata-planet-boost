    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Swordplay a play of swords, a comedic love letter to classics, swashbucklers and retro fantasy video games  A swashbuckling adventure comedy where no plot is untwisted, no bad guy unstabbed, and no chandelier unswung!  Starring Conor Bradbury, Julian Frid, Lowen Morrow, Seann Murray and Sharjil Raso"
      }
    ],
