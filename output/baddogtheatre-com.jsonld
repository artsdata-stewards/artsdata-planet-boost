    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Your juiciest, wildest, sloppiest (and anonymous) breakup stories, improvised.  Ever curse an ex? Ever take a bat to their Toyota Corollas? Do you have those juicy, sloppy, \"am i the a**hole\" break-up type stories? We ALL DO. Now let Toronto's best comedians bring all the drama to life in"
      }
