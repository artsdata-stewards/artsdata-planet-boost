    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "SAD FEMME CLUB is a monthly comedy showcase featuring hilarious women and queer folx of colour who are killing it in the Toronto improv, sketch or stand up scene. Sad Femme Club is inspired by the runaway hit song 'Sad Femme Club' by the incomparable artist, Kimmortal.    SAD FEMME CLUB: WOMEN OF CO"
      }
    ],
