    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Improv Church is a celebration of improv in all of its facets; laughter, learning, community, and the transcendent power of yes and!  Improv can change your life for the better if you open your heart and let it.Improv Church is the funniest mass you'll ever attend!At an Improv Church show you can ex"
      }
    ],
