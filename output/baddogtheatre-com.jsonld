    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Buckle up for a rollercoaster ride of laughter and emotion as a previously nonexistent play is brought to life before your very eyes! Experience the magic of theatre like never before as SODA Impro's Oliver Georgiou joins forces with local celebrities of stage and screen for an unforgettable journey"
      }
    ],
