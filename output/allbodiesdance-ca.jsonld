  {
    "@id": "https://www.allbodiesdance.ca/events-1/community-dance-party-1",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Community Dance Party | All Bodies Dance"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "<p>Thursday September 21</p>\n<p>6:30 to 8:30 pm</p>\n<p>The Roundhouse Performance Centre</p>\n<p>181 Roundhouse Mews (Pacific &amp; Davie St)</p>\n<p><strong>FREE</strong></p>\n<p><strong>ALL AGES</strong></p>\n<p>DJ - bring requests</p>\n<p>Light refreshments provided</p>\n<p></p>\n<p><strong>Accessibility:</strong></p>\n<p>-Sound reducing headphones, ear plugs, masks, and hand sanitizer available</p>\n<p>-Masks strongly recommended</p>\n<p>-Seating options:</p>\n<p>-Wheelchair accessible</p>\n<p>-Single stall, gender diverse inclusive washroom</p>\n<p>-Underground paid parking</p>\n<p>-Scent reduction: please come to ABDP classes and events scent-free. Scents include but are not limited to things like: cologne, perfume, hair spray, deodorant, dryer sheets, scented laundry detergent, fabric softener, cigarette smoke, freshly painted nails (please do them at least 24 hours before the show), essential oils, things marked with &#34;fragrance&#34; and &#34;natural fragrance,&#34; and so on.</p>\n<p><strong>ID:</strong> A graphic advertising our Community Dance Party. On a black background are three signposts. One large and two small. The All Bodies Dance Logo is on the top. Text: Community Dance Party. Thurs. Sept 21, 2023. 6:30 to 8:30 pm. Free. All Ages. DJ- Bring requests!</p>"
      }
    ],
