  {
    "@id": "https://www.allbodiesdance.ca/events-1/vines-art-festival",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Vines Art Festival  | All Bodies Dance"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "<p>Join us at the <strong>Vines Art Festival</strong></p>\n<p>Wednesday, August 16, 2023</p>\n<p>6:00 pm</p>\n<p><a rel=\"noopener noreferrer noopener noreferrer\" target=\"_blank\" href=\"https://www.vinesartsociety.com/locations/oppenheimer-park\"><strong>Oppenheimer Park</strong></a></p>\n<p><a rel=\"noopener noreferrer noopener noreferrer\" target=\"_blank\" href=\"https://goo.gl/maps/4mF3FADHpejXeNkG9\">400 Powell St, Vancouver, BC V6A 1G6</a></p>\n<p>ASL Interpretation</p>\n<p></p>\n<p><strong>7:15 PM – All Bodies Dance - Carnegie Project </strong><em>(Other Animal)</em></p>\n<p><em>Other Animal</em> is a culmination of the creative work with All Bodies Carnegie participants over the last 2 years, and especially over the recent summer session.  Our practices have included presencing with, responding to and witnessing one another as acts of care.  We celebrate our interconnected imaginations, our agency in self-expression, and dancing as a way of being together in community.</p>\n<p></p>\n<p>Learn more about the event <a rel=\"noopener noreferrer noopener noreferrer\" target=\"_blank\" href=\"https://www.vinesartsociety.com/events/our-shared-feast\">here</a></p>"
      }
    ],
