      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Community Dance Party"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Come celebrate the start of our 9th season with a good old dance party!"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventCancelled"
      }
    ],
