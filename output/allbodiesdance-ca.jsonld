[
  {
    "@id": "https://www.allbodiesdance.ca/events-1/community-performance-opportunity",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Community Performance Opportunity | All Bodies Dance"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "<p>Participants in All Bodies Dance Project are invited to take part in an outdoor improvised performance/jam to celebrate <a rel=\"noopener noreferrer noopener noreferrer noopener noreferrer noopener noreferrer\" target=\"_blank\" href=\"https://www.collingwooddays.com/\">Collingwood Days Festiva</a>l</p>\n<p></p>\n<p>Live music by Ben Brown. Come wearing red and black.</p>\n<p></p>\n<p>Friday July 21, 2023</p>\n<p>4-5pm</p>\n<p>outside the plaza at Italian Cultural Centre</p>\n<p>3075 Slocan St.</p>\n<p>To confirm your participation email info&#64;allbodiesdance.ca</p>"
      }
    ],
