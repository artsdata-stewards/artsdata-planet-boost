  {
    "@id": "https://www.allbodiesdance.ca/events-1/dwell-chutzpah-2023",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "DWELL - Chutzpah 2023 | All Bodies Dance"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "This new work by Vancouver’s All Bodies Dance Project was created in a collaborative process to explore the theme of “home” through movement, text, narrative, and imagery."
      }
    ],
