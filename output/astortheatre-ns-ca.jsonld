    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Catherine MacLellan has been captivating audiences around the world with her music for over two decades. Born and raised in the idyllic province of Prince Edward Island, Catherine\\'s songs reflect her deep connection to the land and the people that call it home.&lt;/p&gt;\\n"
      }
