    "http://schema.org/name": [
      {
        "@value": "Chris DeWolf Earring Making Workshop"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Participants will be able to create two pairs of earrings using silver, copper and/or brass. They will use circle, oval or rectangular disc cutters to form shapes, learn to hammer texture into the metal and make their own ear wires from sterling silver.&lt;/p&gt;\\n"
      }
    ],
