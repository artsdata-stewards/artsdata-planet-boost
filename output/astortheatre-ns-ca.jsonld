      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Campbell &amp; Johnston: A Modern guitar-driven blues steeped in Classic Rock &amp; Roots&lt;br /&gt;\\nWhether performing as an acoustic duo or fronting a full electric band, they deliver a seamless interplay of blistering guitar solos, soulful vocals, and rich harmonies. Their live shows pulse with raw energy and emotional intimacy, leaving audiences both exhilarated and deeply moved.&lt;/p&gt;\\n"
      }
