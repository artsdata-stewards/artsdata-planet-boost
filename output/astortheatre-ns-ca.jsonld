    "http://schema.org/name": [
      {
        "@value": "Hoppers"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;What if you could talk to animals and understand what they\\'re saying? In Disney and Pixar\\'s all-new feature film &quot;Hoppers,&quot; scientists have discovered how to &quot;hop&quot; human consciousness into lifelike robotic animals, allowing people to communicate with animals as animals!&lt;/p&gt;\\n"
      }
    ],
