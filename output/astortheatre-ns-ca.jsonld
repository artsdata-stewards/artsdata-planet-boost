    "http://schema.org/name": [
      {
        "@value": "The Choral"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;1916. As war rages on the Western Front, the Choral Society in Ramsden, Yorkshire has lost most of its men to the army. The Choral\\'s ambitious committee, determined to press ahead, decides to recruit local young males to swell their ranks.&lt;/p&gt;\\n"
      }
    ],
