    "http://schema.org/name": [
      {
        "@value": "Steph Peaks  &#038; Friends"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;It’s time to put on those sequins and raise your fives! Steph Peaks is back! June 20th at The Astor!&lt;br /&gt;\\nGet ready for another night of chaos, camp and whole lot of sass!&lt;/p&gt;\\n"
      }
    ],
