    "http://schema.org/name": [
      {
        "@value": "Poet of The Common Man &#8211; The Tribute to Merle Haggard"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Lawrence Maxwell is a PEI born singer-songwriter, who is a multiple PEI Music award-winner, and ECMA nominee with three studio albums under his belt. He has toured internationally in the UK and across Europe. His band of Fugitives consists of the finest musicians. Together they pay tribute to Merle Haggard in a must-see compelling and memorable performance, of some of his greatest songs.&lt;/p&gt;\\n"
      }
    ],
