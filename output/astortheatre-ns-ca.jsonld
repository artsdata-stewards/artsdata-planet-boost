    "http://schema.org/name": [
      {
        "@value": "Symply Skynyrd"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Symply Skynyrd Canada’s authentic Lynyrd Skynyrd delivering the sound and energy of Lynyrd Skynyrd since 2017, while earning a world-class reputation across the nation. A powerful performance that hits the bullseye!&lt;/p&gt;\\n"
      }
    ],
