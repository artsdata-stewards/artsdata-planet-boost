    "http://schema.org/name": [
      {
        "@value": "Tracy&#8217;s Crafty Treasures Art Show"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Tracy Newell, is the owner and creator behind Tracy’s Crafty Treasures, based in Brooklyn, Queens County, Nova Scotia. Crafting has always been a meaningful creative outlet for her, with a focus on jewelry, wooden signs, buoys, and hand-painted pieces on surfaces like rocks and shells.&lt;/p&gt;\\n"
      }
    ],
