    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Thirty Two Short Films About Glenn Gould is a 1993 Canadian biographical anthology film about the pianist Glenn Gould, played by Colm Feore. It was directed by François Girard, with a screenplay by Girard and Don McKellar.&lt;/p&gt;\\n"
      }
