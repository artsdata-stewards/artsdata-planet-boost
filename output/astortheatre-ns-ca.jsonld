    "http://schema.org/name": [
      {
        "@value": "Nirvanna the Band the Show the Movie"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Nirvanna the Band the Show the Movie (2025) is a comedy film directed by Matt Johnson, continuing his mockumentary series about two best friends (Matt and Jay) trying to book a gig at Toronto\\'s Rivoli club. The movie follows them using a &quot;time machine&quot; to 2008 to finally achieve their goal, featuring high-concept stunts. &lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@value": "Organization"
      }
    ],
