        "@id": "https://astortheatre.ca/wp-content/uploads/2026/04/The-Men-of-the-Deeps-60.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://astortheatre.ca/event/men-of-the-deeps-60-diamond-sunset-tour/"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-13T19:30:00-04:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
