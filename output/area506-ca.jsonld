    "http://ogp.me/ns#image:alt": [
      {
        "@language": "en-ca",
        "@value": "\"In country music, truth is everything — and Robyn Ottolini has made a name for herself by telling it exactly like it is. Robyn’s music is modern country with grit, humour, and heart—and fans across North America can’t get enough."
      }
    ],
