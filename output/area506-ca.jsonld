    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "SUNDAY, AUGUST 2   JUNO Award-winning, Hamilton, Ontario–based The Dirty Nil play a staggeringly loud, blown-out mélange of hard rock and punk with hoarse, raw vocals. Self-described as a \"rock & roll band\" and not a punk outfit, they toured for years before releasing an album, winning themselves a spot on the Warped Tour without ever compromising their ideals. MORE"
      }
    ],
