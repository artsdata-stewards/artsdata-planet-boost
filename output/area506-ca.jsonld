        "@language": "en-ca",
        "@value": "Tim Hicks"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "\"Tim Hicks has been blazing his own trail in country music since 2013, mixing gritty vocals, rock ‘n’ roll energy, and honest storytelling into a…"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://area506.imgix.net/performerPhotos/Boxcar-Wanted_Poster-1080x1080-Tim_Hicks.jpg?auto=format&crop=focalpoint&domain=area506.imgix.net&fit=crop&fp-x=0.5&fp-y=0.5&h=630&ixlib=php-3.3.1&q=82&usm=20&w=1200"
      }
    ],
    "http://ogp.me/ns#image:width": [
      {
        "@language": "en-ca",
        "@value": "1200"
      }
    ],
    "http://ogp.me/ns#image:height": [
