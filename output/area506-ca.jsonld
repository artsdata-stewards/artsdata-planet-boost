    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Tenille Townes"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Tenille Townes is a singer-songwriter from Grande Prairie, Alberta who turned teenage journal entries into award-winning songs and a full-blown music…"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://area506.imgix.net/performerPhotos/Boxcar-Wanted_Poster-1080x1080-Tenille_Townes.jpg?auto=format&crop=focalpoint&domain=area506.imgix.net&fit=crop&fp-x=0.5&fp-y=0.5&h=630&ixlib=php-3.3.1&q=82&usm=20&w=1200"
      }
    ],
    "http://ogp.me/ns#image:width": [
      {
        "@language": "en-ca",
        "@value": "1200"
      }
    ],
    "http://ogp.me/ns#image:height": [
      {
        "@language": "en-ca",
        "@value": "630"
      }
    ],
    "http://ogp.me/ns#image:alt": [
      {
        "@language": "en-ca",
        "@value": "Tenille Townes is a singer-songwriter from Grande Prairie, Alberta who turned teenage journal entries into award-winning songs and a full-blown music career. Now based in Nashville, she’s toured with legends like Shania Twain and Miranda Lambert, won a pile of JUNOs, CCMAs, and ACMs, and still somehow finds time to write songs that’ll wreck your heart (in the best way).  If you like your music honest, a little gritty, and full of soul, Tenille’s your girl. MORE"
      }
    ],
