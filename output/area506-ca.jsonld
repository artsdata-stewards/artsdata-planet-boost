    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Robyn Ottolini"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "\"In country music, truth is everything — and Robyn Ottolini has made a name for herself by telling it exactly like it is. Hailing from Uxbridge, Ontario,…"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://www.area506.ca/performerPhotos/_1200x630_crop_center-center_82_none/Boxcar-Wanted_Poster-1080x1080-Robyn_Ottolini.jpg?mtime=1744262040"
