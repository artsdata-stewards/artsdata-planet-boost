    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "\"In country music, truth is everything — and Robyn Ottolini has made a name for herself by telling it exactly like it is. Hailing from Uxbridge, Ontario,…"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://area506.imgix.net/performerPhotos/Boxcar-Wanted_Poster-1080x1080-Robyn_Ottolini.jpg?auto=format&crop=focalpoint&domain=area506.imgix.net&fit=crop&fp-x=0.5&fp-y=0.5&h=630&ixlib=php-3.3.1&q=82&usm=20&w=1200"
