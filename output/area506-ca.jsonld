    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "✨ Time to shine, Swifties \r\nWe’re throwing a launch party for TS12, The Life of a Showgirl! \r\n\r\nWe’ll kick things off by blasting the album front to back, then follow with a dance party featuring Swift Kick playing your faves from ALL the eras 🎶\r\n\r\n📅 Friday, October 3\r\n🕖 Doors @ 7PM | Swift Kick @ 8PM\r\n👗 Dress Code: Fancy / Showgirl\r\n🎟️ Tickets: $25 | All Ages\r\n\r\nPLUS:\r\n🍹 Glittery cocktails & mocktails\r\n🎀 Friendship bracelet-making station\r\n📸 360 photo booth\r\n💍A chance to win a $1000 gift card from our friends at Charm Diamonds!"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "en",
        "@value": "en-ca"
      }
