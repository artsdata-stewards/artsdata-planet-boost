      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Treasurer Talk - October 8, 2025 - ACTRA Toronto"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "ACTRA Toronto’s Treasurer Talk is back on Wednesday, October 8th! Come prepared with your questions as ACTRA Toronto’s Treasurer Paul Constable will have Executive Director Alistair Hepburn speak about finances, […]"
      }
    ],
    "http://ogp.me/ns#url": [
