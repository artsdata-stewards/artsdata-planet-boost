      {
        "@language": "en",
        "@value": "YEAA Shorts: Exhibition Series &#038; Screening Event"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Join the YEAA Committee of ACTRA Toronto for an evening celebrating short films created by ACTRA members. YEAA Shorts: Exhibition Series is a year-long initiative designed to showcase outstanding ACTRA-made [&hellip;]"
      },
      {
        "@language": "en",
        "@value": "Join the YEAA Committee of ACTRA Toronto for an evening celebrating short films created by ACTRA members. YEAA Shorts: Exhibition Series is a year-long initiative designed to showcase outstanding ACTRA-made short films and inspire the next generation of filmmakers within our union. Selected films will screen at Rolling Pictures’ screening room in downtown Toronto, followed [&hellip;]"
      }
    ],
