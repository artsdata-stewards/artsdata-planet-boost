    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Larlee Creek Hullaballoo Boot Camp - Larlee Creek Hullabaloo"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "LCH Music Camp is back!!! Calling all aspiring artists between the ages of 9 and16! 15 applicants will be selected to participate in our interactive camp running daily from August 10–14 at the Perth-Andover Middle School. The week will be capped off with a live performance by all participants on August 14th. For applications and further registration details, email Terry Whalen at terry.whalen@nbed.nb.ca or larleecreek.hullabaloo@gmail.com."
      }
    ],
    "http://ogp.me/ns#url": [
