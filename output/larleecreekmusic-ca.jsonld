    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "His catalogue of recordings and the 150 or so records he’s produced on other artists, resemble the tapestry he weaves in live performance. Where he used to carry 3 and 4 piece bands, he tours alone now.    Just him and the instruments."
      }
    ],
