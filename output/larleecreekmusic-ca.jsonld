    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Great entertainment coming your way. Advance tickets required. Tickets are $20 each. Call 877 778 7271 or email larleecreek.hullabaloo@gmail.com for tickets.    Halifax Blues-Rock power duo Christine Campbell &amp; Blake Johnston has built a name for themselves. Entertaining audiences with their soulful tone, the 60s and 70s rock style guitar riffs and bewitching vocal harmonies.    Hope to see you at the show."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Campbell %26 Johnston (Christine Campbell and Blake Johnston)"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
