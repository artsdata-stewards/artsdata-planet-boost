    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Entangled Others  DE — This Jellyfish Does Not Exist  This Jellyfish Does Not Exist is an interactive meditation on jellyfish. As the user clicks, neurally generated specimens of jelly appear on the screen. An uncanny experience of creatures without faces, these artificial lifeforms mirror their online representation and limits thereof. As mysterious as the deepest parts of the ocean, the fish prove to be intangible beings, constantly morphing their corporeal traits."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Entangled Others"
      }
    ]
  },
