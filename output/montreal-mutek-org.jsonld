      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Maotik & Maarten Vos — Erratic Weather French digital artist, Mathieu Le Sourd ( Maotik ) focuses his work on the creation of immersive multimedia environments , interactive installation and audiovisual performances. He composed music for various art disciplines, collaborated with visual artists Maotik and Nick Verstand, wrote music for contemporary dance companies like Conny Janssen Danst and scored music for film. Starting from Bolzano, the heart of the festival, classical music, electronic music, performances, theatre, exhibitions, movies, and new technologies are presented all over the region from north to south, creating an inter-regional and trans-border contemporary culture platform."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Maotik & Maarten Vos"
      }
    ]
  },
