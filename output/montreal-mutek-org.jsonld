    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The pair delivered one single before Aguayo moved on to an extended collaboration with the producer Dirk Leyers in Closer Musik. These days, Aguayo operates as a solo artist with the production help of Roccness (Marcus Rossknecht of the group Meteorites)."
      }
