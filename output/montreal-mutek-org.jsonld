      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Accomplished graphic and multimedia artist, Richard Chartier has produced multiple pieces for labels like 12k/LINE, Trente Oiseaux, Spekk, MUTEK_REC or Fallt; his sonic installations have been presented at numerous biennales and international exhibitions. Having created the LINE label in 2000, his work explores the interrelations among the natural spatiality of sound, silence, and the art of listening."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Richard Chartier"
      }
    ]
  },
  {
