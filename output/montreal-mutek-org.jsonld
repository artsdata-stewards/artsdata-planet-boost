      }
    ]
  },
  {
    "@id": "https://montreal.mutek.org/en/artists/soulphiction-avec-feat-suzana-rozkosny#creator",
    "@type": [
      "http://schema.org/Organization"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
