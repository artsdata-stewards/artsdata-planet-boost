    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "A violoncellist of profound aptitude, a contemporary of Toshimaru Nakamura among others, Nicholas Bussman (electronics ‚Äì member of Beige Oscillator and Ich Schwitze Nie) together with Martin Brandlmayr (drums and percussions ‚Äì member of Radian and Trapist) have formed a partnership ideal for creating music that begged only to exist before Kapital Band 1."
      }
    ],
