    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "In MUTEK ES+AR 2021, he presented \"Teoría del anhelo\" , together with Javier Bustos, a work that is part of the series \"Formas de interpretar el viento\"  (Ways of interpreting the wind). Magnetic fields, fluid movement, tuning forks, spinners, balloons, hoses, water and air make up a micro-laboratory of translations from technological manipulation."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Federico Kehm"
      }
    ]
