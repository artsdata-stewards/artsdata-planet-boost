        "@id": "https://medias.mutek.org/artists/_1200x630_crop_center-center_82_none/Meitei.png?mtime=1592915682"
      }
    ]
  },
  {
    "@id": "https://montreal.mutek.org/en/artists/meitei#creator",
    "@type": [
      "http://schema.org/Organization"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
