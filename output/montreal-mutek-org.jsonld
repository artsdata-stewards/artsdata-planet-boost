    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Producing artists like Gescom, Bola and Boards of Canada since 1991, the SKAM label has built its reputation on subtle marks of quality, both musical and graphic. Behind this success are Rob Hall and Andy Maddock. SKAM's official DJ, Rob Hall is a member of the Gescom collective, a satellite project of Autechre in which artists collaborate on various projects."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Gescom DJs"
      }
    ]
  },
