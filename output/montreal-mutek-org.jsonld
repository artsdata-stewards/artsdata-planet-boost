        "@language": "en",
        "@value": "Valentina Magaletti  Live  In performance, Valentina Magaletti crafts a sonic space where rhythm becomes narrative. Her sets unfold through tactile…"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://medias.mutek.org/artists/_1200x630_crop_center-center_82_none/kbMzqoSg_1.jpg?mtime=1745950018"
