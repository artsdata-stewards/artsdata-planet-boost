        "@id": "https://montreal.mutek.org/en/artists/tm404"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/tm404"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Stacking analog hardware upon more hardware to compose freeform techno flooded in delay and brimming with life— TM404 explores the intended and unintended scope of Roland drum machines from the 1980s, hardware pivotal to the development of acid house and techno. He coaxes polyrhythmic, hypnotic beats and melodies out of several machines at once, his dub dipping into drum ‘n’ bass and hip hop, his techno well-versed in electronic linguistics."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "TM404"
      }
    ]
  },
