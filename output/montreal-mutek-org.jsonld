    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/monolake"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Composing music and crafting audiovisual art through his own technologies, Robert Henke expands on electronic music's legacy to reveal the soul hiding in the machine. Atmospheric and cinematic one moment, maniacal yet meticulously constructed the next, Monolake 's creations immerse audiences in a complex, expressive, laser-lit world."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Monolake"
      }
    ]
  },
