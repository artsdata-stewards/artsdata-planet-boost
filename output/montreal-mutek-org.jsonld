      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Sabrina Ratté & Guillaume Arseneault  CA/QC/FR + CA/QC — Distributed Memories  Distributed Memories is an installation depicting the interweaving of electronic and human memories, the influence that an external observer has on the way we interpret our recollections and the dialogue between technology and the creative process. Guillaume Arseneault and Sabrina Ratté put forward an interactive installation in which the sequences of images and sounds are influenced by the public’s very presence. Sound design by Roger Tellier Craig ."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Sabrina Ratté & Guillaume Arseneault"
      }
    ]
  },
