    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Claudine Hubert is a writer and independent curator of digital and visual art, with a interest in the artistic potential of AI, performance and institutional structures. She has been active in the Canadian cultural milieu for over fifteen years, most recently as General Codirector and Artistic Director of OBORO (2011-2018), where she instigated programs for artists such as the local artist residency, curatorial research programsand professional development workshops in digital arts."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Claudine Hubert"
      }
