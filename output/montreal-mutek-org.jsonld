      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Benoit Piccolini is a Montréal-based director, motion designer and VJ whose mission is to produce video content for cultural events, musical performances and architectural projections. Passionate about digital arts and music and fascinated by the relationship between image and sound, his ambition is to experiment and develop his own creations in these fields. His desire to amplify the emotions and sensations induced by music or a space, and to transcribe sound into forms, textures and dynamics is at the centre of his artistic approach."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "LLL"
      }
    ]
  },
