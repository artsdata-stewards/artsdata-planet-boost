    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Marc was not only a radiant part of the local music scene, he was also a member of the MUTEK team, working for number of years translating texts and artist biographies so integral to the festivalʼs voice and identity. — dull defies his chosen name in minimalist music that unfolds slowly, an epic adventure between the territories of experimental electronics and acoustic music."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "dull"
      }
    ]
