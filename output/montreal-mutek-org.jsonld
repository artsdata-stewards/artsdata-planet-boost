    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Cellist and vocalist, Lucinda Chua started her musical training at the early age of three, learning to pay the piano and cello under the Suzuki method based on tonalization, the ability to produce or recognize the ringing tone on the given instrument. Her unique musical abilities soon found her performing live with the likes of FKA twigs, GAIKA and collaborating with Ben Vince, Helm, KÁRYYN or Alex Epton."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
