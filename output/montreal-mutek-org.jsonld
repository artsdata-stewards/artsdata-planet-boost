      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Priori & Jason Voltaire  CA/QC World Premiere Armed with a deep respect for ever-shifting permutations of techno and IDM, Priori 's productions morph and shift with every release, channelling murky acid lines, trance-influenced euphoria, and spacey, organic breakbeats. Propulsive, unique dance music that pierces the veil of musical reality to open up new spaces. For this 22nd edition, Priori will be premiering for the first time a unique live ambient set, specially created for the festival and accompanied by visuals from Jason Voltaire ."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Priori & Jason Voltaire"
      }
    ]
  },
