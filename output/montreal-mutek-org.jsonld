    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The Kohlenstoff collective invites you to an audio and visual evening where musicians and visual artists come together to deliver striking, unique, and adventurous performances using digital technologies. This event, through its aesthetic eclecticism, embodies the mission and values driving the efforts of the label and the collective: establishing a dialogue and meeting point between artists from different creative backgrounds in new music."
      }
