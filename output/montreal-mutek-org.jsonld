      {
        "@id": "https://montreal.mutek.org/en/artists/hakan-lidbo"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "In the depths of his Stockholm studio, Håkan Lidbo uses his computer to push the limits of experimental and house composition. Prolific producer and potential record holder for the greatest number of high-quality recordings on a variety of impressive labels (Paper/Repap, Transmat, Superstition, Fiji), Lidbo doggedly explores the limits of computer-assisted sound creation. As a producer and director, he has collaborated with a number of Swedish and international artists. His performance at MUTEK is his Canadian debut, and a unique occasion to penetrate a profound work that will intoxicate your soul."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Håkan Lidbo"
      }
    ]
  },
