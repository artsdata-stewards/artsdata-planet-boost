    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Bionautas is the A/V project of Argentine artists Jonas Kopp and Flor del Valle. It consists of a live performance with a conceptual narrative based on the idea of a universal consciousness with which it’s possible to connect through the decoding of the singular energy that each of its parts possesses."
      }
    ],
    "http://schema.org/name": [
