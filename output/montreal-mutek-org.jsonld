      {
        "@language": "en",
        "@value": "Her audiovisual sets consist of generative visual techniques, data bending, code and video synthesis, exploring connections between desire and reality that interweave the analog, the digital, the abstract, the figurative, the body, materiality, the private, the public, the political and the ethical."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Milena Pafundi"
      }
    ]
  },
