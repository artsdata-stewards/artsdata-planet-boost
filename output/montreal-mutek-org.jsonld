    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Knutsson ’s range as a performer is centred around her ability to deliver emotionally stirring music in multiple contexts. With a catalogue of lush, explorative compositions and multi-genre spanning expertise, Knutsson ’s sets are full of kinetic energy and unexpected detours that create singular, enveloping musical moments."
      }
    ],
