      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Pheek/Iregui  CA/QC+CO/QC — INVERSION World Premiere In the age of Instagram, polished profiles and overly-sanitized cleanliness, INVERSION instead attempts to show the levels of spontaneity, uncertainty and questioning underlying musical creation. Daniel Iregui ’s enormous black mirror, placed behind Pheek and fitted with a device allowing it to vibrate to sound, allows spectators to experience the artists’ various states of mind during an unpredictable yet intuitive journey, where everything will become crystal-clear to those with the patience to wait.  In collaboration with  POP Montréal"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Pheek/Iregui"
      }
    ]
  },
