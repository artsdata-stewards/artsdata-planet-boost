    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "You ponder, but nothing seems to materialize by way of familiarity; your mind is cluttered with names and references...and yet, if you were at all concerned with the electronic scene over the last ten years, his work is surely not as unknown as you may think."
      }
