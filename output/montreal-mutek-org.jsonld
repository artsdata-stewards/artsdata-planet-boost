    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/grand-river-marco-c"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "While mainly connected to the fields of electronic music and sound design, her compositions transcend these genres. Influenced by classical minimal music, Grand River’s work integrates a large variety of sound structures and symphonic calculations, often blurring the lines between traditional composition and research-based modernism. Starting from Bolzano, the heart of the festival, classical music, electronic music, performances, theatre, exhibitions, movies, and new technologies are presented all over the region from north to south, creating an inter-regional and trans-border contemporary culture platform."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Grand River"
      }
    ]
  },
