      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://montreal.mutek.org/en/artists/luomo"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/luomo"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Luomo is none other than Vladislav Delay, a shining star in Scandinavia's electronic music scene. His debut album on Force Tracks was a highly fascinating, welcome surprise on the house music scene, bringing a new virtuosity to the disco-based genre. Whispered gasps and phrases repeat themselves over long stretches of minimal grooves and warm dub effects, building intensity through subtle repetition. But be sure to slip on your boogie boots: Luomo brings the funk, soul and seduction back to minimal house."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Luomo"
      }
    ]
  },
