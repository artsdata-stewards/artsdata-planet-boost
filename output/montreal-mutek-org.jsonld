    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Colleen’s experimental compositions fall into an undefined category between electronic, classical “new music” and folk – she layers and loops acoustic instruments, her voice and samples, through processors and effects, holding her own on drums, music boxes, clarinet, melodica, guitar and her electro-acoustic viola da gamba."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Colleen"
      }
    ]
  },
