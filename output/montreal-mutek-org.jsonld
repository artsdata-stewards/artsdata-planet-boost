    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Shackleton  Live  Shackleton delivers a hypnotic live set where polyrhythms, deep bass, and spectral textures collide. Fusing ritual energy with experimental electronics, he crafts a sonic realm that’s as physical as it is otherworldly—an intense, trance-like experience from a singular voice in electronic music."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Shackleton"
      }
    ]
  },
