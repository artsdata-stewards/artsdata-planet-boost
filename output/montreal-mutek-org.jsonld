      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Tactical Tec h  DE — The Glass Room - Misinformation Edition  The Glass Room is Tactical Tech ’s flagship project and has toured the world over 250 times in 50 different countries. The award-winning exhibition uses thought-provoking, interactive, and creative formats to spark conversation about the impact of technology on society. The latest edition, the Misinformation Edition , focuses on misinformation, deepfakes, and tech dependency. Find out about emerging types of influencers, the new and old tactics they use, and the role everyone plays in the way information flows."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Tactical Tech"
      }
    ]
  },
