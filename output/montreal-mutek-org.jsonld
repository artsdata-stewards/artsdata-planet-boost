      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/si-cut-db"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Little known on this side of the Atlantic, Douglas Benford aka Si-Cut.DB has crisscrossed most of Europe for almost 15 years under that name. Producer with a travel log a mile long, a Londoner who's eternally unsatisfied by his sonic creations, he explores many varying musical directions-most notably in the form of Radial Blend, Phoenix Jig, Media Form or even Tennis, who he co-created with Benge. For 9 years, he has been heading up SPRAWL night and the label it is affiliated with SPRAWL IMPRINT. For MUTEK, he will be serving acoustically improvised recordings, from sounds originating form astronomic radiotelescopes and lo-fi analogue keyboards to create a 'dub' soundscapes."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Si-Cut.DB"
      }
    ]
  },
