      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Giselle Angeles aka Fragmatista is a new media artist currently working on interactive landscapes, 3D design, real-time visuals, VFX, VR and CGI. She is a member of Digi-Gal, a global community of women who specialize in 3D design and animation. Her practice concerns interactive landscapes, exploring nature research and technology, and has been featured across a number of platforms, in exhibitions and festivals including, Fubiz, Feltzine, Giphy Arts, Hervisions, British Council, MIRA Festival, Standard Vision, Espacio Fundación Telefonica and One Times Square."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Giselle Angeles"
      }
    ]
  },
