      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/decrepticon"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "[CANADIAN DEBUT] Decrepticon is New York visual artist Ilan Katin. Katin specializes in abstract drawing, live video performance and animation. As a video performance artist Ilan has provided visual support for a variety of musicians including Shelley Hirsch, DJ Olive, o.blaat, Lance Blisters, Toshio Kajiwara, Aaron Spectre, Becca Schack, Bora Yoon, Erwin Music, Lukas Ligeti, i8u, RJ Valejo, Glomag, Bubblyfish, and The Mad Scene. He has also provided VJ sets in a variety of locations in New York City, including the Museum of Modern Art, Tonic, Galapagos and The Tank."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Decrepticon"
      }
    ]
  },
  {
    "@id": "_:g13755400",
    "@type": [
