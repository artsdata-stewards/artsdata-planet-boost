      }
    ],
    "http://schema.org/mainEntityOfPage": [
      {
        "@id": "https://montreal.mutek.org/en/news/mutek-montreal-edition-26-2025-un-nouveau-cycle"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://montreal.mutek.org/en/news/mutek-montreal-edition-26-2025-un-nouveau-cycle"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/news/mutek-montreal-edition-26-2025-un-nouveau-cycle"
      }
    ],
    "http://schema.org/alternateName": [
      {
        "@language": "en",
        "@value": "MUTEK Montréal"
      }
    ],
    "http://schema.org/copyrightYear": [
      {
        "@language": "en",
        "@value": "2024"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The 25th edition of MUTEK Montréal comes to a close today, marking a quarter-century of inspiration, reflection and creativity. This anniversary symbolises much more than a simple celebration: it's the opening of a new era.  This new era is justified by the profound transformations we have initiated this year. Whether through the increased integration of emerging technologies, the emphasis on inclusivity, or the exploration of new artistic forms.  It's a commitment not just to follow trends, but to anticipate and shape them. True to our innovative spirit, we open ourselves to new paths, inviting you to explore uncharted waters and give free rein to your emotions. The time has come to embark on the next cycle.  The Festival continues to transform itself, building a global ecosystem of artistic ideas and proposals, in which every participant plays a pivotal role. We are called to be part of a pluralistic whole, to imagine futures that open up new opportunities for future generations.  The discussions that animated MUTEK Forum and the discoveries of the Future Festivals Summit should enable us to design a promising future for all communities. Support, development and research initiatives are paving the way for a sustainable and innovative evolution of our cultural landscape.  By joining forces, we can enrich our current practices and invent new forms of artistic expression and collaboration, which are essential for shaping what's to come.  We now invite you to the next MUTEK Montréal gathering, to be held from 20 to 24 August 2025, where the tomorrows of digital creation and electronic music will take shape.  Blind passeports are now on sale for $200 (+ taxes and service fees). Limited Quantity.   Box Office"
      }
    ],
    "http://schema.org/headline": [
      {
        "@language": "en",
        "@value": "MUTEK Montréal Edition 26: 2025, A New Cycle"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "en",
        "@value": "en"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "MUTEK Montréal Edition 26: 2025, A New Cycle"
      }
    ]
  },
