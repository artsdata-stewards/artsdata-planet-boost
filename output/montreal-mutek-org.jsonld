    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/yona-featuring-ash-koosha"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "From Tehran’s repressively underground punk-rock scene to the AI-penned lyrics and the computer-generated rhythms of auxuman (auxiliary human) singer-songwriter YONA , this polymath Iranian performer and software humanist has spent his entire career on the frontlines of musical revolutions, both physical and virtual."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "YONA featuring Ash Koosha"
      }
    ]
  },
