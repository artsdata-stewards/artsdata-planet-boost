    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Deep bass, pulsating rhythms, and vivid projections merge in a novel audiovisual experience presented by the International Festival of Films on Art, MUTEK, and the Society for Arts and Technology. Returning to Montreal after her notable appearance at the MUTEK festival, Deena Abdelwahed promises a new irresistible performance."
      }
