      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "His installations have been exhibited in Japan, Germany, the United States, Canada, and the Internet; his enigmatic photos have been published in ava books (GB), and photo life (CA). Always interested in sharing his recent finds, heard or experienced, Jamie Drouin orchestrates his multiple influences into his specialized audio-visual pieces."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Jamie Drouin"
      }
    ]
  },
