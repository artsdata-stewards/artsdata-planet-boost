      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Mathew Jonson  CA Live  At MUTEK, Mathew Jonson will unveil his mastery in melding classical influences with raw techno energy. A virtuoso of analog synths and live, improvisational electronic sets, Jonson's creative process breathes life into every performance. Drawing from a rich palette of personal and musical histories, he crafts a sonic experience that transcends the typical, making each note a unique journey."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Mathew Jonson"
      }
    ]
  },
