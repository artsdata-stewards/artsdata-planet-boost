      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Montréaler Julien Racine's process involves sampling from vinyl for his one-man, atmospheric assembly. He will deliver a performance that follows up on Quelque Chose Tombe . Artifact-tracks from the album will make subtle appearances, with the goal of placing him between the familiar and that which is yet to be created."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Racine"
      }
    ]
  },
