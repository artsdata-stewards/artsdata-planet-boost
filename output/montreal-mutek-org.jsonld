      {
        "@id": "https://montreal.mutek.org/en/artists/machina"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "machìna — Action Live | North-American Premiere  With Action , machìna strips techno down to its core: the pure interplay of rhythm and sound. Built live with just a drum machine and her voice, each set explores the abstraction of simple beats and layered percussion. Fluid and minimal, the performance adapts in real-time to the energy of the room—live music made for dancing, anywhere."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "machìna"
      }
    ]
  },
