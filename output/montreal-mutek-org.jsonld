      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Kazuya Nagaya has long altered the exquisite sacred sounds of bronze bells, gongs and singing bowls to recontextualize the meditative effect of their reverberating sound and silence. Ponderous and thoughtful, Nagaya 's drifting notes and echoing drones inquire about the world and incite personal introspection."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Kazuya Nagaya"
      }
    ]
  },
