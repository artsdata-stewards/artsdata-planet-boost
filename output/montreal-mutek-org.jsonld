    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/seph-ana-heilpern"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Seph: Con más de 15 años de actividad en la escena techno, se ha establecido como un artista multifacético, dividiendo su tiempo entre roles tales como un productor enérgico y prolífico, remixador, manager de Aula Magna Records y un show en vivo que lo ha llevado a tocar por todo el mundo. Un experimentador sonoro dedicado a expandir la experiencia en la pista de baile y en la mente.  Ana Heilpern: Realizadora visual con una trayectoria que la ha llevado a participar como iluminadora, camarógrafa, editora y productora en diversos medios y emprendimientos. Asimismo, su pasaje por las artes escénicas la han encaminado a consolidar su actual posición como técnica operadora de iluminación en el Centro Cultural de la Cooperación."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Seph & Ana Heilpern"
      }
    ]
  },
