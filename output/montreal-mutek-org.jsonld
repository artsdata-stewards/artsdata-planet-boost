      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Uroboral is an interactive Virtual Reality work carried out by Darío D’Antiochia and Paula Casanova, as the final work of the Image and Sound Design career at the University of Buenos Aires. The work explores the concept of feedback, through a journey through digitally generated landscapes. The work deals with the themes of the loop, random experiences, and the possibility of user interactivity so that they can actively participate.  Translation provided by Google Translate"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Paula Casanova & Darío D'Antiochia"
      }
    ]
  },
