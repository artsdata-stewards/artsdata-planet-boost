    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Kara-Lis Coverdale  CA Live  Kara-Lis Coverdale will unveil a captivating live performance blending electronic and multi-instrument sounds. Known for her profound mastery of the organ and her intricate digital expertise, Coverdale offers sound constructions that seem both timeless and decidedly futuristic. Her work is a fusion of musical traditions promising a deep auditory journey, highlighting her distinctive synthesis of the acoustic and digital worlds."
      }
    ],
    "http://schema.org/name": [
