    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Bell Tower of False Creek Randolph Jordan │ Canada, 2017 │ 12 min An experimental documentary made from archival materials and newly shot Super-8, Bell Tower of False Creek takes as its subject Vancouver’s Burrard Bridge, in order to bring into conversation notions of soundscape, noise pollution, and indigenous land claim"
      }
