      {
        "@id": "https://montreal.mutek.org/en/artists/fm3"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Founded in 1999 by Christiaan Virant and Zhang Jian, two active members of the Beijing music scene, fm3 are considered pioneers of abstract electronic experimentation in China. Known for dedicating prime space for 'live' aspects within their work, fm3 produces mysterious, meditative, and minimalist soundscapes, while subtly adding certain elements of ancient Chinese folk tradition into a universe abundant in micro-sounds and synthetic glitches."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Fm3"
      }
    ]
  },
