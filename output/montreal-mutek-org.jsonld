    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Nick Schofield  CA/QC Live | World Premiere  Nick Schofield is set to transform the ambient landscape with his pioneering 'ambient rave' music. Schofield, known for his rich, soothing soundscapes, ventures into emotional dance music, integrating lush harmonic pads with rhythmic pulses driven by the Elektron Digitakt drum machine and Moog Grandmother sequences."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Nick Schofield"
      }
    ]
  },
