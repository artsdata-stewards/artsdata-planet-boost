    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Studio Everywhen (Brad Necyk x Jonathan Kawchuk)  CA — ALL SKY, MIRROR OCEAN  ALL SKY, MIRROR OCEAN is a film meditation expressed through landscapes of ocean and rainforests, taking place under the Pacific sunset. Tectonic plates converge, creating a tsunami that releases an awakening in the viewer. Ancient trees that seem everlasting become fragile glass sculptures, at risk of shattering and in need of defending."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Studio Everywhen (Brad Necyk x Jonathan Kawchuk)"
      }
    ]
  },
