    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Montréal duo Musique Nouvelle ( Simon Chioini and Félix Gourd ) reflects their desire to make layered, lively techno—and their passion for experimentation and the exploration of new sounds. Live performances, like this year's at MUTEK, and the improvisation that comes with them, are at the heart of the group's process."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Musique Nouvelle"
      }
    ]
