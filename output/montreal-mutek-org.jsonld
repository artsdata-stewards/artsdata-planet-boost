    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Don Sinini is an artist that reflects the current fluidity of UK urban music. His emotional style is steeped in the influences of multicultural London, drawing on influences including, Drill, Dancehall, Trap, Afrobeat and Asian traditional music."
      }
