    ]
  },
  {
    "@id": "https://montreal.mutek.org/temporary/4f4d10af-ddbd-4423-bbae-5f90a7b6b1d9",
    "@type": [
      "http://schema.org/Person"
    ],
    "http://schema.org/image": [
      {
        "@id": "_:g13476020"
      }
    ],
    "http://schema.org/mainEntityOfPage": [
      {
        "@id": "https://montreal.mutek.org/en/artists/magali-babin-i8u"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://montreal.mutek.org/en/artists/magali-babin-i8u"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/magali-babin-i8u"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Deux personnalités fertiles de la scène électronique montréalaise, I8U et Magali Babin, unissent leurs visions respectives, synthétique et organique, dans un duo « noise » hautement performatif. Magali Babin fut d'abord guitariste pour la formation féminine montréalaise « punk-noise » les Nitroglycérines (années 80). La musicalité de Magali Babin se démarque par l'installation radicale d'extrêmes sonores, d'un minimalisme se jouant de hautes fréquences perturbatrices à une interprétation personnelle d'un « noise » planant."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Magali Babin + I8U"
      }
    ]
  },
