      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/mec"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "[CANADIAN DEBUT] MEC is short form for Motards En Colere (which roughly translates to 'The Angry Motorcyclists'), a French trio of Dadaist digital hardcore electro-punks who wear motorcycle helmets for unpredictable performances with various analog electronic gear and a combination of pedals. Associated with the graphic design/fashion outfit Shoboshobo, MEC at times fall into the same category of Game Art as fellow showcase participants Glomag and Bubblyfish, but MEC are far more severe in their execution. Suffice it to say the MEC live experience is not one you're likely to forget."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "MEC"
      }
    ]
  },
