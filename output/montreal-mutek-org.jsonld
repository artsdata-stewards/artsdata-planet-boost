    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "A Single Point Of Light  Shemie brings an intimacy to each track through a masterful manipulation of every piece of the soundscape. At MUTEK 2020 , Shemie will breathe life into his primitive electronic configurations, infusing icy synthetic sounds with a spontaneous, sun-bleached warmth."
      }
    ],
    "http://schema.org/name": [
      {
