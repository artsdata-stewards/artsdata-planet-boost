      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "An artist known for melding digital with organic and manipulated sound with abstract images, Hugues Clément deploys glitch, 3D modelling and graphic interventions in playful, poetic and sometimes brightly kitschy ways. His visual collages are both uncanny and inviting, destabilizing recognizable sights in the natural world with electronic stutters and unexpected digital data forms."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Hugues Clément"
      }
    ]
  },
