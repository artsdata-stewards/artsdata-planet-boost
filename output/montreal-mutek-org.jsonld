      {
        "@language": "en",
        "@value": "Using a mix of European folklore, cartoon music, space-age pop, vocoders and children's toys, this audio/visual collaboration uses samples and video screens to take audiences back to a world ruled by innocence and naïve imaginations, a world most of us see only in kindergartens run amok."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Gangpol & Mit"
      }
    ]
  },
