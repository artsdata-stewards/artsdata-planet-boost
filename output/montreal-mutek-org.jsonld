      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Marc-André Cossette  CA/QC — Altérité Numérique Altérité Numérique is a research-creation project that aims to study the relationship between a dancer and an interactive digital system. During the piece, the dancer improvises in movement to algorithmically generated electronic music. The music reacts to her movements and changes autonomously throughout the piece.  Presented by Hexagram"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Marc-André Cossette"
      }
    ]
  },
