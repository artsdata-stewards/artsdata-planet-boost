    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Ahreum Lee  KR/QC — Multiple Selves Working from research on communication with virtual assistants (Siri, Alexa, Google, etc.), the perception of voice, the hierarchization of sounds according to gender, and the concept of Glitch Feminism (Lacey Russel), Ahreum Lee suggests a glimpse of voices of the future. In a random play on the pitch, length, and tone of syllables, Multiple Selves brings together three choristers who reproduce sounds generated by a voice synthesis application the artist has created.  Presented by Hexagram"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Ahreum Lee"
      }
    ]
  },
