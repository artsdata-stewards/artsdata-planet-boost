    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Of course, much of this praise has to do with normally skeptical journalists lining up to praise his just-released debut album, Rumpelzirkus (meaning 'rumbling circus'), an album that flares with the kind of originality that comes along only every once in a blue moon."
      }
    ],
    "http://schema.org/name": [
