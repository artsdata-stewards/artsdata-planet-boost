    ]
  },
  {
    "@id": "https://montreal.mutek.org/temporary/041ba654-4e75-448b-964b-1b14d5e8ffe7",
    "@type": [
      "http://schema.org/Person"
    ],
    "http://schema.org/image": [
      {
        "@id": "_:g4790060"
      }
    ],
    "http://schema.org/mainEntityOfPage": [
      {
        "@id": "https://montreal.mutek.org/en/artists/substance"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://montreal.mutek.org/en/artists/substance"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/substance"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Peter Kuschnereit is DJ Pete a.k.a Substance , recognized as one of the essential leaders of the techno scene in Berlin. Born and raised in the central district of Kreuzberg, his influence has been multifaceted: he has worked at the groundbreaking HardWax record store for 27 years, has had a long and fruitful relationship with Berghain, is also one of the main DJs of the legendary series of WaxTreatment parties, which helps unite diverse varieties of world dance music and, above all, became an institution of the world circuit for carving the most aseptic and profound sound of the German capital, the purest techno dub with his contributions to the label Chain Reaction and Scion Versions in the mid 90's and 2000 along with Vainqueur."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Substance"
      }
    ]
  },
