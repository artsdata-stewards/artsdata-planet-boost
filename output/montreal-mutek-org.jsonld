      }
    ],
    "http://ogp.me/ns#image:alt": [
      {
        "@language": "en",
        "@value": "An abstract and vibrant digital collage featuring three figures - Amnesia Scanner & Freeka Tet - against a red background. Each figure has been altered with a glitch-like effect, where their eyes are positioned on horizontal strips that float across the frame, disjointed from their faces. From left to right: the first figure appears in a blue textured outfit with a pendant; the second is wearing a floral pattern with an orange flower by their shoulder; the third exhibits an intense expression, with a silver chain hanging near their face. The image has a surreal, edgy vibe, emphasized by its high contrast and saturation."
      }
    ],
