    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Allison Moore  CA/QC \t- Mystic Vale Film  Allison Moore captures the lush forests of Vancouver Island using photogrammetry, creating 3D models and generative animations. Her immersive full dome film video wall and Arthur Desmarteaux's field recordings transport viewers to a serene, moss-covered rainforest, preserving the essence of Mystic Vale's Douglas fir ecosystem.  Allison Moore will also perform at the festival on Saturday, August 24th, at Nocturne 5 with the trio CLOUD BODIES ."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Allison Moore"
      }
    ]
  },
