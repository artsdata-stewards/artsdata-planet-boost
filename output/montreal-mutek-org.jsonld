      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://montreal.mutek.org/en/artists/helen-of-troy"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/helen-of-troy"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Helen of Troy is a project conceived by Montreal's Leon Lo, prolific producer of CD-Rs and manager of Natacha's Recording. Leon Lo loves to mix things up. Following intense exploration into the creative limits of basic instrumentation (exclusive use of a mixer, delay and feedback), the inclusion in his recent compositions of analogue sound sources shatters formal research into 'purified' beauty. Here, he allows other, more specific and demonstrative human sentiments to spring forth: weakness, anger, sleep and ugliness."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Helen of Troy"
      }
    ]
  },
