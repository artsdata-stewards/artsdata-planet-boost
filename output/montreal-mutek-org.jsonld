      }
    ],
    "http://schema.org/mainEntityOfPage": [
      {
        "@id": "https://montreal.mutek.org/en/artists/joana-gomila-1"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://montreal.mutek.org/en/artists/joana-gomila-1"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/joana-gomila-1"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "With the release of Folk Souvenir (Bubota Discos, 2016), Joana Gomila and her band reinvented the traditional Majorcan 'tunes' impregnating them with jazz, free rock and mysticism.  With Paradís (Bubota Discos, 2020), its successor, she has only met with her collaborator Laia Vallès , investigating the possibilities and limitations of analog electronics, without computers involved.  As a result, early repertoire updates and own compositions sound blurred and kaleidoscopic, expanded by effects pedals and defined by synthesizers, linking the Mediterranean to Saturn."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Joana Gomila"
      }
    ]
  },
