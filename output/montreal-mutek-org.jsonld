      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://montreal.mutek.org/en/artists/jonas-bering"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/jonas-bering"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "With French composer Jonas Bering, “pleasure” is one of the first words to come to mind. Encompassing the minimalist and dub influences consistent with Berlin's notorious Chain Reaction label, Bering entertains himself by brewing up veritable pearls of sound to offer to his audience. This performance will open your ears to the ever-evolving Berlin-Cologne scene."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Jonas Bering"
      }
    ]
  },
