      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Former New Yorker Jesse Siminski (aka Heartthrob) emerged in 2005 as one of the shining lights on Richie Hawtin's rejuvenated m_nus label. Alongside Marc Houle, Magda, and Troy Pierce, Heartthrob brought into vogue a highly jacked version of minimal techno that has since dominated dance floors the world round.Siminski, who also records as Vivianneprojects, began releasing singles in 2004 and had quickly made a name for himself as an ace remixer, having reworked the likes of electro-pop heavyweights like Depeche Mode and The Knife, as well as Matthew Dear's Audion alias. He currently lives in Paris."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Heartthrob"
      }
    ]
  },
