    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Montrealer France Jobin is an audio and installation artist, as well as composer and curator. Born in Leipzig, visual artist Markus Heckmann moved to Toronto in 2006 as Technical Director at Derivative, the creators of TouchDesigner."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "France Jobin & Markus Heckmann"
      }
    ]
