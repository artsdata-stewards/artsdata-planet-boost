    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Tryphème  FR Thanks to the support program of the FGO-Barbara Center in Paris, Tryphème has been able to build a live of her own, where the energies mingle with the arts. The perfect occasion to share her second album, Thanks God for Air Emotions , is yet another indicator of his obsession for skin-deep music, a filterless conductor of his feelings towards ours.  Presented by Chapelle XIV , with the support of the Consulat général de France à Québec"
      }
    ],
    "http://schema.org/name": [
