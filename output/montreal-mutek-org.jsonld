      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/bola"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The SKAM label is an anomaly of almost mythical status, due to the rarity of its recordings, the peculiarity of its first releases, and the delicateness of the little stickers placed on every record that offer a Braille translation of its title. Bola (Darrell Fitton) fits this mysterious aura easily: despite a number of years of activity, his recordings are few and far between. His latest work provides atmospheric and mysterious music in which dense melodic textures lie gently over sharp chiseled rhythms. Labeled 'intelligent music' and marked by a certain sacred quality, Bola's composition will call your body -and your mind - to the dance floor."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Bola"
      }
    ]
  },
