    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/quan"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Quan’s expertise designing and operating modular synthesizers delivers a musical palette that jumps between uplifting experimental soundscapes, minimal techno, and deep house. A prominent figure in the development of Vietnam’s experimental electronic music scene, the spontaneous revisions to his live, ever-evolving improvised performances provide an endlessly varied alternative to traditional loop-structured song formats.  This improvised modular techno live set is the result of 2 years of developing his own electronic instruments, Quanalog, as well as new influence from the city of Montreal."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Quan"
      }
    ]
  },
