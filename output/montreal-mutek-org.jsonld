    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Producteur vétéran avec un alter ego qui vit pour le son industriel atmosphérique, mais dont l'autre discographie chevauche la house expérimentale et les compositions pour piano austères, Rrose reste dans l'ombre sur scène, allant de lui et d'elle de manière interchangeable - dans une interrogation implicite de l'art de genre et des normes."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Rrose"
      }
    ]
  },
