    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "A longstanding player in Canada's techno circles, Montréaler Mateo Murphy has clocked nearly 20 years harnessing technology, manning the decks, and releasing dozens of dark, repetitive, rhythmically elegant tracks and remixes – from collaborations with Pheek and Noah Pred to deep, driving cuts on labels such as Tiga’s Turbo and Misstress Barbara’s Relentless."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Mateo Murphy"
      }
    ]
  },
