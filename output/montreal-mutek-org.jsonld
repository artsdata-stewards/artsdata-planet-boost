    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Cy-Ens  CA/QC – Synapse Live  Cy-Ens unveils their latest performance, Synapse , a profound exploration of the nexus between nature and technology through a six-movement suite. Masterfully blending live coding, generative algorithms, and an array of instruments including voice and Theremin, Cy-Ens creates a unique auditory and visual tableau. Synapse emphasizes the harmonious interplay between computational intelligence and human expressivity, inviting the audience into a world where sound transcends traditional confines."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Cy-Ens"
      }
    ]
  },
