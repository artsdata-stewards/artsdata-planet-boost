    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Jess Rowan Marcotte CA/QC — TRACES TRACES is a physical-digital hybrid game experience about trans experiences and science-fiction-themed time travel in a Western 2018/2019 context. Steven Sych CA/QC — MNG+ (Menu New Game+) Main menus are the first thing we see when we start a video game."
      }
    ],
    "http://schema.org/name": [
