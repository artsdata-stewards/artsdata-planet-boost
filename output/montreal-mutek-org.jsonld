  {
    "@id": "https://montreal.mutek.org/temporary/7ff46d75-7c84-4a16-921e-b93856f25b2c",
    "@type": [
      "http://schema.org/Person"
    ],
    "http://schema.org/image": [
      {
        "@id": "_:g5620640"
      }
    ],
    "http://schema.org/mainEntityOfPage": [
      {
        "@id": "https://montreal.mutek.org/en/artists/avalon-emerson"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://montreal.mutek.org/en/artists/avalon-emerson"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/avalon-emerson"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "For the past two years, Avalon Emerson has been fastly emerging through a techno scene that didn’t quite expected her arrival. Her rapid ascent is no equivalent to the productivity with which she releases new material and the signature sound she’s able to develop in them. Her synths touch often flares out in an ocean of abstract which makes her music special, and very much peculiar to herself. There’s an Avalon Emerson sound and we are quite ready to hear more from it, which is why we are glad to welcome her for the first time under Mutek’s intercontinental roof."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Avalon Emerson"
      }
    ]
  },
