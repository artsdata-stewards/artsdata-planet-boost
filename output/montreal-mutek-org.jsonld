      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The Montag project is Montrealer Antoine Bédard's wink to a character in Truffaut's Fahrenheit 451. Under this alias, he attempts, via a cinematic regard, to confer a human dimension to electronic music. He achieves this through melodic compositions that mix analogue synthesizers, xylophone, percussion, organ, and other acoustic instruments ‚Äì all digitally treated. Montag's compositions are charming musical translations of memories he would like to share."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Montag"
      }
    ]
  },
