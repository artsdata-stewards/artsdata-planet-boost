      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://montreal.mutek.org/en/artists/triple-r"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/triple-r"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Last year, MUTEK sidetracked TRIPLE R (Riley Reinhold) from his small-scale North American tour with Thomas Brinkmann for an unforgettable experimental techno set, Cologne-style. This year he's back to accompany and show off some of the musicians on his TRAUM label (and from his sub-label TRAPEZ!). Riley has committed himself to some amazing fieldwork touring the world, discovering and unearthing to the public an assortment of little-known artists whom he takes under his wing. This night alone will unite musicians from three separate continents and is guaranteed to satisfy the appetites of hungry experimental music lovers with a side order of melodic and sensual toppings."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Triple R"
      }
    ]
  },
