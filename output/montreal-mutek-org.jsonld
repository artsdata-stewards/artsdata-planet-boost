      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Created in 2015, El Pumarejo is a non-profit association based in l'Hospitalet de Llobregat whose mission is the incubation of emerging cultural movements, offering creators a space to develop artistically and professionally, promoting the revaluation of the arts, fair trade in culture and promoting the projection and mobility of projects. All this, always seeking to participate in the cultural development of the community with specific interventions that promote the discovery of art in all its facets."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "El Pumarejo"
      }
    ]
  },
