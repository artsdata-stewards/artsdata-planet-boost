      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://montreal.mutek.org/en/artists/kazuya-nagaya-ali-m-demirel"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/kazuya-nagaya-ali-m-demirel"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Iwakura is an audiovisual performance for the full-dome created by video artist Ali M. Demirel , ambient musician Kazuya Nagaya , and produced by Maurice Jones . Originating from Shintoist mythology, Iwakura refers to the spirits that inhabit sacred rock formations found all over Japan. Through immersing the audience in Ali’s organic, visual material collected in the Kumano region, the birthplace of Japanese spirituality, with Kazuya’s meditative, ambient soundscapes inspired by Zen-Buddhist prayer rituals, Iwakura presents a profound journey to rediscover the sublimeness of nature.  The project was made possible by round 9 of the International Coproduction Fund of the Goethe-Institut."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Kazuya Nagaya & Ali Mahmut Demirel & Maurice Jones"
      }
    ]
  },
