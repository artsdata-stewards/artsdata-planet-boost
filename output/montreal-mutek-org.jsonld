      {
        "@id": "https://montreal.mutek.org/en/artists/commonolithic-olivia-mc-gilchrist"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Commonolithic & Olivia Mc Gilchrist  UK/QC + JM/FR/QC — World Space V2 World Space V2 is a WebVR experience that offers a playful perspective of navigating the gravitational pull of a large object as a small sphere in 3D space. Accessed through Mozilla Hubs, the work affords a moment of flaneur-like exploration in the company of a broken toy as a celestial body, surrounded by sounds evoking the object’s materiality.  This work is presented in collaboration with the Société des arts technologiques [SAT] and designed for the platform SATELLITE."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Commonolithic & Olivia Mc Gilchrist"
      }
    ]
  },
