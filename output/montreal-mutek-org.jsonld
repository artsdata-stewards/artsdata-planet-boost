        "@language": "en",
        "@value": "Amnesia Scanner & Freeka Tet  FI/DE+FR/US – STROBE.RIP Live A/V | North American Premiere  Amnesia Scanner and Freeka Tet present STROBE.RIP , an…"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://medias.mutek.org/artists/_1200x630_crop_center-center_82_none/Amnesia-Scanner-Freeka-Tet.jpg?mtime=1721191366"
