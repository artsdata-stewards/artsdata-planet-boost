      }
    ],
    "http://ogp.me/ns#image:alt": [
      {
        "@language": "en",
        "@value": "Alexis Langevin-Tétrault performing live with his custom audiovisual instrument. Captured under deep blue lighting, the artist interacts with a sculptural setup of wires, sensors, and light, emphasizing his experimental approach to sound and media art. Known for his innovative performances and physical engagement with sound, Langevin-Tétrault merges kinetic gesture and sonic composition in real time."
      }
    ],
