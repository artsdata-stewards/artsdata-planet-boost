    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Minibloc is the duo of Anne-Françoise Jacques and Nicolas Dion. Minibloc use amplified objects, small electronic circuits and manipulate field recordings to create live sound performances, occasional radio pieces and, recently, sound installations.  Until now, Minibloc played concerts in Montreal, Quebec City, Rimouski, Winnipeg and Berlin. Minibloc's first full-lenght cd, \"Carton micro récréation\", was released with Le Son 666 collective."
      }
    ],
    "http://schema.org/name": [
