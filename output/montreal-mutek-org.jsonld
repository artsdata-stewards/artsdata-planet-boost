    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Martyn “M” Bootyspoon  Live | World Premiere  Martyn “M.” Bootyspoon presents a live set tracing the Black American roots of house, techno, juke, footwork, and electro, alongside the raw edges of UK grime. Using samplers, synths, and his voice — without a laptop — he builds a dynamic, physical performance that celebrates the dancefloor as a site of connection, resistance, and reinvention."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Martyn Bootyspoon"
      }
    ]
  },
