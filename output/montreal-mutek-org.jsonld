    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/kathy-hinde"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Ever-changing and generative, Kathy Hinde 's audiovisual creations echo phenomena found in the natural world to explore the relationship of people with other species, each other and the earth’s systems. Her abstracted soundscapes and generative art, whether in public outdoor spaces or galleries, uses technology to express those relationships, reflecting on and raising awareness of our everyday world, and involving the audience in a consistently unique creative process."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Kathy Hinde"
      }
    ]
  },
