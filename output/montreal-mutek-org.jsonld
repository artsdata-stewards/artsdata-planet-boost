    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Olaf Blanch is a producer from Barcelona with an elastic trajectory. After participating in several musical projects, in recent years he has focused on creating a personal sound with clear influences from ambient and more experimental electronics. His style, enveloping and in constant evolution, is characterized by the sound of analog synthesizers taken to the limit, lysergic piano improvisations, broken beats, landscape sounds and dream voices that create undivided harmonies."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Olaf Blanch"
      }
    ]
  },
