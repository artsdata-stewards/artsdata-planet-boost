    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "On his acclaimed solo debut album, Alborada (ZZK 2018), and on the EP Marimbas del Guapi (2020), Uji has deepened his exploration of the evolution of folklore: ancient regional customs in dialogue with our modern times and rituals. Uji's new set, exclusively designed for MUTEK ES+AR 2021, previewed songs from his upcoming album TIMEBEING."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Uji"
      }
    ]
