      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://montreal.mutek.org/en/artists/chika"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/chika"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "[CANADIAN DEBUT] New York's Chika Iijima is a live computer visuals artist who often collaborates with her city's sound art community as a video jockey. She was born and raised in Japan and moved to New York in the early 90s, working as a graphic designer until she began her experiments in time-based media. Her videos tend to implement geometric minimalist patterns and original graphics in unique, repetitive combinations. She has performed at the Museum of Modern Art, The Mapping Festival (Geneva), the Bushwick Art Project and the clubs Galapagos and Tonic, as well as private parties, festivals, events, galleries and nightclubs."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Chika"
      }
    ]
  },
