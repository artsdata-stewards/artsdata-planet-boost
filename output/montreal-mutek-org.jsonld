      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Umo has spent a decade performing live hardware sets in the rave / club scene in Barcelona. Sharpening his sound and becoming one of the most acclaimed live shows of the city´s underground circuit. Before releasing any track, his music is tested at events and clubs such as La Camara, Nave 13-14, Moog, Razzmatazz, La Cova, Apolo, BeCool (BCN), Industrial Copera (GRX), La Sala (Bogota), SeOne (London), Coopelia 101 (Madrid) or Florida 135 (Fraga)."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Umo"
      }
    ]
  },
