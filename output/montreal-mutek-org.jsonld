  {
    "@id": "https://montreal.mutek.org/temporary/cc0eb000-a111-4a39-ae32-8b74f0dd0450",
    "@type": [
      "http://schema.org/Person"
    ],
    "http://schema.org/image": [
      {
        "@id": "_:g11583340"
      }
    ],
    "http://schema.org/mainEntityOfPage": [
      {
