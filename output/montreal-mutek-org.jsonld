      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://montreal.mutek.org/en/artists/kevin-drumm"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/kevin-drumm"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Based in Chicago, Kevin Drumm participates in numerous projects and records for several labels. Nevertheless, his most intense and highly explosive project is found, not surprisingly, on Peter Rehberg's MEGO label. Ably exploiting undesired errors and intentional excesses, his compositions chart the topography of a sonic landscape not often frequented by other artists. Gorgeously abstract yet conceptually brilliant, Drumm's work should make for an unforgettable experience for anyone remotely interested in avant-garde experimentation."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Kevin Drumm"
      }
    ]
  },
