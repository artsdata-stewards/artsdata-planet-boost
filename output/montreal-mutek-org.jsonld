      {
        "@id": "https://montreal.mutek.org/en/artists/gaika"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Shape-shifting Brixton artist GAIKA not only straddles disciplines with his future-forward fashion, dystopian A/V sculptures and dissident writings. Since 2015, this emotionally wrenching producer and MC has also delivered a steady stream of expansive industrial electronics. Fiercely loyal to the place he calls home, the ideas underpinning his work draw attention to gun violence, modern masculinity and the immigrant experience, while his gothic Afro-swing soundtracks the underground resistance."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "GAIKA"
      }
    ]
  },
