    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Ethereal, enthralling and perhaps a little wicked... the voices of electronic music have that little something that hardly leaves us indifferent. ﻿Whilst some producers look to technology to create intoxicating melodies, others choose to remain faithful to the purest instrument in the world."
      }
