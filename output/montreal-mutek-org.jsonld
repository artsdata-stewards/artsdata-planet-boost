      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/christopher-mcnamara"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Chris McNamara is video artist, writer and musician. He teaches new media at the University of Michigan in Ann Arbor, MI. In October 2002, McNamara presented an exhibition at the Stiftung BINZ 39 gallery in Zurich, Switzerland-his first spanning the international spectrum. His most recent projects have been developed in collaboration with Steve Roy, another member of Thinkbox, with whom he explores the integration of field-recordings within rhythmic compositions."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Christopher McNamara"
      }
    ]
  },
