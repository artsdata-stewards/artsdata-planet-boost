    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Blade   ARTEXTE 's works were introduced to the audience in multimedia art forms, such as album recording, data based interactive installation and real-time audio visual performance. Through Touch Designer/Notch and modular gears, they create digital scenes that intertwine glitch sound, dark ambient compositions accompanied by black and white grainy visuals."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
