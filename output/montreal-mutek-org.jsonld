    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Dandy Jack and the Éléphant Lab  CL After more than 30 years of exploring the sonic possibilities of electronic music and conducting non-stop creative exchanges, Dandy Jack proves that a musical career without stagnation is possible. At the festival, he will present his new project Dandy Jack and the Éléphant Lab , taking the audience into an intimate sphere of musical creation, where experimentation reigns over all.  Presented by Sundeck"
      }
    ],
    "http://schema.org/name": [
