    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "COH - Ivan Pavlov lives in Sweden and works as a sound engineer. His musical work captures the active sounds that lie at the heart of seemingly static bodies. His latest project, 'Vox Tinnitus,' was completed in collaboration with the members of the British musical group Coil."
      }
    ],
    "http://schema.org/name": [
