    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "(oum  CA/QC — Music for dancing & not dancing!  (oum promises a DJ set with an ethereal, opaline and slightly abrasive character. The artist will juxtapose a selection of electronic music with echoes from here and overseas, inspired by a variety of styles: from dub to Berlin school, through iridescent dance music and jazz sounds."
      }
    ],
    "http://schema.org/name": [
      {
