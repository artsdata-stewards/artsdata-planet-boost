      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Whether taking centre stage as a DJ, producer or label head, Gene Tellem communicates her own style of tweaked soul music through house and techno scripts, dedicating her productions to grooves for both nodding heads and wiggling bodies. Inspired by natural phenomena, Myriam Boucher merges the organic and the synthetic in her mesmerizing visuals, installations and performances. Her sensitive and polymorphic work explores the intimate dialogue and fluid shifts between music, sound and image."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Gene Tellem & Myriam Boucher"
      }
    ]
  },
