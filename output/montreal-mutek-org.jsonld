    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "His approach, hybrid in nature and sometimes highly-referential (e.g. his reinterpretation of Van Halen on My Love is Rotten to the Core), is so rigorously executed that Hecker eludes conventions, aesthetic proprieties, and genre pigeonholing altogether."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Tim Hecker vs 242 Pilots"
      }
    ]
