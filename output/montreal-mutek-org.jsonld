    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The computerized dub and digital dancehall era comes from the virtuous hands of Italian producer Simone Trabucchi aka STILL , originally from Vernasca, a remote village in the north of his country that played a crucial role in his sound design, weaving a transoceanic network between Italy, Ethiopia and Jamaica."
      }
    ],
    "http://schema.org/name": [
