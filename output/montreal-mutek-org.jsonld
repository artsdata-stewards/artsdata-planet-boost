      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "In 2006, Melesul3 (Jérôme LeBel) began injecting his visual touch into Montréal’s electronic music scene. His style moves between retro neon and minimal glitch. The rhythm and energy of his visuals are in symbiosis with the artist he accompanies. Since 2013, he has been exploring the Satosphère at the Société des arts technologique with immersive visual work."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Melesul3"
      }
    ]
  },
