    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "His work is known for precise sound placement, complex, interwoven rhythm structures and its minimal, flowing approach. Bretschneider's subtle and detailed music is echoed by his visuals: perfect translated realizations of the qualities found in music within visual phenomena."
      }
    ],
    "http://schema.org/name": [
      {
