  {
    "@id": "https://montreal.mutek.org/temporary/9ad88c9c-4328-4247-9934-3bc89d1efc8d",
    "@type": [
      "http://schema.org/Person"
    ],
    "http://schema.org/image": [
      {
        "@id": "_:g10095580"
      }
    ],
    "http://schema.org/mainEntityOfPage": [
      {
        "@id": "https://montreal.mutek.org/en/artists/artist-of-the-year"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://montreal.mutek.org/en/artists/artist-of-the-year"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/artist-of-the-year"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Formed by three Montreal musicians, Camille Jacques, Nathaël Duhaime, and David Richard, and joined live by drummer Louis Coutu-who has the heavy task of playing with electronic rhythms sectioned off and surgically manipulated by his three cohorts, aRTIST oF tHE yEAR has gravitated toward electronic music for several years and integrates it into diverse forms of music. For this group of 'old friends,' who've grown up together in one of those magnificent agricultural suburbs, the 'physicality' of their sound is a revelation of utmost importance. The panoramas, the drills, the micro-samples, the reverberating basses, and the high frequencies much like the noises from the first automated printers, add to the groove while forming a unique whole."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "aRTIST oF tHE yEAR"
      }
    ]
  },
