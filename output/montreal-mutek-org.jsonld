    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "While no digital trace of Neo Edo live sets online (reminiscent of the days where rave information would only be available by a phone number for those in the know), Neo's sounds are well familiar to a network of those who have experienced multiple sets at local Montréal venues such as Blizzarts, Casa Del Popolo, and a fair share of unmarked warehouses."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Neo Edo"
      }
    ]
