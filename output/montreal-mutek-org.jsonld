    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Chris Bissonnette is a sound artist and graphic designer whose installations have been displayed in both Canada and the U.S. He's a founding member of the collective and a regular on the sonic festivals and events scene. Bissonnette's audio work is accompanied by visual creations: abstract graphic elements are used to produce non-representational video works. A full-length CD is currently in progress and slated for future release."
      }
    ],
    "http://schema.org/name": [
      {
