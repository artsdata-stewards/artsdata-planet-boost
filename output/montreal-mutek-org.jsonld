    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/maayan-nidam"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Maayan Nidam ’s music makes an authentic claim to diversity: growing up in Tel Aviv, Mediterranean, Jewish, Arabic and Eastern European traditional song wafted through the air alongside pop hits and rock ballads; youthful world travels added more layers to the mix, bringing her to Berlin’s underground clubs, where her global sensibility took root in techno."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Maayan Nidam"
      }
    ]
  },
  {
    "@id": "_:g5572000",
