    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Sofian Audry & TeZ  CA/QC+IT/NL — Xenolalia Xenolalia features a self-organizing artificial neural network and a colony of microorganisms in a symbiotic feedback loop in which they collaborate to generate a speculative alphabet. The work examines perceptual, cognitive, and communicative mechanisms of the human-living-machine through an installation that mixes bio-art and artificial intelligence.  Presented by Hexagram"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Sofian Audry & TeZ"
      }
    ]
  },
