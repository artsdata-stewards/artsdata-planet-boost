      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Josée Brouillard  CA/QC —  5 4 3 2 1  Inspired by the iconic Doomsday Clock , launched in 1947 by the Bulletin of the Atomic Scientists, and knowing fully well that the end of the world will be caused by humans, Josée Brouillard proposes the interactive installation 5 4 3 2 1, which questions our responsibility towards humanity. The text \"Would you dare trigger the end of the world?\" plays on fears, angst and apprehensions associated with the end of the world, and invites spectators to take an altogether trivial action: stepping on a pedal to end a countdown."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Josée Brouillard"
      }
    ]
  },
