      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Founded in 1988 by Alex Paterson and KFL member Jimmy Cauty, The Orb started as ambient and dub DJs in London. During the past, the project took lots of different shapes depending on the acts composing the group, until the one we know today: the unbreakable Dr. Alex Paterson, the German producer Thomas Fehlmann and the English musician and sound engineer Michael Rendall."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Orb"
      }
    ]
  },
