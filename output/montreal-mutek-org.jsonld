    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The immersive project that fuses dance, technology and music is a collaboration between San Francisco-based synthesizer expert and vocalist Arushi Jain and director and choreographer Carly Lave. GOLEM is a collaboration between Arushi Jain, Carly Lave, gamelab.berlin, University of Applied Sciences Kaiserslautern | Virtual Design and Will Hamilton."
      }
    ],
