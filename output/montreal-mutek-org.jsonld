    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Longtime involvement in Detroit's electronic music scene has afforded Theakston the opportunity to work with Carl Craig's notable label Planet E as well as with Ghostly International. Furthermore, he was assistant creative director of the inaugural Detroit Electronic Music Festival. Today, he collaborates with a number of artists throughout the Great Lakes region, such as the collective Thinkbox."
      }
    ],
