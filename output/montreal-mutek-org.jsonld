    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Cabanne is a trained jazz guitarist, a member of Parisian label Logistic and director of its affiliate, Telegraph. His latest releases on Detroit's 7th City and Berlin's Shitkatapult labels have made him one of Europe's most talked-about electronic musicians. Together with Ark, another talented member of France's house scene, they form Copacabannark, a dynamite combo and the newest protégés on the German label Perlon. Get ready for a funk-filled performance!"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Copacabannark"
      }
    ]
  },
