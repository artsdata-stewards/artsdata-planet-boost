    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Since the mid-nineties, Herbert’s highly conceptual yet ever-accessible practice has excelled at shimmering house, experimental techno, musique concrète, sampler-sweeping big band (as The Matthew Herbert Big Band) and dance music that doubles as persuasive political manifestos."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
