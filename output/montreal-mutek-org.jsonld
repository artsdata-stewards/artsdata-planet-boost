    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Known for his intense escalation of ambient noise crafted on synthesizers, sequencers and software, Tim Hecker recently elevated acoustic source material onto equal footing with his technology, linking the two worlds in heightened conversation: trademark static, feedback, industrial chords and bass permeate, as ancient musical melodies steadily weave through the soundscape."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Tim Hecker & Konoyo Ensemble"
      }
