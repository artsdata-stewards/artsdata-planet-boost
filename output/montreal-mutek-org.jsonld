    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Blawan, the British techno producer and DJ known for his industrial style and impactful productions, will return to the SAT on May 10, 2025.  Now based in Berlin, Blawan excels especially during his DJ sets, where he deconstructs electronic sounds, leading us into immersive sonic tunnels.  An event presented by Avec Courage, MUTEK Montréal, and the Society for Arts and Technology (SAT)."
      }
    ],
