      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Originally from Ottawa, Ontario, Jeremy has been a member of Arcade Fire since 2004. In the past few years he’s spent his energies outside of the band collaborating with a wide variety of artists: bandmates Sarah Neufeld, Will Butler, Tim Kingsbury, as well as other artists such as Michael Feuerstack, Susanna Wallumrød, Owen Pallett, Nedelle Torrisi, to name a few."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Jeremy Gara"
      }
    ]
  },
  {
