    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Berlin-based Rashad Becker has become one of the most revered mastering and cutting engineers in techno-oriented dance music over the past two decades, working with Dubplates & Mastering (founded by Basic Channel in 1995) and collaborating with Pantha du Prince, Brandt Brauer Frick, Keiji Haino, Sam Shackleton and Holly Herndon, among many."
      }
    ],
