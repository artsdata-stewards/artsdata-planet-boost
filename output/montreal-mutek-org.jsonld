      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://montreal.mutek.org/en/artists/katherine-kline-alex-moskos-vs-endos"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/katherine-kline-alex-moskos-vs-endos"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Two representatives of Low-Fi groups from Montreal, Dreamcatcher, Thames and Unireverse, Katherine Klein and Alex Moskos face two composers from the Internet label Panospria: John Brennan (Artifact) and Shane Turner (Turner of Wheels).Enthusiasts of improvisation, contemporary avant-garde and disjointed music, these four Montrealers promise us an exceptional opportunity to witness surprising sounds and breaks caught up in the vast ether of sound. Catch the premiere of this double-duo combo and experience an essential expression of a new generation of musicians working to solidify a new image of electronic music in Montreal."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Katherine Kline & Alex Moskos vs Endos"
      }
    ]
  },
