    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "MUTEK Network MUTEK est un organisme sans but lucratif, dédié à la diffusion et au développement des formes émergentes de la création numérique sonore, musicale, visuelle. L’activité principale de MUTEK est la présentation annuelle du festival du même nom, qui a lieu à Montréal depuis l’année 2000."
      }
    ],
