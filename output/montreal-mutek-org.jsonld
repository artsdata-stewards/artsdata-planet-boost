      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Jean-Pierre Gauthier  CA/QC — Générateur Stochastique  Générateur stochastique invites the audience to operate a game console in order to influence and control, at least partially, the installation’s sound output. Laser sensors and programming using random parameters modify the sounds produced as well as their spatialization. Robotic bows and percussion elements react unexpectedly to lines of code written during the composition process, thus creating a way of composing that challenges the operator’s desire for control."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Jean-Pierre Gauthier"
      }
    ]
  },
