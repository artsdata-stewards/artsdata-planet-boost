      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Fonderie Darling is thrilled to invite Never Apart to think up a musical program for a special event, presented on the Place Publique as part of its Allegorical Circuits for Human Software program.For the occasion, NVA proposes 5 musical performances that tie in with the themes of Allegorical Circuits for Human Software to allow for the pursuit of feminist reflections on digital technologies, highlighting the person-machine relationship that underlies computer-assisted musical production."
      }
    ],
