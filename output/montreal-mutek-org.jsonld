    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Overlooked and abandoned sounds take on new emotional form and presence in Jonathan Scherk and Daniel Majer 's music, where dreamlike melodies, electronic signals and tape hiss come layered among rumbling bass and drone."
      }
    ],
