    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/mens-koolwyk"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Sound Engineer and head of the prestigious ERS label (Pimmon, Ambarchi, Shifts), Radboud Mens creates music in all facets of contemporary electronics. Although his earlier work was constructed within the realms of noise-music, for the last three years his sound has evolved to include his own versions of 'glitch' and 'minimal-techno'. Working with video artist Bas van Koolwijk, Radboud uses computer data as sound samples, then edits and processes it to create a highly intense soundtrack for van Koowijk's video. Combining van Koolwijk's digitized video disturbance with Radboud's processed data-noise, sound and image signals influence each other heavily, steadily becoming one and the same."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "MENS/KOOLWYK"
      }
    ]
  },
