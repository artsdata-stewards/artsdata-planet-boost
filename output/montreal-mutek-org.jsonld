    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Stephen Beaupré — Return Live  Stephen Beaupré returns with Return , a finely tuned live set blending lush micro-house, intricate sampling, and hypnotic rhythms. Featuring new material from Vanishing Night and upcoming exclusives on The Nite Owls, this immersive performance balances precision with improvisation—offering a dancefloor experience that’s intimate, expressive, and deeply resonant."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Stephen Beaupré"
      }
    ]
  },
