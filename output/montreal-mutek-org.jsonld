    "http://schema.org/mainEntityOfPage": [
      {
        "@id": "https://montreal.mutek.org/en/artists/latinsizer"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://montreal.mutek.org/en/artists/latinsizer"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/latinsizer"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Latinsizer's work can be traced back to 1988 when he was a member of artefakto, one of the pioners in electronic music in mexico - later he founded nortec collective. Curretnly latinsizer is exploring a very synthetic and basic set of musical tools to create a quirky approach to electronic music that could be described as a combination of the melodic work of early synth Pop classics such as Eno-era Roxy Music, a combination of rhythm and groove with melody and the grit of urban Tijuana.Latinsizer becomes an alternate project to Nortec Collective, and particularly, to Fussible."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Latinsizer"
      }
    ]
  },
