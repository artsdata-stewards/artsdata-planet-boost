    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Phèdre — Liquid Constancy Live | World Premiere  Phèdre returns with a raw, semi-improvised live set shaped by their new album Liquid Constancy . Performed entirely on hardware, the duo, composed of April Aliermo and Daniel Lee, weaves club, jungle, and breakbeat influences through a kinetic blend of samples and synths. Expect deep grooves, sharp turns, and a pulse that never lets go."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Phèdre"
      }
    ]
  },
