      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Akousma + Audiotopie present Léa Boudreau and Nancy Tobi   n   CA/QC — Interstices  A composition spanning three days, Interstices integrates random processes and probabilities favoring its autonomy and its renewal over time. Its sound elements are borrowed from the natural world and resonating bodies, imbuing the work with a truly organic character. The composition will be broadcast on Audiotopie’s custom-made ESSAIM system, consisting of eight autonomous speakers.  Co-presented by MUTEK and Suoni Per Il Popolo"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Akousma + Audiotopie present Léa Boudreau and Nancy Tobin"
      }
    ]
  },
