    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Lurching with synthetic grooves, Ben Shemie ’s lo-fi psychedelic textures careen across genres boundaries, producing pop music at the outer edges of harmony. There’s a sense of enormous potential in his avant-garde, cavernous rhythms - songs that are unpredictable yet strangely familiar."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Ben Shemie"
      }
    ]
