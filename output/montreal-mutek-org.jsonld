    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Closing out MUTEK in euphoric style on Sunday night, Auflassen introduces the almost-jazz sound of their first album to the city, complete with improvised flourishes and the kind of unique elements that can only be experienced in a live performance."
      }
