    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "After studying Music Composition at CalArts with Leonard Stein, Morton Subotnick, Mel Powell, and Morton Feldman, Zack Settel became interested in the use of technology in music production/performance and moved to Paris with a scholarship at IRCAM."
      }
    ],
