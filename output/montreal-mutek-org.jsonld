  {
    "@id": "https://montreal.mutek.org/temporary/ef14715e-2989-4013-8495-c56ade51a7c2",
    "@type": [
      "http://schema.org/Person"
    ],
    "http://schema.org/image": [
      {
        "@id": "_:g7713240"
      }
    ],
