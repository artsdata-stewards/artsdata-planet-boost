    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "In experimental textures and sustained drones, Drew McDowall embarks on meditative travels, taking listeners into states of deep listening in his existential compositions, now joined by Florence To's emotionally intoxicating visual art."
