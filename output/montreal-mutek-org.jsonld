  {
    "@id": "https://montreal.mutek.org/temporary/7855a506-3cb0-4fc1-aaee-5b20a5aa3606",
    "@type": [
      "http://schema.org/Person"
    ],
    "http://schema.org/image": [
      {
        "@id": "_:g13261380"
      }
    ],
    "http://schema.org/mainEntityOfPage": [
      {
        "@id": "https://montreal.mutek.org/en/artists/dettinger"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://montreal.mutek.org/en/artists/dettinger"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/dettinger"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Olaf Dettinger is slightly different from his Kompakt counterparts. He shows little concern for dance floor energy, and his meticulous work can be described as ambient, or “economical”, in the words of Frank Bretschneider. He performs extended pieces woven with organic sound, and his compositions hang off heavy tempos and induce a dream-like state. Pioneer of an ultra-modern wave of young German musicians, he pushes the melodic as much as the provocative uses of the computer, and is one of the few musicians able to reconcile romance and technique with the ease of a poet."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Dettinger"
      }
    ]
  },
