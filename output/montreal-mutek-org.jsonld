    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "David Turgeon, founder of the No Type label, is dedicated to multiple musical explorations within numerous genres: improvisation, electronica, noise and musique actuelle. Under the name Camp, he seeks 'new approaches to sound organization, delving into techniques such as improvisational architecture and vague composition, devising a well defined framework of ethics concerning appropriation and a kind of filter for politics in arts along the way.'"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Camp"
      }
    ]
