    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Ouri —  D.C Live Trial Live A/V  Ouri fuses classical training with electronic grit in a performance that feels both intimate and cinematic. Drawing from Frame of a Fauna, she crafts dense, emotional landscapes where cello, synths, and whispered vocals collide. For this concert, Charline Dally ’s visuals will echo Ouri’s soundworld, guiding the audience through an immersive audiovisual experience."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Ouri"
      }
    ]
  },
