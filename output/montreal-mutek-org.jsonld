      }
    ]
  },
  {
    "@id": "https://montreal.mutek.org/temporary/dbf92cb9-b85c-4427-92b6-ddc4571253d6",
    "@type": [
      "http://schema.org/Person"
    ],
    "http://schema.org/image": [
      {
        "@id": "_:g7811880"
      }
    ],
    "http://schema.org/mainEntityOfPage": [
      {
        "@id": "https://montreal.mutek.org/en/artists/digitaline"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://montreal.mutek.org/en/artists/digitaline"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/digitaline"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "[CANADIAN DEBUT] Digitaline belong to the new school of Swiss techno producers who have flourished in the last three years around the mighty Cadenza label, headed by minimal house prodigy Luciano. Digitaline is a duo of young producers Gregory Poncet, who also records as Gregorythme, and Laurent Bovey, who also records as Laps. As Digitaline they specialize in the dark, moody minimal club-geared techno that has swept across Europe in the last year. So far, they have two releases to their name, the latest being a vinyl-only double-EP Anticlockwise that was released on Cadenza this past spring.This MUTEK appearance highlights the festival's allegiance to new, cutting-edge talent."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Digitaline"
      }
    ]
  },
