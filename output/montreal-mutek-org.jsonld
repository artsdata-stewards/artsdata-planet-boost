    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "François Quévillon CA/QC — Photosynthèse Photosynthèse is a lenticular print featuring an undulating forest made up of millions of particles. François Quévillon CA/QC — Mouvant Mouvant is a lenticular print that condenses four years on the road."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "François Quévillon"
      }
    ]
