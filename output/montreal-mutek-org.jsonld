    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "hellothisisalex is an electronic duo from Ontario made up of Mark Prier and Melissa Creasey. Half grounded in '70s psychedelic pop and half in modern electronica, their music is a sonic adventure of experimentation and exploration, filled with raw analogue synths and otherworldly noises carried by melodic bass lines."
      }
    ],
    "http://schema.org/name": [
