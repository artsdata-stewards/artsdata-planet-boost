      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/hecker"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Florian Hecker approaches the composition of electronic music as an exercise in empirical research on sound. Eschewing sampling or MIDI controls, the German artist's compositions are essentially based on the study and genetic manipulation of sound. His latest opus, ‚ÄòSun Pandämonium', is a penetrating and destabilizing work executed with mastery and described by one critic as 'one of the most beautiful pieces of unpleasant music ever heard.' As a result, his efforts have garnered him reward and attention this year, namely the Prix Ars Electronica. Hecker also runs the fals.ch internet site, which offers a diverse collection of unreleased works by numerous contemporary composers."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Hecker"
      }
    ]
  },
