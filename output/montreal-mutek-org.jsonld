      }
    ],
    "http://schema.org/mainEntityOfPage": [
      {
        "@id": "https://montreal.mutek.org/en/artists/junction-sm"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://montreal.mutek.org/en/artists/junction-sm"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/junction-sm"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "[Canadian Debut] Crossing Dandy Jack and Sonja Moonear forms the supreme combo known as Junction SM. Their union yielded Los Siete Castigos, a voluptuously minimal album in which they play with Latino sounds and funky house, concocting a sound both elegant and sharp.The essence of Junction SM combines the rhythmic constructions of Dandy Jack with the musical selections of Sonja, permitting the pair to cultivate a style that is persistently renewed—rendering each of their performances unique."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Junction SM"
      }
    ]
  },
