      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Ida Toninato & Pierre-Luc Lecours — Homeostasis Live A/V | World Premiere  In Homeostasis , baritone sax and modular synth intertwine beneath a dome of shifting light and real-time visuals. Ida Toninato and Pierre-Luc Lecours sculpt a vibrant system where sound and image continually rebalance, echoing nature’s rhythms. Their performance pulses with intensity—an immersive meditation on coexistence, ecology, and equilibrium."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Ida Toninato & Pierre-Luc Lecours"
      }
    ]
  },
  {
