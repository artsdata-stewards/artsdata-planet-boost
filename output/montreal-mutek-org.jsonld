      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://montreal.mutek.org/en/artists/felix-felix-gourd-gourd"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/felix-felix-gourd-gourd"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Blending abstract black-and-white geometrics with shots of bright colour and bodies in motion, Félix Félix Gourd Gourd's live visuals entwine their artistic, otherworldly tone into a range of music.  With a background in classical percussion at the Conservatoire de Musique de Montréal and a Fine Arts degree in digital arts, Gourd oscillates between synthesized music and visuals and design work. As an artist, he creates video, sound installations and sculpture that reflect culture and art in the digital age, looked at via light, reflexivity, transparency and depth. He's designed performance environments and live visuals for acts such as electro-pop duo Milk & Bone, Blaise Émard, Simon Chioini, Cri, major pop acts like Britney Spears and Selena Gomez, and Montréal hip hop acts Dead Obies and Loud Lary Adjust."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Félix Félix Gourd Gourd"
      }
    ]
  },
