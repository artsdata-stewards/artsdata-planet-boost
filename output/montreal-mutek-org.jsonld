    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "As Hauschka, a project that has issued three critically acclaimed albums since 2005, he manipulates the workings of a piano in order to deliver a haunting, not-quite-classical rendition of what it means to pull melody from the solo piano in the 21st century."
      }
    ],
    "http://schema.org/name": [
