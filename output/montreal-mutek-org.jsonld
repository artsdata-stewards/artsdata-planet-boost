    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Japanese musician, sound designer and producer Yosi Horikawa finds rhythm in seemingly everything, from kitchen utensils to random birdsong, weaving in more DIY sound concoctions to create music that compels while confounding, ultimately absorbing listeners in its eclectic, maximalist joy."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Yosi Horikawa"
      }
