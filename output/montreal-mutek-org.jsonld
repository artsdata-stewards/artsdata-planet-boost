    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/marshmallow-laser-feast"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Marshmallow Laser Feast  UK — EVOLVER: Prologue  EVOLVER: Prologue is a VR journey through the inner rhythms of the human body, and an immersive new work directed by Marshmallow Laser Feast , with music by Jonny Greenwood and Elliot Cole featuring Roomful of Teeth . Sponsored by Orange, the piece is a prologue to EVOLVER , a longer-form interactive experience that is a journey of self-discovery tracing the cardiovascular flow through the human body, featuring visuals modeled on medical data from digital-medicine pioneers Fraunhofer MEVIS ."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Marshmallow Laser Feast"
      }
    ]
  },
