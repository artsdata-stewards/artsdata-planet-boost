    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Loom was born in 2014 among a group of creative entrepreneurs from different origins with a great involvement in the cultural scene of Barcelona, and with the intention of marking a before and after within it. Loom Festival is an interdisciplinary art festival that combines performing arts, audiovisual installations, musical acts, technology, digital art and educational sessions in an interactive circuit, which places the art works and the audience on the same level. With the mission of impending change and representing a new generation of creatives, Loom works to promote values of inclusivity and diversity in its programming as well as promoting emerging and local talent through its network and now, its new initiative Loom Senses."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Loom Festival"
      }
    ]
  },
