    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Yan Breuleux  CA/QC — Les Planètes Entirely generated in real time, this immersive concert is based on the creation of a “light-piano” produced by Yan Breuleux . It allows for a visual dialogue with the performance of pianist Louise Bessette on a new interpretation of Les Planètes , a work by composer and conductor Walter Boudreau .  Presented by Hexagram"
      }
    ],
    "http://schema.org/name": [
