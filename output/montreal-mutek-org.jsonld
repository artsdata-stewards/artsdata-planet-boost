      {
        "@id": "https://montreal.mutek.org/en/artists/isabella-salas"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Born and raised in Mexico City, Isabella Salas moved to Montréal, Canada in 2001 to follow her major in Film Production at Concordia University , specializing in ways of seeing and experimental filmmaking. Her interdisciplinary artworks are grounded in artificial intelligence, video, synthesized sound and installation while taking into account neuroaesthetics properties of digital experiences. Her work has been presented at the SAT , MAPP MTL , Music Motion , MUTEK AI Art Lab , Immers(ed) UK , and has shows coming up in the fall 2020 at Gamma Festival (RU), TransArt Festival (IT), MUTEK Montréal , Polaris Music Awards 2020 and Never Apart ."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Isabella Salas"
      }
    ]
  },
