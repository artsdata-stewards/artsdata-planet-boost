      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Forging cosmic, frenetic techno and IDM creations out of the remains of the past, Priori 's productions are euphoric, layered, and organic all at once, Francis Latreille crafts unique dance music that pierces the veil of musical reality and opens up open up new spaces. In wildly kinetic and colourful projection mapping, video, laser lighting and LED stage displays, BunBun concocts a visual carnival embedded in electronic music."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Priori & BunBun"
      }
    ]
  },
