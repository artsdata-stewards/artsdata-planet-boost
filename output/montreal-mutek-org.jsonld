      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Co-founder of the What.if record label, Dafoe aka Albert Romero has been an innovative member of the electronic scene in Barcelona for years. Developing his minimal and deep house sounds in the main clubs of the Catalan city such as Apolo / Nitsa Club, the DJ and producer will continue to enhance his local-global approach to contemporary electronic music at MUTEK.ES.  Dafoe perfoms at NOCTURNE 3 at NItsa ´s main floor on Saturday March 7."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Dafoe"
      }
