      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Anna Ridler is an artist and researcher. She has exhibited at institutions such as the V&A Museum, Ars Electronica, HeK Basel, Impakt and the Barbican Centre and has degrees from the Royal College of Art, Oxford University and University of Arts London. She was a 2018 EMAP fellow and was listed by Artnet as one of nine “pioneering artists” exploring AI’s creative potential. She is interested in working with self-generated data sets to create new and unusual narratives in a variety of mediums, and what happens when things cannot fit into discrete categories."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Anna Ridler"
      }
    ]
  },
