    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "RAMzi Live | World Premiere     RAMZi returns with a shapeshifting set of lush soundscapes and hybrid rhythms, channeling her forest-dwelling alter ego. Drawing from her latest work on FATi Records, Phoebé Guillemot conjures a dreamy ecosystem where nostalgia and futurism blend through dub textures, acoustic traces, and surreal electronic mutations."
      }
    ],
    "http://schema.org/name": [
