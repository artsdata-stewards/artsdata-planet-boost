    "http://ogp.me/ns#image:alt": [
      {
        "@language": "en",
        "@value": "A person with long, vibrant pink braids, Tati au Miel, stands in a nocturnal outdoor setting, looking towards a large leafless tree under a dark sky. Next to the tree, there's a cow with distinctive white and black patterns and long, curved horns, seemingly grazing. The scene is illuminated with a flash, casting shadows and giving the photograph a surreal, almost staged appearance. The person is dressed in white, contrasting with the surrounding darkness."
      }
