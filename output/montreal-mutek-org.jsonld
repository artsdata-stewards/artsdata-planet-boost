    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "As the portmanteau suggests, Sammy Halimi ’s Aquaventure project descends somewhere deep and lush: trippy broken beats resonate as if they’re ringing out in subterranean ecosystems, and minimalist dub grooves slither like luminescent sea creatures on the ocean floor. Halim i’s musical incantations seem attuned to an otherworldly wavelength, allowing him to incorporate the legacies of house and IDM into the emotional fabric of his pulsating compositions and live sets."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Aquaventure"
      }
    ]
  },
