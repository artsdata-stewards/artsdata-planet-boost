      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Located in the famous Parc del Fòrum, Bus Terraza was one of the first places to open after the confinement. In a few weeks, its bold and fresh proposal of live music, Mediterranean-style tapas and outdoor drinks made everyone in Barcelona start talking about this outdoor space as the new trendy place to enjoy evenings and weekends. In addition, its daily program of djs, live music and incredible sea views are the icing on the cake of a terrace in Barcelona that lacks nothing."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Bus Terraza"
      }
    ]
  },
