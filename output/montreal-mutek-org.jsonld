      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Pole  DE – Tempus Live | North American Premiere  Pole will present Tempus , an exploration into the temporal depths of electronic sound. Pole's live performance will encapsulate the essence of memory and time, showcased through a distinct blend of ambient, dub, and experimental jazz. His approach — a refined balance of dense atmospherics and precise dub techniques — highlights a unique space where sound history and futuristic explorations converge."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Pole"
      }
    ]
  },
