  {
    "@id": "https://montreal.mutek.org/temporary/54a3283a-02dd-4a5d-8502-037b87611921",
    "@type": [
      "http://schema.org/Person"
    ],
    "http://schema.org/image": [
      {
        "@id": "_:g11303440"
      }
    ],
    "http://schema.org/mainEntityOfPage": [
      {
        "@id": "https://montreal.mutek.org/en/artists/tarta-relena"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://montreal.mutek.org/en/artists/tarta-relena"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/tarta-relena"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Onstage, Tarta Relena perform with a neat blend of technologies both modern and ancient. The two musicians flesh out different vocal techniques (flamenco, lyrical, traditional, jazz) with percussive patterns on a ceramic amphora outfitted with a contact mic. Every breath counts and every note is precisely deployed; the duo’s vast exploration of the possibilities of the voice supported by a fine-spun mesh of electronic touches.  Presented as part of the celebrations of the 25th anniversary of the Treaty of Cooperation between Catalonia and Québec with support from Institut Ramon Llull"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Tarta Relena"
      }
    ]
  },
