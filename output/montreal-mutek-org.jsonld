        "@value": "upsammy & Valentina Magaletti Live | North-American Premiere  Bringing together a shared instinct for exploration, Valentina  Magaletti and upsammy sculpt…"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://medias.mutek.org/artists/_1200x630_crop_center-center_82_none/5-unsound-2024_CLASH_upsammy-Valentina-Magaletti_ph_helena_majewska_3666-1024x683.jpg?mtime=1745938926"
