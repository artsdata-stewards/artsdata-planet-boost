    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Richie Hawtin, raised in Windsor, Ontario, currently based in Berlin, has become a central figure in that city's techno culture, first came to fame in the early '90s for his work as Plastikman, which fused elements of acid with an emerging minimalist style which has continued to be his defining hallmark."
      }
    ],
    "http://schema.org/name": [
