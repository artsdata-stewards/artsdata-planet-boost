    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Over the past two decades, the prolific producer, DJ, label head has made a career of synthesizing techno, classic house and ambient music into lush, timeless harmonies and taut, meticulously engineered grooves—demonstrating a deep devotion to Detroit, Europe, and a desire to strive for what’s next."
      }
