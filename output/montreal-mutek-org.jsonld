      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/jacques-greene-1"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Jacques Greene has laid out a promising template for an energetic blend of UK garage and affected female vocals within the kind emo-dubstep terrain first staked out by Burial and later pursued by labels like Hessle Audio and acts like Pangaea and Ramadanman. Along with other LuckyMe acolytes such as Lunice and Ango – with whom the producer also shared the stage at Red Bull Music Academy events – Greene belongs to a generation of Montreal electronic musicians who has looked right past techno to hip-hop and the UK for influences."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Jacques Greene"
      }
    ]
  },
