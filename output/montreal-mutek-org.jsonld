      {
        "@id": "https://montreal.mutek.org/en/artists/andree-martin"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/andree-martin"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Andrée Martin  CA/QC — Kalos eîdos skopeîn  Kalos eîdos skopeîn , or “the beauty of images viewed”, is an immersive and danced work that aims to engage performers and spectators in a transpersonal experience. Enveloped by kaleidoscopic projections of nature-inspired images, the work suggests a nearly stationary journey through a single space-time. Through this poetic and sensorial journey, the project attempts to collect psychophysiological data from participants—sweating, heart rate, and so on—in order to shed light on the nature of this lived experience.  Presented by Hexagram"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Andrée Martin"
      }
    ]
  },
