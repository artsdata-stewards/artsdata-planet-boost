  {
    "@id": "https://montreal.mutek.org/temporary/8fadea60-9ea6-4482-839e-067a33f9a2d7",
    "@type": [
      "http://schema.org/Person"
    ],
    "http://schema.org/image": [
      {
        "@id": "_:g5072660"
      }
    ],
    "http://schema.org/mainEntityOfPage": [
      {
        "@id": "https://montreal.mutek.org/en/artists/gabber-modus-operandi"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://montreal.mutek.org/en/artists/gabber-modus-operandi"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/gabber-modus-operandi"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "For their first ever MUTEK, Gabber Modus Operandi bring their frantic, exuberant diasporic sound to Montréal, connecting the dots between the explosive energy of noise music with the syncopated rhythms of the rave world. Performing in homemade costumes with a DIY attitude that feels firmly planted in their punk days of past, Gabber Modus Operandi is a fever dream of percussive power; a shining example of what the future of Bali club culture could become."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Gabber Modus Operandi"
      }
    ]
  },
