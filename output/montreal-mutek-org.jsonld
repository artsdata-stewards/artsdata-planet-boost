    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "This summer, Linell plays Colombia's BAUM and Portugal's Waking Life festivals as well as Berlin's Freqs Of Nature, dedicated to strange and beautiful art and music. By summer's end at MUTEK, he'll divulge his latest sonic musings in a live set of chasmic techno experimentation."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Anthony Linell"
      }
    ]
  },
