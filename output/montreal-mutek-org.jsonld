    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Chris Salter & Alexandre Saunier - SNN#3: Forms of the Living Chris Salter and Alexandre Saunier 's previous collaborations include SNN #0: Totem , a LED light display responding to machine learning and part of the AI: More Than Human exhibition at London's Barbican Centre in 2019; SNN #1: The Speed of Thought Itself , an audiovisual performance at the IMPAKT festival in Utrecht in 2019; and SNN #2: Light/Space/Modulator at the Barcelona BCN_LLUM light festival in 2020."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
