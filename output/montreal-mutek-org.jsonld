    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Mike Shannon  CA/DE Live  Mike Shannon 's performance at MUTEK Montréal promises a riveting exploration of deep techno through a sophisticated array of modular synthesis and drum machines. Embodying the essence of Detroit and Chicago influences, Shannon crafts a unique sonic signature that defines Canadian minimal house/techno. His commitment to live improvisation and his role as a curator of Cynosure Recordings highlight his influential contributions to the genre."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Mike Shannon"
      }
    ]
  },
