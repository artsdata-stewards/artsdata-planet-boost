    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "MUTEK's International Network will join forces once more to celebrate from the 3rd to the 8th of May 2021 the 12th edition of MUTEK Barcelona and the 4th edition of MUTEK Argentina. It will be a joint and hybrid edition, that will include performances and activities at emblematic places of Barcelona and Buenos Aires, as well as exhibitions throughout the platform virtual.mutek.org. In addition, the festival will have the collaboration of other MUTEK cities, as well as other related festivals, thanks to the MUTEK Connect program.  / + info ➤ bit.ly/3mDzWsU / access ➤ virtual.mutek.org"
      }
    ],
    "http://schema.org/inLanguage": [
      {
