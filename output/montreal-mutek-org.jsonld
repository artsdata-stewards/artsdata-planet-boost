    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Alexis Langevin-Tétrault — REPLIKAS Live A/V | World Premiere  In REPLIKAS , Alexis Langevin-Tétrault builds a glowing metallic totem live on stage, conducting sound and light with visceral precision. Using body sensors and machine learning, he crafts a dramatic arc from somber drones to pulsing luminosity—a ritual of grief and resilience where technology channels the spiritual and the unseen."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Alexis Langevin-Tétrault"
      }
    ]
  },
