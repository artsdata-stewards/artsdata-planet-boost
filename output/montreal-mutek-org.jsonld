    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Crafted out of sampled obsolete technologies, newly recorded harmonized vocals and ever-intensifying distortion, Joni Void 's music is both an uncanny leap through space and time and a precise window into the peculiar beauty of an artist's personal world."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Joni Void & Sonya Stefan"
