      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The Aufhebung project seeks to dismantle the traditional relationship between public and performer through an electronic/electroacoustic lens, and within the infrastructures afforded by modern music venues. Preferring to be situated among the audience rather than on stage, T. Gowdy will mix 8 channels of surround sound through the main PA speakers, as well as a series of monitor wedges encircling the audience; in doing so, Gowdy manipulated the entire context of his live performance."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "T. Gowdy"
      }
    ]
  },
