    ]
  },
  {
    "@id": "https://montreal.mutek.org/temporary/8cce9cdb-4e8c-4429-9b1d-ffac11e987ad",
    "@type": [
      "http://schema.org/Person"
    ],
    "http://schema.org/image": [
