      }
    ],
    "http://schema.org/mainEntityOfPage": [
      {
        "@id": "https://montreal.mutek.org/en/artists/steve-roy"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://montreal.mutek.org/en/artists/steve-roy"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/steve-roy"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Having discovered electronic music only recently, Steve Roy has accumulated-in very little time-a vast amount of knowledge and experience, judging by the musical works he produces today. Moulding minimalist rhythms and combining them with recognizable, everyday sounds, he uses computational methods in order to compose works of striking conceptual clarity. Together with Chris McNamara, Steve is concocting new material that strikes a balance between structured dance music and abstract soundscapes."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Steve Roy"
      }
    ]
  },
