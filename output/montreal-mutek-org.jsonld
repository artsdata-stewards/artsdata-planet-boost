      {
        "@id": "https://montreal.mutek.org/en/artists/stein"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The personal history of Albert Fontanals, aka Stein, is typical of any DJ that pursues his passion, after many years as a raver / clubber, he was motivated to be on the other side of the booth from time to time and express everything he has learned in terms of musical knowledge, in the happiest time of his life, that still continues. His musical influences range from Detroit techno to Rephlex and the UK sound of the 90's and 00's to Dubstep and Post Dubstep, the German and American house scene, as well as modern experimental electronics.  Stein opens the Nocturne 2 program at Nitsa on Friday night."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Stein"
      }
    ]
  },
