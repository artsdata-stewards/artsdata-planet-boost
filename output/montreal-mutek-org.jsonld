    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "In 2017, she jumped into the Barcelona theatre scene, creating soundtracks and ambient landscapes for more than twenty projects in less than three years. As a composer for performing arts, sound designer and live performer, she creates soundscapes that blend electronics and sampled elements with orchestral arrangements."
      }
    ],
