    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/danieto"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Daniel Nieto is one of the discoveries made by the MUTEK team during the first edition of the MUTEK.CL festival in Valparaiso in January 2004. Tireless experimenter of sound and textures, this young and promising artist produces a brand of music both ambient and atmospheric, through subtle mixes and contrasts of both harmonies and infinitesimally strange sounds. Created via synthetic algorithms and his individualized sonorous effects, his compositions combine dubby rhythms, 'IDM' melodies, high-tech constructions, soft and warm electronic textures, and harder beats for a very personal and triumphant finished product. Daniel Nieto is also part of the Skipsapiens duo, which will figure later in the program."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Danieto"
      }
    ]
  },
