    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "YlangYlang  CA/QC  Inspired by the release of Cycles & Decay , orchestral opus with a well-defined jazz sound and featuring recording sessions from guest musicians, YlangYlang will showcase her reflexions on death and rebirth on the Parterre du Quartier des spectacles on Sunday, August 29."
      }
    ],
    "http://schema.org/name": [
      {
