    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "From a close-up imagination of the land before humans, to flying over a future Hong Kong, and including scenes of contemporary Hong Kong, the experience is organised in seven scenes that explore different configurations of the temporal and scale axes."
      }
    ],
    "http://schema.org/name": [
