  {
    "@id": "https://montreal.mutek.org/temporary/9361a13e-66db-435a-8d30-f05407ca8a5e",
    "@type": [
      "http://schema.org/Person"
    ],
    "http://schema.org/image": [
      {
        "@id": "_:g9917260"
      }
    ],
    "http://schema.org/mainEntityOfPage": [
      {
        "@id": "https://montreal.mutek.org/en/artists/fax"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://montreal.mutek.org/en/artists/fax"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/fax"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Canadian debut! Performed live, the music of Rubén Tamayo (Fax) constitutes a collection of rhythmic motifs, muffled reverberations, and upbeat melodies accentuated by streaming waves of electronic dub currents. A partner with Murcof in the Static label based in Tijuana-he's also produced many of the graphic designs for Static releases as well as Murcof's various releases on the British-based Leaf label-Tamayo was introduced to and highly appreciated by the MUTEK team during the MUTEK tour in Mexico in the fall of 2003. Consequently, it is with great pleasure that we welcome one of the most promising and captivating of this new wave of Latin American composers."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Fax"
      }
    ]
  },
