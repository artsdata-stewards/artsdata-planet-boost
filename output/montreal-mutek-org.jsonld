    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Alexis Langevin-Tétrault — REPLIKAS Live A/V | World Premiere  In REPLIKAS , Alexis Langevin-Tétrault builds a glowing metallic totem live on stage,…"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
