      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "In 2005 they released their debut album, On Another Level, after which they set off across the globe to perform their thrilling and effective live sets.Together, Gerald Mitchell, Santiago Salazar (aka DJ S2), Esteban Adame and Dan Caballero (aka DJ Dex) form a diverse group of complex personalities that perform live mixing together turntables, percussion, synthesizers and other machines, creating a music that combines classic techniques with electronic innovations and even touches of salsa."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Los Hermanos"
      }
    ]
  },
