    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Becoming a MUTEK volunteer means discovering the backstage of one of the most important Montreal festivals and contributing to its success while enjoying the programming. If you are as passionate about electronic music as you are about digital creation and if you are eager to meet new people, then join our team!"
      }
