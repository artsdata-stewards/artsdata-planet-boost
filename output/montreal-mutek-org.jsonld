      {
        "@id": "https://montreal.mutek.org/en/artists/matthew-cardinal-stephanie-kuse"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Matthew Cardinal & Stephanie Kuse  CA — Asterisms World Premiere For MUTEK, amiskwaciy (Edmonton) -based musician, composer, and sound designer, Matthew Cardinal recreates his debut album Asterisms live, accompanied by projections created for the project by media artist Stephanie Kuse . Asterisms contemplates emotional textures with constellations of synthesizers dancing around atmospheric themes and rhythmic accents. The visual component features softly distorted natural textures, hypnotic motion and vibrant synthetic colours. The pairing of Cardinal ’s meditative audio journal entries with Kuse ’s sparkling visuals results in an enveloping and otherworldly A/V experience."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Matthew Cardinal & Stephanie Kuse"
      }
    ]
  },
