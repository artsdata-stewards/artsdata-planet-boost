      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Durante los últimos 10 años la presencia de Manrico Montero en el amplio y diversificado circuito de la experimentación electrónica en México lo colocan como uno de los eslabones centrales en la historia reciente del rubro, pues abordó por igual las delirantes derivaciones del break beat en la cultura de club, así como las sutilezas teórico-prácticas de la microfonía, el paisaje sonoro y la fonografía."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Manrico Montero"
      }
    ]
  },
