      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/pictoplasma"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "PICTOPLASMA presents BEST OF CHARACTERS IN MOTION Since 1999, Pictoplasma's goal is to free graphical character representation from commercial intentions and the popular psychology of story telling, while linking a new breed of character design to the birth of a language beyond all cultural boundaries.Besides publishing books and DVD's on the topic, organising the biannual Pictoplasma Conference and curating international exhibitions, Pictoplasma hosts the annual Characters in Motion Animation Festival in Berlin, focusing on stylish and surprising character design re-claiming the world of animation. For the MUTEK Festival, Pictoplasma has specially put together a Best of Characters in Motion, which will offer a unique overview of outstanding international music visuals, short films and motion graphics. This one hour screening will be presented at the beginning of the NOCTURNE 1 program."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Pictoplasma"
      }
    ]
  },
