    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "His expressive patterns, motions and textures amount to multilayered ambience of disconcerting beauty. At once crowded and desolate, unhurried but also unsettled, his sonic architecture is a morning-after remedy of sluggish synth pads and furtively moving melodies."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Huerco S"
      }
    ]
