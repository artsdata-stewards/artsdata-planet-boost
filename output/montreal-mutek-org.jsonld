      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Born in 1977, the year punk exploded, Philipp Quehenberger is a youthful but weathered traveler of the underground Austrian scene. Isolated from centers of activity for many years, he remained relatively invisible to the public eye until he decided to settle in Vienna, thus kick-starting a new era in his career. He is a born performer, with a background in classical piano and an innate sense of the stage. With his modern, raucous sound that draws on rock energy tinged with a sly hint of derision, he seduces immediately."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Philipp Quehenberger"
      }
    ]
  },
