    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/thisquietarmy-x-philippe-leonard"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Thisquietarmy x Philippe Léonard  CA/QC - MSC ZOE 01.01.2019 World premiere With MSCZOE-01.01.2019 , Thisquietarmy x Philippe Léonard A/V duo pushes the concept of an enlarged cinema even further to recreate the scale of the maritime disaster of the MSC Zoe, which resulted in the loss of 290 containers at sea, swapping analog hardware for modern, minimal digital technology. For this work as immersive as it is post-apocalyptic, Leonard works with digital controllers and software from VJ-ing, while Thisquietarmy trades his guitars and amplifiers for more synthetic kosmische electronic drones and off-techno industrial rhythms pulsed from 'recorded samples.  In collaboration with Suoni Per Il Popolo"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Thisquietarmy x Philippe Léonard"
      }
    ]
  },
