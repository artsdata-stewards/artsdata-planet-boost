        "@language": "en",
        "@value": "In multi-textured layers of tape machine processing, tweaked filters and delay, Matt Karmil merges looped obscure samples, smoothed static, heavy pulses and strangely comforting grooves into his distinctly varied concept of minimal house."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Matt Karmil"
      }
    ]
  },
