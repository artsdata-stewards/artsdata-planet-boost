    "http://ogp.me/ns#image:alt": [
      {
        "@language": "en",
        "@value": "A dynamic electronic music performance captured on stage with vibrant lighting and visual effects. The scene includes three musicians equipped with electronic instruments and modular synths. They are surrounded by LED panels and crisscrossing beams of blue light, enhancing the atmospheric, immersive experience for the audience. The background features a vividly textured, blue-toned visual projection, adding a surreal ambiance to the setting."
      }
