      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Alex Guevara is a digital artist born in Lima, Peru in 1986, currently living in Berlin. He works in a wide range of fields including digital art, interaction design, data visualization, generative design, interactive installations, and real-time music visualization—combining art, science, and technology to create immersive experiences and stunning landscapes. His work has been presented in international festivals and exhibitions all over the world."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Alex Guevara"
      }
    ]
  },
