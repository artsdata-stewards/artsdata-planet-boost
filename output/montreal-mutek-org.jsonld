    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/martux-m"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Always seeking an innovative aesthetic, original channels of creative expression, and new approaches to media relationships, the work of Maurizio Martusciello, aka Martux_M, is characterized by persistent experimentation with the capabilities of digital technology. Solo or with the help of his peers (see also his other artist write-up for his performance at Ex-centris 2), he creates hybrid spaces uniting audio and visual material, silences, aspects of colour, and traces of unfamiliar memories."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Martux_M"
      }
    ]
  },
