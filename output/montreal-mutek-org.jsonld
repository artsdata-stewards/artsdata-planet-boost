    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "This crew of artists and DJ's produced radio shows, events and were globally recognized for their suberb selection of music -- the San Francisco Examiner noted Eyephunk as 'leaders in the electronic music community and at the forefront of emerging music trends.' Eyephunk was one of the main suppliers of electronic music for eMusic who were delivering mp3's online before the bigger revolution of digital downloads and music estores had been established."
      }
    ],
    "http://schema.org/name": [
      {
