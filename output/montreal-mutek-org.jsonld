    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "As borders open up once more, and thanks to the first collaboration with Air Canada as the official festival transporter of MUTEK 2021, we invite our community’s authorized travellers to fly to Montreal and (re)live the unique experience of a festival in full reopening."
      }
