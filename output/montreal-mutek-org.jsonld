    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Argentina's Juan Self's immersion in electronic music has produced a warm and enveloping version of house music, demonstrating what seems like an innate Latin understanding of fiesta. His arrival in Quebec has helped him to develop his creativity: having survived the shivers and shocks of a Montreal winter, Self turns up the heat in this Latin-inspired rhythmic performance."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Juan Self"
      }
    ]
