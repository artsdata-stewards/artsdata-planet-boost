    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "International festival of digital creativity and electronic music in Montréal. MUTEK Montréal 2026 (27th edition) takes place August 25–30 with six days of audiovisual performances, live electronic music and digital art in the Quartier des spectacles."
      }
