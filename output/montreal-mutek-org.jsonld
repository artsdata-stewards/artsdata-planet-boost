      {
        "@id": "https://montreal.mutek.org/en/artists/george-hurd"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Echolocation When San Francisco-based electro-acoustic composer George Hurd began work on Echolocation , he was looking for a way to interpret the emotions and experiences gleaned from extensive travels across the globe, both for work and for pleasure. The end result is a musical representation of a location that is both artistic and literal, bringing the place itself into the music.\" Hurd translated these ideas and inspirations into a project that was too big to be contained on one record or a single performance. He plans to leave the USA imminently for a move to Europe, so the project has taken on even more personal resonance for Hurd, who will use these artistic reflections as a way to say goodbye to the places he has loved and called home for so many years."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "George Hurd"
      }
    ]
  },
