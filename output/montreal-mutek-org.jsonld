      {
        "@id": "https://montreal.mutek.org/en/artists/felix-kubin"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://montreal.mutek.org/en/artists/felix-kubin"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://montreal.mutek.org/en/artists/felix-kubin"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Prepare to be amazed as Dadaist and pop provocateur Felix Kubin takes the stage. A trained musician, he mixes influences like swing, exotica, disco, '70s pop, noise and electroacoustic exploration, adding a pinch of '50s science fiction (from the kinds of movies that would have you believe that Planet Earth is overrun by aliens) to create a uniquely deviant outcome. Ignoring traditional rules of performance, he transmits his twisted contents to the audience in an ironically common format. It makes you realize he's having just as much fun as you are."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Felix Kubin"
      }
    ]
  },
