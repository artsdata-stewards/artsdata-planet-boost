      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Sound artist Duul_Drv (aka S. Arden Hill) explores organic beauty in digital music. Using a PC and lo-tech software, he presents slow, abstract compositions that delve into the original sound source while giving space to surrounding sounds. He aims to achieve an aesthetic that reminds listeners of a naturally occurring context, despite the use of digital tools."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Duul_Drv"
      }
    ]
  },
