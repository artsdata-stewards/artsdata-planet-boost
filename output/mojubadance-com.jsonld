  {
    "@id": "https://www.mojubadance.com/event-details/culture-and-crafts-2022-02-05-12-00",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Culture and Crafts  | Mojuba! Dance"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Weekly during Black History Month! Create and make awesome cultural minded crafts with the help of an expert and enjoy refreshments, music, and community"
      }
    ],
