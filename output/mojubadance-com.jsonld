  {
    "@id": "https://www.mojubadance.com/event-details/mojuba-black-history-month-celebration",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Mojuba! Black History Month Celebration | Mojuba! Dance"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "<p>February 27th at 7pm Mojuba! Dance Collective will host a virtual Black History Month program which celebrates the triumphs and acknowledges the trials of the Black community through dance and song.</p>\n<p></p>\n<p>The Mojuba! Black History Month Celebration will be a collection of some of the works danced by our community dancers over the years during our &#34;#NeverForget&#34; and &#34;How I Got Over&#34; productions.  These productions have united community members all over the city of Cleveland and inner suburbs to share the stories and experiences of the not so distant past.  Black history is American History.</p>\n<p></p>\n<p>Join us virtually on our Facebook page or Youtube by searching and subscribing to Mojuba Dance Collective</p>"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://static.wixstatic.com/media/8329a1_e6b79fc2086c4266adb51f389bca549a~mv2.jpg/v1/fill/w_3965,h_2964,al_c,q_90/8329a1_e6b79fc2086c4266adb51f389bca549a~mv2.jpg"
