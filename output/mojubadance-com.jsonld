  {
    "@id": "https://www.mojubadance.com/event-details/super-class-and-bantaba-1-1",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Super Class and Bantaba (1) | Mojuba! Dance"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Join us for an uplifting afternoon of dance, drum, and healing. FREE!  Must register to attend.\n\n11p        Mojuba! Breathe w/ Errin Weaver\n11:30p   Mini Drum Class w/Assane M'Baye\n12p       Trinidad & Tobago w/ Kieron Sargeant\n1:30p     Bantaba/Drum Circle\n2p         Sacred Closing"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://static.wixstatic.com/media/8329a1_5af543115bd842f490c73c6c5f26bcde~mv2.jpg/v1/fill/w_1545,h_2000,al_c,q_90/8329a1_5af543115bd842f490c73c6c5f26bcde~mv2.jpg"
