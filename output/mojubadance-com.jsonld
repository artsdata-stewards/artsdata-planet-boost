    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Where the Light Enters - Benefit Concert | Mojuba! Dance"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Join us for a highly anticipated evening of movement, passion, and power as Mojuba! Dance Collective presents our benefit concert \"Where the Light Enters.\" This captivating evening work will illuminate the stage on August 17th at Karamu House."
      }
    ],
