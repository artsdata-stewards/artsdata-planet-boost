    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "What happens when we trace the lines connecting Black theatre-making across the US-Canada border?  Conversations Across Borders  brings together leading artists, scholars, and cultural leaders for a day of dialogue exploring the shared histories, distinct realities, and future possibilities of Black"
      }
