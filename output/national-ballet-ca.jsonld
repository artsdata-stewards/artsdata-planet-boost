    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Renowned storyteller Val Caniparoli makes his debut with The National Ballet of Canada in a brilliant reimagining of Coppélia, bringing a fresh perspective and visual splendour to a beloved family production from the legacy repertoire."
      }
    ],
    "http://ogp.me/ns#image": [
