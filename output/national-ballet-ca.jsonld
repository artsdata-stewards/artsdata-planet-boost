    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Winter's Tale"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><strong>Choreography: Christopher Wheeldon</strong></p>\n<p>From the acclaimed creators of&nbsp;<em>Alice’s Adventures in Wonderland </em>comes a tale of two kingdoms fractured by jealousy and reconciled in love. Choreographer Christopher Wheeldon’s&nbsp;<em>The Winter’s Tale</em> brings Shakespeare’s play to life with exceptional clarity and power.</p>\n<p><em>The Winter's Tale</em> is presented by<br><br><img src=\"/media/hsckmlog/nb2526_audi_rings_black_60.png?rmode=max&amp;width=106&amp;height=60\" alt=\"Audi\" width=\"106\" height=\"60\"></p>"
      }
    ],
