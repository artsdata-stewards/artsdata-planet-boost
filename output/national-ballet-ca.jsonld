    ]
  },
  {
    "@id": "https://national.ballet.ca/productions/echoes-of-stravinsky/",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Stravinsky Triple Bill | February 26–March 4, 2027 at The National Ballet of Canada"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "National Ballet of Canada"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://national.ballet.ca/productions/echoes-of-stravinsky/"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "The visionary music of Igor Stravinsky anchors a triple bill that includes special collaborations with Canada’s National Ballet School and Ballet BC. The programme features Christopher Wheeldon’s Scènes de Ballet, George Balanchine’s Stravinsky Violin Concerto and Medhi Walerski’s Chamber. "
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://national.ballet.ca/media/2winoeb4/nb2627_website_productionheaders_desktop_2200x1088_echoesofstravinsky.jpg"
      }
    ],
    "http://ogp.me/ns#image:alt": [
      {
        "@language": "en",
        "@value": "Sonia Rodriguez and Nehemiah Kish in Stravinsky Violin Concerto (2004)."
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://national.ballet.ca/productions/echoes-of-stravinsky/"
      }
    ]
