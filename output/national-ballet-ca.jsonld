    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><strong>Choreography: Bobbi Jene Smith and Or Schraiber</strong></p>\n<p>In one of the most highly anticipated dance events of the season, visionary choreographers Bobbi Jene Smith and Or Schraiber unveil their first collaboration with The National Ballet of Canada,&nbsp;<em>Procession</em>, a groundbreaking work showing a bold new side of the company’s artistry.</p>"
      }
    ],
