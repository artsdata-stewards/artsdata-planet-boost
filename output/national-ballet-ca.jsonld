        "@language": "en",
        "@value": "Anna Karenina"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<h3>Sold Out</h3>\n<p>An alluring new <em>Anna Karenina</em> has its North American premiere in this first creative partnership with Christian Spuck. Exquisitely crafted with sumptuous costumes and cinematic projections, <em>Anna Karenina </em>adapts Leo Tolstoy’s great moral novel into an unforgettable theatrical experience.</p>\n<p><em>Anna Karenina</em> is presented by<br><br><img src=\"/media/hmed55wc/nb2425-devo-corporatepartnership-ig-private-wealth-management-b.png?rmode=max&amp;width=171&amp;height=40\" alt=\"\" width=\"171\" height=\"40\"></p>"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
