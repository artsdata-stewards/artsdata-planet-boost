    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Adieu"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Guillaume Côté bids “adieu” to The National Ballet of Canada by creating a new work and restaging his <em>Bolero</em>, celebrating his legacy as Principal Dancer and Choreographic Associate. Two additional world premieres from Canada’s Ethan Colangelo and Jennifer Archibald complete the programme.</p>"
      }
    ],
