      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "David Dawson unveils his first original creation for The National Ballet of Canada since being appointed Resident Choreographer by Artistic Director Hope Muir in 2025. Emotionally rich and physically demanding, The Beginning of Forever showcases the dancers at their most expressive, both physically and spiritually."
      }
    ],
