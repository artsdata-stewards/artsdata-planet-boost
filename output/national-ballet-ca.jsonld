    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Echoes of Stravinsky"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Fitting for the 75th anniversary season, Echoes of Stravinsky&nbsp;celebrates The National Ballet of Canada’s longstanding commitment to live music and the exceptional artistry of its musicians with a triple bill featuring&nbsp;Christopher Wheeldon’s <em>Scènes de Ballet</em>, George Balanchine’s <em>Stravinsky Violin Concerto </em>and Medhi Walerski’s <em>Chamber</em>.</p>\n<p>Single Tickets on Sale September 22<br>Subscriptions Now on Sale</p>"
      }
    ],
    "http://schema.org/eventStatus": [
