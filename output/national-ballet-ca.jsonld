      {
        "@language": "en",
        "@value": "The Sleeping Beauty"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>One of the most important works in the company’s 75-year history, Rudolf Nureyev’s <em>The Sleeping Beauty</em> was first performed by The National Ballet of Canada in 1972.&nbsp;&nbsp;A pinnacle in the classical canon, this signature ballet helped define the company’s international reputation.</p>\n<p>Single Tickets on Sale September 22<br>Subscriptions Now on Sale</p>"
      }
    ],
