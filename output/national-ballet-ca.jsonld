      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Experience the magic of the holidays with James Kudelka’s The Nutcracker, as siblings Marie and Misha journey to the glittering palace of the Sugar Plum Fairy in a joyous tribute to the imagination. "
      }
    ],
    "http://ogp.me/ns#image": [
