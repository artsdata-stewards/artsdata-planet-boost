    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<h6>On Tour: Ottawa&nbsp;<br>National Arts Centre</h6>\n<p>The National Ballet of Canada returns to the National Arts Centre in Ottawa with a new family production created for the 75th anniversary season, a brilliant reimagining of <em>Coppélia</em> by renowned storyteller Val Caniparoli.</p>"
      }
    ],
