      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "One of the most important productions in the company’s 75-year history, Rudolf Nureyev’s The Sleeping Beauty returns with storybook characters, lavish design and a timeless story of light triumphing over darkness, a pinnacle of the classical canon in the narrative tradition."
      }
    ],
    "http://ogp.me/ns#image": [
      {
