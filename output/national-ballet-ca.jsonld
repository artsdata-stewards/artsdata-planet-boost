    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><strong>Choreography: Will Tuckett</strong></p>\n<p>A reimagined&nbsp;<em>Pinocchio </em>returns to The National Ballet of Canada! Will Tuckett’s theatrical production brings a fresh perspective to the classic tale, whimsical stage design and a twist of Canadiana, with vibrant music by Paul Englishby.</p>"
      }
