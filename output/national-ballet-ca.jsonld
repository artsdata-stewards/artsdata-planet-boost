    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Sharing the Stage: Rainbow on Mars"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<div class=\"elementToProof\"><strong>Writer and Creator: Devon Healey</strong></div>\n<div class=\"elementToProof\">The National Ballet of Canada’s next Sharing the Stage partner will be Outside the March with the world premiere of&nbsp;<em>Rainbow on Mars,</em> a multidisciplinary reclamation of Blindness, performed by a hybrid cast of Blind, visually impaired and sighted theatre performers and dancers of the RBC Apprentice Programme.&nbsp;</div>\n<div class=\"elementToProof\">Tickets are now onsale through Outside the March.&nbsp;</div>"
      }
    ],
