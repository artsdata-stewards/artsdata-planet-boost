  {
    "@id": "https://nighthowl.ca/event/6514237/757669894/east-coulee-springfest-2026",
    "http://opengraphprotocol.org/schema/title": [
      {
        "@value": "East Coulee SpringFest 2026 @ East Coulee School Museum - May 2, 2026"
      }
    ],
    "http://opengraphprotocol.org/schema/description": [
      {
        "@value": "Visit: https://ecsmuseum.ca/springfest/ for tickets and info The Drumheller Valley comes alive for 2 days of fabulous music! Our 31st annual East Coulee SpringFest will feature an exciting line up of over 30 performances on 3 stages in 2 venues with hours of soul-nurturing music that will rock the Canadian Badlands and the hippy bones of guest of all ages. It is all for a good cause: SpringFest is the annual fundraiser for the East Coulee School Museum – a Provincial Historic Resource."
      }
    ],
    "http://opengraphprotocol.org/schema/url": [
      {
        "@value": "https://nighthowl.ca/event/6514237/757669894"
      }
    ]
  },
