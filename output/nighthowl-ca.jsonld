  {
    "@id": "https://nighthowl.ca/event/6514239/757669896/revy-live-outside",
    "http://opengraphprotocol.org/schema/title": [
      {
        "@value": "REVY.Live Outside @ Grizzly Plaza - Jul 25, 2026"
      }
    ],
    "http://opengraphprotocol.org/schema/description": [
      {
        "@value": "REVY.Live Outside REVY.Live Outside features a summer full of live music through July & August, showcasing artists from British Columbia, across Canada and worldwide every evening from 6:30-9:00 pm. The atmosphere in Grizzly Plaza is electric; dancing, patios, food trucks, popcorn, and gelato round out the experience, creating a uniquely laid-back, friendly BC festival vibe."
      }
    ],
    "http://opengraphprotocol.org/schema/url": [
      {
        "@value": "https://nighthowl.ca/event/6514239/757669896"
      }
    ]
