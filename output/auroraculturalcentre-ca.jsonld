    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Pique your curiosity with free, bite-sized introductions to various arts classes! Meet the artist-educators for a brief intro & demo and opportunity to give it a try! From Indigenous Beading, Bookbinding and Printmaking to Wood Carving, Acrylics & Oils and many more. All classes are offered in the Fall program. Registration is open throughout"
      }
    ],
