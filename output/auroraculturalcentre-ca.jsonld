    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "  Tuesdays | 6 weeks | March 10 – April [...]"
      },
      {
        "@language": "en-ca",
        "@value": "Register \n\n \n\nTuesdays | 6 weeks | March 10 – April 14 | 4:30PM – 5:30PM\n\nEmbark on your musical journey with the ukulele, the perfect ‘starter’ instrument. Learn all of the basics, such as chords and strum patterns through a variety of familiar songs. No previous musical experience necessary – just bring a ukulele in working"
      }
    ],
