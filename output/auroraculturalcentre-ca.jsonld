    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Introduce your family to the joys of classical music with an upbeat and fun-filled trio."
      },
      {
        "@language": "en-ca",
        "@value": "Kaleidoscope Family Series\nIntroduce your child to the magic of live music with the award-winning trio Infinitus. Through a highly-engaging, funny and upbeat 50-minute program, the trio brings classical music to life. Ranging from classical repertoire, to favourites that may include the themes from Star Wars and SpongeBob Squarepants - and some intro-to-beatboxing techniques - their"
      }
