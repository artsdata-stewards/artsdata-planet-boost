    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Mixed Media Mashup Camp: Animation Exploration (Ages 7 - 12) - Aurora Cultural Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Animate this! Learn the basics of drawing & sketching to discover the secrets behind recreating your favourite cartoon characters - from PAW Patrol to Pokémon - and everything in between. Each week finishes with a student art exhibition for family & friends!  Animation Exploration (Ages 7-12) Mixed Media Mashup camp runs July 22-26, from 1 pm - 4:30 pm daily."
      },
      {
        "@language": "en-ca",
        "@value": "Animate this! Learn the basics of drawing & sketching to discover the secrets behind recreating your favourite cartoon characters - from PAW Patrol to Pokémon - and everything in between. Each week finishes with a student art exhibition for family & friends!\n\nAnimation Exploration (Ages 7-12) Mixed Media Mashup camp runs July 22-26, from 1 pm"
      }
    ],
