    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Colour Around Us (Ages 7 - 12) - Aurora Cultural Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Dress for mess! This week is all about using big, bold splashes of colour to create bright an imaginative pieces. Campers will learn to mix colours, create light and dark hues, and discover what makes them pop! Each week finishes with a student art exhibition for family & friends! All materials provided, including FREE camper t-shirt!  Colour Around Us (Ages 7 - 12) Mixed Media Mashup camp runs August 19 - 23, from 1 pm - 4:30 pm daily."
      },
      {
        "@language": "en-ca",
        "@value": "Dress for mess! This week is all about using big, bold splashes of colour to create bright an imaginative pieces. Campers will learn to mix colours, create light and dark hues, and discover what makes them pop! Each week finishes with a student art exhibition for family & friends! All materials provided, including FREE camper"
      }
    ],
