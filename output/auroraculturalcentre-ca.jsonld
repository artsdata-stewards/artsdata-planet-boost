  {
    "@id": "https://auroraculturalcentre.ca/event/janina-fialkowska-piano/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-ca",
        "@value": "en_US"
      },
      {
        "@language": "en-ca",
