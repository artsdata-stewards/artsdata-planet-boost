    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "*Registration Closed* Sunday | October 16 | 10:00 am – [...]"
      },
      {
        "@language": "en-ca",
        "@value": "Register Here \n*Registration Closed*\n \n\nSunday | October 16 | 10:00 am - 2:00 pm\n\nPrerequisite Checklist \n\nPhotography is a simple way to capture the beauty of the world around you. In this one-day \"out-of lockdown\" workshop you will learn the basics of reading light, framing, using rule of thirds and other techniques to achieve"
      }
    ],
