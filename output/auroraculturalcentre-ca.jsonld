      {
        "@language": "en-ca",
        "@value": "Soroptimist International York Region presents: LUNAFEST Travelling Film Festival\nInternational Women's Day\nHeld at the Aurora Cultural Centre\n\nFeaturing:\n\n \tGuest speaker & author, Cynthia Reyes\n \tSeven short films by and about women!\n\nTickets\n\nAdults: $20\nStudents: $10\n\nFor tickets visit www.siyorkregion.ca"
      }
