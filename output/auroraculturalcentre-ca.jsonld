    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Africville | A Family Storytime with Shauntay Grant Saturday, February [...]"
      },
      {
        "@language": "en-ca",
        "@value": "Africville | A Family Storytime with Shauntay Grant\nSaturday, February 27\n2 pm EST\n\nRegister \n\n \n\nThe Aurora Cultural Centre is pleased to offer this event at no charge, and will compensate the author for their participation. Please join us to support events like this, and consider a donation at time of event registration. Thank you.\n\nJoin author and playwright"
      }
    ],
