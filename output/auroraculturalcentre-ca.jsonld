      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Drop by today to visit View from the Pines, 'play with clay' and ring the old school bell!"
      },
      {
        "@language": "en-ca",
        "@value": "Opened in 1886, the Church Street School is considered one of the best examples of a high Victorian-designed public school in all of Ontario.\n\nBegin your journey of discovery by meeting on the front lawn – every hour on the hour – for a tour into the Aurora Museum’s artifact vaults. While on the lawn, be"
      }
    ],
