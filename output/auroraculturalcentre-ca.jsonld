    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "    Monday, May 31 | One-Day | Virtual | [...]"
      },
      {
        "@language": "en-ca",
        "@value": "Register   Art Kit Info/Materials List \n\n \n\nMonday, May 31 | One-Day | Virtual | Ages 4-12 | 10:00 am - 3:00 pm\n\nA full day of artistic adventures await! Plug in with us virtually and unleash your creativity using a variety of tools and materials, while meeting new friends in a fun and encouraging environment. Join us"
      }
