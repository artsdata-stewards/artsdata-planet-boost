      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Janina Fialkowska, piano - Aurora Cultural Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Beloved the world over for her exquisite pianism, Janina Fialkowska has enchanted audiences for over forty years with her glorious lyrical sound, sterling musicianship and profound sense of musical integrity."
      },
      {
        "@language": "en-ca",
        "@value": "Low ticket alert! These tickets are almost gone, get yours today!\nGreat Artist Music Series\nThe Aurora Cultural Centre is thrilled to celebrate our 10th anniversary with a very special concert featuring internationally-acclaimed pianist Janina Fialkowska.\n\nBeloved the world over for her exquisite pianism, Janina Fialkowska has enchanted audiences for over forty years with"
      }
    ],
