    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Tuesdays | 8 weeks Instructor Anthony Clayton – a Music [...]"
      },
      {
        "@language": "en-ca",
        "@value": "Tuesdays | 8 weeks\n\nInstructor Anthony Clayton – a Music teacher with YCDSB and recipient of the Orff degree from the Toronto Royal Conservatory of Music – offers his fun and inspiring approach on how to play ukulele, the perfect ‘starter’ instrument. This course will cover all of the basics, such as chords and strum patterns"
      }
    ],
