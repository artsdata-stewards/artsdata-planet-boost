    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Brevik Hall Presents Signature Series Winner! 2019 Juno Award for [...]"
      },
      {
        "@language": "en-ca",
        "@value": "BUY TICKETS \nBrevik Hall Presents Signature Series\nWinner! 2019 Juno Award for Vocal Jazz Album.\n\nCanadian singer-songwriter and pianist Laila Biali has toured with Chris Botti, Paula Cole and Suzanne Vega, and recorded with and supported Sting. Her accolades include “SOCAN Composer of the Year” and “Keyboardist of the Year” at Canada’s National"
      }
    ],
