    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Deron Ahsén:nase Douglas | We Are Still Here! - Aurora Cultural Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "35 portraits and characterisations of the Onkwehón:we of Turtle Island by Deron Ahsén:nase Douglas"
      },
      {
        "@language": "en-ca",
        "@value": "An exhibition consisting of 35 portraits and characterisations of the Onkwehón:we of Turtle Island. In a humble attempt to depict their strength, beauty and spirit, the artist utilizes bold colors, thoughtful design and in some cases, a touch of humor to shout out to history – “We Are Still Here!” The exhibition includes a specially-created"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
        "@value": "https://auroraculturalcentre.ca/event/deron-ahsennase-douglas-we-are-still-here/"
      }
