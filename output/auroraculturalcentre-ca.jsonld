    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Find one-of-a-kind gifts from unique local vendors! Homemade holiday treats! [...]"
      },
      {
        "@language": "en-ca",
        "@value": "Find one-of-a-kind gifts from unique local vendors!\n \tHomemade holiday treats!\n \tRaffle for some not-to--miss prizes!\n \tA visit from Santa Claus!\n \tEnjoy classics performed live by Aurora's own Community Band!\n \tAll for this for FREE Admission\n\nAre you interested in joining the Aurora Community Band? Contact auroracommunityband@gmail.com\n\n \n\n "
      }
    ],
