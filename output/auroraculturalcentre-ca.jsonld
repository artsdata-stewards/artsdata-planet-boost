    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Monday-Friday  Dress for mess! This week is all about using [...]"
      },
      {
        "@language": "en-ca",
        "@value": "Monday-Friday \n\nDress for mess! This week is all about using big and bold splashes and pops of colour to create bright and imaginative pieces. Campers will learn how to mix colours, create light and dark hues, and discover which colours help each other pop out and step back. Each week finishes with a student art exhibition"
      }
