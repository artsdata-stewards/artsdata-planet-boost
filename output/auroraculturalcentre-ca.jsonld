    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Christmas with Patricia O'Callaghan & Friends - Aurora Cultural Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Patricia’s Christmas concert will have you feeling both the warmth of the hearth and the frosty nip of deep winter. With cello, nyckelharpa & harp."
      },
      {
        "@language": "en-ca",
        "@value": "Brevik Hall Presents Signature Series\nPatricia O’Callaghan is something of a wandering minstrel. Her fifteen-year career has taken her across genres, continents, and a range of disciplines and passions. Tonight’s concert ushers in the holiday season as only Patricia could. From 15th century Spanish and French carols to modern (holi)day songs, Patricia’s"
      }
    ],
