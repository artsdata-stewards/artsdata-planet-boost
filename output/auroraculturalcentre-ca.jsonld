    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Arts Talk Series #3 Free Event We live in a [...]"
      },
      {
        "@language": "en-ca",
        "@value": "Register \nArts Talk Series #3\nFree Event\n\nWe live in a very diverse world, particularly in Canada, and there is a disparity and inequity in access for artists as they move through their career.  Join us in speaking with an emerging diverse artist as we discover the opportunities and challenges moving from local high school"
      }
    ],
