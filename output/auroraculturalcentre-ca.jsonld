    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Tuesdays | 8 weeks Want to get happy? Learn to [...]"
      },
      {
        "@language": "en-ca",
        "@value": "Tuesdays | 8 weeks\n\nWant to get happy? Learn to play the oh-so-hip ukulele! Come to this ground level introductory course – no musical theory required. This class is for the absolute beginner who has never played an instrument before, or for those who have merely dabbled and would like to take the next step forward."
      }
    ],
