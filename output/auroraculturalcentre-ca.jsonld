    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "The Queen has always been the “fairest in the land.\" Her Magic Mirror tells her so! But when the Queen hears that Snow White has surpassed her, she’s willing to do whatever it takes to get rid of her… forever!"
      },
      {
        "@language": "en-ca",
