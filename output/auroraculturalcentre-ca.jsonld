      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Lady Bugs and Dandy Lions Free Family Day Concert with [...]"
      },
      {
        "@language": "en-ca",
        "@value": "Lady Bugs and Dandy Lions\nFree Family Day Concert with Matt Gerber\nChildren’s performer Matt Gerber – along with his kazoo, ukulele and zany lyrics – will have giggling and humming along with favourites including You’re a Lion, Ain’t that Dandy, Dance Little Ladybug & Buzz Off, Mosquito.\n\nWarm up with lots of free activities!\nLive Music!\nArt Activities!\n10th anniversary"
      }
    ],
