    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Mondays | 8 weeks | Class skips October 14 for [...]"
      },
      {
        "@language": "en-ca",
        "@value": "Materials List \n\nMondays | 8 weeks | Class skips October 14 for Thanksgiving\n\nSharpen your pencils and start your artistic journey! Learn all of the basics of drawing and sketching in this class, including fundamental perspective rules, composition, design, and shading. Instructional handouts and exemplars will be provided each week with exercises to guide students through"
      }
    ],
