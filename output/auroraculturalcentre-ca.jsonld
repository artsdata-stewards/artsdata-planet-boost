    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "  Monday, February 1 | One-Day | Virtual | 10:00 [...]"
      },
      {
        "@language": "en-ca",
        "@value": "Art Kit Info/Materials List \n\n \n\nMonday, February 1 | One-Day | Virtual | 10:00 am - 3:00 pm\n\nPlug in with us virtually for a full-day of PA Day fun with artist-instructor Kimberley Smith! Join us from the comfort of your home and stay engaged all day creating art, playing games, and getting up on your feet"
      }
    ],
