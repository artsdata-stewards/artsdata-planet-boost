        "@language": "en-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Rum Ragged - Aurora Cultural Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Celtic music from Newfoundland! Rising stars present classic tunes and sprited originals. Bodrun, mandolin, guitars - and stunning harmonies."
      },
      {
        "@language": "en-ca",
        "@value": "Brevik Hall Presents Signature Series\nFew traditional Newfoundland bands have risen as quickly in the ranks as Rum Ragged. Formed by singer/guitarist Mark Manning and singer/accordion player Aaron Collis a few years ago, the duo expanded to a four-piece with the addition of Anthony Chafe on bodhran and Michael Boone on bass"
      }
    ],
    "http://ogp.me/ns#url": [
