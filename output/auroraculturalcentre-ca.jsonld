    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "From an Artist’s Viewpoint: Art during - and emerging from – COVID - Aurora Cultural Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "**Registration closes at 5:00 PM on July 20th** Arts Talk [...]"
      },
      {
        "@language": "en-ca",
        "@value": "**Registration closes at 5:00 PM on July 20th**\nRegister \nArts Talk Series #2\nFree Event\n\nThe world pandemic stopped live performing and visual artists from meeting their public in person. This has been the largest crisis to hit a particular sector, and one that is reeling without clarity on when things will fully reopen."
      }
    ],
