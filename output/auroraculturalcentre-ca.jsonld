    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Mindfulness is an important component of Gaia Orion’s artistic practice. [...]"
      },
      {
        "@language": "en-ca",
        "@value": "Mindfulness is an important component of Gaia Orion's artistic practice. Join the artist this evening for an opportunity to fully experience creativity through a workshop that focuses on the process and having fun in the moment.\n\nAll levels of experience and all ages welcome. Come enjoy this practice in a beautiful gallery setting.\n\nThere is no charge,"
      }
    ],
