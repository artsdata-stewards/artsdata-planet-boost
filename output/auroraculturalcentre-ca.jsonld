    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "BEYOND THE WALLS: The Uxbridge Artist Collective Online Exhibition and Sale - Aurora Cultural Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Co-curators | Carmel Brennan & Clare Bolton Monday, June 15 [...]"
      },
      {
        "@language": "en-ca",
        "@value": "Co-curators | Carmel Brennan & Clare Bolton\nMonday, June 15 to Saturday, September 26, 2020\nFeatured image: Fly Me To The Moon, Gayle Temple\n\n \n\nExhibition Description:\n\nA new collection of contemporary work by 18 award-winning artists working in a variety of materials and styles, the Uxbridge Artist Collective includes sculptors, painters, ceramic artists, mixed-media artists, printmakers, photographers and textile artists."
      }
    ],
