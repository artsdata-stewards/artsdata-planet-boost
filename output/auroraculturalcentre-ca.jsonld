    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "March Break Crafternoon: Upcycled Paper Patchwork March 13, 2025 | [...]"
      },
      {
        "@language": "en-ca",
        "@value": "March Break Crafternoon:\nUpcycled Paper Patchwork\nMarch 13, 2025 | 1:00 - 3:00 PM\nBrevik Hall | All Ages | Free\n \n\nJoin us for a popular annual FREE Crafternoon, with family-friendly drop-in art activities\n\nWe’re celebrating sustainability and your unique artistic expression by transforming scrap cardstock and paper into vibrant patchwork-style greeting cards. Using repurposed"
      }
    ],
