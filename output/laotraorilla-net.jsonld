    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Stage de perfectionnement avec Myriam Allard à Québec"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Après de longues années passées en Andalousie à s’imprégner de la technique et de l’âme du flamenco, Myriam Allard est aujourd’hui une artiste de la danse établie à Montréal. Elle réalise des œuvres profondément humaines qui brouillent les frontières entre la danse, le théâtre et le concert rock. Ses travaux récents incluent DEBORDEMENTS, une hybridation [&hellip;]"
      },
      {
        "@language": "fr",
        "@value": "Après de longues années passées en Andalousie à s’imprégner de la technique et de l’âme du flamenco, Myriam Allard est aujourd’hui une artiste de la danse établie à Montréal. Elle [&hellip;]"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
