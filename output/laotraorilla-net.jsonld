    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Intensive Workshops with Myriam Allard in Quebec City"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "After years immersed in Andalusia studying flamenco&#8217;s technique and soul, Myriam Allard is now an established dancer based in Montreal. Her choreographic work blurs boundaries between dance, theatre, and rock concert, with recent creations including DEBORDEMENTS (flamenco-punk fusion) and RITE (flamenco stripped to its essence). With 20 years of international performance and teaching experience across [&hellip;]"
      },
      {
        "@language": "en",
        "@value": "After years immersed in Andalusia studying flamenco&#8217;s technique and soul, Myriam Allard is now an established dancer based in Montreal. Her choreographic work blurs boundaries between dance, theatre, and rock [&hellip;]"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
