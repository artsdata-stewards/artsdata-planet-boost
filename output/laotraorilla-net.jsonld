    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Portes : 19h30 Spectacle : 20h &#8211; Artistes : Myriam Allard Julian Ferrer Caroline Planté Miguel Medina Hedi Graja &#8211; Dans un cadre intime et confidentiel (pour 50 spectateurs maximum), La Otra Orilla vous propose des soirées de performance uniques. Participer à ces moments privilégiés, c’est découvrir les secrets de Lola, qui vous sont révélés [&hellip;]"
      },
      {
        "@language": "fr",
        "@value": "Portes : 19h30 Spectacle : 20h &#8211; Artistes : Myriam Allard Julian Ferrer Caroline Planté Miguel Medina Hedi Graja &#8211; Dans un cadre intime et confidentiel (pour 50 spectateurs maximum), [&hellip;]"
      }
