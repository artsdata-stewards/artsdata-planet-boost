    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "The Texas Tenors bring Christmas cheer to Marshall with concert - thetexastenors"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "MARSHALL, Texas (KTAL/KMSS) — The Texas Tenors are bringing their crossover stylings to Marshall just in time for the holidays for Deep in the Heart of Christmas on December 20 at 7:30 p.m. The group is the most successful vocal group and the third highest-selling act in America’s Got Talent history, reaching the finals in...Continue reading"
      }
    ],
