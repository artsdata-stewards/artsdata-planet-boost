      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The Texas Tenors will be returning to the Webb Center stage Wednesday, Jan. 28. Celebrating America’s 250th birthday are The Texas Tenors and their patriotic concert program, Let Freedom Sing, at 7:30 p.m. Wednesday, Jan. 28, 2026. The Webb Center is proud to welcome the Billboard No. 1 artists and three-time Emmy Award winners back...Continue reading"
      }
    ],
