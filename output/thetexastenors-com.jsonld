    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The Texas Tenors to Give 2 Free Concerts in Columbiana COLUMBIANA, Ohio – The Texas Tenors will perform two free concerts – 3 and 7 p.m. – on Sunday, Sept. 28, at the Columbiana High School auditorium, 700 Columbiana Waterford Road.  Advance tickets or reservations are not necessary and will not be accepted.  Admission is...Continue reading"
      }
