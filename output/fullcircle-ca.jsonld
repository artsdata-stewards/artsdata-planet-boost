2,&quot;2&quot;:0},&quot;15&quot;:&quot;Arial&quot;,&quot;16&quot;:10,&quot;23&quot;:1}' data-sheets-textstyleruns='{&quot;1&quot;:0}{&quot;1&quot;:348,&quot;2&quot;:{&quot;5&quot;:1}}{&quot;1&quot;:437}{&quot;1&quot;:462,&quot;2&quot;:{&quot;2&quot;:{&quot;1&quot;:2,&quot;2&quot;:1136076},&quot;9&quot;:1}}' data-sheets-hyperlinkruns='{&quot;1&quot;:460,&quot;2&quot;:&quot;https://pushfestival.ca/industry/&quot;}{&quot;1&quot;:493}'>milie Monnet’s Okinum.</span></p><p><strong>Facilitated by Lindsay Lachance, in conversation with Mairi Brascoupe and </strong><strong>É</strong><strong>milie Monnet</strong></p><p>Find out more info here<a class='in-cell-link' href='https://pushfestival.ca/industry/' target='_blank' rel='noopener'>: </a><a class='in-cell-link' href='https://pushfestival.ca/industry/' target='_blank' rel='noopener'>https://pushfestival.ca/industr</a>y/</p> "
