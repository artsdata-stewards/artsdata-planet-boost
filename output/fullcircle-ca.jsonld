  {
    "@id": "https://fullcircle.ca/events/write-on-2/event_13654_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://fullcircle.ca/events/write-on-2/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://fullcircle.ca/wp-content/uploads/2021/09/WriteOnHerbie-13.jpg"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://fullcircle.ca/events/write-on-2/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Write On!"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><!-- wp:paragraph --></p><p>Led by Herbie Barnes, in association with <a href='https://neworldtheatre.com/'>Neworld Theatre</a>.</p><p><!-- /wp:paragraph --></p><p><!-- wp:paragraph --></p><p>Young Indigenous writers will be challenged to take their writing from page to &#8216;stage&#8217; in 24 hours. Herbie Barnes will guide young writers through a series of energizing and fun storymaking and playwrighting exercises designed to ignite their creative spark. Over the two day workshop, participants will gain insight into the craft of storytelling and playwrighting and gain tools to honour their imaginations. Writers will also workshop their stories, monologues, or scenes with a crew of professional actors. This is a great opportunity for new writers to meet other young Indigenous artists, share ideas, and hear their work aloud.</p><p><!-- /wp:paragraph --></p><p><!-- wp:paragraph --></p><p>Open to Indigenous youth ages 14-18.</p><p><!-- /wp:paragraph --></p><p><!-- wp:paragraph --></p><p>Please pre-register via Eventbrite at <a href='https://www.eventbrite.ca/e/write-on-with-herbie-barnes-april-30-and-may-1-tickets-151325900843' target='_blank' rel='noreferrer noopener'>Write On! With Herbie Barnes, April 30 and May 1</a></p><p><!-- /wp:paragraph --></p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2021-4-30T15:30-8::00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2021-4-30T18:30-8::00"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
