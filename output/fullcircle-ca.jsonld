      }
    ],
    "http://schema.org/name": [
      {
        "@value": "War Paint: Drag Queens Prepare For Battle"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;The Brush Arbor Gurlz (BAGz) invite you to join them for a drag workshop. The BAGz see drag as a way to transcend gender and express themselves politically through their performance art.  They will demonstrate their transformation process with makeup, lashes and wigs while discussing Native issues, Two-Spirit identity, performance pieces, inspirations and empowerment by their alter egos.&lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@value": "Organization"
      }
    ],
