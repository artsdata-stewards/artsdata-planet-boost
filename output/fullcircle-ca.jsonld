    "http://schema.org/name": [
      {
        "@value": "Reel Reservations: Colonization Road"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;In towns throughout Ontario, there are startling reminders of the colonization of Indigenous territories and the displacement of First Nations people. Anishinaabe comedian and activist Ryan McMahon takes us to his hometown of Fort Francis and down its main drag, which is called Colonization Road. A direct reminder of the little-known Colonization Roads Act of 1872 and its severe impact [&hellip;]&lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@value": "Organization"
