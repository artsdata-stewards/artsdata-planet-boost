    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Presented by Talking Stick and PuSh FestivalThis evening of genre-blending madness mashes the music of Indigenous ancestors with the breaks, cuts, and booming bass of contemporary dance grooves. It’s an excitingly eclectic mix of styles, honouring traditional Indigenous idioms while presenting them in a thoroughly modern context. Enjoy a diverse lineup of artists in a mellow environment, with visuals to complement the propulsive rhythms.Tickets are $10 at the door. Free for PuSh Pass holders | 50% off if you have purchased a single ticket for another showClub PuSh Arists:Alexis LynnDJ O ShowDJ Paisely EvaHaley WallisQuinn PickeringCheck out more details here: https://pushfestival.ca/shows/club-push-2023/#tickets"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
