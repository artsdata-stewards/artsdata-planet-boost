    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "This evening of genre-blending madness mashes the music of Indigenous ancestors with the breaks, cuts, and booming bass"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
