    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "TD Vancouver International Jazz Festival - Blue Moon Marquee"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><!-- wp:paragraph --></p><p>The spirits of Delta blues, ragtime, Howlin&#8217; Wolf, and Django Reinhardt flow freely through this raw duo of A.W. Cardinal, an Albertan guitarist/vocalist who cut his teeth in the jazz clubs and crowded bar rooms of Montreal and New York, and one-woman rhythm section Jasmine Colette Ohlhauser on bass and percussion. Together, Blue Moon Marquee &#8220;plucks the danger from a Tom Waits melody, dances it a little further over the line with dark magic, teases the rhythms and raises a toast to back alley jazz.&#8221; (Canadian Music)</p><p><!-- /wp:paragraph --></p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
