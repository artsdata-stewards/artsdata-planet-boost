    "http://schema.org/name": [
      {
        "@value": "Reel Reservations: The Road Forward"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;A musical documentary directed by Marie Clements depicting a pivotal moment in Canada’s civil rights history. Performed by an ensemble of some of Canada’s finest vocalists and musicians, it seamlessly connects past and present with soaring vocals, blues, rock, and traditional beats.A rousing tribute to the fighters for First Nations rights, a soul-resounding historical experience, and a visceral call to action. (1h [&hellip;]&lt;/p&gt;\\n"
      }
    ],
