    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Full Circle, Vancouver Civic Centres and the Coastal Jazz and Blues Society are proud to present the Indigenous Summer Stage at šxʷƛ̓exən Xwtl&#8217;a7shn (formerly the QET Plaza). Kicking off at 4:30 PM this free lively outdoor stage will feature the fresh sounds of Indigenous artists spanning multiple genres and nations. Featuring: Elaine Bomberry, Murray Porter, Tsatsu Stalqayu (Coastal Wolfpack), Eden Fine Day, Norine Braun and Zach Saunders.</p> "
      }
    ],
