    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Piano Burning"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><!-- wp:paragraph --></p><p>Rising from the ashes of&nbsp;<a href='https://queerartsfestival.com/wp-content/uploads/sites/2/2021/08/Piano-Burning-postponement-PR-2021.pdf'>this summer’s fire ban</a>, Queer Arts Festival and Full Circle: First Nations Performance will reignite our Piano Burning event on Sunday, October 24 at Mountain View Cemetery. Curated by SD Holman and Margo Kane, Annea Lockwood’s infamous work — where QAF veteran Rachel Kiyo Iwaasa performs a piano as it burns to ashes — is re-envisioned through the lens of historically banned First Nations fire ceremonies and contemporary global warming of unprecedented levels.</p><p><!-- /wp:paragraph --></p><p><!-- wp:paragraph --></p><p>Register here: <a href='https://queerartsfestival.com/piano-burning-2/' data-type='URL' data-id='https://queerartsfestival.com/piano-burning-2/'>https://queerartsfestival.com/piano-burning-2/</a></p><p><!-- /wp:paragraph --></p> "
      }
    ],
