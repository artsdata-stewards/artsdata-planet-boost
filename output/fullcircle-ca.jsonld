    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Talking Truths - Following in Her Footsteps"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><!-- wp:paragraph --></p><p>Presented by O.Dela Arts / Matriarchs Uprising, the Talking Truths circle conversation extends new ways of viewing Indigenous and Community art as an act of healing, political assertion, and cultural continuation. Curated and hosted by O.Dela Arts, Artistic Director, Olivia C. Davies to engage audiences in new learning about the nuances of Contemporary Indigenous performance. In this edition, we bring together four women who have blazed the trail for other Indigneous women to find their path into the performing arts. You are invited to join the circle and witness conversation with Margo Kane (Full Circle First Nations Performance), Sharon Jinkerson-Brass (Big Sky), Rosemary Georgeson (Women in Fish), and Renae Morisseau (M&#8217;Girl) as they share their professional legacy stories and consider the future of Indigenous women in the arts.</p><p><!-- /wp:paragraph --></p><p><!-- wp:paragraph --></p><p>Hosted by Olivia C. Davies, O Dela Arts / Matriarchs Uprising</p><p><!-- /wp:paragraph --></p><p><!-- wp:paragraph --></p><p>Register at https://www.eventbrite.ca/e/talking-truths-following-in-her-footsteps-tickets-157406138999</p><p><!-- /wp:paragraph --></p> "
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OnlineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
