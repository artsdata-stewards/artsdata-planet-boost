    "http://schema.org/name": [
      {
        "@value": "2Spirit Rebellion"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Harsh words too often erode the confidence of two-spirit people but for some, drag is used to denote their strength. Join us for a night of rebellion as the Brush Arbor Gurlz demonstrate the resilience of two-spirit people.  &lt;/p&gt;\\n"
      }
    ],
