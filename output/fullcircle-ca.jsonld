    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><!-- wp:paragraph --></p><p><meta charset='utf-8'>This digital iteration of Embodying Power and Place offers twelve audio-visual works that honour the lives of the Indigenous women, girls, Trans, and Two-Spirit people. It creates a sacred space to reflect, heal and find renewed hope.</p><p><!-- /wp:paragraph --></p> "
