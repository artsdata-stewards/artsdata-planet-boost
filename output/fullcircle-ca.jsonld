    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "The Summer Solstice Indigenous Festival (SSIF) helps Canadians of all walks of life to recognize the enormous contributions"
      }
    ],
    "http://ogp.me/ns#image": [
