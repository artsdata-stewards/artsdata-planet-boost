    ],
    "http://schema.org/name": [
      {
        "@value": "Rezurrecting the Goddesses"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Virago Nation Burlesque invites you to take a journey into the multifaceted world of Indigenous sexuality. Through humour, seduction, pop culture and politics, they aim to show that Aboriginal women will not be confined to the virgin-whore dichotomy but will forge a new reconciliation with their bodies. (Note: 19+ event; sexually suggestive content; no full nudity)&lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@value": "Organization"
