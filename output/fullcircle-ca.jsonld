    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://fullcircle.ca/wp-content/uploads/2022/05/white-girls-in-moccasins.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2022-6-19T14:00-8:00"
      }
    ],
    "http://schema.org/endDate": [
