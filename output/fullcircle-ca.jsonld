    "http://schema.org/name": [
      {
        "@value": "Wax Hoks en Shqalawin (Open Your Hearts)"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Gather with us in the Roundhouse Exhibition Hall for Wax Hoks en Shqalawin (Open Your Hearts) - Talking Stick’s Opening Gala Celebration! Hosted by Canadian comedian Ryan McMahon (Anishinaabe), guests can step out on the dancefloor to the music of DJ Kookum (Dene/Nakota) and Beaver T (Cree) &amp; the Divas while being amazed by the table-side sleight of hand magic of [&hellip;]&lt;/p&gt;\\n"
      }
    ],
