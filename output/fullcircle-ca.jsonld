      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Th’owxiya: The Hungry Feast Dish (Matinée)"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Brought to life by the Axis Theatre Company!   Written by Joseph A. Dandurand | Directed by Chris McGregor  Six storytellers from the Kwantlen First Nations village of Squa’lets spin the tale of Th’owxiya: the Hungry Feast Dish “When you take something from the earth, you must give something back.” Th’owxiya: The Hungry Feast Dish, tells the story of Th’owxiya, whose mouth holds the most delicious foods, [&hellip;]&lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@value": "Organization"
      }
    ],
