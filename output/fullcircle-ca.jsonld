    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "An introduction to song publishing rights and royalties with Brittni Noble and Nigel Irwin and facilitated by Alan Greyeyes. This lab invites music makers seeking to understand how to access the different revenue streams available to them. Note: This event will use Facebook Live. "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
