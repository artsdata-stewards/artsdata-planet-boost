    "http://schema.org/name": [
      {
        "@value": "2 Spirit Intersection(s) and Connection(s)"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Exploring the space between and within Two-Spirit: performance, politics and community organizing. Join us for an afternoon of Two-Spirit conversations exploring the history of the Two-Spirit tradition(s) followed by a panel discussion of distinguished Two-Spirit performers exploring the intersection of Two-Spirit identify, performance, politics and community organizing.  &lt;/p&gt;\\n"
      }
    ],
