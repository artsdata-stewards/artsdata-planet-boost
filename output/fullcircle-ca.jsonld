    ],
    "http://schema.org/image": [
      {
        "@id": "https://fullcircle.ca/wp-content/uploads/2023/01/This-And-That-Image-2-Daniel-Paquet-Photographer.png"
      }
    ],
    "http://schema.org/location": [
