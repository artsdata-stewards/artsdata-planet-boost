    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "West Coast Sounds: Pura Fé &amp; Friends"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Join us for a night of music and fun at West Coast Sounds, co-presented by Coastal Jazz. Revel in Indigenous talent with multi-award winning composer and performer <span class='il'>Sandy</span> Scofield, Christielee Charles&#8217; Musqueam language Hip Hop, Murray Porter&#8217;s soulful keyboard, Pura Fé and family&#8217;s melodic tunes, and Wayne Lavallee &#8220;Rock n&#8217; Roll Indian Cowboy&#8221; energy. The night peaks with the vibrant Beaver Thomas Band featuring Shakti Hayes. Cheri Maracle  will host this lively celebration of music, community, and culture.</p><p>Fore event details, <a href='https://fullcircle.ca/west-coast-sounds/'>click here</a>. To buy tickets, <a href='https://www.eventbrite.ca/e/west-coast-sounds-pura-fe-and-friends-tickets-642404568357'>click here.</a></p> "
      }
    ],
