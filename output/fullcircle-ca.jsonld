    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Songwriters on Songwriting: A Virtual Discussion"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "This virtual discussion will touch on collaboration, the songwriting process, creative flow, finding inspiration, and song structure. Three Indigenous artists will guide the discussion by sharing their creative process as well as a song. Open to Indigenous songwriters at any level who would like to dive deeper into the creative process of writing.Note: The link will be displayed below at the time of the event. "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
