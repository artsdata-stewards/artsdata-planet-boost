      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://fullcircle.ca/wp-content/uploads/2023/11/Ceremonial-Fire-credit-Chris-Randle-scaled.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g2865440"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
