      {
        "@language": "en-ca",
        "@value": "Passion, positivity, and professionalism make 2024 Coastal Jazz Artist in Residence DJ O Show one of the most sought-after DJs"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
