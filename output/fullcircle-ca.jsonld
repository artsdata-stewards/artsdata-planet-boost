    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Gather with us in our Kw\\'eykw\\'áystway Pop-Up Musical Bistro. Sit back, fill your stomach (and your glasses), and chat with your host, Auntie Galena (Ed Bourgeois). Music by UnCeded. Includes catered meal.&lt;/p&gt;\\n"
      }
