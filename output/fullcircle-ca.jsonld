    "http://schema.org/name": [
      {
        "@value": "From Talking Stick to Microphone"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;One of our most beloved events is back! Molly Bellows (Northern Coast Salish/Homalco) pulls together a slam-dunkin’ evening in honour of “East Van ghetto poet” Zaccheus Jackson (Blackfoot), the original curator of this event. Be prepared for a selection of this country’s best independent musicians and slam poets going head to head!&lt;/p&gt;\\n"
      }
    ],
