      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Indian Acts!"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Three exciting short works. Michif Medicines a new contemporary dance piece in development as a collaboration between Dancing Earth (N.Mexico) and V’ni Dansi (Vancouver). An excerpt from the critically acclaimed Sokolo by  (Quebec) and a presentation of Standing Sunrise by poet, spoken word artist, actor and  monologue-ist,  Taran Kootenhayoo.  Followed by an Artist Talk and a discussion with the artists about what inspires and guides their work.&lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@value": "Organization"
      }
