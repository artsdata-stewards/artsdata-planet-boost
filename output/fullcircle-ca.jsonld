    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Let&#039;s Hear it! Live Indigenous Showcase"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Let&#8217;s Hear It! Live is back for the 3rd emerging artist showcase in this 4-part live concert series spotlighting new and emerging talent from diverse communities around BC.</p><p>This showcase celebrates new and thriving voices in music featuring up-and-coming Indigenous performers &#8211; Eros Taylor, Caitlin Goulet and Eagle Ex Machina at the Fortune Sound Club hosted by JB The First Lady.</p><p>The artist showcase will be the finale of a powerful afternoon of panel discussions on inclusion, wellness and diversity in the creative industries from an Indigenous perspective.</p> "
      }
    ],
