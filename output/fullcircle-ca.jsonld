  {
    "@id": "https://fullcircle.ca/events/nchu7mut-chesha7-temixw-giving-back-to-mother-earth/event_13811_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://fullcircle.ca/events/nchu7mut-chesha7-temixw-giving-back-to-mother-earth/"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2021-6-21"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2021-6-21"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://fullcircle.ca/events/nchu7mut-chesha7-temixw-giving-back-to-mother-earth/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://fullcircle.ca/events/nchu7mut-chesha7-temixw-giving-back-to-mother-earth/"
