      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Ceremonial Fire"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><span style='font-weight: 400;'>As the sun dips below the horizon, join us at Second Beach for a fire ceremony, deeply rooted in Coast Salish tradition. This gathering is a time for community reflection, storytelling, and connection, embraced by the natural harmony of land, sea, and fire. It&#8217;s an occasion to come together around the fire to share knowledge, music, and camaraderie.</span></p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2024-1-24T16:00-8::00"
      }
    ],
    "http://schema.org/endDate": [
