    "http://schema.org/name": [
      {
        "@value": "Kw’achmixwts Chexw Smen Han (Show ‘N’ Tell)"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Translated, “Kw’achmixwts Chexw Smen Hants” means “Show me, Tell me”. Gather for a pre-show “Show ‘n’ Tell”, a short performance accompanied by a sharing of its origins and meaning, featuring some of our region’s most engaging performers.&lt;/p&gt;\\n"
      }
    ],
