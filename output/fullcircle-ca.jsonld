      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://fullcircle.ca/events/moonlodge/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Moonlodge"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><!-- wp:paragraph --></p><p>By Margo Kane</p><p><!-- /wp:paragraph --></p><p><!-- wp:paragraph --></p><p>Directed by Jani Lauzon</p><p><!-- /wp:paragraph --></p><p><!-- wp:paragraph --></p><p>Hope, healing, and hitchhiking. Taken from her family by the government, Agnes grew up away from the support of her community. Unable to change her past, Agnes follows the voice inside her, journeying across America to where the women gather, helping her find herself, her history, and her family. An inspiring story of self-determination, and the colonial tragedies that shape our society today.</p><p><!-- /wp:paragraph --></p><p><!-- wp:paragraph --></p><p>Moonlodge is performed by Samantha Brown. Directed by Jani Lauzon. Sound Design by Wayne Kelso.</p><p><!-- /wp:paragraph --></p><p><!-- wp:paragraph --></p><p>Don&#8217;t miss the CBC interview with Margo Kane and Jani Lauzon: <a href='https://www.cbc.ca/radio/ideas/around-the-world-in-80-plays-indigenous-theatre-classic-moonlodge-launches-world-tour-1.5995293' target='_blank' rel='noreferrer noopener'>Around the World in 80 Plays: Indigenous theatre classic Moonlodge launches &#8216;world tour&#8217;</a></p><p><!-- /wp:paragraph --></p> "
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OnlineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
