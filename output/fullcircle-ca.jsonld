      {
        "@value": "Heartbeatz!"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Get your finger on the pulse of the best Indigenous music around! Hailing from the Yukon, headliner Diyet (Southern Tutchone/Tlingit) invites you into a soundscape of rhythm, melody and storytelling. She will be joined by a roster of some of the brightest up and coming musical stars – guaranteed to rock the house! Suitable for 19+.Cash Bar&lt;/p&gt;\\n"
      }
    ],
