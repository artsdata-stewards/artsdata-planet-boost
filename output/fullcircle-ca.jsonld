  {
    "@id": "https://fullcircle.ca/events/talking-stick-the-vancouver-jazz-festival/event_17809_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://fullcircle.ca/events/talking-stick-the-vancouver-jazz-festival/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://fullcircle.ca/wp-content/uploads/2022/05/jb-old-soul-event.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g2187380"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g2187420"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://fullcircle.ca/events/talking-stick-the-vancouver-jazz-festival/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Vancouver Jazz Festival Old Soul And JB The First Lady"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>This year, Full Circle is co-presenting with Coastal Jazz &amp; Blues Society to feature Indigenous musical artists at the annual TD Vancouver International Jazz Festival from June 24 &#8211; July 3rd.</p><p>Come and enjoy entertainment from Talking Stick artists performing during the Jazz Festival hosted by Nyla Carpentier.</p><p><strong>OLD SOUL REBEL</strong><br /> A powerhouse duo that puts a new shine on Southern-tinged blues rock, Old Soul Rebel was named one of Canada’s best new bands by CBC Radio. Inspired by their Black and First Nations cultures, Chelsea D.E. Johnson and Lola Whyte’s revelatory collaboration is vivid, upbeat, and compellingly gritty. $10 at Door.</p><p><strong>JB THE FIRST LADY</strong><br /> A member of the Nuxalk and Onondaga Nations, Vancouver-based hip hop/spoken-word artist, beat-boxer, cultural dancer, and youth educator Jerilynn Webster—aka JB The First Lady—upholds an essential oral history tradition while confronting urgent issues like residential schools and missing and murdered Indigenous women. Presented in association with Coastal Jazz &amp; Blues Society.</p><p>Cost: $10</p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2022-6-24T21:00-8::00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2022-6-24T23:50-8::00"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
