    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "DJ Paisley Eva"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Hailing from the Sḵwx̱wú7mesh Nation village of Eslha7an, Ta7talíya Paisley Eva’s been filling local club, party, and festival dance floors with a high energy mix of obscure underground tracks and beloved classics for over ten years. Her choice, chance-taking selections are plucked from house, disco, new wave, pop, and whatever keeps people moving.</p><p><em>Presented by Coastal Jazz and Queer Arts Festival.</em></p><p>The Event is Free</p> "
      }
    ],
