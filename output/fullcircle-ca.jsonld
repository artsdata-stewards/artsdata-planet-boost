      {
        "@language": "en",
        "@value": "https://fullcircle.ca/wp-content/uploads/2022/01/Copy-of-Talking-Stick-Festival-1800x885-1.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2022-2-3T21:00-8:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "en",
        "@value": "2022-2-3T23:59-8:00"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "TSF @ CLUB PUSH"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "This evening of genre-blending madness mashes the music of Indigenous ancestors with the breaks, cuts, and booming bass of contemporary dance grooves. Co-curated by Full Circle: First Nations Performance’s Rob Thomson and Nimkish Younging, Talking Stick offers an excitingly eclectic mix of styles, honouring traditional Indigenous idioms while presenting them in a thoroughly modern context. Enjoy this diverse lineup of artists in a mellow, party-friendly environment, with drinks and visuals to complement the propulsive rhythms. For more information: https://pushfestival.ca/shows/club-push/"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
