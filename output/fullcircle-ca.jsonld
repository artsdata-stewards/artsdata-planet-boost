    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><!-- wp:paragraph --></p><p><meta charset='utf-8'>Building on Annea Lockwood’s classic twentieth-century conceptual music composition, Pride in Art and Full Circle First Nations Performance Society presents Rachel Kiyo Iwaasa performing a newly commissioned piece by Russel Wallace and Jeffrey Ryan’s Fornax Chemica (Chemical Furnace) on the piano (while it burns), in a Kevlar dress made by Métis designer Evan Ducharme.,</p><p><!-- /wp:paragraph --></p> "
