  {
    "@id": "https://fullcircle.ca/events/the-vancouver-jazz-festival-dj-koakea-x-dj-keilani-rose/event_18208_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://fullcircle.ca/events/the-vancouver-jazz-festival-dj-koakea-x-dj-keilani-rose/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://fullcircle.ca/wp-content/uploads/2022/06/DJ-KoaKeA.png"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g2370260"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g2370300"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://fullcircle.ca/events/the-vancouver-jazz-festival-dj-koakea-x-dj-keilani-rose/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Vancouver Jazz Festival"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>This year, Full Circle is co-presenting with Coastal Jazz &amp; Blues Society to feature Indigenous musical artists at the annual TD Vancouver International Jazz Festival from June 24 &#8211; July 3rd.</p><p>Come and enjoy entertainment from Talking Stick artists performing during the Jazz Festival.</p><p><strong>DJ KOAKEA </strong></p><p><span style='font-weight: 400;'>DJ KoaKeA is double Sagittarius, mixed-cutie fire. Expect a dance party featuring tracks from local BIPOC stars, Beyonce, and other [self-]indulgent brown kid anthems from the 90s and 2000s. In ʻŌlelo Hawai’i, Koa means “brave”, KeA is short for KeAloha. Brave love, brave life. Nothing could be more fitting for the energy that KoaKeA brings to the dance floor.</span></p><p><span style='font-weight: 400;'>KoaKeA is KeAloha – a DJ and music artist based in the Musqueam, Squamish, and Tsleil-Waututh Nations, and hailing from the Lheidli T’enneh Nation with mixed Dakelh, Hawaiian, Tahitian, Chinese, and Irish ancestry.</span></p><p>Tickets: Free</p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2022-6-24T23:00-8::00"
      }
