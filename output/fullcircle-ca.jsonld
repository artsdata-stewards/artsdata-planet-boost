    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "</p><p><!-- wp:paragraph --></p><p>Presented in partnership with Western Gold Theatre</p><p> <!-- /wp:paragraph --></p></p><p><!-- wp:paragraph --></p><p>Join multiple award-winner Lee Maracle and her daughters Columpa Bobb and Tania Carter as they read from their book Hope Matters, which takes us on the journey of Indigenous people from colonial beginnings to reconciliation</p><p> <!-- /wp:paragraph --></p> "
      }
    ],
