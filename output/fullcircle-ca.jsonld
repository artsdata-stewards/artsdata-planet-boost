    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><!-- wp:paragraph --></p><p>How traditional teachings and Contemporary Therapy protocols and language can ground our conflict and care along productive, respectful and meaningful paths towards Right Relations. (Zoom-generated captions will be provided, and a transcript will be available after the event.) </p><p><!-- /wp:paragraph --></p><p><!-- wp:paragraph --></p><p>Facilitators: Margo Kane, Dennis Joseph, Mahara Allbrett hosted by Chris Reed  </p><p><!-- /wp:paragraph --></p> "
      }
