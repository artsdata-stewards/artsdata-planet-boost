  {
    "@id": "https://fullcircle.ca/events/indigenous-music-circle-forging-new-trails/event_20486_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://fullcircle.ca/events/indigenous-music-circle-forging-new-trails/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://fullcircle.ca/wp-content/uploads/2023/01/Music-Circle-Image.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g2544360"
