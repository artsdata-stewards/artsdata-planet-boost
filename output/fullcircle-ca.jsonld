    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Summer Sisters Sing: Indigenous Women’s Music Circle"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Join us at &#8220;Summer Sisters Sing,&#8221; a women&#8217;s music circle celebrating the unity of music and sisterhood. Enjoy traditional Indigenous rhythms hosted by Pura Fé and share food, stories, and songs in a warm, welcoming environment. It&#8217;s a unique event honoring traditions, embracing diversity, and harnessing the power of music to bring us closer.</p><p>All women including transgender, non-binary, two-spirit, and any other women identifying members of the LGBTQ+ community are welcome.</p><p>Event by Invite Only, for more details <a href='https://fullcircle.ca/summer-sisters-sing-womens-music-circle/'>click here</a>.</p> "
      }
    ],
