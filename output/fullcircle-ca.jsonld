        "@value": "The SSIMAs celebrate excellence, artistic voice and legacy in a range of music genres for recording, video"
      }
    ]
  },
  {
    "@id": "https://fullcircle.ca/events/the-summer-solstice-indigenous-music-awards/event_13784_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
