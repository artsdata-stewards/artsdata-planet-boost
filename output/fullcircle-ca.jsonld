      {
        "@language": "en",
        "@value": "This demonstration and conversation hosts Mairi Brascoupe and Émilie Monnet in conversation with moderator Lindsay Lachance. Starting with an interactive demonstration of Birch Bark Biting by Mairi Brascoupe, the artists will discuss themes of cultural transmission, land-based work, beavers, and dreams as they connect to Émilie Monnet’s Okinum.Facilitated by Lindsay Lachance, in conversation with Mairi Brascoupe and Émilie MonnetFind out more info here: https://pushfestival.ca/industry/"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
