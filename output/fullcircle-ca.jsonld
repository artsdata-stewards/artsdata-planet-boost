    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Indigenous Music Circle: Forging New Trails"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><span data-sheets-value='{&quot;1&quot;:2,&quot;2&quot;:&quot;Hosted by Talking Stick\n\nIndigenous music community members and allies are invited to gather for a free-flowing circle conversation. With the industry changing rapidly, we’ll have a chance to check in on the state of music venues and festivals locally, nationally and internationally. Participants will be invited to engage and ask questions with circle mentors.\n\nFind out more info here: https://pushfestival.ca/industry/&quot;}' data-sheets-userformat='{&quot;2&quot;:1063869,&quot;3&quot;:{&quot;1&quot;:0},&quot;5&quot;:{&quot;1&quot;:[{&quot;1&quot;:2,&quot;2&quot;:0,&quot;5&quot;:{&quot;1&quot;:2,&quot;2&quot;:0}},{&quot;1&quot;:0,&quot;2&quot;:0,&quot;3&quot;:3},{&quot;1&quot;:1,&quot;2&quot;:0,&quot;4&quot;:1}]},&quot;6&quot;:{&quot;1&quot;:[{&quot;1&quot;:2,&quot;2&quot;:0,&quot;5&quot;:{&quot;1&quot;:2,&quot;2&quot;:0}},{&quot;1&quot;:0,&quot;2&quot;:0,&quot;3&quot;:3},{&quot;1&quot;:1,&quot;2&quot;:0,&quot;4&quot;:1}]},&quot;7&quot;:{&quot;1&quot;:[{&quot;1&quot;:2,&quot;2&quot;:0,&quot;5&quot;:{&quot;1&quot;:2,&quot;2&quot;:0}},{&quot;1&quot;:0,&quot;2&quot;:0,&quot;3&quot;:3},{&quot;1&quot;:1,&quot;2&quot;:0,&quot;4&quot;:1}]},&quot;8&quot;:{&quot;1&quot;:[{&quot;1&quot;:2,&quot;2&quot;:0,&quot;5&quot;:{&quot;1&quot;:2,&quot;2&quot;:0}},{&quot;1&quot;:0,&quot;2&quot;:0,&quot;3&quot;:3},{&quot;1&quot;:1,&quot;2&quot;:0,&quot;4&quot;:1}]},&quot;10&quot;:1,&quot;11&quot;:4,&quot;12&quot;:0,&quot;14&quot;:{&quot;1&quot;:2,&quot;2&quot;:0},&quot;15&quot;:&quot;Arial&quot;,&quot;16&quot;:10,&quot;23&quot;:1}' data-sheets-textstyleruns='{&quot;1&quot;:0}{&quot;1&quot;:389,&quot;2&quot;:{&quot;2&quot;:{&quot;1&quot;:2,&quot;2&quot;:1136076},&quot;9&quot;:1}}' data-sheets-hyperlinkruns='{&quot;1&quot;:389,&quot;2&quot;:&quot;https://pushfestival.ca/industry/&quot;}{&quot;1&quot;:422}'>Hosted by Talking Stick</span></p><p>Indigenous music community members and allies are invited to gather for a free-flowing circle conversation. With the industry changing rapidly, we’ll have a chance to check in on the state of music venues and festivals locally, nationally and internationally. Participants will be invited to engage and ask questions with circle mentors.</p><p>Find out more info here: <a class='in-cell-link' href='https://pushfestival.ca/industry/' target='_blank' rel='noopener'>https://pushfestival.ca/industry/</a></p> "
      }
    ],
