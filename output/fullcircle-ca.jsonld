    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://fullcircle.ca/wp-content/uploads/2021/09/Summer-Solstice-Indigenous-Festival-5.png"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
