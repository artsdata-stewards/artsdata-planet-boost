      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Métis Fair"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;This year\\'s Fair is a Métis Kitchen Party! Come tap your feet to the sound of the fiddle while the jiggers showcase some “fancy steps”. Learn some traditional Métis crafts with hands-on, interactive workshops or browse the vendors\\' displays for Métis art. Our fiddlers and live band will keep the atmosphere lively the whole afternoon.   &nbsp;&lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@value": "Organization"
      }
    ],
