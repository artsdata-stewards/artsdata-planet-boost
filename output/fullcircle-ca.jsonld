    "http://schema.org/name": [
      {
        "@value": "Gala Celebration"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Wa x hoks en Shqalawin (Open Your Hearts) Gala Celebration is always a crowd pleaser. Gather in our Scháyilhen Visual Arts Exhibition, sample a taste of performances to come and help launch Western Canada’s premiere Indigenous Arts festival.  True to tradition, first class entertainment is accompanied by a buffet dinner. Cash bar. &nbsp; &nbsp;&lt;/p&gt;\\n"
      }
    ],
