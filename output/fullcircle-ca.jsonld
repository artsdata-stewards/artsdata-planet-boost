    "http://schema.org/name": [
      {
        "@value": "Reel Reservations: Angry Inuk"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;In her film Angry Inuk, Inuit director Alethea Arnaquq-Baril joins a new tech-savvy generation of Inuit as they campaign to challenge long-established perceptions of seal hunting. Though most commercial sealing is conducted by Inuit in the Arctic, anti-sealing activism has created a perception of the industry that denies their central role in the sealskin market.&lt;/p&gt;\\n"
      }
    ],
