    "http://schema.org/name": [
      {
        "@value": "Wax hoks en Shqalawin (Open Your Hearts) Gala"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Wa hoks en Shqalawin (Open Your Hearts) Gala Celebration is always a crowd pleaser. Dance in the Roundhouse Exhibition Hall to the music of Beaver T (Cree) and help us launch Western Canada’s premiere Indigenous Arts festival. True to tradition, first class entertainment will be led by emcee Sharon Shorty (Tlingit, Northern Tutchone). Includes a buffet dinner and cash bar.&lt;/p&gt;\\n"
      }
    ],
