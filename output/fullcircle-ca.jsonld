  {
    "@id": "https://fullcircle.ca/events/tsf-club-push/event_16430_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://fullcircle.ca/events/tsf-club-push/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://fullcircle.ca/wp-content/uploads/2022/01/Copy-of-Talking-Stick-Festival-1800x885-1.jpg"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://fullcircle.ca/events/tsf-club-push/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "TSF @ CLUB PUSH"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><!-- wp:paragraph --></p><p>This evening of genre-blending madness mashes the music of Indigenous ancestors with the breaks, cuts, and booming bass of contemporary dance grooves. Co-curated by Full Circle: First Nations Performance’s Rob Thomson and Nimkish Younging,&nbsp;<em>Talking Stick</em>&nbsp;offers an excitingly eclectic mix of styles, honouring traditional Indigenous idioms while presenting them in a thoroughly modern context. Enjoy this diverse lineup of artists in a mellow, party-friendly environment, with drinks and visuals to complement the propulsive rhythms.&nbsp;</p><p><!-- /wp:paragraph --></p><p><!-- wp:paragraph --></p><p>For more information: <a href='https://pushfestival.ca/shows/club-push/'>https://pushfestival.ca/shows/club-push/</a></p><p><!-- /wp:paragraph --></p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2022-2-3T21:00-8::00"
      }
    ],
