        "@id": "_:g2761960"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://fullcircle.ca/events/rumble-the-indians-who-rocked-the-world-a-conversation-with-pura-fe/"
