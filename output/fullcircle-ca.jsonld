    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://fullcircle.ca/festivalcalendar/category/theatre/list/?eventDisplay=past"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Red Patch"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;REDPATCH is a historical drama that focuses on a young Métis soldier from the Nuu-chah-nulth nation of Vancouver Island who volunteers to fight for Canada in the First World War. Set in both Canada and the battlefields of France, REDPATCH follows the experiences of this young soldier as he endures the horrors of war. Note: Theatre in development.  Audience talk-back [&hellip;]&lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@value": "Organization"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
