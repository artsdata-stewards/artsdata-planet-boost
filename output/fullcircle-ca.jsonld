    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Summer Solstice Indigenous Music Awards"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The SSIMAs celebrate excellence, artistic voice and legacy in a range of music genres for recording, video and live performance, and for cultural contribution, significance, legacy and social voice. The 2-hour show features awards in 17 categories, and live performances from among the 70+ finalists. A live stream from Ottawa’s National Arts Centre."
      }
    ],
