      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Journeys to Adäka is the story of seven indigenous artists who look to the past for the strength"
      }
    ]
  },
  {
    "@id": "https://fullcircle.ca/events/journeys-to-adaka/event_13808_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://fullcircle.ca/events/journeys-to-adaka/"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2021-6-10"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2021-6-24"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://fullcircle.ca/events/journeys-to-adaka/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://fullcircle.ca/events/journeys-to-adaka/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Journeys To Adaka"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><!-- wp:paragraph --></p><p>Journeys to Adäka is the story of seven indigenous artists who look to the past for the strength to overcome a legacy of hurt, becoming cultural giants and leaders in the process. This one-hour documentary follows its subjects as they prepare for the Adäka Cultural Festival in Whitehorse, Yukon, inviting viewers into carving sheds, kitchens, and community halls.</p><p><!-- /wp:paragraph --></p><p><!-- wp:paragraph --></p><p>In these spaces, artists and their families are reconnecting with their ancestors, healing, and moving personal mountains to each find their light. The process is familiar — rehearsals, training, crafting — but the backdrop of distant northern communities and the intimate access serve up both difficult lessons and inspiration. Journeys to Adäka paints a moving portrait of self-empowered indigenous communities at an inflection point in our history.</p><p><!-- /wp:paragraph --></p><p><!-- wp:paragraph --></p><p>This documentary was produced in association with Yukon First Nations<br />Culture and Tourism Association.</p><p><!-- /wp:paragraph --></p> "
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OnlineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
  {
    "@id": "_:g1815100",
    "@type": [
      "https://schema.org/OnlineEventAttendanceMode"
    ]
  },
  {
    "@id": "https://fullcircle.ca/temporary/ade95fb3-a7ec-4255-b821-a8a9793182b4",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://fullcircle.ca/events/journeys-to-adaka/"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
