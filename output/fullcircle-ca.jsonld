      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Map of the Land, Map of the Stars"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Brought to you by Gwaandak Theatre, Yukon’s only Indigenous-centered theatre company! Spirits used to know the map of the stars. But they’ve lost their way. Can they find the trail home? Map of the Land, Map of the Stars is a story of how the gold rush and the Alaska Highway changed connections between land and sky, told through theater, dance, and music.&lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@value": "Organization"
