    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><!-- wp:paragraph --></p><p>In Partnership with Western Gold Theatre</p><p><!-- /wp:paragraph --></p><p><!-- wp:paragraph --></p><p>Join the Hitchhikers – Jamie Thomson (Haida Nation) and Dennis Joseph (Squamish Nation), two of the coolest cats we know – on YouTube, as they jam some stories with music and mix it up with some laughter. Kick back, relax and get your groove on!</p><p><!-- /wp:paragraph --></p> "
      }
