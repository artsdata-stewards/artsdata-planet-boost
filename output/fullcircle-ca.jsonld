    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2022-6-18T20:00-8:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "en",
        "@value": "2022-6-18T22:00-8:00"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "White Girls in Moccasins 3"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Following a sold-out run in Toronto, The Frank Theatre presents the West Coast premiere of White Girls in Moccasins by Dora-Award-nominated playwright Yolanda Bonnell. Miskozi goes on a search for herself and her culture, accompanied by her inner white girl, Waabishkizi, and guided by Ziibi, a manifestation of an ancestral river. White Girls in Moccasins world-hops between dreams, memories, and a surreal game show as Miskozi grapples with living her own truth in a society steeped in white supremacy.Directed by Quelemia Sparrow Featuring: Danica Charlie, Lisa C. Ravensbergen and Emily Jane KingCost:  $15 – $35Tickets: https://www.eventbrite.ca/e/white-girls-in-moccasins-by-yolanda-bonnell-tickets-349092072787Artwork by Jay Havens"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
