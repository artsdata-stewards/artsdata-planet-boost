    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "@The Vancouver Jazz Festival DJ Kookum"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Cheyanna Kootenhayoo AKA Kookum is a DJ and multi media maker from the Alexis Nakota Sioux Nation, and Cold Lake First Nations, their maternal Denesuline traditional territory. Based out of Vancouver BC, Kookum has been making a name for their self across the country and is no stranger in the community. Kookum is an open format DJ inspired by EDM and Hip Hop music. This diverse- mix-diva is a force on the decks and always keeps the party hype, fresh, and unpredictable. Kookum tours nationally and internationally with the Snotty Nose Rez Kids.</p><p>Cost: Free</p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
