      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Moonlodge"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Written by Full Circle’s Founder and Artistic Managing Director, Margo Kane, Moonlodge is a Canadian Aboriginal Theatre classic. Agnes is a girl who was removed from her home by Child Welfare government services. She grows up in a series of foster homes, away from the warmth and support of her family and her cultural community. Popular media depicting Aboriginal people [&hellip;]&lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@value": "Organization"
      }
    ],
