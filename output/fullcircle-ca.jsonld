  {
    "@id": "https://fullcircle.ca/events/michelle-good-truth-telling-about-indigenous-life-in-canada/event_20974_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://fullcircle.ca/events/michelle-good-truth-telling-about-indigenous-life-in-canada/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://fullcircle.ca/events/michelle-good-truth-telling-about-indigenous-life-in-canada/"
      }
    ],
    "http://schema.org/location": [
