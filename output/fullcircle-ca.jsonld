    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Indigenous Performing Arts Protocols: Modeling Right Relations"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
        "@value": "https://fullcircle.ca/events/tsf-push-industry-series-2/"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Facilitated by Mique'l DangeliPanelists: Michelle Olson, Reneltta Arluk,Dakota Alcantara-Camacho, Rosemary Georgeson, Ronnie Dean Harris, Meena NatarajanWitness: S7aplek Bob"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://fullcircle.ca/wp-content/uploads/2022/01/P1844551-1.jpg"
      }
    ],
