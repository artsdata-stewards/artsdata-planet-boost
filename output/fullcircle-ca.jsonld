        "@value": "https://fullcircle.ca/wp-content/uploads/2022/05/dj-oshow-event.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2022-6-25T23:00-8:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "en",
        "@value": "2022-6-25T23:50-8:00"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Vancouver Jazz Festival DJ O"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Orene Askew, aka DJ O Show, brings energy and expertise to every event she DJ’s and hosts. Coming from a diverse background, O Show is driven by her passion. She is Afro-Indigenous and a proud member of the Squamish Nation. Feeling as though she stood out in a unique way, she embraced both her cultural backgrounds and incorporates the teachings she has learned into everything she does. DJ O Show has experience teaching with an inspired approach. She is an inspirational speaker, having traveled across the country to bring ambition and drive to all generations, and is a former member of Squamish Nation Council.Tickets: Free"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
