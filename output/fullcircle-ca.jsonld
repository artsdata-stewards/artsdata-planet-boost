  {
    "@id": "https://fullcircle.ca/events/indigenous-music-summit/event_13586_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://fullcircle.ca/events/indigenous-music-summit/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://fullcircle.ca/wp-content/uploads/2021/09/IIMS-5.jpg"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
