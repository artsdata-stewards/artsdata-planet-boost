    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Produced by Delinquent Theatre, co-production with PuSh International Performing Arts Festival and Full Circle: First Nations Performance.The Seventh Fire is an immersive audio performance inspired by ceremony and created by Lisa Cooke Ravensbergen that sources traditional, oral Anishinaabe stories as a way to evoke ceremony in the everyday. Cooke Ravenbergen’s creation blurs time and space, bringing emotional and ancestral connection into being through deep collaboration with sound designer Mishelle Cuttler and a matriarchal creative team.Check out showtimes and purchase tickets here: https://pushfestival.ca/shows/the-seventh-fire/"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
  {
    "@id": "https://fullcircle.ca/events/the-seventh-fire/",
    "https://api.w.org/": [
      {
        "@id": "https://fullcircle.ca/wp-json/"
      }
    ],
