        "@value": "event"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Reflections of My Tomorrow + post show Talk Back + reception"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
        "@value": "https://fullcircle.ca/events/reflections-of-my-tomorrow-post-show-talk-back-reception/"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Reflections of my Tomorrow, co-written by the late Siyam Lee Maracle and emerging Metis-Swampy Cree writer and Lawyer, Victoria Perrie"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://fullcircle.ca/wp-content/uploads/2022/06/Reflections.jpeg"
      }
    ],
