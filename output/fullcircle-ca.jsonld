      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Stemming from the Badlands of the Rocky Mountain prairies, Blue Moon Marquee is a self-styled gypsy blues band. This authentic duo writes and performs original compositions influenced by early blues, swing, and ragtime. A.W. Cardinal, a Metis of Cree heritage, howls with a distinctive thick and smoky vocal while playing a jazz tinged blues guitar. Jasmine Colette, aka Badlands Jazz, [&hellip;]&lt;/p&gt;\\n"
      }
