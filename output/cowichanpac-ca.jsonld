    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Shantero Productions presents With twenty-five years spent barrelling down endless strips of asphalt from coast to coast, RON JAMES, our nation\\'s number one road warrior and newly minted senior citizen, [&hellip;]&lt;/p&gt;\\n"
