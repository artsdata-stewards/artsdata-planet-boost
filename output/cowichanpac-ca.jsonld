    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Qairo is a fiery and dynamic ensemble that combines the emotional charged vocals and pulsing rhythms of flamenco dance with the infectious melodies and ear-popping tonalities of the Mediterranean diaspora. [&hellip;]&lt;/p&gt;\\n"
      }
