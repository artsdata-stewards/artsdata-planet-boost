        "@language": "en",
        "@value": "Celebration Concert | Music4Life String Orchestra"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Join Music4life String Orchestra for our seasonal Celebration Concert on Saturday Nov 30th 2024 with special guests, the Multi-Award Winning, Canadian A Cappella Sensation \"CounterMeasure\"."
