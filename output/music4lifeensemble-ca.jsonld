    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Sunshine for the Soul | Music4Life String Orchestra"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Join us Music4life String Orchestra Saturday May 11th 2024 for a vibrant musical experience of uplifting rhythms and joyful tunes featuring special guests, the globe-trotting Clarinet & Accordion Comedic duo Bridge & Wolak.  It will be sheer Sunshine for the Soul."
      }
