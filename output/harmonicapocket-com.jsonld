      }
    ],
    "http://schema.org/performer": [
      {
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "THURSDAY JULY 18  Songwriting Workshop  City of Covington  Covington, WA 98042    10 am - 4:30 pm    For ages 9 - 17  Class Fee: $125    **Please note Advance Registration is required. Workshop location will be shared with enrolled families.      Workshop Description:    In this unique creative writing workshop, everyone is a songwriter.    Together we co-create an original song from scratch based on your ideas. Facilitated by professional songwriter Keeth Apgar, we'll discuss lyrics, melody, and harmony. As we dig into the creative process we'll touch upon the role of vowel sounds, play with creating images with words, dip into music theory and develop our listening skills.    Prior musical training is welcome although not necessary. Students should bring a notebook and pencil and are welcome to bring a musical instrument they have been playing."
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Songwriting Workshop City of Covington, WA"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
