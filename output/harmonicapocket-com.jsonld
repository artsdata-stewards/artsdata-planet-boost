    "http://schema.org/image": [
      {
        "@id": "https://harmonicapocket.com/wp-content/uploads/2025/01/20240417_UkuleleSongwriting7.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://harmonicapocket.com/events/the-benji-project-youth-songwriting-camp/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://harmonicapocket.com/events/the-benji-project-youth-songwriting-camp/"
      }
    ],
    "http://schema.org/performer": [
      {
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "WEDNESDAY JULY 30  Mindfulness in Motion  TheBenjiProject.org    Keeth will be facilitating a songwriting workshop during this weeklong mindful self-compassion camp for local youth aged 11-14.  The full week will feature art, theater games, time in nature, and activities from The Benji Project's Mindful Self-Compassion for Teens curriculum all experienced within a supportive community.  Here is a link for weeklong camp PRE-REGISTRATION.  Participants will learn formal meditations and informal practices as they explore what it means to pay attention in the present moment, how to cultivate a relationship with themselves based on kindness and compassion, and how blending these two concepts can provide important strategies for managing stress and anxiety.  Weekend tuition is $400, with the option to pay what you can. No one turned away for lack of funds!  FREE transportation provided for south Jefferson County residents."
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "The Benji Project — Teen %26 Tween Songwriting Camp (Port Townsend, WA)"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
