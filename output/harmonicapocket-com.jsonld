    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://harmonicapocket.com/events/all-ages-songwriting-workshop-enumclaw-wa/"
      }
    ],
    "http://schema.org/performer": [
      {
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "TUESDAY JULY 25  Enumclaw Library  kcls.org/locations/enumclaw  1700 1st Street  Enumclaw, WA 98022  2 pm            A hands-on Creative Writing workshop with professional songwriter Keeth Apgar. Together we co-create an original song from scratch based on participant-powered ideas.    As we dig into the creative process, the group works with music concepts such as rhythm, melody, tempo and chords. We also touch upon the role of vowel sounds; discuss song structure, storytelling and creating images with words; dip into music theory; and develop listening skills. Time permitting we record a live version of our co- created original work.    Prior musical training is welcome although not necessary.          "
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "All-ages Songwriting Workshop (Enumclaw, WA)"
      }
    ],
