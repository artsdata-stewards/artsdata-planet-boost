      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://harmonicapocket.com/events/pt-cd-release-2021/"
      }
    ],
    "http://schema.org/performer": [
      {
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "SATURDAY OCTOBER 23  The Elevator of Everything  www.mikebiskup.com/elevatorofeverything  630 Water St  Port Townsend, WA 98368  Corner of Water &amp; Madison, across from Elevated Ice Cream  12:30 pm    Name Your Price Admission! Online and cash tip jars will be available for payments to the band.    To celebrate the release of The Harmonica Pocket's 8th album Sing Your Song we are throwing an old school, busking-style, hometown street party!    We’ll be playing songs from the new album and sharing some old favorites. Show will be at Mike Biskup's Elevator of Everything - Port Townsend’s only micro art gallery! Come share some music, laughs, dance and create chalk murals on the sidewalk. Good tunes, good times!    Dress for the weather -- Rain or shine!"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Port Townsend CD Release Street Party"
      }
    ],
