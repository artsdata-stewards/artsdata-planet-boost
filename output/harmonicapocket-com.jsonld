    "http://schema.org/image": [
      {
        "@id": "https://harmonicapocket.com/wp-content/uploads/2022/04/20170816_HamronicaRackSongwriting.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://harmonicapocket.com/events/songwriting-workshop-in-la-conner/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://harmonicapocket.com/events/songwriting-workshop-in-la-conner/"
      }
    ],
    "http://schema.org/performer": [
      {
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "THURSDAY JANUARY 11  La Conner Swinomish Library  laconnerswinomishlibrary.org  520 Morris Street  La Conner, WA 98257  3 - 5 pm    This is session #1 of 3 in a songwriting workshop called How to Write a Rock Song.     How to Write a Rock Song: A hands-on Creative Writing workshop with professional songwriter Keeth Apgar. Together we co-create an original song from scratch based on participant-powered ideas.    As we dig into the creative process, the group works with music concepts such as rhythm, melody, tempo and chords. We also touch upon the role of vowel sounds; discuss song structure, storytelling and creating images with words; dip into music theory; and develop listening skills. Time permitting we record a live version of our co- created original work.    Prior musical training is welcome although not necessary."
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Songwriting Workshop #1 in La Conner"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
