    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Rock &#039;n Roll Call - &quot;A Tribute to Buddy Holly&quot;"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "With his uncanny resemblance to Holly in both voice and performance style, Zachary Stevenson captures the spirit and energy of the 1950s with Buddy’s songs and those of his contemporaries Ritchie Valence, Big Bopper, and Chuck Berry. An afternoon of timeless music delivered with passion and authenticity will have us all dancing to “That’ll be&hellip;"
      }
    ],
