    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "From Barcelona with Love - Partners in music and in life, Kai and Catherine present two different concerts. They are known for weaving a spellbinding musical journey with passion and finesse. These gifted musicians receive lengthy ovations each time they perform in Pender Harbour, and we know they will be warmly welcomed on their much-anticipated&hellip;"
      }
    ],
