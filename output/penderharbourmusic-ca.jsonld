    "http://schema.org/url": [
      {
        "@id": "https://penderharbourmusic.ca/mc-events/morgan-toney-keith-mullins-mikmaltic-magic-tradition-meets-innovation/"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-03-29T14:00:00-05:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-03-29T15:00:00-05:00"
      }
