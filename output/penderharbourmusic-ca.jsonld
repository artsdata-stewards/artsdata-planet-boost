    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Company B - &quot;Festive Swing, A Holiday Concert&quot;"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Vintage harmonies and infectious energy accompanied by a stellar rhythm section take us back to the dance halls of the Swing Era and Roaring 20’s with a performance that radiates joy and nostalgia. Celebrate the season with toe-tapping fun and irresistible swing. Sponsored in part by: Janet &amp; Les Falk, Karen &amp; Gary Strong"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "en",
        "@value": "PT1H"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
