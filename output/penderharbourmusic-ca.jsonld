    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Over The Moon - &quot;Heartfelt Harmonies&quot;"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "A real life couple, Suzanne Levesque and Craig Bignell, endearingly describe themselves as ‘cowbillies’ but they are a lot more than that! This Juno-nominated duo blend heartfelt harmonies, masterful musicianship and a love of storytelling, along with charming banter into a performance to warm the heart. Sponsored in part by: Jean &amp; Clay Curry, Deb&hellip;"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "en",
        "@value": "PT1H"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
