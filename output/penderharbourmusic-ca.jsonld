      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Morgan Toney &amp; Keith Mullins - &quot;Mi’kmaltic Magic: Tradition Meets Innovation&quot;"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "2024 Juno-nominated Celtic fiddler and singer, Morgan Toney, brings together the fiery fiddling of Cape Breton Island with the old songs of the Mi’kmaq. He calls this fusion Mi’lmaltic (Mi’kmaq + Celtic). It’s his way of celebrating his language and heritage. Morgan and his touring partner, and fellow Cape Bretoner, Keith Mullins have collaborated to&hellip;"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "en",
        "@value": "PT1H"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
