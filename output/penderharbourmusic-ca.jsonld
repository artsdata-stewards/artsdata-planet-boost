    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://penderharbourmusic.ca/events"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Janelle Nadeau - &quot;Spring is in the Air&quot;"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Everyone loves the harp, and Janelle, with her warm and engaging presence is always a crowd favourite. Celebrate spring as Janelle and her musical colleagues present an afternoon of diverse classical, Celtic, original and contemporary tunes. Be whisked away to misty hilltops and shadowy glens with beautiful aires played on this most ancient of instruments.&hellip;"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "en",
        "@value": "PT1H"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
