    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Instrumental synth rock   We're Only Here for the Snacks are quite possibly the world’s best (only?) 13-year-old instrumental dual synth indie rock band. Their unique sound blends electro indie pop, rock, punk, and jazz into an energetic style with intricate melodies and catchy riffs. We're Only Her"
      }
