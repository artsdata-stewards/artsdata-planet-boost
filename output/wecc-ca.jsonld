    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "\"A vibrant fusion of John Prine's sharp wit and Lyle Lovett’s musicality paired with the Live energy and spirited performance of their Canadian cousins, Great Big Sea. Thomas and his stellar mates craft a fun, memorable musical experience that harmonizes storytelling with dynamic stage presence"
      }
