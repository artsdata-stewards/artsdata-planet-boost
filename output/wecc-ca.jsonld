    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Co-presented by Wilderness Supply and The WECC.   Things get WILD at the Paddling Film Festival. Come check it out, then immediately make plans to go paddling.&nbsp;  The Paddling Film Festival is an annual film tour, produced by Rapid Media, that show-cases the best paddling films of the year."
      }
