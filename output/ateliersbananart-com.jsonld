      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Chien, Café et Pinceaux! &#8211; PEINT TA BOISSON DE L&rsquo;ÉTÉ &#8211; Laval"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "&lt;p&gt;Atelier de peinture au Café Arthur – Peins ton drink d’été ! ☀️Avec les Ateliers BananArt Rejoins-nous vendredi 4 juillet de 15h à 17h au chaleureux Café Arthur, un café unique où les chiens sont les bienvenus, pour un atelier de peinture acrylique haut en couleurs ! Lors de cette activité créative et décontractée, tu seras guidé·e pas à pas pour peindre un drink d’été coloré, inspiré des cocktails fruités et rafraîchissants qui évoquent les vacances. Aucune expérience n’est requise [&hellip;]&lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Organization"
