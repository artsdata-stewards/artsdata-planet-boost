    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Spécial fête des mères &#8211; PEINTURE SUR CHANDAIL &#8211; Laval"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "✨ Atelier créatif spécial Fête des Mères – 46$ par personne ✨ Joignez-vous à nous le 9 mai de 19h à 21h pour une soirée artistique remplie de cœur à la Friperie Les Trésors d’Ozanam à Laval Nous aurons la chance de peindre sur des chandails neufs, issus de surplus d’entreprise, généreusement récupérés par Sylvie, notre hôte au grand cœur. Sa mission : redonner une seconde vie aux trésors oubliés, dans un lieu rempli de charme et de belles valeurs [&hellip;]"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
