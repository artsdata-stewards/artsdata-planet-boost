    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Les Trésors d&rsquo;Ozanam"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Plongez dans l&rsquo;univers de la friperie « Seconde Vie, Nouveau Souffle » située à Laval. En soutenant ce projet, vous favoriserez l&rsquo;économie circulaire et l&rsquo;insertion sociale. Chaque don contribue à financer le Camp Ozanam, offrant ainsi des moments inoubliables aux familles défavorisées. Ensemble, cultivons un impact positif dans notre communauté, tout en adoptant un mode de vie écoresponsable. Share on FacebookTweetFollow us"
      }
    ],
