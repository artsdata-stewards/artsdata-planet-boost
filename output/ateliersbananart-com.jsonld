  {
    "@id": "https://ateliersbananart.com/ateliers-et-cours/atelier-peinture-et-decoration-de-chandelle/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-fr",
        "@value": "fr_FR"
