    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "ANNULER Atelier art &#038; spiritualité &#8211; CRÉATION LUNAIRE &#8211; Terrebonne"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": " Découvrez la magie de la Pleine Lune et libérez votre créativité  C&rsquo;est avec joie que BananArt offre un nouvel atelier créatif intuitif en collaboration avec la merveilleuse Valérie Guimond! Rejoins-nous le vendredi 14 Mars de 19h à 21h30 pour un atelier unique qui t&#8217;emportera dans le monde envoûtant de la Pleine Lune, de la peinture, de la détente et de l&rsquo;intuition.  Crée sous la Pleine Lune  Sous la douce lueur de la Pleine Lune et de la black light , laisse-toi [&hellip;]"
      }
    ],
