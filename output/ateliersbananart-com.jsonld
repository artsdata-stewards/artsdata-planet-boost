    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Paint &#038; sip *Glow in the dark*"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "BananArt est ravi de t’accueillir à un atelier Paint &amp; sip *Glow in the dark* Tu auras l’occasion de vivre une expérience incroyable en collaboration avec Maman BB&amp;CO. Tu voyageras dans un univers créatif complètement épatant sous la lumière blacklight. Une expérience à ne pas manquer. Place limitée! Date : 15 Novembre 2024 Heure : 18h00 à 20h00 Lieu : Tier Lieu, Laval Coût : 60$ Membre / 70$ Non-Membre / 20$ Halte-Garderie Pour t&rsquo;inscrire click ici ! [powr-button id=ea7f4e4b_1730991381228] [&hellip;]"
      }
    ],
