    "http://ogp.me/ns#title": [
      {
        "@language": "fr-fr",
        "@value": "Spécial fête des mères - PEINTURE SUR CHANDAIL - Laval -"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "✨ Atelier créatif spécial Fête des Mères – 46$ par personne ✨ Joignez-vous à nous le 9 mai de 19h à 21h pour une soirée artistique remplie de cœur à la Friperie Les Trésors d’Ozanam à Laval Nous aurons la chance de peindre sur des chandails neufs, issus de surplus d’entreprise, généreusement récupérés par Sylvie, notre hôte au grand cœur. Sa mission : redonner une seconde vie aux trésors oubliés, dans un lieu rempli de charme et de belles valeurs […]"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-fr",
