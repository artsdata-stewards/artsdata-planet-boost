    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Atelier Peinture et Décoration de Chandelle"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dans notre prochain atelier de Bananart, nous t&rsquo;invitons à plonger dans un univers créatif où la cire devient le médium de ta vision artistique. Imagine-toi, entouré d&rsquo;une ambiance chaleureuse, bercé par la douce lueur des bougies, prêt à donner vie à tes idées sur une toile peu conventionnelle : une chandelle de 6 pouces par 2 pouces. Dans cet atelier unique, nous t&rsquo;offrons l&rsquo;opportunité de fusionner la peinture et la sculpture dans un art aussi éphémère que captivant. Armé de [&hellip;]"
      }
    ],
