  {
    "@id": "https://ateliersbananart.com/temporary/a0df036a-3034-4bc0-816f-186255176f75",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/image": [
      {
        "@id": "https://ateliersbananart.com/wp-content/uploads/2025/02/10h30-9.png"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://ateliersbananart.com/ateliers-et-cours/art-spiritualite-une-aventure-vers-la-revelation-de-soi-ste-therese/"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-03-28T13:00:00-04:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-03-28T16:30:00-04:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g515620"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g515660"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://ateliersbananart.com/ateliers-et-cours/liste/?eventDisplay=past"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Art &#038; Spiritualité &#8211; CERCLE DE MÉTAMORPHOSE SACRÉE &#8211; Ste-Thérèse"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "&lt;p&gt;Une journée pour t’aimer, te révéler et t’honorer Et si, le temps d’un après-midi, tu t’offrais une parenthèse rien que pour toi? Une pause pour reconnecter avec ton image, ton essence et ta vérité intérieure? Nous t’invitons à une expérience unique, où l’art et la photographie se rencontrent pour révéler ta lumière. Nous avons imaginé cette journée comme une véritable déclaration/révélation à toi-même. Une invitation à t’accueillir pleinement, à embrasser chaque parties de toi, sans filtre ni jugement. À travers [&hellip;]&lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Organization"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
  {
    "@id": "https://ateliersbananart.com/temporary/01360347-b9a5-42d8-924e-f2ca8a40e8d5",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/image": [
      {
        "@id": "https://ateliersbananart.com/wp-content/uploads/2025/06/10h30-25.png"
      }
    ],
    "http://schema.org/url": [
      {
