    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "CIRQUE  — Après deux mois de métamorphose, La Chapelle ouvre ses portes de nouveau. C’est notre spectacle  “SANTÉ”  qui a été choisi afin de culminer cette occasion. Notre performance sera suivie d’une session de questions.&nbsp;  Donc, le  30 septembre  prochain à  13h30 , c’est un rendez-vous"
      }
    ],
