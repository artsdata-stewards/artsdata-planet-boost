  {
    "@id": "https://www.osq.org/concerts/romeo-et-juliette-de-prokofiev/#event",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.osq.org/concerts/romeo-et-juliette-de-prokofiev/"
      }
    ],
    "http://schema.org/location": [
