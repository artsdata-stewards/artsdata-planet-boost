  {
    "@id": "https://www.osq.org/concerts/le-3e-concerto-pour-piano-de-rachmaninov/#event",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.osq.org/concerts/le-3e-concerto-pour-piano-de-rachmaninov/"
      }
