        "@language": "fr-fr",
        "@value": "La mystérieuse métamorphose de Monsieur et Madame Tacet | Orchestre symphonique de Québec"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "Monsieur et Madame Tacet découvrent un monde insoupçonné dans cette aventure musicale où les enfants explorent les familles d’instruments et savourent la musique symphonique."
      }
    ],
