    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Singer, songwriter and entertainer Terry Kelly will be bringing his magical voice to the Miles MacDonald Performance Centre on Sunday October 22nd @ 2pm. Terry Kelly’s artistic achievements are [...]"
      },
      {
        "@language": "en-us",
        "@value": "Singer, songwriter and entertainer Terry Kelly will be bringing his magical voice to the Miles\n\nMacDonald Performance Centre on Sunday October 22nd @ 2pm.\n\nTerry Kelly’s artistic achievements are many and varied. They range from awards via his peers,\n\nsuch as his seven ECMA’s to unique special projects that were commissioned to celebrate events\n\nor draw attention to societal"
      }
    ],
