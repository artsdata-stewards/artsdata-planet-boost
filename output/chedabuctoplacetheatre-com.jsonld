    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Ennis Sisters - Miles MacDonald Performance Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The Ennis Sisters are a JUNO award-winning trio hailing from St. John’s, Newfoundland & Labrador.  They have been captivating audiences worldwide for over 25 years with their seamless harmonies and [...]"
      },
      {
        "@language": "en-us",
        "@value": "The Ennis Sisters are a JUNO award-winning trio hailing from St. John’s, Newfoundland & Labrador.  They have been captivating audiences worldwide for over 25 years with their seamless harmonies and compelling songwriting. Flavoured by Celtic and traditional Newfoundland influences, their music offers a broad mix of original songs as well as uniquely interpreted tunes and ballads.\n\nIn 1997,"
      }
    ],
