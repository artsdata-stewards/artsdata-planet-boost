    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The music you remember, the way you remember it. Join us for an evening of heartfelt music and celebration as Jenn Sheppard backed by the Vinyl 33 band and Georges Hebert, Anne’s original guitar player, honour the iconic song catalogue of Anne Murray."
      }
