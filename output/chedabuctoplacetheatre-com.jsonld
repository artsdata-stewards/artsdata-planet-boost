    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "NOT DEAD YET COMEDY TOUR - Miles MacDonald Performance Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Belynda Cleare will make a stop in Guysborough during the 'Not Dead Yet Comedy Tour' - a show you won't want to miss. Belynda will be joined by talented friends Marc Kaye & Maureen Ferguson on July 20th during Guysborough Come Honme Week. The show begins at 7pm. Advance tickets can be purchased at the Chedabucto Lifestyle Centre or by phoning the box office at 902-533-2015. Tickets are $20. This show will benefit the Guysborough Development Society. Don't forget to join us at The Jost for an afterparty! Details coming soon!"
      },
      {
        "@language": "en-us",
        "@value": "Benefits for The Guysborough Waterfront Development Society\n\nBelynda Cleare will make a stop in Guysborough during the 'Not Dead Yet Comedy Tour' - a show you won't want to miss. Belynda will be joined by talented friends Marc Kaye & Maureen"
      }
    ],
