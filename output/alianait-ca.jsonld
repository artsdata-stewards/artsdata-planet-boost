    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Come join us for Alianait Arts Festival opening night! Pangnirtung's own Joey Nowyuk will be opening this exciting night and will be followed by Greenland's Nick Ørbæk. Then, we will have Maten on stage for a stellar performance and ending the night is Juno winning Digging Roots!"
      }
