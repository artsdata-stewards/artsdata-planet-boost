    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Becky Han is a singer-songwriter who records primarily in Inuktut. She has won the Qilaut song-writing competition twice and has the illustrious honour of opening for Tanya Tagaq. Her music celebrates the vibrant Inuktut music scene and maintains her connection to home."
      }
    ],
