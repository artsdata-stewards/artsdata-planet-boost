    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Colleen Nakashuk, who performs as Aasiva, is a rising star in the Canadian music scene, nominated for two Indigenous Music Awards last year. Her music is airy and lively, and her lyrics are fun and playful. Aasiva’s music offers a fresh, buoyant and distinctive twist on indie folk."
      }
