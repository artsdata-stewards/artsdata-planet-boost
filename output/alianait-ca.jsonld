        "@value": "Alianait"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "ᓛᓴᕆ ᖃᑦᑕᓕᒃ Lazarus Qattalik — Alianait"
      }
    ],
    "http://ogp.me/ns#latitude": [
      {
        "@language": "en-ca",
        "@value": "63.7440194"
      }
    ],
    "http://ogp.me/ns#longitude": [
      {
        "@language": "en-ca",
        "@value": "-68.51171349999998"
      }
    ],
    "http://ogp.me/ns#locality": [
      {
        "@language": "en-ca",
        "@value": ""
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
        "@value": "https://alianait.ca/events-list/2020/3/19/-lazarus-qattalik"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-ca",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "ᖁᕕᐊᓱᑉᐳᒍᑦ ᑐᓴᖅᑎᑦᑎᒋᐊᔅᓴᖅ ᓄᓇᕘᒥ ᑕᑯᔅᓴᐅᑲᐅᑎᒋᔪᒥᒃ: ᐃᓐᖏᖅᑐᓂᒃ ᐃᓕᓐᓂᐊᑎᑦᑎᓂᕐᓂᓪᓗ ᖃᕋᓴᐅᔭᒃᑯᑦ ᑕᑯᔅᓴᐅᑎᑦᑎᖃᑦᑕᕐᓂᐊᕋᑦᑕ ᐊᖏᕐᕋᖏᓐᓃᖔᖅᑐᓂᒃ ᐃᓐᖏᖅᑏᑦ. ᑕᒪᓐᓇ ᑲᔪᓯᒍᓐᓇᖅᑎᑕᐅᔪᖅ ᐃᑲᔪᖅᑕᐅᓪᓗᑕ ᐱᕙᓪᓕᐊᔪᓕᕆᔨᒃᑯᑦ ᐃᖏᕐᕋᔪᓕᕆᔨᒃᑯᓪᓗ ᒐᕙᒪᒃᑯᓐᓂ ᐃᓐᖏᕐᓂᕐᒥ ᑲᔪᓯᖁᔨᓪᓗᑕ ᓂᔾᔭᐅᓯᔭᕐᓂᒥᓪᓗ ᐊᑭᓕᖅᓱᖅᑕᐅᓗᑎᒃ ᓂᔾᔭᐅᓯᔭᖅᑏᑦ ᐃᓐᖏᖅᑏᓪᓗ. ᑕᒧᓗᒐᔅᓴᓂᒃ ᑎᒍᓯᓗᓯ ᑕᑯᕋᓐᓈᖃᑕᐅᖃᑦᑕᓂᐊᖅᑯᓯ  ᐱᒋᐊᕈᑎᖃᕐᓂᐊᖅᑐᒍᑦ 7ᒥ ᐅᓐᓄᒃᑯᑦ ᒫᓯ 27 ᑕᑯᔅᓴᐅ"
      }
    ],
