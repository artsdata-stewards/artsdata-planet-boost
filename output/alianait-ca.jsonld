    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "ᓵᓚᑦ ᖃᒪᓂᖅ + ᕋᐃᔅ ᐋᓴᓐ ᑖᒃᑯᓇᙵᑦ ᓯᓚ ᐊᒻᒪ ᕋᐃᔅ, ᐊᐃᕗᕆ ᑮᓇᐃᓐᓇᖅ, ᑯᕆᔅᑎ ᑭᖕ, ᕕᓕ ᖁᖅᓱᖅ Charlotte Qamaniq + Rise Ashen of Silla and Rise, Avery Keenainak ,Kristy King &amp; Billy Kuksuk — Alianait"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
