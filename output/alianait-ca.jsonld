    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A pan-territorial celebration of northern artists showcasing performers from all three territories. From the North weaves together stories, music and dance from some of the North’s most talented artists: IVA, Riit Mike, Quantum Tangle, NÀHGĄ, Sophie Villeneuve, Borealis Soul, and the Dakhká Khwáan D"
      }
