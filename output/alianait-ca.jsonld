  {
    "@id": "https://alianait.ca/events-list/2020/6/21/21-national-indigenous-peoples-day",
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en-ca",
        "@value": "Alianait"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "21 ᑲᓇᑕᓕᒫᒥ ᓄᓇᖃᖅᑳᖅᓯᒪᔪᑦ ᐅᓪᓗᖓᓂ National Indigenous Peoples Day — Alianait"
      }
    ],
    "http://ogp.me/ns#latitude": [
      {
        "@language": "en-ca",
        "@value": "63.7440194"
      }
    ],
    "http://ogp.me/ns#longitude": [
      {
        "@language": "en-ca",
        "@value": "-68.51171349999998"
      }
    ],
