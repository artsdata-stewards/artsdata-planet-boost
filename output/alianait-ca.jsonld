  {
    "@id": "https://alianait.ca/events-list/2020/6/21/21-national-indigenous-peoples-day",
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en-ca",
        "@value": "Alianait"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "21 ᑲᓇᑕᓕᒫᒥ ᓄᓇᖃᖅᑳᖅᓯᒪᔪᑦ ᐅᓪᓗᖓᓂ National Indigenous Peoples Day — Alianait"
      }
    ],
    "http://ogp.me/ns#latitude": [
      {
        "@language": "en-ca",
        "@value": "63.7440194"
      }
    ],
    "http://ogp.me/ns#longitude": [
      {
        "@language": "en-ca",
        "@value": "-68.51171349999998"
      }
    ],
    "http://ogp.me/ns#locality": [
      {
        "@language": "en-ca",
        "@value": ""
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
        "@value": "https://alianait.ca/events-list/2020/6/21/21-national-indigenous-peoples-day"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-ca",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "ᓇᓪᓕᐅᓂᖅᓯᐅᖃᑕᐅᒋᔅᓯ ᑲᓇᑕᒥ ᓄᓇᖃᖅᑳᖅᓯᒪᔪᑦ ᐅᓪᓗᖓᓐᓂᑦ, ᔫᓂ 21 ᐅᓐᓄᒃᑯᑦ 7ᒥ.  ᑕᑯᔅᓴᐅᑲᐅᑎᒋᔪᓂᑦ ᑕᑯᕋᓈᖅᑎᑦᑎᓛᖅᑐᒍᑦ ᐃᒡᓗᓕᒥ, ᐊᒻᒪ ᐃᓱᒪ ᑕᑯᓇᕋᔅᓴᓕᕆᔨᒃᑯᑦ ᐱᖃᑎᒋᓗᑎᒍᑦ!  Come celebrate National Indigenous Peoples Day with us on Sunday, June 21st at 7pm. We will be streaming live from Igloolik, and partnering with Isuma TV!   ᑕᑯᔅᓴᐅᑎᑦᑎᓗᑕ: ᒫᑕᓖ ᐃᕙᓗ"
      }
    ],
