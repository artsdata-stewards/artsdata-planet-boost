    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Celebrate Embrace Life Day with the music of Nick Sherman, an indigenous artist from Sioux Lookout describe as the voice of the wilderness. Opening artists are a lovely duo - Colleen Nakashuk &amp; Teresa Kolola, who sing original Inuktitut songs accompanied on their ukeleles.  Adults $20, Youth"
      }
    ],
