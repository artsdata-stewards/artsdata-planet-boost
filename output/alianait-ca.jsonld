    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "ᕇᑦ&nbsp;ᐃᓐᖏᒐᓕᐅᖅᑎ,&nbsp;ᑲᑕᔾᔭᖅᑎ,&nbsp;ᐃᓐᖏᕈᑎᒧᑦ&nbsp;ᓂᔾᔭᐅᓯᔭᖅᑎ&nbsp;ᓂᐱᖓ&nbsp;ᑐᓴᖅᓴᐅᔪᖅᑐᓴᕐᓂᖅᑑᓪᓗᓂ&nbsp;ᒧᒥᕐᓇᕈᓐᓇᖅᑐᓂᓗ.&nbsp;ᓂᐱᓕᐊᒥᓂᕐᒥᓂᒃ&nbsp;ᓄᐃᑎᑦᑎᓚᐅᖅᑎᓪᓗᒍᐊᕐᕌᓂ&nbsp;ᐊᐅᔭᒃᑯᑦ,&nbsp;ᕇᑦ&nbsp;ᓂᕈᐊᕋᔅᓴᕈᖅᓯᒪᔪᖅ&nbsp;ᐃᓕᓴᕆᔭᐅᓂᕐᒧᑦ&nbsp;ᐃᓐᖏᖅᑎᐅᓪᓗᓂᐃᓄᑑᓪᓗᓂ&nbsp;ᓈᓚᐅᑎᒃᑯᑦ&nb"
      }
    ],
