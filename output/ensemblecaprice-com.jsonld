        "@id": "https://www.ensemblecaprice.com/concert/concertos-brandenburg-qc"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Bach's Brandenburg Concertos"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The instrumental music of J. S. Bach is a high point of the Baroque era. Immerse yourself in the timeless beauty of Bach's Brandenburg Concertos with a captivating performance by Ensemble Caprice, conducted by Matthias Maute. The program includes Brandenburg Concertos 1, 3 and 4, and the Orchestral Suite No. 3 with its famous piece, better known as \"Air on the G String\".\n\nProgram:\nJohann Sebastian Bach\nBrandenburg Concertos No 1, 3 and 4, BWV 1046, 1048 1049\nOrchestral Suite No.3 in D major, BWV 1068"
      }
    ],
    "http://schema.org/keywords": [
      {
        "@language": "en",
        "@value": "Salle Raoul-Jobin, Bach's Brandenburg Concertos, Ensemble Caprice, baroque, concert, concerts, upcoming, à venir"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
