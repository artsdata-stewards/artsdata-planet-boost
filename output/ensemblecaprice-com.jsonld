        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image:alt": [
      {
        "@language": "en",
        "@value": "Bach’s St Matthew Passion image"
      }
    ],
    "http://ogp.me/ns#keywords": [
      {
        "@language": "en",
        "@value": "Maison symphonique, Bach’s St Matthew Passion, Ensemble Caprice, baroque, concert, concerts, classical, classique, upcoming, à venir"
      }
