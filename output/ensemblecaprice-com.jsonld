    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Le Messie de Haendel"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Fidèle à sa tradition des Fêtes, l’Ensemble Caprice vous invite à célébrer le Messie emblématique de Haendel.\nLaissez-vous emporter par la joie, l’éclat et la puissance de ce chef-d’œuvre baroque intemporel, présenté par l’Ensemble Caprice en collaboration avec l’Ensemble ArtChoral et le Festival Classica, sous la direction de Matthias Maute."
      }
    ],
    "http://schema.org/keywords": [
      {
        "@language": "fr",
        "@value": "Maison symphonique, Le Messie de Haendel, Ensemble Caprice, baroque, concert, concerts, upcoming, à venir"
      }
