  {
    "@id": "https://www.ensemblecaprice.com/concert/passion-mtl-2027",
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Bach’s St Matthew Passion stands as a monument of the sacred repertoire, where music, narrative, and meditation become one.\nA profoundly moving masterpiece.\nThe St Matthew Passion is a musical fresco of rare intensity, in which narration, choruses, and solo arias respond to one another in gripping dramatic tension.\nPresented in its entirety by Ensemble Caprice and Ensemble ArtChoral under the direction of Matthias Maute, this interpretation promises a powerful, immersive, and deeply moving experience.\nA great musical moment to be lived — an experience to be shared."
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://static.wixstatic.com/media/5e586c_b8663286f1ed432bb272c1ecd02bb82d~mv2.jpg/v1/fit/w_2500,h_1330,al_c/5e586c_b8663286f1ed432bb272c1ecd02bb82d~mv2.jpg"
      }
    ],
    "http://ogp.me/ns#image:width": [
      {
