  {
    "@id": "https://www.ensemblecaprice.com/fr/concert/flute-enchante",
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Aventure, humour et magie lumineuse : dans son ultime opéra, Mozart nous entraîne dans un voyage fascinant où la musique transforme tout.\nÀ travers le parcours de Tamino et Pamina, courage, amour et harmonie prennent vie dans une partition d’une beauté irrésistible. Présentée en version concert (sans dialogues parlés), cette interprétation dirigée par Matthias Maute, avec l’Ensemble Caprice et six solistes, révèle tout l’éclat et la richesse expressive de ce chef-d’œuvre."
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://static.wixstatic.com/media/5e586c_8c26ce52b8964c10a73fb94e526055cb~mv2.jpg/v1/fit/w_2500,h_1330,al_c/5e586c_8c26ce52b8964c10a73fb94e526055cb~mv2.jpg"
