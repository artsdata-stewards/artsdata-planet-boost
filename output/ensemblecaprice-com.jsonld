        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image:alt": [
      {
        "@language": "fr",
        "@value": "La neuvième de Beethoven image"
      }
    ],
    "http://ogp.me/ns#keywords": [
      {
        "@language": "fr",
        "@value": "Maison symphonique, La neuvième de Beethoven, Ensemble Caprice, baroque, concert, concerts, classical, classique, upcoming, à venir"
      }
    ],
