    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;The final stop of our 2024 Tuckamore Travels Tour will feature the Young Artist Touring group, the Miltenberg Trio, performing a program of exciting chamber music, including a brand new work composed by a 2024 Young Artist Composer in the unique James Baird Gallery.&lt;/p&gt;\\n"
