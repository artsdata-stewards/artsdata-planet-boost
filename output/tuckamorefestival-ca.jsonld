      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Suncor Energy Hall (previously Petro-Canada Hall) seats about 120, and has extensive multimedia and recording capabilities as well as rich acoustics. The hall is equipped with a 9-foot Kawai piano. Suncor Energy Hall is located in the Memorial University School of Music. It is entirely wheelchair accessible including all entrances and washrooms, as well as... &lt;a class=&quot;read-more&quot; href=&quot;https://tuckamorefestival.ca/venue/suncor-energy-hall/&quot;&gt;Read&nbsp;More&lt;/a&gt;&lt;/p&gt;\\n"
