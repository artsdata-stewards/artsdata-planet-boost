    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Our 23rd season continues with a special post-festival tour featuring one talented 2023 Young Artist trio. The trio will pack their bags and head west for their first stop at the Rotary Arts Centre in stunning Corner Brook.  Free admission.&lt;/p&gt;\\n"
      }
