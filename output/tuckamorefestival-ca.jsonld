        "@language": "en",
        "@value": "Young Artist Masterclass with Sharon Wei"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Our 2024 Young Artists perform for and get coached by the Juno-winning Sharon Wei, violist of the New Orford String Quartet and professor of viola at Western University. This masterclass in D.F. Cook Recital Hall is free and open to the public.&lt;/p&gt;\\n"
      }
