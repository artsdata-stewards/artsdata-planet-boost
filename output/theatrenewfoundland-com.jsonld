      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;TNL is pleased to offer an arts education program for youth in the Gros Morne region spanning kindergarten to grade 7! Students enrolled in this program get to participate in drama, music, visual arts, and culinary arts classes at the Nurse Myra Bennett Centre for Performing Arts, in Cow Head. Click here to register! Questions?...&lt;/p&gt;\\n"
      }
