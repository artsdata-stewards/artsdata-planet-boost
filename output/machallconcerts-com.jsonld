    "https://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "DYING FETUS established a reputation for uncompromising integrity with a slew of classic albums and today rides a resurgence of respect and esteem with a new generation. As Revolver Magazine wrote upon the release of their first new material since 2017’s Wrong One To Fuck With: “Their unique sound has always straddled the line between"
      }
