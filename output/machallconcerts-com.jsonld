    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "My Name is NOT Mom is a hilarious journey through motherhood with internet sensations Tiffany Jenkins, Meredith Masony and Dena Blizzard. After helping millions of fans get through the pandemic, this comic trio shares their take on mothering through the sleepless nights of the toddler..."
      }
    ],
    "http://schema.org/about": [
      {
        "@language": "en",
        "@value": "My Name is NOT Mom is a hilarious journey through motherhood with internet sensations Tiffany Jenkins, Meredith Masony and Dena Blizzard. After helping millions of fans get through the pandemic, this comic trio shares their take on mothering through the sleepless nights of the toddler years, middle school craziness and trying not to physically attack a high schooler.\n\nThis special live event features stand-up, stories and videos from their online community and audience interaction to create an up close and personal experience that’s funnier than a pap smear."
      }
    ],
