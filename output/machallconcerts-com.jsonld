    "https://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Just For Laughs is thrilled to announce that actor, director and broadcaster Tom Green is bringing his unique, anything-goes brand of comedy to 30 cities across Canada. The 2025-26 Tom Green: Stompin’ Comedy Tour will treat audiences to an evening of Green’s hysterical comedy, along with stories about his career and a selection of original"
      }
