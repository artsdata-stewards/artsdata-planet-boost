    "http://schema.org/about": [
      {
        "@language": "en",
        "@value": "MRG LIVE Presents: TRIVIUM Deadmen &amp; Dragons Tour\nWith Guests: Between the Buried and Me (BTBAM) // Whitechapel // Khemmis\n\nTrivium is an American heavy metal band from Orlando, Florida, formed in 1999. After getting signed to Roadrunner Records in 2004, the band has released eight studio albums and over twenty singles. Their latest album, The Sin and the Sentence, was released on October 20, 2017. The band has sold over one million albums worldwide. "
      }
