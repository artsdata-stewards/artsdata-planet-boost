    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Calgary, after the huge success of Hamza’s recent album Raye2, we are excited to announce that Hamza will be performing once again in Calgary on April 14, 2023. Brought to you by Rogue Virtue, the show will feature many of..."
      }
    ],
    "http://schema.org/about": [
      {
        "@language": "en",
        "@value": "Calgary, after the huge success of Hamza’s recent album Raye2, we are excited to announce that Hamza will be performing once again in Calgary on April 14, 2023.\n\nBrought to you by Rogue Virtue, the show will feature many of his greatest hits! With over 20 million followers on social media and 1+ billion plays on YouTube, Hamza Namira is one of the top Arab-pop stars and has achieved unprecedented success. This is guaranteed to be an unforgettable experience, so don't miss out!"
      }
    ],
