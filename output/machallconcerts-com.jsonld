    "http://schema.org/image": [
      {
        "@id": "https://machallconcerts.com/wp-content/uploads/2022/10/Alvvays-By-Eleanor-Petry-crop.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://machallconcerts.com/event/alvvays/"
