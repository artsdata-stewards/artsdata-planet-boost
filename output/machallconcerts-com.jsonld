    "https://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "SLAVA KOMISSARENKO - MacHall Concerts"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Slava Komissarenko, a stand-up comedian from Belarus, will perform in Calgary on June 10th at MacEwan Hall stage with a new program. His YouTube videos are gaining millions of views, and his laid-back style of performances can charm and make even the most sullen viewer laugh. His powers of observation make simple speculations about everyday"
      }
    ],
