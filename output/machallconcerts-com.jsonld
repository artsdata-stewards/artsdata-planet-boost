    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "MERSIV: The Audiosphere Tour"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "with KNOW GOOD and GABBY HAZE. Mersiv has been constantly evolving and innovating the genre of dubstep, between a busy release schedule and his label MorFlo Records . His breakout single “Beautiful &amp; Filthy”, debut album Pretty Dark Loud, and energetic..."
      }
    ],
    "http://schema.org/about": [
      {
        "@language": "en",
        "@value": "with KNOW GOOD and GABBY HAZE.\n\nMersiv has been constantly evolving and innovating the genre of dubstep, between a busy release schedule and his label MorFlo Records . His breakout single “Beautiful &amp; Filthy”, debut album Pretty Dark Loud, and energetic touring helped him become a leading voice in the Freeform Bass genre. He pioneered a genre-blurring style he calls “Pretty Dark Loud”, blending emotional melodies, dubstep, and visceral sonic textures to create immersive experiences. Catch Mersiv as he takes over Macewan Hall for a special Audiosphere performance Saturday, November 22nd.\n\nPresented by STACKED"
      }
    ],
    "http://schema.org/doorTime": [
      {
        "@language": "en",
        "@value": "21:00"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "en",
        "@value": "P0DT2H0M"
      }
    ],
