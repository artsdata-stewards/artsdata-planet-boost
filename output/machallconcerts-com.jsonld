    "http://schema.org/image": [
      {
        "@id": "https://machallconcerts.com/wp-content/uploads/2021/11/JFL_Vir22_Social_Facebook_1200x630.png"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://machallconcerts.com/event/vir-das/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
