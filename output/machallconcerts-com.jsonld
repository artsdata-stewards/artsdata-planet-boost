    "http://schema.org/about": [
      {
        "@language": "en",
        "@value": "Due to an unforeseen medical issue, Action Bronson will no longer be able to perform on the Western Canadian dates of the ÑBA LEATHER TOUR. Earl Sweatshirt will still be headlining along with support from The Alchemist and Boldy James.\n\nRefund requests will be accepted to all tickets prior to entry to the venue.\n\nWe wish Action Bronson a speedy recovery and we apologize to fans for any inconvenience this may have caused. We are still looking forward to these amazing experiences on the ÑBA LEATHER TOUR.\n\n\nwith The Alchemist, Boldy James"
      }
