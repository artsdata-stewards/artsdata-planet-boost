    "https://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Come to experience Hamza Namira live in Calgary for an outstanding time on May 7th in MacEwan Hall! Brought to you by Rogue Virtue, the show will feature many of his greatest hits! With over 8 million followers on social media and 700 million plays on YouTube, Hamza Namira is one of the top Arab indie-pop"
      }
    ],
