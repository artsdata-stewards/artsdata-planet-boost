    "https://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "JUST FOR LAUGHS: ASHLEY GAVIN - MacHall Concerts"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Ashley Gavin is a stand-up comedian based in New York City. She's been featured on Netflix is a Joke, Hulu, Comedy Central, but is best known for her viral crowd work videos on TikTok and her top charting podcast We’re Having Gay Sex. Ashley is admired for her confidence, authenticity, and unrelenting energy on stage."
      }
    ],
