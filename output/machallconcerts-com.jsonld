      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "The event organizer has made the unfortunate decision to cancel The Beaches concert for February 26. Refunds are available through point of purchase. With Special Guests, The Blue Stones! Named appropriately after the Toronto neighbourhood they all hail and hang in, The Beaches are authentically rock ‘n’ roll. Their‘70s aesthetic, unapologetic attitude and electrifying sound"
      }
    ],
