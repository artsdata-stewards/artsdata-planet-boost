      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Following his incredibly successul 2022 Canadian Tour, Just For Laughs is thrilled to announce that Dara Ó Briain is returning to Canada with a brand new live stand-up show. ‘So… Where Were We?’. At the end of his highly successful last tour ‘Voice Of Reason’, Dara had performed the show 180 times over 2 years"
      }
    ],
