    "http://schema.org/about": [
      {
        "@language": "en",
        "@value": "Come to experience Hamza Namira live in Calgary for an outstanding time on May 7th in MacEwan Hall!\n\nBrought to you by Rogue Virtue, the show will feature many of his greatest hits! With over 8 million followers on social media and 700 million plays on YouTube, Hamza Namira is one of the top Arab indie-pop stars and has had unprecedented success. This is sure to be an unforgettable time so don't miss out!"
      }
