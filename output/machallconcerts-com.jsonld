    "https://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "With guests Big Rig. Alvvays never intended to take five years to finish their third album, the nervy joyride that is the compulsively lovable Blue Rev. In fact, the band began writing and cutting its first bits soon after releasing 2017’s Antisocialites, that stunning sophomore record that confirmed the Toronto quintet’s status atop a new"
      }
