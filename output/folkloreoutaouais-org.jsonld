    "http://schema.org/performer": [
      {
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Bonjour à tous,    Jam Trad transfert ses activités sur ZOOM contactez nous si vous souhaitez y participer        Chacune et chacun présente sa musique et à sa vitesse, avec son instrument préféré : violon, accordéon, guitare, mandoline et autres! La chanson folklorique est aussi la bienvenue! Le répertoire est principalement du folklore québécois et ses nombreux variants irlandais, écossais et canadiens. Aucune inscription ou réservation nécessaires! Bienvenue aux spectateurs."
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Jam Trad en ZOOM"
      }
    ],
