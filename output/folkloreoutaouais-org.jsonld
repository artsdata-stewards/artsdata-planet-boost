    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://folkloreoutaouais.org/events/jam-trad-au-casse-croute-patalou/"
      }
    ],
    "http://schema.org/performer": [
      {
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Bonjour à tous! - Voici une invitation &quot;alléchante&quot; à partager entre musicien(ne)s amateurs du trad!    Le casse-croûte PATALOU à Plaisance souhaite être l’hôte de Jam trad durant la saison estivale! Ainsi, l’après-midi des 26 et 27 juin (13h00 à 17h00), les musicien(ne)s sont invités(e)s à prendre place sur la terrasse et pousser leurs airs traditionnels, à la bonne franquette!    Venez faire votre tour pour partager ce folklore et faire des mini-retrouvailles! Évidemment, nous comptons sur votre collaboration pour « respecter les mesures sanitaires » en vigueur... (vous savez ce que cela implique...) Grand merci pour votre collaboration, et au grand plaisir de vous retrouver bientôt!    Casse-croûte Patalou : 237, rue Principale (route 148) à Plaisance"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Jam Trad au Casse-croûte Patalou"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
