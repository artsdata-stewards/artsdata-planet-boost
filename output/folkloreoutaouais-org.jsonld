      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Dans le cadre du &quot;Cube culturel&quot; de la Ville de Gatineau, Folklore Outaouais invite les amateurs de musique folklorique pour une soirée musicale à la bonne franquette!    Joignez-vous au son des reels, des gigues, des valses ou de chanson à répondre! Apportez votre instrument, sortez les cuillères, tapez des pieds... et en avant la musique!"
      }
    ],
    "http://schema.org/name": [
