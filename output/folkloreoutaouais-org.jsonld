      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://folkloreoutaouais.org/events/jam-trad-en-zoom/"
      }
    ],
    "http://schema.org/performer": [
      {
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "  Bonjour à tous !        Nous vous proposons des « Jam Trad en Zoom » ! Nous avons des sessions les lundis soir et les samedis soir, de 19 heures à 21 heures. Chacune et chacun présente sa musique à sa vitesse avec son instrument : violons, accordéons, guitares, mandoline et parfois d’autres instruments. Le répertoire est principalement du folklore Québécois et Irlandais.                Si ça vous intéresse, veuillez nous envoyer un courriel vers info@folkloreoutaouais.org pour vous joindre à cette activité. Vous pouvez bien sur simplement écouter et regarder, et nous faire un beau sourire.  "
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Jam Trad en Zoom"
      }
    ],
