    "http://schema.org/description": [
      {
        "@value": "Le spectacle Hommage à La Bolduc présenté le samedi 14 septembre au matin à la Place du Marché de Ripon est un collectif d’artistes réunissant chanteuses et musiciens qui s’unissent pour mettre en valeur et honorer l’œuvre de Mme Mary Travers, dîtes « La Bolduc ».    GRATUIT"
      }
    ],
