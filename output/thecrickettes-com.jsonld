      {
        "@language": "en",
        "@value": "Silly Song Workshop with The Crickettes | The Crickettes"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Join us for a delightful children's program, Writing Silly Songs with The Crickettes! In collaboration with the Calgary Public Library, this fun-filled program is for kids ages 6-9, and ages 4-6 can join in with their parents. Don’t miss out—register now through the Calgary Public Library"
