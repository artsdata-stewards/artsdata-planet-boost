    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Zoe Guigueno (GIG-an-oh) is a bassist & songwriter headquartered in New York City. A jazz-trained, story-telling folk musician, Zoe’s music is constructed from images and sounds that reflect her 20 years of experience as a touring musician."
      }
