  {
    "@id": "https://www.tofinotheatre.com/events/halibut-cowboys-tofino-jazz-fest-2025",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "HALIBUT COWBOYS - Tofino Jazz Fest 2025  | CSCTA"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Formed one dark day in a stormy January, the Halibut Cowboys came together to throw down grooves and funky tunes that loosen up even the stiffest of hips. Inspired by jazz, neo-psychedelia, surfing and Herbie Hancock, these angry pancakes love to play and dance the nights away."
      }
    ],
    "http://ogp.me/ns#image": [
