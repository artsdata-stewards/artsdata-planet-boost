      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Ocie Elliott pen tunes that feel lived-in. You can hear their memories, experiences, and emotions in the dusty acoustic guitars, the sparse production, and the graceful harmonies between Jon Middleton and Sierra Lundy."
