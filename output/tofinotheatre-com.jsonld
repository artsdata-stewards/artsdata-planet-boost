        "@language": "en",
        "@value": "MOONTRICKS with special guest MIINA | CSCTA"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Based in the rustic Kootenay mountains of Western Canada, Nathan Gurley and Sean Rodman of nationally renowned electro-folk duo Moontricks draw inspiration from the ongoing cycles of the natural world."
      }
    ],
