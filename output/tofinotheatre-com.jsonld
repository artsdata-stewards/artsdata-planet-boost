  {
    "@id": "https://www.tofinotheatre.com/events/amphibioux-sara-magal",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "AMPHIBIOUX + SARA MAGAL | CSCTA"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Prepare to be swept away on a captivating journey through the soul-stirring world of Brazilian music as two of the most inspiring Brazillian-Canadian emerging artists, Amphibioux and Sara Magal, grace the stage in their first appearance in Tofino."
      }
    ],
