  {
    "@id": "https://www.tofinotheatre.com/events/single-fin-sessions-theory-class-with-lydia-ricard",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Single Fin Sessions - Theory class  | Clayoquot Sound Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "With almost 8 years of practice in longboarding, 3 silver medals in the Canadian Championships, participating international competitions, Lydia is bringing us together to share her knowledge. She believes that surfing should be fun, and it’s even more fun when you can progress!"
      }
    ],
    "http://ogp.me/ns#image": [
