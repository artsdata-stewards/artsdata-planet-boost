  {
    "@id": "https://www.tofinotheatre.com/events/single-fin-session-with-lydia-ricard-3",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Single Fin Session with Lydia Ricard   | CSCTA"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "In this in depth surfing theory class, you will learn about longboarding styles, equipment choice, wave choice, different types of take-offs, cross-step techniques, and of course noseriding."
      }
    ],
    "http://ogp.me/ns#image": [
