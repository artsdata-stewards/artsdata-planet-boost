      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Sully and friends is an evening of stories & tunes highlighting the wonderful and unlikely connections that music can bring in a small community."
      }
    ],
    "http://ogp.me/ns#image": [
