    "http://schema.org/name": [
      {
        "@value": "Elinor Frey Plays Bach's Cello Suites"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Join us for two enchanting evenings as Elinor Frey, the acclaimed Canadian cellist, delivers a spellbinding performance of all six of Bach's timeless Cello Suites. Immerse yourself in the peak of musical artistry. This first night features Suites 1, 4, &amp; 5."
      }
    ],
