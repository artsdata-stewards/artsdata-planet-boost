    "http://schema.org/organizer": [
      {
        "@id": "_:g1879920"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "http://www.kamloopssymphony.com/alexcubaconversation/default.htm"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "In Conversation: Alex Cuba"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><span style=\"color: rgba(0, 0, 0, 1)\">Join us at the KSO Music School at Kelson Hall on Tues, October 29 at 7:30 PM for an exciting evening with Grammy-winning artist Alex Cuba. Get the inside scoop on his career as an independent artist and as a songwriter and producer, dive into how he creates his unique take on music, and ask him your questions during the live Q&amp;A. This is your chance to learn, have fun, and get inspired by one of the most innovative voices in music. Don’t miss out!</span></p><p><span style=\"color: rgba(0, 0, 0, 1)\">Admission by donation.</span></p>"
      }
    ],
