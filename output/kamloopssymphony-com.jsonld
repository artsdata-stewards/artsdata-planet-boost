    "http://schema.org/name": [
      {
        "@value": "Musical Fairy Tales: Bremen's Musical Brigade"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Experience the charm of the timeless fairytale 'Bremen Town Musicians' and other stories with the Sycamore String Quartet. Enjoy heartwarming tales of friendship and courage with playful melodies and joyful laughter. This relaxed performance has been adapted to suit people who might require a more relaxed environment."
      }
    ],
