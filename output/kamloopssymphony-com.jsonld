    "http://schema.org/name": [
      {
        "@value": "All About That Bass! with Maggie Hasspacher"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Celebrated KSO Principal Bassist curates and performs a set of Canadian premieres. Hear the musical range of this oft-overlooked core of the orchestra and experience what is possible when it's in the heads of a dynamic performer who redefines the boundaries of the instrument."
      }
    ],
