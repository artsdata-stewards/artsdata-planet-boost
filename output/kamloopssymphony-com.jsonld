    "http://schema.org/description": [
      {
        "@value": "The Spirit Horse Returns combines an all-new rich and tuneful orchestral score by Indigenous &amp; Canadian composers, delightful songs, traditional teachings, and stunning colourful visual art. This relaxed performance has been adapted to suit people who might require a more relaxed environment."
      }
