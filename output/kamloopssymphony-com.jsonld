    "http://schema.org/description": [
      {
        "@value": "Experience the grandeur of Handel's masterpiece like never before, featuring a whimsical narration performed by WCT's James MacDonald. An evening of sublime music and a light-hearted tale that brings a fresh twist to this timeless classic."
      }
