    "http://schema.org/description": [
      {
        "@value": "A once-in-a-lifetime concert with the critically acclaimed Canadian pianist. Legendary composers like Debussy, Britten, Vivaldi, Rachmaninov, and more meet Blais' own globally-celebrated works&mdash;a transformative musical experience not to be missed!"
      }
