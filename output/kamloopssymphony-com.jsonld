    ],
    "http://schema.org/description": [
      {
        "@value": "Our KSO Principal Bass gives younger audience members a magical treat by showcasing her instrument through a variety of musical styles and interactive activities. From Bach to jazz, to some of her original music, young audiences will be mesmerized."
      }
