    "http://schema.org/name": [
      {
        "@value": "Tchaikovsky's Symphony No. 5"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Join us as Cvetozar Vutev makes his final appearance as KSO Concertmaster with Tchaikovsky's triumph of the human spirit over fate. Plus! KSO Principal Bass, maggie Hasspacher, transforms the double bass into a source of luminous beauty in Mazzoli's Dark with Expressive Bright."
      }
    ],
