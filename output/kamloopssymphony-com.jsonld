    "http://schema.org/name": [
      {
        "@value": "Mendelssohn's Scottish Symphony"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Witness a rising Canadian star shine! Elisabeth St-Gelais probes the emotional depths of Wagner's reflection of unrequited love and longing. Then take a journey across Scotland's misty highlands in Mendelssohn's Symphony No. 3."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
