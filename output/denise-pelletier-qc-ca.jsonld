    "https://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "La nuit m’avale – Théâtre Denise-Pelletier"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Dans une société où la survie occupe toute la place, La nuit m’avale transforme la pauvreté ordinaire en fable lumineuse. C’est l’été, on suffoque. Les sœurs"
      }
    ],
    "https://ogp.me/ns#url": [
      {
