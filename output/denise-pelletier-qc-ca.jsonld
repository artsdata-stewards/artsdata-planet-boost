    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "La Convivialité"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dogme pour les uns, chemin de croix pour les autres, l’orthographe est un sujet qui déchaîne les passions. Dans une conférence- spectacle pop et iconoclaste, deux acteurs- professeurs questionnent l’orthographe et la langue française dans ce qu’elles ont de plus intimes et de plus politiques. Graphique et enthousiasmant, La Convivialité est un allumeur de débats auxquels le public est invité à prendre part tous les soirs."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "fr",
        "@value": "EventScheduled"
      }
    ],
