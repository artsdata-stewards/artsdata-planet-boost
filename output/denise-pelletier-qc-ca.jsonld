      }
    ],
    "https://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "article"
      }
    ],
    "https://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "On ne badine pas avec l'amour – Théâtre Denise-Pelletier"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Publié en 1834 après le tumulte des amours entre Alfred de Musset et George Sand, On ne badine pas avec l’amour est l’un des plus beaux et cruels dialogues"
      }
    ],
