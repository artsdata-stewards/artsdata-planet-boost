      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Antioche, c’est l’histoire de trois filles emmurées vivantes qui décident de fuir vers l’avant. Et surtout, c’est la fable d’une rencontre improbable dans la ville d’Antioche, en Turquie, là où tout pourrait encore changer."
      }
    ],
    "https://ogp.me/ns#url": [
