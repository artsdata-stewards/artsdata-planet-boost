      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "23 650 lettres en 50 ans d’amour ! À partir de cette monumentale correspondance entre Victor Hugo et Juliette Drouet, Anthéa Sogno a composé cette pièce qui"
      }
    ],
