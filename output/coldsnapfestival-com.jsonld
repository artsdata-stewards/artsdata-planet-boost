    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Prepare for a journey through the surreal back-alleys of North American music. First, get transported to a 1930s speakeasy with raw jug-band blues, ragtime dance numbers, and rattling washboard rhythms. Just as you get settled, the Vipers hit the stage, steering the night into uncharted territory—a"
      }
