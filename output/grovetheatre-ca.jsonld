    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "In 1956 a legendary jam session with Johnny Cash, Jerry Lee Lewis, Carl Perkins and Elvis Presley took place at Sun Records. Featuring rock and roll’s greatest hits and the legends behind the music, Million Dollar Quartet is the ultimate love letter to rock and roll.   July 21, 23, 26 (preview), 28"
      }
