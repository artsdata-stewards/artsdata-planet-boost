    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "A founding member of the band Blue Rodeo and an acclaimed solo artist, Jim Cuddy has written songs that helped put Canadian popular music on the map. The Jim Cuddy Trio perform an intimate night of music at The Grove and end our second season with a bang.  Sam Polley, Opener    Sponsored by The Pier"
      }
    ],
