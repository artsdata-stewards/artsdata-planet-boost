    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Tales of Bravery and Stupidity  is a one man show that is funny and at times touching. Part stand up, part storytelling it looks at some of the bravely stupid things that Bruce has done, and things we all do as we get ourselves in and out of trouble as we “throw ourselves at life.”"
      }
    ],
