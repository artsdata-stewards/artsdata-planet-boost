    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Selling out theatres across Canada, the US and Mexico, Green River Revival performs the greatest hits of CREEDENCE CLEARWATER REVIVAL. Officially licensed by John Fogerty’s Record Company, this amazing CCR Tribute Concert will have you singing at the top of your lungs and dancing in the aisles."
      }
