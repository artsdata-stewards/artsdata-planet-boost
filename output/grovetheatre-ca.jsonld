    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Now in her fourth decade of showbiz, Elvira Kurt is a comedy legend, gay icon and trail-blazing national treasure who has won all the accolades: locally, as a Toronto Fringe Festival Patron’s Pick; nationally, winning both a Canadian Screen Award &amp; Canadian Comedy Award; and internationally,"
      }
