    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://lecarre150.com/spectacles/recital-consolation-alain-lefevre/?rid=13259"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Récital « Consolation »"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "‘’ Désarroi, solitude, impuissance, incertitude et résilience sont autant d’empreintes qui ont marqué notre conscience collective pendant cette dernière pandémie. Privé de mon public, comme tous les artistes des arts de la scène, ce fut une épreuve, conjuguée au pluriel par d’autres dont la souffrance fut encore plus grande. Ce nouvel opus est pour eux… Puisse ma musique apaiser les séquelles et les cicatrices, qu’elles soient physiques ou morales, dans ce monde postpandémique où hélas, l’intolérance, la haine, la violence et les conflits font encore des victimes… Consolation se veut un baume, un havre de paix, un rai de lumière sur notre humanité que je vous invite à partager.’’"
      }
    ]
  },
