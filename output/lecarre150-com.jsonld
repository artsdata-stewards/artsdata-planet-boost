    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://lecarre150.com/spectacles/caity-gyorgy-duo-jazz/?rid=13363"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Duo Jazz"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Rejoignez-nous pour une fantastique soirée de jazz avec la chanteuse et compositrice Caity Gyorgy, l'une des jeunes voix les plus passionnantes du genre au Canada. Triple lauréate d’un prix JUNO, elle séduit pour son swing naturel, son phrasé enjoué et son talent d'improvisation. Inspirée par l'âge d'or du jazz tout en y ajoutant sa touche moderne, elle y apporte une touche moderne, alliant charme et sophistication à chacune de ses performances. En compagnie de son incroyable pianiste Mark Limacher, sa musique fait le pont entre tradition et innovation, mêlant des standards intemporels à des compositions originales qui mettent en valeur sa voix chaleureuse et son timing impeccable. Sur scène, sa présence dynamique et son sens de la narration captivent et transportent le public dans un univers de bonheur et de pur ravissement."
      }
    ]
  },
