  {
    "@id": "https://lecarre150.com/genid/8921a6e47c86b377",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/image": [
      {
        "@id": "https://lecarre150.com/app/uploads/tuxedo/Michel20Barrette_-OckKH-JMHgqgHVmL-iD_.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-21T20:00:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-21T22:00:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://lecarre150.com/genid/19a1380f53b59c9d"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://lecarre150.com/spectacles/michel-barrette-drole-depuis-1957/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://lecarre150.com/spectacles/michel-barrette-drole-depuis-1957/?rid=12009"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Drôle depuis 1957"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dans son tout nouveau spectacle Drôle depuis 1957, Michel Barrette revient en force avec un regard hilarant et tendre sur sa génération. Il y célèbre « la revanche des baby-boomers », ces jeunes d’hier devenus les grands sages d’aujourd’hui… mais toujours aussi irrévérencieux. À travers anecdotes savoureuses, souvenirs touchants et observations mordantes, il nous raconte son époque avec une énergie contagieuse. Entre rires et réflexions, Michel prouve qu’on peut vieillir sans jamais cesser d’être drôle. Ce spectacle est une véritable lettre d’amour au passé… et un clin d’œil bien senti au présent."
      }
    ]
  },
