        "@id": "https://lecarre150.com/spectacles/mat-levesque-beleuet/?rid=14794"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Beleuet"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Natif et habitant toujours au Nord du Lac-Saint-Jean, Mat est un ''raconteux''. Sa parlure et ses anecdotes colorées défi lent à la vitesse d'une bonne toune punk. Il décrit lui-même son style en disant : ''C'est comme du Michel Barrette mais avec ben de la sauce piquante!''Beleuet est son premier one-man-show"
      }
    ]
  },
