    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://lecarre150.com/spectacles/tous-en-mouvement-par-lecole-de-danse-le-claretain/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Par l&rsquo;École de danse Le Clarétain"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le prix affiché dans la billetterie inclut le coût du billet + 3$ de frais de transaction.Plus de 400 danseurs passionnés, accompagnés de 15 chorégraphes débordants de créativité, vous feront découvrir toute l’énergie et le talent de la grande famille de l’École de danse Le Clarétain.Numéro après numéro, laissez-vous emporter par la vibe, les émotions et la magie d’un univers qui bouge, qui raconte et qui fait vibrer.Un spectacle haut en couleur qui fera briller les yeux des petits comme des grands et qui restera longtemps dans vos souvenirs. Bon spectacle !"
      }
    ]
  },
