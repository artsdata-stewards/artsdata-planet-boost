  {
    "@id": "https://lecarre150.com/genid/0f02d8ad88d3e818",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/image": [
      {
        "@id": "https://lecarre150.com/app/uploads/tuxedo/Philippe20Laprise20_-Olg0vmnLIVtuP83csO0_.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-01-30T20:00:00"
      }
    ],
    "http://schema.org/endDate": [
