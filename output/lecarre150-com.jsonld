      {
        "@id": "https://lecarre150.com/spectacles/marthe-laverdiere-jai-dit-oui/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://lecarre150.com/spectacles/marthe-laverdiere-jai-dit-oui/?rid=13645"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "J&rsquo;ai dit oui !"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dans son 2e spectacle, l’inimitable Marthe nous entraîne dans les coulisses de sa nouvelle vie… celle qui a complètement basculé depuis qu’elle est devenue connue.Et fidèle à elle-même, Marthe va encore plus loin et encore plus vite ! Après 45 ans de mariage avec son légendaire Minou, le couple a accumulé une foule d’anecdotes savoureuses et jamais racontées… jusqu’à maintenant.Pour J’ai dit oui !, Marthe retrouve Mario Jean, à la mise en scène et à la script-édition, pour une nouvelle collaboration complice et éclatée."
      }
    ]
  },
