  {
    "@id": "https://lecarre150.com/genid/4204aff8526c8f6a",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/image": [
      {
        "@id": "https://lecarre150.com/app/uploads/tuxedo/Atelier203A20la20Marionnette_-OjXH6gHexfyB5_fSwwF_.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://lecarre150.com/spectacles/atelier-la-marionnette-quen-dit-raton/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://lecarre150.com/spectacles/atelier-la-marionnette-quen-dit-raton/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Qu&rsquo;en dit Raton ?"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Les enfants plongent dans l’univers fascinant des marionnettes en découvrant différents modèles et leurs mécanismes. Ils apprennent à les manipuler avec précision pour leur donner vie et exprimer des émotions à travers le mouvement. Cet atelier stimule la concentration, la coordination et l’imaginaire tout en développant la confiance en soi. Les enfants explorent le langage du corps et des gestes de manière amusante et interactive.Infos pratiques :Durée : 50 minutesÂge recommandé : 4 à 12 ans"
      }
    ]
  },
