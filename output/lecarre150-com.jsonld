      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://lecarre150.com/spectacles/maude-audet-que-ta-lumiere/?rid=14848"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Que ta lumière"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Pour ce nouveau spectacle, Maude Audet nous propose un moment lumineux et vibrant, porté par sa voix chaleureuse et son univers poétique. Inspiré de son album Que ta lumière à paraître en avril 2026, elle livre ses chansons indie-folk avec la sincérité qu’on lui connaît, en phase avec l’instant présent. Entourée de ses musiciens, la chanteuse et son groupe offrent des envolées mélodiques planantes et rythmées qui cadencent la soirée. Dans cet espace, chaque geste a sa place, les notes brillent et l’art vivant est à l’honneur. Sincère et libre, Maude s'investit auprès du public à travers ces nouvelles chansons qui teintent le décor et la mise en scène sensible qu’elle signe. L’optimisme et la fragilité se côtoient, le tout créant une rencontre humaine et profonde."
      }
    ]
  },
