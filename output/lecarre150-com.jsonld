    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://lecarre150.com/spectacles/film-du-21-septembre-2026/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "de Jean-François Asselin"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le film est présenté à 13h30 et à 19h30. Vous pouvez choisir l’une ou l’autre des deux représentations.Canada (Québec). 2026. 91 min. (13+)Avec Louis Morissette, Pascale Drevillon, Geneviève Schmidt, Robin Aubert.François, scénariste de 50 ans en déclin professionnel, coche cyniquement la case « transgenre » pour favoriser le financement de son dernier projet de série télé. Quand, contre toute attente, son plan fonctionne et son projet est accepté, il se retrouve à devoir incarner… Françoise, une autrice qui amorce sa transition.« Le genre de film qui fera passer un bon moment à tout le monde, même à ceux qui n’oseront pas le dire. » (Anne-Frédérique Hébert-Dolbec, Le Devoir)"
      }
    ]
  },
