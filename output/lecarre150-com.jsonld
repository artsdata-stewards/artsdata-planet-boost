  {
    "@id": "https://lecarre150.com/genid/bcd0cbed4a88a2a1",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/image": [
      {
        "@id": "https://lecarre150.com/app/uploads/tuxedo/Mia20Kelly_-OpiUYqDZOap-tCXZZt6_-scaled.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://lecarre150.com/spectacles/mia-kelly-to-be-clear/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://lecarre150.com/spectacles/mia-kelly-to-be-clear/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "To Be Clear"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dotée d’une voix puissante et polyvalente, l’autrice-compositrice Mia Kelly offre un mélange distinctif de folk, de rock et de blues. Avec son talent pour adapter les histoires des personnes qui l’entourent, elle est une conteuse imaginative qui canalise ses émotions brutes et vulnérables grâce à ses chansons savamment conçue. Récemment récompensée comme jeune interprète de l'année et artiste émergente de l'année aux Canadian Folk Music Awards 2024, Mia gagne rapidement en reconnaissance en tant que parolière poétique dotée d'une voix puissante et polyvalente."
      }
    ]
  },
