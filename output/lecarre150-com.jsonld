    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://lecarre150.com/spectacles/ouellet-dans-le-temps-quon-riait/?rid=12501"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Dans l&rsquo;temps qu&rsquo;on riait !"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Révélation du ComediHa! Fest 2023, Ouellet vous a déjà charmés en première partie de Jean-Michel Anctil… mais cette fois, il débarque avec SON spectacle : 100 % inédit, assumé et terriblement efficace.Sous la direction artistique de Jean-Michel Anctil et la mise en scène de Guy Lévesque, Ouellet présente Dans le temps qu’on riait, un show qui fait du bien. Une soirée où l’on décroche, où l’on franchit les barrières, où l’on oublie les jugements — et où on rit, pour vrai, comme dans l’temps.Spectacle pour 16 ans et +"
      }
    ]
  },
