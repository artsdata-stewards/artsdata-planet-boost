      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://lecarre150.com/spectacles/jean-claude-gelinas-tout-ou-rien-2/?rid=12789"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Tout ou rien"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Avec TOUT OU RIEN, Jean-Claude Gélinas nous fait part de son côté plus rigide. Sans compromis, il est souvent excessif dans sa façon de faire ou de ne pas faire les choses. Connu du grand public pour son personnage de Réjean de Terrebonne, Jean-Claude Gélinas s’est de plus révélé un humoriste complet maîtrisant le standup comique sous toutes ses coutures. Lors de sa dernière tournée, comptant plus de 125 représentations, les spectateurs ont constaté le dynamisme et l’objectivité de l’artiste… avec ou sans costume ! Un spectacle de Jean-Claude Gélinas, c’est des gags au pied carré, un enchainement rythmé de rires et d’acclamations, c’est une déride qui rend heureux : il n’y a aucun compromis afin que tous passent une agréable soirée !"
      }
    ]
  },
