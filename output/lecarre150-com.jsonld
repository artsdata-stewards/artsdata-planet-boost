    ],
    "http://schema.org/url": [
      {
        "@id": "https://lecarre150.com/spectacles/atelier-de-jeu-clownesque-avec-alexo-et-bisha/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://lecarre150.com/spectacles/atelier-de-jeu-clownesque-avec-alexo-et-bisha/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "avec Alexo et Bisha"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Accompagnés par Alexo et Bisha, un duo clownesque cumulant plus de 25 ans d’expérience et anciens artistes du Cirque du Soleil, vous aurez la chance d’explorer le jeu clownesque en toute simplicité !Ce que vous allez découvrir :• Des techniques de jeu variées : jeux d’observation, d’imitation et d'amplification des émotions• La force et la dynamique du groupe• La pratique de l'improvisation à travers des exercices ludiques et amusants pour exprimer vos talents comiquesParce qu'on a tous un « Jerry » en nous !Âge public : 5 ans et plus (enfants, parents et grands-parents) Durée : 60 minutes"
      }
    ]
  },
