        "@id": "https://lecarre150.com/spectacles/le-songe-dune-nuit-dete-dapres-william-shakespeare-2/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://lecarre150.com/spectacles/le-songe-dune-nuit-dete-dapres-william-shakespeare-2/?rid=13486"
