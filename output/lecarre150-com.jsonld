    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "King of the Bar"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "**Admission générale - places assises et debout disponibles - Arrivez-tôt**Jay Kutcher débarque avec un new country qui frappe fort. Son spectacle King of the Bar est un véritable party digne des bars de Nashville, où il enchaîne les chansons de son premier album, des inédits de son prochain et des covers de classiques country qui font chanter la foule à l’unisson. Avec un album prévu pour 2026, Jay est prêt à s’imposer comme l’une des figures incontournables du country canadien."
      }
    ]
  },
