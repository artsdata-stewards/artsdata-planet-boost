    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://lecarre150.com/spectacles/sam-vigneault-en-rodage-3/?rid=13653"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Cultivé En rodage"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Après avoir fait germer son talent avec succès et distinction sur les scènes du Québec, l’humoriste Sam Vigneault est maintenant prêt à récolter le fruit de son travail avec Cultivé, son premier one-man-show. Sam Vigneault, c’est un agriculteur, une moustache légendaire, un accordéon, et, surtout, un style d’humour qui ne ressemble à aucun autre. Originaire de Plessisville, Sam a grandi au cœur des régions et en a gardé le parler, les réflexes, la culture, les histoires et cette façon bien à lui de regarder le monde. Dès qu’il commence à parler, on a l’impression de le connaître depuis toujours. Pour son premier one-man-show, celui qui habite encore sur la ferme familiale nous entraîne dans son univers avec un regard aussi surprenant qu’authentique. Sam Vigneault, un humoriste unique, différent et attachant! De l’humour d’ici. Du vrai, du drôle, du cultivé !"
      }
    ]
  },
