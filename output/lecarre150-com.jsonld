    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Monstre"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Ceci n’est pas un spectacle, ceci est une immersion totale dans un univers parallèle aux allures de film d’horreur des années 80. Un voyage intense de 90 min où le temps s’arrête pour laisser place aux flashs et aux hurlements.Un grand partage d’émotions sur un tonnerre de guitare électrique et de synthétiseurs. Silence, le film commence, il est là …. Celui qu’on appelle LE MONSTRE."
      }
    ]
  },
