  {
    "@id": "https://lecarre150.com/genid/fd85d50bf209498e",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/image": [
      {
        "@id": "https://lecarre150.com/app/uploads/tuxedo/FIMAV_-OlqKC2goWnBZfNgJPPq_.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://lecarre150.com/spectacles/fimav/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://lecarre150.com/spectacles/fimav/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "FIMAV"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Avec près de 25 concerts payants et gratuits, le FIMAV est de retour, fort, vivant, et plus accessible que jamais. Pour cette 42e édition, le festival réaffirme son rôle de destination culturelle incontournable, où Victoriaville devient, le temps d’une semaine, un véritable carrefour mondial des musiques actuelles. Encore cette année, le FIMAV est fier de s’associer au Carré 150 afin d’y présenter la majorité de ses concerts en salles, allant de quatuors de jazz exaltés à des performances solos plus intimes. En plus de son incontournable circuit d'installations sonores dans l'espace public et ses matinées de projections de films expérimentaux, découvrez la programmation des concerts qui vous attendent en 2026 en visitant notre site web :https://www.fimav.qc.ca"
      }
    ]
  },
