    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Présent"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Simon Leblanc a plus envie que jamais de sillonner le Québec en quête de paysages et de faces qui rient. Simon repart donc en tournée pour présenter son quatrième spectacle, Présent. Il a hâte de vous voir comme ça s'peut pas! À bientôt tout le monde…"
      }
    ]
