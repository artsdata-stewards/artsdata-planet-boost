  {
    "@id": "https://lecarre150.com/genid/d9890f0a5ce4e2ee",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/image": [
      {
        "@id": "https://lecarre150.com/app/uploads/tuxedo/Pierre20HC3A9bert_-OugmO0Uruo_rSwOcknK_.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-02-05T20:00:00"
      }
    ],
    "http://schema.org/endDate": [
      {
