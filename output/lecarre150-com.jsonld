    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Formule « Duo »"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "En plein air, décontracté, avec des grignotines offertes — c'est ça un show sur la terrasse du Carré 150. Studio en cas de pluie.Maude Cyr-Deschênes, auteure-compositrice et interprète de grand talent, vous transporte dans son univers à la fois sensible, puissant et imagé. Sa personnalité pétillante et son timbre de voix cristallin vous feront vivre un moment qui restera ancré dans votre mémoire ! Accompagnée de son musicien, laissez-vous bercer par ses mélodies, en plus de reprises connues, qui vous feront vivre une soirée marquante dont vous vous souviendrez longtemps !"
      }
    ]
  },
