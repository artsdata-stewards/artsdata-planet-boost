    ],
    "http://schema.org/image": [
      {
        "@id": "https://lecarre150.com/app/uploads/tuxedo/Pierre20Verville_-Orxph8CouqEplp2ZIot_.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://lecarre150.com/spectacles/pierre-verville-pour-une-derniere-voix/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://lecarre150.com/spectacles/pierre-verville-pour-une-derniere-voix/"
