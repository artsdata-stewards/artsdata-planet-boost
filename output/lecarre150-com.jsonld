    "@id": "https://lecarre150.com/genid/641df6bce33b4dba",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/image": [
      {
        "@id": "https://lecarre150.com/app/uploads/tuxedo/C389ric20Lapointe_-OcLU75mqvd674c7Pzq5_-scaled.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://lecarre150.com/spectacles/eric-lapointe-obsession/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://lecarre150.com/spectacles/eric-lapointe-obsession/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Obsession 30 ans"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Fêtant ses 30 ans de carrière, Éric Lapointe soulignera cet anniversaire avec un réenregistrement des dix chansons de son album OBSESSION (Terre promise, N’importe quoi, L’exquise…) et la parution d’une édition vinyle. Aussi, plusieurs événements spéciaux sont prévus, dont un spectacle-anniversaire, OBSESSION 30 ANS, célébrant sur scène les trois décennies bien remplies depuis la parution de ce premier disque. L’énergie et la fougue bien connues du chanteur seront au rendez-vous! Une soirée de grands succès et de belles surprises vous attend."
      }
    ]
  },
