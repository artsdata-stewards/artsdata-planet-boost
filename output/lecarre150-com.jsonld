    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Spectacle de danse"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\"Le Collège Clarétain est fier de vous présenter son spectacle annuel de danse ! Venez découvrir l'immense talent de nos élèves en danse et en concentration danse. À travers leurs créations et leurs réalisations chorégraphiques, ils vous feront vivre un moment inoubliable. Un événement à ne pas manquer, nous vous attendons en grand nombre !\""
      }
    ]
  },
