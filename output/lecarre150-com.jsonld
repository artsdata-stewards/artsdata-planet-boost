  {
    "@id": "https://lecarre150.com/genid/5d01db228a6d4bb0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/image": [
      {
        "@id": "https://lecarre150.com/app/uploads/tuxedo/Dance202620Groove_-OoBEh6Pa-RH5yz1CHO6_.png"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://lecarre150.com/spectacles/dance-groove-ecole-de-danse-le-claretain/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://lecarre150.com/spectacles/dance-groove-ecole-de-danse-le-claretain/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "École de danse Le Clarétain"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Plus de 400 danseurs de tous âges monteront sur scène pour vous offrir un spectacle vibrant, à l’image de cette grande famille artistique en pleine effervescence. Reconnue pour son énergie, sa créativité et son esprit rassembleur, l’École de danse Le Clarétain s’impose aujourd’hui comme un moteur culturel dans la région, offrant des cours variés et accessibles à tous, du récréatif au compétitif.Dance & Groove, c’est une célébration du talent, de la passion et du plaisir de danser. Numéro après numéro, laissez-vous emporter par l’émotion, la diversité des styles et la passion.Un spectacle haut en couleur, porté par une communauté unie, qui promet de faire vibrer petits et grands. Bon spectacle à tous !"
      }
    ]
  },
