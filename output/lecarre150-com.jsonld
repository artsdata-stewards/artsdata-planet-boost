    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://lecarre150.com/spectacles/film-du-23-novembre-2026/?rid=14101"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "de Luc Picard"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le film est présenté à 13h30 et à 19h30. Vous pouvez choisir l’une ou l’autre des deux représentations.Canada (Québec). 2026. 114 min. (13+)Avec Luc Picard, Kelly Depeault, Henri Picard.Marcel, un tueur à gages à la retraite, est forcé de reprendre le collier et de commettre deux meurtres à Montréal. Ce faisant, il initie, sans le savoir, une suite d’événements fortuits qui finiront par mettre en danger la vie de sa propre fille à Paris.« Avec l’ambitieux et bouleversant film choral RÉDEMPTIONS, son sixième long métrage à titre de scénariste et de réalisateur, l’acteur Luc Picard signe indéniablement le plus beau film de sa carrière. » (Manon Dumais, La Presse)"
      }
    ]
  },
