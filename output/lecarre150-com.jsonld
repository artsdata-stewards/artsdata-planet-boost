      {
        "@id": "https://lecarre150.com/spectacles/le-crime-de-lorient-express-la-comedie-humaine/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://lecarre150.com/spectacles/le-crime-de-lorient-express-la-comedie-humaine/?rid=13133"
