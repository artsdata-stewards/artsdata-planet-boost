    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Le Bingo Show en tournée !"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Comme le bingo peut être considéré comme un sport extrême et compétitif, Rainbow Drag a décidé de créer une formule pour faire lever le party !Lors de cette soirée haute en couleurs, la fièvre du disco sera au rendez-vous avec notamment une musique d’ambiance, un boulier brillant et des performances."
      }
    ]
