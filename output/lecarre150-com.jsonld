    ],
    "http://schema.org/image": [
      {
        "@id": "https://lecarre150.com/app/uploads/tuxedo/On20sera20heureux_-OgcOdizhPJN_yLWuwXY_-2.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://lecarre150.com/spectacles/film-du-lundi-02-fevrier-2026/"
