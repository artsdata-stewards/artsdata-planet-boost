      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://lecarre150.com/spectacles/lensemble-den-direct-de-lunivers-harmonies-dun-soir/?rid=13375"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Harmonies d&rsquo;un soir"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Après tant d’années à marier passionnément nos voix et nos instruments pour faire vibrer à l’unisson nos cœurs et les vôtres, les membres de l’Ensemble d’En direct de l’univers vous offrent de toutes nouvelles harmonies. C’est à notre tour de vous raconter en chansons nos histoires, nos amours, nos voyages, nos familles. Nous vous convions à une fête où chaque note, chaque parole résonnera comme un souvenir heureux et vous donnera le goût de chanter avec nous. On vous assure qu’en 15 années à l'émission En Direct de l’Univers on a un répertoire infini de chansons des plus touchantes aux plus drôles, de la pop aux classiques incontournables, sans oublier les chansons marquantes de grands artistes québécois. Les medleys, vous le savez, c’est notre marque de commerce, et comptez sur nous, on va vous gâter !"
      }
    ]
  },
