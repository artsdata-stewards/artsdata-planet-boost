    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://lecarre150.com/spectacles/annie-villeneuve-etre-moi/?rid=14206"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Être moi"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Ne manquez pas l’occasion de vivre un moment magique avec Annie Villeneuve ! Dans ce tout nouveau spectacle, laissez-vous transporter par sa voix saisissante et plongez dans l’univers de son dernier album, ÊTRE MOI.Avec des sonorités « new country » qui confère une énergie vibrante à chaque chanson, Annie vous réserve une soirée riche en émotions, pleine de chaleur et d’authenticité, vous offrant aussi un retour sur ses plus grands succès des deux dernières décennies.Une soirée à ne pas manquer, réservez vite votre place pour partager ce moment inoubliable !"
      }
    ]
  },
