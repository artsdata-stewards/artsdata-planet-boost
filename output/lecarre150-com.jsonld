  {
    "@id": "https://lecarre150.com/genid/0a553ccd4ac8cc51",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/image": [
      {
        "@id": "https://lecarre150.com/app/uploads/tuxedo/Il20C3A9tait20une20Fable_-OjXB8m8-Z4K5IQcpzIU_.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://lecarre150.com/spectacles/il-etait-une-fable-jacinthe-lavoie-et-jean-luc-lavigne/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://lecarre150.com/spectacles/il-etait-une-fable-jacinthe-lavoie-et-jean-luc-lavigne/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Jacinthe Lavoie et Jean-Luc Lavigne"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Il était une fable, un atelier spectacle musical. Jacinthe Lavoie , Jean-Luc Lavigne et leur grande marionnette Dame oiseau revisitent avec les jeunes et leurs parents les fables de la fontaine. Ce spectacle est accompagné par la création interactive d’une histoire. Le public aura ensemble l’occasion de faire des choix de personnages de lieux, et même de situation. Une belle occasion de prendre part à une création collective improvisée par nos deux artistes. Ce qui donnera des outils très simples aux familles pour créer eux même leur histoire à la maison."
      }
    ]
  },
