    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "L&rsquo;écho des étoiles"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Guidés par la passion et l’expertise de leurs enseignants, les jeunes musiciens du programme Musique-études de l’École secondaire Le boisé vous invitent à vivre un voyage musical vibrant, coloré et diversifié. Leur talent exceptionnel et leur énergie communicative illumineront la scène, vous faisant partager toute la magie d’une véritable expérience professionnelle. Venez découvrir ces artistes en pleine émergence, dont la maîtrise et la sensibilité musicales sauront assurément vous émerveiller. Une soirée étincelante vous attend, animée avec dynamisme par monsieur Éric Mercier."
      }
    ]
  },
