  {
    "@id": "https://lecarre150.com/genid/4c20148565450cce",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/image": [
      {
        "@id": "https://lecarre150.com/app/uploads/tuxedo/NINO_-OqqHIZbK6ptUFQlGNyx_.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://lecarre150.com/spectacles/film-du-lundi-11-mai-2026/"
