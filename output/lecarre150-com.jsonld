      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://lecarre150.com/spectacles/maxim-martin-bon-chien/?rid=12633"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Bon chien"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Même après cinq one-man show, un livre et une série sur son quotidien avec sa fille, Maxim Martin vous fera découvrir de nouveaux aspects de son attachante personnalité. Toujours aussi authentique, il se dévoile dans cette nouvelle période où il tente par tous les moyens de simplifier sa vie dans une époque où tout lui semble de plus en plus complexe. Bon chien, son sixième one-man show, se veut une fenêtre ouverte sur son chemin parsemé de petites et grandes frustrations vers la zénitude."
      }
    ]
  },
