    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "On vous jazz le Québec"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le Québec comme vous ne l’avez jamais entendu !​Vibrez au son d'un ensemble puissant composé de 18 musiciens et 5 voix d'exception réunis pour une soirée monumentale. Avec On vous jazz le Québec !, les plus grands succès de notre répertoire national s’offrent une cure de jouvence version Big Band. Entre la précision instrumentale et l’élégance des harmonies vocales, redécouvrez nos classiques dans un déploiement sonore digne des plus grands cabarets. Une célébration chic et enlevante de notre culture !"
      }
    ]
  },
