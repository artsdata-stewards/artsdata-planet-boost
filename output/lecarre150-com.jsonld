    "http://ogp.me/ns#title": [
      {
        "@language": "fr-fr",
        "@value": "Le Carré 150 - Val Belzil - DIY : Fais-le toi-même"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "Val Belzil est de passage avec son spectacle DIY fais le toi même au Carré 150 à Victoriaville. Réservez vos billets"
      }
    ],
    "http://ogp.me/ns#url": [
