    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Vibe. Imbibe. Come alive with the songs you love.  You don’t need to be in New York, New Orleans or Vegas to enjoy this classic casual live music experience. Make one Thursday night a month the unofficial start of a weekend at the  Thursday Evening Piano Bar .  Once a month, The ACT Lobby transforms"
      }
    ],
