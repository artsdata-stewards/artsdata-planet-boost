    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Join panellists as they discuss the history of the LGBT Purge, through an academic and personal lens and reflect on the role art can play in disseminating and commemorating this tragic chapter of Canadian history.   Solo Chicken Productions  in partnership with  Pride Fredericton  is hosting a panel"
      }
    ],
