        "@value": "Solo Chicken Productions"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "LGBT PURGE PANEL: HISTORY, HUMAN RIGHTS AND USING ART TO EXPLORE QUEER HISTORY — Solo Chicken Productions"
      }
    ],
    "http://ogp.me/ns#latitude": [
      {
        "@language": "en-ca",
        "@value": "45.9558461"
      }
    ],
