    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Drop-in on Tuesdays 2:00 &#8211; 5:00 pm or by appointment Weston Family Foundation Room Life Directions specializes in providing individualized, one-on-one employment supports to jobseekers facing barriers to employment. Interested individuals can book an appointment by calling 519-378-5514 or emailing lifedirections@segss.com"
      },
