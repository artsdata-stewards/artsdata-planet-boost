    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Tue. October 27, 7:30 pm | $45 + HST + ticket fee = $56.10 For more than three decades, Canadian singer-songwriter Joel Plaskett has been captivating audiences with his distinctive blend of rock, folk, and heartfelt storytelling. Hailing from Nova Scotia, Plaskett has built an acclaimed career through his solo work and alongside The Emergency,"
      },
