    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Track your reading all summer long! Kids and teens can visit the library to register for the TD Summer Reading Club. Children earn 1 ballot for every: 5 picture books, 3 graphic novels, or 1 chapter book read. There will be draws for prizes every week until Friday, August 28. Visit the library prior to"
      },
