    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Sunny Sunday Tours of Beautiful Joe Park"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Learn about this historic oasis in downtown Meaford with a 30-minute guided walking tour with an expert from the Beautiful Joe Heritage Society.  Highlights include the story of the author who made Meaford&#8217;s own Beautiful Joe famous; history of the park and its monuments and bits about nature.  A little something for everyone.  Tours are"
      },
      {
        "@language": "en",
        "@value": "Learn about this historic oasis in downtown Meaford with a 30-minute guided walking tour with an expert from the Beautiful Joe Heritage Society.  Highlights include the story of the author"
