        "@language": "en",
        "@value": "Pioneer Games and Crafts"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Step back in time and experience the simple pleasures of early pioneer life with Pioneer Fun and Games! This interactive program invites participants to explore traditional activities enjoyed by families in the 19th century, from old-fashioned games and hands-on crafts to classic outdoor entertainment that brought communities together long before modern technology. As part of"
      },
      {
        "@language": "en",
        "@value": "Step back in time and experience the simple pleasures of early pioneer life with Pioneer Fun and Games! This interactive program invites participants to explore traditional activities enjoyed by families"
