    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Oct 9, 2026. 7:30 p.m. $56.10 From the rugged shores of Newfoundland the Far East of the Western World originates one of Canada’s most celebrated folk groups, The Irish Descendants. For over 35 years, this multi-award-winning ensemble has captivated audiences across North America and beyond, performing more than 8,000 live shows and earning a reputation"
      },
      {
        "@language": "en",
        "@value": "Oct 9, 2026. 7:30 p.m. $56.10 From the rugged shores of Newfoundland the Far East of the Western World originates one of Canada’s most celebrated folk groups, The Irish Descendants."
      }
    ],
