      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Step back in time and discover the stories that shaped our community during the Duxbury Cemetery Tour. This guided walking tour explores the rich history, notable residents, and fascinating local legends connected to one of Meaford’s most historic resting places. Comfortable walking shoes are recommended. Suitable for all ages. $15 https://meafordmuseumprograms.square.site/"
      },
      {
