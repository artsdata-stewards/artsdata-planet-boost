    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Friday, June 19 until Friday, August 28 Please register to participate A 10-week (not years) community movement challenge! Walk, run, bike, rollerblade&#8230; just get moving! Keep track of your steps or km travelled and submit them weekly to asolecki@meaford.ca. The participant who travels the furthest will win a heroic-age prize. Let&#8217;s see if we can"
      },
      {
        "@language": "en",
        "@value": "Friday, June 19 until Friday, August 28 Please register to participate A 10-week (not years) community movement challenge! Walk, run, bike, rollerblade&#8230; just get moving! Keep track of your steps"
      }
    ],
