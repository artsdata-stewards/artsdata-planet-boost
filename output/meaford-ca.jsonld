      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Tuesday August 11, 2026 Time: 6:00pm Location: Meaford Museum Adult program A lucet is a two-pronged hand tool, known from the Viking and Medieval periods, used to create strong, square braided cords by looping yarn around its prongs. The resulting cords are durable, slightly elastic, and commonly used for drawstrings, laces, bag handles, decorative trim,"
      },
      {
