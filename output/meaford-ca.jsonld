        "@language": "en",
        "@value": "Canada Day in Meaford"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "  Join us on Wednesday, July 1, 2026, for a full day of Canada Day celebrations at the Meaford Rotary Harbour Pavilion.  From morning to afternoon, enjoy a vibrant, family-friendly event filled with entertainment, community spirit, and activities for all ages.  Celebrate Canadian pride, culture, and connection with a wide range of programming throughout the day."
      },
      {
        "@language": "en",
        "@value": "  Join us on Wednesday, July 1, 2026, for a full day of Canada Day celebrations at the Meaford Rotary Harbour Pavilion.  From morning to afternoon, enjoy a vibrant, family-friendly event"
      }
