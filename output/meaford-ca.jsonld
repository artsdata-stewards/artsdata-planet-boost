    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The Municipality of Meaford has chosen to use internet and telephone voting for the Municipal and School Board Election in October 2026. To help residents prepare, the Municipality will hold information sessions where people can learn how the voting process works and ask any questions they may have."
      },
