  {
    "@id": "https://www.chapelledurang1.com/event-details/yoga-classique-2",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Yoga classique | chapelledurang1"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "<p>Faites de votre dimanche matin un moment actif et culturel en venant assister au cours de yoga donné par Sylvie Bilodeau. Elle sera accompagné du Quatuor Lunes qui présentera un répertoire de musique classique pour accompagner votre pratique. Bien-être garanti pour cette activité dans le cadre du festival Colline. </p>\n<p></p>\n<p>Événement gratuit au Parc des Vétérans. Aucune réservation requise. </p>\n<p></p>\n<p>Prévoyez votre matelas, une bouteille d&#39;eau et de la crème solaire. </p>"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://static.wixstatic.com/media/fa4add_196eacb445c24246939a93765dd0dd71~mv2.png/v1/fill/w_2876,h_1920,al_c/fa4add_196eacb445c24246939a93765dd0dd71~mv2.png"
