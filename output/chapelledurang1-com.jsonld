  {
    "@id": "https://www.chapelledurang1.com/event-details/la-randonnee-musicale-kanen-pilou-lumiere",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "La randonnée musicale | Kanen - Pilou - Lumière  | chapelledurang1"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Une expérience hors du commun, en pleine nature. Découvrez, lors d'une balade dans le bois, Kanen, Pilou et le groupe Lumière. Une expérience immersive à ne pas manquer."
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://static.wixstatic.com/media/fa4add_fd5da8c202fc42f79d4de327b1e312a3~mv2.jpg/v1/fill/w_3810,h_2543,al_c,q_90/fa4add_fd5da8c202fc42f79d4de327b1e312a3~mv2.jpg"
      }
    ],
