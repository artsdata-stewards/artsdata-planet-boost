  {
    "@id": "https://www.chapelledurang1.com/event-details/coeur-de-pirate-presente-perseides",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Coeur de Pirate présente Perséides  | chapelledurang1"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Une soirée tout en douceur avec Coeur de pirate, au piano, accompagnée du Quatuor à cordes LUNES. Une soirée magique sous les étoiles filantes."
      }
    ],
    "http://ogp.me/ns#image": [
