    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Canta Brasil is Missoula’s only band specializing in the fabulous music of Brazil – from romantic bossa nova to sizzling hot samba, poetic choro, and sweat-inducing danceable baião, forró, xote, maracatu."
      }
    ],
