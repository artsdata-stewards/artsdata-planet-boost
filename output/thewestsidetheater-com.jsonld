    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "next to normal  , with book and lyrics by Brian Yorkey and music by Tom Kitt, explores how one suburban household copes with crisis and mental illness.  Winner of three 2009 Tony Awards, including Best Musical Score and the 2010 Pulitzer Prize.   Presented by AM Theatrical    September 22-September"
      }
    ],
