    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Here is your opportunity to learn some new entries into the famous crossback straddle up!  Prerequisites to this workshop include proficiency in putting on and taking off footlocks, an unassisted aerial inversion and a proficient traditional climb on both sides."
      }
