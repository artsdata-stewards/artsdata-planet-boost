  {
    "@id": "https://www.capas.ca/en/event-details/chatgpt-pour-travailleurs-culturels-2024-05-30-10-00",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "ChatGPT for cultural workers | CAPAS"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "<p><em><strong>Offered only in French</strong></em></p><br/><p>This workshop is designed for professionals in the Franch-speaking cultural sector who want to discover ChatGPT, the revolutionary artificial intelligence tool. You'll discover how to use the conversational agent to optimize project management, enrich content creation, simplify your digital processes and improve efficiency. From theory to practice, learn how to formulate effective queries (prompts), analyze the responses generated and integrate these ideas into your cultural strategies. Join us to transform your approach to cultural work and harness the full potential of artificial intelligence.</p><p><strong>Duration | 60 minutes</strong></p><p><strong>Instructor | Mickaël Spinnhirny</strong></p><p><strong>Virtual training</strong></p><p><strong>Groups of 12 people</strong></p><p><em><strong>Offered only in French</strong></em></p>"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://static.wixstatic.com/media/4c971f_e8365d704d484c2fb84af5c0b62b5f8a~mv2.png/v1/fill/w_2400,h_1256,al_c/4c971f_e8365d704d484c2fb84af5c0b62b5f8a~mv2.png"
