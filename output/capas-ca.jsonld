  {
    "@id": "https://www.capas.ca/en/event-details/r-osa-silvia-gribaudi-2024-11-12-20-30",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "R. OSA - Silvia Gribaudi | CAPAS"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "R. OSA is a poetic performance by Silvia Gribaudi, performed by Claudia Marsicano. On stage, the expression of the body, of womanhood and women's social role is showed with a desacralizing irony and an “informal” language that connects with the audience."
      }
    ],
