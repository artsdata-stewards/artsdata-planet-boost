  {
    "@id": "https://www.capas.ca/event-details/r-osa-silvia-gribaudi-2024-11-12-20-30",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "R. OSA - Silvia Gribaudi | CAPAS"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "R. OSA est une performance poétique de Silvia Gribaudi, interprétée par Claudia Marsicano. Sur scène, l’expression du corps, de la femme et de son rôle social est abordée avec une ironie désacralisante et un langage « informel » qui connecte avec le public."
      }
    ],
