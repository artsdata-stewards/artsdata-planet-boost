  {
    "@id": "https://www.capas.ca/en/event-details/fables-compagnie-virginie-brunelle-1",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Murmuration - Le Patin Libre | CAPAS"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Mesmerizing us with their discipline, enthusiasm and virtuosity, the Patin Libre artists are now 15 and as fast as ever on their skates! Here they are chasing swarms of birds. Soaring, vertiginous skating."
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://static.wixstatic.com/media/c19ff4_b965f2501b7d404f8b466f6024a6cd6c~mv2.png/v1/fill/w_1920,h_1080,al_c/c19ff4_b965f2501b7d404f8b466f6024a6cd6c~mv2.png"
      }
    ],
    "http://ogp.me/ns#image:width": [
      {
        "@language": "en",
        "@value": "1920"
