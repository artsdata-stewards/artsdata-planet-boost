  {
    "@id": "https://www.capas.ca/en/event-details/millepertuis-sovann-rochon-prom-tep-2025-05-30-21-00",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Millepertuis | Sovann Rochon - Prom Tep | CAPAS"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Millepertuis is both a journey and a moment of blooming. Shifting between exuberance and surrender, this solo piece was created by choreographer Sovann Rochon-Prom Tep to showcase the personality, charisma, and boundless energy of his friend and collaborator, the exceptional street dancer Walid Hammani."
      }
    ],
