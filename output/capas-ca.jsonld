  {
    "@id": "https://www.capas.ca/event-details/off-cinars-9-2-2",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "9.2 - Cas Public | CAPAS"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Beethoven a écrit sa Neuvième Symphonie alors qu’il était presque complètement sourd. Cai Glover est malentendant, il fait le choix de danser sans son aide auditive."
      }
    ],
    "http://ogp.me/ns#image": [
