    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "OPEN STUDIO - World premiere in June 2025 | Marco D'Agostin builds a score for voice and body that - moving between paleontology, dance and feelings - tells of the infinite means in which life always finds a way to resist."
