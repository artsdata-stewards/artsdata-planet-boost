  {
    "@id": "https://www.capas.ca/event-details/chatgpt-niveau-2",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "ChatGPT - Niveau 2 | Fonctionnalités avancées | CAPAS"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Vous utilisez déjà ChatGPT et vous souhaitez aller encore plus loin ? Cette formation express de 60 minutes vous offre d’approfondir les fonctions de l’outil conversationnel."
      }
    ],
    "http://ogp.me/ns#image": [
