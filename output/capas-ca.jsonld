  {
    "@id": "https://www.capas.ca/event-details/off-cinars-minuit",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Minuit quelque part - CAPAS  | CAPAS"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Éclatant et profond, Minuit quelque part rassemble des interprètes virtuoses et huit chorégraphes québécois d’exception autour de ce besoin mystérieux de bouger quand la nuit nous enveloppe."
      }
