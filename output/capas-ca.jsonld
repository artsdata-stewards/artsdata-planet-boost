        "@id": "https://www.capas.ca/en/event-details/cas-public-9-2-opera-bastille-5"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Cas Public | 9.2 - Opéra Bastille "
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Beethoven a composé sa Neuvième Symphonie alors qu’il était presque complètement sourd. Cai Glover est malentendant. Sur scène, il choisit de danser sans son aide auditive. Que disent nos sens — ou leur absence — sur notre manière d’habiter le monde ? Et surtout, comment nous guident-ils au-delà de "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
