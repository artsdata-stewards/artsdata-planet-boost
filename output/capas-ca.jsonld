  {
    "@id": "https://www.capas.ca/event-details/cas-public-mikro-bartok-premiere-francaise-a-illzach-2",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Cas Public | MIKRO / BARTÓK – Première française à Illzach | CAPAS"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Comment grandir dans un monde en perpétuelle transformation ? MIKRO / BARTÓK, nouvelle création de Cas Public, plonge dans cette grande aventure qu’est l’apprentissage. Entre danse, langage et musique, l’œuvre explore avec aplomb et virtuosité les fondations sensibles de la construction de soi."
      }
    ],
