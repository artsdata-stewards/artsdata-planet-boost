        "@id": "https://www.watermarktheatre.com/events/month/2026-07/"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Sugar Road"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;A country singer and a young woman meet in a magical chance encounter before being separated by his rise to fame. Now it\\'s 12 years later, he\\'s at the top of his career, she\\'s keeping the lights on at the family business; and they\\'re about to meet again. Filled with laughter, romance and a little &hellip; &lt;a href=&quot;https://www.watermarktheatre.com/events/sugar-road-9/&quot;&gt;Continued&lt;/a&gt;&lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@value": "Organization"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
