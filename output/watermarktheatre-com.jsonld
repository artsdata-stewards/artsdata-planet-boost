      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Dear Jack, Dear Louise"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Ken Ludwig’s Dear Jack, Dear Louise is an inspiring reminder of the best we can be, even in the worst of times. During World War II, a military doctor begins writing to an aspiring actress in New York City hoping to meet her someday if the war will allow. But as the war continues, it threatens to end &hellip; &lt;a href=&quot;https://www.watermarktheatre.com/events/dear-jack-dear-louise-29/&quot;&gt;Continued&lt;/a&gt;&lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@value": "Organization"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
  {
    "@id": "https://www.watermarktheatre.com/temporary/b850bff0-785f-4d62-bdbc-de30641d925e",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.watermarktheatre.com/events/the-woman-in-black-23/"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-08-23T19:30:00-03:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-08-23T19:30:00-03:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1414900"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.watermarktheatre.com/events/list/?eventDisplay=past"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "The Woman in Black"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;In the shadowy corridors of an old Victorian theatre, a young actor meets a haunted lawyer compelled to unravel the sinister secrets that plague his nightmares. Together, they recount the tale of a young solicitor who ventures to the eerie marshlands of the English countryside to settle the affairs of a recently deceased woman. Brace &hellip; &lt;a href=&quot;https://www.watermarktheatre.com/events/the-woman-in-black-23/&quot;&gt;Continued&lt;/a&gt;&lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@value": "Organization"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
