    "http://schema.org/name": [
      {
        "@value": "Music Series &#8211; Hits of 1975"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;&quot;Golden Year: Hits of 1975&quot; takes you back to the heart of a musical revolution, where rock, folk, and pop collided in unforgettable ways. From Fleetwood Mac’s dreamy vocals to Elton John’s electrifying melodies and Bob Dylan’s poetic grit, this series strips down the year’s biggest hits for an acoustic reimagining. Get ready to soak &hellip; &lt;a href=&quot;https://www.watermarktheatre.com/events/music-series-hits-of-1975/&quot;&gt;Continued&lt;/a&gt;&lt;/p&gt;\\n"
      }
    ],
