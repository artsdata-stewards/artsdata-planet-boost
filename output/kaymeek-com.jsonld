        "@value": "event"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Kay Meek Arts Centre - Yagódy"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Yagody's repertoire consists of poetic songs from Ukraine and some regions around. The musicians build a very diverse and energetic world of melodies, rhythms and themes, which they blend uniquely. A concert with Yagody is a ritual. It is about listening to the inner self. And to the mythical sound of our ancestors, like the breath of the wind in the field. The concert guests are completely captivated by Yagodys dance of voices, which form the eternal pulse of being human. Yagody's songs are like love letters from the past that haven't arrived yet."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://kaymeek.com/events/yagody-2026-01-29-730-pm"
      }
    ],
