  {
    "@id": "https://kaymeek.com/events/yagody-2026-01-29-730-pm",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
