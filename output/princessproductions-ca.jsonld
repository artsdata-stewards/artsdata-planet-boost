    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "We are excited to take All That Is Between on tour this season! Presented by the wind in the leaves collective in association with  IBPOC Touring Network, The Registry Theatre and Westben. Created by @yvonneng , this work moves through ritual, memory, and the complex space between solitude and connection. What emerges is…"
      }
