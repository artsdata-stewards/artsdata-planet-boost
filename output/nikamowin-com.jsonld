    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Pow Wow By John Abbott College and McGill University"
      },
      {
        "@language": "fr",
        "@value": "Pow Wow By John Abbott College and McGill University"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "This is the first time McGill University and John Abbott College are collaborating to create a Pow Wow that students and the larger community can enjoy!This is also the first time it will be at the MacDonald Campus!Save the Date ~ September 19, 2025 ~ and stay tuned for the updates regarding this upcoming collaborative Pow Wow! We&#39;ll use this page to keep everyone informed!"
      },
      {
        "@language": "fr",
        "@value": "C&#39;est la première fois que l&#39;Université McGill et le Collège John Abbott collaborent pour créer un pow-wow dont les étudiants et la communauté pourront profiter !C&#39;est aussi la première fois que l&#39;événement aura lieu au campus MacDonald !Réservez la date : le 19 septembre 2025 ! Restez à l&#39;affût des dernières nouvelles concernant ce pow-wow collaboratif ! Nous utiliserons cette page pour vous tenir informés !"
      }
    ]
  },
