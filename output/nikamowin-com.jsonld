    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Shauit @ La Chapelle"
      },
      {
        "@language": "fr",
        "@value": "Shauit @ La Chapelle"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\"La Tempête des Fêtes\" is a festive show where local and international traditions collide in an explosion of rhythms and emotions. A veritable musical tornado will sweep through the holiday season as Marco Calliari shares the stage with Mamselle Ruiz, Shauit, and a host of wildly imaginative musicians."
      },
      {
        "@language": "fr",
        "@value": "La Tempête des Fêtes est un spectacle festif où les traditions d&#39;ici et d&#39;ailleurs se rencontrent dans une explosion de rythmes et d&#39;émotions. Une véritable tornade musicale s&#39;abattra sur la période des Fêtes alors que Marco Calliari partagera la scène avec Mamselle Ruiz, Shauit ainsi que des musiciens déjantés."
      }
    ]
  },
