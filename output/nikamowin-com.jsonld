    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Soleil Launière @ Le Ministère"
      },
      {
        "@language": "fr",
        "@value": "Soleil Launière @ Le Ministère"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "For the second consecutive year, Les Productions MOND presents HERA, a benefit show aimed at helping women and children who are victims of violence. The show consists of covers ranging from the 70s to the 2000s, including Trip-Hop, Prog, Grunge, Rock, Prog, and Shoegaze. The profits will be donated to La Dauphinelle, an organization that provides psychosocial support to help women regain control of their lives and break the cycle of domestic violence."
      },
      {
        "@language": "fr",
        "@value": "Pour une deuxième année consécutive, Les Productions MOND présente HERA, un spectacle-bénéfice visant à venir en aide aux femmes et aux enfants victimes de violence. Le spectacle consiste en des reprises allant des années 70 aux années 2000, passant par le Trip-Hop, Prog, Grunge, le Rock, le Prog, le Shoegaze!"
      }
    ]
  },
