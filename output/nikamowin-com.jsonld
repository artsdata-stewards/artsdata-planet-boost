      {
        "@id": "_:g17131300"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nikamowin.com/en/event/eadse-maison-de-radio-canada"
      },
      {
        "@id": "https://nikamowin.com/fr/evenement/eadse-maison-de-radio-canada"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Eadsé @ Maison de Radio-Canada"
      },
      {
        "@language": "fr",
        "@value": "Eadsé @ Maison de Radio-Canada"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Tu veux vivre une soirée mémorable ? Viens découvrir la pop-soul envoûtante d’EADSÉ, une de nos Révélations Radio-Canada, lors d’un 5@7 exclusif dans l’Atrium de Radio-Canada animé par Philippe Fehmiu ! C’est le rendez-vous parfait pour plonger dans son univers unique. EADSÉ (un nom qui veut dire « ma bonne amie » en wendat) va te toucher en plein cœur avec ses textes puissants, comme en témoignent ses collaborations avec Elisapie et Pascale Picard. Son premier album, Healer, est d&#39;ailleurs un voyage intime et rassembleur qui aborde des thèmes comme la guérison et la résilience. Et pour ajouter au fun, Samian sera derrière les platines pour un DJ set de feu !C&#39;est gratuit, mais les places sont limitées. Vite, inscris-toi !​Horaire : - 16h30 : Ouverture des portes et DJ set - 17h15 à 18h15 : Performance de EADSÉ- 19h30 : Fin de la soiréeMaison de Radio-Canada1000, av. PapineauMontréal, QcH2K 0C2"
      },
      {
        "@language": "fr",
        "@value": "Tu veux vivre une soirée mémorable ? Viens découvrir la pop-soul envoûtante d’EADSÉ, une de nos Révélations Radio-Canada, lors d’un 5@7 exclusif dans l’Atrium de Radio-Canada animé par Philippe Fehmiu ! C’est le rendez-vous parfait pour plonger dans son univers unique. EADSÉ (un nom qui veut dire « ma bonne amie » en wendat) va te toucher en plein cœur avec ses textes puissants, comme en témoignent ses collaborations avec Elisapie et Pascale Picard. Son premier album, Healer, est d&#39;ailleurs un voyage intime et rassembleur qui aborde des thèmes comme la guérison et la résilience.Et pour ajouter au fun, Samian sera derrière les platines pour un DJ set de feu !C&#39;est gratuit, mais les places sont limitées. Vite, inscris-toi !​Horaire : - 16h30 : Ouverture des portes et DJ set - 17h15 à 18h15 : Performance de EADSÉ- 19h30 : Fin de la soiréeMaison de Radio-Canada1000, av. PapineauMontréal, QcH2K 0C2"
      }
    ]
  },
