      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Florent Vollant et ses invité.e.s @ Salle Jean-Marc Dion"
      },
      {
        "@language": "fr",
        "@value": "Florent Vollant et ses invité.e.s @ Salle Jean-Marc Dion"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "On December 17, Florent Vollant invites you to celebrate the 22nd edition of his traditional show, featuring:Ludovick BourgeoisÉlisabeth St-GelaisSarah DufourTshishapeuScott-Pien PicardEvery year, you create this magic that allows us to come together, celebrate, sing, and share unforgettable moments. It is a privilege to share Florent Vollant&#39;s holiday show with you.We can&#39;t wait to see you for an evening filled with warmth, music, and emotion."
      },
      {
        "@language": "fr",
        "@value": "Le 17 décembre, Florent Vollant vous invite à célébrer la 22e édition de son spectacle traditionnel, avec la participation de :Ludovick BourgeoisÉlisabeth St-GelaisSarah DufourTshishapeuScott-Pien PicardChaque année, vous créez cette magie qui nous permet de nous réunir, de célébrer, de chanter et de partager des moments inoubliables. C’est un privilège de partager avec vous le spectacle des Fêtes de Florent Vollant.Nous avons hâte de vous retrouver pour une soirée chaleureuse, musicale et émouvante."
      }
    ]
  },
