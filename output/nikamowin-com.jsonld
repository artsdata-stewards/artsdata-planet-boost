    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Shauit @ Théâtre Gilles-Vigneault"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "SHAUIT – NATUKUNVendredi 26 septembre • 20 hSalle Antony-Lessard, Saint-JérômePlongez dans l’univers vibrant de Shauit, l’artiste innu qui fait fusionner folk, roots et reggae en langue innue, avec des récits sincères et émouvants. Reconnu pour plus de 400 performances à travers le monde et lauréat de prix prestigieux (Félix ADISQ, GAMIQ, NERFA…), il vous promet une expérience musicale mémorable. "
      }
    ]
  },
