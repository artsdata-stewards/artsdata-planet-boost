      {
        "@id": "https://victoriaplayhouse.com/wp-content/uploads/2026/05/Jane-Wells-at-the-Bus-Stop-Theatre-with-items-symbolizing-her-family-in-her-play-How-To-Live-With-Dread.jpeg"
