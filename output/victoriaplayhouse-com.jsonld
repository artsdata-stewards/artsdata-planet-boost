    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Join us on Friday, September 25, 2026 for some sparkling Island entertainment including special guest Shane Pendergast and other well-loved Island and community performers such as the music ensemble Woodsmoke, singer-songwriter Megan Ellands, step dancer Emily Hughes accompanied by Morgan Wagner and more!"
      }
