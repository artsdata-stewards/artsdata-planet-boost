    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "The Ross Family Ceilidh - 20th Anniversary! - Victoria Playhouse"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "When quirky, personable siblings Stephanie, Johnny, and Danielle come together as a band, they are no longer just a family, no longer just Rosses. They are: the Ross Family. Big vocals, heartfelt nerdy stories, stylish fiddle sets, wicked piano, and fine step-dancing: the fruit of several generations of Ross and Arsenault values, talents, languages, and hardship."
      }
    ],
