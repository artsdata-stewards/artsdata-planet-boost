    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "THE BRITISH COMEDIAN TURNED CANADIAN, LIVE ON STAGE IN VICTORIA, PEI FOR THE VERY FIRST TIME! This is it! James Mullinger’s first ever live stand-up comedy show at the beautiful Victoria Playhouse. Come and see Atlantic Canada’s biggest cheerleader doing what he does best! Live stand-up comedy at the Playhouse. 90 mins of stand-up comedy …"
      }
