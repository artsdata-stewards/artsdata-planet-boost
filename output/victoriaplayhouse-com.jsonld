        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Mass for Shut-Outs by Tanya Davis - Victoria Playhouse"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Mass for Shut-Outs is a shout out to anyone grappling with the complexity of faith, the inconsistency of awe, and the politics of organized religion. Loosely referencing the framework of a Catholic mass, it is a poetic take on Sunday service, exploring enduring questions through a joyful, critical, and comedic lens"
      }
    ],
    "http://ogp.me/ns#url": [
