      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Scott Parsons is a multi-disciplined Island musician who has consistently utilized his accomplishments to enrich both himself and his community. His involvement with theatre, film, radio and television has sparked an artistic creativity that carries over to his work with disabled and high-priority youth. Scott’s body of work spans nearly five decades and he has …"
