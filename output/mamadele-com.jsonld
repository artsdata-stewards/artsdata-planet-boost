    "http://schema.org/name": [
      {
        "@value": "Dendê Macêdo &#038; Friends Perform Recycled Sounds to mark the exhibit opening!"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Dendê Macêdo &amp; Friends Perform Recycled Sounds at the Allens Lane Arts Center Come join us at the Allens Lane Arts Center for an unforgettable evening of music with Dendê Macêdo &amp; Friends! The event celebrates the opening of the Recycled Sounds exhibit that is running throughout the month of September. Recycled Sounds showcases Macêdo’s striking collection of playable instruments crafted&nbsp;&lt;a class=&quot;read-more&quot; href=&quot;https://www.mamadele.com/new/event/dende-macedo-friends-perform-recycled-sounds-to-mark-the-exhibit-opening/&quot;&gt;Continue reading&lt;/a&gt;&lt;/p&gt;\\n"
      }
    ],
