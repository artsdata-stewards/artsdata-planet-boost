    ],
    "http://schema.org/name": [
      {
        "@value": "Arrastão do Dendê Reciclado at the Festa de Iemanjá"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;At the Festa de Iemanjá, Arrastão do Dendê creates an electrifying experience on the shores of Bahia, honoring the sea goddess with a musical procession filled with reverence and joy. Dendê and his ensemble bring a powerful fusion of Afro-Brazilian rhythms and Candomblé chants, echoing across the waves in a heartfelt tribute to Iemanjá. Their&nbsp;&lt;a class=&quot;read-more&quot; href=&quot;https://www.mamadele.com/new/event/arrastao-do-dende-reciclado-at-the-festa-de-iemanja/&quot;&gt;Continue reading&lt;/a&gt;&lt;/p&gt;\\n"
      }
    ],
