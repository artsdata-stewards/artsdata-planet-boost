    "http://schema.org/name": [
      {
        "@value": "Sons Reciclados no Teatro Gamboa"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;O projeto Sons Reciclados, que une arte, sustentabilidade e criatividade, acontece na sexta-feira, às 19h, no Teatro Gamboa, sob o comando de Dendê Macedo, com toda a renda arrecadada destinada ao local, que passa por um processo de ação coletiva destinada a arrecadação para a compra e manutenção do imóvel. O multiartista constrói instrumentos percussivos a&nbsp;&lt;a class=&quot;read-more&quot; href=&quot;https://www.mamadele.com/new/event/sons-reciclados-no-teatro-gamboa/&quot;&gt;Continue reading&lt;/a&gt;&lt;/p&gt;\\n"
      }
    ],
