    "http://schema.org/name": [
      {
        "@value": "Dendê Macêdo&#8217;s Recycled Sounds at Mt Airy Porchfest"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;On Saturday, September 13th, Dendê will be performing at 3:00 PM at the Mt Airy’s annual Porchfest that is happening on “porches” all over the neighborhood from 1-7pm! The Porchfest is an entirely volunteer-led and free music festival that brings the local community together to stroll the neighborhood and experience all kinds of musical arts.&nbsp;&lt;a class=&quot;read-more&quot; href=&quot;https://www.mamadele.com/new/event/dende-macedos-recycled-sounds-at-mt-airy-porchfest/&quot;&gt;Continue reading&lt;/a&gt;&lt;/p&gt;\\n"
      }
    ],
