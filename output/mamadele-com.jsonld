    "http://schema.org/name": [
      {
        "@value": "Celebrate Hispanic Heritage Month with Musicopia&#8217;s Afro-Brazilian Music Assembly!"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Tue, October 7, 2025 11:00 A.M. Children\\'s Department at Parkway Central Library Ologundê performs a diverse repertoire which includes the rituals associated with candomblé, a synthesis of the Yoruba and Catholic religions in which various orixás (gods) are invoked; the breathtaking capoeira martial arts dance; and the exhilarating samba de roda, the most traditional form of the inconic&nbsp;&lt;a class=&quot;read-more&quot; href=&quot;https://www.mamadele.com/new/event/celebrate-hispanic-heritage-month-with-musicopias-afro-brazilian-music-assembly/&quot;&gt;Continue reading&lt;/a&gt;&lt;/p&gt;\\n"
      }
    ],
