  {
    "@id": "https://loudinthepines.com/event/6436505/755885310/music-in-the-badlands",
    "http://opengraphprotocol.org/schema/title": [
      {
        "@value": "Music in the Badlands @ Dinosaur Provincial Park, Visitor Centre Outdoor Stage - Jun 5, 2026, 7:30PM"
      }
    ],
    "http://opengraphprotocol.org/schema/description": [
      {
        "@value": "Experience the magic of Dinosaur Provincial Park in a whole new way! Join us for an unforgettable evening of live music and captivating storytelling as the sun sets behind the iconic Alberta badlands. The show will take place outside at the Park Visitor Centre outdoor stage. In case of inclement weather, the show will be moved indoors to the Sternberg-Anderson Theatre."
      }
    ],
