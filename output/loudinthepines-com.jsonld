  {
    "@id": "https://loudinthepines.com/event/6436504/758587584/battle-for-jarred-with-0stella-susan-isaac",
    "http://opengraphprotocol.org/schema/title": [
      {
        "@value": "Battle for Jarred (with 0Stella & Susan Isaac) @ 9910 - May 21, 2026, 7:00PM"
      }
    ],
    "http://opengraphprotocol.org/schema/description": [
      {
        "@value": "A good bandmate is worth fighting for! This triple bill of artists has one thing in common: their favourite bandmate Jarred Albright. Talented multi-instrumentalist Jarred is constantly in demand; come for a night of watching Jarred change instruments (and outfits) as fast as he can, playing every genre and role Susan Isaac, Loud in the Pines, and 0Stella can ask of him."
      }
    ],
