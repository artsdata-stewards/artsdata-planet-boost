    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Celebrate Family Day at Studio Bell with a jam-packed day of musical fun for all ages! Admission is free. Explore five floors of interactive activities and enjoy live performances, including a headlining set from a local favourite!"
      }
    ]
