    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Les Voisins"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "La pièce Les Voisins sera présentée dès l'été 2022, explorant avec humour et tendresse les tensions de la vie de quartier. Portée par une distribution audacieuse, elle promet de révéler ce qui se cache derrière les murs de l'ordinaire."
      }
    ]
