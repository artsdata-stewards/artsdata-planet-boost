    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Une comédie à sketchs sur le thème le plus universel qui soit : le sexe. Retrouvez sur scène Simon Boudreault, Brigitte Lafleur et Laurent Paquin, sous la direction de Serge Denoncourt. Un spectacle décoincé, débridé… et totalement assumé."
      }
    ],
