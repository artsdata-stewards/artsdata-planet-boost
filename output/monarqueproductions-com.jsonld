    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Plongez dans l'humour nostalgique de Appelez-moi Stéphane, une pièce culte de Claude Meunier et Louis Saia revisitée par Monarque. Un spectacle hilarant d'une durée d'environ 2h30 avec entracte."
      }
