    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "La comédie culte « Le Père Noël est une ordure » sera présentée à l'été 2023 à la Maison des arts Desjardins Drummondville. Mise en scène par [nom du metteur en scène], elle réunit une distribution talentueuse pour offrir au public un classique toujours aussi percutant."
      }
    ]
