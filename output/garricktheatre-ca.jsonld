    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "It's that time again!  Come join us at The Garrick Annex on Wednesday, December 11th with your host Jared Barnes for another night of friendly competition and lots of fun -holiday style!  That’s right, this is the Christmas edition! We encourage you to dress up in your best holiday duds!  Doors open"
      }
