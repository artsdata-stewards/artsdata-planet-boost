    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Host, Paul Ryan, will have you laughing in your seats and give you the courage to get up on stage and sing a song or two while enjoying the great atmosphere of the Garrick Annex.     Cover $10 - Pay on the door. First come first served."
      }
    ],
    "http://ogp.me/ns#image": [
