    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Come join us for a special showing of the original Frankenstein movie from 1931. Black and white on the big screen. Each admission is a entry to win our Halloween Giftbasket, full of items from local stores around Bonavista. Basket will be drawn for on October 28th.      Tickets $7"
      }
    ],
