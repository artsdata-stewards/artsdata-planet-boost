    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Join us as we pair with Violence Prevention East to offer a FREE showing of It Ends With Us.  Lily Bloom moves to Boston to chase her lifelong dream of opening her own business. A chance meeting with charming neurosurgeon Ryle Kincaid soon sparks an intense connection, but as the two fall deeply in"
      }
