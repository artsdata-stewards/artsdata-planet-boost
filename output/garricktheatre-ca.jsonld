    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Reformed criminals Mr. Wolf, Mr. Snake, Mr. Piranha, Mr. Shark and Ms. Tarantula are trying very hard to be good. However, they soon find themselves hijacked into a high-stakes heist that's masterminded by a new team of delinquents they never saw coming -- the Bad Girls.    Trailer     Tickets"
      }
