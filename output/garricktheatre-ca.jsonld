    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Where the Crawdads Sing tells the story of Kya, an abandoned girl who raised herself to adulthood in the dangerous marshlands of North Carolina. For years, rumors of the \"Marsh Girl\" haunted Barkley Cove, isolating the sharp and resilient Kya from her community.    Tickets $10"
      }
    ],
