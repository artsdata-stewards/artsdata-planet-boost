    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Back for Season 3!    Trivia Thursday takes place every second Thurday at 8:30pm in the Annex. Doors open at 8pm.    $10 a team, 8 members max. Phones placed in sealed containers on your table. No reservations, first come, first served."
      }
