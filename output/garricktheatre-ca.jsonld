    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "In 1957 London, Mrs. Ada Harris, a widowed cleaning lady, becomes obsessed with a haute couture Dior dress of one of her clients; it inspires her to buy her own Dior dress. After suddenly receiving a war-widow's pension, she embarks on an adventure to Paris to do so.    Tickets $10"
      }
    ],
