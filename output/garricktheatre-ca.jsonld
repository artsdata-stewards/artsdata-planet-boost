    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Monthly Karaoke Night - March 18th.  The Annex will be decorated still for St. Patrick’s Day, so why not come out with some friends, sing some songs and sip on some green beers, or green mocktails!     $5 cash cover on the door. Doors open at 8pm. Karaoke runs from 9pm-12am."
      }
