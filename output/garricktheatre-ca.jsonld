      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Blending country-soul with her Irish-Newfoundland roots, Sherry affirms her place as one of East Coast’s best-loved singer-songwriters. Her song “Stop the Trains” about her father’s 1950s railway encounter with the infamous Wreckhouse winds has quickly become a part of the Newfoundland canon of lege"
      }
    ],
