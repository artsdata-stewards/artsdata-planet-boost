    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Buckle up! Girls On The Go is back in full force! Fresh out of pride season and ready to dance and twirl, entertain you all with a show like no other in a town near you. Beep Beep - We are packing the wigs and lashes and hitting the highway!    OPHELIA DELIGHT     DIVINE DIAMOND      BETTY BOO KAKKE"
      }
