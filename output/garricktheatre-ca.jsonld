    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "“Guaranteed to blow your mind”, Kelly-Ann Evans and friends perform all the iconic songs that have made Queen one of the most legendary rock bands of all time.&nbsp; With brilliant 4 part harmonies and incredible musicianship, you’ll hear hits such as I Want to Break Free, Under Pressure, Killer"
      }
