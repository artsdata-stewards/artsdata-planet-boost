    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "The 2023 Tuckamore Festival is premiering a new work, Taking on Water, featuring actors Robert Chafe and Louise Moyse, alongside Tuckamore Festival Artistic Directors Nancy Dahn and Timothy Steeves.  In the fall of 2021, playwright Robert Chafe set out on an interview tour of eastern Newfoundland, a"
      }
    ],
    "http://ogp.me/ns#image": [
