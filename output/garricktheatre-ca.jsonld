  {
    "@id": "http://www.garricktheatre.ca/whats-on/the-show-must-go-on-the-music-of-queen",
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en-ca",
        "@value": "Garrick Theatre"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "The Show Must Go On: The Music of Queen — Garrick Theatre"
      }
    ],
    "http://ogp.me/ns#latitude": [
      {
        "@language": "en-ca",
        "@value": "40.7207559"
      }
    ],
    "http://ogp.me/ns#longitude": [
      {
        "@language": "en-ca",
        "@value": "-74.0007613"
      }
    ],
    "http://ogp.me/ns#locality": [
      {
        "@language": "en-ca",
        "@value": ""
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
        "@value": "https://garricktheatre.ca/whats-on/the-show-must-go-on-the-music-of-queen"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-ca",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "“Guaranteed to blow your mind”, Kelly-Ann Evans and friends perform all the iconic songs that have made Queen one of the most legendary rock bands of all time.&nbsp; With brilliant 4 part harmonies and incredible musicianship, you’ll hear hits such as I Want to Break Free, Under Pressure, Killer"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "http://static1.squarespace.com/static/62794c539ef87f72a6840b47/6287bc6baf89792335b40987/6647de80864a2240b5ed8e1a/1716055395588/Kelly_queenshow_banner_2024+copy.jpg?format=1500w"
      }
    ],
    "http://ogp.me/ns#image:width": [
