    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "It's that time again!  Come join us at The Garrick Annex on Thursday, April 3rd with your host Jared Barnes for another night of friendly competition and lots of fun!   Doors open at 7:30 PM Trivia starts at 8:15 PM  As always, $10.00 per team - maximum 8 per team No reservations - first come, first"
      }
