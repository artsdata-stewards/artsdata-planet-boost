    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "When Paddington discovers his beloved aunt has gone missing from the Home for Retired Bears, he and the Brown family head to the jungles of Peru to find her. Determined to solve the mystery, they soon stumble across a legendary treasure as they make their way through the rainforests of the Amazon."
      }
    ],
