    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Join us on Friday night for Open Mic night!  Hosted by Paul Ryan with special guest, Ian Abbott.  We invite you to drop in and sing a tune, do a little dance, put on your best comedy act or grab a drink and sit and watch!    $10 at the door"
      }
    ],
