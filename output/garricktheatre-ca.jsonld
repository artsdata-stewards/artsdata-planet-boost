    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Beep beep! We are back again with another iconic drag show in the gorgeous gorgeous BONAVISTA! We cannot wait to spend the evening twirling and dancing away for so many beautiful faces! These shows are Always such a blast. And they sell out fast so get your tickets now! NOVEMBER 19TH AT THE GARRICK"
      }
    ],
