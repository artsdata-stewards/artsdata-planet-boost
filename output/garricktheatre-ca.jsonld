    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Zay Nova is a new Canadian country singer-songwriter and radio producer. He was born in a small village called Sempan on Bangka Island, Indonesia. As with many kids, one of his teachers asked, “When you grew up, what do you want to be?” He answered the question by saying, “I want to be a songwriter!"
