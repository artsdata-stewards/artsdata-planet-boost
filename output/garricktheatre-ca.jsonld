    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Back by popular demand! If you missed this show last year, now is your chance. Kelly-Ann and Band put off a beautiful show, incorporating the timeline of the Laurel Canyon Music Scene from the 60's and 70's. This included music from Joni Mitchell, Crosby, Stills and Nash, Mama's and Papas, and so mu"
      }
