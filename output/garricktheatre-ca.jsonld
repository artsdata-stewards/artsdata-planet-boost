    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Our second Friday On Church is happening on August 11th Morgan Davis. Pop in to our Annex Lounge anywhere from 9pm-11pm to take in the show and have a beverage.   Tickets can be purchased in advance by card for $15, or pay cash on the door and get your ticket for $10!    Advance Ticket $15"
      }
    ],
