    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Bonavista! We are back and we are so excited to announce that it's our biggest show yet! 6 of Newfoundlands premier drag entertainers are coming your way to slay the stage and bring you a stunning show you don't wanna miss! Are ya excited? We are.   FEBRUARY 10TH AT THE GARRICK ANNEX    9PM -   $25"
      }
    ],
