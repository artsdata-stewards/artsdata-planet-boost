    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "SOLD OUT   The Newfoundland and Labrador Film Development Corporation will be screening Disney’s Peter Pan &amp; Wendy on our big screen on Thursday, April 27th.     Admission is free and limited seats are available.  Please call 709-468-5777 by April 21st and speak to Amy to reserve your seats."
      }
