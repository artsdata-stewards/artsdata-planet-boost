    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Join us for our off season Trivia League. Put a team together (8 members maximum) and join us in the Garrick Annex for Popcorn and a night of brain challenging questions. $10 per team. Prizes weekly, with a grand prize given out in the spring for the team that earns the most points over the winter!"
      }
    ],
