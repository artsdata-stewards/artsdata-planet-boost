    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Open Mic is back!  What a treat to have Samantha Rolls jumping on board as your host! Come on out next Friday night for our first Open Mic of the year.  Sing a song, tell a joke, do a little dance or sit back and enjoy a drink!  We can't wait to see you!"
      }
