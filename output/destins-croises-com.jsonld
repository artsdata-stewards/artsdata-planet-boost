  {
    "@id": "https://www.destins-croises.com/event-details/le-sacre-de-lila-scolaire",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Le sacre de Lila (Scolaire) | Destins Croisés"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Cette représentation est dédiée au public scolaire et n'est donc pas ouverte au public.\n\nSi vous souhaitez emmener votre classe ou votre école voir Le sacre de Lila, n'hésitez pas à contacter le Théâtre de la Ville de Longueuil : infotheatre@theatredelaville.qc.ca"
      }
