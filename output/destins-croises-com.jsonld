      {
        "@language": "en",
        "@value": "https://static.wixstatic.com/media/9e626b_60fd896eee6140f385c98863e28b56f3~mv2.jpg/v1/fill/w_3330,h_2345,al_c,q_90/9e626b_60fd896eee6140f385c98863e28b56f3~mv2.jpg"
