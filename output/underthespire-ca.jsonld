        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Spring cleaning season is here, and we're taking full advantage by offering a community yard sale.    Join us at the PCU Pavilion from 9AM-1PM for a yard sale full of unique finds. We have everything from home goods and antiques, to tools and equipment, to CD and music items, to vintage Under the Spire memorabilia!    All items are PWYC. Thank you for coming out to support our organization!"
      }
    ],
