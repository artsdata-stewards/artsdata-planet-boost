    "http://schema.org/image": [
      {
        "@id": "https://underthespire.ca/wp-content/uploads/2024/03/20-August-23-Vishten-Connexions_1920x1080_72ppi.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://underthespire.ca/events-2/vishten-connexions/?occurrence=2024-08-23"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
