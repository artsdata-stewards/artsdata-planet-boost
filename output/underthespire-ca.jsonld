    "http://schema.org/image": [
      {
        "@id": "https://underthespire.ca/wp-content/uploads/2025/04/TCantin-A10.png"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://underthespire.ca/events-2/tracy-cantin/?occurrence=2025-08-10"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://underthespire.ca/events-2/tracy-cantin/"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Hailing from Prince Edward Island and Nova Scotia, this trio of Maritime marvels include Summerside’s own award-winning soprano Tracy Cantin, tenor Marcel d’Entremont, and pianist Dakota Scott-Digout. Each accomplished soloists in their own right, this trio has curated an evening of music with something for everyone.  Opera fans will swoon for selections from Tosca, La bohème and La traviata, musical theatre lovers will be delighted by favourites from Carousel and Man of La Mancha, while popular folk songs and golden oldies will have your toes tapping and hands clapping all while enjoying the extraordinary natural acoustics of Historic St. Mary’s church.    Tracy, Marcel, and Dakota have toured together extensively throughout the Maritime provinces, and are delighted to finally have the opportunity to bring their talents and love of music to PEI for the 30th anniversary season of the Under the Spire."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Tracy Cantin %26 Friends"
      }
    ],
