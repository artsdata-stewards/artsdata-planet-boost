    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Heather Rankin is a singer, songwriter, actor, and member of the 6X Juno Award winning band The Rankin Family. Heather is a well-known name throughout Canada for her showstopping muscality and showcasing Cape Breton culture."
      }
