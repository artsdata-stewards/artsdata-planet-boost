    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Have you ever dreamed of performing on the St. Mary's stage?    With our Open Mic nights, now you have your chance! Join us for an evening of community talent and connection. Hosted by UTS sound tech and local musician Curtis Klein, we're ready to hear you share your music with the crowd.    Our second instalment is taking place September 11th from 7-9PM. Depending on the number of participants, we ask that each musician performs 2-3 songs maximum.    UTS will provide access to our grand piano and a microphone. We can't wait to hear you!"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Open Mic Night: Hosted by Curtis Klein!"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
