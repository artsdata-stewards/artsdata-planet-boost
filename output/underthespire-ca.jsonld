        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "In partnership with PEERS Alliance and Pride PEI, Under the Spire presents our third annual Pride Ceilidh!    Join us for a free and family friendlyconcert featuring performers Craig Fair, Anastasia DesRoches, Tunes &amp; Tales, the Celtic Feet Dance Company and more!! This year, PEI's poet laureate Tanya Davis hosts the event so get ready for lots of laughs, queer-affirming moments, poetry, and foot-stomping music all night! If that's still not enough, come see Historic St. Mary's covered in pride and rainbow flags!    Transportation will be provided from Charlottetown to St. Mary's and back after the concert.  Check out PridePEI.ca for more details!"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "2024 Pride Ceilidh"
      }
    ],
