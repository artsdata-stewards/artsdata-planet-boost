    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Have you ever dreamed of performing on the St. Mary’s stage?    With our Open Mic nights, now you have your chance! Join us for an evening of community talent and connection. Hosted by local musician Marc Ekins, we’re ready to hear you share your music with the crowd.    Depending on the number of participants, we ask that each musician performs 2-3 songs maximum. Participating musicians will be asked to sign-up upon their arrival at the venue - to let us know your name and how many songs you'll be performing with us!    UTS will provide access to our grand piano, microphones and direct input for guitars. We can’t wait to hear you!"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Open Mic Night: Hosted by Marc Ekins!"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
