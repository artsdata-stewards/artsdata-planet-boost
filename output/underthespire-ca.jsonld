    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://underthespire.ca/events-2/angels-in-the-architecture-the-songs-of-paul-simon/"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Join Nick Doneff - and his special musical guests Carlie Howell and Meaghan Blanchard - to experience an evening exploring the songs of Paul Simon.  In a career spanning over six decades, Paul Simon has often defied musical genre yet remained timeless and popular. His songs and recordings weave intricate, diversely informed arrangements with sympathetic poetry and storytelling. Join us at Under the Spire as Charlottetown artist Nick Doneff performs careful distillations of some of Simon’s most compelling and popular songs."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Angels in the Architecture: The Songs of Paul Simon"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
