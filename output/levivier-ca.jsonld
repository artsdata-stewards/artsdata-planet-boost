    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Originally from Quebec, Canada, this composer with a multi-instrumental background has worked for more than 15 years in North American, European and Asian musical circles. Although his reputation is mainly established as a composer of concert music, from chamber music to symphonic music, he has also devoted himself to arrangements and orchestrations in jazz and popular music, and in recent years, more particularly in film music.\r\n"
      }
    ],
