    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Canadian Guitarist and Composer, Emmanuel Jacob Lacopo (b. 1996), is an artist driven by collaboration and innovation who aims to redefine the constraints of the 21st century guitar. Acknowledged as one of CBC’s 2023 “30 under 30 classical musicians,” his music challenges conventions and offers an expanded world of soundscapes and textures. By showcasing varying settings of electronics, classical guitar, and electric guitar within the context of classical music, Lacopo unifies the different stylistic and cultural worlds of the guitar to create a more realistic picture of the genre in..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
