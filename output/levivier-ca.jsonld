    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "DÉVOILEMENT VIRTUEL SAISON HIVER-PRINTEMPS 2023"
      }
    ],
    "http://schema.org/alternateName": [
      {
        "@language": "fr",
        "@value": "RENDEZ-VOUS LE 1ER DÉCEMBRE"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "À VOS AGENDAS !\r\n\r\nLe Vivier dévoile sa saison hiver-printemps 2023 dans une semaine !\r\nOn vous promet une belle saison pour les musiques nouvelles,\r\npleine de découvertes et de rencontres inattendues qui raviront les oreilles, mais pas seulement !\r\n\r\nINTÉRESSÉ·E·S ?\r\n\r\nSuivez-nous sur les réseaux sociaux et surveillez votre boîte courriel pour ne rien rater !&nbsp;\r\nPour patienter, on vous partage quelques-uns des visages de la saison.&nbsp;\r\n"
      }
    ],
