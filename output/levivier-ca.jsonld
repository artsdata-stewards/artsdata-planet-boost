    "http://schema.org/organizer": [
      {
        "@id": "_:g3499360"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/concert/saison-2024-25/carl-ludwig-hubsch-cartographie-origines"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Carl Ludwig Hübsch: Cartographie - Origines"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Ce concert est l’aboutissement des recherches et du travail de création du compositeur et tubiste allemand Carl Ludwig Hübsch lors de sa résidence au Québec.Accueilli par SuperMusique, le compositeur vient à la rencontre de la musique nouvelle et improvisée québécoise. De Montréal à Rimouski, en passant par Québec, il a côtoyé, joué et discuté avec des instrumentistes de l’Ensemble SuperMusique (ESM), du Grand groupe régional d’improvisation libérée (GGRIL), de l’Ensemble de musique improvisée de Québec (EMIQ) et de Bakarlari. Ces rendez-vous lui ont permis de sonder leurs pratiques instrumentales, de comprendre quel type d’expérience ces artistes souhaiteraient éprouver et les questionner sur la manière dont une nouvelle œuvre devrait idéalement être \"improvisée\". Visant à traduire les diverses origines musicales et géographiques de ces instrumentistes, il nous présente une œuvre inspirée autant par le lieu que par l’environnement social; une œuvre tissée en réseau qui intègre aussi des éléments enregistrés lors de ses échanges avec les musiciens et musiciennes.Ce programme est rendu possible grâce au soutien du CALQ et à la collaboration de HELLERAU - European Center for the Arts Dresden, Goethe-Institut Montréal, Le Vivier - Carrefour des musiques nouvelles et l'Antenne du Québec à Berlin"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-04-26T21:00:00-04:00"
      }
    ]
  },
