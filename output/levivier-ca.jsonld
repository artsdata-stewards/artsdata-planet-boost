    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Nuit Blanche: Vibrations éphémères - Le Grand POP"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Pour la Nuit blanche, Le Vivier et Totem contemporain vous invitent à découvrir une installation cinétique, sonore et visuelle.Composée de dispositifs sonores et lumineux, des bols en acier disposés en cercle et animés par de petites hélices, cette œuvre en perpétuel mouvement vous invite à observer, écouter et vous émerveiller. Inspirée du mouvement circulaire, elle transforme des objets du quotidien en une expérience visuelle et sonore captivante. Tantôt douces comme des cloches d’église, tantôt envoûtantes comme des bols chantants tibétains, ses harmonies changeantes éveilleront la curiosité des petits et des grands.&nbsp;"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-03-02T04:00:00-05:00"
      }
    ]
