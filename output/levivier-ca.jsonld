    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://sixtrum.com/en"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Sixtrum Percussion"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "With roots firmly planted in the major classics that formed the percussion ensemble genre of the 20th Century, today Sixtrum embarks in an unbridled exploration of contemporary percussion. Made up of virtuosic and multi-talented performers, Sixtrum renews its artistic universe through constant confrontation with other art forms and other musical genres. Every collaboration aims to investigate new forms of expression and new modes of presentation that will form new links between music, musicians and audience."
      }
    ],
    "@type": [
      "http://schema.org/PerformingGroup"
    ]
  },
  {
    "@id": "_:g15544480",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/en/artists/cordame"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/artists/cordame"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Cordâme"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Cordâme est un ensemble montréalais de musique de chambre, fondé en 2004. Reconnu pour son interprétation originale des compositions de Jean-Félix Mailloux, l'ensemble explore les sonorités des cordes, aux frontières du classique et du jazz. Cordâme a donné naissance à des albums acclamés par la critique, tels que Lieux imaginés et Da Vinci inventions. Lauréats de nombreux prix, dont le prix OPUS et finalistes ADISQ, l'ensemble a présenté plus de 60 représentations de leur spectacle Satie Variations, à travers le Québec. Il est &nbsp; également très actif sur la scène internationale. Piloté par le prolifique contrebassiste Jean Félix Mailloux, l’ensemble offre des concerts chargés d’émotion grâce à une musique subtile et sensible."
      }
    ],
    "@type": [
      "http://schema.org/PerformingGroup"
    ]
  },
