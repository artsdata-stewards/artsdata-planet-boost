    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Mad Max"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/le-vivier/repertoire/mad-max"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "en",
        "@value": "Cette pièce est une commande du festival Aujourd’hui Musiques et a été développée dans le cadre du projet Gekipe porté par l'ensemble Flashback initialement pour le percussionniste Philippe Spiesser.&nbsp;\r\nAprès une première rencontre axée sur la découverte du système Gekipe (un dispositif de captation du geste) j’ai décidé d’aborder ce projet sous un angle profondément théâtral.&nbsp;\r\nJ’ai donc avant tout cherché ici à créer un personnage, dont la définition même transiterait par une gestuelle iconographique me permettant de développer les mouvements dans un..."
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
