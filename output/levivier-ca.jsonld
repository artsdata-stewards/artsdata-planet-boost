  {
    "@id": "https://levivier.ca/fr/concert/saison-2024-25/quatuor-bozzini-konus-quartett-jurg-frey",
    "https://ogp.me/ns#site_name": [
      {
        "@language": "fr",
        "@value": "Le Vivier"
      }
    ],
    "https://ogp.me/ns#type": [
