    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Pour cette sixième édition&nbsp;du&nbsp;Vivier en coulisse, Gabriel Dufour-Laperrière s’entretiendra avec Louis-Philippe Bonin et David Therrien Brongo du Duo AIRS sur leur prochain concert Miseo présenté le 16 mars prochain dans la saison du Vivier.&nbsp;\r\n"
      }
    ],
