    ],
    "http://schema.org/familyName": [
      {
        "@language": "en",
        "@value": "Zombik"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Kim Zombik is known for her unembellished, poignant style, twice nominated as one of top ten “Best Female Jazz Vocalists” by Japan’s SWING Journal Jazz Magazine. With over 12 albums, one can hear her evolving path through pop, choral, funk, jazz and her new studies of Indian Classical singing. Kim aims to create music that brushes the heart with honesty and pleasure. She has performed in the Montreal International Jazz Festival (2005, 2009, 2014), the L’OFF Jazz Festival (2014, 2018), the Ginza Jazz Festival (Japan 2007), the “New York Blues” Festival in Siberia (2008), as well..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
