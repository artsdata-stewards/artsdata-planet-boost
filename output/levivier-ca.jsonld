    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Portrait#2 Alla Zagaykevych // VivierMix"
      }
    ],
    "http://schema.org/alternateName": [
      {
        "@language": "fr",
        "@value": "avec Quasar, Pamela Reimer, Lyne Allard, Hubert Brizard, Marie-Annick Béliveau (Chants Libres), et Corinne René (Productions SuperMusique)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dans ce deuxième concert-portrait d’Alla Zagaykevych, l’artiste ukrainienne en résidence au Vivier, nous invite à entendre trois œuvres de son répertoire et une création. Elles seront interprétées par Quasar (saxophones), Pamela Reimer (piano), Lyne Allard (violon), Hubert Brizard (violon), Marie-Annick Béliveau (mezzo-soprano - Chants Libres), Corinne René (percussions - PSM).\r\n"
      }
    ],
