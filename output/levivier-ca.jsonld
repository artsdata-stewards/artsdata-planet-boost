      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "the way water breathes"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/le-vivier/repertoire/way-water-breathes"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "fr",
        "@value": "L’approche instrumentale de Lacopo dans the way water breathes s’inspire des influences musicales de la musique progressive, du post-rock et de ambient. Grâce à sa fusion avec la guitare classique, la pièce présente une nouvelle façon d’approcher l'instrument en incorporant des techniques étendues typiques de ces genres. Une nouvelle scordatura, souvent utilisée par le groupe Covet, transpose l'instrument à une sonorité ouverte qui permet de rendre beaucoup plus accessibles des gestes auparavant impossibles. Avec l’utilisation du Hologram Electronics Microcosm en tant que..."
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
  {
    "@id": "_:g34215740",
    "http://schema.org/url": [
      {
