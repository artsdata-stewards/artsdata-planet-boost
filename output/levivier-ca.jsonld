    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/artistes/membres/organismes/isabelle-bozzini"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Isabelle Bozzini"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "fr",
        "@value": "Isabelle"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "fr",
        "@value": "Bozzini"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Chambriste passionnée, la violoncelliste Isabelle Bozzini se dédie à deux mondes parallèles: les musiques nouvelles de tout acabit et la musique sur instrument d’époque. Cette entreprise constitue un défi de tous les instants et nourrit pleinement ses aspirations artistiques.\r\n\r\nElle est membre-fondatrice et codirectrice du Quatuor Bozzini, groupe qui se distingue parmi les quatuors à cordes canadiens depuis 1999, tant sur la scène nationale qu’internationale. Présentant près d’une quarantaine de concerts par année, les Bozzinis produisent leur propre série montréalaise..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
  {
    "@id": "_:g3920180",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/fr/le-vivier/membres/organismes/quasar/marie-chantal-leclair"
