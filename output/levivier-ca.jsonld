    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/concert/saison-2022-23/concert-du-printemps"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "CONCERT DU PRINTEMPS"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Point culminant de la saison dédiée aux victimes de la guerre en Ukraine, ce concert, sous la direction de Lorraine Vaillancourt présente les œuvres de cinq compositeur·trice·s à découvrir. L’événement signe également la dernière rencontre de l’année avec Alla Zagaykevych, compositrice ukrainienne en résidence au Vivier, avec la création d’une œuvre écrite pour le Nouvel Ensemble Moderne (NEM).\r\n"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2023-05-05T23:30:00-04:00"
      }
    ]
  },
