      }
    ],
    "https://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Quatuor Bozzini & Konus Quartett / Jürg Frey | Le Vivier"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "En grande première à Montréal, une œuvre profonde de Jürg Frey, compositeur cultissime. Après plusieurs concerts donnés en Europe, le Quatuor Bozzini invite enfin le Konus Quartett à Montréal pour interpréter la première canadienne de l'œuvre de Jürg Frey, Continuité, fragilité, résonance (2019-21). Chacun des ensembles entretient une relation particulière avec Jürg grâce à des commandes antérieures, et maintenant la combinaison étonnante du quatuor à cordes et du quatuor de saxophones révèle un autre domaine de beauté dans l'univers sonore de Jürg Frey."
      }
    ],
    "https://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/sites/default/files/evenements/BOZZINI-KONUS-PAGE.jpg"
      }
    ],
