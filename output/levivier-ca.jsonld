    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Quatuor Bozzini & Konus Quartett / Jürg Frey"
      }
    ],
    "http://schema.org/alternateName": [
      {
        "@language": "fr",
        "@value": "Continuité, fragilité, résonance"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "En grande première à Montréal, &nbsp;une œuvre profonde de Jürg Frey, compositeur cultissime.&nbsp;Après plusieurs concerts donnés en Europe, le Quatuor Bozzini invite enfin le Konus Quartett à Montréal pour interpréter la première canadienne de l'œuvre de Jürg Frey, Continuité, fragilité, résonance (2019-21). Chacun des ensembles entretient une relation particulière avec Jürg grâce à des commandes antérieures, et maintenant la combinaison étonnante du quatuor à cordes et du quatuor de saxophones révèle un autre domaine de beauté dans l'univers sonore de Jürg Frey."
      }
    ],
