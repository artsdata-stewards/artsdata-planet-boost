      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g17590780"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g17590820"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/concert/saison-2025-26/quasar-trio-zukan-chambre-decoute"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Quasar & Trio Zukan — Chambre d'écoute"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le quatuor de saxophones Quasar poursuit ses collaborations internationales en s'associant au Trio Zukan, originaire du Pays Basque espagnol.Quasar retrouve le Trio Zukan (percussions, accordéon et txistu) avec Chambre d’écoute: une rencontre approfondie des musiques nouvelles québécoises et basques dans un concert unique et immersif. En ouverture, l’œuvre &nbsp;de la compositrice québécoise Chantale Laplante Chambre d’écoute 2, qui prête son titre au concert, sera présentée en création internationale. Suivra un programme riche et audacieux mettant en valeur les couleurs des deux ensembles, que le public pourra découvrir dans diverses formations et sonorités : trio, quatuor, quintette et même septuor, acoustique ou avec électroniques, un événement incontournable de la rentrée montréalaise!"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-09-18T23:30:00-04:00"
      }
    ]
  },
