    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Nouvel Ensemble Moderne"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Founded in 1989 by conductor Lorraine Vaillancour, the Nouvel Ensemble Moderne (NEM) is a chamber orchestra composed of 15 permanent members who perform in Québec, in Canada, and across the world.&nbsp;\r\n\r\nGuided by a duty to perform the essential works of the 20th and 21st centuries, both on the national and international stages, and by a willingness to nurture the creation of new works, the NEM’s mission is to disseminate and promote this music. Widely acknowledged as a leader in its field, the NEM is recognized for its modernism and excellence in all aspects of the performance,..."
      }
    ],
    "@type": [
      "http://schema.org/PerformingGroup"
    ]
  },
