    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://www.architekpercussion.com/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Architek Percussion"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le quatuor montréalais Architek Percussion se spécialise dans l’interprétation de la musique de chambre multipublic, expérimentale, minimaliste, pluridisciplinaire et électroacoustique. Fondé en 2012, le groupe s'est rapidement imposé comme une force dynamique au sein de la nouvelle musique canadienne, autant à l’aise de jouer des pièces du répertoire classique que d’innover en jouant des œuvres commandées et des créations."
      }
    ],
    "@type": [
      "http://schema.org/PerformingGroup"
    ]
  },
  {
    "@id": "_:g32444740",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/fr/le-vivier/repertoire/we-are-while"
      }
    ],
    "http://schema.org/datePublished": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2016"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "We are for a while"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/le-vivier/repertoire/we-are-while"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "fr",
        "@value": "We are for while, écrit dans le cadre d'une résidence de son et de musique à Apartment House :\r\n\r\nVitalija Glovackyte crée une musique gazeuse et profonde à l'aide d'instruments acoustiques, d'appareils électroniques et de dispositifs lo-fi. Ses œuvres vont des petites miniatures sur bande magnétique aux performances multimédias à grande échelle, en passant par des concerts en solo. Son œuvre récente Virtual Love pour mini-synthétiseur et projecteur de diapositives a été décrite comme \"un petit conte touchant... dans lequel une musique nostalgique émerge comme un chaos..."
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
