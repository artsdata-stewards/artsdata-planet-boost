        "@language": "fr",
        "@value": "https://levivier.ca/fr/concert/saison-2022-23/qmp-quatuor-bozzini-kyriakides-moor"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "QMP: Quatuor Bozzini /  Kyriakides + Moor"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Ne manquez pas le passage de Québec Musiques Parallèles à Montréal pour une soirée de musiques éclatées en compagnie du Quatuor Bozzini et du duo Moor-Kyriakides, guitare électronique et électronique! Une rencontre inédite entre des artistes d’ici et d’ailleurs.&nbsp;\r\n"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2022-10-16T23:30:00-04:00"
      }
    ]
  },
