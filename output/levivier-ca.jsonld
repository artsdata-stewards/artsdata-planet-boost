    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Génération PLUS !"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "ECM+, Le Vivier and the Conservatoire de Montréal invite you to the final concert of Generation2020, an encore performance of the works by composers Gabriel Dufour-Laperrière and Matthew Ricketts that tied for the Steven R. Gerber National Jury Award. In addition, five young guest soloists perform a repertoire of exciting contemporary works that will put their skills and immense talent to the test.\r\n"
      }
    ],
