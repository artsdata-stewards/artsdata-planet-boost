  {
    "@id": "_:g35174480",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/fr/le-vivier/repertoire/saxoctet"
      }
    ],
    "http://schema.org/datePublished": [
      {
        "@type": "http://schema.org/Date",
        "@value": "1985"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Saxoctet"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/le-vivier/repertoire/saxoctet"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "fr",
        "@value": "Cette œuvre emploie une écriture polyphonique sans langage harmonique ni véritable contrepoint. Elle exploite l'hétérophonie : plusieurs lignes réalisent simultanément la même idée mélodique avec des variantes. Les instruments sont parfois traités comme s'ils appartenaient à des familles différentes. La pièce s'articule en cinq mouvements, tous basés sur la même mélodie : Giusto e semplice, Giardino, Scorrévole, Tenso et Transe.\r\nJose Evangelista\r\n"
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
  {
    "@id": "_:g35174520",
