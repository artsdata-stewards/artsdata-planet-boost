  {
    "@id": "_:g14532360",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/en/le-vivier/repertoire/adherence"
      }
    ],
    "http://schema.org/datePublished": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2024"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Adherence"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/le-vivier/repertoire/adherence"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "en",
        "@value": "Adherence was written near the end of a period where many of my works were being influenced by musical organizing principles of the European Medieval period, particularly techniques such as isorhythm and cantus firmus. As with most of my work, Adherence is a purely procedural composition, where the processes at play within the musical material are tightly controlled and rigorously planned out beforehand. Adherence contains a single melodic line, using the familiar basis of pitches derived almost purely from the harmonic series as a colour palette of sorts. The melodic line has been expanded..."
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
