      }
    ],
    "http://schema.org/datePublished": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2021"
      }
    ],
    "http://schema.org/composer": [
      {
        "@id": "_:g12136860"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Vitesse locale"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/le-vivier/repertoire/vitesse-locale"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "en",
        "@value": "Les procédés d’écritures seront puisés dans le « système » compositionnel que j’établie maintenant depuis plusieurs années. Ces mécanismes compositionnels pourraient globalement être ramenés à des modélisations de phénomènes naturels. Ma musique est traversée par des principes d’organisations Physique comme on en trouve dans la physique quantique, la physique du Chaos, la physique électro-magnétique. Il y a des champs de forces, des lois combinatoires, des auto-régulations éphémères,...\r\nMais d’une certaine manière, ces organisations abstraites n’excluent..."
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
