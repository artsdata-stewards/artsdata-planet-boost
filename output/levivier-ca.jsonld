    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Ensemble Land of Kush"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Land Of Kush est un grand orchestre réuni et dirigé par le compositeur et musicien Sam Shalabi, largement reconnu comme l'un des musiciens les plus uniques et prolifiques de Montréal depuis plus de deux décennies. Shalabi se produit constamment à la guitare électrique et au oud, avec des apparitions régulières dans de nombreux ensembles de jazz et d'improvisation libre, en tant que membre d'un kaléidoscope de groupes de rock avant-gardistes et à la tête de la composition de divers assemblages musicaux, grands et petits.\r\n\r\nShalabi a sorti des dizaines d'albums au fil des ans sous..."
      }
    ],
    "@type": [
      "http://schema.org/PerformingGroup"
    ]
  },
