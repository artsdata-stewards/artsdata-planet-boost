    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/hors-les-murs/saison-2022-23/atelier-partage-au-sujet-de-lharmonie-naturelle-avec-simon-martin"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Atelier-partage au sujet de l’harmonie naturelle avec Simon Martin"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "À la façon d’un repas-partage («potluck»), Simon Martin invite les musicien·ne·s professionnel·le·s, compositeur·trice·s ou interprètes, à amener leur contribution à la table pour la partager en groupe de façon conviviale. Une idée, une question, une expérience, une découverte, un projet de composition... tout ce qui concerne l’harmonie naturelle, ou les échelles musicales non-conventionnelles de façon générale, est bienvenu.\r\n"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2023-06-21T18:00:00-04:00"
      }
    ]
  },
