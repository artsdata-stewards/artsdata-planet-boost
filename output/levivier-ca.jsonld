    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Inter-university meetings - Master classes"
      }
    ],
    "http://schema.org/alternateName": [
      {
        "@language": "en",
        "@value": "Quebec/Europe musical residencies and creations"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The inter-university meetings of Résonance Croisée, which will take place in the fall 2021 in conjunction with part 1 of the event, will be an opportunity for young composers and performers to discover compositional approaches and processes, to learn about new instrumental practices and to approach new listening perspectives on sound\r\nand new technological tools. The students will participate in five online master classes and will attend the entirety of the webcast concerts. At the end of these encounters, students who wish to do so will be able to compose sketches or short pieces, which will be performed in April, during the second part of the event.\r\n"
      }
    ],
    "http://schema.org/keywords": [
      {
        "@language": "en",
        "@value": "Meetings"
      }
    ]
  },
