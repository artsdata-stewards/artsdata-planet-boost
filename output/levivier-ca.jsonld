  {
    "@id": "_:g15166920",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/en/le-vivier/repertoire/saxoctet"
      }
    ],
    "http://schema.org/datePublished": [
      {
        "@type": "http://schema.org/Date",
        "@value": "1985"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Saxoctet"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/le-vivier/repertoire/saxoctet"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "en",
        "@value": "\r\n\r\nThis work employs polyphonic writing without harmonic language or real counterpoint. It exploits heterophony: several lines simultaneously realize the same melodic idea with variations. Instruments are sometimes treated as if they belong to different families. The piece is articulated in five movements, all based on the same melody: Giusto e semplice, Giardino, Scorrévole, Tenso and Trans\r\n\r\nJose Evangelista\r\n\r\n\r\n"
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
  {
