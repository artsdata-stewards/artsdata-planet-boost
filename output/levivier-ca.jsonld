    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/concert/saison-2021-22/duo-doblinger-neyrinck-12-avril"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "DUO DOBLINGER & NEYRINCK (AT) | 12 AVRIL"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Comment expliquer que des heures durent un instant et des secondes, une éternité? Que serait le temps sans horloge? Et si nous reprenions le contrôle de nos vies? L’espace d’une heure, une clarinettiste basse et un pianiste nouent un dialogue musical émouvant sur le temps et son emprise sur notre existence.\r\n"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2022-04-12T22:00:00-04:00"
      }
    ]
  },
