    "https://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "CONCERT DU PRINTEMPS | Le Vivier"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Highlighting this season dedicated to the victims of the war in Ukraine, this concert, conducted by Lorraine Vaillancourt, presents the works of five composers yet to be discovered. The event also marks the last meeting of the year with Alla Zagaykevych, Ukrainian composer in residence at Le Vivier, with the creation of a work written for the Nouvel Ensemble Moderne (NEM)."
      }
    ],
