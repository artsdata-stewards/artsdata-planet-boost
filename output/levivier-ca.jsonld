  {
    "@id": "_:g12234380",
    "http://schema.org/url": [
      {
        "@id": "http://www.charlottehug.ch/"
      }
    ],
    "http://schema.org/sameAs": [
      {
        "@id": "http://www.charlottehug.ch/"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/artists/charlotte-hug"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Charlotte Hug"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "en",
        "@value": "Charlotte"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "en",
        "@value": "Hug"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The \"music-visual\" performances that Hug presents solo in particular places and her interdisciplinary work created an international outcry around her. She performed in the tunnels of the Rhone Glacier, at the House of Detention (a former underground prison in London), in a half-demolished bunker in Berlin's Humboldthain Park, at the thermal springs in Baden, as well as at the shipyard in Cobh on the Irish Atlantic coast.\r\n\r\nThis extreme musician constantly pushes the limits of her instrument and reinvents the viola, with an instrument built by the Viennese luthier JG Thir in 1763. She has..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
  {
    "@id": "_:g12234400",
