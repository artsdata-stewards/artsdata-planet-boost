        "@language": "en",
        "@value": "Amplitude"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/le-vivier/repertoire/amplitude"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "en",
        "@value": "Amplitude est dédiée à Alexis Descharmes et écrite à la demande de ce dernier. La pièce évoque encore l'idée d'une dualité puisque deux matériaux s'alternent. Tandis que le premier (un son glissé descendant) disparaît peu à peu, le second (un bariolage sur les quatre cordes de l'instrument) prend de plus en plus d'ampleur. Jean-Luc Hervé.\r\n"
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
