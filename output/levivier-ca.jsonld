    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Le Vivier en coulisse #10"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Pour cette dixième édition du Vivier en coulisse, Philippe Macnab-Séguin s’entretiendra avec la compositeur&nbsp;Ofer Pelz en lien avec le concert présenté le 16 avril prochain dans le cadre de l’événement RÉSONANCE CROISÉE • créations et résidences musicales Québec/Europe.&nbsp;Sa création Acufen sera interprété par l'ensemble allemand ur.werk. dans le concert Montréal-Hanovre (Quatuor Bozzini + ur.werk)&nbsp;\r\n"
      }
    ],
