  {
    "@id": "https://levivier.ca/en/concert/2022-23-season/we-are-while",
    "https://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Le Vivier"
      }
    ],
    "https://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "article"
      }
    ],
    "https://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/concert/2022-23-season/we-are-while"
      }
    ],
    "https://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "We are for a while | Le Vivier"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "In this playful sonic and visual tale on the theme of recycling, Architek Percussion joins forces with Vitalija Glovackyte (objects, lighting, and electronics), Victor Alibert and Michael Cutting to give a new lease on life to broken instruments, borrowed music, and damaged machines salvaged from Montreal's garbage cans. A modern and playful fable!"
      }
    ],
    "https://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/sites/default/files/evenements/WSFAW-WebHeader-JAN2022_0.jpg"
      }
    ],
    "https://ogp.me/ns#updated_time": [
      {
        "@language": "en",
        "@value": "2022-09-06T09:26:04-04:00"
      }
    ],
