    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Concert électroacoustique Québec-Ukraine [PARIS]"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "PROJET DE COLLABORATION INTERNATIONALE POUR ARTISTES ÉMERGENT·E·S DE MONTRÉAL ET DE KYIV\r\n\r\nAu programme de ce concert, quatre œuvres inédites pour électroacoustique et instrumental issues d’une collaboration croisée entre musicien·ne·s du Vivier InterUniversitaire (Montréal) et de l’Académie nationale de musique d’Ukraine (Kyiv).\r\n"
      }
    ],
