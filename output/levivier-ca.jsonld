    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/concert/2024-25-season/ce-qui-reste-quand-la-peau-se-detache-du-corps-quatuor-bozzini"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Ce qui reste quand la peau se détache du corps / Quatuor Bozzini"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\"What Remains When the Skin Detaches from the Body\" is an immersive experience that takes you on a journey into the depths of bodily metamorphosis. Through a hybrid performance that engages all the senses, Sara Létourneau and Chantale Boulianne push the boundaries of matter and sound."
      }
    ],
