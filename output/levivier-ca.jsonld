    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Quatuor Konus"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Precise, minimalist sound that turns places into spaces: in the 20 years of its existence, the Konus Quartet has specialised in the latest contemporary and experimental music. In visionary curated, intensive collaborations with contemporary composers, the ensemble is committed to the creation and performance of new works.To this end, the Konus Quartet regularly commissions compositions, including pieces by Chiyoko Szlavnics, Jürg Frey, Barry Guy, Makiko Nishikaze, Phill Niblock, Urs Peter Schneider, Martin Brandlmayr, Klaus Lang, Tomas Korber and Sam Pluta, which have been developed and..."
      }
    ],
    "@type": [
      "http://schema.org/PerformingGroup"
    ]
  },
