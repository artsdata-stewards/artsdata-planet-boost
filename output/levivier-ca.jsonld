    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Composer Wlad Marhulets’ musical studies began at the age of 16 when he attended the Academy of Music in Gdansk, Poland. Inspired by the recordings of clarinetist David Krakauer from a young age, he studied klezmer clarinet playing and composition, later transferring to the Juilliard School in New York as a full scholarship student, where his studies continued with Oscar and Pulitzer Prize-winning composer John Corigliano.\r\n\r\nMarhulets’ classical work has been performed by major ensembles including the Detroit Symphony, the Columbus Symphony, the Princeton Symphony, Orchestre..."
      }
    ],
