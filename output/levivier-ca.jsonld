  {
    "@id": "_:g33328180",
    "http://schema.org/url": [
      {
        "@id": "https://www.tempsfort.quebec/contact"
      }
    ],
    "http://schema.org/sameAs": [
      {
        "@id": "https://www.tempsfort.quebec/contact"
      },
      {
        "@id": "https://www.facebook.com/tpsfort"
      },
      {
        "@id": "https://www.instagram.com/tpsfort/"
      },
      {
        "@id": "https://www.youtube.com/channel/UCBiR7j5RX5nALuK6XlEpFJQ"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://www.tempsfort.quebec/contact"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Temps Fort"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Chez les productions Temps Fort (anciennement Société de Concert de Montréal - SCM) nous présentons à notre public des expériences musicales immersives et originales mettant en valeur des créateurs classiques de la nouvelle génération.\r\n\r\nPar « créateurs », nous incluons l’ensemble des artistes présents sur scène et l’ensemble de l’équipe administrative et technique derrière chaque miracle que représente la tenue d’un spectacle.\r\n\r\nPar « classique », nous n’entendons pas simplement Mozart ou Beethoven, mais bien l’ensemble des époques anciennes, médiévales,..."
      }
    ],
    "@type": [
      "http://schema.org/PerformingGroup"
    ]
  },
  {
    "@id": "_:g33328240",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/fr/le-vivier/repertoire/journal"
      }
    ],
    "http://schema.org/datePublished": [
      {
        "@type": "http://schema.org/Date",
        "@value": "1977"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Journal"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/le-vivier/repertoire/journal"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "fr",
        "@value": "Forces attractives de mon enfance (voire même mieux, celle que j'ai toujours voulu avoir !) Journal est en fait une pièce très autobiographique.\r\n\r\nElle se divise en quatre sections : L'enfance, L'amour, La mort, Après la mort. Elle est principalement inspirée par le fait que pendant la majeure partie de mon enfance, je n’ai cessé de rechercher ma propre mère, que j’imaginais être quelque chose comme Polonaise, [par des] concepts mystiques que je tiens également de mon enfance alors que Noël était un événement important, et dans laquelle la réalité n’était pas celle..."
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
