      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "en",
        "@value": "Sims"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Joseph Sims is a composer / sound designer born in London (Ontario), and currently based in Montréal. His work acts as an amalgamation of sonic styles, frequently exploring the relationships between concrete and electronic sources. With roots in folk music, his compositional approach remains grounded in intuition and narrative — continually exploring new sonic pallets as a means of expression. Multi-channel fixed-medium composition is his primary focus, but a love for visual media is expressed through frequent collaboration with animators and film makers. He is currently finishing his..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
