    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https:www.5ilience.com"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "5ilience"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "5ilience, c’est un tout nouvel ensemble basé à Montréal et composé de cinq artistes émergent·e·s passionné·e·s par la musique de chambre.\r\n\r\nNotre quintette, composé d’un hautbois, d’une clarinette, d’un saxophone, d’une clarinette basse et d’un basson, respectivement joué par Léanne Teran-Paul, Mariane Pellerin, Thomas Gauthier-Lang, Gwénaëlle Ratouit et Alex Eastley, s’établit comme tout premier quintette à anches au Québec. C’est par la combinaison des spécificités timbrales des instruments de cette formation que nous avons développé une palette de..."
      }
    ],
    "@type": [
      "http://schema.org/PerformingGroup"
    ]
  },
  {
