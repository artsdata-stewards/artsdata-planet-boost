    "https://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Tim Brady invites two Montreal-based composer-guitarists of the next generation, Emmanuel Jacob Lacopo and Kevin O'Neil, to explore in concert the infinite possibilities of music for electric - and electrified classical - guitar."
      }
