      {
        "@language": "fr",
        "@value": "CONCERT ÉLECTRO-ACOUSTIQUE ET PROJECTION DE FILM"
      }
    ],
    "http://schema.org/alternateName": [
      {
        "@language": "fr",
        "@value": "Rencontre et concert avec le compositeur Matthias Krüger"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Matthias Krüger est un compositeur de musique contemporaine basé entre Paris et Hambourg. Il est lauréat de la résidence en musiques nouvelles (2023 – 2024) du Conseil des arts et des lettres du Québec, du Groupe Le Vivier et du Goethe-Institut. Ce rendez-vous est l'opportunité de découvrir son travail et projet artistique.\r\n"
      }
    ],
