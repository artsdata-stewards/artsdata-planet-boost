      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Alt-Escape"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/le-vivier/repertoire/alt-escape"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "fr",
        "@value": "Une succession d’univers sonores et visuels hypnotiques\r\n\r\nAlt-Escape est une performance numérique d’une heure qui plonge le spectateur dans une succession d’univers sonores et visuels interactifs et hypnotiques explorant les notions de la gravité, de la physique et du temps.\r\nCe spectacle s’approprie les technologies numériques pour inventer des instruments interactifs de toutes pièces offrant une proposition esthétique unique alliant musique, projection vidéo et technologie qui donnent vie en temps réel à une nouvelle forme de concert.\r\nEn parallèle de la version..."
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
