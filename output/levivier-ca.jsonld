    "https://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "LA SEMAINE DU NEUF | Le Vivier"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "After the success of the first edition and the tribute to the composer Claude Vivier in 2023, La Semaine du Neuf is back from March 1st to March 18th, 2024, inviting the audience to explore possible connections between digital arts and new music.For the occasion, Le Vivier is delighted to host composer Pierre Jodlowski, whose works will be highlighted by our members and international artists. Concerts, performances, sound installations, and discussions, both on-site and online, will punctuate these almost 20 days of programming."
      }
    ],
