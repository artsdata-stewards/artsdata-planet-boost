      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Ensemble Hopper"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "L’Ensemble Hopper est né du désir de jeunes musiciens du Conservatoire de Liège de jouer et diffuser la musique de leur entourage.\r\n\r\nEnsemble à géométrie variable, Hopper se produit fréquemment en Belgique et à l’étranger. Il entretient de fructueuses collaborations avec diverses institutions telles que le Centre Henri Pousseur, le Forum des Compositeurs, et avec des artistes et compositeurs de talent. Ces partenariats directs sont autant le garant d’un ancrage dans la vie musicale actuelle que d’une authenticité d’interprétation. Soutenu par la Fédération..."
      }
    ],
    "@type": [
      "http://schema.org/PerformingGroup"
    ]
  },
