    "https://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "LA SEMAINE DU NEUF — Third edition | Le Vivier"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Le Vivier announces the third edition of Semaine du NeufLa Semaine du Neuf presents a panorama of new horizons in new music, with an eclectic and festive program that ventures from acousmatic music to contemporary opera, via unbridled sound experimentation.Focusing on creation, the Vivier festival celebrates the diversity of creative processes, with concerts, multidisciplinary performances and sound installations.La Semaine du Neuf will be held from March 8 to 16, 2025 at a wide range of iconic Montreal venues, including the Wilder Building, CIRMMT and La Chapelle Scènes contemporaines."
      }
    ],
