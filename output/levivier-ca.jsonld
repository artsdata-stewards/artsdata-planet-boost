    ],
    "http://schema.org/familyName": [
      {
        "@language": "en",
        "@value": "Koh"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Jennifer Koh (born 1976) is an American violinist born to Korean parents in Glen Ellyn, Illinois. She holds a B.A. in English Literature from Oberlin College and a performance diploma from Oberlin Conservatory. She is also a graduate of the Curtis Institute and was the first medalist in the 1994 Tchaikovsky Competition.\r\nMs Koh has performed extensively with orchestras such as the Los Angeles Philharmonic, the New York Philharmonic, the BBC National Orchestra of Wales and others. She is an advocate of music education for children.\r\nShe is praised for her programmes devoted to Bach. She has..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
  {
    "@id": "_:g13944200",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/en/artists/missy-mazzoli"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/artists/missy-mazzoli"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Missy Mazzoli"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "en",
        "@value": "Missy"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "en",
        "@value": "Mazzoli"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Grammy-nominated composer Missy Mazzoli was recently hailed as \"one of the most inventive and surprising composers working in New York today\" (The New York Times) \"Brooklyn's post-millennial Mozart\" (Time Out New York), and praised for her \"apocalyptic imagination\" (Alex Ross, The New Yorker). Mazzoli's music has been performed worldwide by the Kronos Quartet, Eighth Blackbird, pianist Emanuel Ax, Opera Philadelphia, Scottish Opera, LA Opera, Cincinnati Opera, New York City Opera, Norwegian National Opera, Detroit Symphony, LA Philharmonic, Minnesota Orchestra, Boston Symphony, Sydney..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
