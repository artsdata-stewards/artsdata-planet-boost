      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/artists/felix-antoine-coutu"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Félix-Antoine Coutu"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "en",
        "@value": "Félix-Antoine"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "en",
        "@value": "Coutu"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Félix-Antoine Coutu (1990) is a composer, sound designer, arranger, drummer, and producer based in Montreal. In his recent work, he explores the fusion of acoustic instruments and the mechanical energy produced by engines. He experiments with microcontrollers and builds electronic devices to create new musical instruments or enhance the original capabilities of existing acoustic instruments. This journey immerses him in childhood nostalgia where he is sometimes confronted with distorted memories.\r\n\r\nHis works have been performed in Canada, the United States, France, Belgium, and Australia..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
