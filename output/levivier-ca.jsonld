    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/concert/2025-26-season/quatuor-bozzini-25th-anniversary-concert-brook-di-castri-miller"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Quatuor Bozzini — 25th Anniversary Concert — Brook, Di Castri, Miller"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The Bozzini Quartet celebrates its 25th anniversary with a program highlighting its commitment to creation and collaboration.The Bozzini Quartet continues its 25th anniversary celebrations with three new works by internationally renowned Canadian composers Cassandra Miller, Zosha Di Castri, and Taylor Brook. Miller has collaborated with the Bozzini Quartet for many years, notably with About Bach (2016), winner of the Jules-Léger Prize, and with the incredibly intimate Thanksong (2020). Her latest piece for the Bozzini Quartet is based on musical memory and memories related to music. Brook, a former participant in the Composer's Kitchen (2009) and composer of Musique de chambre (noire) (2012, film+music), writes for the Bozzini Quartet, inventing microtonal folk music inspired by the legendary Baltic city of Vineta. The Bozzini Quartet is delighted to be working for the very first time with composer Zosha di Castri, who has written a piece exploring the textures and sonic possibilities of the string quartet.This concert is a co-commissioned project of the Bozzini Quartet in partnership with Darmstädter Ferienkurse, Time:Spans, Earle Brown Music Foundation, Le Vivier, Soundstreams, Huddersfield Contemporary Music Festival and Gaudeamus."
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-10-18T23:30:00-04:00"
      }
    ]
  },
  {
