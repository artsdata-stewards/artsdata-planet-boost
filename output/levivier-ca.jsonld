      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "DO YOU HAVE A MINUTE?"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Carte blanche à An Laurence 安媛 : Do you have a minute? fusionne la création musicale contemporaine, l’expérience théâtrale et l’art relationnel pour offrir une interprétation du temps. Au programme, quatre œuvres musico-théâtrales des compositeur·trice·s Jing Wang, Gabo Champagne, Collectif Paramorph et Thais Montanari, ainsi qu’une œuvre visuelle d’Ivetta Sunyoung Kang.\r\n"
      }
    ]
  },
