      },
      {
        "@id": "_:g3923160"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/concert/saison-2021-22/spiesser-flashback-sculpt-chfr-12-avril"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "SPIESSER / FLASHBACK : SCULPT (CH/FR) | 12 AVRIL"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Seul sur scène, l’interprète Philippe Spiesser joue des percussions invisibles. Avec ses mains, son corps, ses gestes, il sculpte des sons et des images et invite le public à une exploration du geste en musique comme instrument. Grâce à différents dispositifs de capteurs et à des algorithmes de vision par ordinateur, le corps se transforme en instrument. Une performance technique et scénique qui nous projette dans le monde de la réalité virtuelle.\r\n"
      }
    ],
    "http://schema.org/keywords": [
      {
        "@language": "fr",
        "@value": "Rencontres internationales"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2022-04-13T01:00:00-04:00"
      }
    ]
  },
