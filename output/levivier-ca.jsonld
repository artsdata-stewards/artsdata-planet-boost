    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/concert/saison-2024-25/corie-rose-soumah-hypercube-aptitudes-materielles"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Corie Rose Soumah & Hypercube — Aptitudes Matérielles"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "La commissaire artistique Corie Rose Soumah invite les artistes sonores de Hypercube, Erin Rogers, Antoine Goudreau et Antonin Bourgault pour un concert où se rencontrent nouvelles technologies, arts visuels et spatialisation sonore.Cette convergence de deux métropoles au formidable dynamisme créatif, New York et Montréal, offre un prétexte idéal pour la rencontre entre nouvelles technologies, arts visuels, théâtralité et spatialisation sonore. Mettant en scène instruments analogiques et une myriade de paysages graphiques et acousmatiques, le programme du concert convoque des univers pluriels représentatifs de la diversité sonore contemporaine.&nbsp;Cet évènement est présenté avec le soutien de la Caisse Desjardins de la Culture"
      }
    ],
