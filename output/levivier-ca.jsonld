    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Raised in the coastline woods of western Michigan, Christine Chapman has traveled far and wide to pursue her passion for music. In 1990, after finishing her musical studies at the University of Michigan and Indiana University, she broke out of the rural heartland of America for an orchestra job on the still fresh border between East and West Germany. The desire to gain a bit of work experience before returning to the States has since turned into a quarter of a century of exploration and adventure.\r\n\r\nAs a member of Ensemble Musikfabrik, Christine Chapman has had the opportunity to..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
  {
    "@id": "_:g11009080",
    "http://schema.org/url": [
