    "@id": "_:g12528440",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/en/le-vivier/repertoire/ways-returning"
      }
    ],
    "http://schema.org/datePublished": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2019"
      }
    ],
    "http://schema.org/composer": [
      {
        "@id": "_:g12528460"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Ways of Returning"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/le-vivier/repertoire/ways-returning"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "en",
        "@value": "Aesthetically, this work represents the mixing of the Classical String Quartet genre with Noise, and Dark Ambient genre signifiers. Theoretically, the work explores timbre through the historical abstraction of modal and tonal counterpoint. The first movement builds timbre through the imitation of acoustic strings by sampled, and synthetically modelled strings. The second movement is a timbre fugue. The third movement is an industrial ritual, exploring the micro-synchronicity within a pulsation and its effect on timbral blend.\r\n"
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
