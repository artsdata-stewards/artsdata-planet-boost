    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Stockholms Saxofonkvartett"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Stockholms Saxofonkvartett [Stockholm Saxophone Quartet (SSQ)] is an innovative and pioneering leader in Swedish contemporary music, and represents a fresh look at saxophone and electroacoustic music. The members of the ensemble have had over 700 works written for them.\r\n"
      }
    ],
    "@type": [
      "http://schema.org/PerformingGroup"
    ]
  },
