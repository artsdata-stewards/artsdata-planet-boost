    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "BETWEEN FEATHERS"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "In 2019, four outstanding, Austria-based musicians (Maria Mogas Gensana, accordion; Audrey G. Perreault, flutes; Hannes Schöggl, percussion; Elīna Viļuma-Helling, voice) decided to form an ensemble for new music and dedicated themselves to curiosity, exploration, collaboration and creativity. between feathers explores international new music repertoire and collaborates with composers who share their vision: to rethink the traditional contemporary music concert format with other artists, dancers and thinkers. The quartet also attempts to address preoccupations of our modern society in..."
      }
    ],
    "@type": [
      "http://schema.org/PerformingGroup"
    ]
  },
