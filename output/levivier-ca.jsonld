        "@id": "_:g10891840"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Les oiseaux de Nias"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/le-vivier/repertoire/les-oiseaux-de-nias"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "en",
        "@value": "&nbsp;\r\n\r\nVideo: R. B. Breton PARISI, François Doyon, Roxanne Turcotte\r\nNarration: Audrey Southière\r\nInstrumentalists:&nbsp;Michel Dubeau, calls, sulings, ocarinas - Julien Grégoire, calls, percussion - Claire Marchand, calls, flutes, Didgeridoo - Sonia Paço-Rocchia, calls, bassoon, fabricated instrument and electronics - Guy Pelletier, calls, sulings, flutes, Roxanne Turcotte, composer, conductor - The Nias Virtual Bird Choir.\r\n\r\nThe call (dissidence) - Murmurations (mobilization) - Resistance (revolution)&nbsp;\r\n"
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
