  {
    "@id": "_:g24463060",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/fr/le-vivier/repertoire/simple-loops-complex-times-mvt123"
      }
    ],
    "http://schema.org/datePublished": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2012"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Simple Loops in Complex Times – Mvt.1,2,3"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/le-vivier/repertoire/simple-loops-complex-times-mvt123"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "fr",
        "@value": "Simple Loops in Complex Times est composé de trois mouvements qui explorent des idées musicales assez simples et transparentes. Elles évoluent selon le principe de la superposition musicale, à partir de l’utilisation des loopers (machine à boucle).\r\n\r\nMvt 1 – tempo moyen\r\nMvt.2 – tempo lent\r\nMvt. 3 – tempo rapide\r\n\r\nSimple Loops in Complex Times sera accompagnée d’une chorégraphie créée et interprétée par le danseur Charles Bécard.\r\n"
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
  {
    "@id": "_:g24463100",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/fr/le-vivier/repertoire/sergios-request"
      }
    ],
    "http://schema.org/datePublished": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2020"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "At Sergio’s Request"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
