      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Carte blanche to An Laurence 安媛 : Do you have a minute? merges contemporary music creation, theatrical experience and relational art to offer an interpretation of time. The program includes four music-theatre works by composers Jing Wang, Gabo Champagne, Collectif Paramorph and Thais Montanari, as well as a visual work by Ivetta Sunyoung Kang, Tenderhands."
      }
    ],
