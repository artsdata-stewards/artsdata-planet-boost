    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/fr/concert/saison-2024-25/totem-electrique-xviii-concours-totem-electroacoustique"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "_:g3497300"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g3497320"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g3497360"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/concert/saison-2024-25/totem-electrique-xviii-concours-totem-electroacoustique"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Totem Électrique XVIII + Concours Totem électroacoustique"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Totem Électrique, un concert qui met à l’honneur la musique mixte est de retour pour sa 18e édition avec des compositions originales pour Table de Babel et électronique.Ce concert s’inscrit dans le cadre de la série Totem Électrique créée en 2009. Cette série a donné lieu à la création de près de 100 œuvres musicales mixtes hors du commun spécialement composées pour les instruments inventés de Jean-François Laporte, qui sont combinés à une composante électrique ou électronique (bande sonore, traitement numérique en temps réel, électronique, amplification, etc.).RÉSERVEZ VOS BILLETS&nbsp;En 2e partie: Concours Totem électroacoustiqueProductions Totem Contemporain, présente les finalistes de son concours électroacoustique annuel, qui invite les compositrices et compositeurs de tous horizons à explorer l'univers sonore des instruments inventés par Jean-François Laporte. Ces instruments, souvent créés à partir d'objets inusités, offrent une palette de timbres et de textures inédites, ouvrant de nouvelles perspectives d'expression musicale. Le concours Totem Électroacoustique a pour objectif de promouvoir la lutherie acoustique de PTC, d'encourager la création d'œuvres électroacoustiques originales et de favoriser leur diffusion auprès d'un large public. Ce concert inclura également, suite à la délibération du jury sur place, la remise des prix du concours : les trois prix Totem, le prix Akousma, le prix Vivier Inter Universitaire et le prix du public.&nbsp;ASSISTEZ AU CONCOURS"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-02-24T00:00:00-05:00"
      }
    ]
  },
