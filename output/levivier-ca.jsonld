    ],
    "http://schema.org/familyName": [
      {
        "@language": "en",
        "@value": "Takemitsu"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Tōru Takemitsu (武満 徹, Takemitsu Tōru, October 8, 1930 – February 20, 1996; pronounced [takeꜜmitsɯ̥ toːɾɯ]) was a Japanese composer and writer on aesthetics and music theory. Largely self-taught, Takemitsu possessed consummate skill in the subtle manipulation of instrumental and orchestral timbre. He is famed for combining elements of oriental and occidental philosophy to create a sound uniquely his own and for fusing opposites together such as sound with silence and tradition with innovation.\r\n\r\nHe composed several hundred independent works of music, scored more than ninety..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
