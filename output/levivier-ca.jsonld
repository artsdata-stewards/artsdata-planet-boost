    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Productions Fiolûtröniq"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Productions Fiolûtröniq is a vehicle for new artistic trends, which aims to promote new music to the public by presenting multidisciplinary concerts and shows. Artistic Director Cléo Palacio-Quintin explores various musical marriages for her interactive instrument — the hyper-flute — choosing different novel combinations to create innovative works that incorporate contemporary digital technologies. Always surrounded by her equally versatile accomplices — Elin Söderström on viola da gamba in Duo Fiolûtröniq — Terri Hron, recorder player and composer in Beta Lyræ — Cléo’s..."
      }
    ],
