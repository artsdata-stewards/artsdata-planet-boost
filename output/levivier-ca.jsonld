      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Sanctuaire d'oiseau"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Sanctuaire d’oiseau est une aventure interculturelle et une expérience multi-sensorielle pour sensibiliser le public à la situation écologique catastrophique par une approche esthétique et créative. Par l'entremise de trois disciplines artistiques, la musique, les arts visuels et les arts vidéo, le projet constatera la situation actuelle et le rôle fondamental de l'humanité dans cet état de fait.\r\n"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2023-05-07T23:30:00-04:00"
      }
    ]
  },
