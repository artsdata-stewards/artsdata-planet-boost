    "http://schema.org/sameAs": [
      {
        "@id": "https://simonmartin.ca"
      },
      {
        "@id": "https://www.youtube.com/channel/UCF-_BVu-uAoAEIrRR819iQA"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/artistes/membres/organismes/simon-martin"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Simon Martin"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "fr",
        "@value": "Simon"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "fr",
        "@value": "Martin"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Né à Rouyn-Noranda (Québec), Simon Martin (1981-) est un compositeur de musique de concert contemporaine résidant à Montréal. Il est directeur-fondateur de Projections libérantes, la seule compagnie québécoise en musique contemporaine exclusivement dédiée à la création, sans musiciens attitrés ni programmation saisonnière.\r\n&nbsp;\r\nAprès avoir collaboré avec des ensembles de réputation internationale, tels que le Quatuor Bozzini (Montréal) et l’Ensemble Musikfabrik (Cologne), Simon Martin rassemble désormais des musiciens en fonction des besoins spécifiques de chacune..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
