    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Wablework"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/le-vivier/repertoire/wablework"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "en",
        "@value": "This piece has an unusual origin. Years ago, in order to leave my home on the west coast of Canada to study composition in Europe, I raised money for my travel by selling as-yet unwritten bars of music to everyone I’d ever met. The result was a huge commission from over sixty friends, family, and community members. In 2011, with the help of the&nbsp;Quatuor Bozzini, I finally made good on my promise and created the piece&nbsp;Warblework.\r\n\r\nEach of&nbsp;Warblework’s four movements (warble = chirp) is based on birdsong — in particular of four thrushes (Swainson’s thrush, hermit..."
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
