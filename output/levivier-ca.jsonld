        "@value": "2024"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "L'être contre le vent"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/le-vivier/repertoire/letre-contre-le-vent"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "en",
        "@value": "If I come, in ravishing garments,&nbsp;\r\nUnto this brink, without horror, to breath the high foam,&nbsp;\r\nDrink in through my eyes the vast and smiling bitterness,\r\nA being against the wind, in the sharpest of air,&nbsp;\r\nReceiving full in the face a call from the sea;&nbsp;\r\nIf the intense soul breathes, and there furiously swells&nbsp;\r\nSheer wave out of exhausted wave, and if the wave&nbsp;\r\nBooms, to immolate a monster of naivety,&nbsp;\r\nAnd comes from the high seas to vomit its profoundness&nbsp;\r\nOn this rock, from where spurts even to my very thoughts&nbsp;\r\nA dazzling array of..."
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
