    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/concert/2024-25-season/chants-libres-laboratoire-lyrik-03-la-voix-lumineuse-semaine-du-neuf"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Chants Libres / Laboratoire Lyrik 03 : La voix lumineuse — Semaine du Neuf"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The new Laboratoire Lyrik of Chants Libres explores the concepts of presence and absence.&nbsp;Presented at La Chapelle Scènes Contemporaines, this research-creation project brings together scenographer Cédric Delorme-Bouchard, dancer Jennyfer Desbiens, cellist Audréanne Filion, mezzo-soprano Marie-Annick Béliveau and composer Frédéric Lebel, in a triptych combining voice, cello and electronics. The dramaturgy of sound and light focuses on the metamorphosis of physical bodies on stage, immersing the audience in contemporary lyrical creation.A Chants Libres production in co-production with Le Vivier."
      }
    ],
