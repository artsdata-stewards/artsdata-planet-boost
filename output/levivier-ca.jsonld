    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/artists/elzbieta-sikora"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Elzbieta Sikora"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "en",
        "@value": "Elzbieta"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "en",
        "@value": "Sikora"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Born in 1943 in Lwow, Poland, Elzbieta Sikora studied music composition with Tadeusz Baird and Zbigniew Rudziński in Warsaw, Poland, with Betsy Jolas in Paris and electro-acoustic music composition with Pierre Schaeffer and François Bayle in Paris. In 1973 she founded, with Wojciech Michniewski and Krzysztof Knittel the Group of Composers KEW. Scholarships from the French Government at IRCAM, Paris, the City of Mannheim, and the Kosciuszko Foundation at CCRMA (Computer Center for Research in Music and Acoustics), Stanford, have enriched the composer’s international outlook.\r\n\r\nElzbieta..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
  {
    "@id": "_:g13544240",
