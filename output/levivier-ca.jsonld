    "http://schema.org/thumbnailUrl": [
      {
        "@id": "https://levivier.ca/sites/default/files/oembed_thumbnails/1oc2FIHm1fUPIQwtrUinYTjWmo0GLPJf2FUH2r7OkQA.jpg"
