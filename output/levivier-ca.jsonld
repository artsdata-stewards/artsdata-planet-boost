    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Celestial Blue"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le violoniste Mark Fewer et le compositeur/pianiste Daniel Janke ont travaillé ensemble sur plusieurs projets de films et de concerts au fil des années. Revisitant le folklore canadien, Celestial Blue est l'aboutissement de leur désir d'explorer cette connexion musicale à travers une série de duos qui représentent leur voix collaborative unique.\r\n"
      }
    ],
