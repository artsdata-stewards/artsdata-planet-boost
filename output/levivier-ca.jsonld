    "https://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "TriOculaire + | Le Vivier"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Let yourself be transported along the fascinating paths of the graphic transposition of music, thanks to three major names in improvisation! Charlotte Hug (Zurich) François Houle (Vancouver), and Lori Freedman (Montreal) open the doors to Live Structures/Structures vivantes, a research project by composer Linda Bouchard, which playfully explores different ways of interpreting data in musical notation. Using the Ocular Scores tool, the composer pushes the boundaries of expression while revealing the high-octane creative potential of the performers."
      }
    ],
    "https://ogp.me/ns#image": [
