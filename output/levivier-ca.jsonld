    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Productions Totem contemporain"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Productions Totem contemporain (PTC) is dedicated to the research, the development, the production, the creation and to the presentation of projects featuring Jean-François Laporte’s invented instruments and sound installations.\r\n\r\nIn July 2004, PTC took over the Espace Totem, a working space for Jean-François Laporte and his ensemble; an artists’ residence; and a performance venue.\r\n\r\nSince 2008, PTC presents three concerts series: Totem Danse emphasizes on PTC’s instruments and installations with choreographic works; Totem Installation explores the musical potential of our..."
      }
    ],
    "@type": [
      "http://schema.org/PerformingGroup"
    ]
  },
