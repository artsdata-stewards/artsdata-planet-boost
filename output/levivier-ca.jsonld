      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "CARTE BLANCHE À BEKAH SIMMS"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Paramirabo invites Bekah Simms, an artist with a nuanced and complex style of writing, to share her world and her works. For the occasion, she invites the composer Corie Rose Soumah to create a work and also completes the programme with Plekto by Yannis Xenakis.\r\n"
      }
    ],
