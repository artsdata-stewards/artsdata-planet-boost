    "https://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "STICK & BOW + PARAMIRABO + LISILOG - CANTA LO INVISIBLE | Le Vivier"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Canta lo invisible – making the invisible visible Born from the meeting of artists from Stick&Bow, Paramirabo, LiSiLoG and composer Philippe Macnab-Séguin, Canta lo invisible, under the artistic direction of Krystina Marcoux, explores the intimate relationship between gesture, sound, and light, at the crossroads of contemporary music, improvisation, and digital art."
      }
    ],
