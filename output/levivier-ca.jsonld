      }
    ],
    "https://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "KOPERKUS | Le Vivier"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Les tout-petits sont invités à entrer dans le monde chaleureux et onirique du compositeur québécois Claude Vivier. Ils y feront la connaissance d’Emma, qui roupille dans son lit de coussins. À son réveil, elle utilise le pouvoir de son imagination pour transformer les objets, les formes et les sons. Ainsi, les coussins deviennent des personnages, l’ombre devient musique, les mélodies se transforment en lumières colorées…"
      }
    ],
    "https://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/sites/default/files/evenements/Koperkus.png"
      }
