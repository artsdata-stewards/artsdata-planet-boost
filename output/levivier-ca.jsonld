    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Proxima Centauri"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Proxima Centauri est un ensemble musical qui bouscule les codes de la musique de chambre notamment en intégrant l’électroacoustique comme un membre à part entière de la formation. Depuis plus d’une vingtaine d’années, Proxima Centauri collabore avec de nombreux artistes, d’autres musiciens ; interprètes ou improvisateurs, mais aussi des danseurs ou des plasticiens. L’ensemble porte ainsi une démarche artistique pluridisciplinaire, alliant création musicale et arts visuels.\r\n\r\nPlacé sous la direction artistique de Marie-Bernadette Charrier, l’ensemble pratique une..."
      }
    ],
    "@type": [
      "http://schema.org/PerformingGroup"
    ]
  },
