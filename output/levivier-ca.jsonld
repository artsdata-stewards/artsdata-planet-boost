    "https://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "The Planète Bonheur series offers a loving exploration of the unsuspected frontiers of the electric guitar. This first concert features Belgian guitarist and composer François Couvreur, the teotwawki quartet and Montreal composer Kevin O'Neil."
      }
