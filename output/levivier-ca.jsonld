        "@value": "Le Vivier"
      }
    ],
    "https://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "article"
      }
    ],
    "https://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/concert/2022-23-season/montreal-mexico"
      }
    ],
    "https://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Montréal-Mexico | Le Vivier"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "A happy encounter between Mexican and Canadian new music in a concert 100% dedicated to creation. Quasar, quatuor de saxophones, will perform works by Mexican composers Alejandro Padilla and Eduardo Caballero, as well as those by French-Canadian composers Sophie Dupuis and Geneviève Ackerman."
      }
    ],
    "https://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/sites/default/files/evenements/MTLmexico_1000x500_300dpi_ST.jpg"
      }
    ],
    "https://ogp.me/ns#updated_time": [
