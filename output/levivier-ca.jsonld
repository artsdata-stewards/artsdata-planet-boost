      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Vivian FUNG"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "en",
        "@value": "Vivian "
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "en",
        "@value": "FUNG"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "JUNO Award-winning composer Vivian Fung has a talent for combining idiosyncratic textures and styles into large-scale works, often including influences such as non-Western folk music, Tibetan chant, and Brazilian rhythms. Recent works include Aqua, commissioned by the Chicago Sinfonietta, and Violin Concerto No. 2, commissioned and premiered by the Toronto Symphony Orchestra with Jonathan Crow, violin.\r\n"
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
  {
    "@id": "_:g12913740",
    "http://schema.org/url": [
      {
        "@id": "https://kellymariemurphy.com/"
      }
    ],
    "http://schema.org/sameAs": [
      {
        "@id": "https://kellymariemurphy.com/"
      },
      {
        "@id": "https://soundcloud.com/k-mmurphy"
      },
      {
        "@id": "https://twitter.com/KMMOttawa"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/artists/kelly-marie-murphy"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Kelly-Marie Murphy"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "en",
        "@value": "Kelly-Marie "
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "en",
        "@value": "Murphy"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Kelly-Marie Murphy was born on a NATO base in Sardegna, Italy, and grew up on Canadian Armed Forces bases all across Canada. She began her studies in composition at the University of Calgary with William Jordan and Allan Bell, and later received a Ph.D. in composition from the University of Leeds, England, where she studied with Philip Wilby. After living and working for many years in the Washington D.C. area where she was designated \"an alien of extraordinary ability\" by the US Immigration and Naturalization Service, she is now based in Ottawa.&nbsp;\r\n"
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
