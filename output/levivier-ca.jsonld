  {
    "@id": "_:g13794740",
    "http://schema.org/url": [
      {
        "@id": "http://totemcontemporain.com/"
      }
    ],
    "http://schema.org/sameAs": [
      {
        "@id": "http://totemcontemporain.com/"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "http://totemcontemporain.com/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Productions Totem contemporain"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Productions Totem contemporain (PTC) is dedicated to the research, the development, the production, the creation and to the presentation of projects featuring Jean-François Laporte’s invented instruments and sound installations.\r\n\r\nIn July 2004, PTC took over the Espace Totem, a working space for Jean-François Laporte and his ensemble; an artists’ residence; and a performance venue.\r\n\r\nSince 2008, PTC presents three concerts series: Totem Danse emphasizes on PTC’s instruments and installations with choreographic works; Totem Installation explores the musical potential of our..."
      }
    ],
    "@type": [
      "http://schema.org/PerformingGroup"
    ]
  },
  {
    "@id": "_:g13794760",
    "http://schema.org/url": [
      {
        "@id": "http://brahms.ircam.fr/jean-francois-laporte"
      }
    ],
    "http://schema.org/sameAs": [
      {
        "@id": "https://fr.wikipedia.org/wiki/Jean-Fran%C3%A7ois_Laporte"
      },
      {
        "@id": "http://brahms.ircam.fr/jean-francois-laporte"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/artists/members/organisms/jean-francois-laporte"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Jean-François Laporte"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "en",
        "@value": "Jean-François"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "en",
        "@value": "Laporte"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Jean-François Laporte is a Québecois artist, active on the contemporary art scene since the middle of the 1990s. He pursues an hybrid approach integrating sonic arts, musical composition, performance, interpretation, installation and digital art. Trained initially at the Université de Montréal (Québec), then at the IRCAM (Paris, France), he builds his compositional approach on active listening and observing of the reality of each phenomenon. For the last ten years, he has invested a lot of energy to the development and to the building of new musical instruments that he integrates to his works and, since 2002, to his installations. He also works in collaboration with contemporary dancers."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
