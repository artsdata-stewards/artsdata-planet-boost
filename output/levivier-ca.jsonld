    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://www.collectif9.ca"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "collectif9"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Finaliste aux Prix Juno en 2022 et 2023 pour ses deux plus récents albums, le nonette montréalais collectif9 est reconnu pour sa programmation novatrice et pour son approche unique de la musique de chambre. Depuis ses débuts en 2011, collectif9 a présenté de nombreux concerts à travers l’Amérique du Nord, l’Europe et l’Asie. En tant qu’interprète de musique classique et contemporaine, le groupe combine la puissance d’un orchestre à l’agilité d’un ensemble de musique de chambre. collectif9 opère sur la prémisse qu’un changement de contexte peut influencer la communication et l’expérience de la musique et tente de favoriser la communication ainsi que la collaboration entre artistes de tous horizons."
      }
    ],
    "@type": [
      "http://schema.org/PerformingGroup"
    ]
  },
  {
    "@id": "_:g34654280",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/fr/le-vivier/repertoire/heros"
      }
    ],
    "http://schema.org/datePublished": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2020"
      }
    ],
    "http://schema.org/sameAs": [
      {
        "@id": "https://www.collectif9.ca/heros"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Héros"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/le-vivier/repertoire/heros"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "fr",
        "@value": "Une création musique et vidéo immersive qui déconstruit la musique d'un compositeur emblématique.\r\nCréé conjointement avec les compositeurs et artistes vidéo ​Myriam Boucher ​et ​Pierre-Luc Lecours​, Héros est un spectacle multidisciplinaire immersif inspiré par la musique de Beethoven. Pour ce projet, les deux créateurs ont plongé dans le répertoire du compositeur mythique pour en extraire des mouvements, des constructions harmoniques et mélodiques; ces idées musicales sont modifiées, étirées dans le temps et retravaillées avec un souci contemporain du timbre et..."
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
