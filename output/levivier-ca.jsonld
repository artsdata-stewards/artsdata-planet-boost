    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Symon Henry :  je suis calme et enragé·e"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dans ce spectacle transdisciplinaire porté par la poésie de Roxane Desjardins, Symon Henry compose six tableaux sonores pour voix, harmonicas,&nbsp;synthétiseurs et ensemble d’improvisateurs qui interrogent notre rapport à l’histoire et aux désastres écologiques imminents.\r\n"
      }
    ],
