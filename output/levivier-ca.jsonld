  {
    "@id": "_:g16524000",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/en/le-vivier/repertoire/3-piezas-para-guitarra-electrica"
      }
    ],
    "http://schema.org/datePublished": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2022"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "3 piezas para guitarra eléctrica"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/le-vivier/repertoire/3-piezas-para-guitarra-electrica"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "en",
        "@value": "3 piezas para guitarra eléctrica is the work with which he obtained his Post-Título in Musical Composition in 2022. These written pieces seek to explore both a bodily relationship and a cultural dimension with the electric guitar, from the perspective of a Chilean (Spanish–Picunche mestizo). Each piece focuses on a different materiality: the cable and the guitar’s own body in the first piece, the pick in the second, and a slide tube in the third. At the same time, they draw on traditional music from central Chile, merging it with sounds from contemporary classical music and rock."
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
  {
    "@id": "_:g16524040",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/en/le-vivier/repertoire/pull"
      }
    ],
    "http://schema.org/datePublished": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Pull up"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/le-vivier/repertoire/pull"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "en",
        "@value": "\"Pull Up\" is about the meaning behind vernacular language, specifically slang terms. Many words over time have lost their original meanings or taken on new ones, especially when transmitted orally. When language is manipulated or removed far enough from its original source, it may even take on the form of purely sound to a listener. At what stage does a word become recognized simply by its sound parameters? At a point of complete contextual disconnect or distortion, does language still retain its meaning?"
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
  {
