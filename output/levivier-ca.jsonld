    "https://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Aptitudes Matérielles — Corie Rose Soumah & Hypercube | Le Vivier"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Artistic director Corie Rose Soumah invites sound artists from Hypercube, Erin Rogers, Antoine Goudreau, and Antonin Bourgault for a concert where new technologies, visual arts, and sound spatialization converge.This convergence of two metropolises with formidable creative dynamism, New York and Montreal, offers an ideal pretext for the meeting of new technologies, visual arts, theatricality, and sound spatialization. Featuring analog instruments and a myriad of graphic and acousmatic landscapes, the concert program brings together pluralistic universes representative of contemporary sonic diversity."
      }
    ],
