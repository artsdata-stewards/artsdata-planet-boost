    "https://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "RÉSONANCE CROISÉE • VOLET #2 | 11 ► 17 AVRIL | Le Vivier"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "The second part of the Résonance croisée event offers eight concerts featuring some of the biggest international names in new music: L'arsenale Ensemble, under the direction of Filippo Perocco (Italy), percussionist Philippe Spiesser (Switzerland/France), cellist and composer Séverine Ballon (France), Duo Doblinger/Neyrinck (Austria), artists Hauptmeier-Recker and the ensembles Urwerk and Flex (Germany), as well as Quatuor Bozzini, Quasar - saxophone quartet and Nouvel Ensemble Moderne (Quebec)."
      }
    ],
