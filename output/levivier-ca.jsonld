    ],
    "http://schema.org/familyName": [
      {
        "@language": "fr",
        "@value": "Therrien Brongo"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Multipercussionniste basé à Montréal, David Therrien Brongo mène une carrière d’interprète, de pédagogue et de chercheur. Il est récipiendaire de nombreux prix, dont le Quatrième Prix (Prix Guy Soucie) au prestigieux Concours Prix d’Europe 2021. Il est percussionniste solo de Ensemble Paramirabo et timbalier-percussionniste solo de l'Orchestre de l'Agora en plus d'être codirecteur artistique du Duo AIRS. Il joue régulièrement avec l’Orchestre Métropolitain, l’Orchestre Symphonique de Québec, le Nouvel Ensemble Moderne, l’ensemble à percussion Sixtrum, la Société..."
      }
    ],
