    "https://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Bird's Sanctuary is a cross-cultural adventure and a multi-sensory experience to raise awareness of the catastrophic ecological situation through an aesthetic and creative approach. Through three artistic disciplines, music, visual arts and video arts, the project will acknowledge the current situation and the fundamental role of humanity in this state of affairs."
      }
    ],
