  {
    "@id": "https://levivier.ca/en/concert/2022-23-season/concert-vivier-interuniversitaire",
    "https://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Le Vivier"
      }
    ],
    "https://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "article"
      }
    ],
    "https://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/concert/2022-23-season/concert-vivier-interuniversitaire"
      }
    ],
    "https://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "CONCERT VIVIER INTERUNIVERSITAIRE | Le Vivier"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "The 7th annual Vivier InterUniversitaire (ViU) concert will present unusual and innovative works for instrumental, mixed and electroacoustic music. They are all composed and performed by some of the brightest members of the emerging generation of composers and performers from the Université de Montréal, McGill, Concordia and the Conservatoire de musique de Montréal."
      }
    ],
    "https://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/sites/default/files/evenements/VIU%20Concert%202023-%20noir%20sur%20blanc%20-%201000%20x%20500-21.png"
      }
    ],
