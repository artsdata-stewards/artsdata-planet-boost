    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Alexander Bridger, a Newfoundland-born composer and multi-instrumentalist, has long defied easy genre classification with his music. His jazz-inflected meditations on Newfoundland folk music led Overcast magazine to name Bridger “St. John’s Most Original Songwriter,” and saw his works being presented at Sound Symposium, Newfoundland’s foremost contemporary music festival, as well as POP Montréal International Music Festival. Prior to attending music school, Bridger staged works of loosely-improvised minimalism by assembling motley chamber orchestras from the vibrant downtown St...."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
