        "@id": "http://philippespiesser.com/"
      }
    ],
    "http://schema.org/sameAs": [
      {
        "@id": "http://philippespiesser.com/"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/artistes/philippe-spiesser"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Philippe Spiesser"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "fr",
        "@value": "Philippe "
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "fr",
        "@value": "Spiesser"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Né en 1971 dans la région de Strasbourg au sein d’une famille de musiciens invétérés, Philippe Spiesser a été plongé dans l’univers de la musique depuis le plus jeune âge. Il étudiera ensuite au Conservatoire de Musique de Strasbourg, dans la classe de Jean Batigne, célèbre fondateur des Percussions de Strasbourg. En 1997, il est Lauréat du Concours Européen des Jeunes Talents : plus qu’un simple percussionniste, il se révèle alors en musicien captivant et atypique.\r\n\r\nPhilippe Spiesser reste toujours en mouvement et s’enrichit au contact d’autres univers..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
