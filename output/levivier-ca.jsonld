    "http://schema.org/mainEntityOfPage": [
      {
        "@id": "_:g33594380"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "AVANT-PREMIÈRE | WEBDIFFUSION : TRIOCULAIRE +"
      }
    ],
    "http://schema.org/alternateName": [
      {
        "@language": "fr",
        "@value": "RENCONTRE AVEC LINDA BOUCHARD, LES MUSICIENS ET LE CINÉASTE"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "En Novembre dernier l’ensemble TriOculaire + interprétait quelques œuvres de la série des Structures Vivantes de la compositrice Linda Bouchard. Une “première” électrique et généreuse avec Charlotte Hug de Zurich (voix et alto), François Houle de Vancouver (clarinette) et Lori Freedman de Montréal (clarinette basse et clarinette contrebasse) avec une équipe technique hors pair et l’utilisation d’un outil unique que la compositrice utilise pour créer des partitions en temps réel et les projeter sur deux écrans.\r\n\r\nVous n’avez pas pu y assister ?\r\nVous étiez présents et vous souhaitez avoir des réponses à vos questions ?\r\n\r\nNous vous donnons rendez-vous pour une discussion virtuelle et live sur Zoom/YouTube en présence de la compositrice, des musiciens et du cinéaste. L’occasion d’en apprendre davantage sur TriOculaire +, de poser toutes vos questions et de rencontrer l’équipe, en live depuis leur ville respective. La rencontre sera animée par Brice Gatinet.\r\n\r\nPour clôturer ce moment privilégié, vous pourrez découvrir un extrait du concert. Sa version complète sera ensuite disponible gratuitement à partir du dimanche 30 avril pour une durée limitée avec un dispositif imaginé par le cinéaste Hui Lin spécialement pour le web.\r\n"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2023-04-26T21:00:00-04:00"
      }
    ]
  },
