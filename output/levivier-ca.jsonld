    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/le-vivier/membres/individus/marie-helene-breault"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Marie-Hélène Breault"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "fr",
        "@value": "Marie-Hélène"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "fr",
        "@value": "Breault"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Marie-Hélène Breault se distingue par sa polyvalence, sa créativité et l’excellence de son travail comme flûtiste, compositrice-arrangeuse, productrice et pédagogue.&nbsp;\r\n\r\nComme flûtiste, elle se démarque par son expressivité, sa sonorité ample et raffinée, sa technique impeccable et la justesse de son jeu. Au fil des ans, elle s’est produite comme soliste avec la Société de musique contemporaine du Québec (SMCQ), l’Ensemble contemporain de Montréal (ECM) et l’Orchestre symphonique de Montréal. On a aussi pu l’entendre au sein de différentes formations..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
  {
    "@id": "_:g3757960",
    "http://schema.org/url": [
      {
        "@id": "http://pamelareimer.ca/"
      }
    ],
    "http://schema.org/sameAs": [
      {
        "@id": "http://pamelareimer.ca/"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/artistes/membres/individus/pamela-reimer"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Pamela Reimer"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "fr",
        "@value": "Pamela"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "fr",
        "@value": "Reimer"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "La pianiste Pamela Reimer est réputée pour sa polyvalence et sa grande complicité musicale. Elle a joué, participé à des tournées et enregistré avec l’ensemble Bradyworks, le Blue Rider Ensemble, l’ECM+, la SMCQ, Orford Six Pianos, Erreur de Type 27, l’Ensemble Paramirabo, et en duos avec la flûtiste Marie-Hélène Breault et la percussionniste Beverley Johnston. Elle a réalisé plusieurs collaborations interdisciplinaires, notamment avec Les Grands Ballets Canadiens et le Ballet National du Canada, et a créé le concert théâtralisé 50 questions @ 50 (2019). Plusieurs..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
