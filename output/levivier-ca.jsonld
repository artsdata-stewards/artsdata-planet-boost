      {
        "@id": "_:g21936940"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g21936960"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g21937000"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/concert/saison-2025-26/sixtrum-percussion-les-percussions-de-strasbourg-field-vision"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Sixtrum Percussion & Les Percussions de Strasbourg — Field of Vision"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Un concert événement gratuit à l’Agora de l’UQAM, avec 36 percussionnistes dont Sixtrum, Architek Percussion, EP4 percussion et les légendaires Percussions de Strasbourg!Le 7 novembre prochain à 17h, l’Agora du pavillon Judith-Jasmin de l’UQAM se transforme en véritable terrain de jeu sonore. Quatre ensembles de percussion parmi les plus audacieux de la scène contemporaine y donneront vie à Field of Vision, une œuvre monumentale du compositeur américain Michael Gordon (cofondateur de &nbsp;Bang on a Can). Pensée comme une expérience sensorielle totale, Field of Vision transforme l’espace en un champ vibrant de résonances et de pulsations où le rythme se propage comme une onde.La pièce est interprétée sur des instruments de percussion spécialement construits et accordés, ainsi que sur des grosses caisses, des pierres, des branches, des métaux industriels et des gongs. Field of Vision fait partie d’une série d’œuvres pour groupes d’instruments uniques, dans lesquelles Gordon explore, par la disposition spatiale, l’expérience physique et perceptive de la musique et du son.Un concert présenté par SIxtrum en collaboration avec les Percussions de Strasbourg, en co-diffusion avec Le Vivier et le département de Musique de l’UQAM. Soutenu par le Consulat Général de France à Québec, le Conseil des arts et des lettres du Québec (CALQ), le CIRMMT et l’Université McGill."
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-11-07T22:00:00-05:00"
      }
    ]
  },
  {
    "@id": "_:g21937040",
    "@type": [
