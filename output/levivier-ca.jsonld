      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Tour de bras"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Tour de bras est un organisme de création, de production et de diffusion qui œuvre à Rimouski dans le domaine des musiques improvisées.\r\n\r\nPar ses résidences, ses ateliers, ses classes de maîtres et ses concerts, Tour de bras offre aux musiciens intéressés par cette pratique un contexte d’exploration artistique et de partage de savoir favorable à la rencontre et à la création.\r\n\r\nTour de bras se donne aussi pour mandat de favoriser la circulation de ses productions et le rayonnement des œuvres au Canada et à l’étranger.\r\n"
      }
    ],
    "@type": [
      "http://schema.org/PerformingGroup"
    ]
  },
  {
    "@id": "_:g732640",
    "http://schema.org/url": [
      {
        "@id": "http://totemcontemporain.com/"
      }
    ],
    "http://schema.org/sameAs": [
      {
        "@id": "http://totemcontemporain.com/"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "http://totemcontemporain.com/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Productions Totem contemporain"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Productions Totem contemporain (PTC) is dedicated to the research, the development, the production, the creation and to the presentation of projects featuring Jean-François Laporte’s invented instruments and sound installations.\r\n\r\nIn July 2004, PTC took over the Espace Totem, a working space for Jean-François Laporte and his ensemble; an artists’ residence; and a performance venue.\r\n\r\nSince 2008, PTC presents three concerts series: Totem Danse emphasizes on PTC’s instruments and installations with choreographic works; Totem Installation explores the musical potential of our..."
      }
    ],
    "@type": [
      "http://schema.org/PerformingGroup"
    ]
  },
  {
    "@id": "_:g732660",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/en/artists/nous-percons-les-oreilles"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/artists/nous-percons-les-oreilles"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Nous perçons les oreilles"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Two saxophones, two voices; two gargoyles, two satyrs; two forces of nature that agitate, whistle, squeek, scrape, blow, and bite, transforming music into a secular incantation and a banquet of sound.\r\n\r\nNous perçons les oreiles is a rather peculiar duo, down to its very instrumentation. There is a certain symmetry at its core: two alto saxophones improvising together, but the sax players also sing, one relaying the other to a point where, in some places, there is no way of knowing who plays what. A hall of mirrors, symbiotic work. A duality blending into one, just like two ears sending..."
      }
    ],
    "@type": [
      "http://schema.org/PerformingGroup"
    ]
  },
