        "@language": "fr",
        "@value": "DYLAN ROBINSON - SXELXÉLES TE TL'ETL'ÁXEL / DESIGNS FOR INVITING / Semaine du Neuf"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "sxelxéles te tl'etl'áxel / designs for inviting est une performance qui s’interroge sur la manière dont les valeurs autochtones peuvent influencer la présentation de la musique nouvelle (mise en scène, formats de rassemblement) .&nbsp;"
      }
    ],
