    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Le Vivier en coulisse #9"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Pour cette neuvième édition du Vivier en coulisse, Gabriel Dufour-Laperrière s’entretiendra avec la Chef d’orchestre, pianiste et Directrice musicale du NEM (Nouvel Ensemble Moderne) Lorraine Vaillancourt et la compositrice Keiko Devaux, nommée Compositrice de l’année au dernier gala des Prix Opus. Cet entretien est en lien avec le concert du NEM et l’Arsenale du 14 avril prochain dans le cadre de l’événement de résidences et créations Québec/Europe Résonance Croisée. La pièce de Keiko Devaux, Arras, en nomination au Prix Juno pour la composition classique de l’année sur l’album du NEM, Nouvelle musique juive sous étiquette de disque Analekta sera interprétée lors de ce concert.\r\n"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2022-03-30T22:00:00-04:00"
      }
    ]
  },
