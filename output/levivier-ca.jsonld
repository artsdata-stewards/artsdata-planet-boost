    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Big Bang - Sommet de la création"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Laissez-vous emporter par la fougue de l’Orchestre de l’Agora, sous la direction de Nicolas Ellis, qui interprétera les créations de quatre artistes incomparables de la relève québécoise. Ce concert marque le point culminant de toute une semaine de conférences et d’ateliers consacrés à la création ouverts au public.&nbsp;\r\n"
      }
    ]
