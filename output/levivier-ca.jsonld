    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "An inventive and dynamic musician and the founder and artistic director of collectif9, double bassist and arranger Thibault Bertin-Maghit finds his inspiration from multiple sources, from experimental to early music and other mediums. Based in Montreal since 2004, Thibault completed a master's degree in music at the University of Montreal and has participated in numerous baroque, contemporary, chamber and orchestral music festivals in Europe and North America.&nbsp;\r\n\r\nThibault’s artistic projects include award-nominated albums and films, concept programmes, and multimedia productions,..."
      }
    ],
