    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/concert/saison-2021-22/vigiles"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Vigiles"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le chœur Voces Boreales présente le chef-d’œuvre du répertoire choral russe – les magnifiques Vêpres de Rachmaninov – ponctué par un triptyque, présenté en première mondiale, créé spécialement pour l’ensemble par le compositeur canadien d’origine russe Evgeny Shcherbakov. Un concert empreint de ferveur, qui offre une expérience quasi-mystique, &nbsp;conjuguant l’âme russe au passé et au présent.\r\n"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2022-04-30T23:30:00-04:00"
      }
    ]
  },
