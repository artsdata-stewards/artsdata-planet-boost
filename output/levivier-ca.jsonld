    ],
    "http://schema.org/familyName": [
      {
        "@language": "en",
        "@value": "Browne"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Joseph Browne is a composer, sound designer and audio professional based in Montreal with 8 years of experience composing soundtracks for stage productions, film and interactive installations.\r\n\r\nWith a degree in electroacoustic composition from Concordia University, Joseph has worked on over 30 productions ranging from live theatre to film to interactive installations. In 2015 Joseph was awarded Undergraduate Research Award funding to develop spatial audio methods for performance.&nbsp;\r\n\r\nHis sound design for theatre was nominated for two Montreal English Theatre Awards in 2016 and 2018...."
      }
    ],
