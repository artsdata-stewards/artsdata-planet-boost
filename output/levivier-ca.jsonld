    "https://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Journées de la Culture - Gabo Champagne | Le Vivier"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Come discover the behind-the-scenes creation process with the release of the show Yvern, an original work by multidisciplinary creator Gabo Champagne.At the crossroads of theater, performance, and sensory experimentation, Yvern questions how winter has shaped the Quebec imagination and explores the loss of an identity marker in the face of its gradual disappearance. The work imagines a future in a world in decline, where memory and nostalgia take center stage.Excerpts from the work will be presented. The presentation will be followed by a discussion with the artist."
      }
    ],
