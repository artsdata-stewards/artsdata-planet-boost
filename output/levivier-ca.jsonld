  {
    "@id": "_:g20112800",
    "http://schema.org/url": [
      {
        "@id": "https://tourdebras.com/"
      }
    ],
    "http://schema.org/sameAs": [
      {
        "@id": "https://tourdebras.com/"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://tourdebras.com/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Tour de bras"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Tour de bras est un organisme de création, de production et de diffusion qui œuvre à Rimouski dans le domaine des musiques improvisées.\r\n\r\nPar ses résidences, ses ateliers, ses classes de maîtres et ses concerts, Tour de bras offre aux musiciens intéressés par cette pratique un contexte d’exploration artistique et de partage de savoir favorable à la rencontre et à la création.\r\n\r\nTour de bras se donne aussi pour mandat de favoriser la circulation de ses productions et le rayonnement des œuvres au Canada et à l’étranger.\r\n"
      }
    ],
    "@type": [
      "http://schema.org/PerformingGroup"
    ]
  },
  {
    "@id": "_:g20112820",
    "http://schema.org/url": [
      {
        "@id": "http://totemcontemporain.com/"
      }
    ],
    "http://schema.org/sameAs": [
      {
        "@id": "http://totemcontemporain.com/"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "http://totemcontemporain.com/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Productions Totem contemporain"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Les Productions Totem contemporain (PTC) se dédie essentiellement à la création, au développement, à la production et à la diffusion des instruments inventés et installations sonores de Jean-François Laporte.\r\n\r\nEn juillet 2004, l’organisme a investi l’Espace Totem qui se veut à la fois atelier et lieu de répétition pour le compositeur et son ensemble, lieu de résidence pour des artistes, puis lieu de diffusion.\r\n\r\nEn 2008, PTC mettait en place trois séries de concerts: Totem Danse met en valeur les instruments et installations des PTC en parallèle avec une œuvre..."
      }
    ],
    "@type": [
      "http://schema.org/PerformingGroup"
    ]
  },
  {
    "@id": "_:g20112840",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/fr/artistes/nous-percons-les-oreilles"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/artistes/nous-percons-les-oreilles"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Nous perçons les oreilles"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Deux saxophones, deux voix; deux gargouilles, deux satyres; deux forces de la nature qui se démènent, chuintent, couinent, raclent, soufflent, mordent et transforment la musique en incantation profane et en un festin de sons.\r\n\r\nDéjà par son instrumentation, Nous perçons les oreilles constitue un duo assez particulier. On y trouve une certaine symétrie à la base: deux saxophones alto improvisant ensemble, mais des saxophonistes qui chantent aussi, chacun prenant le relais de l’autre si bien que dans certaines sections on ne sait plus du tout qui joue quoi. Un jeu de miroir, un..."
      }
    ],
    "@type": [
      "http://schema.org/PerformingGroup"
    ]
  },
