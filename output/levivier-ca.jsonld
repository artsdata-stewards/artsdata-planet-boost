    "https://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Que vous soyez musicien·ne d'un jour ou de toujours, chanteur·teuse sous la douche ou soliste expérimenté·e, si les clefs de sol et de fa n’ont pas de secret pour vous ou si vous ne savez pas lire une note, apportez votre instrument ou un objet qui ne paraît pourtant pas sonore (casseroles, bols métalliques ou petites cuillères acceptées !), ou votre voix et participez à cette activité musicale collective INOUBLIABLE !"
      }
    ],
    "https://ogp.me/ns#image": [
