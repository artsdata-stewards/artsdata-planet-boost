      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Tandis que les artistes italiens Giulio Colangelo et Vittorio Montalti voyagent 20 000 ans plus tôt dans les grottes de Lascaux au moyen d’éclairs visuels et sonores, le percussionniste Charles Chiovato Rambaldo interprète un motard fou et complètement incontrôlable tout droit sorti des studios hollywoodiens.\r\n"
      }
    ],
