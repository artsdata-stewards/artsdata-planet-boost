    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/concert/saison-2022-23/montreal-mexico"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Montréal-Mexico"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Une heureuse rencontre entre les musiques nouvelles mexicaines et canadiennes dans un concert 100% dédié à la création. Quasar, quatuor de saxophones interprétera les œuvres des compositeurs mexicains Alejandro Padilla et Eduardo Caballero, ainsi que celles des compositrices franco-canadienne Sophie Dupuis et Geneviève Ackerman.\r\n"
      }
    ],
