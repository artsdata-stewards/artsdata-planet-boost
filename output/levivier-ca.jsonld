    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "BETWEEN FEATHERS"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "En 2019, quatre musiciens exceptionnels basés en Autriche (Maria Mogas Gensana à l'accordéon, Audrey G. Perreault aux flûtes, Hannes Schöggl aux percussions, Elīna Viļuma-Helling à la voix) ont décidé de former un ensemble dédié à la musique nouvelle et se sont consacrés à la curiosité, à l'exploration, à la collaboration et à la créativité. Between Feathers explore le répertoire international de la musique nouvelle et collabore avec des compositeurs partageant leur vision : repenser le format traditionnel du concert de musique contemporaine en travaillant avec..."
      }
    ],
    "@type": [
      "http://schema.org/PerformingGroup"
    ]
  },
