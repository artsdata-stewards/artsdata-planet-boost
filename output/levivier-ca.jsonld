      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Aléas : redécouvrir l’univers qui nous entoure à travers le prisme déformant d’un récit poétique transdisciplinaire\r\n&nbsp;\r\nLe CEM et Cléo Palacio-Quintin présentent un concert constitué des quatre œuvres que la flutiste-compositrice a réalisées avec des artistes du Saguenay lors de sa résidence au CEM en 2020.\r\n"
      }
    ],
