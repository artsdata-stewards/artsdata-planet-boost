    ],
    "http://schema.org/familyName": [
      {
        "@language": "en",
        "@value": "Pierini"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "‘I think the music is a field of energies generated between two poles, one connected to the technical-linguistic speculation and one to the instinct and intuition; I do not consider those two in a dialectical opposition though, but rather as integrated elements of the same system which are in dialogic relationship. As such as the pair past-future, the research for new expressive forms and modalities derived from what has come before which belongs and permeates me as an individual who is part of a cultural system with which I can relate on different levels, from the ludic to the critic or..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
