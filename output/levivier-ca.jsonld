      }
    ],
    "http://schema.org/datePublished": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2021"
      }
    ],
    "http://schema.org/composer": [
      {
        "@id": "_:g12292460"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Paillettes et voix graminées à l'orée de paradis"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/le-vivier/repertoire/paillettes-et-voix-graminees-loree-de-paradis"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "en",
        "@value": "Le jardin est cet espace d’harmonisation que crée l’humain afin de s’associer aux incontournables forces de la nature. La poésie vibre dans le tourbillon de ces forces reliant sa portée visible dans l’inaudible. À travers cette métaphore jardinière, déclinée en sept tableaux-paysages aux ambiances aromatiques, tout s’épanouit et fait corps à l’orée des semences orchestrales. À mains nues, murmures avec soin, constance et extase. De la rêverie au sextet de drills, en passant par le vibraphone d’eau et la symphonie d’arrosage aux accents poético-sensuelo-suave,..."
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
