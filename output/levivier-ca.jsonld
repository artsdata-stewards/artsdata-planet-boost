      },
      {
        "@id": "http://brahms.ircam.fr/jean-francois-laporte"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/artists/members/organisms/jean-francois-laporte"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Jean-François Laporte"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "en",
        "@value": "Jean-François"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "en",
        "@value": "Laporte"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Jean-François Laporte is a Québecois artist, active on the contemporary art scene since the middle of the 1990s. He pursues an hybrid approach integrating sonic arts, musical composition, performance, interpretation, installation and digital art. Trained initially at the Université de Montréal (Québec), then at the IRCAM (Paris, France), he builds his compositional approach on active listening and observing of the reality of each phenomenon. For the last ten years, he has invested a lot of energy to the development and to the building of new musical instruments that he integrates to his works and, since 2002, to his installations. He also works in collaboration with contemporary dancers."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
  {
    "@id": "_:g12204720",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/en/artists/diego-bermudez-chamberland"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/artists/diego-bermudez-chamberland"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Diego Bermudez Chamberland"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "en",
        "@value": "Diego"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "en",
        "@value": "Bermudez Chamberland"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Diego Bermudez Chamberland is a Quebecois sound artist whose work incorporates several creative disciplines including composition, sound, design, installations and live performance.&nbsp;His work is inspired by lived experience, both on a human and musical level. Collaboration is an essential aspect of his artistic practice. He sees it as a way to transcend one's work habits and to bring one’s creations to new horizons. He is also interested in the evocative power of sound and its ability to transport us to an \"elsewhere\".&nbsp;\r\n\r\nHe devotes most of his time to the exploration of his discipline through his many projects. Diego is currently completing a master's degree in electroacoustic composition at the Conservatoire de musique de Montréal.\r\n"
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
  {
    "@id": "_:g12204740",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/en/artists/genevieve-ackerman"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/artists/genevieve-ackerman"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Geneviève Ackerman"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "en",
        "@value": "Geneviève"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "en",
        "@value": "Ackerman"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Après avoir terminé un 1er cycle au Conservatoire de musique de Montréal en composition, Geneviève fonde une troupe de théâtre musical, « Le Théâtre du Radeau », un espace de rencontre entre la poésie, le théâtre, la musique et la danse. Profondément marquée par les travaux de Meyerhold, d’Antonin Artaud, de Grotowski, et de Piña Bausch, elle fonde ce théâtre essentiellement expérimental dans l’idée de poursuivre le travail de recherche sur la matière théâtrale qui s’est mis en branle tout au long du XXème siècle, tout en prenant racine dans la tragédie..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
