    "https://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "VIVIER MIX / BENEFIT EVENT 2025 | Le Vivier"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "On December 2, Le Vivier invites you to a festive and creative benefit evening! Come experience an inspiring artistic moment while supporting Montréal’s new music community. Take part in a musical workshop open to everyone, where you’ll discover the creative process alongside artists and fellow music enthusiasts.Funds raised will support two initiatives: the Members’ Creation Fund, which helps commission new works and increase artists’ fees, and the Emerging Artists Fund, which supports the next generation by funding creation residencies through the Pôle Relève program."
      }
    ],
