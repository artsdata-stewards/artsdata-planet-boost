      }
    ],
    "http://schema.org/composer": [
      {
        "@id": "_:g12663040"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "La rêve de Muššàtùr"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/fr/le-vivier/repertoire/la-reve-de-mussatur"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "en",
        "@value": "Dans la mythologue mésopotamienne, Muššàtùr – «&nbsp;serpent venimeux » – est l’un des onze monstres auxquels donne naissance Tiamat, la déesse des eaux primordiales. Tiamat engendre ces monstres pour se venger de ses enfants, qui ont assassiné son époux, mais elle perd la bataille et meurt. Marduk utilise ses os et son sang pour former la Terre et les fleuves. Dans la première version akkadienne de l’Épopée, Muššàtùr est décrit comme un monstre à «&nbsp;six gueules, sept langues et sept sexes », dont Tiamat remplit le corps de poison au lieu de sang...."
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
