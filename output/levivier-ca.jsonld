    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Vitalija Glovackyte creates music bringing together second-hand analogue machines, conventional / home-made instruments, electronics and lo-fi visuals. Aside from her solo work, Vitalija is one-half of the experimental pop duo HYPERDAWN.\r\n\r\nHer most recent large projects are WE ARE FOR A WHILE (hour long multimedia work for recycled instruments and tech) and TENDER VOLTS (for amplified slimming belt motors and live lighting). Offering new life to broken instruments and battered machines recovered from dumpsters, beaches and alleyways, WE ARE FOR A WHILE was originally created for Apartment..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
  {
    "@id": "_:g12940720",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/en/le-vivier/repertoire/we-are-while"
      }
    ],
    "http://schema.org/datePublished": [
