      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le Duo Marie-Hélène Breault Pamela Reimer rend hommage à trois compositeurs canadiens fondateurs des « Événements du neuf » : Claude Vivier, John Rea et le récemment regretté José Evangelista.\r\n"
      }
