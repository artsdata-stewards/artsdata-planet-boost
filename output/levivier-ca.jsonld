  {
    "@id": "_:g15193340",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/en/le-vivier/repertoire/rain-spell"
      }
    ],
    "http://schema.org/datePublished": [
      {
        "@type": "http://schema.org/Date",
        "@value": "1982"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Rain Spell"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/le-vivier/repertoire/rain-spell"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "en",
        "@value": "Rain Spell - along with Garden Rain (1974) for brass, Rain Tree (1981) for vibraphone and two marimbas and Rain Coming (1982) for chamber orchestra - is part of a suite of works inspired by the theme of rain and entitled Waterscape. Rain coming is a special commission from the London Sinfonietta, which premiered in 1982. Takemitsu wanted to compose several pieces that, like their subject matter, would undergo transformations giving rise to an ocean of tonality. Rain spell was written for Sound Space Art in Tokyo.\r\n"
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
