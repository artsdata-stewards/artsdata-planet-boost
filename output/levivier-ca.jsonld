    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/artists/alvin-lucier"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Alvin Lucier"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "en",
        "@value": "Alvin"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "en",
        "@value": "Lucier"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Alvin Lucier was born in 1931 in Nashua (New Hampshire, USA). He was educated in Nashua public and parochial schools, the Portsmouth Abbey School, Yale, and Brandeis and spent two years in Rome on a Fulbright Scholarship. From 1962 to 1970 he taught at Brandeis, where he conducted the Brandeis University Chamber Chorus which devoted much of its time to the performance of new music. Since 1970 he has taught at Wesleyan University where he is John Spencer Camp Professor of Music. Lucier has pioneered in many areas of music composition and performance, including the notation of performers’..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
  {
    "@id": "_:g12468400",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/en/artists/giacinto-scelsi"
      }
    ],
    "http://schema.org/sameAs": [
      {
        "@id": "https://en.wikipedia.org/wiki/Giacinto_Scelsi"
      },
      {
        "@id": "https://giacintoscelsi.bandcamp.com"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/artists/giacinto-scelsi"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Giacinto Scelsi"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "en",
        "@value": "Giacinto"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "en",
        "@value": "Scelsi"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Enfant musicalement doué, Scelsi étudie la composition à Rome avec Giacinto Sallustio. Pendant l’entre-deux-guerres et jusqu’au début des années 1950, il effectue de nombreux voyages en Afrique, en Orient et séjourne longuement en France et en Suisse, où il travaille avec Egon Koehler. Il étudie le dodécaphonisme à Vienne en 1935-36 avec Walter Klein, élève de Schoenberg.\r\n\r\nAu début des années 1950, au sortir d’une longue crise spirituelle, il affiche une nouvelle conception de la musique, dans laquelle le son est au centre de ses préoccupations et se considère..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
  {
    "@id": "_:g12468420",
