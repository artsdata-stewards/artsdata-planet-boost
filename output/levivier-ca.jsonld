    "https://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Spationautes II | Le Vivier"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Under the artistic direction of Cléo Palacio-Quintin, the SuperMusique ensemble invites you to explore the space of sound. Combining improvised and electroacoustic music, interactive animated scores, projections and sound spatialization, this new odyssey will feature Spationautes (2019) by Cléo Palacio-Quintin, as well as creations by Linda Bouchard and Émilie Payeur."
      }
    ],
