    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "DUO HAUPTMEIER & RECKER (DE) | 13 AVRIL"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Deux joueurs se font face et exécutent une improvisation structurée à l’aide d’ordinateurs, de contrôleurs, de capteurs tactiles, d’un échantillonnage en direct et d’un mixeur sans entrée. Un spectacle d’art sonore et multimédia signé par le duo Hauptmeier-Recker.\r\n"
      }
    ],
