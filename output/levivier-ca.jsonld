    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Corps de brume"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/le-vivier/repertoire/corps-de-brume"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "en",
        "@value": "Essentiellement inspirée par le timbre de l'instrument et son souffle incessant, cette pièce vise à créer un état d'esprit contradictoire : stationnaire, hypnotique et brumeux mais aussi progressif, lumineux et clair. Corps de brume appelle le sauvage, la grande chasse, la recherche de cet état transcendant qui porte l'esprit au-delà de lui-même.\r\n"
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
