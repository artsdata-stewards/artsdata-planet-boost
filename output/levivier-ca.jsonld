    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Inaes"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/le-vivier/repertoire/inaes"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "en",
        "@value": "Composed entirely from sounds obtained by synthesis, Inaes offers us an energetic and rapid speech, sharp, contrasting and constantly revived. The playful energy, sometimes pushed to its apex, reaches rawness. The resumption in writing made with generally united sound materials is a way to show several facets of the same image, as if we were directing a beam of light on multiple small debris of mirrors and the reflections that shimmers are unpredictable, dazzling and fleeting.\r\n"
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
