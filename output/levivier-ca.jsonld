      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Anna Pidgorna is a Ukrainian-Canadian composer, vocalist and multi-media artist who combines sound, visual arts, and writing to create works that are dramatic and picturesque. She works extensively with Ukrainian folk singing, draws inspiration from the natural soundscape, and incorporates visual elements into some of her manuscripts. Her work has been commissioned, performed and recorded by soloists and ensembles in Canada, USA, Uruguay, Ireland, Scotland, France, Germany, Austria, Italy, Greece, Poland, Ukraine and South Korea. She holds a PhD from Princeton University, an MMus from the..."
      }
    ],
