        "@id": "https://www.facebook.com/isabelle.bozzini.98"
      },
      {
        "@id": "https://twitter.com/IsabelleBozzini"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/artists/members/organisms/isabelle-bozzini"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Isabelle Bozzini"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "en",
        "@value": "Isabelle"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "en",
        "@value": "Bozzini"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "A passionate chamber player, cellist Isabelle Bozzini is dedicated to exploring two parallel worlds — new music of all kinds and music on period instruments. This endeavour continuously challenges her and nourishes her artistic aspirations.\r\n\r\nShe is a founding member of the Quatuor Bozzini which since its inception in 1999 has become one of Canada’s leading string quartets on national and international scenes. Playing close to forty concerts per year, the Bozzinis produce their own concert series in Montréal including the Salon des compositeurs + Composer’s Kitchen event. They tour..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
  {
    "@id": "_:g13346420",
    "http://schema.org/url": [
      {
