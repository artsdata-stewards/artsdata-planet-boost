      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "QUASAR - MONTRÉAL / MONTERREY: LE SOUFFLE DES CORPS "
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Quasar – quatuor de saxophones renouvelle sa collaboration avec la Escuela Superior de Música y Danza de Monterrey (ESMDM). Cette initiative transculturelle fait dialoguer les univers de la musique et de la danse contemporaine du Québec et du Mexique à travers une production ambitieuse.&nbsp;"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-03-11T23:30:00-04:00"
      }
    ]
  },
