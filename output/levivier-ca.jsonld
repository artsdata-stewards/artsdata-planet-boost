    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Journées de la culture - Orchestre d'un après-midi"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Que vous soyez musicien·ne d'un jour ou de toujours, chanteur·teuse sous la douche ou soliste expérimenté·e, si les clefs de sol et de fa n’ont pas de secret pour vous ou si vous ne savez pas lire une note, apportez votre instrument ou un objet qui ne paraît pourtant pas sonore (casseroles, bols métalliques ou petites cuillères acceptées !), ou votre voix et&nbsp;participez à cette activité musicale collective INOUBLIABLE !"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2024-09-28T17:00:00-04:00"
      }
    ]
  },
