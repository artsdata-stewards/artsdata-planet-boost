      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g3759960"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/concert/saison-2022-23/joane-hetu-elle-son-mot-dire"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "JOANE HÉTU : ELLE A SON MOT À DIRE"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Joane Hétu offre ici un mini-cabaret au caractère dadaïste qui s’articule autour de nouvelles créations ainsi que de chansons et textes réorchestrés connus et inconnus. Les musicien·ne·s s’approprient les mots de Joane Hétu pour les faire résonner et les propulser dans un univers fantaisiste qui mélange discours amoureux, prises de parole et délires phonétiques. Quel sera donc ce mot à dire?\r\n"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2023-05-03T23:30:00-04:00"
      }
    ]
  },
