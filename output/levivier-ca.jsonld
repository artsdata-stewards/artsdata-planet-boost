        "@value": "Quatuor Bozzini: Ways of Returning"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le quatuor à cordes virtuose poursuit son exploration des possibilités apparemment infinies du timbre et de la couleur sonore en interprétant des œuvres puisant dans le glitch art, le minimalisme, le noise et le dark ambient.\r\n"
      }
