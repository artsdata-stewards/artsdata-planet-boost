    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/concert/saison-2024-25/chants-de-passage-andre-pappathomas-grand-choeur-du-centre-sud"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Chants de passage — André Pappathomas — Grand chœur du Centre-Sud "
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Conçue et dirigée par André Pappathomas, Chants de passage est une création collective en huit mouvements pour chœur, quatre solistes, piano, hautbois, cornemuse irlandaise, tuba, percussions et instruments à cordes inventés.Dans toute forme d’acte poétique il y a un « passage » entre l’inspiration et la création... Des moments de révélations en quelque sorte. À partir de thèmes écrits par André Pappathomas, la conception des Chants de passage a évolué au fil des répétitions, créant à travers ces moments de révélations, des croisements singuliers et touchants entre les cultures musicales des solistes et instrumentistes invité-es.&nbsp;L’ensemble des huit mouvements de la pièce se veut aussi une illustration, dans ce premier tiers de notre hiver, du passage de l’ombre précieuse à l’expression essentielle de la lumière.&nbsp;"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-01-24T00:30:00-05:00"
      }
    ]
  },
