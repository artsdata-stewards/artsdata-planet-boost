    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/concert/2025-26-season/tim-brady-electric-guitar-canada"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Tim Brady — Electric Guitar @Canada"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Virtuoso guitarist and composer Tim Brady presents two concerts highlighting the richness of electric guitar composition across Canada.The electric guitar has been an instrument dedicated to musical creation since its inception in 1932—and we're not letting go! This major two-day event showcases electric guitar composition across Canada, with soloists and composers from Quebec, Ontario, Nova Scotia, and Manitoba. These concerts will showcase a wide range of styles and approaches : the jazz and folk influences of Sam Wilson, chamber music with Instruments of Happiness and its guest soloists, electro-experimental music with Andrew Noseworthy, and two major solo pieces by Tim Brady. The November 13 concert will also mark the launch of Tim Brady's new double album, For Electric Guitar, on the People Places Records label, which celebrates the 40th anniversary of his first solo electric guitar album, dR.E.aM.s, released in 1985."
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-11-14T00:30:00-05:00"
      }
    ]
  },
