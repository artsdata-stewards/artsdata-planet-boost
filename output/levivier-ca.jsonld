  {
    "@id": "_:g1355720",
    "@type": [
      "http://schema.org/MusicEvent"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/en/concert/2025-26-season/ggril-c-ime-ensemble-supermusique-des-nuees-de-ritournelles"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "_:g1355740"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1355760"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g1355800"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/concert/2025-26-season/ggril-c-ime-ensemble-supermusique-des-nuees-de-ritournelles"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "GGRIL • C-IME • Ensemble Supermusique — Des nuées de ritournelles"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "A meeting between the improvisers of the Rimouski-based ensemble GGRIL and Ensemble SuperMusique, together with the musicians and sound artists of the Belgian collective C-IME.The idea of the ritournelle comes from Belgian saxophonist and composer Audrey Lauro. Although she won’t be traveling with them this time, her spirit accompanies this concert—conceived and reconceived—made of improvisation, fragility, and attentive listening. Members of GGRIL and C-IME have been collaborating for several years, following a serendipitous encounter at the Citadelic Festival in Ghent. In 2022, after a residency in Rimouski, Audrey Lauro composed Ritournelle Reverse, a piece for GGRIL.In a marvelous desire to collaborate within a shared creative process—one that inhabits space and the physicality of sound—three musicians from C-IME (Belgium), five musicians from GGRIL (Rimouski), and two guests from Ensemble SuperMusique (Montréal) come together on stage for a Montréal ritournelle."
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-10-06T00:00:00-04:00"
      }
    ]
  },
  {
    "@id": "_:g1355960",
    "@type": [
      "http://schema.org/MusicEvent"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/en/concert/2025-26-season/roozbeh-tabandeh-chants-libres-paramirabo-songs-drowning"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "_:g1355980"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1356000"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g1356040"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/concert/2025-26-season/roozbeh-tabandeh-chants-libres-paramirabo-songs-drowning"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Roozbeh Tabandeh • Chants libres • Paramirabo — Songs of the Drowning"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Songs of the Drowning is an interdisciplinary performance created by Roozbeh Tabandeh, inspired by the poems of Sandeep Bhagwati and the paintings of Khosro Berahmandi.Bhagwati’s poetry served both as inspiration and as a source of ideas throughout the musical composition process. The poetry cycle offers a critical reflection on the human condition in our time. These nine short poems, originally written in German, will be presented in four languages during the performance, including English, French, and Farsi. The final work thus weaves together these four languages with Roozbeh Tabandeh’s music, video works by Hadi Jamali inspired by Khosro Berahmandi’s paintings, and a scenography created by set designer and architect Haleh Vedadi in collaboration with Roozbeh Tabandeh.The production is a copresentation under the artistic direction of Roozbeh Tabandeh, in collaboration with Paramirabo, Chants Libres, and Le Vivier."
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-10-16T00:30:00-04:00"
      }
    ]
  },
