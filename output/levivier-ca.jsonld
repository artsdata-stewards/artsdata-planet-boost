    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le concert présenté par l’Ensemble SuperMusique se compose de deux œuvres commandées à l’ébouriffante saxophoniste-vocaliste Joane Hétu ainsi qu’au rocambolesque claviériste Vergil Sharkya’.\r\n"
      }
