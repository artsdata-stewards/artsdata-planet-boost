      {
        "@language": "fr",
        "@value": "LA SEMAINE DU NEUF"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Après le succès de la 1ère édition et l'hommage rendu au compositeur Claude Vivier en 2023, La Semaine du Neuf est de retour&nbsp;du 1er au 18&nbsp;mars 2024 et invite le public à explorer les liens possibles entre les arts numériques et les&nbsp;musiques nouvelles.&nbsp;Pour l’occasion, Le Vivier est heureux d'accueillir le compositeur Pierre Jodlowski dont certaines œuvres seront mises de l'avant par nos membres et artistes internationaux.&nbsp;Des concerts, performances, installations sonores et discussions, in situ et en ligne, viendront rythmer ces presque 20 jours de programmation."
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2024-03-01T23:30:00-05:00"
      }
    ]
  },
