    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/concert/saison-2024-25/chants-libres-laboratoire-lyrik-03-la-voix-lumineuse-semaine-du-neuf"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Chants Libres / Laboratoire Lyrik 03 : La voix lumineuse — Semaine du Neuf"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dans ce nouveau Laboratoire lyrik de Chants Libres, les artistes explorent les concepts de présence et d’absence.Présenté à La Chapelle Scènes Contemporaines, ce projet de recherche-création réunit le scénographe Cédric Delorme-Bouchard, la comédienne Jennyfer Desbiens, la violoncelliste Audréanne Filion, la mezzo-soprano Marie-Annick Béliveau et le compositeur Frédéric Lebel, dans un triptyque alliant voix, violoncelle et électronique. La dramaturgie sonore et lumineuse met en avant la métamorphose des corps physiques sur scène, offrant au public une immersion dans la création lyrique contemporaine.Une production de Chants Libres en codiffusion avec Le Vivier.&nbsp;"
      }
    ],
