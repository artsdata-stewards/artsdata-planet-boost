  {
    "@id": "_:g14736780",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/en/le-vivier/repertoire/string-quartet-no-2-three-busy-monsters"
      }
    ],
    "http://schema.org/datePublished": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2023"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "String Quartet No. 2 “Three Busy Monsters”"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/le-vivier/repertoire/string-quartet-no-2-three-busy-monsters"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "en",
        "@value": "Afreely written chorale in one movement, where the chords are divided over three axes of intonation. The quartet plays in pairs so that the melodic, repeating clouds of chord sequences can be “hocketed” over these three axes. Each axis received a name—they are Jeff, Elon and Richard.\r\n"
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
  {
    "@id": "_:g14736820",
