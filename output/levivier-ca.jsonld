      "http://schema.org/PerformingGroup"
    ]
  },
  {
    "@id": "_:g12830800",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/en/artists/alejandro-padilla"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
