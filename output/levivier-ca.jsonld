    "https://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Entre Nous | Le Vivier"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Enter the music theater work Entre Nous as a singular anthropological investigation, brilliantly led by Quasar - saxophone quartet and narrated by actors Tracy Marcelin, Marc Béland, Lili Morin-Prévost, and Nicolas Dionne-Simard. Up-and-coming Franco-Ontarian composer Thierry Tidrow wrote Entre Nous especially for Quasar. Combining instrumental music and theatre in a playful way, the piece acts as a revealer of hidden meanings and explores what language does and doesn't say about our past, our values, our traumas, our prejudices, our need to belong, and our need to laugh."
      }
    ],
