        "@value": "2021"
      }
    ],
    "http://schema.org/composer": [
      {
        "@id": "_:g10923120"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Quelques souvenirs du fleuve entre Trois-Pistoles et Sept-Iles"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/fr/le-vivier/repertoire/quelques-souvenirs-du-fleuve-entre-trois-pistoles-et-sept-iles"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "en",
        "@value": "Des images sonores venant du fleuve, là où il devient une mer et se déploie sous divers aspects. En vrac : mer d’huile du petit matin, mer pleine des jours gris, vagues qui roulent sur la plage, mer furieuse et débordante, craquements des glaces riveraines ou scintillements d’argent au coucher du soleil.\r\n"
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
