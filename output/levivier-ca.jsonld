        "@value": "Ritratto"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Bakarlari convie à une expérience sensorielle riche en émotion, où son, lumière et mise en scène de JJ Houle se rencontrent de façon audacieuse. À travers un portrait de Luciano Berio et de Gabo Champagne découvrez cinq œuvres solos pour saxophone, guitare, trompette, piano et clarinette.\r\n"
      }
    ],
