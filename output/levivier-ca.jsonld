    "https://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "ICE [INSTALLATION] | Le Vivier"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Ice, œuvre de Jimmie Leblanc, est une installation immersive mixte et sonore en collaboration avec l'artiste Fareena Chanda et le physicien Stephen Morris qui explore la formation silencieuse des stalactites. Le processus lent et dynamique de la transformation de l'eau fluide en glace statique est caractéristique de l'universalité, de la beauté et de la violence. L'œuvre invite le spectateur à vivre les moments figés de ce processus en engageant son esprit et son corps dans l'espace de l'installation."
      }
    ],
    "https://ogp.me/ns#image": [
