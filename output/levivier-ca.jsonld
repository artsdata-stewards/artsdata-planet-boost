      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Productions SuperMusique (PSM)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Créé en 1979, Productions SuperMusique est dirigé par Joane Hétu et Danielle Palardy Roger. Organisme entièrement dédié à la musique actuelle, à l’improvisation et à l’expérimentation sonore, PSM est un leader dans sa discipline.\r\n\r\nMusique actuelle: improvisation, jazz d’avant-garde, chansons éclatées, folklore réinventé, ambiances bruitistes, nouvelles musiques d’ensemble, métissages des lutheries acoustiques et électroacoustiques. Les musiques mises de l’avant par SuperMusique sont des musiques renouvelées par la cohabitation des différentes tendances..."
      }
    ],
    "@type": [
      "http://schema.org/PerformingGroup"
    ]
  },
  {
    "@id": "_:g32693260",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/fr/le-vivier/repertoire/spationautes-ii"
      }
    ],
    "http://schema.org/datePublished": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2019"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Spationautes II"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/le-vivier/repertoire/spationautes-ii"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "fr",
        "@value": "Commande de SuperMusique, pour ensemble de musiciens-improvisateurs, bande électroacoustique* spatialisée et projections interactives\r\n\r\nSpationautes est au départ une œuvre graphique, un monde imaginaire en cinq dimensions que j’ai créé sous forme de dessins. Chaque dimension représente un point de vue cosmologique distinct : cosmos, éther, paysage, jungle et hypogée (ce dernier étant un monde souterrain microscopique un peu étrange). Les dessins de ces cinq « espaces-temps » parallèles servent à la fois de canevas, d’orchestration et d’inspiration pour..."
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
  {
    "@id": "_:g32693300",
