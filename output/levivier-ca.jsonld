    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Le Vivier en coulisse #8"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Pour cette huitième édition du Vivier en coulisse, Dominique Lafortune s’entretiendra avec le compositeur Philippe Leroux au sujet de sa pièce Éon (2019), entre autres. Elle est prévue au programme du concert de la violoncelliste Séverine Ballon le 13 avril prochain, présenté dans le cadre de l’événement de résidences et créations Québec/Europe Résonance Croisée.\r\n"
      }
    ],
