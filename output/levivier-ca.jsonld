    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Exercices d'Étrangeté III Mycorrhizia"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/le-vivier/repertoire/exercices-detrangete-iii-mycorrhizia"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "en",
        "@value": "Exercises in Estrangement III Mycorrhizia explores the most basic process of interspecies communication: the exchange of molecules between trees and the fungal network that connects their roots. The four musicians send gestural and melodic molecules to each other, receive and transform them in a continual cycle of assimilation and separation. Together, all these musical threads will form a living sonic texture, an acoustic rootscape in which we listeners can wander and follow the melodies' ramifications. On a surface that intimately connects the four players - at the same time their..."
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
