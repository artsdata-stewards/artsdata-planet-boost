    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Unhörbare Zeit (SOLD OUT)"
      }
    ],
    "http://schema.org/alternateName": [
      {
        "@language": "en",
        "@value": "Presented as part of the Festival Suoni Per II Popolo"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Quatuor Bozzini and percussionists Kristie Ibrahim and Fabrice Marandola explore the space and malleability of time in the music of Swiss composer Jürg Frey, known for leading the listener to explore vast inner soundscapes.\r\n\r\nThe musicians delicately lay down each sound, hovering at the limits of perception and expressiveness.\r\n\r\nThe composer describes his work Unhörbare Zeit (Unaudible Times) as follows: \"Unhörbare Zeit are empty volumes in the music. Durations without sounds define their own entity and develop their architectural presence. One should add nothing to these empty volumes, neither in composition nor while listening. They should remain open, light and serene.\"\r\n"
      }
    ]
  },
