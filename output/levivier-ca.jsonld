  {
    "@id": "_:g33053800",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/fr/le-vivier/repertoire/wablework"
      }
    ],
    "http://schema.org/datePublished": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2011"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Wablework"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/le-vivier/repertoire/wablework"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "fr",
        "@value": "Le point de départ de cette pièce est inusité. Il y a plusieurs années, désirant quitter mon coin de pays de la côte ouest canadienne pour aller étudier la composition en Europe, j’ai mis sur pied une collecte de fonds pour payer mon voyage. En vendant à chaque personne rencontrée quelques mesures d’une musique qui n’existait pas encore, j’ai pu récolter un gros montant provenant d’une soixantaine de sympathisants — amis, famille, membres de la communauté. Au printemps 2011, avec l’aide du Quatuor Bozzini, j’ai enfin pu réaliser ma promesse en créant Warblework...."
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
