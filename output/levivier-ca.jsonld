    "https://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Portrait#2 Alla Zagaykevych // VivierMix | Le Vivier"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Dans ce deuxième concert-portrait d’Alla Zagaykevych, l’artiste ukrainienne en résidence au Vivier, nous invite à entendre trois œuvres de son répertoire et une création. Elles seront interprétées par Quasar (saxophones), Pamela Reimer (piano), Lyne Allard (violon), Hubert Brizard (violon), Marie-Annick Béliveau (mezzo-soprano - Chants Libres), Corinne René (percussions - PSM)."
      }
    ],
