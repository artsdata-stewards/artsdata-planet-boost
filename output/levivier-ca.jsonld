        "@value": "JOURNAL"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Sous la direction de Pascal Germain-Berardi, le chœur émergent Temps Fort interprète Journal, une œuvre majeure de Claude Vivier, avec les voix des solistes Marie-Annick Béliveau, Ariadne Lih, Clayton Kennedy, Arthur Tanguay-Labrosse et David Therrien-Brongo aux percussions.&nbsp;\r\n"
      }
    ],
