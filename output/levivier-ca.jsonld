    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "ESM : ZIGZAGUE & COLORE"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Get a front row seat for this colourful and uncompromising concert featuring the creations of three distinguished sound explorers! Supported by the virtuoso instrumentalists of the SuperMusique Ensemble, Canadian performer Laura Kavanaugh, Australian-born clarinetist Elizabeth Millar, and SuperMusique doyenne Danielle Palardy Roger will premiere live works using graphic scores and improvisation instructions. With their characteristic and well-known sensitivity and attentiveness, the instrumentalists will play the scores provided in the form of drawings, colours, verbal instructions, or other surprising means.&nbsp;\r\n"
      }
    ],
