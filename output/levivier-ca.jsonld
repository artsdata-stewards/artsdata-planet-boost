  {
    "@id": "_:g3924380",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/fr/artistes/gabriel-dufour-laperriere"
      }
    ],
    "http://schema.org/sameAs": [
      {
        "@id": "https://soundcloud.com/gabduflap"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/artistes/gabriel-dufour-laperriere"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Gabriel Dufour-Laperrière"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "fr",
        "@value": "Gabriel"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "fr",
        "@value": "Dufour-Laperrière"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Originaire de Chicoutimi, Gabriel Dufour-Laperrière vit et travaille à Montréal comme compositeur. Il complète actuellement un doctorat en composition auprès de Denys Bouliane à l’école de musique Schulich de l’Université McGill. Sa recherche porte sur la notion de cinétisme musical, impliquant les dimensions reliées à la directionnalité et aux forces dynamiques perceptibles en musique. Il se dédie aussi à l’étude et à la transmission de la sonologie auditive, une approche développée par le compositeur Lasse Thoresen vouée à l’analyse auditive (sans partition)..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
  {
    "@id": "_:g3924400",
    "http://schema.org/url": [
      {
        "@id": "http://www.timbrady.ca/"
      }
    ],
    "http://schema.org/sameAs": [
      {
        "@id": "http://www.timbrady.ca/"
      },
      {
        "@id": "https://www.facebook.com/timbradymusic"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/artistes/membres/organismes/tim-brady"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Tim Brady"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "fr",
        "@value": "Tim"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "fr",
        "@value": "Brady"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Guitariste-compositeur, Tim Brady ne peut être rattaché à une seule catégorie d’artiste. Que ce soit dans les opéras qu’il a écrits ou les concertos dans lesquels il a joué, il est avant reconnu comme virtuose de la guitare électrique mais il se sent aussi bien l’aise avec des improvisations électros qu’avec un quatuor à cordes. La « guitare orchestre » est une synthèse très personnelle de musique classique contemporaine, jazz, rock et électronique."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
