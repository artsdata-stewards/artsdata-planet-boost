    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Portrait Alla Zagaykevych // VivierMix"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "En solidarité avec les artistes ukrainien·ne·s, Le Vivier invite Alla Zagaykevych en résidence pour la saison 22-23. Entrez dans l’univers captivant de la compositrice ukrainienne et laissez-vous imprégner par ses œuvres qui mélangent subtilement la musique instrumentale et l’électronique. Très inspirée par la poésie, la musique d’Alla Zagaykevych suggère des atmosphères envoûtantes. Dans ce concert conçu par la compositrice, le Nouvel Ensemble Moderne, les Productions SuperMusique, Paramirabo et Chants Libres interpréteront des œuvres de son répertoire.&nbsp;\r\n"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2022-10-16T19:00:00-04:00"
      }
    ]
  },
