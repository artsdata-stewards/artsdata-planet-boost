  {
    "@id": "_:g14703980",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/en/le-vivier/repertoire/something-out-apocalypse"
      }
    ],
    "http://schema.org/datePublished": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2012"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Something Out Of Apocalypse"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/le-vivier/repertoire/something-out-apocalypse"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "en",
        "@value": "This composition refers of course to Coppola's masterpiece, Apocalypse Now, which I discovered in a rather unusual way : I didn't actually see the film when it was originally released, but a few years later. I first listened to the soundtrack, on an old L.P(vinyl) which was quite damaged, spoilt with scratches to the extent &nbsp;that the voices of Captain Willard and Colonel Kurtz &nbsp;were scarcely heard. Some time after, I read \"Heart of Darkness\" by Joseph Conrad which Coppola adapted for his film and it was only a few years later that I saw the film in a poor suburban cinema.\r\nWhat..."
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
