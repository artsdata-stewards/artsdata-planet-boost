  {
    "@id": "_:g14130740",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/en/le-vivier/repertoire/moths-flame"
      }
    ],
    "http://schema.org/datePublished": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2023"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Like moths to a flame"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/le-vivier/repertoire/moths-flame"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "en",
        "@value": "This work is an echo of two important first encounters in my compositional development: the first time I touched a five-octave marimba at a percussion seminar with So Percussion, and the first time hearing Kaija Saariaho’s “Sept Papillon” (Seven Butterflies). Marimba, generally a very “happy” sounding instrument because of that strong major third in the overtones, sounds wonderfully muddy in its lowest range. Hearing those low thuds I imagined human-sized moths throwing themselves against a giant lantern in a manic attempt to unite with the flame, leaving smudges of grayish brown..."
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
