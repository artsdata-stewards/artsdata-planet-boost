  {
    "@id": "https://levivier.ca/en/event/2024-25-season/totem-contemporain-spiritual-semaine-du-neuf",
    "https://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Le Vivier"
      }
    ],
    "https://ogp.me/ns#type": [
