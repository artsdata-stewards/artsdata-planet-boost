    "https://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/event/2024-25-season/cine-quasar"
      }
    ],
    "https://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "CINÉ-QUASAR | Le Vivier"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Quasar Unveils Digital Triptych and Celebrates Three DecadesQuasar saxophone quartet presents an unmissable event: the screening of their cinematic triptych featuring three works by Quebec composers in three art films, accompanied by three documentaries by filmmaker Simon Roberge. Come (re)discover Ode au Métal by Sonia Paço-Rocchia, Chaleurs by Walter Boudreau, and Entre Nous by Thierry Tidrow in all their splendor, with behind-the-scenes access to the creation of these three landmark performances in Quasar's career. At the same time, come celebrate the quartet's 30th anniversary with its founding members, collaborators, and all its friends, in a festive and friendly atmosphere."
      }
    ],
    "https://ogp.me/ns#image": [
      {
