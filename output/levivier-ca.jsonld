    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "E27 musiques nouvelles (E27)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "E27 musiques nouvelles est un organisme de création et de production en musiques nouvelles. Fondé en 1999, E27 incarne la présence musicale contemporaine dans la région de Québec. Depuis 2015, E27 ouvre ses actions à toutes les musiques. Son mandat principal est de valoriser la création musicale récente en offrant à son public la chance d’entendre une grande diversité de musiques de création récentes. La mission de l’organisme vise à contribuer à l’appréciation de différentes démarches musicales créatives sans égard aux styles: musiques de concert, improvisation,..."
      }
    ],
    "@type": [
      "http://schema.org/PerformingGroup"
    ]
  },
