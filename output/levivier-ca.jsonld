    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/concert/saison-2022-23/entre-nous"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Entre Nous"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Entrez dans le théâtre musical Entre Nous comme dans une enquête anthropologique singulière, menée avec brio par Quasar – quatuor de saxophones et narrée par la comédienne Tracy Marcelin et les comédiens Marc Béland, Lili Morin-Prévost et Nicolas Dionne-Simard. Thierry Tidrow, compositeur franco-ontarien en plein essor, a écrit Entre Nous spécialement pour Quasar. Combinant musique instrumentale et vocale de manière ludique, la pièce agit comme un révélateur de sens cachés et explore ce que la langue dit et ne dit pas sur notre passé, nos valeurs, nos traumas, nos préjugés, notre besoin d’appartenance et notre besoin de rire.\r\n"
      }
    ]
  },
  {
