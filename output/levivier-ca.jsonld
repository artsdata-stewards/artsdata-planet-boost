        "@language": "fr",
        "@value": "Chants libres & Paramirabo / Oper'Actuel "
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Découvrez, expérimentez six créations lyriques avec Chants Libres.Oper'Actuel vous propose de découvrir six extraits d'opéras en création, dans des propositions extrêmement variées qui vous mèneront du théâtre musical à l’opéra de chambre, en passant par l’opéra de poche et la performance multidisciplinaire.&nbsp;"
      }
    ],
