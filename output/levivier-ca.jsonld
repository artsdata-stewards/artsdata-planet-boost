        "@language": "en",
        "@value": "Corwin"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Lyric soprano Charlotte Corwin is one of Canada's most exciting young singers, established as an accomplished soloist and choral performer, of both opera and concert repertoire.\r\n\r\nA member of the elite Atelier Lyrique de L'Opéra de Montréal from 2005 to 2008, Charlotte debuted as Juliette in the 2007 production of Romeo et Juliette with L'Opera de Québec.\r\n"
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
