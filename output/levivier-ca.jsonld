  {
    "@id": "_:g15544380",
    "http://schema.org/url": [
      {
        "@id": "https://sixtrum.com/en"
      }
    ],
    "http://schema.org/sameAs": [
      {
        "@id": "https://sixtrum.com/en"
      },
      {
