      }
    ],
    "https://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/concert/2024-25-season/nanatasis-musique-3-femmes-sixtrum-semaine-du-neuf"
      }
    ],
    "https://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "NANATASIS — Musique 3 Femmes & Sixtrum — Semaine du Neuf | Le Vivier"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Premiered at the Casteliers puppet festival, this show created by Nicole O'Bomsawin and Alejandra Odgers transports us to a magical world inspired by Abenaki legends.Discover the adventures of a young Abenaki who becomes a hero after facing many trials. Under the direction of Troy Hourie and Christopher Gaudreault, a talented team of fifteen musicians, choristers, and puppeteers takes the stage amidst dreamlike sets to draw the audience into a fantastic universe.Nanatasis is a show that awakens the child within us.An ode to Abenaki culture and nature.\""
      }
    ],
    "https://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/sites/default/files/evenements/S9-Nanatasis.jpg"
      }
    ],
