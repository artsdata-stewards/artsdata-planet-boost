      {
        "@language": "en",
        "@value": "Beaulieu"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Stéphane Beaulieu s’implique sur la scène des musiques de création depuis près de quinze ans. Bachelier en éducation musicale à l’Université Laval, il explore divers horizons de la musique d’improvisation, autant dans sa démarche personnelle que professionnelle. On a pu le voir et l’entendre dans divers projets stylistiquement variés, notamment pour le CEM au sein la Ligue d’Improvisation Musicale du Saguenay ainsi qu’à travers plusieurs participations au Lab : musiques d’appellation incontrôlées.\r\n"
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
  {
    "@id": "_:g12264240",
