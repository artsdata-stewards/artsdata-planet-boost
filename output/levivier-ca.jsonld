      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Dominique Lafortune"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "fr",
        "@value": "Dominique"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "fr",
        "@value": "Lafortune"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le compositeur montréalais Dominique Lafortune (1989, Saint-Césaire, Québec) s’intéresse de près aux sens possibles des dimensions intrinsèques de la musique. Ses études avec les compositeurs Denys Bouliane (McGill, Montréal) et Lasse Thoresen (Norges Musikkhøgskole, Oslo) lui donnèrent le goût d’une production musicale où la perception est à la base de toute décision.\r\n\r\n\r\nIl a écrit pour une variété d’effectifs (soliste, instrumentiste et dispositif électronique, chœur, orchestre symphonique, ainsi qu’ensemble de deux à vingt instruments), et ses oeuvres furent..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
  {
    "@id": "_:g3922160",
    "http://schema.org/url": [
      {
        "@id": "https://www.lerouxcomposition.com/fr/index.html"
      }
    ],
    "http://schema.org/sameAs": [
      {
        "@id": "https://www.lerouxcomposition.com/fr/index.html"
      },
      {
        "@id": "https://fr.wikipedia.org/wiki/Philippe_Leroux_(compositeur)"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/artistes/philippe-leroux"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Philippe Leroux"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "fr",
        "@value": " Philippe"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "fr",
        "@value": "Leroux"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Philippe Leroux est né en 1959 à Boulogne sur Seine (France). En 1978, il entre au Conservatoire National Supérieur de Musique de Paris dans les classes d’Ivo Malec, Claude Ballif, Pierre Schäeffer et Guy Reibel où il obtient trois premiers prix.\r\nDurant cette période, il étudie également avec Olivier Messiaen, Franco Donatoni, Betsy Jolas, Jean-Claude Eloy et Iannis Xénakis.\r\nEn 1993, il est nommé pensionnaire à la Villa Médicis (prix de Rome) où il séjourne jusqu’en octobre 1995.\r\n\r\nLa musique de Philippe Leroux, toujours très vivante et souvent pleine de surprises, est..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
