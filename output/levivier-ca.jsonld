      {
        "@id": "https://vimeo.com/nouvelensemblemoderne"
      },
      {
        "@id": "https://www.youtube.com/channel/UCqRffCfjQ9CFYx14cyWSyoQ"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "http://lenem.ca"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Nouvel Ensemble Moderne"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le Nouvel Ensemble Moderne (NEM), fondé en 1989 par la cheffe Lorraine Vaillancourt, est un orchestre de chambre constitué de musiciens permanents qui se produit au Québec, au Canada et à l’international.\r\n&nbsp;\r\nGuidé par le devoir d’interpréter les grandes œuvres musicales et le répertoire du XXe et du XXIe siècle tant sur la scène nationale qu’internationale, et par le désir de stimuler la création d’œuvres originales, le NEM a pour mission de diffuser et de promouvoir cette musique. Chef de file incontournable dans son milieu et sur la scène internationale, le NEM..."
      }
    ],
    "@type": [
      "http://schema.org/PerformingGroup"
    ]
  },
  {
    "@id": "_:g34908300",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/fr/artistes/membres/organismes/productions-fiolutroniq"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/artistes/membres/organismes/productions-fiolutroniq"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Productions Fiolûtröniq"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Productions Fiolûtröniq est un véhicule des nouvelles tendances artistiques, qui vise à faire connaître des musiques nouvelles au grand public en présentant des concerts et spectacles multidisciplinaires. Sa directrice artistique Cléo Palacio-Quintin explore le mariage musical de son instrument interactif — l’hyper-flûte — avec différentes combinaisons originales, pour créer des œuvres novatrices qui intègrent les technologies numériques contemporaines. Toujours entourée de complices tout aussi polyvalentes qu’elle — Elin Söderström à la viole de gambe dans le Duo..."
      }
    ],
    "@type": [
      "http://schema.org/PerformingGroup"
    ]
  },
