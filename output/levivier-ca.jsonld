    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/artistes/raven-chacon-0"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Raven Chacon"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Raven Chacon, né en 1977 à Fort Defiance (Arizona), est un compositeur de musique de chambre diné. Également interprète solo de musique bruitiste et artiste d'installation, notamment au sein du collectif Postcommodity de 2009 à 2018, il est le premier autochtone d'Amérique récompensé d’un prix Pulitzer, recevant le prix Pulitzer de musique pour sa composition Voiceless Mass en 2022."
      }
    ],
    "@type": [
      "http://schema.org/PerformingGroup"
    ]
  },
  {
    "@id": "_:g36246220",
    "http://schema.org/url": [
      {
        "@id": "https://quatuorbozzini.ca/fr/"
      }
    ],
    "http://schema.org/sameAs": [
      {
        "@id": "https://quatuorbozzini.ca/fr/"
      },
      {
        "@id": "https://www.facebook.com/quatuorbozzini/"
      },
      {
        "@id": "https://www.instagram.com/quatuorbozzini/"
      },
      {
        "@id": "https://quatuorbozzini-actuellecd.bandcamp.com/music"
      },
      {
        "@id": "https://open.spotify.com/artist/5IRpEZK7VBzlYsJ4aG7z2h"
      },
      {
        "@id": "https://soundcloud.com/quatuor-bozzini"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://quatuorbozzini.ca/fr/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Quatuor Bozzini"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Depuis sa fondation en 1999, le Quatuor Bozzini œuvre dans les domaines des musiques nouvelles, expérimentales et classiques. Ensemble radicalement contemporain, il propulse la scène hyper-créative de Montréal, et au-delà. Il cultive le sens du risque et emprunte résolument les voies moins fréquentées, rejetant d’emblée les idées reçues. Le Quatuor Bozzini se distingue par son «jeu extraordinaire» (Alex Ross, The New Yorker) et construit avec soin un répertoire diversifié qui ne cède jamais à la facilité ou aux modes, donnant lieu jusqu’à maintenant à plus de quatre cents commandes, ainsi qu’à près de cinq cents créations. Chaque concert du Quatuor Bozzini est une expérience partagée avec intensité et présentée dans une atmosphère toujours inspirante.\r\n"
      }
    ],
    "@type": [
      "http://schema.org/PerformingGroup"
    ]
  },
  {
    "@id": "_:g36246240",
