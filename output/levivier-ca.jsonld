    "https://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "La Semaine du Neuf rendra hommage au compositeur québécois Claude Vivier, du 7 au 17 mars 2023 à Montréal. Un rendez-vous qui célébrera en musique et rencontres uniques le répertoire et la vie de ce compositeur de renommée internationale, qui à marqué durablement la création contemporaine en musique."
      }
    ],
