      "http://schema.org/PerformingGroup"
    ]
  },
  {
    "@id": "_:g15253280",
    "http://schema.org/url": [
      {
        "@id": "https://chantslibres.org/en/welcome/"
      }
    ],
    "http://schema.org/sameAs": [
      {
