    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\r\n\r\n\t\r\n\t\t\r\n\t\t\t\r\n\t\t\tAlexander Tchorny (1993*) was born in Kyiv, Ukraine, and studied Piano and Composition at the National Music Academy of Ukraine and Hanns Eisler High School of Music in Berlin. He participated in contemporary festivals such as Kyiv Music Fest, Contrasts Lviv, 2d2n, Mehrlicht, Forum Neue Music, and Crescendo UDK, including the recent opera project at Deutsche Oper Berlin. In addition to contemporary classical music, he composes music for theater, movies, video games, and various media shows staged in the USA, Germany, India, UK, Ukraine, and other countries. Besides his..."
      }
    ],
