    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Hide to show speaks about solitude, but also about synchronizing with others without seeing them; about being observed, choosing to make oneself visible or not, and replacing oneself in multiple ways."
      }
    ],
