    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/artists/pierre-luc-lecours"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Pierre-Luc Lecours"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "en",
        "@value": "Pierre-Luc"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "en",
        "@value": "Lecours"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Pierre-Luc Lecours is a composer and multidisciplinary artist based in Montréal. His artistic practice covers many different mediums and aesthetics, ranging from music to video and performance. His work is characterized by a search for expressiveness in projects exploring an artistic process aimed at drawing relationships between form, format, and content. His influences come as much from the currents of instrumental and electroacoustic contemporary music as from electronic and experimental music. His performances feature everyday objects combined with traditional instrumentation and..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
  {
    "@id": "_:g12204420",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/en/artists/diego-bermudez-chamberland"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/artists/diego-bermudez-chamberland"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Diego Bermudez Chamberland"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "en",
        "@value": "Diego"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "en",
        "@value": "Bermudez Chamberland"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Diego Bermudez Chamberland is a Quebecois sound artist whose work incorporates several creative disciplines including composition, sound, design, installations and live performance.&nbsp;His work is inspired by lived experience, both on a human and musical level. Collaboration is an essential aspect of his artistic practice. He sees it as a way to transcend one's work habits and to bring one’s creations to new horizons. He is also interested in the evocative power of sound and its ability to transport us to an \"elsewhere\".&nbsp;\r\n\r\nHe devotes most of his time to the exploration of his discipline through his many projects. Diego is currently completing a master's degree in electroacoustic composition at the Conservatoire de musique de Montréal.\r\n"
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
