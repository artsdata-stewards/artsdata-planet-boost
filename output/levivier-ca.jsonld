    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Japan native Kimihiro Yasaka is an active pianist, a recording artist as well as an enthusiastic educator. He began his piano studies at the age of twelve in Japan with Ms. Reiko Mizutani, and continued to complete his Master’s degree in Piano Solo Performance under the supervision of Professor Kyoko Hashimoto at the Schulich School of Music at McGill University. During his studies at McGill he received the Yamaha Canada scholarship, the Ellen Ballon Piano Scholarship, Schulich School of Music Award in Memory of Jeffrey Campbell, as well as the Lubka Kolessa Award. During his study, he..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
