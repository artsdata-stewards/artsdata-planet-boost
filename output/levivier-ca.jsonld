      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Bakarlari"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Bakarlari is a collective of soloists dedicated to exploring new sounds and breaking down creative barriers. Bringing together instruments that are not often featured - tuba, trumpet and clarinet - the ensemble's main aim is to expand the contemporary solo repertoire and to encourage close collaboration between composer and performer.\r\n"
      }
    ],
    "@type": [
      "http://schema.org/PerformingGroup"
    ]
  },
