    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Duo AIRS"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le Duo AIRS est un groupe de musique de chambre de musique contemporaine formé de David Therrien Brongo (percussion) et Louis-Philippe Bonin (saxophone). De par ses activités et sa proposition artistique, le Duo AIRS se démarque dans un créneau actuellement non-exploité par les ensembles et solistes actuels au Québec. Leur mandat artistique naît de la volonté de présenter le riche répertoire pour percussion et saxophone, tout en favorisant la recherche et la création d’œuvres nouvelles. Dans une volonté d’offrir une expérience dynamique et différente du récital..."
      }
    ],
    "@type": [
      "http://schema.org/PerformingGroup"
    ]
  },
