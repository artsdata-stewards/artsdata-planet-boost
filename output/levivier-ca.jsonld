    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/concert/saison-2025-26/lovemusic-protest-physical-semaine-du-neuf"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "LOVEMUSIC - PROTEST OF THE PHYSICAL / SEMAINE DU NEUF"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "lovemusic propose une performance musicale dans laquelle les corps des interprètes sont au cœur de l'expérience, devenant des éléments essentiels de la création sonore."
      }
    ],
