  {
    "@id": "_:g3923460",
    "http://schema.org/url": [
      {
        "@id": "https://www.hauptmeier-recker.de/"
      }
    ],
    "http://schema.org/sameAs": [
      {
        "@id": "https://www.hauptmeier-recker.de/"
      },
      {
        "@id": "https://soundcloud.com/paul-hauptmeier/cultural-sounds-hauptmeier-recker-stereomix"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/artistes/duo-hauptmeier-recker"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Duo Hauptmeier-Recker"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "fr",
        "@value": "Duo Hauptmeier-Recker "
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Depuis 2009, les compositeurs Martin Recker (1991) et Paul Hauptmeier (1993) travaillent ensemble en tant que duo d'artistes dans le domaine de l'art sonore et multimédia. Outre des œuvres pour le théâtre et l'opéra, l'électronique en direct, la radio et la musique électroacoustique, ils se concentrent sur les installations sonores dans les espaces publics. Tous deux ont étudié la composition auprès de Robin Minard à la Hochschule für Musik Franz Liszt Weimar. Ils sont cofondateurs du ZiMMT - Center for Immersive Media Art, Music and Technology - à Leipzig.&nbsp;\r\n"
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
