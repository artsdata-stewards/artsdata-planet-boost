    "https://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "2011-12 | Le Vivier"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Third Le Vivier Season: The 2011-12 Line-Up Le Vivier presents its 2011-2012 new music line-up: a third season featuring 20 concerts presented on various stages across Montréal. Twenty Le Vivier member organizations and their artistic directors, performers, and creators have put together a generous line-up for an eventful and extremely diversified season, with transformation as its underlying theme. The Le Vivier Privilege Card (Carte Privilège Le Vivier) opens the doors of Québec new music before you, with 50% off on all 20 regular-season concerts, unique meet-the-artist events, and an exclusive new music guide."
      }
    ],
