    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "L'écoute du perdu"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "In co-production with Musique 3 Femmes and in co-presentation with Le Vivier, Paramirabo will present the world premiere of L'écoute du perdu at the Darling Foundry. This non-narrative, experimental, bilingual chamber opera will feature a major operatic work by Keiko Devaux, winner of the 2022 JUNO Award for Best Composition, and a staging by the renowned Marie Brassard (Siminovitch Prize, 2022). Soloists Sarah Albu, Frédéricka Petit-Homme and Raphaël Laden-Guindon, will perform the work commissioned by Paramirabo, which will aim to present several individual memories, and will question our emotional connection to sound and how we hold sound and music in our memory, what triggers these memories, and how we transform, distort, and ultimately recreate these fragments. This production will be under the musical direction of Jennifer Szeto (M3F), with texts by Kaie Kellough, Daniel Canty and Michaël Trahan\r\n\r\n&nbsp;\r\n"
      }
    ]
  },
