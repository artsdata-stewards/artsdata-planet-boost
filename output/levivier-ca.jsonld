    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Musikfabrik"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "In 2014, the in-house Label Musikfabrik was founded. Exploring forms of modern communication and new possibilities for expression in music and theatre are a focal point. Interdisciplinary projects that include live electronics, dance, theatre, live video, and visual art expand the conventional form of the conducted ensemble concert."
      }
    ],
