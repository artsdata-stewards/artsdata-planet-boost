      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "L'ARSENALE (IT) : NOSFERATU • CINÉ-CONCERT | 11 AVRIL"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Projection du film Nosferatu le vampire, qui fête ses 100 ans, avec musique d’accompagnement\r\n\r\nÀ l’occasion de la visite du quintet italien L’arsenale Ensemble, l’effrayant comte Orlok sortira de son cercueil au son de la musique de Filippo Perocco.\r\n"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2022-04-11T23:30:00-04:00"
      }
    ]
  },
