    "https://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Celebrating the 60th birthday of Franco-Argentine composer Luis Naón, Stick&Bow and Ensemble Paramirabo join forces for an immersive evening at the heart of the creative universe of this multi-faceted artist. An evening of wandering that will charm both contemporary music enthusiasts and neophytes alike, thanks to Naón’s varied language and rhythmic style."
      }
    ],
