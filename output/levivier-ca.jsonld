    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Justin Saulnier is a 17-year-old violinist from Orléans, Ontario. He was the recipient of the Lloyd Carr-Harris String Scholarship to attend McGill University Schulich School of music and is currently pursuing his undergraduate degree in violin performance with Andrew Wan.&nbsp;\r\n\r\nHe was the concertmaster of Canada’s National Youth Orchestra for their 2022 season. He is also the former concertmaster of the Ottawa Chamber Orchestra and the Ottawa Youth Orchestra. He has also shared the stage with the National Arts Centre Orchestra, Thirteen Strings, the Ottawa Pops Orchestra, and the..."
      }
