    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/artistes/membres/organismes/andrew-gray"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Andrew Gray"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "fr",
        "@value": "Andrew"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "fr",
        "@value": "Gray"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Arrivé à Montréal en 2010, Andrew Gray s’est rapidement fait connaître sur la scène régionale en tant que chef de chœur et répétiteur. En plus d’être directeur artistique du Chœur des enfants de Montréal et du projet choral Sing Montréal Chante, chef de chœur adjoint à l’église Saint-Andrew and Saint-Paul et directeur général du Chœur Saint-Laurent, il assume depuis le 1er juillet 2015 la direction artistique à la fois de l’Institut choral de Montréal et de Voces Boreales, l’ensemble vocal qui lui est rattaché, et vient d’être nommé directeur musical et..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
