      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Composer based in Montreal, Alexis Blais (he/him) is currently beginning his master’s degree with Ana Dall’Ara-Majek at University of Montreal. His research focuses on the continuum between the language of instrumental and electroacoustic musics. Trained as a classical pianist, his acousmatic work is based on a plastic and textural research on modal harmonies.\r\n"
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
