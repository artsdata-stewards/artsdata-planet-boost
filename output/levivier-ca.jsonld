    "https://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Quasar: Montréal/Munich | Le Vivier"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "With Montréal-Munich, Quasar continues its series of collaborations celebrating the richness of international exchanges and encounters. Following several creative residencies in Quebec and Bavaria bringing together the four saxophonists of Quasar with composers Francis Battah, Philipp C. Mayer, Maxime McKinley, Florence M. Tremblay, Alexander Strauch, and Abigél Varga, this concert offers the Montreal public a preview of six new creations that will then be performed again in Munich, at the aDevantgarde festival in the summer of 2025. True 'carte blanche' commissions, these new works give free rein to innovative, diverse, and unrestricted creative paths."
      }
    ],
