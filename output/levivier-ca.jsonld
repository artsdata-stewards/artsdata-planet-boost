    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Louis-Philippe BONIN holds a master’s degree (M.MUS) from the University of Montreal. After finishing his curriculum in Montréal, he took extensive courses with Timothy McAllister, University of Michigan, where he undertook a specialist degree in saxophone performance . He attends numerous events such as the World Saxophone Congress (France, Scotland), the Jean-Marie Londeix International Saxophone Competition (Thailand), the Saxophone European University (France) and the Arosa Saxophone Course (Switzerland) where he raffined his knowledge on the saxophone repertoire and pedagogy with..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
  {
    "@id": "_:g13723640",
