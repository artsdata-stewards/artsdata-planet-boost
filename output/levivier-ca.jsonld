    ],
    "https://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Klaus Janek + Andy Graydon | Le Vivier"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Since 2011, Klaus Janek and Andy Graydon have been involved in a series of joint projects with various collaborators. Since 2021, they have focused more on their work as a duo. Due to the geographical and temporal distances separating them, this collaboration takes the form of conversations with oneself and the other in resonance, both mutually developing semantics, metaphors, and states of consciousness that gently oscillate. Their concerts in North America conclude a two-year collaborative process of composition, creation, and reflection, a process that extends into the present."
      }
    ],
