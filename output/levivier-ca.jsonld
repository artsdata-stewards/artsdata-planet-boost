  {
    "@id": "_:g15690140",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/en/le-vivier/repertoire/fishbones"
      }
    ],
    "http://schema.org/datePublished": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2007"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Fishbones"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/le-vivier/repertoire/fishbones"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "en",
        "@value": "\"The sounds that glide through the air carry a certain nostalgia, solitude, anxiety... they sound like human voice! The submerged percussion instruments drown us in an aquatic sonority that crescendo becomes a metallic roar. The cynic idea of fishy life cycle came to me while I was sophisticating this piece, a life that begins with an egg hatching in the ocean freely to end up in a form of pressurized canned food.\" - O. Adamek\r\n"
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
