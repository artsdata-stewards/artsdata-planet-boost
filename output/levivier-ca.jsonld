  {
    "@id": "_:g14225360",
    "http://schema.org/url": [
      {
        "@id": "http://www.timbrady.ca/"
      }
    ],
    "http://schema.org/sameAs": [
      {
        "@id": "http://www.timbrady.ca/"
      },
      {
        "@id": "https://www.facebook.com/bradyworks"
      },
      {
        "@id": "https://www.instagram.com/_bradyworks_"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "http://www.timbrady.ca/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Bradyworks / Instruments of Happiness"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "“Bradyworks” was created in 1989 as the production team for composer and guitarts Tim Brady. In 2014 brady created the electric guitar collective “Instruments of Happiness” , which includes a quartet, and ensembles of 20 and 100 guitars, the latter used for large-scale spatialized performance. Their first CD - Instruments of Happiness - was released on the American label Starkland Records in March 2016, to excellent reviews. Their 100 and 20 guitar projects continue to play to sold-out houses across Canada, with concerts in Montreal and St. John's, a 100-guitar concert in Vancouver at the Modulus Festival in November 2016, and a new creation (homage to Jimi Hendrix) presented in Montreal in April 2017. Their first Canadian tour, with the IoH quartet, presented 8 concerts across the country in late March/early April 2017. 2018 saw a feature performance for 100 guitars at Toronto's Luminato, and a Canadian tour with singer Marie-Annick Béliveau. 2019 pulled out all the stops with their 2nd CD - The Happiness Handbook, a US tour and a massive 150-guitar event in Montréal to an audience of 3,200 people at the Festival MNM. Their CD \"The Happiness Handbook\" was awarded a Gold Medal by the Global Music Awards In the United States in August 2019, as well as a Prix Opus in Québec in January 2020.\r\n"
      }
    ],
    "@type": [
      "http://schema.org/PerformingGroup"
    ]
  },
  {
    "@id": "_:g14225500",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/en/le-vivier/repertoire/o-sacrum-convivium"
      }
    ],
    "http://schema.org/datePublished": [
      {
        "@type": "http://schema.org/Date",
        "@value": "1937"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "O Sacrum Convivium"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/le-vivier/repertoire/o-sacrum-convivium"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "en",
        "@value": "O Sacrum Convivium was written by Olivier Messiaen in 1937 for four-part mixed chorus. Several iterations of the work came to be, including an optional organ accompaniment and a version for solo soprano and organ, before being officially listed as a piece for mixed chorus a cappella in 1986. Arranged by Lacopo for electric guitar in 2020, this version uses the extended range guitar and electronic processing to re-create the grandiose world of this piece. From octave pitch shifters for added density, chorus modulation for subtle de-tuning effects, and granular delays to replicate..."
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
  {
    "@id": "_:g14225540",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/en/le-vivier/repertoire/after-dark"
      }
    ],
    "http://schema.org/datePublished": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2023"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "After Dark"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/le-vivier/repertoire/after-dark"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "en",
        "@value": "After Dark is inspired by Haruki Murakami’s novel of the same title. In this story, Murakami builds a surrealist world suspended between fantasy and reality. To replicate the atmosphere of a constantly morphing sleeping city, After Dark presents a conversation between a layer of un-effected guitar and a layer of effected guitar processing through two distinct guitar pedals: the Hologram Electronics Microcosm and the Chase Bliss MOOD. The MOOD is a really special multi-effect guitar pedal; it has two channels that are aware of each other and work together to morph melodic material. After..."
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
  {
    "@id": "_:g14225580",
