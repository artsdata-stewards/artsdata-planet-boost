    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Horse Notations"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/fr/le-vivier/repertoire/horse-notations"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "en",
        "@value": "Horse Notations (2019) a été composé à la demande de l'Oregon East Symphony pour être créé dans les terres ancestrales des tribus confédérées de la réserve indienne d'Umatilla. La composition s'inspire d'un article du Popular Science Journal de 1874 intitulé « The Paces of the Horse » (Les pas du cheval) et de son analyse des pas du cheval – le pas, le trot, le galop et le grand galop – comme source d'inspiration pour les rythmes, les motifs de batterie, les pressions de l'archet et les courbes de volume. Les représentations graphiques de l'article apparaissent dans la..."
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
