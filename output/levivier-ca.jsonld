    "https://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Journées de la culture - Orchestre d'un après-midi | Le Vivier"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Whether you're a musician for a day or a lifetime, a singer in the shower or an experienced soloist, if the treble and bass clefs have no secrets for you or if you don't know how to read a note, bring your instrument or an object that doesn't seem to make a sound (saucepans, metal bowls or teaspoons accepted!), or your voice and take part in this UNBELIEVABLE collective musical activity!"
      }
    ],
