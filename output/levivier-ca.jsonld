  {
    "@id": "https://levivier.ca/en/concert/2024-25-season/sixtrum-cordame-i-am-vertical",
    "https://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Le Vivier"
      }
    ],
    "https://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "article"
      }
    ],
    "https://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/concert/2024-25-season/sixtrum-cordame-i-am-vertical"
      }
    ],
    "https://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Sixtrum & Cordâme / I am vertical | Le Vivier"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Inspired by the poetry of Sylvia Plath, \"I Am Vertical\" brings together the ensembles Sixtrum and Cordâme in an unprecedented encounter of percussion, voice, and strings. Jean Félix Mailloux's compositions, brought to life by the voice of Coral Egan, give voice to Plath's words, inviting the audience on an intimate exploration of the human emotions.Composed of multi-talented virtuosos, the percussion ensemble Sixtrum constantly renews its universe by confronting other disciplines and artistic genres. Each of the group's collaborations aims to find new forms of expression and original ways 1 to touch the audience. Led by the prolific composer and double bassist Jean Félix Mailloux, Cordâme is a Montreal chamber music ensemble that explores the sounds of strings, on the borders of classical and jazz. The ensemble offers emotionally charged concerts thanks to its subtle and sensitive music."
      }
    ],
    "https://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/sites/default/files/evenements/sixtrum_WeB_1500x1500.jpg"
      }
    ],
