    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Quasar & Stockholm Saxophone Quartet / SAXOCTET "
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Quasar célèbre son 30e anniversaire aux côtés du célèbre Stockholm Saxophone Quartet. Après des collaborations fructueuses en 2019 et 2021, les 8 saxophonistes-virtuoses sont de retour avec un nouveau programme qui sera également joué 3 fois en Suède. Outre deux nouvelles œuvres commandées à Gordon Williamson (CA) et Martina Tomner (SE), Quasar saisit l'occasion de rendre hommage au regretté José Evangelista en présentant son Saxoctet.&nbsp;"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2024-10-24T23:30:00-04:00"
      }
    ]
