    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/concert/2025-26-season/architek-percussion-contrechamps-kino-sonique-semaine-du-neuf"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "ARCHITEK PERCUSSION & CONTRECHAMPS - KINO-SONIQUE / SEMAINE DU NEUF"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Between repurposed technologies, digital avatars and everyday objects, this triptych explores the many faces of contemporary sound.&nbsp;Daniel Zea offers a performance for facial recognition in which the digital avatar reveals the tensions between human expression and algorithm. Nicole Lizée, meanwhile, brings the machines of the past back to life in a quadraphonic creation in which glitch becomes poetic material. Finally, Alexandre Babel overturns sound hierarchies by sculpting the raw beauty of ‘poor’ sounds, derived from found objects and simple gestures.Three works that, each in their own way, question our relationship with technology, memory and imperfection — and redefine the boundary between human, machine and matter.&nbsp;"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-03-01T23:00:00-05:00"
      }
    ]
  },
