    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Alexandre David (1989; Montréal, Canada) is a French Canadian composer, performer, teacher and radio presenter currently based in Montréal. His projects revolve around his various interests: transdisciplinarity, sociology and musical semiology, often in close collaboration with artists from various origins. Inspired by the traduction and transformation of extra-musical sources to a musical form, he is interested in the listener’s perception towards musical objects and the meaning they can convey.\r\n\r\nHis catalog includes more than 40 works for orchestra, chamber ensemble, choir, soloist..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
