    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Niels Lyhne Løkkegaard"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "en",
        "@value": "Niels"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "en",
        "@value": "Lyhne Løkkegaard"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Since 2012 Niels Lyhne Løkkegaard has experimented with multiplying instruments in attempts of making the sound of the instruments transcend their inherent sonic norms and reappear in another form. The multiplication brings out timbral phenomena, interference of sound waves and vibrations, and brings out what Niels Lyhne Løkkegaard calls the sound’s potential of transformation. He describes this as the quality in a musical piece, when you no longer hear recognizable instruments, but instead the individual sound, as well as the individual musician, is dissolved into the collective sound...."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
  {
    "@id": "_:g13055820",
