    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The Voces Boreales choir presents the masterpiece of the Russian choral repertoire - Rachmaninov's magnificent Vespers - punctuated by a world premiere triptych created especially for the ensemble by the Russian-Canadian composer Evgeny Shcherbakov. A fervent concert that offers an almost mystical experience, combining the Russian soul in the past and present.\r\n"
      }
    ],
