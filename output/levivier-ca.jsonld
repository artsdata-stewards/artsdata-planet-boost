    ],
    "http://schema.org/familyName": [
      {
        "@language": "en",
        "@value": "Rachmaninov"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Sergei Vasilyevich Rachmaninoff was a Russian composer, virtuoso pianist, and conductor. Rachmaninoff is widely considered one of the finest pianists of his day and, as a composer, one of the last great representatives of Romanticism in Russian classical music. Early influences of Tchaikovsky, Rimsky-Korsakov, and other Russian composers gave way to a thoroughly personal idiom notable for its song-like melodicism, expressiveness and rich orchestral colours. The piano is featured prominently in Rachmaninoff's compositional output and he made a point of using his skills as a performer to..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
