    "https://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "JOANE HÉTU : ELLE A SON MOT À DIRE | Le Vivier"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Joane Hétu offers a mini-cabaret with a Dadaist character which revolves around new creations as well as known and unknown songs and re-orchestrated texts. The musicians appropriate Joane Hétu's words to make them resonate and catapult them into a whimsical universe that mixes love talk, speech and phonetic delirium. So, what will be that word?"
      }
    ],
