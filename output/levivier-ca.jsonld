      "http://schema.org/Person"
    ]
  },
  {
    "@id": "_:g13692600",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/en/le-vivier/repertoire/string-quartet-no-2-three-busy-monsters"
      }
    ],
    "http://schema.org/datePublished": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2023"
      }
    ],
    "http://schema.org/composer": [
      {
        "@id": "_:g13692620"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "String Quartet No. 2 “Three Busy Monsters”"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/le-vivier/repertoire/string-quartet-no-2-three-busy-monsters"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "en",
        "@value": "Afreely written chorale in one movement, where the chords are divided over three axes of intonation. The quartet plays in pairs so that the melodic, repeating clouds of chord sequences can be “hocketed” over these three axes. Each axis received a name—they are Jeff, Elon and Richard.\r\n"
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
  {
    "@id": "_:g13692640",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/en/le-vivier/repertoire/we-are-all-clouds-masquerading-knights"
      }
    ],
    "http://schema.org/datePublished": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2023"
      }
    ],
    "http://schema.org/composer": [
      {
        "@id": "_:g13692660"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "We are all but clouds, masquerading as a knights"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/le-vivier/repertoire/we-are-all-clouds-masquerading-knights"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "en",
        "@value": "Are we nothing but fluff with idiosyncratic shapes? Or are we what we suppose ourselves to be… This piece is loosely inspired by a character from Italo Calvino’s story, The Nonexistent Knight, named Raimbaut, whose youthful folly I wish to celebrate. I have written this music with a similar character in mind — sometimes it digresses… sometimes it can’t make up its mind… but regardless, it chases its passions.\r\n"
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
  {
    "@id": "_:g13692680",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/en/le-vivier/repertoire/string-theory"
      }
    ],
    "http://schema.org/datePublished": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2023"
      }
    ],
    "http://schema.org/composer": [
      {
        "@id": "_:g13692700"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "String Theory"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/le-vivier/repertoire/string-theory"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "en",
        "@value": "String Theory is dedicated to composer Alex Jang, who supports me at every step of this journey towards understanding hidden connections, towards understanding the whole of simultaneity (both in music and in the world).\r\n\r\nString Theory is a concept from physics which predicts the existence of additional dimensions in nature (parallel universes, if you will) and which claims that matter is composed of energy filaments connecting everything (strings), rather than isolated point-like particles.\r\n\r\nThe following piece similarly presents three distinct musical worlds in one: a medieval..."
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
  {
    "@id": "_:g13692720",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/en/le-vivier/repertoire/cinq-pieces-pour-quatuor-cordes-five-pieces-string-quartet"
      }
    ],
    "http://schema.org/datePublished": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2023"
      }
    ],
    "http://schema.org/composer": [
      {
        "@id": "_:g13692740"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Cinq pièces pour quatuor à cordes [Five pieces for string quartet]"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/le-vivier/repertoire/cinq-pieces-pour-quatuor-cordes-five-pieces-string-quartet"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "en",
        "@value": "My Cinq pièces pour quatuor à cordes [Five pieces for string quartet] explore the idea of a “rhythmic cubism”, where each new motivic fragment suggests a different temporal point of view, by making heard a polyrhythmic relation with the previous fragment. These pieces are generally not conceived from a common metric grid, but only on temporal relations between different voices, in a way similar to harmonic relations produced just intonation techniques. This structural conception make use of the relative character of rhythm notation and perception: a tempo can be heard as a main —or..."
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
