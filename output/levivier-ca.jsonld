    "https://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "SPIESSER / FLASHBACK : SCULPT (CH/FR) | 12 APRIL | Le Vivier"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Alone on stage, the performer Philippe Spiesser plays invisible percussion instruments. With his hands, his body, his gestures, he sculpts sounds and images and invites the audience to an exploration of gesture in music as an instrument. Thanks to various sensor devices and computer vision algorithms, the body is transformed into an instrument. A technical and scenic performance that projects us into the world of virtual reality."
      }
    ],
    "https://ogp.me/ns#image": [
