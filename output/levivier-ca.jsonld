  {
    "@id": "_:g3611200",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/fr/artistes/peyee-chen"
      }
    ],
    "http://schema.org/sameAs": [
      {
        "@id": "https://www.instagram.com/peyeepeyee/?hl=fr"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/artistes/peyee-chen"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Peyee Chen"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "fr",
        "@value": "Peyee"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "fr",
        "@value": "Chen"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Interprète “omnivore\", la soprano Peyee Chen aime autant chanter Monteverdi avec le luth et la basse de viole que Bernhard Lang avec l'électronique et la basse électrique. Elle s'intéresse également à l'improvisation et aux instruments électroniques bricolés, ainsi qu'aux installations et à la performance.&nbsp;\r\n\r\nElle s'est produite en tant que soliste à la Philharmonie de Paris, à la Biennale de Munich, à la Pierre Boulez Saal, au Konzerthaus Berlin, au Huddersfield Contemporary Music Festival, au Lucerne Festival, à l'Adelaide Festival, au Spitalfields Festival, au Big..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
