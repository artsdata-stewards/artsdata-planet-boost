        "@value": "MONTRÉAL-HANOVRE (QUASAR + FLEX) | 15 AVRIL"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Deux quatuors montréalais à la réputation solidement établie – Quasar quatuor de saxophones et le Quatuor Bozzini – engagent un dialogue innovant avec deux brillants ambassadeurs de la musique nouvelle allemande, Flex Ensemble et ur.werk.\r\n"
      }
    ],
