    "https://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Alla Zagaykevych portrait // VivierMix | Le Vivier"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "In solidarity with Ukrainian artists, Le Vivier has invited Alla Zagaykevych to a residency for the 22-23 season. Enter the musical universe of the Ukrainian composer and let yourself be immersed in her works that subtly mix instrumental music and electronics. Alla Zagaykevych's music, inspired by poetry, suggests enchanting atmospheres. In this concert curated by the composer, the Nouvel Ensemble Moderne, the Productions SuperMusique, Paramirabo, and Chants Libres will perform works from her catalogue."
      }
    ],
