    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/artists/ensemble-supermusique"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Ensemble SuperMusique"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Founded in 1998, the Ensemble SuperMusique (ESM) is directed by Joane Hétu and Danielle Palardy Roger. This variable-geometry ensemble, entirely devoted to the interpretation of contemporary music and improvisation, is one of the rare ensembles whose repertoire consists exclusively of contemporary music. The ESM is made up of the most prominent instrumentalists and composers of Montreal's vibrant contemporary music scene. Since its foundation, the ESM has commissioned more than 50 works that combine written music and improvisation. The Montreal record company DAME has released several of its recordings.\r\n"
      }
    ],
    "@type": [
      "http://schema.org/PerformingGroup"
    ]
  },
