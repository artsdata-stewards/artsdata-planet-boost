      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le Nouvel Ensemble Moderne et L’arsenale Ensemble s’unissent le temps d’un concert pour dérouler le tapis rouge à la création d’avant-garde italienne. Au programme, de grands noms de la musique contemporaine comme Silvia Borzelli, Alessandro Solbiati, Stefano Trevis et Keiko Devaux.\r\n"
      }
    ],
