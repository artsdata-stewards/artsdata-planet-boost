    ],
    "http://schema.org/givenName": [
      {
        "@language": "en",
        "@value": "Sabrina"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "en",
        "@value": "Dupuis"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Originaire de Moncton (Nouveau-Brunswick, Canada), Sabrina Dupuis est diplômée du programme préprofessionnel de l’école DansEncorps en 2018. Elle y reçoit aussi une formation d’enseignement en danse lui permettant d’enseigner les bases en jazz/hip-hop, en contemporain et en classique.\r\nBoursière du Conseil des arts du Nouveau-Brunswick, elle s’installe à Montréal la même année afin de poursuivre sa formation professionnelle en danse à l’École de danse contemporaine de Montréal. Durant son parcours, elle collabore avec des chorégraphes tels que Pierre-Marc Ouellette,..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
  {
