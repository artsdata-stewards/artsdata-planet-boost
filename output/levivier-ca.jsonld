    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/artistes/carmine-emanuele-cella"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Carmine Emanuele Cella"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "fr",
        "@value": "Carmine Emanuele"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "fr",
        "@value": "Cella"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Compositeur et chercheur, Carmine-Emanuele Cella travaille sur les relations entre mathématique et musique. Diplômé du conservatoire G. Rossini de Pesaro en piano, informatique musicale et composition, il obtient ensuite un Master en composition de l’Académie Sainte Cécile de Rome avec Azio Corghi. Il étudie en outre la philosophie et les mathématiques et obtient un doctorat de logique mathématique à l’Université de Bologne avec sa thèse intitulée On Symbolic Representations of Music (2011).\r\n\r\nPour ses compositions, Carmine-Emanuele Cella reçoit plusieurs prix, parmi..."
      }
    ],
