    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "CONCERT VIVIER INTERUNIVERSITAIRE"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The 7th annual Vivier InterUniversitaire (ViU) concert will present unusual and innovative works for instrumental, mixed and electroacoustic music. They are all composed and performed by some of the brightest members of the emerging generation of composers and performers from the Université de Montréal, McGill, Concordia and the Conservatoire de musique de Montréal.\r\n"
      }
    ],
