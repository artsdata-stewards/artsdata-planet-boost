    "http://schema.org/familyName": [
      {
        "@language": "en",
        "@value": "(Roxanne Turcotte)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Productions RTM is a musical enterprise dedicated to contemporary sound art, electroacoustic and acousmatic music, as well as to performance on stage and on disc. It also works in research and pedagogy, as well as in the presentation of creation workshops for young and old. Roxanne Turcotte is the founder and works with independent collaborators in her personal studio, Studio Séducson on the Island of Montreal.\r\n"
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
