    ],
    "http://schema.org/familyName": [
      {
        "@language": "en",
        "@value": "D’Orion"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Érick d’Orion est un musicien autodidacte et est aussi co-fondateur du collectif de diffusion de spectacles Machines: abstractions sonores électroniques. Son travail est centré sur l’improvisation bruitiste à l’aide d’instruments électroniques. Cofondateur en 1995, avec A_dontigny, du collectif radio Napalm Jazz, il s’intéresse depuis à l’intégration totale des méthodes concrètes et urbaines en musique électronique avec le projet morceaux_de_machines. C’est avec ce duo qu’Érick d’Orion est le plus actif musicalement avec un album sur l’étiquette..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
