    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Carl Ludwig Hübsch"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "en",
        "@value": "Carl Ludwig"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "en",
        "@value": "Hübsch"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Carl Ludwig Hübsch (born 1966) is a German jazz and improvisation musician, renowned for his mastery of the tuba and his original compositions. A self-taught tuba player, he studied musicology, philosophy, and art history. He has collaborated with renowned ensembles and musicians such as the Vienna Art Orchestra and the Globe Unity Orchestra. His discography includes critically acclaimed albums, such as \"Lumière\", \"Not Even\", and \"Orbiting and Module Modulations\". A recipient of several awards, he is considered an innovative and influential jazz tuba player in Germany."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
