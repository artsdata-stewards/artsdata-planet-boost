      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "en",
        "@value": "Hayes"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "During the latter half of the twentieth century I feel modern music has deteriorated into free atonalism and minimalism, both of which I reject. However, I feel these developments are indicative of what has happened to the idea of modernism in general.\r\n\r\nPaul Hayes was born in Dublin and studied composition at the Royal Irish Academy of Music with James Wilson and at University College Dublin with Seóirse Bodley.\r\n\r\nHe has written works for a wide variety of media and has a particular interest in live electronics, music theatre, ballet and modern dance. He has fulfilled commissions for..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
