      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Une rencontre entre l’émergence québécoise et un ensemble phare de la Suisse autour de l'œuvre de Chiyoko Szlavnics.À travers un travail sur l’intonation juste et un placement immersif des musicien·nes, Chiyoko Szlavnics mélange les sonorités instrumentales au niveau moléculaire et crée ainsi une forme de mobile sonore suspendu dans l’espace.&nbsp;"
      }
    ],
