    ],
    "https://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Misceo | Le Vivier"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Duo AIRS (Louis-Philippe Bonin on saxophone and David Therrien Brongo on percussion) and violist Marina Thibeault join together for a concert featuring an eclectic repertoire of contemporary music drawn from various folklores, with pieces by Iannis Xenakis, George Aperghis and Luciano Berio, and creations by Ana Sokolović and Anishinaabe artist Melody McKiver."
      }
    ],
    "https://ogp.me/ns#image": [
