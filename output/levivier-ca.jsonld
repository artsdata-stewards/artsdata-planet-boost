  {
    "@id": "_:g3756380",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/fr/artistes/julie-trudeau"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/artistes/julie-trudeau"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Julie Trudeau"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "fr",
        "@value": "Julie"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "fr",
        "@value": "Trudeau"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Julie Trudeau entreprend ses études de violoncelle à Sherbrooke et les poursuit à Montréal auprès du réputé Walter Joachim. Bachelière en interprétation de la musique de l’Université de Sherbrooke, elle obtient, en 1994, une bourse d’études du Conseil des arts et des lettres du Québec lui permettant de poursuivre un stage de perfectionnement auprès du violon­celliste Philippe Muller, professeur au Conservatoire National Supérieur de Musique de Paris. De 2000 à 2007, elle est membre du Quatuor Molinari. Cette formation de chambre lui a permis de donner des concerts en..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
  {
    "@id": "_:g3756400",
    "http://schema.org/url": [
      {
        "@id": "https://www.brigittepoulin.ca/"
      }
    ],
    "http://schema.org/sameAs": [
      {
        "@id": "https://www.brigittepoulin.ca/"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/artistes/brigitte-poulin"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Brigitte Poulin"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "fr",
        "@value": "Brigitte"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "fr",
        "@value": "Poulin"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "La pianiste montréalaise Brigitte Poulin est reconnue autant comme soliste, chambriste, qu’accompagnateure et pédagogue. Son répertoire englobe toutes les époques: de l’invention du piano jusqu’à sa déconstruction. Partisane de la musique des 20e et 21e siècles, elle a commandé et créé plus d’une trentaine d’œuvres pour piano seul, piano préparé et différents ensembles de musique de chambre. Elle a joué avec Bradyworks, Chants libres, Continuum, l’Ensemble contemporain de Montréal, l’Orchestre Symphonique de Montréal, la Société de musique contemporaine du..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
