    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Daniel Áñez is a pianist based in Montreal, specialized in Latin-American contemporary repertoire. His work as a chambrist and soloist has taken him to play in more than 15 countries of the Americas and Europe, and he has participated in the world premiere of more than 50 works. He is also an Ondes Martenot and a synthesizer performer. He is the co-founder of the concert series No Hay Banda and is a member of the Editorial Board of Circuit Magazine. He has a doctorate from the University of Montreal in piano performance.\r\n"
      }
