    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Québec Musiques Parallèles #JOUR2"
      }
    ],
    "http://schema.org/alternateName": [
      {
        "@language": "en",
        "@value": "QMP: New music and sound practices"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Québec Musiques Parallèles (QMP) brings together artists, producers, venues and presenters working on the fringes of the industry, and links the regions and major centres. They offer original and promising programming based on experimentation and collaboration in order to discover new musical and sound practices and to promote local creative music in all regions of Quebec. &nbsp;#3 •&nbsp;15H |&nbsp;Québec Musiques Parallèles&nbsp;Noorg + Bélinda Campbell + Alexandre St-Onge#4 •&nbsp;20H |&nbsp;Québec Musiques Parallèles&nbsp;Camille Émaille + Erikm&nbsp;"
      }
    ]
  },
