        "@language": "fr",
        "@value": "https://levivier.ca/fr/concert/saison-2021-22/severine-ballon-fr-13-avril"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "SÉVERINE BALLON (FR) | 13 AVRIL"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Artiste profondément engagée dans le répertoire moderniste, Séverine Ballon repousse les frontières de l’expressivité du violoncelle, qui ne sonne plus comme un violoncelle. Dans un concert où la technique instrumentale et la pureté du son servent une exploration résolument libre de l’instrument, la violoncelliste et compositrice livre quatre œuvres fortes de Philippe Leroux, Liza Lim, Thierry Blondeau et une ses propres compositions.\r\n"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2022-04-13T22:00:00-04:00"
      }
    ]
  },
