  {
    "@id": "_:g1357360",
    "@type": [
      "http://schema.org/MusicEvent"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/en/concert/2025-26-season/architek-percussion-contrechamps-kino-sonique-semaine-du-neuf"
