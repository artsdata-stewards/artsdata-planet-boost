    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/concert/saison-2024-25/la-semaine-du-neuf-festival-des-musiques-de-creation-3e-edition"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "LA SEMAINE DU NEUF — Festival des musiques de création - 3e édition"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le Vivier présente la troisième édition de La Semaine du Neuf!La Semaine du Neuf offre un panorama des nouveaux horizons de la musique de création, à travers une programmation éclectique et festive qui s’aventure de la musique acousmatique à l'opéra contemporain, en passant par des expérimentations sonores débridées.&nbsp;Placée sous le signe de la création, cette édition met à l'honneur la diversité des processus créatifs, avec des concerts, des performances multidisciplinaires et des installations sonores.La Semaine du Neuf se tiendra du 8 au 16 mars 2025 dans plusieurs lieux emblématiques à Montréal, dont l'Édifice Wilder, le CIRMMT et &nbsp;La Chapelle Scènes contemporaines.&nbsp;&nbsp;"
      }
    ]
  },
