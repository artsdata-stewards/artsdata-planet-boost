    ],
    "http://schema.org/givenName": [
      {
        "@language": "en",
        "@value": "Ayam"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "en",
        "@value": "Yaldo"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Ayam Yaldo is an interdisciplinary artist based in Montreal. She holds a Bachelor of Fine Arts and a Masters degree in Studio Arts in the department of Intermedia from Concordia University. Yaldo works in a wide range of media including video, performance, voice and storytelling, ceramic sculpture and installation. She explores concepts of reconstruction, transformation and ephemerality, in relation to forms of displacement. She will be in residence at the Darling Foundry artist studios in 2023-2026.\r\n"
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
  {
