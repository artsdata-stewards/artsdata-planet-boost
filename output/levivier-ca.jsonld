    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Centre d'expérimentation musicale (CEM)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Fondé en 1980, Le Centre d’expérimentation musicale (CEM) a pour mission le développement du milieu des musiques nouvelles et émergentes au Saguenay. Par ses activités de création, de production, de diffusion et de formation, le CEM assure un soutien professionnel aux créateurs dans un contexte favorisant la recherche et l’exploration musicale. Véritable laboratoire où l’hybridation des styles occupe le devant de la scène, le travail artistique du CEM abolit les frontières entre le rock d’avant-garde, l’électronique, le jazz, la musique contemporaine, la chanson, le..."
      }
    ],
