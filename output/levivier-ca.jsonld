      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "LA SEMAINE DU NEUF · Hommage à Claude Vivier"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "La Semaine du Neuf rendra hommage au compositeur québécois Claude Vivier, du 7 au 17 mars 2023 à Montréal. Un rendez-vous qui célébrera en musique et rencontres uniques le répertoire et la vie de ce compositeur de renommée internationale, qui à marqué durablement la création contemporaine en musique.\r\n"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2023-03-07T05:00:00-05:00"
      }
    ]
  },
