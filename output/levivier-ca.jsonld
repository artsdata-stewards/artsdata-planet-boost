    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Dans le cadre de la résidence de la compositrice ukrainienne Alla Zagaykevych au Vivier. Présentation et première lecture d’une toute nouvelle œuvre écrite pour le NEM, avec la participation d’Alla Zagaykevych, sous la direction musicale de Lorraine Vaillancourt."
      }
