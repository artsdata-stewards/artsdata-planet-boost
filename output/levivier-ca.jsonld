    ],
    "http://schema.org/familyName": [
      {
        "@language": "en",
        "@value": "Sciarrino"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "In his youth, Sciarrino was attracted to the visual arts, but began experimenting with music when he was twelve. Though he had some lessons from Antonino Titone and Turi Belfiore, he is primarily self-taught as a composer. In 1969 he moved to Rome, where he attended Franco Evangelisti’s course in electronic music at the Accademia di Santa Cecilia (Osmond-Smith 2001).\r\n\r\nIn 1977, Sciarrino moved from Rome to Milan, where he taught at the conservatory until 1982. By this time his compositional career had expanded to the point where he could withdraw from teaching, and he moved to Città di..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
