  {
    "@id": "_:g34515440",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/fr/le-vivier/repertoire/adherence"
      }
    ],
    "http://schema.org/datePublished": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2024"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Adherence"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/le-vivier/repertoire/adherence"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "fr",
        "@value": "Adherence a été écrit vers la fin d’une période où nombre de mes œuvres étaient influencées par les principes d’organisation musicale de la période médiévale européenne, en particulier par des techniques telles que l’isorythmie et le cantus firmus. Comme la plupart de mes œuvres, Adherence est une composition purement procédurale, où les processus en jeu dans le matériau musical sont étroitement contrôlés et rigoureusement planifiés à l’avance. Adherence contient une seule ligne mélodique, utilisant la base familière des hauteurs dérivées presque..."
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
