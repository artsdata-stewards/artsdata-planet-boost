      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "RÉSONANCE CROISÉE • VOLET #2 | 11 ► 16 AVRIL"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le second volet de l’événement Résonance croisée propose huit concerts réunissant certains des plus grands noms internationaux des musiques nouvelles : L’arsenale Ensemble, sous la direction de Filippo Perocco (Italie), le percussionniste Philippe Spiesser (Suisse/France), la violoncelliste et compositrice Séverine Ballon (France), le Duo Doblinger/Neyrinck (Autriche), les artistes Hauptmeier-Recker et les ensembles Urwerk et Flex (Allemagne), ainsi que le Quatuor Bozzini, Quasar – quatuor de saxophones et le Nouvel Ensemble Moderne (Québec).&nbsp;\r\n"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2022-04-11T23:30:00-04:00"
      }
    ]
  },
