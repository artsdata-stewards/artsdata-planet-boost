    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/concert/2025-26-season/paramirabo-bad-trip"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Paramirabo — Bad Trip"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "A sonic overdose of distortion, psychedelia, and raw electricity.&nbsp;Professor Bad Trip is Fausto Romitelli’s cult masterpiece, part hallucination, part manifesto. Fusing spectralism with the chaos of rock, Romitelli crafts a world where delicate melodies melt into noise, time contracts, and sound mutates. Inspired by mescaline visions and digital overload, this is music that doesn’t evolve, it implodes.Brace yourself for a wild ride through glitchy beauty and glorious disintegration. This is the sound of a bad trip you won’t want to miss.&nbsp;"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-09-17T00:00:00-04:00"
      }
    ]
  },
  {
