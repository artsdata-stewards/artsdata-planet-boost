    "https://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Chants Libres - Fantôme de Roy | Le Vivier"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Chants Libres presents Fantôme de Roy, a mesmerizing musical theater piece about the legendary conflict between King Henry II Plantagenêt and his chancellor Thomas Becket.Between holy wrath and royal power, this work explores the ravages of fury in a dramatic fresco woven from medieval and contemporary texts. Carried by bold music combining grand organs, electric guitar, electroacoustics, choir, and solo voices, Fantôme de Roy offers a striking soundscape at the crossroads of time and human tensions."
      }
    ],
    "https://ogp.me/ns#image": [
      {
        "@language": "en",
