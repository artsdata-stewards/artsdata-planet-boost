      }
    ],
    "http://schema.org/image": [
      {
        "@id": "_:g3614240"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g3614260"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g3614300"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/concert/saison-2023-24/ice-installation"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "ICE [INSTALLATION]"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Ice, œuvre de Jimmie Leblanc, est une installation immersive mixte et sonore en collaboration avec l'artiste Fareena Chanda et le physicien Stephen Morris qui explore la formation silencieuse des stalactites. Le processus lent et dynamique de la transformation de l'eau fluide en glace statique est caractéristique de l'universalité, de la beauté et de la violence. L'œuvre invite le spectateur à vivre les moments figés de ce processus en engageant son esprit et son corps dans l'espace de l'installation.\r\n"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2024-03-10T16:00:00-04:00"
      }
    ]
  },
