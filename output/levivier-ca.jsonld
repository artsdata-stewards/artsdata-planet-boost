      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Florence M. Tremblay is a Montreal-based composer originally from Rimouski. In her creative work, she is interested in games, in the principles of gamification and in the transfer of models and processes borrowed from different disciplines. Her interest in interdisciplinary collaborations has led her to work with poets, visual artists, a herbalist and dancers, among others.\r\n\r\nIn 2023, she took part in New Music Concerts' MAKEWAY program in Toronto. In 2022, her piece L'individu est une espèce won the Grand Prix of the SOCAN competition. That same year, she received a commission from..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
