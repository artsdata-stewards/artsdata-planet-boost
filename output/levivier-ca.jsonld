    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Musikfabrik"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Depuis sa création en 1990, l'Ensemble Musikfabrik (Landesensemble NRW) a la réputation d'être l'un des principaux ensembles de musique contemporaine. Comme son nom l’indique, l'Ensemble Musikfabrik s'attache particulièrement à commander et à produire de nouvelles œuvres, en étroite collaboration avec les compositeur.trice.s."
      }
    ],
