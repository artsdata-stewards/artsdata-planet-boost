    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "PROJECTIONS : LOVE SONGS + LIGHT"
      }
    ],
    "http://schema.org/alternateName": [
      {
        "@language": "en",
        "@value": "LA SEMAINE DU NEUF · Tribute to Claude Vivier"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The vocal collective Phth invests its body and voice in this visceral and dreamlike interpretation of the work Love Songs by Quebec composer Claude Vivier. This art video revitalizes the work of the renowned Quebec composer, while remaining sensitive to his whimsical and dramatic style. Sensitive to the achievements of the queer milieu since the work's creation in 1977, the heteronormative relational structures of the score are subverted, celebrating the ambiguity of gender and sexuality.\r\n"
      }
    ],
