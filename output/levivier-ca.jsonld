    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/concert/saison-2023-24/koperkus"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "KOPERKUS"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Les tout-petits sont invités à entrer dans le monde chaleureux et onirique du compositeur québécois Claude Vivier. Ils y feront la connaissance d’Emma, qui roupille dans son lit de coussins. À son réveil, elle utilise le pouvoir de son imagination pour transformer les objets, les formes et les sons. Ainsi, les coussins deviennent des personnages, l’ombre devient musique, les mélodies se transforment en lumières colorées…\r\n"
      }
    ]
  },
  {
    "@id": "_:g3616840",
    "@type": [
      "http://schema.org/MusicEvent"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/fr/concert/saison-2023-24/klaus-janek-andy-graydon"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "_:g3616860"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g3616880"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g3616920"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/concert/saison-2023-24/klaus-janek-andy-graydon"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Klaus Janek + Andy Graydon "
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Depuis 2011, Klaus Janek et Andy Graydon participent à une série de projets communs avec différents collaborateurs. Depuis 2021, ils se concentrent davantage sur leur travail en duo. En raison des distances géographiques et temporelles qui les séparent, cette collaboration prend la forme de conversations avec soi-même et l’autre en résonance, tous les deux développant réciproquement des sémantiques, des métaphores et des états de conscience qui oscillent doucement. Leurs concerts en Amérique du Nord concluent un processus commun de deux ans de composition, de création et de réflexion, processus qui se projette dans le présent.\r\n"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2024-05-01T23:00:00-04:00"
      }
    ]
  },
