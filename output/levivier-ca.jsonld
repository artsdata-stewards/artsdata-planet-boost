  {
    "@id": "https://levivier.ca/en/concert/2025-26-season/quasar-trio-zukan-chambre-decoute",
    "https://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Le Vivier"
      }
    ],
    "https://ogp.me/ns#type": [
