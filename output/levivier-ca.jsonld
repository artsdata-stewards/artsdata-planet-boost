    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "La série Planète Bonheur propose une exploration amoureuse des frontières insoupçonnées de la guitare électrique. Ce second concert met en valeur le quatuor Instruments of Happiness qui interprète notamment trois œuvres de création.\r\n&nbsp;\r\n"
      }
