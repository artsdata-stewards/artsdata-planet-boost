    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Productions SuperMusique (PSM)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Founded in 1979, Productions SuperMusique is headed by Joane Hétu and Danielle Palardy Roger. This organization, a leader in its field, is solely devoted to “musique actuelle,” improvisation, and sonic experiments. Its operations focus on creating, producing, and programming concerts in Montréal, and on setting up international tours for ensembles such as Les Poules, Nous perçons les oreilles, and Ensemble SuperMusique. The company also presents music creation workshops for young audiences.\r\n\r\nMusique actuelle: unstructured rock, fragmented jazz, splintered songs, reinvented..."
      }
    ],
    "@type": [
      "http://schema.org/PerformingGroup"
    ]
  },
  {
    "@id": "_:g12893620",
