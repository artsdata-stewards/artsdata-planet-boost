    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "PREVIEW | WEBCAST : TRIOCULAR +"
      }
    ],
    "http://schema.org/alternateName": [
      {
        "@language": "en",
        "@value": "MEETING WITH LINDA BOUCHARD, THE MUSICIANS AND THE FILMMAKER"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Last November, the TriOculaire + ensemble performed several works from the Living Structures series by composer Linda Bouchard. An electric and generous \"premiere\" with Charlotte Hug from Zurich (voice and viola), François Houle from Vancouver (clarinet) and Lori Freedman from Montreal (bass clarinet and contrabass clarinet) with an outstanding technical team and the use of a unique tool that the composer uses to create scores in real time and project them on two screens.\r\n\r\nCouldn't attend?\r\nWere you present and would you like to have answers to your questions?\r\n\r\nWe invite you to a virtual and live discussion on Zoom/YouTube with the composer, the musicians and the filmmaker. This is your chance to learn more about TriOcular +, ask all your questions and meet the team, live from their respective cities. The meeting will be hosted by Brice Gatinet.\r\n\r\nTo close this special moment, you will be able to discover an extract of the concert. The full version will then be available free of charge from Sunday 30 April for a limited time, with a device designed by the filmmaker Hui Lin especially for the web.\r\n"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2023-04-26T21:00:00-04:00"
      }
    ]
  },
