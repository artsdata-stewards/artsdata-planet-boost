    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Concours AKOUSMAtique - concert des finalistes"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Venez découvrir les trois œuvres finalistes du Concours international de musique multipiste immersive de Montréal, sélectionnées à l’aveugle parmi 54 propositions internationales par un jury de pairs. Lors du concert, les lauréats spatialiseront leurs œuvres sur l’orchestre de haut-parleurs de la MMR de l’École de musique Schulich.\r\n"
      }
    ],
