      {
        "@language": "en",
        "@value": "Démantibulé·es | Le Vivier"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Under the artistic direction of Joane Hétu, this concert features a wind quintet (flute, clarinet, saxophones and trombone), a disparate ensemble of electric or synthetic instruments (synthesizers, oscillators, samplers and rigged percussion) and members of the Joker Choir, who come together to present four creations evoking the scattered pieces of our pandemic moods."
      }
    ],
