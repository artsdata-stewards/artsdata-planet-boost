      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Proxima Centauri, HANATSU miroir and Ensemble Paramirabo are driven by the discovery of new musical territories and each have an artistic approach that is open to other disciplines such as the plastic arts, dance and scenography. It is therefore quite natural that the idea of a Franco-Canadian exchange developed between the three ensembles."
      }
    ],
