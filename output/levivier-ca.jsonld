      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "en",
        "@value": "This piece for saxophone quartet was written specifically for the concert Un pour tous et tous pour un, presented at the Chapelle Historique du Bon-Pasteur in Montreal. Working with Quasar for the creation of this piece, we experimented with specific sonorities and techniques which we found to be well adapted to acoustic spaces. The piece quickly became a ‘’chamber’’ composition, with many sounds circulating across the room and taking into account the distance between each musician to emphasize the many colors and nuances of the Quasar ensemble. Breathing Room therefore addresses..."
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
