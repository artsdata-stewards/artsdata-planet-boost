      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Paul was born in Turkey and moved to the United States as a child. He studied with Alvin Chow at the Oberlin Conservatory, before completing his Master's degree with Kyoko Hashimoto at McGill University. He has also worked with pianists such as Stephen Drury, Ursula Oppens, Peter Frankl and Monique Duphil, among others. At Oberlin and McGill, he worked closely with the Contemporary Music Ensemble and frequently collaborated with composers, taking part in several world premieres and recordings. As a soloist, Paul has performed with the Oberlin CME and recently performed Olivier Messiaen's..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
