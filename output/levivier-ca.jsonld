    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://quatuorbozzini.ca/en/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Quatuor Bozzini"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Quatuor Bozzini has been an original voice and strong advocate in new, experimental and classical music since 1999. Driving the hyper-creative Montréal scene and beyond, the quartet cultivates an ethos of risk-taking, experimentation, and collaboration, venturing boldly off the beaten track. With a rigorous eye for quality, it has nurtured a rich and diverse repertoire, regardless of trends, and leading to a great number of commissions and some 500 premiered works. Its open, collaborative, artist-led approach has resulted in the realization of numerous innovative and highly praised productions, including inter-disciplinary projects with video, theater and dance."
      }
    ],
    "@type": [
      "http://schema.org/PerformingGroup"
    ]
  },
  {
    "@id": "_:g15224900",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/en/artists/quatuor-konus"
      }
    ],
    "http://schema.org/sameAs": [
      {
        "@id": "https://www.youtube.com/channel/UC_-UMmTI3OZaB1RDPcTNf_w"
      },
      {
        "@id": "https://www.facebook.com/Konussax/"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/artists/quatuor-konus"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Quatuor Konus"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Precise, minimalist sound that turns places into spaces: in the 20 years of its existence, the Konus Quartet has specialised in the latest contemporary and experimental music. In visionary curated, intensive collaborations with contemporary composers, the ensemble is committed to the creation and performance of new works.To this end, the Konus Quartet regularly commissions compositions, including pieces by Chiyoko Szlavnics, Jürg Frey, Barry Guy, Makiko Nishikaze, Phill Niblock, Urs Peter Schneider, Martin Brandlmayr, Klaus Lang, Tomas Korber and Sam Pluta, which have been developed and..."
      }
    ],
    "@type": [
      "http://schema.org/PerformingGroup"
    ]
  },
