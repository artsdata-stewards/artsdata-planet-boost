    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/concert/2025-26-season/roozbeh-tabandeh-chants-libres-paramirabo-songs-drowning"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Roozbeh Tabandeh • Chants libres • Paramirabo — Songs of the Drowning"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Songs of the Drowning is an interdisciplinary performance created by Roozbeh Tabandeh, inspired by the poems of Sandeep Bhagwati and the paintings of Khosro Berahmandi.Bhagwati’s poetry served both as inspiration and as a source of ideas throughout the musical composition process. The poetry cycle offers a critical reflection on the human condition in our time. These nine short poems, originally written in German, will be presented in four languages during the performance, including English, French, and Farsi. The final work thus weaves together these four languages with Roozbeh Tabandeh’s music, video works by Hadi Jamali inspired by Khosro Berahmandi’s paintings, and a scenography created by set designer and architect Haleh Vedadi in collaboration with Roozbeh Tabandeh.The production is a copresentation under the artistic direction of Roozbeh Tabandeh, in collaboration with Paramirabo, Chants Libres, and Le Vivier."
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-10-16T00:30:00-04:00"
      }
    ]
  },
