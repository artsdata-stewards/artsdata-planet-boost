      }
    ],
    "https://ogp.me/ns#url": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/evenement/saison-2024-25/nuit-blanche-vibrations-ephemeres-le-grand-pop"
      }
    ],
    "https://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Nuit Blanche: Vibrations éphémères - Le Grand POP | Le Vivier"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Pour la Nuit blanche, Le Vivier et Totem contemporain vous invitent à découvrir une installation cinétique, sonore et visuelle.Composée de dispositifs sonores et lumineux, des bols en acier disposés en cercle et animés par de petites hélices, cette œuvre en perpétuel mouvement vous invite à observer, écouter et vous émerveiller. Inspirée du mouvement circulaire, elle transforme des objets du quotidien en une expérience visuelle et sonore captivante. Tantôt douces comme des cloches d’église, tantôt envoûtantes comme des bols chantants tibétains, ses harmonies changeantes éveilleront la curiosité des petits et des grands."
      }
    ],
    "https://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/sites/default/files/evenements/nuit_blanche_25_0.png"
      }
    ],
