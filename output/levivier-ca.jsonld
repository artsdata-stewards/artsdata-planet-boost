    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Quasar & Stockholm Saxophone Quartet / SAXOCTET "
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Quasar celebrates its 30th anniversary alongside the renowned Stockholm Saxophone Quartet. After successful collaborations in 2019 and 2021, the 8 saxophonist-virtuosos are back together with a new program that will also be performed 3 times in Sweden. In addition to two new works commissioned from Gordon Williamson (CA) and Martina Tommer (SE), Quasar also seizes the opportunity to pay tribute to the late José Evangelista by presenting his Saxoctet.PROGRAMJose Evangelista, Saxoctet for 8 saxophones, 1985Jenny Hettne, Swirls and ShadesGordon Williamson, Création , 2024Martina Tomner, Création , 2024Yannick Plamondon, Passage, New version for saxophones octuor , 2024"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2024-10-24T23:30:00-04:00"
      }
    ]
  },
