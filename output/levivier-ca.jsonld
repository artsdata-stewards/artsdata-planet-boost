    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "I've composed music for over ten feature-length films, including&nbsp;HBO's 537 Votes&nbsp;&amp;&nbsp;ESPN 30 for 30&nbsp;documentaries&nbsp;Broke&nbsp;and&nbsp;The U.&nbsp;I've scored commercials for&nbsp;McDonalds, Old Navy, Microsoft, Volkswagen&nbsp;and&nbsp;Burger King,&nbsp;among others. My music has been featured in&nbsp;The Guardian, Billboard, NME&nbsp;and&nbsp;The Sunday Times,&nbsp;and played on&nbsp;BBC Radio 1, Beats 1,&nbsp;and&nbsp;KCRW.&nbsp;I've had compositions performed on stage in eight countries. I have a Master’s in Composition from McGill University in Montreal, and..."
      }
