    "https://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "JOANE HÉTU : ELLE A SON MOT À DIRE | Le Vivier"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Joane Hétu offre ici un mini-cabaret au caractère dadaïste qui s’articule autour de nouvelles créations ainsi que de chansons et textes réorchestrés connus et inconnus. Les musicien·ne·s s’approprient les mots de Joane Hétu pour les faire résonner et les propulser dans un univers fantaisiste qui mélange discours amoureux, prises de parole et délires phonétiques. Quel sera donc ce mot à dire?"
      }
    ],
