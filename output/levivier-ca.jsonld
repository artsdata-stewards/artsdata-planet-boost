    "https://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Quatuor Bozzini: 1998 | Le Vivier"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Le Vivier comes to La Chapelle Scènes contemporaines! And it does so with great fanfare with the Quatuor Bozzini, in a preview of a series of concerts that the ensemble will present at London’s prestigious Wigmore Hall. To the delight of Montreal audiences, Bozzini will be giving not one, but two concerts dedicated to the music of Gerald Barry (Ireland) and of Cassandra Miller, Linda Catlin Smith, and Tanya Tagaq (Canada). An evening highlighting the quartet's scintillating virtuosity."
      }
    ],
