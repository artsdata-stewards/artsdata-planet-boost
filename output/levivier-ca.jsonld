        "@value": "Exposition : Je suis calme et enragé·e (accessible sur réservation - à tout moment)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "« Nous étions masques, miracles,/empêtrées dans l’enthousiasme,/mystère longtemps guetté,/apparitions-disparitions,/habitudes qui sonnent faux. »\r\n"
      }
