    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Matthias Krüger"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "fr",
        "@value": "Matthias"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "fr",
        "@value": "Krüger"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Né en 1987 à Ulm (Allemagne), il a grandi à Bruxelles et à Trèves, et a étudié la composition musicale à la Hochschule für Musik und Tanz de Cologne, à la Columbia University de New York et à l'IRCAM de Paris. Il a également étudié le français à l'université de Cologne et à la Sorbonne. Il est actuellement doctorant à la Hochschule für Musik und Theater Hamburg, où il fait des recherches sur la composition hybride entre la musique, la danse et le théâtre. De septembre 2023 à avril 2024, il est chercheur diplômé à l'Université McGill de Montréal.\r\n\r\nMatthias..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
