    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Tim Brady: Symphony in 18 Parts for Solo Electric Guitar — Semaine du Neuf"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Un virtuose de la guitareLe concert met en vedette Tim Brady, guitariste virtuose et figure incontournable de la scène musicale montréalaise, interprétera des extraits de sa récente œuvre Symphony in 18 Parts for Solo Electric Guitar, saluée par le New York Times. Le public pourra également découvrir sa nouvelle création For Electric Guitar, spécialement composée pour ce concert.Une production de Bradyworks en codiffusion avec Le Vivier."
      }
    ],
