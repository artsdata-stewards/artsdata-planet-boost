  {
    "@id": "_:g3760420",
    "http://schema.org/url": [
      {
        "@id": "http://www.christopherisnow.com"
      }
    ],
    "http://schema.org/sameAs": [
      {
        "@id": "http://www.christopherisnow.com"
      },
      {
        "@id": "https://www.youtube.com/watch?time_continue=21&v=llBXbtscwAI&feature=emb_logo"
