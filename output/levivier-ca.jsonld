  {
    "@id": "_:g3920600",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/fr/artistes/dominique-lafortune"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/artistes/dominique-lafortune"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Dominique Lafortune"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "fr",
        "@value": "Dominique"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "fr",
        "@value": "Lafortune"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le compositeur montréalais Dominique Lafortune (1989, Saint-Césaire, Québec) s’intéresse de près aux sens possibles des dimensions intrinsèques de la musique. Ses études avec les compositeurs Denys Bouliane (McGill, Montréal) et Lasse Thoresen (Norges Musikkhøgskole, Oslo) lui donnèrent le goût d’une production musicale où la perception est à la base de toute décision.\r\n\r\n\r\nIl a écrit pour une variété d’effectifs (soliste, instrumentiste et dispositif électronique, chœur, orchestre symphonique, ainsi qu’ensemble de deux à vingt instruments), et ses oeuvres furent..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
  {
    "@id": "_:g3920620",
