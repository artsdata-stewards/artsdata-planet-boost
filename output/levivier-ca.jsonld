  {
    "@id": "_:g3613540",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/fr/artistes/jennifer-koh"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/artistes/jennifer-koh"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Jennifer Koh"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "fr",
        "@value": "Jennifer"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "fr",
        "@value": "Koh"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Jennifer Koh (née en 1976) est une violoniste américaine née de parents coréens à Glen Ellyn, dans l'Illinois. Elle est titulaire d'une licence en littérature anglaise de l'Oberlin College et d'un diplôme d'interprétation de l'Oberlin Conservatory. Elle est également diplômée du Curtis Institute et a été la première médaillée du concours Tchaïkovski de 1994.\r\nMme Koh s'est beaucoup produite avec des orchestres tels que le Los Angeles Philharmonic, le New York Philharmonic, le BBC National Orchestra of Wales et d'autres. Elle milite en faveur de l'éducation musicale des..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
  {
    "@id": "_:g3613560",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/fr/artistes/missy-mazzoli"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/artistes/missy-mazzoli"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Missy Mazzoli"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "fr",
        "@value": "Missy"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "fr",
        "@value": "Mazzoli"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "La compositrice nominée aux Grammy Awards Missy Mazzoli a récemment été considérée comme \"l'une des compositrices les plus inventives et les plus surprenantes travaillant actuellement à New York\" (The New York Times) \"Mozart post-millénaire de Brooklyn\" (Time Out New York), et a été félicitée pour son « imagination apocalyptique » (Alex Ross, The New Yorker).La musique de Mazzoli a été interprétée dans le monde entier par le Kronos Quartet, le huitième merle, le pianiste Emanuel Ax, l'Opéra de Philadelphie, le Scottish Opera, le LA Opera, le Cincinnati Opera, le New York..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
