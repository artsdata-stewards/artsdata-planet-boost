    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Jean-François Robin"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "en",
        "@value": "Jean-François"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "en",
        "@value": "Robin"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Jean-François Robin (FR) is a Tiohtiá:ke/Montreal-based intermedia artist. He graduated with a MFA in Intermedia Arts in 2021. His work centres around the translation between material and digital matter, with a particular attention for what resists the translative act, the untranslatable, but also what is transformed and disfigured as a result of this same act. He primarily works with digital moulds created by means of photogrammetry. He then sculpts, transforms, makes collages, so as to see new, unpredictable virtual environments emerge.\r\n"
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
