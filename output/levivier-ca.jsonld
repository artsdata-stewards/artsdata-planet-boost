      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Montreal-based saxophonist, composer and improviser Ida Toninato has an ear for the unknown, exploring reverberant spaces with uncommon acoustics with which she develops artistic partnerships with a strong sense of bonding. After years of playing contemporary music with various collaborators, she has dived head first into pursuing a music after her own daring musical intuitions. Her debut full length record Strangeness is gratitude, released on Kohlenstoff Records in April 2016, planted her firmly in the underground experimental scene with an enthusiastic reception from critics, artists and..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
