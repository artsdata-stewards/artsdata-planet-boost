      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "LA SEMAINE DU NEUF 2026: New Music Festival "
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Get ready to explore new sonic horizons: La Semaine du Neuf returns for its 4th edition!This year, the Music &amp; Movement theme highlights the dialogue between sound and body, gesture and space. The festival will take place from February 27 to March 15, 2026, in several iconic Montréal venues, including the Agora de la Danse, CIRMMT, and La Chapelle Scènes contemporaines.Welcoming dozens of artists from around the world, the festival offers concerts, multidisciplinary performances, an immersive installation, professional gatherings, and a youth program."
      }
    ],
