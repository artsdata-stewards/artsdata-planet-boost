      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Architectures sonores immatérielles et autres invisibilités résonantes — Semaine du Neuf [COMPLET]"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Programme d'œuvres acousmatiques et en direct de Martin Bédard, Marie-Hélène Breault, Louis Dufort, Antoine Lussier et Pauline Patie.Pont d’ondes entre artistes montréalais et longueuillois, Architectures sonores immatérielles et autres invisibilités résonantes propose une immersion dans la richesse et la diversité de la musique acousmatique d’ici. Du son jaillit la lumière... intérieure, irradiante tel le soleil levant, éclat pénétrant que nous absorbons comme une promesse, les yeux fermés.Une production du Conseil des arts de Longueuil en codiffusion avec Le Vivier et Akousma."
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-03-10T23:30:00-04:00"
      }
    ]
