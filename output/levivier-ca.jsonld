    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Christina Volpini"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "en",
        "@value": "Christina"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "en",
        "@value": "Volpini "
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Christina Volpini (b. 1992) is a Canadian composer whose music has been described as “very nuanced, rustling and whispering” (Neomemoire) and “focused intently on the subtle sounds that fall between the cracks.” (Ludwig Van Toronto). Informed by the ephemerality and spontaneity of natural sonic environments, her work explores gradual unfolding through time, found objects, sonic spatialization, instrumental textures and liminal spaces. Her music has been performed and commissioned by Esprit Orchestra, Array Ensemble, Continuum Contemporary Music, Echéa Quartet, Bakarlari Ensemble,..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
