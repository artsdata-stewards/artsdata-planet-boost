    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "L’Ensemble belge Hopper invite le public dans un voyage extatique au travers des vagues submergeantes, puissantes, quelque peu psychédéliques, de sons qui fleurissent à l’infini et de textures qui s’élèvent de manière obsessionnelle au travers des oeuvres de James O’Callaghan et de Pierre Slinckx.\r\n"
      }
    ],
