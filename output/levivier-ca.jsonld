    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "LASCAUX + MAD MAX"
      }
    ],
    "http://schema.org/alternateName": [
      {
        "@language": "en",
        "@value": "As part of La Semaine du Neuf"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "While Italian artists Giulio Colangelo and Vittorio Montalti transport themselves 20,000 years back to the caves of Lascaux through visual and auditory flashes, percussionist Charles Chiovato Rambaldo interprets a wild and completely uncontrollable biker straight out of Hollywood studios.\r\n"
      }
    ],
