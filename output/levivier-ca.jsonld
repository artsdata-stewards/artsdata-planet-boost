    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://en.triozukan.com/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Trio Zukan"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Trio ZUKAN is a young and innovative musical group created in 2014 under the auspices of Musikene. The promotion of contemporary artistic creation and the dissemination of 21st century music are the hallmarks of this group, which combines the varied skills of its members to create fresh and dynamic performances full of detail and rigour. The three members of ZUKAN coincide in their passion for contemporary chamber music, a discipline that they complement with their knowledge of orchestral, traditional or ancient music.\r\nZUKAN differs in its internal functioning from the majority of small..."
      }
    ],
    "@type": [
      "http://schema.org/PerformingGroup"
    ]
  },
