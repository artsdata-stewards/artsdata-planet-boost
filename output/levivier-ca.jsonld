    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Soundstreams"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "fr",
        "@value": "Soundstreams"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Soundstreams est un chef de file mondial dans la présentation d'expériences musicales novatrices, soigneusement sélectionnées et immersives. Le directeur artistique Lawrence Cherney s'est engagé à présenter le travail de compositeurs/musiciens canadiens et internationaux vivants, souvent en mettant l'accent sur les conversations contemporaines dans nos communautés.&nbsp;\r\n\r\nFondée en 1982, la plateforme de conservation de Soundstreams a fait découvrir au public plus de 170 œuvres de certains des compositeurs les plus brillants et les plus novateurs de notre époque, de R. Murray..."
      }
    ],
