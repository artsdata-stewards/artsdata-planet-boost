  {
    "@id": "_:g3923320",
    "http://schema.org/url": [
      {
        "@id": "https://www.severineballon.com/"
      }
    ],
    "http://schema.org/sameAs": [
      {
        "@id": "https://www.severineballon.com/"
      },
      {
        "@id": "https://soundcloud.com/severineballon/je-suis-honoree-detre-nee-dans-ta-tete?utm_source=clipboard&utm_campaign=wtshare&utm_medium=widget&utm_content=https%253A%252F%252Fsoundcloud.com%252Fseverineballon%252Fje-suis-honoree-detre-nee-dans-ta-tete"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/artistes/severine-ballon"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Séverine Ballon"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "fr",
        "@value": "Séverine"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "fr",
        "@value": "Ballon"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Violoncelliste et compositrice, pleinement engagée dans le renouvellement de son répertoire, Séverine Ballon nourrit son travail de la fréquentation des œuvres clés du répertoire ainsi que de ses nombreuses collaborations avec des compositeurs, dans l’intimité de la fabrique sonore. Composer pour son propre instrument le violoncelle est comme un jardin secret, une promenade quotidienne à observer les sons cultivés, les regarder avec un verre magnifiant, les organiser et découvrir des vies si riches et fascinantes. Elle étudie le violoncelle aux Hochschule de Berlin et Lübeck..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
