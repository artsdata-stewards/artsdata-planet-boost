  {
    "@id": "https://levivier.ca/en/concert/2025-26-season/quatuor-bozzini-composers-kitchen",
    "https://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Le Vivier"
      }
    ],
    "https://ogp.me/ns#type": [
