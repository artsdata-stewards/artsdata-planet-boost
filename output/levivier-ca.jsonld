  {
    "@id": "_:g15567360",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/en/le-vivier/repertoire/60-loops"
      }
    ],
    "http://schema.org/datePublished": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2006"
      }
    ],
    "http://schema.org/sameAs": [
      {
        "@id": "http://www.pierrejodlowski.fr/site/index.php?post/60-Loops"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "60 loops"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/le-vivier/repertoire/60-loops"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "en",
        "@value": "60 loops was commissioned by the Myriam Naisy's Company for the project \"backwards 2\". Each project with this choreographer consists in a new challenge : here the opportunity to approach the music world of Steve Reich and give to musical time a funny and relentless meaning.\r\nFrom Steve Reich, I borrowed the principle of repetition, but it is compounded by a stacking principle up to 40 quartets that play simultaneously. Each cell performed live is then repeated by a prerecorded soundtrack until a saturation of the sound space.\r\n\r\nThe musical gesture is absorbed by itself in a dynamic and..."
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
