      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Composer / guitarist Tim Brady defies categorization - an electric guitar virtuoso who writes operas, plays concertos and feels as comfortable with a laptop electronic improvisation as with a string quartet.&nbsp; The guitar as orchestra - his music is a highly personal synthesis of contemporary classical, jazz, rock and electronics."
      }
    ],
