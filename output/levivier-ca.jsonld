    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Snežana Nešić is a Serbian composer, conductor and accordionist based in Germany. After her studies in the P. I. Tschaikowsky, Kiev and at the University for Music and Drama, Hannover she became university lecturer in composition and modern music at the Hanover University of Music, Drama and Media. Since 2018 she teaches also at the University of Music “Felix Mendelssohn Bartholdy” in Leipzig. In 2015 she was visiting professor of composition at the university Skopje.\r\n\r\nShe won inter alia the Molinari Quartet’s international Composer Competition and was also awarded with the..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
