    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "La harpiste bionique"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "La « harpiste bionique » Alexandra Tibbitts offre une performance inoubliable en sculptant avec ses mains et sa voix des paysages sonores envoûtants, évoquant la vulnérabilité, la force et la résilience.\r\n"
      }
    ],
