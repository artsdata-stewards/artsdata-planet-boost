    "https://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Ad Lib presents \"I Lost the Desert\", an intense and immersive quintet by the Egyptian-Quebecer Nour Symon · نور سيمون for harmonica, oud, piano, violin and cello, as well as \"The Great Thaw\" by Montrealer Marc Hyland, for voice, electric guitar and tape."
      }
