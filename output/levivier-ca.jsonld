    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/artistes/ensemble-trioculaire"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Ensemble Trioculaire +"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Composé de Charlotte Hug, François Houle et Linda Bouchard, ce trio crée des performances audiovisuelles immersives qui oscillent de manière ludique entre les espaces numériques et analogiques. Le jeu des musiciens, les dessins « Sound Icons » de Charlotte Hug et la traduction numérique visuelle du logiciel Ocular Scores™ sont traités de manière interactive.\r\n\r\nLinda Bouchard, compositrice avec Ocular Scores ™ et électronique, François Houle, clarinette, clarinette basse avec électronique et Charlotte Hug au violon alto et voix avec électronique et « Sound Icons ».\r\n"
      }
    ],
    "@type": [
      "http://schema.org/PerformingGroup"
    ]
  },
