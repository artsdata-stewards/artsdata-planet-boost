    "http://schema.org/familyName": [
      {
        "@language": "en",
        "@value": "Koslow"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Lily Koslow is a Montréal-based composer, multi-instrumentalist, and vocalist. The aesthetic of their recent work contrasts delicate subtleties of timbral interplay with a dark intensity inspired by surrealist literature, as well as metal music and saturated contemporary music. Lily is often conceptually inspired by extra-musical topics such as bionics, psychedelics, and post-capitalist political theories. They enjoy performing an eclectic assortment of styles, including classical, mixed electroacoustic, rock, and pop music. Lily is currently studying composition with Jean Lesage and piano..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
