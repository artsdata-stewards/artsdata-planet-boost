    "http://schema.org/abstract": [
      {
        "@language": "en",
        "@value": "à la montagne\r\non pleurait des flammes et du lait\r\nla bave des étoiles\r\nla mouche à chevreuil de tes vents\r\nétait un foyer de lèvres\r\n&amp; tu avais murmuré un haïku\r\nune nuit\r\nles cigales cesseront de chanter\r\ncomme si on n'avait jamais fait l'amour\r\n\r\n-&nbsp;&nbsp; &nbsp;Jean-Christophe Réhel, Bleu sexe les gorilles\r\n&nbsp;\r\n"
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
