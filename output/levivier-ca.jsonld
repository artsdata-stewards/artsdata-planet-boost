    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "LES AUTRES RDV"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "En marge des huit concerts du second volet de Résonance croisée, le festival propose de nombreuses occasions d’échange entre le public québécois et des artistes rarement venus à Montréal : classes de maître, tables rondes, rencontres, préconcerts…&nbsp;"
      }
    ],
