        "@value": "2002"
      }
    ],
    "http://schema.org/composer": [
      {
        "@id": "_:g12913860"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Dance me to your beauty with a burning violin"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/le-vivier/repertoire/dance-me-your-beauty-burning-violin"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "en",
        "@value": "Dance Me to Your Beauty With a Burning Violin was commissioned by the CBC for Duo Concertante. &nbsp;It is a single-movement work lasting approximately 9 minutes, and one which tests the virtuosity of the players in many ways. &nbsp;There are solos that touch both ends of the musical spectrum, from fast and aggressive to slow and lyrical; there are extremes in register that must be carefully controlled; and there are fast passages that weave together to form a thick counterpoint.\r\n\r\nThis is one in a series of pieces which are inspired by the poetry of Leonard Cohen, and the second from one..."
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
