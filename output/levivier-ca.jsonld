    "https://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Nuit Blanche: Vibrations éphémères - Le Grand POP | Le Vivier"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "In the heart of this kinetic, sonic, and visual installation, a celestial ballet unfolds, orchestrated by a circular movement that breathes life and momentum into the sounds and light.The installation consists of 13 sound and light devices, made up of steel bowls placed in a circle, fitted with small fan propellers, and set in motion mechanically. Centered on the idea of circular movement, everything in the installation rotates. It also reuses everyday objects to reveal their aesthetic, even hypnotic, properties. Without referencing any specific cult, the changing harmonies of the work can sometimes resemble church bells, sometimes Tibetan singing bowls."
      }
    ],
    "https://ogp.me/ns#image": [
