      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Voiceless Mass"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/fr/le-vivier/repertoire/voiceless-mass"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "en",
        "@value": "Voiceless Mass est une œuvre pour grand ensemble destinée à être jouée dans n'importe quel lieu de culte doté d'une haute voûte et d'un orgue à tuyaux. Bien que le titre fasse référence à une « messe », la pièce ne contient aucune voix chantée audible, mais utilise plutôt l'ouverture du grand espace pour faire résonner les intervalles restreints des instruments à vent et à cordes. En exploitant l'architecture de la cathédrale, Voiceless Mass réfléchit à la futilité de donner une voix à ceux qui n'en ont pas, lorsque l'espace n'est jamais une option.« Je sais..."
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
  {
    "@id": "_:g17157500",
