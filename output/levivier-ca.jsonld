      }
    ],
    "http://schema.org/image": [
      {
        "@id": "_:g21937540"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g21937560"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/concert/saison-2025-26/la-semaine-du-neuf-2026-festival-musiques-nouvelles"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "LA SEMAINE DU NEUF 2026: Festival musiques nouvelles "
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Préparez-vous à explorer de nouveaux horizons sonores: la Semaine du Neuf est de retour pour une 4e édition!&nbsp;Cette année, la thématique Musique &amp; Mouvement met à l’honneur le dialogue entre le son et le corps, le geste et l’espace. La Semaine du Neuf se tiendra du 27 février au 15 mars 2026 dans plusieurs lieux emblématiques à Montréal, dont l'Agora de la Danse, le CIRMMT et La Chapelle Scènes contemporaines. Accueillant des dizaines d’artistes du monde entier, le festival propose des concerts, des performances pluridisciplinaires, une installation immersive, des rencontres professionnelles et un programme jeune public.&nbsp;"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-02-27T14:00:00-05:00"
      }
    ]
  },
