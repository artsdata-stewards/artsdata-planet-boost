    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Misceo"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Duo AIRS (Louis-Philippe Bonin au saxophone et David Therrien Brongo aux percussions) et l’altiste Marina Thibeault s’unissent le temps d’un concert pour présenter un répertoire éclectique de musique contemporaine puisant dans divers folklores, avec des pièces de Iannis Xenakis, de George Aperghis et de Luciano Berio et des créations d’Ana Sokolović et de l’artiste anishinaabe Melody McKiver.\r\n"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2022-03-16T23:30:00-04:00"
      }
    ]
