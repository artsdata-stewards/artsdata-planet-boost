  {
    "@id": "_:g21938920",
    "http://schema.org/url": [
      {
        "@id": "https://quasar4.com/fr"
      }
    ],
    "http://schema.org/sameAs": [
      {
        "@id": "https://quasar4.com/fr"
      },
      {
        "@id": "https://www.facebook.com/Quasar4"
      },
