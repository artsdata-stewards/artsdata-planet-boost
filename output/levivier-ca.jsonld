    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "DU NORD"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Quatre en un — le Quatuor Bozzini, c’est un seul et unique instrument qui vibre, respire, qui déploie une palette sonore parfois semblable à celle d’un immense accordéon, et qui, à coup sûr, marque l’imaginaire. Pour ce programme en particulier, sont proposées trois œuvres qui explorent le potentiel liminal du son.\r\n"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2023-01-30T00:30:00-05:00"
      }
    ]
  },
