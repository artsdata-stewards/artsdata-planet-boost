  {
    "@id": "_:g17011620",
    "@type": [
      "http://schema.org/VideoObject"
    ],
    "http://schema.org/thumbnailUrl": [
      {
        "@id": "https://levivier.ca/sites/default/files/oembed_thumbnails/lXzNY5_f3EL-po6JwIZ_-L_cA9Im-enu7_T4Fb6CIHY.jpg"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "TABLEAUX MUSIQUE - Bande-annonce"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<h4><strong>Tableaux Musique est une porte ouverte offerte aux enfants sur l'imaginaire, le voyage et la musique. Un voyage exaltant, tout en sons et en images.&nbsp;</strong></h4><p>Un petit castelet donne vie aux péripéties des marionnettes, animées par deux musiciennes. À travers des univers variés comme la plage de sable chaud, les fonds aquatiques, la forêt tropicale ou les sols enneigés, les tout-petits naviguent entre le rêve et la réalité. À leur façon, les enfants voyagent tour à tour dans les aventures et les souvenirs des personnages. Munies d’une variété d’instruments, de tableaux et d’objets, les artistes construisent et déconstruisent chaque décor sonore et visuel sous les yeux des petits.</p>"
      }
    ],
    "http://schema.org/uploadDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-03-19T23:58:05-04:00"
      }
