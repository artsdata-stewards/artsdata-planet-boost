  {
    "@id": "_:g14875000",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/en/le-vivier/repertoire/linstant-liquide"
      }
    ],
    "http://schema.org/datePublished": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2023"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "L’instant liquide"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/le-vivier/repertoire/linstant-liquide"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "en",
        "@value": "L’instant liquide est un objet dont la seule constante est le changement, une forme molle dont les limites subissent une transformation continue et évoluent tantôt résolument, tantôt selon une pente si douce qu’on pourrait presque croire à un état. Sa mouvance est le fruit d’une tension entre les vecteurs d’une transformation incessante et d’une stabilisation qu’on n’atteindra jamais. Cet objet mou se meut dans un instant infini dont on ne peut définir le commencement ni la fin. Cette pièce serait donc idéalement déjà commencée et continuerait d’être jouée en..."
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
  {
