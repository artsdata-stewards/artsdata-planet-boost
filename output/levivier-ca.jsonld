    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Les Percussions de Strasbourg"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Founded in 1962, the Percussions de Strasbourg are world-renowned ambassadors of musical creation. With their exceptional repertoire, the group performs twentieth century masterpieces and commissioned new works with the same concerns: to bring life to a contemporary heritage while revisiting it constantly, and to continue to innovate in a context of artistic diversification.\r\n\r\nSince its foundation, the group still stands at the heart of creation, thanks to its particular connections with contemporary composers and the diversity of its abilities in terms of musical formats: from duo to..."
      }
    ],
    "@type": [
      "http://schema.org/PerformingGroup"
    ]
  },
  {
    "@id": "_:g16614860",
