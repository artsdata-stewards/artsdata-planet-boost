      }
    ],
    "http://schema.org/alternateName": [
      {
        "@language": "en",
        "@value": "Presented as part of Festival Accès Asie"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Bird's Sanctuary is a cross-cultural adventure and a multi-sensory experience to raise awareness of the catastrophic ecological situation through an aesthetic and creative approach. Through three artistic disciplines, music, visual arts and video arts, the project will acknowledge the current situation and the fundamental role of humanity in this state of affairs.\r\n"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2023-05-07T23:30:00-04:00"
      }
    ]
  },
