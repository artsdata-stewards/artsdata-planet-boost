    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/concert/saison-2022-23/spationautes-ii"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Spationautes II"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Sous la direction artistique de Cléo Palacio-Quintin, l’ensemble SuperMusique invite à une exploration de l’espace du son. Alliant musiques improvisées et électroacoustiques, partitions animées interactives, projections et spatialisation sonore, cette nouvelle odyssée fera entendre Spationautes (2019), œuvre de la cheffe, ainsi que des créations de Linda Bouchard et Émilie Payeur.\r\n"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2023-04-06T23:30:00-04:00"
      }
    ]
  },
