    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/concert/saison-2024-25/tak-ensemble-star-maker-love-songs-ana-sokolovic-par-kristin-hoff-semaine-du"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "TAK Ensemble: Star Maker / Love Songs - Ana Sokolovic par Kristin Hoff — Semaine du Neuf"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "L’ensemble new-yorkais TAK, figure de proue de la musique expérimentale américaine, présente Star Maker Fragments, une œuvre inspirée d’un roman de science-fiction.Cette œuvre mixte électroacoustique à la partition imaginative signée Taylor Brook, met en scène des extraits du roman révolutionnaire d'Olaf Stapledon Star Maker, paru en 1937. &nbsp;Le roman invite le lecteur à suivre un narrateur humain, projeté dans un voyage cosmique hors de son corps, qui explore les confins de l'espace et du temps. Brook transpose musicalement les sociétés imaginaires de Stapledon en déployant un langage sonore composé de lignes microtonales étendues et transcendantes.&nbsp;En première partie, Kristin Hoff interprète Love Songs d'Ana Sokolovic.&nbsp;Cet opéra intime sur le thème de l'amour explore, en 100 langues différentes, les diverses expressions de l'amour : de l'amour passionné à l'amour perdu, en passant par l'amour familial.*En accord avec Boosey &amp; Hawkes, Inc. éditeur et détenteur des droits d'auteur."
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-03-16T22:00:00-04:00"
      }
    ]
  },
