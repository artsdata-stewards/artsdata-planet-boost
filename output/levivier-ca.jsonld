    ],
    "http://schema.org/familyName": [
      {
        "@language": "en",
        "@value": "Neyrinck"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Composer Frederik Neyrinck (°1985) studied in Brussels, Stuttgart and Graz with Piet Kuijken (piano), Jan Van Landeghem, Marco Stroppa and Clemens Gadenstätter (composition).\r\nHis compositions were already performed by different ensembles and orchestras in Belgium and abroad. He often makes transcriptions of existing repertoire as well.\r\nHis music has been recorded by, among others, I SOLISTI, Revue Blanche and SPECTRA. In 2017-2018, he was season’s composer at Concertgebouw Brugge. He is Artist in Residence at I SOLISTI from 2020 until 2024. He received the Austrian Staatsstipendium..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
