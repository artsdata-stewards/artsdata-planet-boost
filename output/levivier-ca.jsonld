    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "PROJECTIONS : CLAUDE VIVIER / TRIPTYQUE de Michael Greyeyes"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Une projection de trois films produits par Soundstreams, réalisés et chorégraphiés par le célèbre artiste autochtone canadien Michael Greyeyes, d’après les oeuvres de Claude Vivier : Leora, d’après Shiraz (Vivier - 1977), 2, d’après Cinq chansons pour percussions (Vivier - 1980) et Zipangu, d’après Zipangu (Vivier -1980).\r\n"
      }
    ],
