    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/le-vivier/repertoire/unexpected-tremor-lines"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "en",
        "@value": "An Unexpected Tremor of Lines was tangentially inspired by the novel The Passion According to G.H., by Brazilian author Clarice Lispector. The novel takes the form of a monologue by an amateur sculptress, who tells of the existential crisis that overcame her upon crushing a cockroach in the door of a wardrobe. The mystical nature of the book inspired the mood and musical materials of this piece, influencing the development of harmony and textures which are organically expressive. The aesthetic of An Unexpected Tremor of Lines is a response to the narrator’s poetic experiences, as well as..."
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
  {
