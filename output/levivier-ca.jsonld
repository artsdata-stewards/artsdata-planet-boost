    "https://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "SCOTT THOMSON : ARBORIENTATION | Le Vivier"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Le Jardin botanique de Montréal ouvrira ses portes aux seize musicien·ne·s de l’ensemble SuperMusique pour interpréter l’œuvre in situ Arborientation de Scott Thomson. En suivant une partition cartographique, chaque interprète offrira un solo inspiré de l’essence spécifique d’un arbre. Une parenthèse enchantée, 1,8 km et de 85 minutes de musique qui sera exécutée deux fois pour les amateurs d’arbres autant que de musique."
      }
    ],
    "https://ogp.me/ns#image": [
      {
