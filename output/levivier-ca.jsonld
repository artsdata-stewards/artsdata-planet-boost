        "@value": "Le Vivier"
      }
    ],
    "https://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "article"
      }
    ],
    "https://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/concert/2023-24-season/letre-contre-le-vent"
      }
    ],
    "https://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "L'être contre le vent | Le Vivier"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Concert marking the end of the residency of German composer Matthias Krüger, this event offers the opportunity to discover his work and rediscover the instrument considered the oldest synthesizer in the world, the organ. \"L'être contre le vent\" is an improvisational piece composed for computer-controlled organ and real-time electroacoustic processing. Matthias Krüger is joined by organist Adrian Foster, inviting audiences to explore the essence of music itself: time and space."
      }
    ],
    "https://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/sites/default/files/evenements/MatthiasKruger_1000x500.jpg"
      }
    ],
    "https://ogp.me/ns#updated_time": [
      {
        "@language": "en",
        "@value": "2024-02-29T17:52:06-05:00"
      }
    ],
