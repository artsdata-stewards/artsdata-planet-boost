    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/concert/2024-25-season/architectures-sonores-immaterielles-et-autres-invisibilites-resonantes"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Architectures sonores immatérielles et autres invisibilités résonantes — Semaine du Neuf [SOLD OUT]"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Program of acousmatic, mixed and live works by Marie-Hélène Breault &amp; Martin Bédard, Pauline Patie, Louis Dufort and Antoine Lussier.From sound comes light. A bridge of waves between artists from Montreal and Longueuil. There's the neon light that cuts shapes in the darkness of night and reassures our steps in our uncertain walk. But there's also the light of the rising sun, which we feel like a promise and absorb in a penetrating glow.... with eyes closed.A production of the Conseil des arts de Longueuil in co-production with Le Vivier and Akousma."
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-03-10T23:30:00-04:00"
      }
    ]
  },
