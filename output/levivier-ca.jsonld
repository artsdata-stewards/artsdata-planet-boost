    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://levivier.ca/en/event/2024-25-season/ce-qui-nous-lie-documentary-benoit-fry-about-collectif9-official-selection-le"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Ce qui nous lie — Documentary by Benoit Fry about collectif9 — Official Selection Le FIFA 2025"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Diffusé en première mondiale dans le cadre de la 43e édition du Festival International du Film sur l’Art (Le FIFA) , ce documentaire nous plonge au cœur de l’univers d’un groupe de musique de chambre unique en son genre : collectif9, composé de neuf musicien·ne·s à cordes.&nbsp;Discover the world of a unique chamber music group: Collectif9, made up of nine string musicians. This documentary immerses us in their performance, alternating between musical pieces and interviews, where the sensitivity of each artist is revealed, along with their individual personalities. Far from clichés, the film delves into the invisible bonds that connect the musicians, in their constant pursuit of balance between personal expression and collective harmony, the true essence of their art.Filmed during the performance of Héros by the Montreal-based string ensemble Collectif9, as part of the La Semaine du neuf festival, organized by Le Vivier in Montreal, in March 2024. Music and video by Myriam Boucher and Pierre-Luc Lecours.In the presence of director Benoît Fry and the artistic director and director of photography Thibault Bertin-MaghitRéalisation: Benoit FryDirection de la photographie: Benoit FryDirection musicale: Thibault Bertin-MaghitDirection artistique: Thibault Bertin-MaghitMontage: Benoit FryComposition: Myriam Boucher, Pierre-Luc LecoursEn partenariat avec le Festival de Lanaudière"
      }
    ],
