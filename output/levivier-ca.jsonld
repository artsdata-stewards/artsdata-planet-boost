    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Bakarlari"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Fondé en 2018 par la trompettiste Émilie Fortin, Bakarlari est né d’une volonté de mettre en valeur la musique contemporaine et de création en version solo dans le but avoué de créer un nouveau canon musical, en jouant et rejouant des œuvres souvent méconnues – ou pas encore connues - &nbsp;du public. Travaillant en étroite collaboration avec les compositeurs.trices d’ici et d’ailleurs, ses membres veulent toujours repousser les limites techniques de leur instrument et sont avides de sons nouveaux.&nbsp;\r\nComptant plusieurs improvisateurs.trices chevronnés.es, Bakarlari..."
      }
    ],
    "@type": [
      "http://schema.org/PerformingGroup"
    ]
  },
