    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Orchestre de l’Agora"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "L’Orchestre de l’Agora (OA), sous la direction de Nicolas Ellis, est un collectif musical à géométrie variable qui réinvente le rôle du musicien classique dans sa communauté en misant sur son talent et son engagement. Nos musiciens, qui sont de jeunes professionnels de la région de Montréal, sont parmi les meilleurs de leur génération et participent activement à nos concerts audacieux et à nos actions sociales au moyen de la musique. Ensemble, nous voulons changer le monde, une note à la fois.\r\n\r\nFondé en 2013, l’Orchestre possède depuis ce temps une vocation double :..."
      }
    ],
    "@type": [
      "http://schema.org/PerformingGroup"
    ]
  },
