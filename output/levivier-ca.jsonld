    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/concert/saison-2025-26/vivier-mix-soiree-benefice-2025"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "VIVIER MIX / SOIRÉE BÉNÉFICE 2025"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Une soirée bénéfice dont vous êtes les héros!&nbsp;Le 2 décembre, Le Vivier vous convie à une soirée bénéfice festive et créative! Venez vivre une expérience artistique inspirante, tout en soutenant la communauté des musiques nouvelles à Montréal. En plus du concert, vous pourrez participer à un atelier musical qui vous fera découvrir le processus de création, aux côtés d’artistes et de passionné·es de musique. Les fonds recueillis permettront de soutenir deux initiatives: le fonds de création des membres, qui soutient les commandes d’œuvres et l’augmentation des cachets artistiques, ainsi que le fonds de soutien à la relève qui encourage la nouvelle génération en appuyant les résidences de création du Pôle Relève.&nbsp;La Soirée bénéfice 2024 en images"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-12-02T23:00:00-05:00"
      }
    ]
  },
