    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "BEN DUINKER pursues a dual career in performance and academics. As a solo percussionist he has won prizes in the OSM Standard Life Competition, PASIC Solo Percussion Competition, and the Prix D’Europe. His playing has been described as displaying “breath-holding physical grace” (Chronicle Herald) and as “revealing exceptional dexterity and precision” (La Presse). Duinker holds a Master of Music (percussion) and PhD in Music Theory from McGill University. His doctoral research investigates the role of rhythm and metre in the construction, performance, and perception of the rapped..."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
