    ],
    "http://schema.org/familyName": [
      {
        "@language": "en",
        "@value": "Reich"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Steve Reich was recently called “… America’s greatest living composer” (The Village Voice), “… the most original musical thinker of our time” (The New Yorker), and “… among the great composers of the century” (The New York Times). From his early tape pieces It’s Gonna Rain (1965) and Come Out (1966) to his and video artist Beryl Korot’s digital video opera Three Tales (2002), Steve Reich’s path has embraced not only aspects of Western classical music, but the structures, harmonies, and rhythms of non-Western and American vernacular music, particularly jazz...."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
