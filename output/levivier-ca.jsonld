  {
    "@id": "_:g34687040",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/fr/le-vivier/repertoire/something-out-apocalypse"
      }
    ],
    "http://schema.org/datePublished": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2012"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Something Out Of Apocalypse"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/le-vivier/repertoire/something-out-apocalypse"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@language": "fr",
        "@value": "J'ai découvert Apocalypse Now, chef d'œuvre de Coppola, d'abord par le son : disque vinyle, abîmé, scratches permanents recouvrant presque les voix de Willard ou du Colonel Kurtz ; j'ai aussi lu par la suite \"Au cœur des Ténèbres\" de Conrad, le livre adapté par Coppola pour son film. Enfin, quelques années plus tard, j'ai découvert le film, dans un cinéma de banlieue sordide, nous étions peu dans la salle…\r\nQue reste t-il de cette Apocalypse ?\r\nL'impression d'un mouvement de l'esprit à la fois incontrôlable et terriblement efficace… le son insupportable de la voix..."
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
