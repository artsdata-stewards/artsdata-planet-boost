    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Benjamin Oliver is a composer, conductor, electronic musician and pianist. Around sixty of his works have been performed by performers including Århus Sinfonietta, London Sinfonietta and the BBC Symphony Orchestra. Ben is an Associate Professor in Composition at the University of Southampton and conductor of the Workers Union Ensemble.\r\n"
