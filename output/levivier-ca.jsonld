      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dans ce concert empreint d’émotion et de sensibilité, TJ Skinner (violon) et Olivier Hébert-Bouchard (piano) mettent leur talent au service de la musique de quatre&nbsp;compositrices canadiennes, dans une scénographie suscitant la réflexion et l’introspection.\r\n"
      }
    ],
