    "https://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "LA SEMAINE DU NEUF · Tribute to Claude Vivier | Le Vivier"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "La Semaine du Neuf will pay tribute to the Quebec composer Claude Vivier, from March 7 to 17, 2023 in Montreal. This event will celebrate, through music and unique encounters, the repertoire and life of this internationally renowned composer, who has had a lasting impact on contemporary music creation."
      }
    ],
