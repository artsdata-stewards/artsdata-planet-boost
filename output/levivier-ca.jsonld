    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Alexandra Templier — Chant 2 : Le Murmure Du Vivant / Semaine du Neuf"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Expérience immersive, musique improvisée (voix et électroacoustique), danse, arts visuelsLe Murmure du Vivant est un écosystème pluridisciplinaire où le son, le mouvement et le visuel se tissent de façon organique pour convier le public à une expérience transformative: écouter autrement pour penser autrement."
      }
    ]
  },
  {
    "@id": "_:g26762540",
    "@type": [
      "http://schema.org/MusicEvent"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/fr/concert/saison-2025-26/architek-percussion-contrechamps-kino-sonique-semaine-du-neuf"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "_:g26762560"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g26762580"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/concert/saison-2025-26/architek-percussion-contrechamps-kino-sonique-semaine-du-neuf"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Architek Percussion & Contrechamps - Kino-sonique / Semaine du Neuf"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Créations croisées suisses-canadiennes. Entre technologies détournées, avatars numériques et objets du quotidien, ce triptyque de concerts explore les multiples visages du son contemporain.&nbsp;Daniel Zea propose une performance pour reconnaissance faciale où l’avatar numérique révèle les tensions entre expression humaine et algorithme. Nicole Lizée, quant à elle, fait revivre les machines du passé dans une création quadriphonique où le glitch devient matière poétique. Enfin, Alexandre Babel renverse les hiérarchies sonores en sculptant la beauté brute de sons “pauvres”, issus d’objets trouvés et de gestes simples.Trois œuvres qui, chacune à leur manière, interrogent notre rapport à la technologie, à la mémoire et à l’imperfection — et redéfinissent la frontière entre humain, machine et matière."
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-03-01T23:00:00-05:00"
      }
    ]
  },
