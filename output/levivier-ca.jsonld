    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Video Phase"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Video Phase est le fruit de l’association entre deux musiciens créateurs, Julien-Robert et Julien Compagne. Leur idée commune est de développer une nouvelle forme artistique hybride combinant en un seul objet musique, vidéo et technologie.\r\n\r\nIl crée des univers où la musique et le visuel sont totalement fusionnés, l’un étant la représentation de l’autre et vice-versa. Le visuel de ses spectacles étant interactif, cela permet aux interprètes d’improviser et de conserver l’aspect éphémère d’une performance en direct. En parallèle de performances scéniques, il..."
      }
    ],
    "@type": [
      "http://schema.org/PerformingGroup"
    ]
  },
  {
    "@id": "_:g34556900",
    "http://schema.org/url": [
      {
