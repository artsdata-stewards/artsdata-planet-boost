  {
    "@id": "https://www.lediamant.ca/temporary/9c630288-0761-4b9d-ae50-46b5a9096c59",
    "@type": [
      "http://schema.org/TheaterEvent"
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.lediamant.ca/wp-content/uploads/2023/04/2023-dixcommandements-StephanieJasmin-opengraph-1024x538.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
