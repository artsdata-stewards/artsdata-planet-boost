    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.lediamant.ca/wp-content/uploads/2023/09/2023-voixetjeuxdanslespace-Visuel-700x700.jpg"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.lediamant.ca/en/programming/le-piano-de-papou"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Le Piano de Papou"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "« Papou » refers to none other than composer Gilles Tremblay, whose former piano is now in the lobby of Le Diamant. Pianist Rosemarie Duval-Laplante, violinist Pascale Giguère and cellist Raphaël Dubé bring the composer’s musical and poetic universe to life through imaginative narration and musical excerpts from a wide range of eras, including work from Monteverdi, Mozart, Tremblay and others.\nThe 1919 Louis XV-style Steinway piano with gold-leaf gilding belonged to composer and teacher Gilles Tremblay. His grandson, cellist Raphaël Dubé, initiated its bequest to the Fondation des Violons du Roy.\n"
      }
    ]
  },
