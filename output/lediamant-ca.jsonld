  {
    "@id": "https://www.lediamant.ca/temporary/e02cd159-e020-413d-8dbb-f416189b6d15",
    "@type": [
      "http://schema.org/Play"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.lediamant.ca/en/programming/poyo-rojo"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.lediamant.ca/wp-content/uploads/2025/01/Visuel-PoyoRojo-700x700.jpg"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.lediamant.ca/en/programming/poyo-rojo"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Un Poyo Rojo"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "In a gym locker room, two men face each other, challenge each other and seduce each other. This wild mix of dance, sport and sexuality pushes body language to the limit, creating infinite possibilities of rivalry, jealousy and desire. A delightful mix of acrobatics and humour, Un poyo rojo is simultaneously naive, kitsch and cliché, inviting us to laugh at ourselves and accept ourselves completely.\nThe extraordinary duo of physical theatre artists, Luciano Rosso and Alfonso Barón, humorously transforms the ideals of virility and masculine seduction in the hilarious Argentinian production Un poyo rojo. It’s a delightful look at a macho world.\n"
      }
    ]
  },
