    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Needles and Opium - Ex Machina / Robert Lepage | Le Diamant"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Les Aiguilles et l’Opium is a meditation on art, love and dependence. A collage of moments where time and gravitational force seem suspended, the viewer is immersed in an Escher-like world with no up or down—an illusionist act as fascinating as it is strange."
      }
    ],
    "http://ogp.me/ns#url": [
