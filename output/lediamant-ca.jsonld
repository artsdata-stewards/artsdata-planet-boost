    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-fr",
        "@value": "Les aveugles | Le Diamant"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "Douze visages surgissent de l’obscurité. Six visages de femmes et six d’hommes."
      }
    ],
    "http://ogp.me/ns#url": [
