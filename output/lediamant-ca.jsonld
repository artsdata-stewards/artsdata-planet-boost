  {
    "@id": "https://www.lediamant.ca/temporary/3bd37c79-b105-4f02-9ef6-47cb83b5098e",
    "@type": [
      "http://schema.org/Play"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.lediamant.ca/fr/programmation/orangeraie"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.lediamant.ca/wp-content/uploads/2025/01/Visuel-Orangeraie-700x700.jpg"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.lediamant.ca/fr/programmation/orangeraie"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "L&rsquo;orangeraie"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le Diamant dévoile une facette de sa salle Hydro-Québec, sa fosse d’orchestre, en recevant pour la première fois Chants libres, compagnie lyrique de création, et le Nouvel Ensemble Moderne (NEM), avec ses 16 musiciens, sous la direction musicale de Lorraine Vaillancourt.\nLa toute dernière création de Chants libres, L&rsquo;orangeraie, est mis en musique par Zad Moultaka sur un livret de Larry Tremblay et mis en scène par Pauline Vaillancourt.\nAdapté du roman à succès de Larry Tremblay, L’orangeraie est une fable poignante sur l’enfance et la guerre, se déroulant quelque part au Moyen-Orient. On y suit le parcours tragique des jumeaux Amed et Aziz, deux enfants pris dans l’engrenage de la guerre. Avec la musique du franco-libanais Zad Moultaka, reconnue pour la beauté des voix et des sons riches de deux mondes.\n"
      }
    ]
  },
