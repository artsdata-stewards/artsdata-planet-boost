  {
    "@id": "_:g3504140",
    "@type": [
      "http://schema.org/Play"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.lediamant.ca/en/programming/kidd-pivot"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.lediamant.ca/wp-content/uploads/2023/04/2023-assemblyhall-opengraph-1024x538.jpg"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Assembly Hall"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "From the team that brought you the groundbreaking, award-winning productions of Betroffenheit and Revisor comes Kidd Pivot’s latest offering: a dance-theatre hybrid that promises the company’s signature wit and invention.\nCo-creators Crystal Pite and Jonathon Young assemble eight magnificent performers in a new work that explores our need to congregate and belong. In a gathering place that doubles as community hall and mythic realm, we witness the joys and dangers of devoted like-mindedness and the pain of exile.\nFuelling Kidd Pivot’s work is a fascination with story and the role of language as an animating force.\n"
      }
    ]
  },
