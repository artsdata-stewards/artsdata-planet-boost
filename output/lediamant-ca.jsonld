    "http://schema.org/image": [
      {
        "@id": "https://www.lediamant.ca/wp-content/uploads/2025/01/Visuel-MadoFollies-700x700.jpg"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.lediamant.ca/fr/programmation/mado-follies"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Mado Follies"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Reine du kitsch et de la parodie, animatrice à la répartie sans pareille, Mado prend d’assaut la scène du tout dernier joyau de la ville de Québec : Le Diamant. Accompagnée de ses drag queens et de ses séduisants danseurs, Mado fera briller Le Diamant lors d’une soirée inoubliable où chansons, chorégraphies, parodies, glamour et extravagance se donneront rendez-vous.\nDu haut de ses 33 ans de carrière sur les scènes du Québec, l’icône des nuits montréalaises saura faire vibrer la crème des publics de la Vieille Capitale. \nSoyez prêts. La reine et ses duchesses arrivent !\n"
      }
    ]
  },
