    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Le Piano de Papou"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Faîtes découvrir à vos enfants le magnifique piano résidant au Diamant, celui du compositeur Gilles Tremblay.\nÀ travers les nombreux souvenirs racontés par son petit-fils Raphaël Dubé, on y découvre l’univers artistique et créateur du compositeur. Raphaël, violoncelliste aux Violons du Roy, sera entouré de Pascale Giguère au violon et Rosemarie Duval-Laplante au piano. Des airs de Tremblay, Machaut, Monteverdi, Bach, Mozart, Debussy, Messiaen, et Vivie résonneront dans le foyer du Diamant.\n"
      }
    ]
  },
