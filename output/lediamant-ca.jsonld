  {
    "@id": "https://www.lediamant.ca/temporary/ef81e23e-9f33-44af-baa9-2cb06b9cf66d",
    "@type": [
      "http://schema.org/Play"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.lediamant.ca/fr/programmation/poyo-rojo"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.lediamant.ca/wp-content/uploads/2025/01/Visuel-PoyoRojo-700x700.jpg"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.lediamant.ca/fr/programmation/poyo-rojo"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Un Poyo Rojo"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Deux hommes dans le vestiaire d’un centre de conditionnement de physique: ils se font face, se défient, se séduisent. Les possibilités de rivalité, de jalousie et de désir sont infinies dans ce croisement déjanté de danse, de sport et de sexualité, où le langage corporel est poussé dans ses extrêmes limites.\nUn poyo rojo est un savoureux mélange d’acrobatie et d’humour, à la fois naïf, kitsch et cliché qui nous invite à rire de nous-mêmes et à nous accepter entièrement. L&rsquo;extraordinaire duo d’artistes de théâtre physique Luciano Rosso et Alfonso Barón transforme avec humour les canons de la virilité et de la séduction masculine dans l’hilarante production argentine Un poyo rojo. Un clin d’oeil savoureux sur l’univers macho.\n"
      }
    ]
  },
