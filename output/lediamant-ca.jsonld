    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Mado Follies"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Queen of kitsch and parody, a host with unparalleled wit, Mado will take over the stage of Quebec City&#8217;s newest gem: Le Diamant.\nAccompanied by her drag queens and alluring dancers, Mado will make Le Diamant shine during an unforgettable evening where songs, choreographies, parodies, glamor, and extravagance will come together.\nWith 33 years of career on Quebec&#8217;s stages, the icon of Montreal&#8217;s nightlife will make the crème de la crème of audiences, that of the Old Capital, resonate.\nOn February 28 and 29, 2020, be ready. The queen and her duchesses are arriving !\n"
      }
    ]
  },
