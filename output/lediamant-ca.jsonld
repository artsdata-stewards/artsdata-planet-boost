  {
    "@id": "https://www.lediamant.ca/temporary/5b85ed39-c98e-4b63-8b4d-cd64470f1ff9",
    "@type": [
      "http://schema.org/Play"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.lediamant.ca/en/programming/andromak"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.lediamant.ca/wp-content/uploads/2024/07/Visuel-AndromakSaA-Jorge-Camoreti-700x700.jpg"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.lediamant.ca/en/programming/andromak"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Andromak Sa a !"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "After the Haitian people won independence, the tension was palpable among those that fought in the revolution. Two sides formed: the rebels and the royalists. Pyrrhus, the great rebel general, took Andromaque, a royalist, prisoner in his residence. He falls desperately in love with her, and they will be confronted by the Haitian elite who will demand the death of her son.\nSince the story takes place in Saint-Domingue, the official language is Haitian Creole. Certain characters, including Andromaque, speak French in private discussions. The play explores linguistic conflicts, heritage, love and especially honour. Andromak Sa a ! is a translation, adaptation and reimagining of Jean Racine’s Andromaque.\nLanguages: Creole and French, with surtitles.\n&nbsp;\n"
      }
    ]
  },
