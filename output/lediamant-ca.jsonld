  {
    "@id": "https://www.lediamant.ca/temporary/b08dbc2d-abad-4f69-898c-e640db46f4e2",
    "@type": [
      "http://schema.org/Play"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.lediamant.ca/fr/programmation/la-galerie"
