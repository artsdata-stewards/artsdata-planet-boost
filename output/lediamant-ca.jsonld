    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.lediamant.ca/wp-content/uploads/2025/01/Visuel-Orangeraie-700x700.jpg"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.lediamant.ca/en/programming/orangeraie"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "L&#8217;orangeraie"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Le Diamant is revealing a different aspect of the Hydro-Québec Auditorium—its orchestra pit—by welcoming for the first time Chants Libres, an opera company focused on new creations, and the Nouvel Ensemble Moderne (NEM), with its 16 musicians, under the musical direction of Lorraine Vaillancourt.\nThis most recent creation of Chants Libres, L’Orangeraie, brings together Zad Moultaka’s music, Larry Tremblay’s libretto and Pauline Vaillancourt’s direction. Adapted from Larry Tremblay’s award-winning novel, L’Orangeraie is a poignant fable about childhood and war that is set somewhere in the Middle East. In it we follow the tragic journey of twins Amed and Aziz, two children caught up in the maelstrom of war. French-Lebanese composer Zad Moultaka’s music conveys the deep beauty of the voices and sounds of these two worlds.\n"
      }
    ]
  },
