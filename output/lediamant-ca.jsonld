    "http://schema.org/image": [
      {
        "@id": "https://www.lediamant.ca/wp-content/uploads/2025/01/Visuel-Daisy-700x700.jpg"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.lediamant.ca/fr/programmation/daisy-theatre"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "The Daisy Theatre"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "The Daisy Theatre est l’œuvre du marionnettiste de génie, de renommée mondiale, Ronnie Burkett. Dans ce spectacle de cabaret solo, Ronnie Burkett manipule et prête sa voix à une galerie de 40 personnages des plus outranciers, qui laissent place à l’improvisation débridée de leur créateur à travers les numéros de variété, les monologues impromptus, les performances musicales et la participation du public. Une soirée d’improvisation fantaisiste qui évolue à chaque représentation.\n"
      }
    ]
  },
