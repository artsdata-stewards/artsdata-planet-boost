    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Moby Dick"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Moby Dick is the tale of a whaling expedition, but it’s also the story of an obsession and an investigation into the unexplained mysteries of life. To quote Melville, « It is the image of the ungraspable phantom of life; and this is the key to it all. »\nWith seven actors, fifty puppets, video projections, a drowned orchestra and a whale-sized whale, Yngvild Aspeli is working on a visual adaptation of this wonderful beast of a book.\n"
      }
    ]
  },
