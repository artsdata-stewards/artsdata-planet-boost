  },
  {
    "@id": "https://www.lediamant.ca/temporary/da45e8e2-cf53-46f3-8f50-7a70b9e09771",
    "@type": [
      "http://schema.org/TheaterEvent"
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.lediamant.ca/wp-content/uploads/2023/04/2023-LesAveugles-opengraph-1024x538.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2023-10-06T18:00:00"
      }
    ],
    "http://schema.org/remainingAttendeeCapacity": [
