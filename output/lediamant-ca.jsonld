    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Courville - Le Diamant"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Courville esquisse le portrait d’une adolescence complexe, où la toile de fond des euphories collectives n’arrive pas à occulter les tourments de l’éveil à la sexualité, le poids du regard des autres ou l’obsession des apparences."
      }
    ],
