    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Hamlet, Prince of Denmark - Sunday, May 11th, 2025"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Hamlet is in a dark place. Full of doubt, and perhaps touched by madness. After the death of his father under questionable circumstances, he loses his footing&#8230; Is his entourage lying to him? Is his mind, muddled with apparitions, failing? When reason wavers, how can we distinguish between truth and falsehood, how can we distinguish between the faithful and the traitors?\nCo-created by choreographer Guillaume Côté and director Robert Lepage, Hamlet, Prince of Denmark immerses the viewer in a world of deceptive appearances, where ghosts and humans rub shoulders in a minimalist scenography. Light, shadows and transparency play a central role. This metaphorical reinterpretation of Shakespeare&#8217;s narrative draws the fine line between what is and what is not in the vagaries of the mind and the movements of the body.\n"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
