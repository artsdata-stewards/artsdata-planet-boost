    "http://ogp.me/ns#title": [
      {
        "@language": "fr-fr",
        "@value": "Ghost Light : Entre la chute et l'envol - Machine de Cirque | 7 au 9 avr. 2022 | Le Diamant"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "Forts d’une collaboration de plus de dix ans sur les scènes du monde entier, Maxim Laurin et Ugo Dario."
      }
    ],
