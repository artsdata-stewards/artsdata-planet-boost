  {
    "@id": "https://www.lediamant.ca/temporary/de28522d-1a9a-431f-9856-e1b9a99748c6",
    "@type": [
      "http://schema.org/Play"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.lediamant.ca/en/programming/la-ou-le-sang-se-mele"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.lediamant.ca/wp-content/uploads/2025/01/Visuel-LaOuLeSangSeMele-700x700.jpg"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.lediamant.ca/en/programming/la-ou-le-sang-se-mele"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Là où le sang se mêle"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The performance will be followed by a Labrador tea service and a healing circle.\nFloyd, a disillusioned man who drowns his memories and troubles in alcohol, meets up with his childhood friend Mooch every day in the tavern of the village on the other side of the river. One day he receives a letter from his daughter, who was removed from his care by social services and put up for adoption after her mother’s suicide more than 20 years ago. Now, curious about her roots after having been raised in the city, she wants to get to know him and reconnect with her forgotten past.\nAbout\nLà où le sang se mêle is a work about confession and forgiveness. It bridges the gap between a hidden past and a future with bittersweet hope. The characters are people like us, who only have their profound humanity to rely on as they seek resilience.\n"
      }
    ]
  },
