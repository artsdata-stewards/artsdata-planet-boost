  {
    "@id": "https://www.lediamant.ca/temporary/1d034324-7bde-471c-8873-695bcec1b310",
    "@type": [
      "http://schema.org/TheaterEvent"
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.lediamant.ca/wp-content/uploads/2024/05/2024-Courville-Opengraph-1024x538.jpg"
      }
    ],
    "http://schema.org/startDate": [
