  {
    "@id": "_:g3015060",
    "@type": [
      "http://schema.org/Play"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.lediamant.ca/en/programming/michel"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.lediamant.ca/wp-content/uploads/2023/12/michel_1200x628-1024x536.jpg"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Michel!"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Audiences are invited to jump into the wacky world of MICHEL! the latest ComediHa! production inspired by the exceptional work and universe of Michel Courtemanche.\nDesigned for a wide audience, this multidisciplinary show skilfully fuses comedy, circus, dance, music and theater. A simple, captivating scenario brimming with laughter, fantasy and poetry: Michel, a young child, seeks refuge and freedom in an imaginary world where Courtemanche&#8217;s famous characters suddenly come to life before our very eyes. Seven artists on stage transport us into this fabulous epic.\nMICHEL! is a magnificent celebration that stimulates our collective imagination to create magical, spectacular moments through a liberating tale of cartoonish humor\n"
      }
    ]
  },
