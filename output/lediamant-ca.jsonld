    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.lediamant.ca/wp-content/uploads/2025/01/Visuel-LaGalerie-700x700.jpg"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.lediamant.ca/fr/programmation/la-galerie"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "La Galerie"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le cirque envahit le musée ! Sept acrobates disjonctés et une musicienne électrisante s&#8217;emparent d&rsquo;une exposition monochrome. Dans un élan créatif, ils la transforment en une explosion de couleurs. Se moquant allègrement des conventions, ces personnages, aussi loufoques que touchants, explorent avec avidité l’envers du décor. Prouesses vertigineuses, trouvailles surprenantes, poésie colorée et autodérision sont au programme de cette ode à la créativité. Laissez-vous enivrer par cette expérience unique. Prenez part à La Galerie !\n"
      }
    ]
  },
