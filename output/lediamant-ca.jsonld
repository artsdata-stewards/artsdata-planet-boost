  {
    "@id": "_:g1235280",
    "@type": [
      "http://schema.org/Play"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.lediamant.ca/fr/programmation/lutte-2025-2026"
      }
    ],
    "http://schema.org/image": [
