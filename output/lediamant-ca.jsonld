      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Danseurs du ciel est une nouvelle pièce de danse multidisciplinaire qui explore l'impact de la catastrophe du pont de Québec de 1907, qui a tué 33 monteurs de charpentes métalliques de la communauté mohawk de Kahnawake."
      }
