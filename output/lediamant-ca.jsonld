    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Daisy Theatre"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The Daisy Theatre is the work of the genius puppeteer of worldwide renown, Ronnie Burkett. In this solo cabaret show, Ronnie Burkett manipulates and lends his voice to a gallery of 40 outrageously unique characters, giving room to the unbridled improvisation of their creator through variety acts, impromptu monologues, musical performances, and audience participation. An evening of whimsical improvisation that evolves with each performance.\n"
      }
    ]
  },
