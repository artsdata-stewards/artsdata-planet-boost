      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.lediamant.ca/wp-content/uploads/2025/01/Visuel-Courville-700x700.jpg"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.lediamant.ca/en/programming/courville-2"
