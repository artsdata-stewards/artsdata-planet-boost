    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Histoire de la violence - Thomas Ostermeier - 20 au 22 mars 2025 - Le Diamant"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dans le roman autobiographique « Histoire de la violence » d'Édouard Louis, une rencontre fortuite entre Édouard et Reda à Paris passe rapidement du flirt à une nuit d'intimité."
      }
    ],
    "http://schema.org/inLanguage": [
