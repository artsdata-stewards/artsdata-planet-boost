    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Blizzard"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Avec Blizzard, FLIP Fabrique vous emporte dans un voyage fou, poétique et tendre en plein hiver, et vous invite à vous perdre dans un instant d’émerveillement complet. Avec des artistes au sommet de leur art et une poésie visuelle hors du commun, Blizzard promet de tout souffler sur son passage.\nUn spectacle de cirque contemporain qui permettra aux jeunes et moins jeunes de plonger dans la saison d’hiver à venir sans méfiance et remplis d’enthousiasme.\n"
      }
    ]
  },
