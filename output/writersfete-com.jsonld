    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Join us on February 1 for a powerful and engaging literary afternoon with Gillian Deacon—journalist, television and radio host and bestselling author—as she launches her brand-new book, A Love Affair with the Unknown, Leaning Into the Uncertainty of Modern Life. &lt;/p&gt;\\n"
      }
