  {
    "@id": "https://www.writersfete.com/event/passion-et-creation/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Passion et création - Wakefield Writers Fête"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Chloé Sainte-Marie et Marc Séguin. Elle est chanteuse, comédienne et écrivaine. Il est peintre, poète et auteur. Ils font parties des écrivains et artistes multidisciplinaires incontournables québécois. Leurs oeuvres connaissent un succès retentissant ici et à travers le monde. Ensemble sur scène pour la première fois, ils nous parleront, sous la baguette de Julie Huard, de leur passion pour la création, l’écriture, la poésie, la musique, l’art et l’amour."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://www.writersfete.com/event/passion-et-creation/"
      }
