    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Stories of Courage - Wakefield Writers Fête"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Join us for an inspiring evening with celebrated authors and public figures Sally Armstrong and R.H. Thomson with acclaimed host Adrian Harewood. These masterful storytellers will share powerful tales of bravery and resilience, showcasing how individuals and societies face global challenges with unwavering courage. This thought-provoking discussion promises to leave you feeling hopeful and empowered. Don't miss this chance to be part of a conversation that celebrates courage and inspires action towards a brighter future!"
      }
    ],
    "http://ogp.me/ns#url": [
