  {
    "@id": "https://www.writersfete.com/event/waubgeshig-rice-and-kai-thomas/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
