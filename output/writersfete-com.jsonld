  {
    "@id": "https://www.writersfete.com/event/stories-of-fortitude-renewal/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Stories of Fortitude & Renewal - Wakefield Writers Fête"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "THIS EVENT IS SOLD OUT.   Join us for a remarkable afternoon at Motel Chelsea, October 20, 1-3 pm! Writers Fête closes with four acclaimed writers who will celebrate the human spirit’s capacity to overcome adversity and start anew with hope and optimism for the future. Giller Prize winner Souvankham Thammavongsa, born in a Lao refugee camp, Jamal Saeed, 12-year prisoner of conscience who escaped Syria, shortlisted for the Hilary Weston Writers’ Trust Prize for Non-fiction, Lawrence Scanlan, award winning journalist and writer, with host, renowned author Frances Itani, will explore the struggle and triumphs of finding meaning in difficult times and in belonging in a foreign place."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://www.writersfete.com/event/stories-of-fortitude-renewal/"
      }
