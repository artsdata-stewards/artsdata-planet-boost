      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Called in for a last-minute replacement, Ms. Brûlé is euphoric at the prospect of her first teaching contract. However, her enthusiasm quickly gives way to panic as she realizes that she is the fourth replacement of the year. Her arrival in the classroom also coincides with the annual parents\\' meeting, at which she must hand in report cards that are... nowhere to be found.&lt;/p&gt;\\n"
      }
