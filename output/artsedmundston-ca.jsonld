    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;After more than 100 performances and nearly 25,000 tickets sold for his first one-man show \\'\\'Des choses qui arrivent\\'\\' Alex Roy, who made you howl with laughter during the opening acts for Lise Dion, Les Grandes Crues and José Gaudet, takes us back, into his awkward, surprising and hilarious universe with his brand new show &quot;Debout&quot;!&#013;&lt;br /&gt;\\n*PERFORMANCE IN FRENCH&lt;/p&gt;\\n"
      }
    ],
