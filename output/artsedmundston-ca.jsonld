        "@value": "&lt;p&gt;Strengthened by their longstanding friendship and the same passion for country music, two performers beloved by Quebec audiences, Maxime Landry and Annie Blanchard, are back in the studio for a new album and on stage for a full-scale show following the success of their Jolene and the Gambler tour.&#013;&lt;br /&gt;\\n*PERFORMANCE IN FRENCH&lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@value": "Organization"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
