    "http://schema.org/name": [
      {
        "@value": "Jeunesse Musicales Canada"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;À travers ce concert, la soprano Mathilde Duval-Laplante et les pianistes &#013;&lt;br /&gt;\\nRosemarie Duval-Laplante et Jean-Michel Dubé proposent avec sensibilité un espace contemplatif autour de la paix en temps de guerre.&lt;/p&gt;\\n"
      }
    ],
