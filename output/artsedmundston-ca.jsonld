    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Un duo composé d\\'enfants et d\\'adultes (parents, grands-parents, tantes, oncles, etc.) se réunira pour un moment créatif unique. Sans sujet prédéfini ni résultat attendu, l\\'artiste vous invitera en à vous laisser guider par la toile blanche et par l\\'instant présent pour peindre en collaboration, votre propre oeuvre.&lt;/p&gt;\\n"
      }
    ],
