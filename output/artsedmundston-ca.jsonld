    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;** SPECTACLE DEBOUT **&#013;&lt;br /&gt;\\n&#013;&lt;br /&gt;\\nTout frais sortant des confins du Nord-Ouest du Nouveau-Brunswick, La Grosse Équipe arrive avec un tout premier album et spectacle, &quot;Rose Motel&quot;.&lt;/p&gt;\\n"
      }
    ],
