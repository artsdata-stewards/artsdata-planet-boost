      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Rita Baga, la plus célèbre drag queen québécoise qui s\\'illustre aussi en Europe, revient chez vous avec sa toute nouvelle tournée musicale SPRAYNET! Rita a conquis le Québec avec Créature, la plus longue tournée solo d\\'une drag en Amérique, vue par 75 000 spectacteur.trices et récipiendaire d\\'un Olivier.&lt;/p&gt;\\n"
      }
    ],
