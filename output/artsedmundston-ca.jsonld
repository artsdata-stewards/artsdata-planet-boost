    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Cayenne interprète avec justesse et fougue des récits tantôt champ gauche et énergiques, tantôt introspectifs et sensibles. Au menu : féminisme, préoccupations milléniales, recherche identitaire à travers l\\'amour du territoire, le tout nappé d\\'influences qui valsent avec le polyamour musical.&lt;/p&gt;\\n"
      }
    ],
