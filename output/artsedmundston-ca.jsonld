    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Lors de ce Déjeun\\'art : « Le Monde est ma Représentation » Découvrez comment les artistes, de la Renaissance à l\\'art contemporain, ont transformé leur regard sur le monde en oeuvres uniques.&lt;/p&gt;\\n"
      }
