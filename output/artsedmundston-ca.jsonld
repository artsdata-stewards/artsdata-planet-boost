    "http://schema.org/name": [
      {
        "@value": "Maxime Landry et Annie Blanchard"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Forts de leur amitié de longue date et animés par cette même passion pour la musique country, deux interprètes aimés du public québécois, Maxime Landry et Annie Blanchard, se retrouvent en studio pour un nouvel album et sur scène pour un spectacle à grand déploiement à la suite du succès de la tournée Jolene and the Gambler.&lt;/p&gt;\\n"
      }
    ],
