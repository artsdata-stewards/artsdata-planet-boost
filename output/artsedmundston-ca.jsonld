    "http://schema.org/name": [
      {
        "@value": "Mégan Brouillard"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Le chiendent, c\\'est subjectif. La mauvaise herbe, c\\'est quelque chose qui pousse là où toi, tu ne voulais pas. Ce qui est du chiendent pour l\\'un ne l\\'est peut-être pas pour l\\'autre et ce qui est du chiendent quelque part, ne l\\'est pas ailleurs...&lt;/p&gt;\\n"
      }
    ],
