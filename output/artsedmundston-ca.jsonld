    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Après l\\'immense succès télévisuel de l\\'émission, Passe-Partout, Passe-Carreau et Passe-Montagne sillonneront enfin les routes du Québec à la rencontre de leurs poussinots et poussinettes.&lt;/p&gt;\\n"
      }
