    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Rita Baga, Quebec\\'s most famous drag queen who also performs in Europe, returns with her all-new SPRAYNET musical tour! Rita conquered Quebec with Créature, the longest solo drag tour in America, seen by 75,000 spectators and winner of an Olivier award.&lt;/p&gt;\\n"
      }
