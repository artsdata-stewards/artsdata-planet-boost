    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;** REMISE DU SPECTACLE INITIALEMENT PRÉVU LE 7 JUIN 2025, NOUVEAU PLAN DE SALLE **&#013;&lt;br /&gt;\\n&#013;&lt;br /&gt;\\nMartin Levac continue le voyage dans l\\'univers combiné de Phil Collins &amp; Genesis dans un nouveau spectacle! Phil Collins &amp; Genesis... Live vous fait revivre les grandes chansons qui ont accompagné les plus beaux moments de votre vie!&lt;/p&gt;\\n"
      }
