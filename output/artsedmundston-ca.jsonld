      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://artsedmundston.ca/events_cal/cayenne/"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-01-28T20:00:00-04:00"
      }
    ],
    "http://schema.org/endDate": [
      {
