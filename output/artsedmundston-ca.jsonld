    "http://schema.org/name": [
      {
        "@value": "Ballet Atlantique"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Séducteur amoral ou romantique incurable ? Le ballet enjoué que propose Igor Dobrovolskiy jette un regard contemporain et drolatique sur la légende d\\'un des amants les plus outranciers de l\\'histoire.&lt;/p&gt;\\n"
      }
    ],
