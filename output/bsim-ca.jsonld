    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Join us Thursday, August 22nd at 7 p.m. for an evening concert by the Brantford Community Symphony Orchestra, and featuring the Ryerse Jazz Singers, on the grounds of the Bell Homestead. In a nod to Alexander Graham Bell, there\\'ll be a certain tune played in his honour. Come and see if you can catch which one it is. Bring lawn&hellip;&lt;/p&gt;\\n"
      }
    ],
