    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Our spring concert, Both Sides Now, features a tribute to the Yorkville Coffee Houses and hippie hits of the 60’s and ’70s. Get your groove on and enjoy music from Joni Mitchell, Gordon Lightfoot, Leonard Cohen, Hair and Godspell. Join us May 13th, 7:30pm at Eastminster United Church, 310 Danforth A"
      }
    ],
