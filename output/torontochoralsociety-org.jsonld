    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Known as the St Cecilia Mass, Gounod’s longest and most  complex  setting  of  the  Latin  Mass.  Rich  in  its elaborate interweaving  and  lasting  more  than  an  hour,  it reveals  Gounod the  opera  composer. Join us on this magical night with the Scarborough Philharmonic."
      }
    ],
