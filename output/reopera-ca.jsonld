  {
    "@id": "https://reopera.ca/temporary/1939cc9f-1038-4537-817c-c87a50f40232",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/image": [
      {
        "@id": "https://reopera.ca/wp-content/uploads/2021/09/Shirin_Eskandani2-1.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://reopera.ca/event/compassionate-and-resilient-creative-leadership-2/"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2021-11-04T09:00:00-07:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2021-11-04T10:00:00-07:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g2114860"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g2114900"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://reopera.ca/events/list/?tribe-bar-date=2022-11-01&eventDisplay=past"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Compassionate and Resilient Creative Leadership"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;As creatives, our goal is to create new and exciting projects. But if our creativity is not rooted in resilience and compassion then we cannot sustain the demands of creative leadership. The truth is that creative leaders struggle with higher burnout rates, chronic fatigue and stress than the general population, which often leads to a &hellip; &lt;a href=&quot;https://reopera.ca/event/compassionate-and-resilient-creative-leadership-2/&quot; class=&quot;more-link&quot;&gt;Continue reading &lt;span class=&quot;screen-reader-text&quot;&gt;Compassionate and Resilient Creative Leadership&lt;/span&gt; &lt;span class=&quot;meta-nav&quot;&gt;&rarr;&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": "Organization"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
  {
    "@id": "https://reopera.ca/temporary/d1dd9154-f18f-455f-b6eb-9ad48ee51ec4",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/image": [
      {
        "@id": "https://reopera.ca/wp-content/uploads/2021/09/INdieFest-Banner-V3-1.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://reopera.ca/event/indie-opera-hackathon-kickoff/"
      }
    ],
    "http://schema.org/startDate": [
