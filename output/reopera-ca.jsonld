    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Seamstress is a documentary opera based on the collected oral histories of Palestinian women and girls from Donia Jarrar\\'s family and community. Blending audio interviews, photography, and raw footage with &hellip; &lt;a href=&quot;https://reopera.ca/event/seamstress/&quot; class=&quot;more-link&quot;&gt;Continue reading &lt;span class=&quot;screen-reader-text&quot;&gt;Seamstress&lt;/span&gt; &lt;span class=&quot;meta-nav&quot;&gt;&rarr;&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;\\n"
