    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;One of our most loved events, Future Mythologies, returns to IndieFest 2025! Future Mythologies is a celebratory showcase for the new works in development that aspire to redefine the future of &hellip; &lt;a href=&quot;https://reopera.ca/event/future-mythologies-2025/&quot; class=&quot;more-link&quot;&gt;Continue reading &lt;span class=&quot;screen-reader-text&quot;&gt;Nov 26 | Future Mythologies 2025 at the Annex&lt;/span&gt; &lt;span class=&quot;meta-nav&quot;&gt;&rarr;&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;\\n"
