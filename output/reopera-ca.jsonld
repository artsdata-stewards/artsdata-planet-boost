    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Wilillish\\'d is a new immersive production by Thule van den Dam and Hayley Sullivan McInerney, presented at DigiBC Creative Tech Studio. Willilish’d explores themes of memory, emotion, change, and motherhood &hellip; &lt;a href=&quot;https://reopera.ca/event/willilishd/&quot; class=&quot;more-link&quot;&gt;Continue reading &lt;span class=&quot;screen-reader-text&quot;&gt;Nov 21 &#038; 22 | Willilish&#8217;d by As and When&lt;/span&gt; &lt;span class=&quot;meta-nav&quot;&gt;&rarr;&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;\\n"
      }
