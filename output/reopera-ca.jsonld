    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Indie Producer&#8217;s Forum"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Emerging alongside new indie opera / music / theatre companies is a new kind of producer: one that plays an integral role in the creation, execution and dissemination of new works and performances. This forum is a networking and knowledge sharing session that will address the unique barriers independent artists and producers face in performing &hellip; &lt;a href=&quot;https://reopera.ca/event/indie-producers-forum/&quot; class=&quot;more-link&quot;&gt;Continue reading &lt;span class=&quot;screen-reader-text&quot;&gt;Indie Producer&#8217;s Forum&lt;/span&gt; &lt;span class=&quot;meta-nav&quot;&gt;&rarr;&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;\\n"
