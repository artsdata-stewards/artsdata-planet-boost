    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Rivers of Grief &#8211; A Journey Through the Underworld"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Why do we tell stories? And why do certain myths resonate across centuries? Immerse yourself in the rivers of the Greek Underworld, as soprano Mireille Asselin, tenor Asitha Tennekoon, violinist Parmela Attariwala and pianist Perri Lo, explore the nature of grief and loss. Travel with them over the Styx on a musical journey featuring works &hellip; &lt;a href=&quot;https://reopera.ca/event/the-underworld/&quot; class=&quot;more-link&quot;&gt;Continue reading &lt;span class=&quot;screen-reader-text&quot;&gt;Rivers of Grief &#8211; A Journey Through the Underworld&lt;/span&gt; &lt;span class=&quot;meta-nav&quot;&gt;&rarr;&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;\\n"
      }
    ],
