    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Based on the live performance piece Double Happiness: Detour This Way, this short film traces the migration paths of two families from Southern China through Hong Kong to finally settle &hellip; &lt;a href=&quot;https://reopera.ca/event/double-happiness-a-little-detour/&quot; class=&quot;more-link&quot;&gt;Continue reading &lt;span class=&quot;screen-reader-text&quot;&gt;Double Happiness: A Little Detour&lt;/span&gt; &lt;span class=&quot;meta-nav&quot;&gt;&rarr;&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;\\n"
