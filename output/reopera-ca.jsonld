    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Presented at the Fox Cabaret, Musique 3 Femme’s SOLO is a tour-de-force double bill for solo unaccompanied voice, featuring Scottish composer Judith Weir’s King Harald\\'s Saga and Love Songs by &hellip; &lt;a href=&quot;https://reopera.ca/event/musique-3-femmes-solo/&quot; class=&quot;more-link&quot;&gt;Continue reading &lt;span class=&quot;screen-reader-text&quot;&gt;Musique 3 Femmes: SOLO&lt;/span&gt; &lt;span class=&quot;meta-nav&quot;&gt;&rarr;&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;\\n"
