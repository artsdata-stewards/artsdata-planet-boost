    "http://opengraphprotocol.org/schema/title": [
      {
        "@value": "Late Show at Tune Up Bar @ Tune Up Bar - May 22, 2026, 9:00PM"
      }
    ],
    "http://opengraphprotocol.org/schema/description": [
      {
        "@value": "Saint of Soldiers bring their full-band show to the Late Show at the Tune Up Bar in Bozeman from 9–11 PM. Built on driving rock percussion, haunting melodies, and roots storytelling, the band delivers a sound that’s both raw and cinematic, anchored by powerful, emotionally charged vocals."
      }
    ],
