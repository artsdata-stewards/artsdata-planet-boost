    "@id": "https://saintofsoldiers.com/event/6326954/741895123/o-shaughnessy-cultural-arts-center",
    "http://opengraphprotocol.org/schema/title": [
      {
        "@value": "O'Shaughnessy Cultural Arts Center @ O'Shaughnessy Cultural Arts Center - Nov 6, 2026, 7:00PM"
      }
    ],
    "http://opengraphprotocol.org/schema/description": [
      {
        "@value": "Saint of Soldiers brings their full five-piece band to Whitefish for a late-fall show at the performing arts center. Featuring layered instrumentation, dual female vocals, and a roots-forward sound with rock influence, the band delivers songs driven by storytelling and dynamic arrangements. This performance offers a full-band experience in a seated listening space, suited for an attentive, immersive night of music. Ticket link coming soon."
      }
    ],
    "http://opengraphprotocol.org/schema/image": [
