[
  {
    "@id": "https://saintofsoldiers.com/event/6430525/751178001/libby-memorial-center",
    "http://opengraphprotocol.org/schema/title": [
      {
        "@value": "Libby Memorial Center @ Libby Memorial Center - Apr 17, 2026, 7:00PM"
      }
    ],
    "http://opengraphprotocol.org/schema/description": [
      {
        "@value": "Saint of Soldiers bring their full band to the Libby Memorial Center for a night centered on story and connection. This show offers a deeper look into the songs, with expanded stories behind the originals and the moments that shaped them. It’s also a chance to see SOS after spending the day doing outreach with local schools, carrying that community energy straight into the performance. Expect an intimate but powerful evening."
      }
    ],
