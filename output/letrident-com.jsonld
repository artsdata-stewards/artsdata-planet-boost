    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.letrident.com/wp-content/uploads/2022/11/TRI_VisuelMedias_Hor_LesBonsDebarras_Trident_Par-Stephane-Bourgeois-Helene-Bouffard-scaled.jpg"
      }
    ],
