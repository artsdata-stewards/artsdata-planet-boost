    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.letrident.com/piece/madame-de-sade/"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.letrident.com/piece/madame-de-sade/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "LA NUIT DES ROIS au Théâtre du Trident"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "2h sans entracte"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Alors que son mari, le Marquis de Sade, est emprisonné à moult reprises, Madame de Sade, épouse de l&rsquo;illustre libertin, lui demeure fidèle. Autour de son absence, dans un salon du XVIIIe siècle, six femmes, incarnant chacune une vertu ou un vice, s&rsquo;épanchent en conjectures sur le retour espéré du débauché personnage en quête d&rsquo;absolu. L&rsquo;épouse, sa mère et sa sœur, une amie d&rsquo;enfance, une courtisane et une femme de chambre nous présentent des vérités qui transcendent les préjugés et nous proposent une réflexion sur les vertiges de la liberté. Un texte sensible et nuancé qui met de l&rsquo;avant des dialogues enflammés où s&rsquo;entremêlent la douceur de l&rsquo;amour et la cruauté des coups de fouets.\n"
      }
    ]
  },
