    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.letrident.com/piece/la-nuit-des-rois/"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.letrident.com/piece/la-nuit-des-rois/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "LA MÉDÉE D&rsquo;EURIPIDE au Théâtre du Trident"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "2h40 avec entracte"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dans cette comédie romantique, une tempête provoque le naufrage d&rsquo;un navire, séparant la jeune Viola de son jumeau, Sébastien. Ils échouent à deux endroits différents, chacun croyant à la mort de l&rsquo;autre. La jumelle, n&rsquo;étant plus sous la protection de son frère, prend plaisir à jouer de son androgynie pour devenir le page du duc Orsino, follement amoureux de la comtesse Olivia. S&rsquo;enchaînera un véritable tourbillon de quiproquos, d&rsquo;imbroglios sentimentaux et de rebondissements inattendus où folie, bêtises et facéties se côtoient dans un délicieux délire.\n"
      }
    ]
  },
