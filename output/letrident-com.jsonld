      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "LA NUIT DES ROIS au Théâtre du Trident"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "2h30 avec entracte"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dix ans après avoir quitté son royaume et les siens, Ulysse tente de retrouver le chemin du retour, mais sera confronté à des obstacles foudroyants. Reconnu pour son intelligence et sa ruse, ce héros devra affronter de nombreux personnages mythologiques pour rejoindre son épouse Pénélope et son fils Télémaque. Un voyage rempli de péripéties dont les plus grands ennemis sont l&rsquo;irréductibilité du temps et ses effets sur l&rsquo;homme.\n"
      }
    ]
  },
