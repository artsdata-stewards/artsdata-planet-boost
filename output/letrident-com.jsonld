  {
    "@id": "https://www.letrident.com/temporary/41e2aa1b-69bf-4d70-978d-38cc41aa0296",
    "@type": [
      "http://schema.org/TheaterEvent"
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.letrident.com/wp-content/uploads/2023/10/1392-85-trident-siteweb-1080x900-1.png"
      }
    ],
    "http://schema.org/location": [
      {
