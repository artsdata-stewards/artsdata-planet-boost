      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "HOSANNA OU LA SHÉHÉRAZADE DES PAUVRES au Théâtre du Trident"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "1h15"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dans cette adaptation franchement contemporaine du mythe où une image vaut mille mots, l’idéaliste Orphée fera tout pour libérer l’envoûtante Eurydice des dictats de notre monde, alors que tous deux se verront confrontés à des manières distinctes de voir et vivre l’amour.\nComme dans la version 100 fois racontée, Orphée, inconsolable, défie toutes les conventions et fonce, tête baissée, dans le royaume des Enfers pour tenter de ramener sa bien-aimée Eurydice dans le monde des vivants.\n"
      }
    ]
  },
