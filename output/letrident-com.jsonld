  {
    "@id": "https://www.letrident.com/temporary/5a770597-e64c-4e77-a6ce-7bc0e228615c",
    "@type": [
      "http://schema.org/TheaterEvent"
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.letrident.com/wp-content/uploads/2023/01/Dieu-Carnage.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1593060"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "_:g1593080"
      }
    ],
    "http://schema.org/startDate": [
      {
