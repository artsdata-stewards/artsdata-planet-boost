        "@value": "2015-09-15T00:00:00-04:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2015-10-10T00:00:00-04:00"
      }
    ],
    "http://schema.org/sponsor": [
      {
        "@id": "_:g1593100"
