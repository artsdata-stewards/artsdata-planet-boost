    "http://schema.org/url": [
      {
        "@id": "https://www.letrident.com/piece/un-deux-trois/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "CABARET au Théâtre du Trident"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "UN : 65 minutes / Entracte 15 minutes / DEUX : 70 minutes / Entracte 15 minutes / TROIS : 95 minutes. Boissons permises dans la salle."
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Pour une semaine seulement Le Trident vous présente une nouvelle mouture de l’événement théâtral UN.DEUX.TROIS., une trilogie exceptionnelle acclamée par le public et la critique, présentée par Orange Noyée et le Théâtre français du CNA en coproduction avec le Théâtre du Nouvel-Ontario, le Théâtre français de Toronto, le Théâtre Duceppe, le Théâtre du Trident, le Théâtre populaire d’Acadie, le théâtre l’Escaouette, le Théâtre la Seizième et le Cercle Molière.\n"
      }
    ]
  },
