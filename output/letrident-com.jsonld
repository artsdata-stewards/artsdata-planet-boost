    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.letrident.com/piece/albertine-en-cinq-temps/"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.letrident.com/piece/albertine-en-cinq-temps/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "LES AIGUILLES ET L&rsquo;OPIUM au Théâtre du Trident"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "1h30 sans entracte"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Une oeuvre capitale\nCe texte met en scène Albertine, un des personnages phares de l&rsquo;univers de Michel Tremblay. Albertine, en cinq temps c’est l’histoire de toutes les femmes, celles qui foncent tête baissée devant l’adversité, celles qui cherchent le bonheur dans le regard des autres ou celles qui acceptent leur sort avec résignation. Si on pouvait parler à la personne que nous avons été, que lui dirions-nous ? Quel bilan peut-on tracer de sa vie ? Sans aucun doute, une des œuvres les plus touchantes de Tremblay\nARRIVÉE AU BOUT D&rsquo;UNE VIE RATÉE, UNE SEPTUAGÉNAIRE RESSASSE LES MOMENTS MARQUANTS DE SON EXISTENCE.\n"
      }
    ]
  },
