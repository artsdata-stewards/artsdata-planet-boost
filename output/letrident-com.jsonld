      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.letrident.com/piece/therese-et-pierrette-a-lecole-des-saints-anges/"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.letrident.com/piece/therese-et-pierrette-a-lecole-des-saints-anges/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "LA NUIT DES ROIS au Théâtre du Trident"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "2h sans entracte"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Thérèse, Pierrette et leur amie Simone forment un trio inséparable. Alors qu&rsquo;à l&rsquo;école des Saints-Anges se préparent les célébrations de la Fête-Dieu, chacune s&rsquo;éveille à la vie et découvre les exaltations et les tourments du passage à l&rsquo;adolescence sous le regard parfois autoritaire des religieuses qui dirigent l&rsquo;établissement. Dans ce quartier ouvrier du Québec des années 40, où les rapports de classes sont marqués, l&rsquo;élite religieuse fait peser son emprise sur les élèves, leurs mères et les enseignantes. Progressivement, une révolte commence à sourdre dans tous les coins de l&rsquo;école, annonciatrice du désir d&rsquo;affranchissement qui secouera la province lors de la Révolution tranquille.\n"
      }
    ]
  },
  {
