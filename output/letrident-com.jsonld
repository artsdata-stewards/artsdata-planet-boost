  {
    "@id": "https://www.letrident.com/temporary/045222d4-683a-4d49-8d71-0861370fe98e",
    "@type": [
      "http://schema.org/TheaterEvent"
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.letrident.com/wp-content/uploads/2024/03/1314-82-trident-visuel-siteweb-header-1024x964-5-min.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1916360"
      }
    ],
    "http://schema.org/offers": [
