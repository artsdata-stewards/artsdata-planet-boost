    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.letrident.com/piece/un-tramway-nomme-desir/"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.letrident.com/piece/un-tramway-nomme-desir/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Dom Juan au Théâtre du Trident"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "Information à venir"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Elle arrive avec ses valises, ses illusions et ce qu&rsquo;il reste de son ancienne vie. Blanche DuBois débarque chez sa sœur Stella, à La Nouvelle-Orléans, dans un appartement trop petit pour deux femmes et un homme comme Stanley Kowalski. Stanley, charnel et souverain sur son propre territoire, sent immédiatement que Blanche est une menace. Pas pour sa sécurité. Pour son pouvoir. Alors commence une guerre sourde, implacable, où chaque mot est une arme et chaque verre de whisky une forteresse. Stanley s&#8217;emploie à détruire Blanche lentement, méthodiquement, sapant sa crédibilité et retournant son entourage contre elle en la faisant passer pour folle.\nCe que la pièce dit aujourd&rsquo;hui résonne avec une violence troublante : combien de Blanche se font encore réduire au silence parce que leur vérité est jugée trop fragile, excessive, trop dérangeante ? Combien de Stella ferment les yeux pour préserver ce qu&rsquo;elles ont ? Le tramway roule toujours. Et il porte encore le même nom.\n"
      }
    ]
  },
