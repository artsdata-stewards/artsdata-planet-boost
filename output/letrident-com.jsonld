    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "HOSANNA OU LA SHÉHÉRAZADE DES PAUVRES au Théâtre du Trident"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "1h10"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Avec la même cruauté avec laquelle son père abattait les poulets en plein mois d’août, Michel-Maxime vous lance des parties de lui. Il vous parle de son parcours, de la vie rurale, de St-Polycarpe, de sa famille colorée, de ses parents bienveillants… et de la différence qui dérange. Maintenant, la table est mise pour que vous lui lanciez des parties de vous, à votre tour.\n"
      }
    ]
  },
