    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.letrident.com/piece/nessuie-jamais-de-larmes-sans-gants/"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.letrident.com/piece/nessuie-jamais-de-larmes-sans-gants/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "CABARET au Théâtre du Trident"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "3 h 30 avec entracte"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Rasmus fuit son village et l’étouffant nid familial pour se jeter à corps perdu dans sa nouvelle vie à Stockholm, où brille l’espoir d’être enfin lui-même. Benjamin, lui, est déchiré entre le chemin tracé d’avance par son appartenance aux Témoins de Jéhovah et son simple désir d’aimer quelqu’un qui l’aimera en retour. C’est Paul, mère poule pour les gais égarés, qui les réunit par hasard une nuit de Noël. Ils repartent main dans la main sans savoir que leurs pas de deux enfiévrés les mèneront au bord de l’abîme. Que l’un d’eux tombera sous la lame d’une faucheuse que personne ne connaît encore: le sida.\nAlexandre Fecteau, qui avait notamment signé la mise en scène d’Amadeus au Trident, s’attaque ici à un chef d&rsquo;œuvre de la littérature mondiale avec l’audace et l’engagement qu’on lui connaît.\n"
      }
    ]
  },
