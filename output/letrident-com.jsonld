      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "HOSANNA OU LA SHÉHÉRAZADE DES PAUVRES au Théâtre du Trident"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "Information à venir"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Elizabeth Bennet a quatre sœurs et une mère qui ne songe qu’à les marier pour leur assurer un avenir confortable. Quand le jeune, riche et surtout célibataire Mr Bingley vient s’installer dans le voisinage, Mrs Bennet imagine le destin de ses filles scellé, d’autant plus que celui-ci est accompagné de son ami, Mr Darcy, un jeune aristocrate encore plus fortuné. Alors que le fier Darcy irrite la pétillante Elizabeth, la douce Jane vit ses premiers émois amoureux. À travers les bals, le campement de la milice et les manigances de leur mère, les sœurs Bennet découvriront, avec beaucoup d’humour et de complicité, les chemins qui mènent à l’amour.\n"
      }
    ]
  },
