      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "LE PROJET LARAMIE au Théâtre du Trident"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "1h35 sans entracte"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "C’est l’histoire de 4 couples, entre 1989 et 2009, entre l’Allemagne et le Québec. On y évoque la chute du mur de Berlin et son impact sur la vie des gens ordinaires. Les personnages auront à décider de leur avenir. Est-ce qu’on peut croire au hasard ?\n"
      }
    ]
  },
