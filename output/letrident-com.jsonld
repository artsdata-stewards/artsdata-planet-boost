  {
    "@id": "https://www.letrident.com/temporary/4f3e593e-4400-4ba6-aa69-946c379214e6",
    "@type": [
      "http://schema.org/TheaterEvent"
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.letrident.com/wp-content/uploads/2023/10/1392-85-trident-siteweb-1080x900-1.png"
      }
    ],
    "http://schema.org/location": [
