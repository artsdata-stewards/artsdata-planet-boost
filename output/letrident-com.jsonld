      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2013-09-14T00:00:00-04:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2013-10-12T00:00:00-04:00"
      }
    ],
    "http://schema.org/sponsor": [
