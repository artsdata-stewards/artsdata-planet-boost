    "http://schema.org/url": [
      {
        "@id": "https://www.secondcity.com/shows/toronto/mumble-banter-made-up-very-good-tor"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Mumble Banter: Made Up Very Good"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Made Up Very Good is Toronto’s very own, very good improv comedy show!&lt;br /&gt;\nCome hang out, grab a bevy from the bar and spend your Friday laughing your week off as Mumble Banter brings a full hour of sharp, fully improvised comedy! Featuring some of Toronto’s strongest performers as seen on Just For Laughs, CBC, The Beaverton, Second City and more! With special guests, Chesterfield.&lt;/p&gt;\n"
      }
    ],
