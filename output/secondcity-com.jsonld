    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "An Oddyssey"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;“Chicago’s favorite themed stand-up show is back!” &amp;#8211; Every News Outlet Ever&lt;/p&gt;\n&lt;p&gt;An Oddyssesy is a four-week stand-up comedy juggernaut featuring some of Chicago’s most established comedians delivering hilarious stories on their real everyday experiences. Like the Greeks before us, we’re carrying on the tradition of storytelling loudly and proudly.&lt;/p&gt;\n&lt;p&gt;~ Featuring a special DUET Edition the week of April 12.&lt;/p&gt;\n"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
