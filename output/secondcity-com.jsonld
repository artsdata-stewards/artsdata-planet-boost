    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Come see The Second City Mainstage brand new 114th Revue. This is the most exciting time to see a show on our stages. The cast is fresh, new material is worked into the show every night, and your laughter in the audience helps shape the final show!&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Group of 10 or more? We’ll make it easy: &lt;a href=&quot;https://www.secondcity.com/group-events&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Contact Us for Group Events&lt;/a&gt;&lt;/strong&gt;&lt;/p&gt;\n"
