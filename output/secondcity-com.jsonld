    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Stand Up &amp; Complain"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Got something to complain about? This show is half stand-up comedy, half audience participation. Each comedian performs their set, then opens the floor and encourages you to yell out your complaints about anything: work, relationships, life in general, whatever’s been driving you crazy. They’ll respond in real time, roasting, riffing, and finding the funny in whatever’s bothering you.&lt;/p&gt;\n"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
