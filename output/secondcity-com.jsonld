    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Stop and Smell the Bad Decisions"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Bad decisions are in full bloom.&lt;/p&gt;\n&lt;p&gt;Join FUCHSIA at the de Maat Theater every Saturday at 8pm for high-energy, fully unscripted comedy from eight improvisers making chaos out of a single suggestion.&lt;/p&gt;\n&lt;p&gt;Come laugh with us. Bring a friend. Make questionable choices. 🌿😂&lt;/p&gt;\n"
      }
    ],
