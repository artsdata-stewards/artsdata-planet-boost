    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Dr. Show"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Dr. Show guarantees you a one-night fix-up. They say laughter is the best medicine so we&amp;#8217;re gonna shove it down your throats. Select members of Off-Off Campus from the University of Chicago bring you a variety of sketches. Every sketch is set up to be a suggestion for the next. Think of a really long and scripted game of telephone. brrring brrring, Dr. Show&amp;#8217;s office, how can we help you?&lt;/p&gt;\n"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
