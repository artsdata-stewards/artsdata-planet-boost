  {
    "@id": "https://www.secondcity.com/temporary/54d3d828-b635-4348-8dfb-f4e6fb055bb0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-04-14T23:30:00Z"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": ""
      }
    ],
