    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Wheel of Improv"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Chicago’s top comedians battle it out for laughs, glory, and sweet sweet points in an interactive game show, featuring a live studio audience (that’s you!) Performers go head to head in a series of hilarious challenges inspired by classic game shows like The Dating Game and The Price is Right, and current hits like Game Changer and Taskmaster. Wheel of Improv will leave your head spinning &amp;#8211; with laughter!&lt;/p&gt;\n&lt;p&gt;&lt;a href=&quot;https://linktr.ee/wheelofimprov&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Check out our Linktree&lt;/a&gt;&lt;/p&gt;\n"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
