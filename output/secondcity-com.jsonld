    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Ten Dollar Comedy"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Ten Dollar Comedy is a weekly showcase featuring some of Chicago’s best stand-up and improv comedy – all for only $10. &lt;/p&gt;\n&lt;p&gt;This show is produced and hosted each week by Top Dollar Comedy, a rotating cast that has performed all over the world together.&lt;/p&gt;\n&lt;p&gt;The current ensemble includes: Ashley Whitehurst, Carly Olson, Eric Muller, Eric Pedersen, Erin Goldsmith, Jonny Nelson, Peter Corey, &amp;#038; Deanna Ortiz.&lt;/p&gt;\n"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
