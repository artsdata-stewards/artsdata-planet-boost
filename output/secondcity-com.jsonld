    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Low Key Lit is a new comedy show at the world famous Second City, which will feature improv and stand up comedy acts each week. You can expect some of the biggest names in comedy, locally and nationally, to perform in this amazing show. This is more than a comedy show, it is an experience. An experience, you don&amp;#8217;t want to miss.&lt;/p&gt;\n"
      }
