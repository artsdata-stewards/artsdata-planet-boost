    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Dylan Mahaney: The Mom Show"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;With over half a BILLION views, the face of motherhood on TikTok and Instagram is coming to Toronto with an all new show! You know Dylan from CTV, CBC, Just For Laughs Toronto, and his #1 Comedy Album, &amp;#8220;What Is Wrong With You&amp;#8221;, which is featured on SiriusXM.&lt;/p&gt;\n&lt;p&gt;Dylan is back with never told before stories that will make you wonder, is he my mom?&lt;/p&gt;\n"
      }
    ],
