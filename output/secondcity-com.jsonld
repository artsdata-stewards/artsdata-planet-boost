    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "EASTER?! I Hardly Knew Her!"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Sunday nights in April are about to get egg-stra chaotic. 🐣&lt;br /&gt;\nNine quick-on-their-feet comedians take one tiny audience suggestion and scramble it into a fast, feel-good comedy hatch-fest. We crack it open, flip it sunny-side up, and serve it hot with sharp twists and big laughs.&lt;/p&gt;\n&lt;p&gt;It’s high energy. It’s a little unhinged. It’s eggsactly what your Sunday night needs.&lt;br /&gt;\nOne suggestion. Nine friends. No script.&lt;br /&gt;\nLet’s shell-ebrate accordingly. 🥚✨&lt;/p&gt;\n"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
