    "http://schema.org/url": [
      {
        "@id": "https://www.secondcity.com/shows/chicago/improvised-broadway-chi"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Live at the Second City: Improvised Broadway"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;The brainchild of renowned Chicago musician Laura Hall—best known for her work on Whose Line Is It Anyway?—and accomplished performer Lisa McQueen , Improvised Broadway features a powerhouse ensemble of Chicago’s finest musical improvisers. Improvised Broadway is a high-energy, laugh-out-loud musical spectacular created entirely on the spot! Inspired by the structure, style, and sweeping drama of your favorite Broadway hits, this one-of-a-kind show transforms audience suggestions into a brand-new, fully realized musical. It&amp;#8217;s spontaneous. It’s spectacular. It’s Broadway—without the script.&lt;/p&gt;\n&lt;p&gt;Come ready to shout out suggestions and leave humming songs that didn’t exist an hour before.&lt;/p&gt;\n"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
