  {
    "@id": "https://www.secondcity.com/temporary/d89485c6-f645-45e7-a67d-f6f5ebcad652",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-05-03T00:00:00Z"
      }
