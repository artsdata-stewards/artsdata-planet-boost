    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "420 Shakespeare"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;4 professional actors meet to perform a Shakespeare play… but only after one of them takes at least 20mg of you know what, leading to a fun, twisted take on one of the Bard&amp;#8217;s classics. In a nutshell, 4 actors + 20mg = anything can (and Will) happen!&lt;/p&gt;\n&lt;p&gt;*21+ (adult language, sexual humor, reference to drug use, and suggestive elements)&lt;/p&gt;\n"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
