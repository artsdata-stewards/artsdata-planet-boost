    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;A night of improv, sketch, stand-up, music, and magic as faculty and friends of The Second City Training Center show off their talents in this special, one-night-only performance.&lt;/p&gt;\n&lt;p&gt;Use code FREESPACE at checkout for free admission into the show!&lt;/p&gt;\n"
      }
