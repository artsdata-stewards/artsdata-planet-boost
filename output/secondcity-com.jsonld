    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Half-Written Play"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;The Half-Written Play is a highly theatrical improv show for drama geeks everywhere. Five comedians rehearse a classic work of American theatre&amp;#8230; But here&amp;#8217;s the catch: they only have half of the script. Using their wits, props, costumes, and a revolving door of special guests, they will attempt to play out the ending to the best of their ability. Will they get a standing ovation, or the hook?&lt;/p&gt;\n"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
