        "@id": "_:g3399660"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.secondcity.com/shows/toronto/islandography-live-comedy-storytelling-tor"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.secondcity.com/shows/toronto/islandography-live-comedy-storytelling-tor"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Islandography: Live Comedy Storytelling"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Brace yourselves for Justin Shaw’s ISLANDOGRAPHY.&lt;/p&gt;\n&lt;p&gt;Justin Shaw is a comedian and storyteller originally from Prince Edward Island (and if you’re also from Prince Edward Island, his dad probably knows your dad.)&lt;/p&gt;\n&lt;p&gt;Weaving tales of his madcap misadventures across Canada, Justin Shaw is proud to present his comedy storytelling solo show: ISLANDOGRAPHY &amp;#8211; a one hour fish-out-of-water journey comedy filled with big laughs and big feelings from Canada’s smallest province.&lt;/p&gt;\n&lt;p&gt;Don’t miss the down-home hilarity that is Justin Shaw’s ISLANDOGRAPHY.&lt;/p&gt;\n&lt;p&gt;&amp;#8212;&lt;br /&gt;\nABOUT THE ARTIST&lt;br /&gt;\nJustin Shaw has been described as “a slightly caffeinated Stuart McLean” (The Buzz.) Shaw fuses comedy and storytelling to create solo theatre shows that have toured across Canada, with works presented by Theatre Aquarius, Blyth Festival, Charlottetown Festival, and Here For Now Theatre. As a standup comic, he has been featured on JFL42, CBC Laugh Out Loud, Hubcap Comedy Festival, Departure Festival, and has opened for Harland Williams, Fortune Feimster, and is a member of Yuk Yuks official comedy roster. Shaw&amp;#8217;s latest comedy album Mostly Clean showcases his down-home yet outrageous sense of humour, and can be heard on Sirius XM Comedy Club. As a theatre artist, he is a graduate of the National Theatre School of Canada (Acting 2017) and select stage credits include Salt-Water Moon, Nook &amp;amp; Cranny: Twin Detectives, and Culture Shock alongside Lorne Elliott.&lt;/p&gt;\n"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
