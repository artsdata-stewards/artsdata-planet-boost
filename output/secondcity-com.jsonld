      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://platform.secondcity.com/wp-content/uploads/2025/12/Pink-Chicken-1440x823-1.png"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "_:g2796740"
