  {
    "@id": "https://www.secondcity.com/temporary/8458e9b2-d06e-41c9-b105-07f234127419",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
