    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Spotlight at the Second City is a new series from Taylor Hreljac &amp;amp; Gabe Meacher that celebrates sketch comedy&amp;#8217;s best troupes. Each month, The Second City will open its doors to the next generation of sketch by putting the spotlight on two of our favourite sketch troupes. Audiences will get to enjoy a double-header sketch show: two acts, one amazing night of fresh comedy.&lt;/p&gt;\n&lt;p&gt;April&amp;#8217;s show features SPENCER GLASSMAN and BEST BY FAR!&lt;br /&gt;\n&amp;#8212;&lt;/p&gt;\n&lt;p&gt;About the Acts&lt;/p&gt;\n&lt;p&gt;SPENCER GLASSMAN is a bonafide theatre girl showing no signs of slowing. A writer and performer from Toronto she has dazzled audiences across North America, with credits including JFL, Toronto and Montreal Sketch Festivals, Yuk Yuks and the Fun and Dumb Improv Festival at the Brooklyn Comedy Collective. Her one-woman musical sketch show, Child Star, was featured in Brooklyn Magazine and performed in both Canada and New York City. She&amp;#8217;s so excited to bring Amish Famous, directed by Zoe Marin, to Second City.&lt;/p&gt;\n&lt;p&gt;Hot! Fast! Hilarious! BEST BY FAR is ready for their SPOTLIGHT!! When Austin, Brody, and Rachel were asked to perform at the illustrious Second City Toronto, they shit themselves. This is huge. MASSIVE. AND THEY’RE PULLING OUT ALL THE STOPS! ALL THE STOPS!! SO BUCKLE UP BADDIES, because yes it’s just a name BUT we believe. WE ARE BEST BY FAR!! (references and accolades available upon request)&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;&lt;span style=&quot;text-decoration: underline;&quot;&gt;SPENCER GLASSMAN&lt;/span&gt;&lt;/strong&gt;&lt;br /&gt;\n&lt;img loading=&quot;lazy&quot; decoding=&quot;async&quot; class=&quot;alignleft wp-image-24026 size-medium&quot; src=&quot;https://platform.secondcity.com/wp-content/uploads/2025/07/Spencer-Glassman-200x300.jpg&quot; alt=&quot;&quot; width=&quot;200&quot; height=&quot;300&quot; srcset=&quot;https://platform.secondcity.com/wp-content/uploads/2025/07/Spencer-Glassman-200x300.jpg 200w, https://platform.secondcity.com/wp-content/uploads/2025/07/Spencer-Glassman-683x1024.jpg 683w, https://platform.secondcity.com/wp-content/uploads/2025/07/Spencer-Glassman-768x1152.jpg 768w, https://platform.secondcity.com/wp-content/uploads/2025/07/Spencer-Glassman-1024x1536.jpg 1024w, https://platform.secondcity.com/wp-content/uploads/2025/07/Spencer-Glassman-1365x2048.jpg 1365w, https://platform.secondcity.com/wp-content/uploads/2025/07/Spencer-Glassman-1200x1800.jpg 1200w, https://platform.secondcity.com/wp-content/uploads/2025/07/Spencer-Glassman-1400x2100.jpg 1400w, https://platform.secondcity.com/wp-content/uploads/2025/07/Spencer-Glassman-300x450.jpg 300w, https://platform.secondcity.com/wp-content/uploads/2025/07/Spencer-Glassman-scaled.jpg 1707w&quot; sizes=&quot;auto, (max-width: 200px) 100vw, 200px&quot; /&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;&lt;span style=&quot;text-decoration: underline;&quot;&gt;BEST BY FAR&lt;img loading=&quot;lazy&quot; decoding=&quot;async&quot; class=&quot;alignleft size-medium wp-image-24027&quot; src=&quot;https://platform.secondcity.com/wp-content/uploads/2025/07/BestByFar-169x300.png&quot; alt=&quot;&quot; width=&quot;169&quot; height=&quot;300&quot; srcset=&quot;https://platform.secondcity.com/wp-content/uploads/2025/07/BestByFar-169x300.png 169w, https://platform.secondcity.com/wp-content/uploads/2025/07/BestByFar-576x1024.png 576w, https://platform.secondcity.com/wp-content/uploads/2025/07/BestByFar-300x534.png 300w, https://platform.secondcity.com/wp-content/uploads/2025/07/BestByFar.png 750w&quot; sizes=&quot;auto, (max-width: 169px) 100vw, 169px&quot; /&gt;&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;\n"
      }
    ],
