    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Fellowship Thursdays – Free Show"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;&lt;span data-teams=&quot;true&quot;&gt;Use Promo Code: &lt;strong&gt;DeICE&lt;/strong&gt; for Free Admission&lt;/span&gt;&lt;/p&gt;\n&lt;p&gt;Celebrating Bob Curry and Victor Wong Fellows from the beginning to right now. This show is a platform for all performers of color to play, workshop and learn from each other and grow together. Every style of comedy is welcome and we can’t wait to hear your voice.&lt;/p&gt;\n&lt;p&gt;Come watch, come play.&lt;/p&gt;\n&lt;p&gt;Looking to perform in The Fellowship Show? &lt;strong&gt;&lt;a href=&quot;https://forms.cloud.microsoft/r/nKiEwTEi6z&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Register Here&lt;/a&gt;&lt;/strong&gt;&lt;/p&gt;\n"
      }
    ],
