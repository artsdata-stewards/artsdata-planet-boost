    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Horse Always Whinnies"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Dust off your boots and mosey on down. Each week, our sharp-shootin’ cast brings you sketches inspired by the spirit of the Old West. Saloons! Showdowns! Sumptuous mustaches! Horse shenanigans?! Anything can happen, but one thing’s for sure: the West has never been wilder.&lt;/p&gt;\n"
      }
    ],
