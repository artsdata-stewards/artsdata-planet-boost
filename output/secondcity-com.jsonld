    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Toronto Comedy All Stars"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Catch the hottest standups from Toronto’s world class comedy scene at the iconic Second City Toronto! Featuring comedians seen on Just For Laughs, CBC, Crave, Hulu &amp;amp; more!&lt;/p&gt;\n&lt;p&gt;Over the past decade this show has sold out at prestigious venues like the National Arts Centre in Ottawa, Yuk Yuk’s Comedy Club in Toronto &amp;amp; the Gas Station Arts Centre in Winnipeg. Advanced tickets are highly recommended.&lt;/p&gt;\n&lt;p&gt;This show is rated M for Mature. Viewer discretion advised.&lt;/p&gt;\n"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
