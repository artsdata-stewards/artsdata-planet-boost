    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.secondcity.com/shows/chicago/unsolicited-chick-pics-the-kj-chloe-show-chi"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.secondcity.com/shows/chicago/unsolicited-chick-pics-the-kj-chloe-show-chi"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Unsolicited Chick Pics: The KJ &amp; Chloe Show"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Did you ask for this show? No. Are you seeing it anyway? Yes. &amp;#8220;Unsolicited Chick Pics&amp;#8221; is a sketch comedy show that explores the realities of life in 2026 as an &amp;#8220;outcast&amp;#8221; in society. The good, the bad, the ugly, the funny, the stupid, and the absurd.&lt;/p&gt;\n&lt;p&gt;This show brings together the minds of two trans women in comedy: KJ Whitehead (the Queen of Radical Comedy) and Chloe Noteboom (Fox News&amp;#8217; worst nightmare). Along with some friends, they answer a very important question: How else can we piss of those that don&amp;#8217;t think we should exist?&lt;/p&gt;\n"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
  {
    "@id": "https://www.secondcity.com/temporary/fc21bd02-94eb-4907-b9af-253cefaffe20",
