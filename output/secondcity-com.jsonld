  {
    "@id": "https://www.secondcity.com/temporary/a70bb5e2-e545-4c67-ab41-97bfc6f3a26e",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-05-12T23:30:00Z"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": ""
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g3321060"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://platform.secondcity.com/wp-content/uploads/2025/07/SC-TOR-Spotlight-at-SC-Sizes-WEB-Show_Page-Header-1440x823-1.png"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "_:g3321100"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "_:g3321120"
