    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Dumped! A one woman musical"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Dumped, A One-Woman Musical: A comedic musical exploration of Marian Yesufu being dumped.&lt;/p&gt;\n&lt;p&gt;Marian Yesufu has been dumped, healed, laughed, and sang her way through it all — and somehow turned it into art. She presents a one-woman musical piece of art where she and the audience go through a rollercoaster of dumped musical stories to hopefully end with a smidge of healing.&lt;/p&gt;\n&lt;p&gt;Written &amp;amp; Performed by Marian Yesufu&lt;/p&gt;\n"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
