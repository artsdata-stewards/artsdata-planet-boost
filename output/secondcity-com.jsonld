    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Call It A Night Show"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Coming off a hot show run at The Second City, Call It a Night is back! Step into the chaos of late night energy with The Call It a Night Show, a live mashup of sharp-edged sketch comedy and killer stand-up that doesn&amp;#8217;t play it safe. Think the vibe of a classic late-night show, but stripped down, turned up, and injected with bold, modern humor. Every show is a fast-paced ride through absurd sketches, fearless jokes, and unexpected moments that keep the audience on their toes. It&amp;#8217;s smart, it&amp;#8217;s edgy, and it&amp;#8217;s the perfect way to call it a night.&lt;/p&gt;\n"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
