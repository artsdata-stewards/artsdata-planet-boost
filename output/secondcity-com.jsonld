        "@id": "https://www.secondcity.com/shows/toronto/lights-up-for-aya-tor"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Lights Up for AYA"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Join us for an unforgettable evening of comedy, music, live entertainment, and raffle prizes as we celebrate cancer survivorship and raise vital funds in support of the Adolescent and Young Adult (AYA) Program at Princess Margaret. A welcome drink and passed canapés are included in the ticket price with other food items and AYA merchandise available for purchase throughout the evening.&lt;/p&gt;\n&lt;p&gt;Early Bird Pricing: $75 (available until March 25)&lt;br /&gt;\nRegular Pricing: $100 (begins March 26)&lt;/p&gt;\n&lt;p&gt;Pre-Reception: 5:00 pm&lt;br /&gt;\nShow Start Time: 6:30pm (Post-show reception to follow.)&lt;/p&gt;\n&lt;p&gt;Underground Parking available. Parking validation available at the venue.&lt;/p&gt;\n&lt;p&gt;Follow @ayaprogram on Instagram and Twitter&lt;/p&gt;\n"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
