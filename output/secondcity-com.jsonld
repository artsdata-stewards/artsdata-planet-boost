    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Windy City Comedy Fest is a 4 day comedy festival bringing together Chicago’s favorite stand up comics with the best comedic talent from across the country. “Comedy Legends” at the De Maat Theatre will be a standup comedy showcase featuring those most likely to be a household name! &lt;/p&gt;\n"
