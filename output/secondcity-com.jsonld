    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Super Scaries Presents: CRYPTIDS!"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Super Scaries, Chicago’s favorite musical improv horror show is back with Cryptids!, a brand-new improvised musical about the mysterious and scientifically questionable (but legendary) creatures that go bump in the night…or in the woods.  Cryptids! dives into rumor, legend, and folklore, spinning a brand-new tale each night about a totally made-up creature and the chaos it unleashes on the human world. From adorable abominations to town-destroying terrors, no beast is too weird, too cute, or too catastrophic. Will the Killer Kittenchicken become humanity’s new best friend? Or will Rexie the Red Cherry Toad doom an unsuspecting town? Equal parts spooky and ridiculous, Cryptids! is a musical comedy thrill ride about myth, fear, and who really gets to be called the monster.&lt;/p&gt;\n"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
