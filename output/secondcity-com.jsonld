    "http://schema.org/url": [
      {
        "@id": "https://www.secondcity.com/shows/toronto/worlds-collide-tor"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Worlds Collide"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;In Worlds Collide, your favourite characters get smashed together an explosive, unpredictable show. Eight of Toronto’s funniest comedians play characters from fiction, history, pop culture and any other weirdly specific niche they can find. After meeting them, YOU, the audience decide on which characters you want to see do a hilarious improv scene together. Maybe Linda Belcher will be in a pitch meeting with Walt Disney. Maybe Rocky will be roommates with a Muppet. Any pairing can happen, as long as the audience decides it wants to see those Worlds Collide!&lt;/p&gt;\n&lt;p&gt;Worlds Collide is hosted by Maddox Campbell and produced by Kicks and Giggles Entertainment, the same people behind shows that have been making people laugh for years like Perfect Match, The Know Show, and The Resistance: Improvised. You can find more info about Worlds Collide and our other projects at kicksandgigglesentertainment.com&lt;/p&gt;\n"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
