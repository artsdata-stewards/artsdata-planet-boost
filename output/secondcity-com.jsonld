    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.secondcity.com/shows/toronto/comedy-game-show-down-tor"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.secondcity.com/shows/toronto/comedy-game-show-down-tor"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Comedy Game Showdown!"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Featured at FanExpo, Toronto ComiCon, and the Montreal Fringe Festival, Comedy Game Showdown is Toronto&amp;#8217;s longest-running live comedy panel show! Each episode, two teams of Toronto&amp;#8217;s finest comedians face off in a series of quizzes, challenges, and debates to see who will win the game, and with it&amp;#8230;the people&amp;#8217;s ovation and fame forever!&lt;/p&gt;\n&lt;p&gt;April 28: Tales of the City (Urban Legend Theme)&lt;/p&gt;\n&lt;p&gt;From skunk apes to cursed tapes and Mothman to death by fan, anything and everything in the wide world of urban legends might come up as our two teams of comics face off to see who wins the Elevator Game and who wakes up in a bathtub full of ice!&lt;/p&gt;\n&lt;p&gt;The Cryptids: Nikki Ashworth, Ada Nicolle, George Burgess&lt;/p&gt;\n&lt;p&gt;The Yokai Watchers: Ted Morris, Sebastian D. Chow, Lily Langen&lt;/p&gt;\n&lt;p&gt;Hosted by Dan Donnelly&lt;/p&gt;\n"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
