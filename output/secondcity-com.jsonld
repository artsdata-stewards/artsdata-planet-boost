    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.secondcity.com/shows/chicago/rpg-13a-role-playing-improv-comedy-show-chi"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "RPG-13:A Role Playing &amp; Improv Comedy Show"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Hello Travelers! Welcome to RPG-13, the comedy company that combines role playing games with improvisation: where fate and funny collide! Join our Tavern Keeper, as they invite a volunteer from the audience onstage (maybe you!), and will help you create your very own role playing adventure! With the help of our Game Master and company of Adventurers, you will create your character, pick which Adventurer will play your character, and discover the location and genre of your adventure. However, as the story unfolds, the random roll of the dice will be the deciding factor on how well everything goes. Roll a 20, a glorious success! Roll a 1, a hilarious disaster! Join us to create your adventure onstage, where you and the roll of the dice have all the possibilities!&lt;/p&gt;\n"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
