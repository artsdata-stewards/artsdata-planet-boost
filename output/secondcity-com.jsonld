    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Ante Up hosted by Lavalier Improv"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Go All-In on longform improv with host team Lavalier. Six teams play for a chance to win completely worthless prizes awarded by our esteemed panel of improv judges, followed by a performance by the judges themselves. Seven teams, six weeks, two hours of hilarious improv comedy. Nothing has been scripted or prepared in advance. It will all be made up before your very eyes!&lt;/p&gt;\n"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
