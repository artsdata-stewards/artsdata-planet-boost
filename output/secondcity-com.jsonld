    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Looking for an hour of ads-free comedy? Nothing today is free unless you Like and Swigscribe. In this fast-paced two person sketch show you&amp;#8217;ll embark on a twisted ride that is the modern pill-popping American fever dream. Like and Swigscribe, a comedy show that feels like scrolling at 2 AM.&lt;/p&gt;\n"
      }
