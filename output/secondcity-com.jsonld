    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "House of Improv"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Here for a fun and memorable time? House of Improv is a showcase of 3 of the most exciting and celebrated improv teams we know of. This one hour showcase will have you howling with laughter, and in awe at their cohesiveness. Good improv really is magic. Served up in classic, Chicago scenic-style improv.&lt;/p&gt;\n"
      }
    ],
