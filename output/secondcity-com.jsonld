    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Improvised Sitcom"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Every week, a brand-new sitcom is born — live, unscripted, and based entirely on your suggestions. Chicago’s finest improvisers bring you secret crushes, nosy neighbors, wild misunderstandings, and over-the-top schemes — all the classic sitcom chaos you love, made up on the spot. No scripts. No reruns. Just nonstop laughs!&lt;/p&gt;\n"
      }
    ],
