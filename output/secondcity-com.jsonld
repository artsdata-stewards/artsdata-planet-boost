    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Delusions of Adequacy is a character-driven sketch show about people performing authenticity in an age of algorithms. As identity becomes branding and connection becomes content, everyone insists they’re self-aware, evolved, and exceptional. The problem is, they’re usually wrong.&lt;/p&gt;\n"
      }
