    "http://schema.org/url": [
      {
        "@id": "https://www.secondcity.com/shows/chicago/no-grown-ups-allowed-chi"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "No Grown-Ups Allowed"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Kids, are you tired of grown-ups constantly telling you what to do? When to wake up, when to do homework, even making you do chores?! Well, on Saturdays at the Second City, it’s the kids’ turn to run the world! In this high-energy and fast-paced sketch and improv show, kids give all the ideas and even get the chance to get onstage! *Grown-ups are absolutely allowed because kids can’t drive or pay for tickets (the Tooth Fairy has not kept up with the pace of inflation.)&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Group of 10 or more? We’ll make it easy: &lt;a href=&quot;https://www.secondcity.com/group-events&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Contact Us for Group Events&lt;/a&gt;&lt;/strong&gt;&lt;/p&gt;\n"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
