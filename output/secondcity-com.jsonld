    "http://schema.org/url": [
      {
        "@id": "https://www.secondcity.com/shows/toronto/cowbell-comedy-presents-canadian-famous-tor"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Cowbell Comedy presents Canadian Famous"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Join us at the iconic Second City&amp;#8217;s John Candy Box Theatre for a night filled with Canadian talent and entertainment. Come witness the best of Canadian Standup comedy with a lineup of professional comedians, curated by seasoned stand-up veteran Braydon Lynch (Just For Laughs, Edinburgh Fringe Festival, San Francisco Comedy Competition)&lt;/p&gt;\n&lt;p&gt;No Rules, No Filters, Just Funny..&lt;/p&gt;\n&lt;p&gt;Brought to you by the folks at Cowbell Comedy.&lt;/p&gt;\n&lt;p&gt;Cowbell Comedy strives to raise the bar for live stand-up, bringing audiences world-class talent, premium shows, and an unforgettable experience.&lt;/p&gt;\n&lt;p&gt;More Laughs, More Comedy, More Cowbell..&lt;/p&gt;\n&lt;p&gt;Braydon Lynch @braydonlynch (Edinburgh Fringe, Just For Laughs Toronto)&lt;br /&gt;\nAnjelica Scannura @scanooch (Just For Laughs, Boston Comedy Festival)&lt;br /&gt;\nTyler Morrison @tylermorrison123 (Just For Laughs, Roast Battle)&lt;br /&gt;\nKeith Pedro @keithpedro (Kevin Harts LOL Network, Just For Laughs)&lt;/p&gt;\n&lt;p&gt;**Line-up subject to change.&lt;/p&gt;\n"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
