    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "CELEBRASIAN: An Asian Heritage Month Comedy Show!"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Come celebrate Asian Heritage month with some of the BEST Stand up comedians in the country. Their parents might be disappointed in them but you won’t be! Our comics have been on TV! They’ve been viral! They’ve appeared on Just for Laughs, Roast Battles, This Hour has 22 Minutes, TallBoyz, Crave, CTV, CBC and more!&lt;/p&gt;\n"
      }
