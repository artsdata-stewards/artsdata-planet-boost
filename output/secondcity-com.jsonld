    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Blockbuster? Blockbuster!"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;We come to this place&amp;#8230; for magic. We come to the de Maat theatre to laugh, to cry, to care.  All of Hollywood’s greatest hits get twisted, smashed, and deranged as we search for the next great blockbuster.  Grab your popcorn and join Chicago’s finest sketch and improv performers for a night at the movies. You’ll laugh! You’ll cry!  But somehow, heartbreak feels good in a sketch show like this.&lt;/p&gt;\n"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
