    "http://schema.org/url": [
      {
        "@id": "https://www.secondcity.com/shows/toronto/first-drafts-at-the-second-city-toronto-tor"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "First Drafts at The Second City Toronto"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;First Drafts at Second City goes LIVE with 2 table reads of the funniest NEW scripts from across Canada!&lt;/p&gt;\n&lt;p&gt;Join us for an evening behind the scenes as Toronto&amp;#8217;s top performers take the wheel on these hidden-gem comedy scripts. Could one of these be Canada&amp;#8217;s next great TV comedy? Plus: Guest stars, sneak peeks, and more.&lt;/p&gt;\n&lt;p&gt;And the best part? It&amp;#8217;s FREE. (But every laugh goes to support the artists ❤️) USE PROMO CODE &amp;#8220;FREE&amp;#8221; at checkout.&lt;/p&gt;\n"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
