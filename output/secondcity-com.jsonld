    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Best of The Second City: Chicago Style"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;The Best of The Second City: Chicago-Style is a fast-paced sketch and improv comedy revue from The Second City featuring classic scenes from its legendary archives alongside fresh material from today’s ensemble. Blending sharp satire, iconic characters, and spontaneous audience-driven improv, it delivers a high-energy night of quintessential Chicago comedy.&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Group of 16 or more? We’ll make it easy: &lt;a href=&quot;https://www.secondcity.com/group-events&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Contact Us for Group Events&lt;/a&gt;&lt;/strong&gt;&lt;/p&gt;\n"
      }
    ],
