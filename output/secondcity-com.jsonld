  {
    "@id": "https://www.secondcity.com/shows/chicago/rudolph-runs-wild-chi",
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Rudolph Runs Wild - The Second City"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Share silliness this holiday season with The Second City's Rudolph Runs Wild… a jolly extravaganza for kids, parents, grandparents, aunts, uncles, and reindeer of all ages!"
      }
    ],
    "http://ogp.me/ns#url": [
      {
