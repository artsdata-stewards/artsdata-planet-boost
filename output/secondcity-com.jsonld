    "http://schema.org/url": [
      {
        "@id": "https://www.secondcity.com/shows/chicago/swiped-improvised-thievery-chi"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "SWIPED Improvised Thievery"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Are you ready for some heist-jinks? SWIPED Improvised Thievery’s crew of comedic criminals perform a 55-minute improvised longform set that pays homage to the highs and lows of the heist genre. All we need to get started is a suggestion of what outrageously valuable thing you’d like us to steal and the heist begins. SWIPED features loving references and tropes from your favorite heist media. Before your eyes, we’ll meet our mastermind, build their crew, and see what dangerous obstacles they must overcome to walk away with the prize.&lt;/p&gt;\n"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
