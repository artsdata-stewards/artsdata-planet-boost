    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Gluten Free Comedy"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Mamas world famous Gluten Free Comedy Show is coming back to prime time with an all star line up of some of Canada’s top comics!  A dairy free gluten alternative comedy  showcase!&lt;/p&gt;\n&lt;p&gt;This is a celebration of comedy, gluten free, gluten based, non stop action and hilariously fun comedy served to you!&lt;/p&gt;\n&lt;p&gt;Come catch one of Canada’s premier comedy shows, Gluten Free Comedy, 5 years running, April 18th, 8:30 1 York st at Second City Toronto! &lt;/p&gt;\n&lt;p&gt;No bun all jokes Gluten Free Comedy&lt;/p&gt;\n&lt;p&gt;D.J. Demers (headliner)&lt;/p&gt;\n&lt;p&gt;One More Time (2024)&lt;/p&gt;\n&lt;p&gt;The Tonight Show Starring Jimmy Fallon,&lt;/p&gt;\n&lt;p&gt;Conan,&lt;/p&gt;\n&lt;p&gt;America&amp;#8217;s Got Talent &lt;/p&gt;\n&lt;p&gt;Sam Burns &lt;/p&gt;\n&lt;p&gt;Icebreakers Comedy Festival, The Big Three and Departure Breakout showcase  &lt;/p&gt;\n&lt;p&gt;Host Ben Norman Davies&lt;/p&gt;\n&lt;p&gt;Gluten Free Comedy Tour, Fragile and Proud, Northern Lights Comedy Festival, Second City Alumni&lt;/p&gt;\n&lt;p&gt;And more! &lt;/p&gt;\n"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
