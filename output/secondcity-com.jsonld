      {
        "@language": "en",
        "@value": "Compass Party: Second City’s Improv Ensemble Night"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Compass Party is a night of improvisation and comedic acts put on by some of our most talented and up-and-coming improvisers from the Training Center.  Each ensemble presents a mix bag of short form and long form structured improv sets and is coached by one of our incredible faculty members!&lt;/p&gt;\n"
      }
