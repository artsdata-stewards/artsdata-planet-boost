      {
        "@language": "en",
        "@value": "Explore Our New Season! Tickets & Subscription Packages Now Available!"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Discover a year of unforgettable live chamber music experiences within our new season! From captivating solo recitals to duos, trios, and dynamic chamber ensembles, this new season of fourteen concerts delivers the powerful performances you’ve come to expect from high-calibre classical music artists, including three performances featuring our 2025/26 Musician-in-Residence, prize-winning cellist Bryan Cheng. Whether you're a longtime concert-goer or are new to the series, there’s something for everyone to love!"
      }
    ],
