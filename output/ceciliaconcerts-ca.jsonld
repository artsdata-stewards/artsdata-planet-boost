        "@value": "\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t \n\t\t\t\t\t\t\t\t\t\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"WebPage\",\n  \"@id\": \"https://www.ceciliaconcerts.ca/#webpage\",\n  \"url\": \"https://www.ceciliaconcerts.ca/\",\n  \"name\": \"Cecilia Concerts | Halifax, Nova Scotia\",\n  \"description\": \"Cecilia Concerts presents concerts in Halifax, Nova Scotia — from classical music to genre-defying artists and sensory-accessible performances by award-winning Canadian musicians.\",\n  \"inLanguage\": \"en-CA\",\n  \"isPartOf\": {\n    \"@type\": \"WebSite\",\n    \"@id\": \"https://www.ceciliaconcerts.ca/#website\",\n    \"url\": \"https://www.ceciliaconcerts.ca/\",\n    \"name\": \"Cecilia Concerts\",\n    \"publisher\": {\n      \"@id\": \"https://www.ceciliaconcerts.ca/#organization\"\n    }\n  },\n  \"mainEntity\": {\n    \"@id\": \"https://www.ceciliaconcerts.ca/#organization\"\n  }\n}\n\n\n\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"Organization\",\n  \"@id\": \"https://www.ceciliaconcerts.ca/#organization\",\n  \"name\": \"Cecilia Concerts\",\n  \"url\": \"https://www.ceciliaconcerts.ca/\",\n  \"logo\": \"https://www.ceciliaconcerts.ca/wp-content/uploads/2023/10/Cecilia-Concerts-Halifax-Classical-Music-Logo.png\",\n  \"description\": \"Cecilia Concerts is a Halifax-based non-profit that presents concerts by award-winning musicians in welcoming, bilingual, and accessible venues across the city.\",\n  \"sameAs\": [\n    \"https://www.facebook.com/ceciliaconcerts/\",\n    \"https://www.instagram.com/ceciliaconcerts/\",\n    \"https://www.tiktok.com/@ceciliaconcerts\",\n    \"https://bsky.app/profile/ceciliaconcerts.bsky.social\",\n    \"https://www.threads.net/@ceciliaconcerts\"\n  ],\n  \"contactPoint\": {\n    \"@type\": \"ContactPoint\",\n    \"telephone\": \"+1-902-423-0143\",\n    \"contactType\": \"General Inquiries\",\n    \"areaServed\": \"CA\",\n    \"availableLanguage\": [\"English\", \"French\"]\n  },