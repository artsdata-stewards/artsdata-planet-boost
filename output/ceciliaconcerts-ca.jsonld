      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Everybody needs music. It builds community and contributes to a sense of health and well-being. But the way live concerts are traditionally presented means they are not always very friendly or accessible to everyone. Sensory-Accessible Concerts, presented by Cecilia Concerts in partnership with Halifax Public Libraries, feature free classical music programs purposely-crafted and curated to be welcoming, friendly, and accessible for autistic, neurodivergent, and intellectually disabled community members of all ages."
      }
    ],
