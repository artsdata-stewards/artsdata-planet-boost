    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Applause 5 Concert Package&lt;br&gt;Save 15% Off"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Our ENCORE Concert Package includes admission to 8 of our 2018/19 regular series concerts (they begin September 2018), with a savings of 20% OFF our regular ticket prices. Booking is as easy as selecting your package and concert options below, and choosing any additional special presentation concerts you’d like to add. You will receive your tickets in the mail via Canada Post within two weeks of placing your order. Patron ticket holders will receive a $170 tax-deductible charitable gift receipt in addition to their tickets.\r\n\r\nPackages do not include tickets to special presentations unless selected as additional concerts."
      }
    ]
  },
