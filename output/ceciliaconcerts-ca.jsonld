    "https://schema.org/mainContentOfPage": [
      {
        "@language": "en",
        "@value": "\n\t\t\t\t\nMake a Donation\n\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"WebPage\",\n  \"url\": \"https://www.ceciliaconcerts.ca/donate-now/\",\n  \"name\": \"Donate Now • Cecilia Concerts | Halifax, Nova Scotia\",\n  \"description\": \"Make a secure, tax-deductible donation to Cecilia Concerts. Your gift helps us present accessible, high-quality chamber music performances and educational programs in Halifax, Nova Scotia.\",\n  \"inLanguage\": \"en-CA\",\n  \"isPartOf\": {\n    \"@type\": \"WebSite\",\n    \"url\": \"https://www.ceciliaconcerts.ca/\",\n    \"name\": \"Cecilia Concerts\"\n  },\n  \"mainEntity\": {\n    \"@type\": \"Organization\",\n    \"name\": \"Cecilia Concerts\",\n    \"url\": \"https://www.ceciliaconcerts.ca/\",\n    \"logo\": \"https://www.ceciliaconcerts.ca/wp-content/uploads/2023/10/Cecilia-Concerts-Halifax-Classical-Music-Logo.png\",\n    \"description\": \"Cecilia Concerts is a Halifax-based non-profit that presents concerts by award-winning musicians in welcoming, bilingual, and accessible venues across the city.\",\n    \"sameAs\": [\n      \"https://www.facebook.com/ceciliaconcerts/\",\n      \"https://www.instagram.com/ceciliaconcerts/\",\n      \"https://www.tiktok.com/@ceciliaconcerts\",\n      \"https://bsky.app/profile/ceciliaconcerts.bsky.social\",\n      \"https://www.threads.net/@ceciliaconcerts\"\n    ],\n    \"contactPoint\": {\n      \"@type\": \"ContactPoint\",\n      \"telephone\": \"+1-902-423-0143\",\n      \"contactType\": \"Donations Support\",\n      \"areaServed\": \"CA\",\n      \"availableLanguage\": [\"English\", \"French\"]\n    },\n    \"address\": {\n      \"@type\": \"PostalAddress\",\n      \"streetAddress\": \"6199 Chebucto Road\",\n      \"addressLocality\": \"Halifax\",\n      \"addressRegion\": \"NS\",\n      \"postalCode\": \"B3L 1K7\",\n      \"addressCountry\": \"CA\"\n    }\n  }\n}\n\t\t\t"
