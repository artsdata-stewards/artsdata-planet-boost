  {
    "@id": "https://www.blackouttheater.com/nextprojects/tiresias",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "TIRESIAS | Vancouver Theatre | Blackout Art Society"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "A sex-positive, musical comedy cabaret created by Pulsive Party (Ashley Whitehead & Natalie Tin Yin Gan). Big laughs, bold bodies, and vulva alter-egos who just won't quit."
      }
    ],
    "http://ogp.me/ns#image": [
