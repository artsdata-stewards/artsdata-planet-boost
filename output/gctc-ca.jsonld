    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "In this riveting sequel to  The Last Wife , playwright Kate Hennig takes us on a gritty exploration of&nbsp; victim shaming, sexual awareness, and female empowerment as she reimagines the scandalous story of young Elizabeth I as a modern day crime drama."
      }
    ],
