    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Gracie’s world is full of faith and family, but as a fifteen year-old in a polygamous community, she feels increasing pressure to conform. With deep empathy and compassion, the playwright takes us into young Gracie’s world, where we discover what it’s like to grow up in an uncommon environment."
      }
    ],
