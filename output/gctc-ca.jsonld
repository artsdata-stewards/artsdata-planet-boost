    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "For each of GCTC’s mainstage productions in the 2017-18 season, a pop-up restaurant will form in GCTC’s lobby for one night only during the run. Each pop-up restaurant will be led by one of Ottawa’s most renowned executive chefs and feature a creative prix fixe menu inspired by the play on our stage"
      }
