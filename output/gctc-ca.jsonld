    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The lawyers are back and the con is on. 2022’s CCLA/GCTC Lawyer Play is  The Sting , adapted from David Ward’s Oscar-winning screenplay by David Rogers. Will Hooker’s scheme pay off, or will Lonnegan get wise to the game? Find out on GCTC’s Main Stage, June 21 - 25, 2022."
      }
    ],
