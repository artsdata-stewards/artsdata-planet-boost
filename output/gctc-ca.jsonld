    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The Piano Teacher  is dotted throughout with musical excerpts from the classical and jazz traditions. Join local pianist, sound designer, and piano teacher Ali Berkok in an informative, entertaining, and spoiler-free pre-show talk, taking a deeper dive into some of the play's musical&nbsp;touchp"
      }
