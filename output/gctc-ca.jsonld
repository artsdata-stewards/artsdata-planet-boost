    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "by Rachel Mutombo    directed by Dian Marie Bridge    a GCTC co-production with Black Theatre Workshop    Sixteen-year-old Divine’s only real friend is Jesus. When her family joins a new church she learns that the world around her is not as it seems. With heart and humour,  Vierge  follows four Cong"
      }
    ],
