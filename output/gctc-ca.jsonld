    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Here's the deal:  A show is cast confidentially, and cast members meet only on the night of the performance when the musical is revealed to the audience.  It's an unparalleled experience for the actors and audience alike.  That's the Confidential Musical Theatre Project!  (CMPT)"
      }
    ],
    "http://ogp.me/ns#image": [
      {
