    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "A multimedia experience, Propeller Dance’s “Frame of Mind” features three videos, each exploring the theme of mental health through dance. With work from Cara Spooner, Ed Hanley, Jesse Stewart, and Shara Weaver, these videos offer viewpoints on mental health, bringing awareness to societal barriers"
      }
    ],
