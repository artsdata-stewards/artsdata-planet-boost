    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Why sing by yourself when you can sing with others, online? GCTC is testing an online choir concept. We’re working with Saeideh Rajabzadeh, musician and uOttawa student, to create a choir just for our community, and get this: GCTC staff will be participating!"
      }
