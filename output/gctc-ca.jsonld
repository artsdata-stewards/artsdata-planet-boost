    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Can what is torn apart by war be put back together? From the award-winning writer of  Gas Girls  and  Sound of the Beast ,  The First Stone  is an epic-yet-intimate examination of violence and forgiveness. During the Ugandan Civil War, two children are captured into an army, while their father fight"
      }
    ],
