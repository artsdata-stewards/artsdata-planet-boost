        "@value": "https://www.gctc.ca/shows/cottagers-and-indians"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "When Indigenous farmer Arthur Copper begins planting wild rice to reclaim lakeshores, the seeds bloom into a funny-yet-fiery exchange between the farmer and a white cottager, Maureen Poole. The confrontation traces issues of ownership and community."
      }
    ],
