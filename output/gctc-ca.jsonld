    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The Revue is a folk music presentation like no other, featuring original music from celebrated local artists traversing the long line of folk music, from pre-war ragtime and blues, to modern singer-songwriter ballads. Blend in a healthy dose of banter, hokum and playful ribbing, and you have The Rev"
      }
    ],
