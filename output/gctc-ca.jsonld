    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Join Propeller Dance and GCTC the week of June 6th in a joyful celebration of Ian Dury’s birthday, of his riotous disability anthem, “Spasticus Autisticus,” and of the disability justice movement. This show is available on-demand for the entire week!"
      }
