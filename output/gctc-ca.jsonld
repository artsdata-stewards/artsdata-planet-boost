    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Lawyer Play 2024 - Goodnight Desdemona (Good Morning Juliet) — GCTC | Great Canadian Theatre Company"
      }
    ],
    "http://ogp.me/ns#latitude": [
      {
        "@language": "en-us",
