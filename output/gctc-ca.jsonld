    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "“Heartlines” traces the interaction of love, art, and war as it reimagines the lives of French surrealist and avant-garde artists Lucy Schwob (a.k.a. Claude Cahune) and Suzanne Malherbe (a.k.a. Marcel Moore), who were secretly Jewish, lesbian life partners, active in the French Resistance during the"
      }
    ],
