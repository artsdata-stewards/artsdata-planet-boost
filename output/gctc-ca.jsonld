    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "“Swatow women are supposed to be fierce.”   That’s what Grandmother tells her daughter. Grandmother’s a butcher and to her disappointment, her daughter’s a vegetarian. But to her satisfaction, her granddaughter killed her first chicken at the age of three."
      }
