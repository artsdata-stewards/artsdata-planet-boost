    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Helen wanders through a Middle Eastern city looking for a lost pearl necklace. In language as shimmering as the strand of pearls itself—its value isn’t what we initially think—Fréchette brings Helen into contact with a series of people, from a friendly taxi driver to a distraught mother and an angri"
      }
