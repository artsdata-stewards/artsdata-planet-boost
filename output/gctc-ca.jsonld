    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Determined to help her brother find some kind of happiness, Bridget searches grocery stores looking for his potential wife. A dark comedy about millennial love, sibling loyalty, conformity and an uncomfortably close shave."
      }
    ],
