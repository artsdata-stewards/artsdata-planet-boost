    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "In an imaginary letter to an absent older brother, Braidie struggles to understand the torture and killing of a teenage girl by a group of her school-mates. MacLeod’s young protagonist enters all the bright open avenues of peer-group play and the dark blind alleys of individual and collective terror"
      }
    ],
