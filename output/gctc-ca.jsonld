    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Guilt is a new play by Diane Flacks ( Unholy ), a tour through the many facets of guilt performed live from her own living room. It explores the perspective of a self-sacrificing mother who is also an instigator of family dissolution."
      }
    ],
