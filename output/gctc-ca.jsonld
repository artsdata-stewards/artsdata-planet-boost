    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Unbridled Futurism  -  A Sci-Fi Comedy Rock Show     January 19, 2024 at 8 PM    Tickets: $23  (+ $2 online booking fee per order)    Captain Nick Di Gaetano is an astronaut from an advanced parallel Earth and the only known human to travel at the Speed of Light. Encountering a spacetime anomaly on"
      }
