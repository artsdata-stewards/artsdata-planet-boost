    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Joys and Splendors    a spy thriller in podcast form by Kate Werneburg.     Joys and Splendors is the gripping political intrigue of a soldier and a spy attempting to survive through a Canada devastated by war and greed. Through the eyes of these two sides of one coin, the drama asks: do some deserv"
      }
