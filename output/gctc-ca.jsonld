    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Lila is a Black former police officer whose career ended after she shot an unarmed Black youth. Her story is fictionalized by Tim, a white playwright whose play about the shooting takes liberties with the facts. Now there’s talk of a film, and Tim visits Lila to discuss. What unfolds is a raucous st"
      }
