    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Anchored in a poignant moment—adult siblings dealing with their parents’ estate—the play flashes through the many stages of sibling history, from infancy through the rich miseries of growing up, the alien landscape of adolescence and teen years, the inevitable confusions of adulthood."
      }
    ],
