    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Fuelled by equal parts outrage, intelligence and wit,  Fronteras Americanas  re-creates one person’s struggle to construct a home between two cultures, while exploding the images and constructs built up around Latinos and Latin America."
      }
