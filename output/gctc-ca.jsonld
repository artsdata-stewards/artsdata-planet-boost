    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "She wants to keep everything. He wants to throw it all away! Is she a pack rat? Is he a monster? This hilarious and highly addictive couple wants you to decide.&nbsp;  “Baram and Snieckus are as much fun as you can have without taking your clothes off”. - Toronto Star.   You’ll laugh, you’ll cry"
      }
    ],
