    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "In a Jewish ghetto at the height of the Second World War, a group of youths plot what will become known as the Warsaw Ghetto Uprising, while coming of age. This sharp comedy from Darrah Teitel ( Behaviour, The Apology ) is a story of youth, revolution, and betrayal in Poland, 1943 as these young soc"
      }
    ],
