      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "In this witty, wild, and very relevant debate, four female panelists square off on one question: should women abandon religion? On one side, an ex-nun and an atheist pundit. On the other, a progressive Muslim lawyer and a Jewish scholar. As the play delves into the depths of the question, it reveals"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-us",
