    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "When Mimi’s date for the evening fails to show up, one willing audience member is invited to step into his shoes! What happens next is a thrilling, unscripted theatrical adventure offering a unique experience for the artist and audience each night — you’ll want to see it more than once! Adults only,"
      }
    ],
