    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "A journey to Ottawa’s vibrant past through music, story and dance: Buckle up for a wild and groovy romp through time to Ottawa’s music and nightlife scenes of the 1940s, 50s and 60s. Along the way, you’ll make stops at three legendary, now nearly forgotten venues: the Trocadero, the Chaudière and Le"
      }
