    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "When big city radio host Charlie King is forced to take a job managing a small town station, he has no idea what’s in store! Not only does a pandemic begin his first week in Port Belette, but he quickly finds himself chasing a story of municipal corruption. From the writer of  Bed and Breakfast  com"
      }
