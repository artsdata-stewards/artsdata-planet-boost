    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Here's the deal :&nbsp; A show is cast confidentially, and cast members meet  only  on the night of the performance when the musical is revealed to the audience.&nbsp; It's an unparalleled experience for the actors and audience alike.&nbsp; That's the Confidential Musical Theatre Project"
      }
    ],
