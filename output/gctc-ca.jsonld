      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "After years of silence, francophone Gaston Talbot can finally speak again. The only problem is all his words are coming out in the wrong language. Written in French but with English words; a show that questions whether language brings us closer to the truth—or further from it?"
      }
    ],
