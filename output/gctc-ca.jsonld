        "@language": "en-us",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "A haunting play about three brides who share two things in common: they all married the same man, and they are all dead. Emerging from their clawfoot bathtubs, Bessie, Alice and Margaret share the evidence against a murderous man in a chilling ghost story that recounts the shocking crimes."
      }
    ],
