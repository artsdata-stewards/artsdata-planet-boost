    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Starting a better life in Canada is a dream for many immigrants, but for Daphne the decision presents an unthinkable sacrifice. This is a story of separation and reconciliation infused with a bold original score that blends gospel, reggae and R&amp;B with classical music."
      }
    ],
