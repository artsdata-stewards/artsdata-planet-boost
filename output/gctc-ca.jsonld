    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Seventeen years ago, Isobel was murdered at the tender age of nine. Now she finds herself back in her previous life as a ghost searching for the person responsible for her untimely death. But this time she’s powerful, having the ability to watch over the living, observe them, and sometimes interact"
      }
    ],
