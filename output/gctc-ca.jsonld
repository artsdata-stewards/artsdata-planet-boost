    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The GCTC Bowl-a-thon is back!.  Join&nbsp;a team for an exciting evening of fundraising, bowling, and prizes, or show your support by making a donation.  Then join us after bowling for a party at the Royal Oak.  Date: September 18, 2025, 5:30PM Location: West Park Bowling"
      }
    ],
