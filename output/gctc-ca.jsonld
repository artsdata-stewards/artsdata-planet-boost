      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Speaking Vibrations is the next evolution of theatre: an immersive, inclusive and multi-sensory experience in ASL song/poetry, music, rhythm tap &amp; dance.  what happens when I come into contact with a body in all its forms? when I see in my feet, hear in my hands and speak in vibrations?"
      }
    ],
