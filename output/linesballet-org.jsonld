    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Don't miss a landmark world premiere with acclaimed bassist, vocalist, and composer esperanza spalding, joining the dancers LIVE each performance; and experience a joyful return to the acclaimed \"Ode to Alice Coltrane.\""
      }
    ],
