    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "LINES Ballet Family Experience"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Guided by our LINES Ballet\\'s Teaching Artists, families with children ages 4–12 will connect with choreographer Alonzo King’s work and philosophy while moving, grooving, and collaborating to create dances all their own. Families will also get a sneak peek of the company dancers in rehearsal on stage. &lt;/p&gt;\\n"
      }
    ],
