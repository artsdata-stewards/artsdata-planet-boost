        "@value": "LINES DAY | Las Vegas"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Experience LINES Ballet's transformative approach to dance training during this one-day intensive in Las Vegas. Work directly with former or current LINES Ballet Company members. LINES DAY is also offered as a part of our 2026 Summer Program audition processes. "
      }
    ],
