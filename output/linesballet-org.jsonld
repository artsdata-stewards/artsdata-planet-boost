    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "LINES Ballet in Vail"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Experience our exquisite company dancers LIVE at Gerald Ford Amphitheatre during Vail Dance Festival performing two of Alonzo King\\'s recent works: &quot;Ode to Alice Coltrane&quot; and &quot;Ma Mére L’oye (Mother Goose).&quot;&lt;/p&gt;\\n"
      }
    ],
