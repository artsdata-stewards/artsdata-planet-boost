  {
    "@id": "https://elmeriselersingers.com/temporary/c9444bc7-01b7-430f-90dc-33f4cf65f9e3",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.elmeriselersingers.com/events/conductors-workshop/"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2024-05-11"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2024-05-11"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g2048460"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.elmeriselersingers.com/events/conductors-workshop/"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "EIS Conductors Workshop"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "The Elmer Iseler Singers, a 20-voice professional chamber choir based in Toronto, and EIS Artistic Director Lydia Adams are pleased to announce a workshop opportunity for emerging conductors on Saturday, May 11th, 2024 from 1:00 - 4:00 p.m. at the Canadian Music Centre, 20 St. Joseph St., Toronto.\r\n\r\nThis initiative will showcase Canadian choral compositions, and works presented will be chosen through consultation with the conductors and Lydia Adams, Artistic Director of the EIS.\r\n\r\nConductors will have the opportunity to interact with the choir and Lydia Adams on the clarity and focus of their technique, their understanding of the work, sound colour painting, and their ability to bring their chosen choral work to life.\r\n\r\nThis is the final of three educational workshops the Elmer Iseler Singers are presenting during the 2023-2024 concert season and we look forward to the thrill of working with these fine emerging choral artists.\r\n\r\n\r\n\r\nThere is no charge to conductors for this workshop opportunity. The Elmer Iseler Singers are pleased to welcome the generous support of the Takla Foundation as primary sponsors of this educational initiative.\r\n\r\n\r\n\r\n\r\n\r\nBy invitation, limited spacing, interested parties may apply by email to info@elmeriselersingers.com\r\n\r\nMore information TBD."
      }
    ]
  },
