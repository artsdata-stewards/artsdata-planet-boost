    "http://schema.org/name": [
      {
        "@value": "CANCELLED: Strawberries &#038; Champagne"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "CANCELLED: In response to Covid-19\r\n\r\nEnjoy the beautiful and intimate setting of the Toronto Hunt Club on Lake Ontario, participate in our amazing spring silent auction and spend a delightful musical afternoon with Canada’s Elmer Iseler Singers, Lydia Adams, conductor.\r\n\r\nIf you are unable to join us, please consider making a donation with your ticket order.\r\n\r\nFor tickets or more information, please email info@elmeriselersingers.com or call 416-217-0537."
      }
    ]
