    ],
    "http://schema.org/name": [
      {
        "@value": "Strawberries &#038; Champagne at the Lake"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Enjoy the beautiful and intimate setting of the Toronto Hunt Club on Lake Ontario, participate in our amazing spring silent auction and spend a delightful musical afternoon with Canada’s Elmer Iseler Singers, Lydia Adams, conductor.\r\nTickets for Strawberries & Champagne at the Lake\r\n\r\nThis year we celebrate 25-years with Lydia Adams as Conductor and Artistic Director of the Elmer Iseler Singers!\r\n\r\nProceeds from this annual fundraising event will support the Elmer Iseler Singers’ outstanding musical performances, workshops and educational activities throughout the GTA, around Ontario and across Canada.\r\n\r\nIf you are unable to join us, please consider making a donation with your ticket order.\r\nTickets"
      }
    ]
