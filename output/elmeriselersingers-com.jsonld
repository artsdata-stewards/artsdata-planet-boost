    "http://schema.org/description": [
      {
        "@value": "This musical event is our annual seasonal concert/fundraiser and is sure to lift your spirits and make your heart sing. Tune in VIRTUALLY with the Elmer Iseler Singers, conductor Lydia Adams, special guests Ben Heppner, and our James T. Chestnutt Scholars, Manishya Jayasundera and Emily Taub as featured guest conductors."
      }
    ]
  },
