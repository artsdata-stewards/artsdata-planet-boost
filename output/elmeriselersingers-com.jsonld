    "http://schema.org/name": [
      {
        "@value": "Celestial Light &#8211; EIS Toronto Series Concert #1"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Featuring the Requiem by Gabriel Fauré (with instrumental ensemble), a World Premiere of Sid Robinovitch’s new choral work Psalm Cycle, and a tribute to the distinguished Toronto composer John Beckwith with a performance of Sharon Fragments. Also, not to be missed are works by William Byrd, Eleanor Daley and Srul Irving Glick.\r\nTickets for Celestial Light\r\nProgram\r\n\r\n \tO Be Joyful in the Lord by Eleanor Daley\r\nAve Verum Corpus by William Byrd\r\n \tSharon Fragments by John Beckwith\r\n \tPsalm Cycle world premiere by Sid Robinovich\r\n \tRequiem by Gabriel Fauré\r\nThe Hour Has Come by Srul Irving Glick"
      }
    ]
  },
