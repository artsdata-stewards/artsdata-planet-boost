    "http://schema.org/name": [
      {
        "@value": "Get Music! Educational Gala"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Lydia Adams, Conductor with guest conductors from participating secondary schools and choirs.\r\n\r\nJoin Canada’s conductor/mentor/clinician Lydia Adams and the Elmer Iseler Singers for a grand finale and performance of Canadian and International composers.\r\n\r\nEducational Outreach co-ordinator: Bob Anderson.\r\n\r\nThis Get Music! Educational Outreach Initiative is in Memory of John C. Bird.\r\n\r\nA complimentary concert for season subscribers.\r\nTickets for non-subscribers can be purchased for $25 at the door."
      }
    ]
  },
