    ],
    "http://schema.org/name": [
      {
        "@value": "Calgary concert with Luminous Voices"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Presented by Luminous Voices  &amp; The Taylor Centre Concert Season\r\n\r\n\r\nLuminous Voices comprises some of the best ensemble singers in the Calgary area, collaborating with singers and musicians from across North America. Luminous Voices is directed by Dr. Timothy Shantz, who founded the ensemble in 2012.\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\nTheir mission is to engage audiences in exceptional choral music through stirring performances, workshops and recordings. Their Vision is to encourage the advancement of the choral art by providing a forum for collaboration among local and international artists in the development and presentation of choral music, as well as musical education programs.\r\nTickets are $38 and available on the Mount Royal University website\r\n\r\n\r\n\r\n\r\n\r\n&nbsp;\r\n\r\n&nbsp;"
      }
    ]
  },
