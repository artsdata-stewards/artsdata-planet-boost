    "http://schema.org/name": [
      {
        "@value": "Music and Beyond with John Rutter"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "An Evening with John Rutter | Une Soirée avec John Rutter\r\nThe Elmer Iseler Singers are pleased to be performing in Ottawa for Music &amp; Beyond on July 13, 2023.\r\nTickets\r\nThis event is a Premium Event. Adult and Student Members can select the discounted “…with Membership” tickets.\r\n\r\nClick here for tickets and more information.\r\nProgram / Programme\r\nMireille Asselin – soprano\r\nDavid Pike – baritone\r\nElmer Iseler Singers\r\nCapital Chamber Choir\r\nThe Music and Beyond Festival Orchestra\r\nJohn Rutter – conductor | chef\r\nGabriel Fauré – Requiem \r\nJohn Rutter – Requiem "
      }
    ]
  },
