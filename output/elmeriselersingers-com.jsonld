    ],
    "http://schema.org/name": [
      {
        "@value": "Strawberries &#038; Champagne at the Lake"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Celebrate 45-years with the Elmer Iseler Singers as we enjoy the beautiful and intimate setting of the Toronto Hunt Club on Lake Ontario, participate in our amazing spring silent auction and spend a delightful musical afternoon with Canada’s Elmer Iseler Singers, Lydia Adams, conductor.\r\nAppropriate donation receipts will be provided.\r\nTickets for Strawberries &amp; Champagne at the Lake\r\n\r\nProceeds from this annual fundraising event will support the Elmer Iseler Singers’ outstanding musical performances, workshops and educational activities throughout the GTA, around Ontario and across Canada.\r\n\r\nIf you are unable to join us, please consider making a donation with your ticket order."
      }
    ]
