    "http://schema.org/name": [
      {
        "@value": "Thornbury Workshop, Grace United Church Choir &#038; Community Singers"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Choral workshop with Grace United Church Choir and Community Singers,\r\nDr. Chris Burton, conductor\r\nSponsor: Jim Dolmer\r\nElmer Iseler Singers will host a choral workshop for local Thornbury singers from 4:30 to 6:00 PM. Registration is $15 for Adults and $10 for Youth (14 and under). There is a $0.75 handling fee for online workshop purchases. To register online, please click the link below.\r\n\r\nWORKSHOP REGISTRATION\r\n\r\n(For the Workshop: Youth 14 and under must be accompanied by a Responsible Adult who will be on the premises at all times.)\r\n\r\nWorkshop registration available through the Grace United Church website. For more information, email the Church Office or call (519)599-2438.\r\n\r\n&nbsp;"
      }
    ]
  },
