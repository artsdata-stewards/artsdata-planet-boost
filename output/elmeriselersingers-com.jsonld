    ]
  },
  {
    "@id": "https://elmeriselersingers.com/temporary/6670b92f-6191-4f0d-a151-9c637220d936",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.elmeriselersingers.com/events/sherry-shortbread-at-home-2024/"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2024-12-22"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-01-15"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.elmeriselersingers.com/wp-content/uploads/2024/12/sherryandshortbread2024-6x9-1.jpg"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.elmeriselersingers.com/events/sherry-shortbread-at-home-2024/"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Sherry &#038; Shortbread ‘At Home’"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Join The Elmer Iseler Singers for the choir’s annual fundraising online seasonal presentation!\r\n\r\nLive Online performance ‘Watch Party’ beginning on Sunday, December 22nd at 4:00 p.m. with the program available online until January 15th, 2025!\r\nDonate for your link to our online seasonal presentation, Sherry & Shortbread ‘At Home’\r\n\r\nHear the Elmer Iseler Singers’ new recordings of seasonal favourites O Holy Night with soprano Claire Renouf; In the Bleak Mid-Winter, by Alexander Tilley; David Willcocks’ brilliant arrangement of Jingle Bells; the stunningly beautiful Sure on this Shining Night by Morten Lauridsen and favourite works, All This Night and Rejoice and Sing by the brilliant Eleanor Daley.\r\n\r\nRuth Watson Henderson’s Lullaby for the Christ Child is sure to move you, and our new recording of the Elmer Iseler’s achingly beautiful arrangement of Away in a Manger with soloists Amy Dodington, Graham Robinson and Clara Krausse is ethereal and moving. Back by popular acclaim is the remarkable Ben Heppner reading The Christmas Orange. Tie the entire program all up with a bow with the Mark Hayes arrangement of Have Yourself a Merry Little Christmas and you have a program that you and your family and friends can enjoy all through the Christmas season!\r\n\r\nTo receive your invitation to our online seasonal presentation, donate today. Recent donors will be provided with the link as well.\r\nDonate for your link to our online seasonal presentation, Sherry & Shortbread ‘At Home’\r\nWe use the secure Zeffy donation platform, for other ways to donate click here\r\n\r\nWishing you, each and every one, a joyous holiday season!!"
      }
    ]
  },
