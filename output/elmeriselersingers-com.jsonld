  {
    "@id": "https://elmeriselersingers.com/temporary/ee455ad2-8685-4988-8bec-69108d8efa26",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.elmeriselersingers.com/events/mahler-symphony-no-2-resurrection/"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2019-04-18"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2019-04-18"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.elmeriselersingers.com/wp-content/uploads/2018/08/mahler-resurrection_1920x520.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g739540"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.elmeriselersingers.com/events/mahler-symphony-no-2-resurrection/"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Mahler Resurrection Symphony"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Mahler’s heart-stirring “Resurrection” Symphony addresses life-and-death issues as only he could. “The whole thing sounds as though it came to us from some other world,” he wrote. “And I think there is no one who can resist it. One is battered to the ground and then raised on angels’ wings to the highest heights.” In celebration of Easter, the Toronto Symphony Orchestra (TSO), Spanish guest conductor Juanjo Mena, and a superlative cast of singers bring this colossal score dynamically to life.\r\n\r\n[maxbutton id=\"7\"]\r\nPerformers\r\n\r\n \tOrchestra:\r\n\r\n \tToronto Symphony Orchestra, Juanjo Mena, conductor\r\n\r\n\r\n \tChoirs\r\n\r\n \tAmadeus Choir\r\n \tElmer Iseler Singers\r\n\r\n\r\n \tSoloists\r\n\r\n \tJoélle Harvey soprano\r\n \tMarie-Nicole Lemieux contralto"
      }
    ]
  },
