    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.elmeriselersingers.com/events/composers-workshop/"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "EIS Composers Workshop"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "The Elmer Iseler Singers, Lydia Adams, conductor, welcome new or ‘in progress’ choral compositions to be workshopped in person with the EIS and Lydia Adams at the Canadian Music Centre on Saturday, April 27th from 1:00 to 4:00 p.m. Through this educational initiative, the EIS are pleased to consider, in particular, works by Canadian emerging composers reflecting Canada’s diversity and also works which advance collaborative choral and collective singing opportunities with Indigenous creators. The composer, conductor and singers will have the opportunity to interact about various aspects of the works, including colours, textures, musical phrasing, appropriate text writing for choirs, and any other aspects of writing successfully for choir, to test out new concepts or to help develop completed work.\r\n\r\n\r\n\r\nThere is no charge to composers for this workshop. The Elmer Iseler Singers are pleased to welcome the generous support of the Takla Foundation as primary sponsors of this educational initiative.\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\nBy invitation, limited spacing, interested parties may apply by email to info@elmeriselersingers.com"
      }
    ]
  },
