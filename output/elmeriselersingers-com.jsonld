  {
    "@id": "https://elmeriselersingers.com/temporary/617012b7-ae24-4672-9dc4-92ef18abf952",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.elmeriselersingers.com/events/music-beyond-the-heart-sings-le-coeur-chante/"
      }
    ],
