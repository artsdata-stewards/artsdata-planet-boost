    ],
    "http://schema.org/name": [
      {
        "@value": "Canadian Connections IX"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "ProCoro Canada welcomes the Elmer Iseler Singers under the direction of maestra Lydia Adams. They will present a choral kaleidoscope of a cappella selections from across Canada. Pro Coro will be performing music by composer-in-residence Alberto Grau and Canadian Marie-Claire Sandon, and the evening will end with both choirs combined on stage.\r\n\r\nGuest Choir: The Elmer Iseler Singers (Lydia Adams, director)\r\n\r\nPrice: $35 Adult | $30 Senior/Student ($40/$35 at the door)\r\n\r\nTickets can be chosen in the Pick4 All Saints' Concerts Subscription and is included in the Full Subscription package on the ProCoro website.\r\n\r\nFor those who would like assistance making their purchase, tickets are available by phone (780.420.1247) or in person (#309, 10113 - 104 St.) during our regular Box Office hours (Mon-Fri, 9AM-4PM), closed all holidays and observances."
      }
    ]
