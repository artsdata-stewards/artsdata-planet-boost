    "http://schema.org/name": [
      {
        "@value": "Handel&#8217;s Messiah"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Lydia Adams conducts the rich textures of the solos and the glorious choruses that will once again be celebrated as the Elmer Iseler Singers present Handel’s resplendent Messiah. We continue our tradition of presenting award winning Canadian soloists, professional orchestra and choral richness with our special guest choir: VIVA Chamber Singers. Our guest soloists include: Meredith Hall, Soprano; Andrea Ludwig, Mezzo Soprano; Owen McCausland, Tenor; and Jorell Williams, Bass."
      }
