      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Elmer Iseler Singers, Lydia Adams, Artistic Director &#8211; Conductors Workshop"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "The Elmer Iseler Singers, a 20-voice professional chamber choir based in Toronto, and EIS Artistic Director Lydia Adams are pleased to announce a workshop opportunity for emerging conductors. This initiative will showcase Canadian choral compositions, and works presented will be chosen through consultation with the conductors and Lydia Adams, Artistic Director of the EIS. Conductors will have the opportunity to interact with the choir and Lydia Adams on the clarity and focus of their technique, their understanding of the work, sound colour painting, and their ability to bring their chosen choral work to life. \r\n\r\n\r\n\r\n\r\n\r\nBy invitation, limited spacing."
      }
    ]
  },
