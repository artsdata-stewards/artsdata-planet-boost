    "http://schema.org/name": [
      {
        "@value": "Cheam Vista Classical Concerts in Agassiz"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "The Cheam Vista Classical Concerts Society present The Elmer Iseler Singers as part of the their Cheam Vista Classical Concerts Series.\r\nThe society operates on a subscription model. Before the start of the season, audience members buy a subscription for the whole season and your ticket reserves you a spot for all four concerts. If you cannot make a concert, feel free to give your ticket to a friend so that they may enjoy the music instead.\r\n\r\nTo purchase a subscription, please download, print and fill out this form and take it, along with your cheque, to the Agassiz branch of the Fraser Valley Regional Library."
      }
    ]
