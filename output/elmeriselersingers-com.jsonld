  {
    "@id": "https://elmeriselersingers.com/temporary/95e05923-3d57-4589-a7b0-656a990c3f3b",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.elmeriselersingers.com/events/esprit-orchestra-concert/"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-04-23"
      }
    ],
    "http://schema.org/endDate": [
      {
