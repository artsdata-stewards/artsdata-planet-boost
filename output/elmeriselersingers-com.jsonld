    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.elmeriselersingers.com/events/eis-composers-workshop/"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Elmer Iseler Singers, Lydia Adams, Artistic Director &#8211; Composers Workshop"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "The Elmer Iseler Singers, Lydia Adams, conductor, welcome new or ‘in progress’ choral compositions to be workshopped in person with the EIS and Lydia Adams. Through this educational initiative, the EIS are pleased to consider, in particular, works by Canadian emerging composers reflecting Canada’s diversity and also works which advance collaborative choral and collective singing opportunities with Indigenous creators. The composer, conductor and singers will have the opportunity to interact about various aspects of the works, including colours, textures, musical phrasing, appropriate text writing for choirs, and any other aspects of writing successfully for choir, to test out new concepts or to help develop completed work.\r\n\r\n\r\n\r\n\r\n\r\nBy invitation, limited spacing.\r\nCall for new or ‘in progress’ choral compositions for workshop opportunity - Applications open until May 12, 2025"
      }
    ]
  },
