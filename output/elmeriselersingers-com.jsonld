  {
    "@id": "https://elmeriselersingers.com/temporary/d6be1a7b-8dc3-47c0-9a3d-c01a68effa4a",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.elmeriselersingers.com/events/conductors-composers-workshop/"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2023-09-30"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2023-09-30"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g2076380"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.elmeriselersingers.com/events/conductors-composers-workshop/"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "EIS workshop for Emerging Conductors and Composers"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "The Elmer Iseler Singers, Lydia Adams, Artistic Director, are thrilled to announce a new initiative in the EIS educational outreach program on Saturday, September 30th, 2023 at the Canadian Music Centre.\r\nThe emerging choral composers’ and conductors’ workshop features six composers from the VIVA Singers Toronto choral composition program.\r\nThe Singers are excited to work with these composers to assist them in honing their skills for their future work.\r\nThe Singers and Lydia Adams will also mentor four emerging conductors, Nathan Gritter, Manishya Jayasundera, Deborah Park and Emily Taub, all from the Toronto area, conducting compositions by Canadian composers Eleanor Daley, Ruth Watson Henderson and Hussein Janmohamed, all Associate Members of the CMC.\r\nThis new initiative is an exciting one for the Elmer Iseler Singers, in that it showcases both emerging Canadian choral composers, and also the next generation of Canadian choral conductors!\r\nThis is one of three educational workshops the Elmer Iseler Singers will present during the 2023-2024 concert season and we look forward to the thrill of working with all these fine artists.\r\nBy invitation only, limited spacing."
      }
    ]
  },
