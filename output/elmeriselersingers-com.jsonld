    "@id": "https://elmeriselersingers.com/temporary/1a138ae4-b6b9-4c51-8548-4a908db51514",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.elmeriselersingers.com/events/komitas-canadian-tribute/"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2019-10-25"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2019-10-25"
      }
    ],
    "http://schema.org/location": [
