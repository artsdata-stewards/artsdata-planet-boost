      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Reception at 6:00 PM\r\nConcert begins at 7:00 PM\r\n\r\nThe Muskoka Concert Association presents The Elmer Iseler Singers, conducted by artistic director Lydia Adams, C.M., on April 28.\r\n\r\nPlease come early for a reception at 6 pm in the Trillium Court where you can enjoy good conversation with some tasty appetizers and maybe a glass of wine before the concert begins at 7 pm.\r\n\r\nTickets are $48.00 plus applicable fees &amp; taxes\r\n\r\nClick here to buy tickets online OR call the Box Office at 705-687-5550 or Toll-Free 1-888-495-8888\r\n\r\n[caption id=\"\" align=\"alignnone\" width=\"1093\"] Interior of the Gravenhurst Opera House[/caption]"
      }
