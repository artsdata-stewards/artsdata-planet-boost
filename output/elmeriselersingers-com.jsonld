    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.elmeriselersingers.com/events/timeless-journeys-collingwood-music-festival/"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Timeless Journeys &#8211; Collingwood Music Festival"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "The concert features a world premiere: a commissioned work by Canadian composer Ian Cusson.\r\nConducted by Lydia Adams\r\n\r\nAn unforgettable evening of choral brilliance, this program features the renowned Elmer Iseler Singers, a stellar lineup of instrumentalists, and the world premiere of a CMF-commissioned work by Canadian composer Ian Cusson. The evening culminates in John Rutter’s luminous Requiem, a deeply moving masterpiece of hope and remembrance.\r\nInstrumentalists\r\n\r\n \tShawn Grenke, organ\r\n \tJames Campbell, clarinet\r\n \tBryan Holt, cello\r\n \tNoa Sarid, violin\r\n \tTim Francom, percussion\r\n \tErica Goodman, harp\r\n \tSuzanne Shulman, flute\r\n \tGuy Few, piano\r\n\r\nClick here for tickets!\r\n\r\nClick here for the Collingwood Music Festival event page\r\nProgram\r\nJ.S. Bach (1685-1750) - Cum Sancto Spiritu (b minor Mass)\r\nMatthew Emery (b. 1991) - Barren Cabin, Tin Roof\r\nHussein Janmohamed - Sun on Water\r\nIan Cusson (b. 1981) - World Première: Dance Dance Dance\r\nJohn Rutter (b. 1945) - Requiem\r\nSrul Irving Glick (1934-2002) - The Hour Has Come\r\n\r\n&nbsp;"
      }
    ]
  },
