    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.elmeriselersingers.com/events/brantford-symphony-orchestra-presents-christmas-bells/"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Brantford Symphony Orchestra Presents Christmas Bells"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Shake the dust of your Christmas bells and bring them along to the Sanderson and the Brantford Symphony Orchestra's annual seasonal extravaganza! As always, the Orchestra presents your sentimental favourites in new and exciting arrangements, along with some \"two thumbs up\" chestnuts from years past. And if all that isn't enough to get you rushing for your tickets, we go way over the top by presenting, as our special guests, one of Canada's most famous choirs, the Elmer Iseler Singers. The Singers, who on their own have wowed Brantford audiences on several occasions in recent years, now team up with the amazing Brantford Symphony for a show that will be the gold standard of Christmas shows for years to come.\r\n\r\nThe seats will go fast and the Sanderson will be packed! Get your tickets early to avoid disappointment!\r\n\r\nTickets available at the Sanderson Centre website."
      }
    ]
  },
