    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2024/11/joe.webp"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2025-6-14T19:30-4:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "en",
