  {
    "@id": "https://www.kingstheatre.ca/new-events/musical-theatre-camp-for-youth-2/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "MUSICAL THEATRE CAMP FOR YOUTH - King's Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Do you love to sing, dance and act? Well, this is the camp for you! We'll learn songs, scenes and dances, play theatre games and learn and rehearse a show to be presented for family and friends on the final day. Laughing is encouraged! Come to have a blast and you just might discover some talent you didn't know you had."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://www.kingstheatre.ca/new-events/musical-theatre-camp-for-youth-2/"
      }
    ],
