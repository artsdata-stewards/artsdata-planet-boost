      }
    ],
    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2024/01/IMGP4625-scaled.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2024-3-2T15:00-4:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "en",
        "@value": "2024-3-2T23:50-4:00"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "WE HAVE OVERCOME"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n                \n\n\n\nWendy Goudie leads a show that dives into the challenges and triumphs of today’s youth. Sparkle Dance teams each selected social issues they feel deserving of attention — bullying, being brave, mental health, the strength of friends. This dance show has all the feels!\nThere is a power to bringing awareness to meaningful topics from a stage, and this show gives our community’s youth this platform.\nJoin us celebrate our local youth dancing and speaking on everything from hard losses to uplifting resilience.\nSparkle Dance is happy to have a special addition from AWEC. As an in-school project, a group of high school students will also be contributing a presentation.\n\nDirection & Choreography – Wendy Goudie\nCostume Director – Sandra Rector\nTechnical Director – Devin Fraser\nBackstage Hands – Corin Rector, Rhys Rector \n\n\n\n\n\nTICKETS\n\n\n\n\n Adults $15.00\nYouth: $5.00\n\nRoyalty Card holders get 10% off\nKing’s Theatre is committed to making live performances accessible to all audiences. If cost is a barrier please contact our Box Office for Bursary Tickets: boxoffice@kingstheatre.ca or 902-532-7704.\nDoors open 45 before showtime.\n\nClick here for King’s Ticket Exchange policies\n\n\n\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
