    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<div id='movie-details-expander'> <div class='score-wrap'> <div class='description-wrap'> <div data-adsmediascorecardmanager='description'> <div class='drawer'> <div class='score-wrap'> <div class='description-wrap'> <div data-adsmediascorecardmanager='description'> <div class='drawer'> <div class='ipc-metadata-list-item__content-container'> <div class='ipc-html-content ipc-html-content--base sc-ac2b5e16-0 deDizX' role='presentation'> <div class='ipc-html-content-inner-div' role='presentation'> <div class='ipc-html-content ipc-html-content--base' role='presentation'> <div class='ipc-html-content-inner-div' role='presentation'> <div class='cpx-bottomMargin-lg'> <div class='MovieSelectedDetails_container__ftjgX'> <div class='MovieSelectedDetails_detailsContainer__2seki'> <div class='MovieSelectedDetails_ctaAndDetails__BpCFb'> <div class='MovieSelectedDetails_genreContainer__qEtwh MovieSelectedDetails_movieDetail__8XtgT'> <div class='score-wrap'> <div class='description-wrap'> <div data-adsmediascorecardmanager='description'> <div class='drawer'>A bedridden boy&#8217;s grandfather reads him the story of a farmboy-turned-pirate who encounters numerous obstacles, enemies and allies in his quest to be reunited with his true love.</div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> <div class='description-wrap'> <div data-adsmediascorecardmanager='description'> <div data-adsmediascorecardmanager='description'> <div class='drawer'> <div class='score-wrap'> <div class='description-wrap'> <div data-adsmediascorecardmanager='description'> <ul> <li><strong>Stars: </strong>Cary Elwes, Mandy Patinkin, Robin Wright</li> <li><strong><strong>Director: </strong></strong>Rob Reiner</li> <li><strong><strong>Writer: </strong></strong>William Goldman</li> </ul> <p><img class='alignleft' src='data:image/png;base64,' /></p> <p>&nbsp;</p> <p>&nbsp;</p> <p><strong>Genre:</strong> Adventure, Fantasy,<br /> <strong>Duration:</strong> 1<span class='cpx-body' data-testid='movie-length'>h 38min</span><br /> <strong>Rating:</strong> PG</p> <p><strong>TICKETS:</strong><br /> <strong>$11.95 Adult</strong><br /> <strong>$7.95 Youth (under 18)</strong><br /> (HST additional)</p> <h3 style='text-align: center;'><strong>GENERAL SEATING AT THE DOOR</strong></h3> <ul class='p-rich_text_list p-rich_text_list__ordered p-rich_text_list--nested' data-stringify-type='ordered-list' data-list-tree='true' data-indent='0' data-border='0'> <li data-stringify-indent='0' data-stringify-border='0'><em>Doors open 45 minutes before showtime.</em></li> <li data-stringify-indent='0' data-stringify-border='0'><em> Children under 12 must be accompanied by a guardian.</em></li> <li data-stringify-indent='0' data-stringify-border='0'><em>Outside food and beverages may not be brought into the theatre.</em></li> </ul> </div> <p><iframe title='The Princess Bride - 30th Anniversary Trailer - In Cinemas Oct 23' width='1080' height='608' src='https://www.youtube.com/embed/P9FRDyTerZA?feature=oembed'  allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share' referrerpolicy='strict-origin-when-cross-origin' allowfullscreen></iframe></p> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> "
