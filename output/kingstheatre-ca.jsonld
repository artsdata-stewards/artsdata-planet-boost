    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2023/11/gyp6.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
