    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "DON GIOVANNI - King's Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Tony Award–winning director of Broadway’s A View from the Bridge and West Side Story, Ivo van Hove makes a major Met debut with a new take on Mozart’s tragicomedy, re-setting the familiar tale of deceit and damnation in an abstract architectural landscape and shining a light into the dark corners of the story and its characters."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://www.kingstheatre.ca/new-events/don-giovanni/"
