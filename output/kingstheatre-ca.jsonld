        "@id": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2026/02/Screenshot-2026-02-23-at-1.41.22-PM.png"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
