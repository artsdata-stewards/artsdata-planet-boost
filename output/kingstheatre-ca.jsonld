    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "THE BARRA MACNEILS - King's Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Canada’s Celtic ambassadors return to King's Theatre! For four decades, Cape Breton-based family group the Barra MacNeils has been thrilling audiences of all ages, near and far, with their sparkling repertoire, vocals, instrumental prowess and vibrant showmanship."
      }
    ],
    "http://ogp.me/ns#url": [
      {
