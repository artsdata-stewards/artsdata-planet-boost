    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Nathaniel Rankin The Canadian Champion of Magic, is an international award winning magician & circus artist. His one man show 'Astonishment' combines state of the art modern magic, circus skills, dangerous stunts, audience interaction, comedy & mind reading."
      }
