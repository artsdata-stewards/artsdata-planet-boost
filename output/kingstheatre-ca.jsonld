    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2025/04/OLP-POSTER-1.jpeg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2025-11-21T19:30-4:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "en",
        "@value": "2025-11-21T23:59-4:00"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "ONE LOVE: BOB MARLEY TRIBUTE"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n                The One Love Project is a five-piece band from Montreal that tours internationally wowing audiences with their incredible musicianship! It’s a high-energy show that will have you moving and grooving! An incredible, uplifting experience.\n\nOne Love Productions is a premier showband production company founded by three seasoned musicians: Dano Peace on vocals, David Segreti on guitar, and Wes Smith on bass. Having worked together for a decade, they’ve built a powerhouse team of musicians known for their extraordinary talent and chemistry. They have mastered the art of captivating audiences with their expert showmanship and top-tier musicianship.\n\nThe must-see SHOW OF THE YEAR.\n\nTICKETS:  \n\n$50 Adult\n$15 Youth\n\n\n\n\n\nHST additional\nKing’s Theatre is committed to making live performances accessible to all audiences. If cost is a barrier please contact our Box Office for Bursary Tickets: boxoffice@kingstheatre.ca or 902-532-7704.\nDoors open 45 minutes before showtime. Please arrive early.\n\n\n\nClick here for King’s Ticket Exchange policies\n\n \n            "
      }
    ],
