    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2023/11/Image-Types-for-website-TomAllenBanner-Image.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2024-8-9T19:30-4:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "en",
