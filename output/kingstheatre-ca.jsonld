    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "HAMLET - King's Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Olivier Award-winner Hiran Abeysekera (The Father and the Assassin, Life of Pi) is Hamlet in this fearless, contemporary take on Shakespeare’s famous tragedy. National Theatre Deputy Artistic Director, Robert Hastie (Standing at the Sky’s Edge, Operation Mincemeat) directs this sharp, stylish and darkly funny reimagining."
      }
    ],
