      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Intergenerational circus with lots to say: the personal is political, their fury is fun and the acrobatics downright dangerous. Casting Off defies stereotype as these dynamic Australian women tumble, talk, fly, and balance precariously."
      }
    ],
