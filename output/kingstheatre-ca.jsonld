    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2025/03/auditions-kings-shorts.png"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2025-4-10T18:00-4:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "en",
