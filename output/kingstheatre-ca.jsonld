    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "NEXT GEN THEATRE WORKSHOP - King's Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "A series of FREE workshops for youth aged 8-17 who are interested in learning about the magical world of Theatre -- both on stage and backstage!The workshops will take place every Tuesday, 5:30-7:30pm, from January 13 to June 2, on the King's Theatre stage."
      }
    ],
