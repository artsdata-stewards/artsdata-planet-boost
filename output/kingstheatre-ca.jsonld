    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "OCEAN KIN AND OTHER STORIES"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<div class='et_pb_row et_pb_row_5'> <div class='et_pb_column et_pb_column_4_4 et_pb_column_6 et_pb_css_mix_blend_mode_passthrough et-last-child'> <div class='et_pb_module et_pb_text et_pb_text_3 et_pb_text_align_left et_pb_bg_layout_light'> <div class='et_pb_text_inner'> <div class='et_pb_row et_pb_row_5'> <div class='et_pb_column et_pb_column_4_4 et_pb_column_6 et_pb_css_mix_blend_mode_passthrough et-last-child'> <div class='et_pb_module et_pb_text et_pb_text_3 et_pb_text_align_left et_pb_bg_layout_light'> <div class='et_pb_text_inner'> <div class='et_pb_row et_pb_row_5'> <div class='et_pb_column et_pb_column_4_4 et_pb_column_6 et_pb_css_mix_blend_mode_passthrough et-last-child'> <div class='et_pb_module et_pb_text et_pb_text_3 et_pb_text_align_left et_pb_bg_layout_light'> <div class='et_pb_text_inner'> <div class='fl-row fl-row-full-width fl-row-bg-none fl-node-id0z7qs4gl5t fl-row-default-height fl-row-align-center' data-node='id0z7qs4gl5t'> <div class='fl-row-content-wrap'> <div class='fl-row-content fl-row-fixed-width fl-node-content'> <div class='fl-col-group fl-node-k8l6oxzjwmc5' data-node='k8l6oxzjwmc5'> <div class='fl-col fl-node-a5sli79up2t8 fl-col-bg-color' data-node='a5sli79up2t8'> <div class='fl-col-content fl-node-content'> <div class='fl-module fl-module-pp-heading fl-node-hjmxe8ckvqz0' data-node='hjmxe8ckvqz0'> <div class='fl-module-content fl-node-content'> <div class='pp-heading-content'> <div class='pp-heading pp-center'> <p>A night of Shadow puppetry featuring Ocean Kin by <strong>Jeighk Koyote</strong> and two short shows by <strong>Dawn Brandes.</strong></p> <p class='heading-title'><strong><span class='title-text pp-primary-title'>Ocean Kin: </span>A shadow show by Jeighk Koyote</strong></p> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> <div class='fl-row-content-wrap'> <div class='fl-row-content fl-row-fixed-width fl-node-content'> <div class='fl-col-group fl-node-604a75bdb70b2' data-node='604a75bdb70b2'> <div class='fl-col fl-node-604a75bdb7693 fl-col-bg-color' data-node='604a75bdb7693'> <div class='fl-col-content fl-node-content'> <div class='fl-module fl-module-fl-post-content fl-node-604a70df90965' data-node='604a70df90965'> <div class='fl-module-content fl-node-content'> <p><em>Ocean Kin, </em>created by <a href='https://www.jeighkkoyote.com' target='_blank' rel='noopener'>Jeighk Koyote</a>, is a 45-minute long poetic shadow show contemplating our relationship to body and self inspired by the ecology of the sea otter. Three performers animate plexi-glass puppets, 3D sculptural props and projected illustrations behind a screen using flashlights and an overhead projector that is both mechanically complex and visually rich. The performance carries a loose narrative through words and an ethereal soundscape created by Halifax musician, <a href='https://layia.bandcamp.com/' target='_blank' rel='noreferrer noopener'>Alyson Randles</a>.</p> <p><strong>Performers/Puppeteers:</strong> Jeighk Koyote, Leah Gooyers, Forest Tremblay<br /> <strong>Directors:</strong> Megan Stewart and Ian McFarlane<br /> <strong>Music:</strong> Alyson Randles</p> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> <div class='et_pb_row et_pb_row_7'> <div class='et_pb_column et_pb_column_1_2 et_pb_column_9 et_pb_css_mix_blend_mode_passthrough et-last-child'> <div class='et_pb_module et_pb_text et_pb_text_6 et_pb_text_align_left et_pb_bg_layout_light'> <div class='et_pb_text_inner'></div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> <p><strong>TICKETS:</strong></p> <ul> <li><strong>Adults: $30</strong></li> <li><strong>Youth (Under 18): $10</strong> <div class='TitleBlock__TitleMetaDataContainer-sc-1nlhx7j-2 hWHMKr'></div> <p><em>HST additional.</em></li> </ul> <p>&nbsp;</p> <p><iframe title='Ocean Kin: A Shadow Show by Jeighk Koyote' width='1080' height='608' src='https://www.youtube.com/embed/5BqcTA-y1n0?feature=oembed'  allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share' referrerpolicy='strict-origin-when-cross-origin' allowfullscreen></iframe></p> <div class='style__notes___25v7J'> <div class='main-title'> <div class='TitleBlock__TitleMetaDataContainer-sc-1nlhx7j-2 hWHMKr'> <ul> <li style='list-style-type: none;'> <ul> <li><em>Doors open 45 minutes before showtime. Please arrive early.</em></li> <li><em>King’s Theatre is committed to accessibility. If price is a barrier to attending, please request a ‘Bursary Ticket’ at the Box Office.</em></li> <li><em>Tickets are not refundable for cash, but can be exchanged for credit with a minimum of 48 hours notice. Credits are valid for 12 months.</em></li> <li><em>All persons require a ticket; we do not allow babes in arms. Children under 12 must be accompanied by a guardian.</em></li> <li><em>Outside food and beverages may not be brought into the theatre.</em></li> <li><em>For more information about Theatre policies, click <a href='https://www.kingstheatre.ca/about/ticket-info/'>here.</a></em></li> </ul> </li> </ul> </div> </div> </div> "
      }
    ],
