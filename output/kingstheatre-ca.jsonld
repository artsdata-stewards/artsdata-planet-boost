    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "ZED: LED ZEPPELIN TRIBUTE - King's Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "For ZED, it's much more than simply being a tribute. It's faithfully recreating the sound of Led Zeppelin's studio albums to an astonishing level of accuracy while also capturing the magical aura of the Led Zeppelin live experience."
      }
