    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/billy-joel-my-life/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2025/11/image003.jpg"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
