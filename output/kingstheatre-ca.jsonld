    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "17th ANNUAL TOURNAMENT OF KING'S"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n                \n\n\n\n\n\nMark your calendars because the 17th Annual Tournament of King’s will take place on \nSaturday, September 13, 2025!\nThe tournament will once again take place at the beautiful Fort View Golf Course, where in addition to 18 holes of golf you will be provided with gourmet lunches prepared by Founders House, delivered right to you on the course for your enjoyment! We’ll also have a raffle prize basket filled by local businesses.\n\n\n\nContact us for more information: 902-532-7704 or ed@kingstheatre.ca\n\n\nThank you to our past Business Partners.\nWill your business be on board for 2025?\n\n\n \n \n \n \n \n \n \n \n \n\n \n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
