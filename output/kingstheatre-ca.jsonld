    ],
    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2024/09/Screenshot-2024-09-05-at-1.43.22 PM.png"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
