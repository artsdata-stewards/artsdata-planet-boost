    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "AQUAKULTRE PRESENTS: 1783 LIVE - King's Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Aquakultre Presents: 1783 Live will feature a full band, bespoke wardrobe, backdrop and projections, set pieces, and lighting design. More than just a concert, this event is designed to bring Black audiences into arts presentation spaces with music and storytelling that speaks directly to them, in venues that enact their commitment to inclusivity and the wellbeing of diverse audiences."
      }
