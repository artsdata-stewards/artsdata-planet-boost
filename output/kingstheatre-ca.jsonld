        "@id": "_:g4213040"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/robin-the-ultimate-robin-williams-tribute-experience/"
      }
    ],
    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2023/05/ROB.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2023-11-9T19:30-4:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "en",
        "@value": "2023-11-9T23:50-4:00"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "ROBIN: THE ULTIMATE ROBIN WILLIAMS TRIBUTE EXPERIENCE"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n                \n\n\n\n\n\n\n\nAn incredible live reincarnation of one of the greatest comedic icons of all time — Robin Williams!\nStarring Roger Kabler from New York City, this show pays tribute to the award-winning movie actor and stand-up comic, largely considered as one of America’s greatest impressionists. Making its Canadian premiere, this has become one of the hottest shows in the USA, selling out major venues everywhere. Roger Kabler performed as one of the cast members of the Carol Burnett Show in the 90’s.\nIf you’ve never had the chance to see what it was like to see Robin Williams in concert, now is the time!\n\n\n\n\n\nPraise for the show:\n“You’ll laugh, you’ll cry — A brilliant one-man theatre masterpiece.” – Los Angeles Times\n“Roger’s Robin Williams impression is extraordinary as his face seems to “morph” and he becomes Robin onstage.” – Boston Globe\n“Roger freaked the audience out. He was Robin in the flesh. You’d think he was channeling Robin.” – San Diego Union-Tribune\n“Astonishing.” – New York Post\n\n\n\n\n\n\n\n\n\n\n\n\n\nTICKETS: $55\n\n\n\nHST additional\nRoyalty Card holders get 10% off\nKing’s Theatre is committed to making live performances accessible to all audiences. If cost is a barrier please contact our Box Office for Bursary Tickets: boxoffice@kingstheatre.ca or 902-532-7704.\nDoors open 45 minutes before showtime. Please arrive early.\nChildren under 12 must be accompanied by a guardian when attending a King’s Theatre event\n\n\n\nClick here for King’s Ticket Exchange policies\n\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
  {
    "@id": "https://www.kingstheatre.ca/new-events/youth-creative-showcase-2/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Youth Creative Showcase 2! - King's Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Sparkle Dance Academy and King's Theatre's Next Gen Break Dance program are collaborating to bring another showcase of youth performance! Sparkle Dancers will share collaborative self choreographed group pieces to close off their spring dance session. Special guest DJ Mystic Nic will be spinning world beats for the Break Dancers as they highlight their new skills."
      }
    ],
