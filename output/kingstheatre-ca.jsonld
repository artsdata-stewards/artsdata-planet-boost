    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "TERRA SPENCER & KIM DUNN - King's Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "An off-the-cuff invitation in a Charlottetown hotel bar, a shared stage in a Canso rink, and a mutual love for questionable jokes…award-winning performers Kim Dunn and Terra Spencer paired up for a run of intimate shows off the beaten path."
      }
    ],
    "http://ogp.me/ns#url": [
