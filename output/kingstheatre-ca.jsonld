      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Annual General Meeting"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n                The King’s Theatre Society hosts its Annual General Meeting at 7pm on Tuesday April 2 at King’s Theatre.\nThe agenda will include reports on the 2023 year, the audited financial statements, and the election of the Board of Directors.\nNotice that there will be a motion to change the Term of Office clause in the by-laws to read:\nThe term of office for Directors shall be for two years, for a maximum of\neight years with the exception of the past Chair and past Treasurer who\nmay serve for an additional year as an ex-officio, non-voting member of the\nBoard.\nDonor-Members in good standing are welcome to vote, as well as to put their name forward to serve on the Board of Directors. A Donation of $25 or more constitute Membership, and is eligible for a tax receipt. Click here to donate.\n            "
      }
    ],
