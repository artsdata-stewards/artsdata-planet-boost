  {
    "@id": "https://www.kingstheatre.ca/new-events/event_239849_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/bakersfield-mist-2/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2023/12/IMG_1010-scaled.jpeg"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/bakersfield-mist-2"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "BAKERSFIELD MIST"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<ul> <li class='tm6 Normal'><span class='tm7'>Written by </span><strong><span class='tm8'>Stephen Sachs</span></strong></li> <li class='tm6 Normal'><span class='tm7'>Directed by</span><strong><span class='tm8'> Scott Campbell</span></strong></li> <li class='tm6 Normal'><span class='tm7'>Starring </span><strong><span class='tm8'>Tracy Summerville and Patrick Kelly</span></strong></li> <li>Produced by <strong>Scrappy Lady Productions</strong></li> </ul> <p class='tm6 Normal'><span class='tm7'> On stage at King&#8217;s Theatre <strong><span class='tm8'>August 16 &amp; 17 at 7:30pm and August 18 at 3:00pm</span></strong></span></p> <p class='tm6 Normal'><em><span class='tm7'>A hilarious and poignant play first staged on the West End in London with Kathleen Turner and Ian McDermid, now performed worldwide.  </span></em></p> <p class='tm6 Normal'><strong><span class='tm8'>The Story: </span></strong><span class='tm7'>Maude, a fifty-something unemployed bartender living in a trailer park, has bought a painting for a few bucks from a thrift store. Despite almost trashing it, she’s now convinced it’s a lost masterpiece by Jackson Pollock worth millions. But when world-class art expert Lionel Percy flies over from New York and arrives at her trailer home in Bakersfield to authenticate the painting, he has no idea what he is about to discover. Inspired by true events, this hilarious and thought-provoking new comedy-drama asks vital questions about what makes art and people truly authentic. </span></p> <p class='tm6'><strong><span class='tm9'>The Playwright: </span></strong><span class='tm10'>Stephen Sachs</span> <span class='tm10'>is an award-winning playwright, director and producer. He is the Founding Artistic Director of the Fountain Theatre in Los Angeles.</span></p> <p><strong>TICKETS: Adults $25/ Youth $20</strong></p> <p><em>Please note: This play contains some course language and suicidal ideation.</em></p> <p>&nbsp;</p> <p>&nbsp;</p> <p>&nbsp;</p> <p>&nbsp;</p> <p>&nbsp;</p> <p>&nbsp;</p> <p>&nbsp;</p> <p>&nbsp;</p> <p>&nbsp;</p> "
      }
    ],
