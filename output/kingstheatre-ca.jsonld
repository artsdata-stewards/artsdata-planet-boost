    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2024/08/Untitled-design-5.png"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2024-10-5T19:00-4:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "en",
