  {
    "@id": "https://www.kingstheatre.ca/new-events/lynyrd-skynard-tribute/event_240734_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/bon-jovi-bryan-adams-tribute/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2024/09/Screenshot-2025-03-22-at-9.46.24 AM.png"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/lynyrd-skynard-tribute/"
