      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "The Choral - King's Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "A choral society's male members enlist in World War I, leaving the demanding Dr. Guthrie to recruit teenagers. Together, they experience the joy of singing while the young boys grapple with their impending conscription into the army."
      }
    ],
    "http://ogp.me/ns#url": [
