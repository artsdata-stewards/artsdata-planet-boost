  {
    "@id": "https://www.kingstheatre.ca/category/uncategorized/event_242671_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/auditions/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2026/02/shorts-logo-banner.jpg"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "AUDITIONS"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<div class='moz-text-html' lang='x-unicode'> <div dir='ltr'> <p><strong>AUDITIONS for King&#8217;s Shorts Festival of 10-Minute Plays</strong></p> <p><strong>Audition Dates: </strong></p> <ul> <li><strong>Thursday April 9, 6-8pm</strong></li> <li><strong>Saturday April 11, 10:30am-12:30pm</strong></li> </ul> <p><strong>Location:</strong> King’s Theatre</p> <p>Anyone interested in being cast in one of the Shorts is invited to attend one of the above auditions at King’s Theatre.</p> <p>Please bring a short (less than 5-minute) prepared piece to read. Additional material will also be available to read to the Festival directors.</p> <p><i>If you are unable to attend and are still interested in participating or want more information, please contact Verilea Ellis 902-245-2309 or <a href='mailto:verilea@yahoo.ca' target='_blank' rel='noopener'>verilea@yahoo.ca</a></i></p> <p>Performances at King&#8217;s Theatre June 19, 20 &amp; 21.</p> </div> </div> "
      }
    ],
    "http://schema.org/startDate": [
