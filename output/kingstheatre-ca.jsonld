    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2024/08/69973936_2467610320192331_6963962954165256192_n.jpg"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/josephine-a-burlesque-cabaret-dream-play/"
