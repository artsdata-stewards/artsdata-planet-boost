    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "GREGORY MUSZKIE: THE GREG SHOW - King's Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "In this solo show, Gregory equips both the piano and guitar to perform original works like ‘Weird Kid’, ‘Plastic’ and ‘One Step From My Heart’.Themes include: Cautionary storytelling, celebration of the self, love and passion, environmentalism, and the unknown. "
      }
    ],
