  {
    "@id": "https://www.kingstheatre.ca/temporary/a23adb82-e1fb-4a8f-9d62-87ac1f656ae4",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/dufflebag-theatres-cinderella/"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "_:g14701480"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.kingstheatre.ca/kings-theatre-welcome/"
      }
    ],
    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2025/07/Cinderella-web-banner.png"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2025-12-30T14:00-4:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "en",
        "@value": "2025-12-30T23:59-4:00"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "DUFFLEBAG THEATRE'S CINDERELLA"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n                \n\n\n\n\n\n\nCINDERELLA\nPoor Cinderella. All she wants to do is go to the Royal Ball to meet Prince Charming. But her mean stepmother and stepsisters won’t let her go, so they ruin her dress and leave without her. With the help of her Fairy Godmother, Cinderella gets to go to the castle after all and make the grand entrance she’s always dreamed about. The only catch is that Cinderella must be back by midnight when the spell is broken! The comedic timing is bang on as curfews, lost footwear, and giant pumpkins abound in this fun-filled version of the classic fairy tale from DuffleBag Theatre, especially when members of the audience are invited to star in the show!\nSuitable for all ages.\nABOUT DUFFLEBAG THEATRE\nThe “nearly world-famous” DuffleBag Theatre returns! Now in their 33nd season of touring hilarious adaptations of fairy tales & classic stories, DuffleBag Theatre performances feature members of the audience in the key roles! Everyone’s dream of living a fairy tale can come true as audiences around the world have come to know. Always expect the unexpected with the improvisation and spontaneity of a DuffleBag Theatre performance. Come play a part! Established in 1992 in London, Ontario, Canada, DuffleBag Theatre is an international touring theatre company for young audiences specializing in hilarious adaptations of fairy tales and classic stories that star members of the audience in the main parts.\n\n\n\n\n\n\n\nTICKETS\n\n\n\n\n Adults $20.00\nYouth: $10.00\n\nHST additional\n\n\n\nDoors open 45 minutes before showtime. Please arrive early.\nKing’s Theatre is committed to accessibility. If price is a barrier to attending, please request a ‘Bursary Ticket’ at the Box Office.\nTickets are not refundable for cash, but can be exchanged for credit with a minimum of 48 hours notice. Credits are valid for 12 months.\nAll persons require a ticket; we do not allow babes in arms. Children under 12 must be accompanied by a guardian.\nOutside food and beverages may not be brought into the theatre.\nFor more information about Theatre policies, click here.\n\n\n\n \n \n\n\n\n\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
