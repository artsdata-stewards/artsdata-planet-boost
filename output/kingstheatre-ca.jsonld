    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2025/07/NTL-2025-Mrs.-Warrens-Profession-Listing-Image-Landscape-1024x722-1.jpg"
