        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "TH’OWXIYA: THE HUNGRY FEAST DISH - King's Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Immerse yourself in the legend of the basket ogress, Th’owxiya, an old hungry spirit that inhabits in a feast dish full of bountiful delicious foods. This Kwantlen First Nations tale follows a sly Mouse (Kw’at’el) who is caught stealing cheese from this feast dish."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://www.kingstheatre.ca/new-events/thowxiya-the-hungry-feast-dish/"
