    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Annual General Meeting 2026"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><strong>The King&#8217;s Theatre Society hosts its Annual General Meeting at 7pm on Monday March 30, 2026 at King&#8217;s Theatre.</strong></p> <p>The agenda will include reports on the 2025 year, the audited financial statements, and the election of the Board of Directors.</p> <p>Donor-Members in good standing are welcome to vote, as well as to put their name forward to serve on the Board of Directors. A Donation of $25 or more constitute Membership, and is eligible for a tax receipt. <a href='https://www.kingstheatre.ca/support-us/donate/'>Click here to donate.</a></p> "
      }
    ],
