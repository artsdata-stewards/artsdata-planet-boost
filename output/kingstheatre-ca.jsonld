  {
    "@id": "https://www.kingstheatre.ca/new-events/dancing-the-seven-teachings/event_240582_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/dancing-the-seven-teachings/"
