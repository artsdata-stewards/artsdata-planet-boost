  {
    "@id": "https://www.kingstheatre.ca/new-events/dance-theatre-camp-for-youth/event_241283_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/dance-theatre-camp-for-youth/"
      }
    ],
