    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "AUDITIONS FOR YCP&#039;s ALICE THROUGH THE LOOKING GLASS"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<div class='moz-text-html' lang='x-unicode'> <div dir='ltr'> <p><strong>AUDITIONS for Young Company Production’s &#8216;Alice Through the Looking Glass&#8217;, Directed by Heather Hiscock.</strong></p> <p><strong>Audition Dates: </strong></p> <ul> <li><strong>Sunday May 4, 11am-1pm</strong></li> <li><strong>Thursday May 8, 4-6 pm</strong></li> </ul> <p><strong>Location:</strong> King’s Theatre</p> <p><strong>About the Show:</strong> &#8216;Alice Through the Looking Glass&#8217; is a whimsical sequel to Lewis Carroll&#8217;s beloved tale! It will take the audience on a fantastical journey through a mirror world filled with quirky characters and delightful adventures. Join Alice as she encounters the Red Queen, the White Knight, and the Jabberwocky in a story that explores themes of identity, imagination, and the passage of time.</p> <p>Performances at King&#8217;s Theatre October 18&amp; 19.</p> <p><strong>Audition Requirements:</strong> Ages 5-17. All backgrounds are welcomed. Be ready to perform a cold reading from the script. Scripts will be provided!</p> <p>We look forward to seeing you bring your imagination to life in this enchanting production!</p> </div> </div> "
      }
    ],
