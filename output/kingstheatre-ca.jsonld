    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "GINA BURGESS - King's Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Gina Burgess is a genre-bending violinist and composer from Kjipuktuk / Halifax. She is well known for her virtuosic work with the hot swing outfit Gypsophilia (NS), and the Juno nominated folk-rock band The Jerry Cans (Iqaluit).She'll be performing with Cynthia Pitsiulak (Contemporary Inuit throat singing), Greg Woolner (Drum kit), Jordan Stephens (Double bass), and  Ross Burns (Brazilian percussion)."
      }
    ],
