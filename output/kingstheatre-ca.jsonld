    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2023/06/Piano-Heist-webpage-image-800-wide-crop.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2023-11-4T19:30-4:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "en",
