    ],
    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2024/08/Screenshot-2023-12-02-190735.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2024-12-15T18:00-4:00"
      }
    ],
    "http://schema.org/endDate": [
