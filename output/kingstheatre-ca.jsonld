    "http://schema.org/image": [
      {
        "@id": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2024/09/shorts-logo-banner.jpg"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
