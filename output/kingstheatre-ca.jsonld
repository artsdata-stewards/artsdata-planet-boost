        "@id": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2026/02/Banner-scaled.jpg"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "LES FURIES (THE FURIES)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<div id='movie-details-expander'> <div class='score-wrap'> <div class='description-wrap'> <div data-adsmediascorecardmanager='description'> <div class='drawer'> <div class='score-wrap'> <div class='description-wrap'> <div data-adsmediascorecardmanager='description'> <div class='drawer'> <div class='ipc-metadata-list-item__content-container'> <div class='ipc-html-content ipc-html-content--base sc-ac2b5e16-0 deDizX' role='presentation'> <div class='ipc-html-content-inner-div' role='presentation'> <div class='ipc-html-content ipc-html-content--base' role='presentation'> <div class='ipc-html-content-inner-div' role='presentation'> <div class='cpx-bottomMargin-lg'> <div class='MovieSelectedDetails_container__ftjgX'> <div class='MovieSelectedDetails_detailsContainer__2seki'> <div class='MovieSelectedDetails_ctaAndDetails__BpCFb'> <div class='MovieSelectedDetails_genreContainer__qEtwh MovieSelectedDetails_movieDetail__8XtgT'> <div class='score-wrap'> <div class='description-wrap'> <div data-adsmediascorecardmanager='description'> <div class='drawer'> <p>When Waterloo gets a new semi-pro men’s hockey team, the local women’s amateur leagues are kicked out of the arena. Determined to avenge their lost ice time, an impulsive hockey player teams up with a local roller derby legend to recruit the town’s outcasts and form an underground roller derby team.</p> <p>This bold feminist sports comedy features a hilarious cast of characters that are sure to have you rolling in the aisles.</p> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> <div class='description-wrap'> <div data-adsmediascorecardmanager='description'> <div data-adsmediascorecardmanager='description'> <div class='drawer'> <div class='score-wrap'> <div class='description-wrap'> <div data-adsmediascorecardmanager='description'> <ul> <li><strong>Cast: </strong>Anne-Élisabeth Bossé, Gabrielle Côté, France Castel</li> <li><strong><strong>Director: </strong></strong>Mélanie Charbonneau</li> <li><strong><strong>Writers: </strong></strong>Gabrielle Côté</li> </ul> <p><strong>Genre:</strong> Comedy<br /> <strong>Duration:</strong> 1<span class='cpx-body' data-testid='movie-length'>h 35m</span><br /> <strong>Rating:</strong> PG<br /> <strong>Language:</strong> French (English subtitles)</p> <h3 style='text-align: center;'><strong>FREE! GENERAL SEATING AT THE DOOR</strong></h3> <p><img class='size-medium wp-image-242705 aligncenter' src='https://www.kingstheatre.ca/kingweb/wp-content/uploads/2026/02/canfilmday-social-sharer-300x158.webp' alt='' width='300' height='158' /></p> <ul class='p-rich_text_list p-rich_text_list__ordered p-rich_text_list--nested' data-stringify-type='ordered-list' data-list-tree='true' data-indent='0' data-border='0'> <li data-stringify-indent='0' data-stringify-border='0'><em>Doors open 45 minutes before showtime.</em></li> <li data-stringify-indent='0' data-stringify-border='0'><em> Children under 12 must be accompanied by a guardian.</em></li> <li data-stringify-indent='0' data-stringify-border='0'><em>Outside food and beverages may not be brought into the theatre.</em></li> </ul> <p>&nbsp;</p> </div> <p><iframe title='THE FURIES | In theatres November 28 2025' width='1080' height='608' src='https://www.youtube.com/embed/H-nIbxSboZ0?feature=oembed'  allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share' referrerpolicy='strict-origin-when-cross-origin' allowfullscreen></iframe></p> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> "
      }
    ],
