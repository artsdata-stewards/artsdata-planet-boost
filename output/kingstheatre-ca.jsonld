    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "MICHAEL HARRISON: VENTASTIC - King&#039;s Theatre"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Michael Harrison presents, VENTASTIC - Reimagining the Art of Ventriloquism. Michael is an extraordinarily talented ventriloquist, comedian and master showman who combines his many talents in this laugh out loud, one man tour de force. It's Fantastic Ventriloquism, it's VENTASTIC!"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "en",
        "@value": "en-US"
      }
    ]
  },
