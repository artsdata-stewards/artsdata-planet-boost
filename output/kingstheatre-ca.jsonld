    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><strong>Bringing Broadway to Annapolis Royal with ANDREW MORRISEY! </strong></p> <ul> <li>July 20- 24, 9:30am – 4:30pm daily</li> <li>Ages 10 – 17</li> <li>Camp finale show Friday July 24 at 3:30pm</li> </ul> <p>Participants will learn songs, scenes, and dances with Andrew Morrisey, an actor, singer and teacher originally from Truro, NS, now based in New York City. We are delighted to have Andrew back to Annapolis Royal for the 5th Summer with his incredibly popular camp!</p> <p><strong>Cost $350 + hst       </strong></p> <p>Advance registration is required. Space is limited.</p> <p><em><strong>There will be a free performance for the community on Friday July 24th at 3:30pm at Kings Theatre.</strong></em></p> <p><strong>What to bring each day:</strong></p> <ul> <li>Lunch, snacks and beverages for the day;</li> <li>Clean indoor footwear.</li> </ul> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
