      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "FISH AND DICKS - King's Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Fish and Dicks provides a farcical snapshot of life in the close-knit, remote communities of Digby Neck and Brier & Long Islands."
      }
    ],
    "http://ogp.me/ns#url": [
