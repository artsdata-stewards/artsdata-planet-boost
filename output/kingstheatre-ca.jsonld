    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2025-12-30T14:00-3:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "en",
        "@value": "2025-12-30T23:59-3:00"
