    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "AUDITIONS FOR KING'S SHORTS"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n                \n\nAUDITIONS for King’s Shorts Festival of 10-Minute Plays\nAudition Dates: \n\nSaturday April 5, 1-3pm\nThursday April 10, 6-8pm\n\nLocation: King’s Theatre\nAnyone interested in being cast in one of the Shorts is invited to attend one of the above auditions at King’s Theatre.\nPlease bring a short (less than 5-minute) prepared piece to read. Additional material will also be available to read to the Festival directors.\nIf you are unable to attend and are still interested in participating or want more information, please contact Verilea Ellis 902-245-2309 or verilea@yahoo.ca\nPerformances at King’s Theatre June 20, 21 & 22.\n\n\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
