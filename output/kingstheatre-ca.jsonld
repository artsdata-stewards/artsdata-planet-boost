        "@value": "Free Stage Makeup & Wig Workshop - King's Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "This three-hour session covers basic stage makeup and wig fastening, as well as basic wig styling, and emphasizes the significance of simple makeup techniques (and a few well-placed hairpins)."
      }
