  {
    "@id": "https://www.kingstheatre.ca/temporary/197ca267-57eb-4b65-966e-c75616005863",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/something-missing-a-play/"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
