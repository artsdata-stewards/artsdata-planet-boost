    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "A NIGHT OF GRIEF & MYSTERY - King's Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "A Night of Grief & Mystery combines stories and observations by author/culture activist Stephen Jenkinson, drawn from his decades of work in palliative care, with original songs/sonics by recording artist Gregory Hoskins."
      }
    ],
    "http://ogp.me/ns#url": [
