  {
    "@id": "https://www.kingstheatre.ca/new-events/alfie-zappacosta/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "ALFIE ZAPPACOSTA - King's Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Alfie Zappacosta is undeniably one of Canada’s premier songwriters and performers with chart topping hits and a recording and acting career that has spanned 40 years. He continues to evolve as an artist by “doing it his way”, an effort that has been rewarded with an impressive song catalogue and a discerning loyal fan base."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://www.kingstheatre.ca/new-events/alfie-zappacosta/"
      }
    ],
