  {
    "@id": "https://www.kingstheatre.ca/new-events/art-2/event_241715_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/art-2/"
