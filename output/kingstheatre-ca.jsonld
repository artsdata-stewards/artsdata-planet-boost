  {
    "@id": "https://www.kingstheatre.ca/new-events/andre-rieus-merry-christmas-2025/event_242254_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/andre-rieus-merry-christmas-2025/"
