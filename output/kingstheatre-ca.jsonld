    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2024/05/IMG_5720-crop-scaled.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2024-8-3T19:30-4:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "en",
        "@value": "2024-8-3T23:59-4:00"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "GREGORY MUSZKIE: THE GREG SHOW"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n                \n\n\nKing’s Theatre presents ‘The Greg Show’, a night of music, stories and surprises with our own Gregory Muszkie!\n\n\n\n\n\nSpecial guests include Sam Boer, Anita Cazzola, and Maddie Frisby.\n\n\n\n\nGregory Muszkie is a singer, songwriter, and storyteller who embodies the character of a flawed, naive individual — ‘Greg’ — who navigates a crazed modern world. His satirical style combines humour and ennui to bring a unique musical experience to all. Inspired by musics like The Barenaked Ladies, David Bowie, Rufus Wainwright, John Mayer and Stevie Wonder, he embarks on a journey of introspection and becoming.\n\n\nIn this solo show, Gregory equips both the piano and guitar to perform original works like ‘Weird Kid’, ‘Plastic’ and ‘One Step From My Heart’.\nThemes include: Cautionary storytelling, celebration of the self, love and passion, environmentalism, and the unknown.\n\nGregory Muszkie is a Graduate of Voice from the university of Regina, Saskatchewan. He is currently the house manager of King’s Theatre, a featured visual artist in the Annapolis Valley, and a big fan of natural sciences. He has been featured in King’s stage productions such as D. Rousseau’s The Rocky Horror: Film and Live Experience, Scrappy Lady Productions’ ‘Dracula’, and King’s Summer Lovin’ Cabaret.\n\n\n\n\nGreg’s original music can ONLY be heard at King’s Theatre!\nTICKETS\n\n\n\n\n Adults $25.00\nYouth: $10.00\n\nHST additional\nKing’s Theatre is committed to making live performances accessible to all audiences. If cost is a barrier please contact our Box Office for Bursary Tickets: boxoffice@kingstheatre.ca or 902-532-7704.\nDoors open 45 minutes before showtime.\n\nClick here for King’s Ticket Exchange policies\n\n\n\n \n \n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
