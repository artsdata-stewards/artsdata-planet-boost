    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<div id='movie-details-expander'> <div class='score-wrap'> <div class='description-wrap'> <div data-adsmediascorecardmanager='description'> <div class='drawer'> <div class='score-wrap'> <div class='description-wrap'> <div data-adsmediascorecardmanager='description'> <div class='drawer'> <div class='ipc-metadata-list-item__content-container'> <div class='ipc-html-content ipc-html-content--base sc-ac2b5e16-0 deDizX' role='presentation'> <div class='ipc-html-content-inner-div' role='presentation'> <div class='ipc-html-content ipc-html-content--base' role='presentation'> <div class='ipc-html-content-inner-div' role='presentation'> <div class='cpx-bottomMargin-lg'> <div class='MovieSelectedDetails_container__ftjgX'> <div class='MovieSelectedDetails_detailsContainer__2seki'> <div class='MovieSelectedDetails_ctaAndDetails__BpCFb'> <div class='MovieSelectedDetails_genreContainer__qEtwh MovieSelectedDetails_movieDetail__8XtgT'>In Walt Disney Animation Studios&#8217; &#8220;Zootopia 2,&#8221; detectives Judy Hopps (voiced by Ginnifer Goodwin) and Nick Wilde (voiced by Jason Bateman) find themselves on the twisting trail of a mysterious reptile who arrives in Zootopia and turns the mammal metropolis upside down. To crack the case, Judy and Nick must go undercover to unexpected new parts of town, where their growing partnership is tested like never before.</div> </div> </div> </div> </div> <div class='VideoBillboardContent_expanderWrap__Zcq_E cpx-bottomMargin-xxl'> <div id='movie-details-expander'> <div class='AdditionalDetails_contentBox__pAxPZ'></div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> <div class='description-wrap'> <div data-adsmediascorecardmanager='description'> <div data-adsmediascorecardmanager='description'> <div class='drawer'> <div class='score-wrap'> <div class='description-wrap'> <div data-adsmediascorecardmanager='description'> <ul> <li><strong>Stars: </strong>Ginnifer Goodwin, Jason Bateman, Ke Huy Quan</li> <li><strong><strong>Director: </strong></strong>Jared Bush, Byron Howard</li> <li><strong><strong>Writers: </strong></strong>Jared Bush</li> </ul> <p><img class='alignnone size-medium wp-image-242499 aligncenter' src='https://www.kingstheatre.ca/kingweb/wp-content/uploads/2025/11/Zootopia-2-Rating-300x77.png' alt='' width='300' height='77' /></p> <p><strong>Genre: </strong><span class='cpx-body' data-testid='genres'>Animation/Comedy</span><br /> <strong>Duration:</strong> <span class='cpx-body' data-testid='movie-length'>1h 48min</span><br /> <strong>Rating:</strong> PG</p> <p><strong>TICKETS:</strong><br /> <strong>$11.95 Adult</strong><br /> <strong>$7.95 Youth (under 18)</strong><br /> (HST additional)</p> <ul> <li><em>Doors open 45 minutes before showtime.</em></li> <li><em>King’s Theatre is committed to accessibility. If price is a barrier to attending, please request a ‘Bursary Ticket’ at the Box Office.</em></li> <li><em>Tickets are not refundable for cash, but can be exchanged for credit with a minimum of 48 hours notice. Credits are valid for 12 months.</em></li> <li><em>All persons require a ticket; we do not allow babes in arms. Children under 12 must be accompanied by a guardian.</em></li> <li><em>Outside food and beverages may not be brought into the theatre.</em></li> <li><em>For more information about Theatre policies, click <a href='https://www.kingstheatre.ca/about/ticket-info/'>here.</a></em></li> </ul> <p>&nbsp;</p> </div> <p><iframe title='Zootopia 2 | Trailer' width='1080' height='608' src='https://www.youtube.com/embed/BjkIOU5PhyQ?feature=oembed'  allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share' referrerpolicy='strict-origin-when-cross-origin' allowfullscreen></iframe></p> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> "
