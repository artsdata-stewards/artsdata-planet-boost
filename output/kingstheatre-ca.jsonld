    "http://schema.org/image": [
      {
        "@id": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2023/11/Screenshot-2023-11-23-at-16-00-24-HOME-Grace-2-The-Tragically-Hip-Tribute-Canada-2.png"
