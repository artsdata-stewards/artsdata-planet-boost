        "@language": "en-us",
        "@value": "Shiny Happy People – A Tribute to R.E.M. - King's Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Valley musicians Jeff Hennessy, Nicholas D’Amato, Noah Scanlan, Alec Bloch and some special guests deliver an authentic tribute to R.E.M. that will please both die hard fans and those who only know the hits!"
      }
    ],
    "http://ogp.me/ns#url": [
