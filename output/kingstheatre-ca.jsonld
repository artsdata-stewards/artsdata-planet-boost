    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Stick&Bow unites Canadian marimba player Krystina Marcoux and Argentinian cellist Juan Sebastian Delgado. Classically trained musicians, they strive to present a wide spectrum of musical styles, ranging from rock to gypsy-jazz, baroque or tango."
