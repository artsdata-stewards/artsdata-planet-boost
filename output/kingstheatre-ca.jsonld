  {
    "@id": "https://kingstheatre.ca/events/event_242354_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/hysteria/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2025/11/525582069_1288612329941572_9131688634775905404_n.jpg"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://kingstheatre.ca/events/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "HYSTERIA"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<div id='comp-ly4fq7k3' class='Z_l5lU ku3DBC zQ9jDz qvSjx3 Vq6kJx comp-ly4fq7k3 wixui-rich-text' data-testid='richTextElement'> <p class='text-align-left'><strong>Hysteria</strong> is a group of Montreal musicians that just love the music. Pat, the band leader, is a passionate Def Leppard fan and always dreamt of bringing together people to play their music. Hysteria&#8217;s<span class=''> repertoire will bring you back to the great rock era. You&#8217;ll want to sing  your heart out with us. From </span>Pour Some Sugar<span class=''> on me to </span>Bringing on the Heartbreak, we are going to play those for you.</p> <div id='1108059754' class='u_1108059754 dmNewParagraph' data-element-type='paragraph' data-version='5' data-styletopreserve='{'> <ul> <li class='text-align-center size-22'><strong><span class='font-size-22'>Pat McTurner: </span></strong>Lead Rhythm Guitarist</li> <li id='1404806260' class='u_1404806260 dmNewParagraph' data-element-type='paragraph' data-version='5'> <p class='text-align-center size-22'><strong><span class='font-size-22'>Frankie Raffa: </span></strong><span class='m-font-size-16'>Lead Vocals</span></p> </li> <li class='u_1404806260 dmNewParagraph' data-element-type='paragraph' data-version='5'> <p class='text-align-center size-22'><strong><span class='font-size-22'>Anthony Doyle: </span></strong>Lead Rhythm Guitarist</p> </li> <li class='u_1404806260 dmNewParagraph' data-element-type='paragraph' data-version='5'> <p class='text-align-center size-22'><span class='font-size-24 m-font-size-19'><strong>Hugo Delarosbil:</strong> </span>Drummer</p> </li> <li class='u_1404806260 dmNewParagraph' data-element-type='paragraph' data-version='5'> <p class='text-align-center size-22'><strong class='m-font-size-19 font-size-24'>Nick Maglieri: </strong>Bassist</p> </li> </ul> </div> </div> <p>&nbsp;</p> <p><strong>TICKETS:</strong></p> <ul> <li><strong>Adults: $45</strong></li> <li><strong>Youth: $15 (Under 18)</strong></li> <li>HST additional</li> </ul> <div class='TitleBlock__TitleMetaDataContainer-sc-1nlhx7j-2 hWHMKr'> <p><strong>Doors open 45 minutes before showtime. Please arrive early.</strong></p> <p>Children under 12 must be accompanied by a guardian when attending a King’s Theatre event</p> </div> <p><small><b><small></small></b><b><small><a href='https://www.kingstheatre.ca/about/ticket-info/'>No refunds. Click here for King’s Ticket Exchange policies</a></small></b></small></p> <p>&nbsp;</p> "
      }
    ],
