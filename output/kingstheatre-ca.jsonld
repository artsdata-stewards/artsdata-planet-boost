        "@value": "DANCE FOR ALL - BALLET JORGEN - King's Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "This mixed program will showcase excerpts from major classical ballets such as Romeo & Juliet, The Nutcracker, our smash hit Anne of Green Gables – The Ballet, along with exciting new contemporary works by Canadian choreographers."
      }
    ],
