    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2025/02/Dr.-Strangelove-S2S-1056-x-480-Spektrix-Thumbnail.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2025-5-18T15:00-4:00"
      }
    ],
    "http://schema.org/endDate": [
