    "http://schema.org/image": [
      {
        "@id": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2025/10/GNO-2025-photo-by-Dahlia-Katz.jpg"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
