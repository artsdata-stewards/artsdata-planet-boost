    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Duo Beija-Flor - King's Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Flute and guitar duo, Duo Beija-Flor, presents a dynamic and accessible repertoire of classical works inspired by the many diverse cultures found around the world. This fresh and modern style they call ethno-classical highlights the emotions and experiences we all share, expressing them through the lens of music. "
      }
    ],
    "http://ogp.me/ns#url": [
