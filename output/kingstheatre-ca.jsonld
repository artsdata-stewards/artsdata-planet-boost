        "@value": "BBOYIZM - King's Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "True to the essence of street dance, Bboyizm works to preserve and promote authentic street dance within the communities we tour. Our education and outreach activities leverage street dance as a tool for youth, educators, and parents to connect through a shared understanding of self-expression."
      }
    ],
