        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
  {
    "@id": "https://www.kingstheatre.ca/new-events/laila-biali-wintersongs-holiday-classics/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
