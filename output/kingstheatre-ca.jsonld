    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2024/02/Screenshot-2024-02-07-162219-e1707337460560.png"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2024-3-24T15:00-4:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "en",
