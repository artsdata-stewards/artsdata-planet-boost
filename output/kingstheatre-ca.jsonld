    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2025/11/Z73qK57c43Q3gNmd_NUTHERO_GaryAvisasHerrDrosselmeyerGiacomoRoveroasHansPeterandMariannaTsembenhoiasClaraTheNutcrackerbackstageandsidestage©2023ROH.PhotographedbyAndrejUspenski.avif"
