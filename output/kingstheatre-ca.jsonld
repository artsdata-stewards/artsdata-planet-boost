    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2025/11/Hamlet-starring-Hiran-Abeysekera-at-the-National-Theatre.webp"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2026-2-22T14:00-3:00"
      }
