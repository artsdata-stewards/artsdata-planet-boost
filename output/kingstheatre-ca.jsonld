        "@value": "JOHN PRINE TRIBUTE - King's Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "A memorable evening of John Prine’s finest songs & stories, performed by eight seasoned veteran songwriter/musicians’ and friends’, who are lifelong fans of John Prine. A show that includes a multimedia layer of captivating still pics."
      }
    ],
