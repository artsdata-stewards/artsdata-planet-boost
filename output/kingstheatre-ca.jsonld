      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "MICHAEL KAESHAMMER - King's Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Michael isn’t so much a piano player as a piano whisperer, a master musician and songwriter able to coax dazzling, kaleidoscopic sounds from his instrument in a way few can rival"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://www.kingstheatre.ca/new-events/michael-kaeshammer/"
      }
    ],
    "http://ogp.me/ns#site_name": [
