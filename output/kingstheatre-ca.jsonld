  {
    "@id": "https://www.kingstheatre.ca/new-events/rum-ragged/event_242204_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/rum-ragged/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2025/10/oota_rum_aug2023-01d.webp"
