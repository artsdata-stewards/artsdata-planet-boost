    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2025/10/Screenshot-2025-10-17-at-11.55.30-AM.png"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2026-3-8T14:00-3:00"
      }
