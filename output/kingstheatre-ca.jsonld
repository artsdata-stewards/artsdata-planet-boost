    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Annual General Meeting"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><strong>The King&#8217;s Theatre Society hosts its Annual General Meeting at 7pm on Monday March 31, 2025 at King&#8217;s Theatre.</strong></p> <p>The agenda will include reports on the 2024 year, the audited financial statements, and the election of the Board of Directors.</p> <p>Donor-Members in good standing are welcome to vote, as well as to put their name forward to serve on the Board of Directors. A Donation of $25 or more constitute Membership, and is eligible for a tax receipt. <a href='https://www.kingstheatre.ca/support-us/donate/'>Click here to donate.</a></p> <p><strong>Please see the attached document for proposed changes to the by-laws:</strong></p> <p><a href='https://www.kingstheatre.ca/kingweb/wp-content/uploads/2025/02/Proposed-By-Law-Changes-March-2025.pdf'>Proposed By Law Changes March 2025</a></p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-3-31T19:00-3::00"
      }
    ],
