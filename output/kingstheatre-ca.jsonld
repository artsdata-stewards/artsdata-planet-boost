      {
        "@language": "en",
        "@value": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2024/02/kings-theatre-aglow-1.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
