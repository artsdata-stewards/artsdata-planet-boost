    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2025/10/Screenshot-2026-01-13-at-3.46.41-PM.png"
      }
    ],
    "http://schema.org/startDate": [
