    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "JAH'MILA - King's Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Jah-Mila is a Juno-nominated reggae singer hailing from Kingston, Jamaica, who now calls Nova Scotia home. A beacon for Jamaican music and culture in Atlantic Canada, Jah’Mila's music embodies the spirit of traditional Jamaican roots reggae music, infused with light elements of jazz and soul."
      }
    ],
