  {
    "@id": "https://www.kingstheatre.ca/new-events/fleabag-national-theatre-live/event_239620_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/fleabag-national-theatre-live/"
