    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "CELEBRATING CELINE - King's Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Experience the ultimate Celine Dion tribute Concert. CELEBRATING CELINE is a stunning celebration of the music and life of one of the greatest singers of our time. Starring January Butler as ‘Celine Dion’ and an outstanding live band, the audience are taken on a magical ride through four decades of hits."
      }
    ],
