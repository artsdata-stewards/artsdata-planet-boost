    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Sam Mendes directs Johnny Flynn as Richard Burton, Mark Gatiss as John Gielgud and Tuppence Middleton as Elizabeth Taylor, in this fierce and funny new play by Jack Thorne, offering a glimpse into the politics of a rehearsal room and the relationship between art and celebrity."
      }
