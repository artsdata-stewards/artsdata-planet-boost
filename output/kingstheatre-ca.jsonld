  {
    "@id": "https://www.kingstheatre.ca/new-events/art-3/event_241716_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/art-3/"
