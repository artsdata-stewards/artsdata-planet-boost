    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Sparkle Dance: THE JOY OF CHRISTMAS"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<div dir='ltr'> <div dir='ltr'> <div dir='ltr'> <div dir='ltr'> <div class='moz-text-html' lang='x-unicode'> <div dir='ltr'> <div class='moz-text-html' lang='x-unicode'> <p><strong>Sparkle Dance returns to the King’s Theatre stage with ‘The Joy of Christmas’, an all new show that will get you in the spirit of Christmas!</strong></p> <p><strong>Happening Sunday November 23 at 2pm &amp; 6pm.</strong></p> <p>Experience 90+ children, teens, and adult performers on stage in this highly entertaining community dance show by Sparkle Dance. ✨ Join us for an entertaining dance experience that will leave you inspired and ready to start the holiday season!</p> <ul> <li>Director, Producer: Wendy Goudie</li> <li>Choreography: Wendy Goudie, Violet MacDonald, Elizabeth Inglis, Margo Welch, Moxy Manitowabi</li> <li>Co-Producer, Music and Photography: John Goudie</li> <li>Costumes: Sandra Rector</li> <li>Technical Director: Devin Fraser</li> <li>Energy and Creativity: All the kids!</li> </ul> <p><strong>TICKETS:</strong></p> <ul> <li><strong>Adults: $20 for one show/$30 for both shows </strong><em>(please contact the box office at 902-532-7704)</em></li> <li><strong>Youth: $5 for each show</strong></li> </ul> <p>&nbsp;</p> <p><strong><img class='size-full wp-image-242118 alignleft' src='https://www.kingstheatre.ca/kingweb/wp-content/uploads/2025/09/e339dfde.jpeg' alt='' width='251' height='130' />Sparkle Dance </strong><strong>Academy</strong> started in 2001 in BC by <strong>Wendy Goudie</strong>. Focused on World Dance, SDA enjoyed a successful 20+ years in BC. Now settled in the Annapolis Valley, Nova Scotia, Sparkle Dance programs are dedicated to teaching youth life skills through the art of non-competitive performance. The studio runs on a model of mentorship, with older dancers guiding younger dancers on costumes, make up, hair, backstage organization, public speaking and more. SDA dancers perform throughout the community at retirement homes, events and fundraisers. <em><strong>Handcrafting self-confidence, and covering it in glitter! </strong></em></p> <div id='signature'></div> </div> </div> <div dir='ltr'></div> <div dir='ltr'></div> </div> </div> </div> </div> </div> "
      }
    ],
