  {
    "@id": "https://www.kingstheatre.ca/new-events/dufflebag-theatres-cinderella/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "DUFFLEBAG THEATRE'S CINDERELLA - King's Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The comedic timing is bang on as curfews, lost footwear, and giant pumpkins abound in this fun-filled version of the classic fairy tale from DuffleBag Theatre, especially when members of the audience are invited to star in the show!"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://www.kingstheatre.ca/new-events/dufflebag-theatres-cinderella/"
      }
