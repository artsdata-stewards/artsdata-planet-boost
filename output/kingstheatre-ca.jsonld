  {
    "@id": "https://www.kingstheatre.ca/new-events/event_239852_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/dick-whittington-his-cat-3/"
