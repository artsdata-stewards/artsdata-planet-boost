        "@value": "GEOFF ARSENAULT - King's Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Geoff Arsenault is a multi award winning, veteran, touring and recording artist. Based in the East of Canada, his unique style and skill behind the drum kit has taken him clear across North America, all through Europe, and the UK."
      }
    ],
