  {
    "@id": "https://www.kingstheatre.ca/new-events/rumour-has-it-the-songbook-of-adele/event_239724_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/rumour-has-it-the-songbook-of-adele/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2023/11/Rumour-Has-It-crop.jpg"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/rumour-has-it-the-songbook-of-adele/"
