    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2025-12-11T19:00-3:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "en",
        "@value": "2025-12-11T23:59-3:00"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "BABY IT'S COLD OUTSIDE"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n                The Annapolis Basin Community Band invites you to join them for a fun evening of holiday music! The ABCB is a group of community musicians who meet weekly under the direction of Jolene Buchholz.\nWe will be joined for a guest performance by the recently revived Annapolis West Education Centre Concert Band, who will be making their debut performance. This small, yet mighty group of students began learning their instruments in September under the leadership of Jolene Buchholz.\nJoin us to show your support for community music!\n\nTICKETS:  \nAdults: $20\nYouth: $5\n\n\n\n\n\n\nDonations of cash and non-perishable food items for the Annapolis Area Food Bank will be collected.\n\n\n\nDoors open 45 minutes before showtime. Please arrive early.\nAll persons require a ticket; we do not allow babes in arms. Children under 12 must be accompanied by a guardian.\nOutside food and beverages may not be brought into the theatre.\nFor more information about Theatre policies, click here.\n\n\n\n \n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
