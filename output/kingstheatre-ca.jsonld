    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Hysteria is a group of Montreal musicians that just love the music. Pat, the band leader, is a passionate Def Leppard fan and always dreamt of bringing together people to play their music."
      }
