    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2023/10/header.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2023-11-19T15:00-4:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "en",
