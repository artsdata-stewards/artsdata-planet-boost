    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n                \n\nMichael Mayer’s sumptuous production of Verdi’s beloved tragedy returns, featuring soprano Diana Damrau and tenor Juan Diego Flórez in this 2018 performance. Yannick Nézet-Séguin conducts.\n\nComposer: Giuseppe Verdi, Conductor: Yannick Nézet-Séguin, Production: Michael Mayer\n\n\nCast: Diana Damrau, Juan Diego Flórez, Quinn Kelsey\n\n\n\nEstimated Run Time 2h 40m\nTICKETS:  $16.95\nHST additional\nDoors open 45 minutes before showtime. Please arrive early.\nChildren under 12 must be accompanied by a guardian when attending a King’s Theatre event\n\n \n            "
      }
