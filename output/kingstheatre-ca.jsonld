    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "THINKING BEYOND THE MARKET"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<div id='movie-details-expander'> <div class='score-wrap'> <div class='description-wrap'> <div data-adsmediascorecardmanager='description'> <div class='drawer'> <div class='score-wrap'> <h3 data-rte-preserve-empty='true'><strong>Solutions to the housing crisis are hiding in plain sight!</strong></h3> <p data-rte-preserve-empty='true'><strong>FREE SCREENING</strong> of a new Canadian documentary that looks beyond market forces to find real solutions to the housing crisis is coming to Annapolis Royal, complete with a live Q&amp;A with the filmmaker.</p> <p data-rte-preserve-empty='true'>The screening at King&#8217;s Theatre is Hosted by the Municipality of Annapolis County, who have made it <strong>FREE ADMISSION</strong> for all (General Seating at the Door).</p> <div class='description-wrap'> <div data-adsmediascorecardmanager='description'> <div data-adsmediascorecardmanager='description'> <div class='drawer'> <div class='score-wrap'> <div class='description-wrap'><strong>Dr. Brian Doucet,</strong> an associate professor in the School of Planning at the University of Waterloo who created the documentary, will join the screening via video link for a post-film discussion.</div> <div></div> </div> </div> </div> <div><a href='https://www.housingfilm.ca/trailer'>https://www.housingfilm.ca/trailer</a></div> </div> </div> </div> </div> </div> </div> </div> </div> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
