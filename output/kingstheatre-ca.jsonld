    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2025/12/next-gen-banner-1-scaled.png"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://kingstheatre.ca/events/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "NEXT GEN THEATRE WORKSHOP"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><strong>A series of FREE workshops for youth aged 8-17 who are interested in learning about the magical world of Theatre &#8212; both on stage and backstage!</strong></p> <p><strong>The workshops will take place every Tuesday, 5:30-7:30pm, from January 13 to June 2, on the King&#8217;s Theatre stage.</strong></p> <p>Participants will learn theatre skills, self confidence, and how to work together in ensemble.</p> <p>Each workshop will focus on a different area of theatre. Topics to be covered include:</p> <p><strong>Acting, Story Telling, Improvisation, Directing, Movement, Voice, Production, Stage Tech, and so much more!</strong></p> <p>While participation in ALL workshops is not mandatory, it is highly recommended.</p> <p><strong>Space is limited &#8212; register today!</strong></p> <p>The workshops series will conclude with a SHOWCASE PERFORMANCE at King&#8217;s Theatre on June 13.</p> <p><em>Presented by King&#8217;s Theatre in partnership with Young Company Productions, with support from the Canada Post Community Foundation.</em></p> <p>&nbsp;</p> "
      }
    ],
