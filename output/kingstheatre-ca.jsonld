  {
    "@id": "https://www.kingstheatre.ca/new-events/michael-kaeshammer/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
