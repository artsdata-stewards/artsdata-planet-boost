        "@language": "en-us",
        "@value": "FODAR: Program One - King's Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "FODAR returns with a lineup of provocative and sometimes heart-stopping dance! Live performance is alive and well and definitely in top form in our beautiful part of the world."
      }
    ],
