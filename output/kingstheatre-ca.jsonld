        "@value": "ANNAPOLIS GUITAR QUARTET - King's Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The Amadeus Guitar Duo and the Duo Cormier-Martin come together to create the ANNAPOLIS GUITAR QUARTET. Experience the incredible energy of four virtuoso classical guitars playing works by Boccherini, Jenkins, Spanish and tango composers, and much more."
      }
    ],
