  {
    "@id": "https://www.kingstheatre.ca/temporary/be74cdb5-4911-4810-ad1c-20a490aac3ac",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/dance-theatre-camp-for-youth/"
      }
