    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2023/12/OML_web1_MatDunlap.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2024-2-10T19:30-4:00"
      }
    ],
    "http://schema.org/endDate": [
