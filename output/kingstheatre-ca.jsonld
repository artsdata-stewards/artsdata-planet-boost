  {
    "@id": "https://www.kingstheatre.ca/new-events/acting-workshop-with-jeremy-watkins/event_240005_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/acting-workshop-with-jeremy-watkins/"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
