  {
    "@id": "https://www.kingstheatre.ca/new-events/bboyizm/event_239712_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/bboyizm/"
