    ]
  },
  {
    "@id": "https://www.kingstheatre.ca/temporary/d90b2df8-6a0b-4452-94f3-b82e97e2a68f",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
