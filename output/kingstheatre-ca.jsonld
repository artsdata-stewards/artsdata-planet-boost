    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2024/08/IMG_8579.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2024-8-30T15:30-4:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "en",
