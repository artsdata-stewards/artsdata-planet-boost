      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2025-11-1T19:30-4:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "en",
        "@value": "2025-11-1T23:59-4:00"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Poet of The Common Man: Tribute to Merle Haggard"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n                Join Lawrence Maxwell and the Band of Fugitives as they pay tribute to country music legend, Merle Haggard.\nTake in the turbulent life of ‘The Hag’ through the stories and songs from his train-jumping days in California all the way through his prolific career as one of country music’s most iconic outlaws.\nThe band features: Nick Doneff, Peter Cann, Thomas Webb, Ben Aitken and Mark Geddes.\nCLICK HERE FOR PROGRAM \nTICKETS\n\n Adults $40.00\nYouth: $15.00\n\nHST additional\nKing’s Theatre is committed to making live performances accessible to all audiences. If cost is a barrier please contact our Box Office for Bursary Tickets: boxoffice@kingstheatre.ca or 902-532-7704.\nDoors open 45 minutes before showtime.\n\nClick here for King’s Ticket policies\n\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
