        "@value": "TILT - King&#039;s Theatre"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "TILT is a hybrid theatre/improv show where each performance is different, as a prompt from the audience sends the story – and performers – into an improvised tailspin!"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "en",
        "@value": "en-US"
      }
