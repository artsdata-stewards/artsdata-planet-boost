  },
  {
    "@id": "https://www.kingstheatre.ca/new-events/joel-plaskett-new-date/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "JOEL PLASKETT NEW DATE - King's Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "From rocking Halifax’s Marquee Club to performing for the masses at Massey Hall or touring the country with his father, Joel Plaskett has forged a reputation as one of Canada’s most engaging performers and respected singer-songwriters."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://www.kingstheatre.ca/new-events/joel-plaskett-new-date/"
      }
    ],
