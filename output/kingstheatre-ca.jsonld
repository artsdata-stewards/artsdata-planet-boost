    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Solemn and soaring, backed by a swirling blend of indie, soul and electronic soundscapes, mournful saxophone and pulse-quickening finger-picking, Aysanabee’s striking sound is equal parts hypnotic and melodic which has been compared to Bon Iver, Matt Corby, Don Ross, Kim Churchill, Kings of Leon and Sam Smith."
      }
