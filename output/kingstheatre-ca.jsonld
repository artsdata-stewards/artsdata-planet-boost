  {
    "@id": "https://www.kingstheatre.ca/temporary/46dcf5f7-5c8c-41e1-a5fb-81eacdc702f2",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/rum-ragged/"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "_:g4165140"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/rum-ragged/"
      }
    ],
    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2025/10/oota_rum_aug2023-01d.webp"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2026-2-21T19:30-3:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "en",
        "@value": "2026-2-21T23:59-3:00"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "RUM RAGGED"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n                Catch a piece of Newfoundland with JUNO Award Nominees Rum Ragged, who take a bold approach to the distinct folk music of their home. With a reverence for their roots and a creative, contemporary edge, this young band has quickly become known as the finest performers of their great, living, musical tradition. Boasting bouzouki, fiddle, bodhran, banjo, guitar, and button accordion, these new champions of East Coast music enliven and enlighten audiences with their signature brand of Newfoundland folk. Always honest, thought-provoking, and often humorous, it’s Rum Ragged’s live show that makes them a fast favourite with any audience. Their combination of striking vocal harmonies, staggering musicianship, and captivating storytelling gives concert-goers an experience they won’t soon forget. Since their inception in 2016, Rum Ragged has maintained a rigorous tour schedule, performing at some of the world’s premier folk, Celtic and roots venues all while managing to record four acclaimed, award-winning studio albums. Rum Ragged is not your run-of-the-mill folk band, they are the genuine article.\n\nTICKETS:  \n\nAdults: $40\nYouth: $10\nHST additional\n\n\n\n\n\n\n\n\nDoors open 45 minutes before showtime. Please arrive early.\nKing’s Theatre is committed to accessibility. If price is a barrier to attending, please request a ‘Bursary Ticket’ at the Box Office.\nTickets are not refundable for cash, but can be exchanged for credit with a minimum of 48 hours notice. Credits are valid for 12 months.\nAll persons require a ticket; we do not allow babes in arms. Children under 12 must be accompanied by a guardian.\nOutside food and beverages may not be brought into the theatre.\nFor more information about Theatre policies, click here.\n\n\n\n\n\n\n \n\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
  {
    "@id": "https://www.kingstheatre.ca/new-events/gina-burgess/",
