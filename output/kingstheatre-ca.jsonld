    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2025/11/shorts-logo-banner.jpg"
      }
    ],
    "http://schema.org/startDate": [
