    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2023/11/1W3A0690-Edit-1.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2024-11-17T19:30-4:00"
      }
    ],
    "http://schema.org/endDate": [
