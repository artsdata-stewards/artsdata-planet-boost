        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "LAILA BIALI: WINTERSONGS & HOLIDAY CLASSICS - King's Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Following a triumphant global premiere of her new show Wintersongs & Holiday Classics at Toronto’s Koerner Hall in Toronto, multi-award winning vocalist, pianist, songwriter, and national radio host LAILA BIALI returns to the King's Theatre stage with an extraordinary 9-person show, kicking off her national tour!!!"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://www.kingstheatre.ca/new-events/laila-biali-wintersongs-holiday-classics/"
      }
    ],
