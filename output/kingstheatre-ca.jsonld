    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "ALFIE ZAPPACOSTA"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n                \n\n\n\nJUNO winner Alfie Zappacosta is one of Canada’s premier songwriters and performers with chart-topping hits and a recording and acting career that has spanned 40 years. He continues to evolve as an artist by “doing it his way”, an effort that has been rewarded with an impressive song catalogue and a loyal fan base.\n\n\n\n\nTICKETS\n\n\n\n\n Adults $35.00\nYouth: $10.00\n\nHST additional\n\n\nDoors open 45 minutes before showtime.\nKing’s Theatre is committed to accessibility. If price is a barrier to attending, please request a ‘Bursary Ticket’ at the Box Office.\nTickets are not refundable for cash, but can be exchanged for credit with a minimum of 48 hours notice. Credits are valid for 12 months.\nAll persons require a ticket; we do not allow babes in arms. Children under 12 must be accompanied by a guardian.\nOutside food and beverages may not be brought into the theatre.\nFor more information about Theatre policies, click here.\n\n\n\n\n\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
