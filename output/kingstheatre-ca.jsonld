    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Youth Creative Showcase 2! - King&#039;s Theatre"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Sparkle Dance Academy and King's Theatre's Next Gen Break Dance program are collaborating to bring another showcase of youth performance! Sparkle Dancers will share collaborative self choreographed group pieces to close off their spring dance session. Special guest DJ Mystic Nic will be spinning world beats for the Break Dancers as they highlight their new skills."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "en",
        "@value": "en-US"
      }
    ]
