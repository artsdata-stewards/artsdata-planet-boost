    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2024/11/966920c6-8cd0-40bd-a4af-b2d6f9ed395a.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2025-9-12T19:30-4:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "en",
