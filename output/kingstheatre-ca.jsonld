    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "16th ANNUAL TOURNAMENT OF KING'S"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n                \n\n\n\n\n\nThe 16th Annual Tournament of King’s will take place on Saturday, September 14, 2024\n\nThe tournament will once again take place at the beautiful Fort View Golf Course, where in addition to 18 holes of golf you will be provided with gourmet lunches prepared by Founders House, delivered right to you on the course for your enjoyment! We’ll also have a raffle prize basket filled by local businesses.\n\n\n\nContact us for more information: 902-532-7704 or golf@kingstheatre.ca\n\n\n\nTHANK YOU TO OUR 2025 BUSINESS PARTNERS!\n\n\n\n\nTEE-UP CONCERT:\nHELP! THE DEFINITIVE BEATLES TRIBUTE CONCERT\n\nFriday September 13th at 7:30pm at King’s Theatre.\nThank you to our official Tournament of King’s Concert Partner Hutchins Pharmacy!\n\nClick here for tickets and more info.\n \n \n \n \n \n \n \n \n \n\n \n            "
      }
    ],
