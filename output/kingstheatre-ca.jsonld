    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "OFF THE ROCK: CANADA&#039;S GREAT BIG SEA TRIBUTE"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<div id='item-62e01b9b77c6355ecaa95034' class='sqs-layout sqs-grid-12 columns-12' data-layout-label='Post Body' data-type='item' data-updated-on='1658854556125'> <div id='yui_3_17_2_1_1763739098427_281' class='row sqs-row'> <div id='yui_3_17_2_1_1763739098427_280' class='col sqs-col-12 span-12'> <div id='block-0c7569a975872279d4b7' class='sqs-block html-block sqs-block-html' data-block-type='2' data-border-radii='{&quot;topLeft&quot;:{&quot;unit&quot;:&quot;px&quot;,&quot;value&quot;:0.0},&quot;topRight&quot;:{&quot;unit&quot;:&quot;px&quot;,&quot;value&quot;:0.0},&quot;bottomLeft&quot;:{&quot;unit&quot;:&quot;px&quot;,&quot;value&quot;:0.0},&quot;bottomRight&quot;:{&quot;unit&quot;:&quot;px&quot;,&quot;value&quot;:0.0}}' data-sqsp-block='text'> <div class='sqs-block-content'> <div class='sqs-html-content' data-sqsp-text-block-content=''> <div class='fl-module fl-module-rich-text fl-node-662aef9a86485' data-node='662aef9a86485'> <div class='fl-module-content fl-node-content'> <div class='fl-rich-text'> <p>Off The Rock is North America’s premier tribute to one of Canada’s greatest musical icons, Great Big Sea. Playing the group&#8217;s classics as well as East Coast Traditional songs, Off The Rock brings an interactive and engaging show that keeps audiences talking about their evening hours, days, even weeks later!</p> <p>Featuring the musical talents of Anthony Clayton, Thom Danger Speck, Sean Battams, Steve Peckford, and David Skolnick, this dynamic group brings the spirit of the Canadian East Coast home, wherever home may be.</p> </div> </div> </div> </div> </div> </div> </div> </div> </div> <p><strong>TICKETS: </strong></p> <ul> <li><strong>$45 Adults</strong></li> <li><strong>$15 Youth<br /> </strong></li> </ul> <div class='style__notes___25v7J'> <div class='main-title'> <div class='TitleBlock__TitleMetaDataContainer-sc-1nlhx7j-2 hWHMKr'> <div class='style__notes___25v7J'> <div class='main-title'> <div class='TitleBlock__TitleMetaDataContainer-sc-1nlhx7j-2 hWHMKr'> <p><em>HST additional</em></p> <ul> <li style='list-style-type: none;'> <ul> <li><em>Doors open 45 minutes before showtime. Please arrive early.</em></li> <li><em>King’s Theatre is committed to accessibility. If price is a barrier to attending, please request a ‘Bursary Ticket’ at the Box Office.</em></li> <li><em>Tickets are not refundable for cash, but can be exchanged for credit with a minimum of 48 hours notice. Credits are valid for 12 months.</em></li> <li><em>All persons require a ticket; we do not allow babes in arms. Children under 12 must be accompanied by a guardian.</em></li> <li><em>Outside food and beverages may not be brought into the theatre.</em></li> <li><em>For more information about Theatre policies, click <a href='https://www.kingstheatre.ca/about/ticket-info/'>here.</a></em></li> </ul> </li> </ul> </div> </div> </div> <p>&nbsp;</p> <p>&nbsp;</p> </div> </div> </div> <div> <div class='style__notes___25v7J'> <div class='main-title'> <div class='TitleBlock__TitleMetaDataContainer-sc-1nlhx7j-2 hWHMKr'>  </div> </div> </div> </div> "
      }
    ],
