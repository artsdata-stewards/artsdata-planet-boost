    ]
  },
  {
    "@id": "https://www.kingstheatre.ca/temporary/06949857-bb5b-49e3-a9ec-ae3e0c68f162",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
