    "http://schema.org/image": [
      {
        "@id": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2025/08/785x590-romeo-intro.jpg"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/romeo-et-juliette/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Gounod’s Roméo et Juliette"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<div class='synopsis__body__jZWmX xlarge'> <div id='movie-details-expander'> <p><span class='cpx-body'>In this dazzling 2024 Met performance, soprano Nadine Sierra and tenor Benjamin Bernheim are the star-crossed lovers in Gounod’s operatic adaptation of Shakespeare’s immortal love story. Yannick Nézet-Séguin conducts.</span></p> <p>Two singers at the height of their powers—radiant soprano <strong>Nadine Sierra</strong> and tenor sensation <strong>Benjamin Bernheim</strong>—come together as the star-crossed lovers in Gounod’s sumptuous Shakespeare adaptation, with Met Music Director Yannick Nézet-Séguin on the podium to conduct one of the repertoire’s most romantic scores. Bartlett Sher’s towering staging also features baritone Will Liverman and tenor Frederick Ballentine as the archrivals Mercutio and Tybalt, mezzo-soprano Samantha Hankey as the mischievous pageboy Stéphano, and bass-baritone Alfred Walker as Frère Laurent. This live cinema transmission is part of the Met’s award-winning <em>Live in HD</em> series, bringing opera to movie theaters across the globe.</p> <div class='AdditionalDetails_contentBox__pAxPZ'> <p><span class='cpx-body'><strong>Composer:</strong> Charles Gounod<br /> <strong>Conductor:</strong> Yannick Nézet-Séguin</span></p> </div> <div class='AdditionalDetails_contentBox__pAxPZ'> <div class='AdditionalDetails_movieInfoTitle__5O_Dw'><strong><span class='cpx-subtitle'>Cast: </span></strong><span class='cpx-body'>Nadine Sierra, Benjamin Bernheim</span></div> </div> </div> </div> <p>Estimated Run Time<strong> 3<span class='jss140 jss141 jss141'>h 30m</span></strong></p> <h6 style='text-align: center;'><a href='https://issuu.com/kingstheatreannapolisroyal/docs/rome_o_juliette_met_opera_program_-_09-21-25-2'><strong>CLICK FOR PROGRAM</strong></a></h6> <p><strong>TICKETS:  $16</strong><strong>.95<br /> </strong><em>HST additional</em></p> <p>Doors open 45 minutes before showtime. Please arrive early.<br /> Children under 12 must be accompanied by a guardian when attending a King&#8217;s Theatre event</p> <p><iframe title='Roméo et Juliette: Trailer' width='1080' height='608' src='https://www.youtube.com/embed/weGWrvF5KHI?feature=oembed'  allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share' referrerpolicy='strict-origin-when-cross-origin' allowfullscreen></iframe></p> <p>&nbsp;</p> "
      }
    ],
