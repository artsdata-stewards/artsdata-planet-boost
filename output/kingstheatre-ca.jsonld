    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "LES FURIES (THE FURIES) - King&#039;s Theatre"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Women in Montreal and Waterloo must fight for their ice time when a men's semi-pro hockey team claims their regular arena, threatening their established sports community."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "en",
        "@value": "en-US"
      }
