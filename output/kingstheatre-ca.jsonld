    "http://schema.org/image": [
      {
        "@id": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2025/02/qa-uk-sea-shanty-singer-chris-ricketts-talks-atlantic-canada_nuun5fg-e1752859289274.webp"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/chris-ricketts-sea-shanty-show/"
