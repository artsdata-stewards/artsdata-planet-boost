  {
    "@id": "https://www.kingstheatre.ca/new-events/the-best-of-boxwood/event_240960_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/the-best-of-boxwood/"
