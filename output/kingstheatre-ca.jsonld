    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "ART - King&#039;s Theatre"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "ART is a hot-headed, laugh out loud, hilarious play about how subjective art can be, and how differing of opinions can leave people struggling to understand the viewpoints of others. ART is a play that leaves audiences buzzing."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "en",
        "@value": "en-US"
      }
    ]
