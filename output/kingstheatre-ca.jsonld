    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "16th ANNUAL TOURNAMENT OF KING&#039;S"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<div class='style__notes___25v7J'> <div class='main-title'> <div class='TitleBlock__TitleMetaDataContainer-sc-1nlhx7j-2 hWHMKr'><strong><img class='wp-image-240510 aligncenter' src='https://www.kingstheatre.ca/kingweb/wp-content/uploads/2024/07/tok-2024-logo-300x75.jpg' alt='' width='448' height='112' /></strong></div> </div> </div> <div class='et_pb_text_inner'> <p class='tm5 Normal' style='text-align: center;'><span class='tm7'>The 16th Annual Tournament of King’s will take place on </span><strong><span class='tm6'>Saturday, September 14, 2024<br /> </span></strong></p> <p style='text-align: center;'><span class='tm6'>The tournament will once again take place at the beautiful Fort View Golf Course, where in addition to 18 holes of golf you will be provided with gourmet lunches prepared by Founders House, delivered right to you on the course for your enjoyment! We&#8217;ll also have a raffle prize basket filled by local businesses.<br /> </span></p> </div> <div class='et_pb_text_inner'> <div style='text-align: center;'><strong>Contact us for more information: 902-532-7704 or<a href='mailto:golf@kingstheatre.ca'> golf@kingstheatre.ca</a><br /> </strong></div> </div> <div></div> <h1 style='text-align: center;'><strong>THANK YOU TO OUR 2025 BUSINESS PARTNERS!</strong></h1> <div></div> <div><img class='aligncenter wp-image-240733 size-full' src='https://www.kingstheatre.ca/kingweb/wp-content/uploads/2024/07/TOK-Big-Sponsor-Board-2024.png' alt='' width='9000' height='18000' /></div> <div></div> <div></div> <div style='text-align: center;'><strong>TEE-UP CONCERT:</strong></div> <div style='text-align: center;'><strong>HELP! THE DEFINITIVE BEATLES TRIBUTE CONCERT<br /> </strong></div> <div style='text-align: center;'><strong>Friday September 13th at 7:30pm at King&#8217;s Theatre.</strong></div> <div style='text-align: center;'>Thank you to our official Tournament of King&#8217;s Concert Partner Hutchins Pharmacy!</div> <div style='text-align: center;'><img class='wp-image-240492 aligncenter' src='https://www.kingstheatre.ca/kingweb/wp-content/uploads/2024/04/Hutchins-Pharmacy-Logo-Final_Emblem-01-300x298.png' alt='' width='135' height='134' /></div> <div style='text-align: center;'><strong><a href='https://www.kingstheatre.ca/new-events/help-the-beatles-revisited-2/'>Click here for tickets and more info.</a></strong></div> <p>&nbsp;</p> <p>&nbsp;</p> <p>&nbsp;</p> <p>&nbsp;</p> <p>&nbsp;</p> <p>&nbsp;</p> <p>&nbsp;</p> <p>&nbsp;</p> <p>&nbsp;</p> <div class='et_pb_text_inner'></div> <p>&nbsp;</p> "
      }
    ],
