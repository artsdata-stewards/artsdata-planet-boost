    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2024/12/auditions.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2025-8-17T10:30-4:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "en",
        "@value": "2025-8-17T23:59-4:00"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "AUDITIONS FOR CHARLOTTE'S WEB"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n                \n\nAUDITIONS for Annapolis District Drama Group’s December production of ‘Charlotte’s Web’, directed by Shaeralee McCutcheon.\nJoin us in bringing to life one of the most heartwarming and timeless tales of friendship, bravery, and the magic of words! We’re looking for enthusiastic performers of all ages to help us tell the story of Wilbur the pig, Charlotte the spider, and the barnyard crew that touched generations.\nAudition Dates: \n\nTuesday August 12 from 6 – 8pm\nSunday August 17 from 10:30am – 12:30pm\n\nLocation: King’s Theatre\nPerformances at King’s Theatre December 5-7, 2025.\nAudition Requirements: ALL AGES and backgrounds are welcome! Be ready to perform a cold reading from the script. Scripts will be provided. We look forward to seeing you bring your imagination to life in this enchanting production!\nParts to be Cast:\n\nFern Arable – a young girl\nJohn Arable – Fern’s father\nMartha Arable – Fern’s mother\nAvery Arable – Fern’s younger brother\nHomer Zukerman – Fern’s Uncle\nEdith Zukerman – Fern’s Aunt\nLurvy – a hired hand\nWilbur – the pig\nTempleton – a rat\nCharlotte – the spider\nGoose, Gander, Sheep, Lamb – farm animals\nChorus – 3 narrators\n\n\n\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
  {
    "@id": "https://www.kingstheatre.ca/new-events/shiny-happy-people-a-tribute-to-rem/",
