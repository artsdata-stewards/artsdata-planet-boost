  {
    "@id": "https://www.kingstheatre.ca/new-events/the-bessie-carruthers-study-club/event_240218_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/the-bessie-carruthers-study-club/"
