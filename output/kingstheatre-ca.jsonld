  {
    "@id": "https://www.kingstheatre.ca/new-events/lennie-gallant/event_240226_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/lennie-gallant/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2024/04/Lennie-Gallanet-Xmas-Live-Poster-scaled-e1726762097982.jpg"
