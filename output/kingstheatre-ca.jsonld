    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Matthew Bourne's Sleeping Beauty - King's Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "With an unforgettable score, sumptuous sets and costumes, evocative lighting and masterly storytelling, the beloved fairy tale is brought to life by the uniquely talented New Adventures company. Get ready to be transported in time from the halcyon days of the late Edwardian era through to the modern day in this Gothic romance."
      }
    ],
    "http://ogp.me/ns#url": [
