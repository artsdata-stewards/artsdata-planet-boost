  {
    "@id": "https://www.kingstheatre.ca/temporary/445da94e-de50-45ad-b132-dc5ba32ca4e2",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/the-royal-ballet-romeo-juliet/"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "_:g7296680"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://kingstheatre.ca/events/"
      }
    ],
    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2026/01/Screenshot-2026-02-23-at-3.43.52-PM.png"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2026-5-3T15:00-3:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "en",
        "@value": "2026-5-3T23:59-3:00"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "THE ROYAL BALLET: ROMEO & JULIET (2026)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n                \n\n\nExperience the greatest love story ever told on the cinema screen, with The Royal Ballet’s brand new production of Romeo and Juliet.\n\nThe Capulets and Montagues are sworn enemies. Yet it is love at first sight for Romeo Montague and Juliet Capulet when they meet each other at the Capulet ball, into which Romeo has snuck. The two fall in love and they profess their devotion to each other at Juliet’s balcony. They secretly get married. The stakes are raised for the young couple when Romeo avenges the death of his friend Mercutio who has been killed by Tybalt, Juliet’s cousin. For this, Romeo is exiled from Verona. Meanwhile, Juliet’s parents are forcing her to marry another suitor. In order to be together, Romeo and Juliet must risk it all.\n\nCast: Fumi Kaneko, Vadim Muntagirov\n\nMusic: Sergey Prokofiev, Orchestra of the Royal Opera House\n\n\n\n\n\n\n\nEstimated Run Time: 2h 36min\nGENRE: Ballet, Dance\n\n\n\n\nTICKETS\n\nAdult: $16.95\nYouth: $7.95\nHST additional\n\n\n\n\nDoors open 45 minutes before showtime. Please arrive early.\nKing’s Theatre is committed to accessibility. If price is a barrier to attending, please request a ‘Bursary Ticket’ at the Box Office.\nTickets are not refundable for cash, but can be exchanged for credit with a minimum of 48 hours notice. Credits are valid for 12 months.\nAll persons require a ticket; we do not allow babes in arms. Children under 12 must be accompanied by a guardian.\nOutside food and beverages may not be brought into the theatre.\nFor more information about Theatre policies, click here.\n\n\n\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
