  {
    "@id": "https://www.kingstheatre.ca/new-events/17th-annual-tournament-of-kings/event_241359_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/17th-annual-tournament-of-kings/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2025/03/IMG_8803.jpg"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/17th-annual-tournament-of-kings/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "17th ANNUAL TOURNAMENT OF KING&#039;S"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<div class='style__notes___25v7J'> <div class='main-title'> <div class='TitleBlock__TitleMetaDataContainer-sc-1nlhx7j-2 hWHMKr'><img class=' wp-image-241583 aligncenter' src='https://www.kingstheatre.ca/kingweb/wp-content/uploads/2025/03/tok-2025-logo-no-partner-300x75.png' alt='' width='436' height='109' /></div> </div> </div> <div class='et_pb_text_inner'> <h4 class='tm5 Normal' style='text-align: center;'><span class='tm7'>Mark your calendars because the 17th Annual Tournament of King’s will take place on </span></h4> <h1 class='tm5 Normal' style='text-align: center;'><strong><span class='tm6'>Saturday, September 13, 2025!</span></strong></h1> <p style='text-align: center;'><span class='tm6'>The tournament will once again take place at the beautiful Fort View Golf Course, where in addition to 18 holes of golf you will be provided with gourmet lunches prepared by Founders House, delivered right to you on the course for your enjoyment! We&#8217;ll also have a raffle prize basket filled by local businesses.<br /> </span></p> </div> <div class='et_pb_text_inner'> <div style='text-align: center;'><strong>Contact us for more information: 902-532-7704 or <a href='mailto:ed@kingstheatre.ca'>ed@kingstheatre.ca</a></strong></div> </div> <div></div> <h1 style='text-align: center;'><strong>Thank you to our past Business Partners.</strong></h1> <h1 style='text-align: center;'><strong>Will your business be on board for 2025?</strong></h1> <div></div> <div style='text-align: center;'></div> <p>&nbsp;</p> <p>&nbsp;</p> <p>&nbsp;</p> <p>&nbsp;</p> <p>&nbsp;</p> <p>&nbsp;</p> <p>&nbsp;</p> <p>&nbsp;</p> <p>&nbsp;</p> <div class='et_pb_text_inner'></div> <p>&nbsp;</p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-9-13T09:00-3::00"
      }
    ],
