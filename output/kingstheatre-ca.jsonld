  {
    "@id": "https://www.kingstheatre.ca/new-events/tom-allen-friends/event_239771_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/tom-allen-friends/"
