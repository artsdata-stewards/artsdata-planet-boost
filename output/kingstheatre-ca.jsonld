  {
    "@id": "https://www.kingstheatre.ca/kings-theatre-welcome/event_242714_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/epic-elvis-presley-in-concert/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2026/02/EpiC-Banner.jpg"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.kingstheatre.ca/kings-theatre-welcome/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "EPiC: Elvis Presley in Concert"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<div id='movie-details-expander'> <div class='score-wrap'> <div class='description-wrap'> <div data-adsmediascorecardmanager='description'> <div class='drawer'> <div class='score-wrap'> <div class='description-wrap'> <div data-adsmediascorecardmanager='description'> <div class='drawer'> <div class='ipc-metadata-list-item__content-container'> <div class='ipc-html-content ipc-html-content--base sc-ac2b5e16-0 deDizX' role='presentation'> <div class='ipc-html-content-inner-div' role='presentation'> <div class='ipc-html-content ipc-html-content--base' role='presentation'> <div class='ipc-html-content-inner-div' role='presentation'> <div class='cpx-bottomMargin-lg'> <div class='MovieSelectedDetails_container__ftjgX'> <div class='MovieSelectedDetails_detailsContainer__2seki'> <div class='MovieSelectedDetails_ctaAndDetails__BpCFb'> <div class='MovieSelectedDetails_genreContainer__qEtwh MovieSelectedDetails_movieDetail__8XtgT'> <div class='score-wrap'> <div class='description-wrap'> <div data-adsmediascorecardmanager='description'> <div class='drawer'>Elvis sings and tells his story like never before in a new cinematic experience from visionary filmmaker Baz Luhrmann.</div> <div></div> <div><img class='alignnone wp-image-242716 size-medium' src='https://www.kingstheatre.ca/kingweb/wp-content/uploads/2026/02/EpiC-Ratings-e1771529801284-300x60.png' alt='' width='300' height='60' /></div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> <div class='description-wrap'> <div data-adsmediascorecardmanager='description'> <div data-adsmediascorecardmanager='description'> <div class='drawer'> <div class='score-wrap'> <div class='description-wrap'> <div data-adsmediascorecardmanager='description'> <ul> <li><strong>Stars: </strong>Elvis Presley</li> <li><strong><strong>Director: </strong></strong>Baz Luhrmann</li> </ul> <p><strong>Genre:</strong> Music, Documentary<br /> <strong>Duration:</strong> 1<span class='cpx-body' data-testid='movie-length'>h 36m</span><br /> <strong>Rating:</strong> PG</p> <p><strong>TICKETS:</strong><br /> <strong>$11.95 Adult</strong><br /> <strong>$7.95 Youth (under 18)</strong><br /> (HST additional)</p> <ul class='p-rich_text_list p-rich_text_list__ordered p-rich_text_list--nested' data-stringify-type='ordered-list' data-list-tree='true' data-indent='0' data-border='0'> <li data-stringify-indent='0' data-stringify-border='0'><em>Doors open 45 minutes before showtime.</em></li> <li data-stringify-indent='0' data-stringify-border='0'><em>King’s Theatre is committed to accessibility. If price is a barrier to attending, please request a ‘Bursary Ticket’ at the Box Office.</em></li> <li data-stringify-indent='0' data-stringify-border='0'><em>Tickets are not refundable for cash, but can be exchanged for credit with a minimum of 48 hours notice. Credits are valid for 12 months.</em></li> <li data-stringify-indent='0' data-stringify-border='0'><em>All persons require a ticket; we do not allow babes in arms. Children under 12 must be accompanied by a guardian.</em></li> <li data-stringify-indent='0' data-stringify-border='0'><em>Outside food and beverages may not be brought into the theatre.</em></li> <li data-stringify-indent='0' data-stringify-border='0'><em>For more information about Theatre policies, click <a href='https://www.kingstheatre.ca/about/ticket-info/'>here.</a></em></li> </ul> </div> <p><iframe title='EPiC: Elvis Presley in Concert | Official Main Trailer' width='1080' height='608' src='https://www.youtube.com/embed/NmqWusmzp0k?feature=oembed'  allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share' referrerpolicy='strict-origin-when-cross-origin' allowfullscreen></iframe></p> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
