  {
    "@id": "https://www.kingstheatre.ca/category/uncategorized/event_242710_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/nirvanna-the-band-the-show-the-movie/"
