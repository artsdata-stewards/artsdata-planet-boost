  {
    "@id": "https://www.kingstheatre.ca/kings-theatre-welcome/event_242307_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/now-you-see-me-now-you-dont/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2025/11/23668.jpg"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.kingstheatre.ca/kings-theatre-welcome/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Now You See Me: Now You Don&#039;t"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<div id='movie-details-expander'> <div class='score-wrap'> <div class='description-wrap'> <div data-adsmediascorecardmanager='description'> <div class='drawer'> <div class='score-wrap'> <div class='description-wrap'> <div data-adsmediascorecardmanager='description'> <div class='drawer'> <div class='ipc-metadata-list-item__content-container'> <div class='ipc-html-content ipc-html-content--base sc-ac2b5e16-0 deDizX' role='presentation'> <div class='ipc-html-content-inner-div' role='presentation'> <div class='ipc-html-content ipc-html-content--base' role='presentation'> <div class='ipc-html-content-inner-div' role='presentation'> <div class='cpx-bottomMargin-lg'> <div class='MovieSelectedDetails_container__ftjgX'> <div class='MovieSelectedDetails_detailsContainer__2seki'> <div class='MovieSelectedDetails_ctaAndDetails__BpCFb'> <div class='MovieSelectedDetails_genreContainer__qEtwh MovieSelectedDetails_movieDetail__8XtgT'>The Four Horsemen return along with a new generation of illusionists performing mind-melding twists, turns, surprises, and magic unlike anything ever captured on film.</div> </div> </div> </div> </div> <div class='VideoBillboardContent_expanderWrap__Zcq_E cpx-bottomMargin-xxl'> <div id='movie-details-expander'> <div></div> <div class='AdditionalDetails_contentBox__pAxPZ'><img src='data:image/png;base64,' /></div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> <div class='description-wrap'> <div data-adsmediascorecardmanager='description'> <div data-adsmediascorecardmanager='description'> <div class='drawer'> <div class='score-wrap'> <div class='description-wrap'> <div data-adsmediascorecardmanager='description'> <ul> <li><strong>Stars: </strong>Jesse Eisenberg, Woody Harrelson, Dave Franco, Isla Fisher</li> <li><strong><strong>Director:</strong></strong> Ruben Fleischer</li> <li><strong><strong>Writers: </strong></strong>Michael Lesslie, Paul Wernick, Rhett Reese</li> </ul> <p><strong>Genre: </strong><span class='cpx-body' data-testid='genres'>Adventure/Comedy/Drama</span><br /> <strong>Duration:</strong> <span class='cpx-body' data-testid='movie-length'>1h 53min</span><br /> <strong>Rating:</strong> PG</p> <p><strong>TICKETS:</strong><br /> <strong>$11.95 Adult</strong><br /> <strong>$7.95 Youth (under 18)</strong><br /> (HST additional)</p> <ul> <li style='list-style-type: none;'> <ul> <li><em>Doors open 45 minutes before showtime. Please arrive early.</em></li> <li><em>King’s Theatre is committed to accessibility. If price is a barrier to attending, please request a ‘Bursary Ticket’ at the Box Office.</em></li> <li><em>Tickets are not refundable for cash, but can be exchanged for credit with a minimum of 48 hours notice. Credits are valid for 12 months.</em></li> <li><em>All persons require a ticket; we do not allow babes in arms. Children under 12 must be accompanied by a guardian.</em></li> <li><em>Outside food and beverages may not be brought into the theatre.</em></li> <li><em>For more information about Theatre policies, click <a href='https://www.kingstheatre.ca/about/ticket-info/'>here.</a></em></li> </ul> </li> </ul> <p>&nbsp;</p> </div> <p><iframe title='Now You See Me: Now You Don’t (2025) Official Trailer' width='1080' height='608' src='https://www.youtube.com/embed/-E3lMRx7HRQ?feature=oembed'  allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share' referrerpolicy='strict-origin-when-cross-origin' allowfullscreen></iframe></p> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> "
      }
    ],
