    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "RUM RAGGED - King's Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Catch a piece of Newfoundland with JUNO Award Nominees Rum Ragged, who take a bold approach to the distinct folk music of their home. With a reverence for their roots and a creative, contemporary edge, this young band has quickly become known as the finest performers of their great, living, musical tradition."
      }
    ],
