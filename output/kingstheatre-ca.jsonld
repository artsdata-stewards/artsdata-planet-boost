    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "OLD MAN LUEDECKE - King's Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "2 time JUNO and multi East Coast Music award-winner, and Polaris Music Prize nominee from Chester, Nova Scotia, delights his audiences with his heart-felt command of the stage, inspired banjo playing and wry storytelling."
      }
    ],
