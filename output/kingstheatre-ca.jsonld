    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<div id='movie-details-expander'> <div class='score-wrap'> <div class='description-wrap'> <div data-adsmediascorecardmanager='description'> <div class='drawer'> <div class='score-wrap'> <div class='description-wrap'> <div data-adsmediascorecardmanager='description'> <div class='drawer'> <div class='ipc-metadata-list-item__content-container'> <div class='ipc-html-content ipc-html-content--base sc-ac2b5e16-0 deDizX' role='presentation'> <div class='ipc-html-content-inner-div' role='presentation'> <div class='ipc-html-content ipc-html-content--base' role='presentation'> <div class='ipc-html-content-inner-div' role='presentation'> <div class='cpx-bottomMargin-lg'> <div class='MovieSelectedDetails_container__ftjgX'> <div class='MovieSelectedDetails_detailsContainer__2seki'> <div class='MovieSelectedDetails_ctaAndDetails__BpCFb'> <div class='MovieSelectedDetails_genreContainer__qEtwh MovieSelectedDetails_movieDetail__8XtgT'> <div class='score-wrap'> <div class='description-wrap'> <div data-adsmediascorecardmanager='description'> <div class='drawer'>Marty Mauser, a young man with a dream no one respects, goes to hell and back in pursuit of greatness.</div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> <div class='description-wrap'> <div data-adsmediascorecardmanager='description'> <div data-adsmediascorecardmanager='description'> <div class='drawer'> <div class='score-wrap'> <div class='description-wrap'> <div data-adsmediascorecardmanager='description'> <ul> <li><strong>Stars: </strong>Timothée Chalamet, Gwyneth Paltrow, Odessa A&#8217;zion</li> <li><strong><strong>Director: </strong></strong>Josh Safdie</li> <li><strong><strong>Writers: </strong></strong>Josh Safdie, Ronald Bronstein</li> </ul> <p><img class='alignnone size-full wp-image-242501 aligncenter' src='https://www.kingstheatre.ca/kingweb/wp-content/uploads/2025/12/Marty-Supreme-rating.png' alt='' width='157' height='79' /></p> <p><strong>Genre:</strong> Comedy/<span class='cpx-body' data-testid='genres'>Drama</span><br /> <strong>Duration:</strong> 2<span class='cpx-body' data-testid='movie-length'>h 30min</span><br /> <strong>Rating:</strong> 14A</p> <p><strong>TICKETS:</strong><br /> <strong>$11.95 Adult</strong><br /> <strong>$7.95 Youth (under 18)</strong><br /> (HST additional)</p> <ul class='p-rich_text_list p-rich_text_list__ordered p-rich_text_list--nested' data-stringify-type='ordered-list' data-list-tree='true' data-indent='0' data-border='0'> <li data-stringify-indent='0' data-stringify-border='0'><em>Doors open 45 minutes before showtime.</em></li> <li data-stringify-indent='0' data-stringify-border='0'><em>King’s Theatre is committed to accessibility. If price is a barrier to attending, please request a ‘Bursary Ticket’ at the Box Office.</em></li> <li data-stringify-indent='0' data-stringify-border='0'><em>Tickets are not refundable for cash, but can be exchanged for credit with a minimum of 48 hours notice. Credits are valid for 12 months.</em></li> <li data-stringify-indent='0' data-stringify-border='0'><em>All persons require a ticket; we do not allow babes in arms. Children under 12 must be accompanied by a guardian.</em></li> <li data-stringify-indent='0' data-stringify-border='0'><em>Outside food and beverages may not be brought into the theatre.</em></li> <li data-stringify-indent='0' data-stringify-border='0'><em>For more information about Theatre policies, click <a href='https://www.kingstheatre.ca/about/ticket-info/'>here.</a></em></li> </ul> </div> <p><iframe title='Marty Supreme | Official Trailer HD | A24' width='1080' height='608' src='https://www.youtube.com/embed/s9gSuKaKcqM?feature=oembed'  allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share' referrerpolicy='strict-origin-when-cross-origin' allowfullscreen></iframe></p> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> "
