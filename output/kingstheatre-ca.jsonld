    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2024/04/Lennie-Gallanet-Xmas-Live-Poster-scaled-e1726762097982.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2024-11-23T19:30-4:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "en",
