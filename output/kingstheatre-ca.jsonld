    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "FODAR: Program Two"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<ul> <li class='tm6'><span class='tm7'>Festival of Dance Annapolis Royal leaps into its second decade with the 12th edition of the Festival. Check back later for program details!</span></li> <li>Program One: July 16 at 7:30pm</li> <li>Program Two: July 17 at 7:30pm</li> <li>Program One: July 18 at 2pm</li> <li>Program Two: July 18 at 7:30pm</li> </ul> <p>&nbsp;</p> <ul> <li style='list-style-type: none;'> <ul> <li><em>Doors open 45 minutes before showtime. Please arrive early.</em></li> <li><em>All persons require a ticket; we do not allow babes in arms. Children under 12 must be accompanied by a guardian.</em></li> <li><em>Outside food and beverages may not be brought into the theatre.</em></li> <li><em>For more information about Theatre policies, click <a href='https://www.kingstheatre.ca/about/ticket-info/'>here.</a></em></li> </ul> </li> </ul> <p>&nbsp;</p> <p>&nbsp;</p> <p>&nbsp;</p> <p>&nbsp;</p> <p>&nbsp;</p> "
      }
    ],
