    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Join Andrew Morrisey and the Youth from the Musical Theatre Camp for a FREE performance on Friday August 30 at 3:30pm.Come see for yourself what these talented youth from our community have put together!!!"
      }
    ],
