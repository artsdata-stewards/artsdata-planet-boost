    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2025/02/472759896_10171318484130019_3831469410896878712_n.jpg"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/speech-for-the-stage-workshop/"
