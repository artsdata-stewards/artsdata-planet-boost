        "@id": "_:g7829500"
      }
    ],
    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2026/01/OthelloBanner.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2026-4-12T14:00-3:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "en",
        "@value": "2026-4-12T23:59-3:00"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "OTHELLO"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n                \n\n\nShakespeare’s OTHELLO rages to life like never before in a ‘compelling’ (★★★★ Telegraph) new production starring David Harewood OBE (Homeland, Best of Enemies), Toby Jones OBE (Mr Bates vs the Post Office, Detectorists), Caitlin FitzGerald (Succession, Masters of Sex), Vinette Robinson (Boiling Point) and Luke Treadaway (A Street Cat Named Bob).\nDirected by Tony Award-winner Tom Morris OBE (War Horse, Dr Semmelweis, The Grinning Man) with music by PJ Harvey with Jon Nicholls, this epic story of manipulation, jealousy and toxic masculinity explores the darker side of power, rage and desire. Filmed live at the Theatre Royal Haymarket in London especially for the big screen, this is ‘an electrifying star-studded Othello.’ (★★★★ Mail on Sunday)\n\n\n\nEstimated Run Time 2 hours 45 minutes including interval\nTICKETS\n\nAdult: $16.95\nYouth: $7.95\nHST additional\n\n\n\n\nDoors open 45 minutes before showtime. Please arrive early.\nKing’s Theatre is committed to accessibility. If price is a barrier to attending, please request a ‘Bursary Ticket’ at the Box Office.\nTickets are not refundable for cash, but can be exchanged for credit with a minimum of 48 hours notice. Credits are valid for 12 months.\nAll persons require a ticket; we do not allow babes in arms. Children under 12 must be accompanied by a guardian.\nOutside food and beverages may not be brought into the theatre.\nFor more information about Theatre policies, click here.\n\n\n\n\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
