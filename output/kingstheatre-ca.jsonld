    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "EPIDERMIS CIRCUS: THE WEIRDEST PUPPET SHOW YOU'VE EVER SEEN - King's Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Calling it a puppet show doesn’t quite capture the magic of The Baby Tyler Show. What we can call it is – surprising, hilarious, and unlike anything you’ve seen before. Join us for this uniquely joyful performance, where laughter and high stakes drama are conjured from the smallest of objects, live on stage!"
      }
    ],
    "http://ogp.me/ns#url": [
