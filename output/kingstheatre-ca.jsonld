    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Annapolis Royal's own AARON HALLIDAY returns to King's Theatre with a very special ALAN JACKSON & FRIENDS Kitchen Party in support of Shelburne County, to help that community get back on its feet after the terrible wildfires."
      }
    ],
