    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Annual General Meeting"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n                The King’s Theatre Society hosts its Annual General Meeting at 7pm on Monday March 31, 2025 at King’s Theatre.\nThe agenda will include reports on the 2024 year, the audited financial statements, and the election of the Board of Directors.\nDonor-Members in good standing are welcome to vote, as well as to put their name forward to serve on the Board of Directors. A Donation of $25 or more constitute Membership, and is eligible for a tax receipt. Click here to donate.\nPlease see the attached document for proposed changes to the by-laws:\nProposed By Law Changes March 2025\n            "
      }
    ],
