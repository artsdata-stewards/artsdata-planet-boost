    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The costumes, the music, the moves... Creating a dance show is powerful!    Participants will spend an exciting week pushing their dancing to the limit, to learn and co-create their own original dance show. 5 days of fun lead to the creation of a whole new dance theatre performance at the end of the week."
      }
