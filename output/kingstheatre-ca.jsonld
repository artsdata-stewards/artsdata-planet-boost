    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><strong><span style='font-weight: 400;' data-sanitized-data-mce-style='font-weight: 400;' data-sanitized-data-mce-fragment='1'>For over three decades, Joel Plaskett has proven himself a spinning wheel of reinvention. The Nova Scotia songwriter&#8217;s eclectic body of work reveals a restless and playful spirit, always transforming and expanding.</span> Don&#8217;t miss his incredible solo show!<br /> </strong></p> <p><strong>Tickets: $50 + hst</strong></p> <p>Contact: boxoffice@kingstheatre.ca or 902-532-7704.</p> <div class='style__notes___25v7J'> <div class='main-title'> <div class='TitleBlock__TitleMetaDataContainer-sc-1nlhx7j-2 hWHMKr'> <p><small><a href='https://www.kingstheatre.ca/about/ticket-info/'><b>Click here for King&#8217;s Ticket policies</b></a></small></p> </div> </div> </div> <p>&nbsp;</p> <p>&nbsp;</p> "
      }
