  {
    "@id": "https://www.kingstheatre.ca/new-events/aysanabee/event_240661_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/aysanabee/"
