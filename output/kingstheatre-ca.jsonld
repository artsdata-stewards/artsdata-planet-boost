    ]
  },
  {
    "@id": "_:g4213040",
    "@type": [
      "https://schema.org/OfflineEventAttendanceMode"
    ]
  },
  {
    "@id": "https://www.kingstheatre.ca/temporary/303ed9e0-0ffc-47a5-aefb-4ba5c868df52",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/robin-the-ultimate-robin-williams-tribute-experience/"
      }
    ],
