        "@id": "_:g8251480"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/auditions-for-grease-singalong-sockhop/"
      }
    ],
    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2024/12/auditions.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2025-1-13T18:00-4:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "en",
        "@value": "2025-1-13T23:59-4:00"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "AUDITIONS FOR GREASE SINGALONG SOCKHOP"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n                \n\nCome be a part of a Film+Live Experience, Directed and Choreographed by Dany Rousseau, happening on stage at King’s Theatre on March 29.\n\n\nIt’s an all-new, immersive sing-along experience with the classic, feature-length film. Sing, dance & joke along with this smash-hit musical rom-com.\n\n\nAnyone interested in being part of this show can come out to auditions on January 13th at 6pm at King’s Theatre.\n\n\n\nA secondary audition will be held on January 15th at 6pm for those who cannot make the Monday evening audition. \n\n\nWe’re seeking singers & dancers of ALL GENDERS to bring this interactive movie feature to life (14+, all folks welcome).\n\nCome prepared to sing your favourite song from the movie & to learn a short dance combination. Wear/bring comfortable attire!\nA Pianist will be available at the January 13th audition for anyone who brings their own sheet music, however, everyone will be asked to sing along with the movie, so please come prepared to sing/with a song in mind. For this show, the audience will be singing and dancing along with the cast & movie, so a short, choreographed dance combination will also be taught to attendees as part of a dance audition. Please bring/wear comfortable shoes and clothing you can move comfortably in. All skill levels welcome.\n\n\nThose who wish to participate, but are unable to make auditions, should reach out to the director, Dany Rousseau, at rousseaucomadany@gmail.com\n\nRehearsals will take place predominantly at Upper Clements Hall & Kings Theatre.\n\n\n\n\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
