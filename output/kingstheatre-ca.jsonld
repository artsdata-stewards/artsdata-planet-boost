    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2023/06/m_dufflebag-theatre-snow-white-2022-close-up-doc-mirror-snow-apple-.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2023-12-30T14:00-4:00"
      }
