        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "AUDITIONS FOR YCP's ALICE THROUGH THE LOOKING GLASS - King's Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "'Alice Through the Looking Glass' is a whimsical sequel to Lewis Carroll's beloved tale! It will take the audience on a fantastical journey through a mirror world filled with quirky characters and delightful adventures. Join Alice as she encounters the Red Queen, the White Knight, and the Jabberwocky in a story that explores themes of identity, imagination, and the passage of time."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://www.kingstheatre.ca/new-events/auditions-for-ycps-alice-through-the-looking-glass/"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en-us",
        "@value": "King's Theatre"
      }
    ],
    "article:modified_time": [
      {
        "@language": "en-us",
        "@value": "2025-03-19T13:30:40+00:00"
      }
    ],
    "http://ogp.me/ns#image": [
      {
