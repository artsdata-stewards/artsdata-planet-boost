    "http://schema.org/image": [
      {
        "@id": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2025/12/d995b493-cfde-46a0-8697-a2d6508c584a_The-Choral_Web-Materials_3840x2160-Final.jpg"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
