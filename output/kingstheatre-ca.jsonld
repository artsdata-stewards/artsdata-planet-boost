    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<div dir='ltr'> <div dir='ltr'> <div dir='ltr'> <div dir='ltr'> <p>Join <strong>GEORGE CLAIRMONT</strong> &#8212; actor, writer, director, and improviser &#8212; for a fun series of after school workshops to learn how to improvise and have fun!</p> <ul> <li><strong>Workshops on Tuesdays from 4-6pm, March 19-April 9<br /> </strong></li> <li><strong>Performance TBA (Show title: &#8220;The Instant Soup Opera&#8221;)</strong></li> <li><strong>Participants cost for 4 workshops plus a show: $80+hst<br /> </strong></li> <li><strong>Ages: 10-15</strong></li> </ul> <div dir='auto'></div> <div dir='auto'><span data-ogsc='rgb(0, 0, 0)' data-ogsb='rgb(255, 255, 255)'>No script? No problem! Improv is a form of theatre that relies on the actor&#8217;s imagination to play along with scenarios made up on the spot! Through a series of fun games and thought exercises, George Clairmont will lead participants to create their own characters and then improvise dialogue and play through a whole universe of situations that revolve around one theme: &#8220;soap opera&#8221;. </span><br data-ogsc='rgb(0, 0, 0)' data-ogsb='rgb(255, 255, 255)' /><br data-ogsc='rgb(0, 0, 0)' data-ogsb='rgb(255, 255, 255)' /><span data-ogsc='rgb(0, 0, 0)' data-ogsb='rgb(255, 255, 255)'>We will explore drama, silliness, deep emotions, wacky decisions and questionable choices! Good and evil, cats and dogs, ladies and gentlemen, thieves and robber barons&#8230; you can play all of these, just for a start! </span></div> <div dir='auto'></div> <div dir='auto'><span data-ogsc='rgb(0, 0, 0)' data-ogsb='rgb(255, 255, 255)'>Four sessions of 2 hours each, Tuesdays at 4pm at King&#8217;s Theatre, registration required.</span></div> </div> </div> </div> </div> <div class='style__notes___25v7J'> <div class='main-title'> <div dir='ltr'></div> <div class='TitleBlock__TitleMetaDataContainer-sc-1nlhx7j-2 hWHMKr'> <p>&nbsp;</p> <p>King’s Theatre is committed to making live performances accessible to all audiences. If cost is a barrier please contact our Box Office for Bursary Tickets: boxoffice@kingstheatre.ca or 902-532-7704.</p> <p><small><a href='https://www.kingstheatre.ca/about/ticket-info/'><b>Click here for King&#8217;s Ticket Exchange policies</b></a></small></p> </div> </div> </div> "
      }
    ],
