  {
    "@id": "https://www.kingstheatre.ca/temporary/d963402c-e76c-4d18-919d-cba49d4432d7",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/a-very-sparkly-christmas/"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
