  {
    "@id": "https://www.kingstheatre.ca/new-events/michael-kaeshammer/event_240981_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/michael-kaeshammer/"
