  {
    "@id": "https://www.kingstheatre.ca/new-events/thalea-string-quartet/event_242205_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/thalea-string-quartet/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2025/10/Screenshot-2025-10-17-at-11.55.30-AM.png"
