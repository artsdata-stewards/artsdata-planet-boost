  {
    "@id": "https://www.kingstheatre.ca/new-events/therrien-go-duo/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "THERRIEN-GO DUO - King's Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Created by cellist Daniel Hamin Go and pianist Jean-Luc Therrien, the Therrien-Go Duo offers an innate connection that electrifies the stage. Their music is a mesmerizing fusion of thought-provoking interpretation, innovative collaboration, and a sincere dedication to community engagement, both near and far."
      }
    ],
