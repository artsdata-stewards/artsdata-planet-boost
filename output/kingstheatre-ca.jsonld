      }
    ]
  },
  {
    "@id": "https://www.kingstheatre.ca/new-events/auditions-for-ycps-alice-through-the-looking-glass/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
