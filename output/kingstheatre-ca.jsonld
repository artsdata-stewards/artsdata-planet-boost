    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2025/02/IMG_6539-scaled.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2025-5-25T10:30-4:00"
      }
    ],
    "http://schema.org/endDate": [
