    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "THE ALAN JACKSON EXPERIENCE"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>The Alan Jackson Experience is an internationally recognized tribute performed by ISSA Entertainer of the Year award winner Aaron Halliday. The look, stage presence, and sound will have you believing you are at an actual Alan Jackson concert. The show prides itself on having the best musicians in the country perform along side Aaron which has led to a world class act. This years tour, aptly named the &#8220;Margaritaville&#8221; tour, will bring you all of the AJ classics along with his Jimmy Buffet inspired songs to give the performance a tropical beachy overtone. This is an upbeat, feel good performance that truly will be a &#8220;Good Time&#8221; and have you saying &#8220;Remember When&#8221;! All ticket holders are invited to the meet and greet on the intermission in the lobby.</p> <p class='tm7'><strong><span class='tm9'>TICKETS: </span></strong><strong><span class='tm9'>$47.25</span></strong></p> <p class='tm7'><span class='tm9'>Doors open 45 minutes before showtime.</span></p> <p class='tm7'><strong><span class='tm9'>*Please note that this is a Rental event, and show credits outlined in our Ticketing Policy do not apply. Tickets are final sale.*</span></strong></p> <p>&nbsp;</p> <p><iframe title='THE ALAN JACKSON EXPERIENCE' width='1080' height='608' src='https://www.youtube.com/embed/y-2V_i7G54Q?feature=oembed'  allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share' referrerpolicy='strict-origin-when-cross-origin' allowfullscreen></iframe></p> "
      }
    ],
