      }
    ]
  },
  {
    "@id": "https://kingstheatre.ca/events/event_242195_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.kingstheatre.ca/new-events/the-heterosexuals/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2025/10/Heterosexuals-web-banner.png"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://kingstheatre.ca/events/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "THE HETEROSEXUALS"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<div><span style='color: #000000;'>★★★★★ “Comic genius!” The Irish Times<br /> ★★★★★ “Priceless, playful perfection!” The Reviews Hub</span></div> <div><span style='color: #000000;'> </span></div> <div><span style='color: #000000;'>A deep-dive into the shocking world of Heterosexuality! THEY WALK AMONG US! But where did they come from? And what do they think they’re wearing?! Find out in this explosive solo show based on undercover research gathered while posing as one of their own! Combining elements of storytelling, satire, comedy, and deep personal humiliation, The Heterosexuals is here to spill the T on what The Queers really think about The Straights.</span></div> <div></div> <div><span style='color: #000000;'>The latest solo show from tour-de-force writer/performer Johnnie McNamara Walker has wowed audiences and sold out houses across Canada as well as touring internationally to Ireland and the US, including an Off-Broadway run at The SoHo Playhouse in NYC.</span></div> <div><span style='color: #000000;'> </span></div> <div><strong><span style='color: #000000;'>Johnnie McNamara Walker</span></strong> is a writer and performer from Toronto who has been producing work for the stage for twenty years. He continues to tour his solo shows The Heterosexuals and Iggy Beamish Destroys Traditional Marriage both across Canada and internationally, including a recent Off-Broadway debut at The SoHo Playhouse in New York City. His first solo show, Redheaded Stepchild, toured Canada coast-to-coast and was published by Playwrights Canada Press. His play Shove It Down My Throatpremiered at Buddies in Bad Times Theatre in Toronto as part of their 40th Anniversary Season in 2019. Johnnie is also a founding member of BoylesqueTO and has written and hosted dozens of shows for the troupe, which have been performed across North America and been honoured at the Burlesque Hall of Fame in Las Vegas.</div> <p><em><strong>Recommended for audiences 13+. Light cursing and sexual content.</strong></em></p> <div id='i8e4vmc5' class='BaOVQ8 tz5f0K i8e4vmc5 wixui-rich-text' data-testid='richTextElement'> <p><strong>ALL TICKETS:</strong><strong>  </strong></p> <ul> <li><strong>$45 + HST</strong></li> </ul> </div> <div class='style__notes___25v7J'> <div class='main-title'> <div class='TitleBlock__TitleMetaDataContainer-sc-1nlhx7j-2 hWHMKr'> <p><em>* Intended for mature audiences.</em></p> <ul> <li style='list-style-type: none;'> <ul> <li><em>Doors open 45 minutes before showtime. Please arrive early.</em></li> <li><em>King’s Theatre is committed to accessibility. If price is a barrier to attending, please request a ‘Bursary Ticket’ at the Box Office.</em></li> <li><em>Tickets are not refundable for cash, but can be exchanged for credit with a minimum of 48 hours notice. Credits are valid for 12 months.</em></li> <li><em>All persons require a ticket; we do not allow babes in arms. Children under 12 must be accompanied by a guardian.</em></li> <li><em>Outside food and beverages may not be brought into the theatre.</em></li> <li><em>For more information about Theatre policies, click <a href='https://www.kingstheatre.ca/about/ticket-info/'>here.</a></em></li> </ul> </li> </ul> </div> </div> </div> <p>&nbsp;</p> <p><iframe title='The Heterosexuals by Johnnie McNamara Walker - trailer' width='1080' height='608' src='https://www.youtube.com/embed/doQmVCJCiAk?feature=oembed'  allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share' referrerpolicy='strict-origin-when-cross-origin' allowfullscreen></iframe></p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-2-6T19:30-4::00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-2-6T23:59-4::00"
      }
    ],
