    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2023/12/IMG_4552.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2024-11-3T15:00-4:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "en",
