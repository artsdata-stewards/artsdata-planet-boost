    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2025/02/Beethovens-Fidelio-Stage-to-Screen.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2025-4-13T15:00-4:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "en",
