      }
    ],
    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://www.kingstheatre.ca/kingweb/wp-content/uploads/2025/05/ART-Banner.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2025-8-10T15:00-4:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "en",
        "@value": "2025-8-10T23:59-4:00"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "ART"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n                \nWritten by Yasmina Reza\nDirected by AC Silver\nStarring Ryan Hebert, William McCormick & Jamie Keithline\nProduced by Scott Campbell & Scrappy Lady Productions\nStage Managed by Tracy Summerville\nSet by Rick & Dawn Vroom\n\n On stage at King’s Theatre August 8 & 9 at 7:30pm and August 10 at 3:00pm\nART is set in Paris, the play follows three friends, Serge, Marc, and Yvan. One day their 15 year friendship is shaken when Serge shows his friends a new, staggeringly expensive piece of art he has purchased. A white canvas with white lines on it. Upon hearing the price of the painting, Marc calls it a “piece of white shit” and can’t believe that one of his oldest friends spent a large sum on it. Yvan tries to balance out the argument by being slightly more positive about it, however this also infuriates Marc as he struggles to see how others can’t see his point of view. This argument is a catalyst to a night where tempers fly and opinions are thrown at each other, seemingly attempting to destroy their friendship as quickly as they can.\nTICKETS: Adults $25/ Youth $20\n \n \n \n \n \n \n \n \n \n \n            "
      }
    ],
