    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.aramusique.org/apero-jazz-saison-2023-2024/romance-saveur-jazz/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Romance saveur jazz"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "[EN FORMULE CABARET]\nLe trompettiste Paul Merkelo s’entoure de musiciens chevronnés pour vous chanter la pomme avec des romances saveur jazz. Ce sont les sonorités de la clarinette d’André Moisan, du piano de Matt Herskowitz, de la contrebasse d’Éric Lagacé et des percussions de Wali Muhammad qui accompagneront ce fabuleux trompettiste acclamé lors de son passage à Repentigny en 2019.\nVous serez séduits par des standards tels que My funny Valentine et The very thought of you sans oublier l’incomparable Summertime. Un rendez-vous pour les amoureux du jazz.\nArtistes :\nPaul Merkelo, trompette\nMatt Herskowitz, piano\nÉric Lagacé, contrebasse\nAndré Moisan, clarinette\nWali Muhammad, percussions\nRÉGULIER | 30 $"
      }
    ],
