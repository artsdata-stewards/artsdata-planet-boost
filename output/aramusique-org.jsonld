  {
    "@id": "https://www.aramusique.org/evenement/danses/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-fr",
        "@value": "fr_FR"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-fr",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-fr",
        "@value": "DANSES | PIANO À QUATRE MAINS | MIDIS ARAMUSIQUE"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "Le Duo Fortin-Poirier fait briller la musique pour piano à quatre mains partout où il passe. Mais c’est avant tout l’union de deux grandes amies, complices autant dans leur quotidien que sur scène qui vous en mettront plein la vue! Dans ce concert haut en couleurs sur le thème de la danse, les pianistes Amélie Fortin et Marie-Christine Poirier vous invitent à découvrir une sélection d’œuvres de grands compositeurs classiques et modernes, souvent rythmées, parfois langoureuses, mais suscitant toujours l’émerveillement. Une excellente façon de célébrer la fin de l’été! Amélie Fortin et Marie-Christine Poirier, piano. Préau du Centre d'art Diane-Dufresne, gratuit."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-fr",
        "@value": "https://www.aramusique.org/evenement/danses/"
      }
