  {
    "@id": "https://www.aramusique.org/evenement/du-romantisme/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-fr",
        "@value": "fr_FR"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-fr",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-fr",
        "@value": "DU ROMANTISME À L’IMPRESSIONNISME | MUSIQUE INTIMISTE | REPENTIGNY"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "MUSIQUE INTIMISTE Le pianiste Stéphan Sylvestre nous présente le piano dans toute sa gamme de couleur musicale. Partant du 19e siècle et l’époque de Johannes Brahms, il nous mènera jusqu’à Claude Debussy et le début du 20e siècle dans une exploration de chef-d’œuvres pour le piano qui ont marqué ce parcours du romantisme à l’impressionnisme. Un voyage inoubliable à travers deux merveilleuses époques de l’histoire de la musique, autour du piano.Artiste : Stéphan Sylvestre, piano. RÉGULIER | 35 $. Mardi 25 mars 2025, 20 h au Théâtre Alphonse-Desjardins, Repentigny."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-fr",
        "@value": "https://www.aramusique.org/evenement/du-romantisme/"
      }
