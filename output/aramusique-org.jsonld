  {
    "@id": "https://www.aramusique.org/evenement/les-arrivants/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-fr",
        "@value": "fr_FR"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-fr",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-fr",
        "@value": "LES ARRIVANTS | MUSIQUE DU MONDE | REPENTIGNY"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "Le compositeur et bandonéoniste, Amichai Ben Salev s’entoure des musiciens Abdul-Wahab Kayyali au oud et Hamin Honari à la percussion pour nous emmener à la découverte de musique arabique et persane en passant par les tangos de l’Argentine. Muni d’une maîtrise de l’Université de Montréal, Amichai nous guide à travers ce voyage quasi initiatique de sons et de sensualité musicale insoupçonnés par nous qui ne manquerons pas d’être séduits par tant de virtuosité musicale et de beauté. Artistes : Amichai Ben Salev, bandonéon Abdul Wahab Kayyali, oud Hamin Honari, percussions. Samedi 15 novembre 2025, 20 h au Théâtre Alphonse-Desjardins, Repentigny. 35 $."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-fr",
