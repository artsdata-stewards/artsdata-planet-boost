  },
  {
    "@id": "https://aramusique.org/temporary/a999eb26-a0cd-4c3a-9782-8a243c827d04",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.aramusique.org/wp-content/uploads/2023/07/Autour-dHenri-Salvador_2024-02-15_rose-soleil.jpg"
      }
    ],
