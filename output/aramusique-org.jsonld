    "http://ogp.me/ns#title": [
      {
        "@language": "fr-fr",
        "@value": "CHOPIN EN TOUTE INTIMITÉ | MUSIQUE INTIMISTE | REPENTIGNY"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "MUSIQUE INTIMISTE Gagnant de la médaille d’argent au Concours international Frédéric Chopin en 2015, le pianiste Charles Richard-Hamelin nous raconte son lien privilégié avec la musique et de l’un de ses compositeurs préférés. Au programme : Debussy, Poulenc et bien entendu, Chopin !Artiste :Charles Richard-Hamelin, piano. RÉGULIER | 35 $. Théâtre Alphonse-Desjardins, Repentigny."
      }
    ],
