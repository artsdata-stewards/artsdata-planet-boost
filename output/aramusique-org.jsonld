    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "Découvrez l'hommage de Roman Zavada aux grands génies du cinéma muet tels que Méliès, Chaplin, Keaton et Laurel & Hardy. Un ciné-concert inoubliable alliant une touche musicale actuelle et une ambiance magique à la belle étoile."
      }
