    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.aramusique.org/grands-concerts-saison-2023-2024/couronnement/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Couronnement"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Pour célébrer ses vingt ans, l’Ensemble vocal Vox Luminosa vous offre la Messe du couronnement de Wolfgang Amadeus Mozart, œuvre tout indiquée pour souligner cet événement ainsi que le 40e anniversaire de l’Aramusique. Cette double célébration marque l’importance de la musique classique dans toute sa grandeur, ici, chez nous, à Repentigny.\nNe manquez pas ce rendez-vous vocal incontournable du printemps où vous pourrez entendre l’immortel Gloria de Vivaldi en complément de programme.\nArtistes :\nEnsemble vocal et instrumental Vox Luminosa\nDirection Claudel Callender\nRÉGULIER | 55 $\nABONNÉ ARAMUSIQUE | 44 $\nPRIVILÈGE | 50 $"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
  {
    "@id": "https://www.aramusique.org/grands-concerts-saison-2023-2024/ravel-inspirations/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-fr",
        "@value": "fr_FR"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-fr",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-fr",
        "@value": "Ravel inspirations | Aramusique"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "L'ensemble Cordâme interprète Maurice Ravel avec une nouvelle approche, incluant des compositions inspirées des œuvres les plus célèbres telles que \"Pavane pour une infante défunte\" et \"Boléro\". Un mélange de musique de chambre et de jazz créant des images sonores merveilleuses."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-fr",
        "@value": "https://www.aramusique.org/grands-concerts-saison-2023-2024/ravel-inspirations/"
      }
