    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.aramusique.org/grands-concerts-saison-2023-2024/le-messie-de-haendel/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Le Messie de Haendel"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Selon une tradition maintenant bien établie depuis 6 ans, c’est le retour du Messie de Haendel à Repentigny, présenté dans la région aux deux ans. Cette œuvre intemporelle, composée seulement en 24 jours par Georg Friedrich Haendel, a séduit le public et les mélomanes depuis sa toute première création en avril 1742 et continu d’être jouée annuellement partout dans le monde.\nCette œuvre phare du temps des fêtes sera jouée sur instruments d’époque par l’Harmonie des saisons. Vous vivrez donc une interprétation magnifique qui vous transportera au 18e siècle, le chef Eric Milnes dirigeant les musiciens et chanteurs directement du clavecin, comme le fit Haendel à son époque ! Ne manquez pas ce rendez-vous biannuel incontournable à Repentigny de la présentation du Messie, concert d’une tournée de six villes du Québec.\nL’Harmonie des saisons\nMélisande Corriveau, direction artistique\nEric Milnes, direction musicale\nSolistes :\nDenise Torre Ormeño, soprano\nDaniel Taylor, alto\nPhilippe Gagné, ténor\nSumner Thompson, basse\nRÉGULIER | 55 $\nABONNÉ ARAMUSIQUE | 44 $\nPRIVILÈGE | 50 $"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
