    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.aramusique.org/grands-concerts-saison-2023-2024/un-peu-plus-haut/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Un peu plus haut"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "La soprano Marie-Josée Lord vous amène Un peu plus haut, proche du cœur et des sourires à travers un répertoire lumineux qu’elle a choisi pour vous faire du bien. Du classique avec Youkali et O Sole Mio, jusqu’au répertoire de chansons avec La vie en rose et l’Hymne à l’amour, en passant par le jazz avec Besame Mucho, notre Diva nationale vous fera vivre toute une gamme d’émotions !\nArtistes :\nMarie-Josée Lord et ses musiciens\nRÉGULIER | 55 $\nABONNÉ ARAMUSIQUE | 44 $\nPRIVILÈGE | 50 $"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
