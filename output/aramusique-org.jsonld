    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.aramusique.org/apero-jazz-saison-2023-2024/la-magie-du-big-band/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "La magie du Big Band"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "[EN FORMULE CABARET]\nNe manquez pas l’occasion de voir et d’entendre un ensemble de 24 musiciens lorsque l’Aramusique accueillera l’Orchestre de jazz 1 de l’Université McGill. Sous la direction de l’attachante pianiste et compositrice Marianne Trudel, l’ensemble se dédie avec passion à l’interprétation des grands classiques de la tradition jazz ainsi qu’au répertoire moderne.\nCe big band des meilleurs étudiants du programme de jazz nous présentera un savoureux programme d’oeuvres qui survolent les différentes époques de la musique pour big band, incluant des grands classiques de Count Basie, Duke Ellington, Thad Jones ainsi que des perles du répertoire moderne.\nArtistes :\nMarianne Trudel, direction\nOrchestre de jazz 1 de l’École de musique Schulich de l’Université McGill\nRÉGULIER | 30 $"
      }
    ],
