  {
    "@id": "https://www.aramusique.org/evenement/cordame-en-duo/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-fr",
        "@value": "fr_FR"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-fr",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-fr",
        "@value": "CORDÂME EN DUO"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "Marie Neige Lavigne au violon et Jean Félix Mailloux à la contrebasse proposent une version délicate et caressante de son répertoire. Des mélodies de Mailloux, Satie, Debussy et Ravel viendront charmer le public présent. Un duo surprenant qui témoigne de 20 ans de complicité musicale.Artistes :Jean Félix Mailloux, contrebasseMarie Neige Lavigne, violon. Jeudi 31 juillet 2025 à 12 h au Préau du Centre d’art Diane-Dufresne, Repentigny. ÉVÉNEMENT EXTÉRIEUR ET GRATUIT. APPORTEZ VOTRE CHAISE ET PARASOL."
      }
    ],
