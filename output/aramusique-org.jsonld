  {
    "@id": "https://www.aramusique.org/evenement/de-vivaldi-a-barbara/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-fr",
        "@value": "fr_FR"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-fr",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-fr",
        "@value": "DE VIVALDI À BARBARA | MIDIS ARAMUSIQUE | REPENTIGNY"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "Le duo formé de Myriam Leblanc, soprano, et d’Ellen Torrie, soprano et guitariste, vous propose des mélodies de la période baroque à aujourd’hui. Nous vous ferons découvrir des compositrices, moins connues, telles que Strozzi et Francesca Caccini, tout en passant par les fameux Monteverdi et Vivaldi. Nous vous proposons également des mélodies qui ont bercé notre enfance et qui ont été les allumeuses de notre amour pour la musique. Une invitation irrésistible à un voyage musical à travers le temps. Artistes : Myriam Leblanc, soprano Ellen Torrie, soprano et guitare. Jeudi 3 juillet 2025 à 12 h au Préau du Centre d’art Diane-Dufresne, Repentigny. ÉVÉNEMENT EXTÉRIEUR ET GRATUIT. APPORTEZ VOTRE CHAISE ET PARASOL."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-fr",
