    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.aramusique.org/apero-jazz-saison-2023-2024/le-jazz-aux-couleurs-de-largentine/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Le jazz aux couleurs de l'Argentine"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "[EN FORMULE CABARET]\nLa saison Apéro-Jazz commence en grande avec un mélange de tango classique et des nouvelles compositions, créées par le joueur de bandonéon et compositeur Amichai Shalev. Inspiré par son pays d’origine l’Argentine et le charme captivant de Montréal, ce projet vise à faire du tango une expression universelle au-delà de ses racines traditionnelles\nAmichai sera accompagné par un quatuor de musiciens soit deux violonistes, un contrebassiste et un pianiste. La virtuosité de leur performance doublée d’une densité harmonique et d’improvisations musicales entre le jazz et la musique classique vous transporteront à un univers aux sonorités du tango et de la musique latine. Une invitation irrésistible à un voyage musical entre l’Argentine et le Canada.\nArtistes :\nAmichai Ben Shalev, bandonéon et direction musicale\nChantal Bergeron, violon\nMélanie Bélair, violon\nPierre-Alexandre Maranda, contrebasse\nSebastian Verdugo, piano\nRÉGULIER | 30 $"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
