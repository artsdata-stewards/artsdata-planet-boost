  {
    "@id": "https://www.aramusique.org/evenement/john-roney-joue-gershwin/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-fr",
        "@value": "fr_FR"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-fr",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-fr",
        "@value": "JOHN RONEY JOUE GERSHWIN | MIDIS ARAMUSIQUE"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "John Roney, pianiste chouchou de la communauté Aramusique, et reconnu pour sa polyvalence, sa créativité et sa générosité artistique, présente un tout nouveau programme de la musique de George Gershwin. Couvrant le spectre des sons allant de la musique de chambre classique aux concertos orchestraux et aux chansons du Great American Songbook, John Roney présentera la musique de George Gershwin comme vous ne l’avez jamais entendue auparavant. Venez écouter vos coups de cœur préférés parmi Rhapsody in Blue, Someone to watch over me et an American in Paris pour un Midi qui vous fera voyager au New York des années 20.John Roney, piano. Préau du Centre d'art Diane-Dufresne, gratuit."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-fr",
        "@value": "https://www.aramusique.org/evenement/john-roney-joue-gershwin/"
