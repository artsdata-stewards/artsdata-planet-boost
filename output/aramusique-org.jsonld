  {
    "@id": "https://www.aramusique.org/evenement/bach-aznavour/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-fr",
        "@value": "fr_FR"
      }
    ],
    "http://ogp.me/ns#type": [
