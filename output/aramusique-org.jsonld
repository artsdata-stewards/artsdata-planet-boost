  },
  {
    "@id": "https://aramusique.org/temporary/d688d7f9-b88a-4f4d-a43c-9f19dc8a0ea1",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.aramusique.org/wp-content/uploads/2023/04/Le-voyage-en-chanson-2024-03-10.jpg"
      }
    ],
    "http://schema.org/startDate": [
