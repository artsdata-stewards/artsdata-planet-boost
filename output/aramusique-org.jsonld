  {
    "@id": "https://www.aramusique.org/evenement/note-bleue/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-fr",
        "@value": "fr_FR"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-fr",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-fr",
        "@value": "NOTE BLEUE | APÉRO-JAZZ | REPENTIGNY"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "FORMULE CABARET Le pianiste et compositeur Andrés Vial propose un concert de jazz sur le thème de la Note Bleue. Le concert comprendra des compositions classiques de John Coltrane, Miles Davis, Thelonious Monk, Horace Silver et Wayne Shorter associées au légendaire label Blue Note Records.Vial est le premier compositeur et pianiste québécois à avoir enregistré pour le label, sur l’album «Dance Kobina» de Joe Chambers, paru en 2023. Le concert présentera également plusieurs compositions de Vial enregistrées pour cet album. Artistes : Quartet Andrés Vial. RÉGULIER 30 $. Jeudi 6 mars 2025, 17 h 30 au Théâtre Alphonse-Desjardins, Repentigny."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-fr",
        "@value": "https://www.aramusique.org/evenement/note-bleue/"
      }
