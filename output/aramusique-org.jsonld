  {
    "@id": "https://www.aramusique.org/evenement/voyage-a-travers-les-ameriques/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-fr",
        "@value": "fr_FR"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-fr",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-fr",
        "@value": "VOYAGE À TRAVERS LES AMÉRIQUES | MUSIQUE INTIMISTE | REPENTIGNY"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "Chambriste et récitaliste passionné, le guitariste Daniel Bolshoy a foulé les scènes de concerts à travers l’Europe, l’Asie, le Moyen-Orient et les Amériques. Il nous propose une escapade musicale pour nous présenter les œuvres des compositeurs sud-américains Agustín Barrios Mangoré, Manuel Ponce et Sergio Assad. Entre commentaires et histoires de ces voyages terrestres et musicaux, Daniel Bolshoy nous ramènera au pays avec la prestation de la pièce Aurore Boréale, du compositeur franco-canadien Patrick Roux. Artiste : Daniel Bolshoy, guitare. RÉGULIER | 35 $."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-fr",
        "@value": "https://www.aramusique.org/evenement/voyage-a-travers-les-ameriques/"
