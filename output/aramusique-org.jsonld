    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.aramusique.org/apero-jazz-saison-2023-2024/rousso-passion-et-melodies-jazz/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Rousso : Passion & mélodies jazz"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "[EN FORMULE CABARET]\nLe pianiste virtuose Xavier Rousso vous présente une musique qui chevauche le jazz et le néo-classique tirée de ses deux albums Iceberg et Rosemont. Entouré de ses musiciens Pierre-Alexandre Maranda à la contrebasse, Ryan Truby au violon et Stef Jackson au saxophone, la personnalité chaleureuse et spontanée de Rousso vous entraîne rapidement à la découverte d’un univers tissé de perles noires et blanches musicales.\nC’est d’ailleurs avec un réel plaisir qu’il partage avec les spectateurs son processus créatif, afin de vous conduire dans ce monde fertile où voguent allègrement le classique et le jazz, à travers des concepts mélodiques où la passion fait émerger la musique.\nArtistes :\nXavier Rousso, piano\nStef Jackson, saxophone\nPierre-Alexandre Maranda, contrebasse\nRyan Truby, violon\nRÉGULIER | 30 $"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
