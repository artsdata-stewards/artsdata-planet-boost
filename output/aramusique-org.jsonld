      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "Assistez à un voyage musical aux couleurs de l'Amérique du Sud avec le Graciano Quartet, originaire d'Argentine, qui mélange habilement tango, jazz et musique classique, avec une instrumentation traditionnelle de deux guitares, un bandonéon et une contrebasse. Une expérience musicale virtuose à ne pas manquer."
      }
    ],
