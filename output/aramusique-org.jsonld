  },
  {
    "@id": "https://www.aramusique.org/evenement/paris-sous-les-etoiles/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-fr",
        "@value": "fr_FR"
      }
    ],
    "http://ogp.me/ns#type": [
