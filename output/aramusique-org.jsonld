      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "Découvrez le Messie de Haendel interprété sur instruments d'époque par l'Harmonie des Saisons. L'œuvre intemporelle est présentée biannuellement à Repentigny depuis 6 ans, offrant une interprétation magistrale dirigée par Eric Milnes jouant du clavecin. Un événement musical incontournable pour les mélomanes et amateurs de musique baroque."
      }
    ],
