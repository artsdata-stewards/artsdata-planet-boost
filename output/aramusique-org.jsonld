    "http://schema.org/organizer": [
      {
        "@id": "_:g4311560"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "_:g4311580"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.aramusique.org/sons-et-brioches-saison-2023-2024/circus-opus/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Circus Opus"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Un cirque de puces débarque en ville !\nAttention… Mesdames et messieurs, petits et grands…\nAccompagnés de leur petit orchestre, Il Direttore Maestro et son assistant Presto vous invitent à l’ultime représentation du Circus Opus ! Venez applaudir les exploits de nos remarquables artistes : Barbara la puce à barbe, Giulietta la puce cantatrice sans oublier les incroyables Swiffer Sisters ! Curieuses et espiègles, les puces joueront des tours à Maestro et Presto qui feront des pieds et des mains pour reprendre le contrôle de leurs petites bêtes…\nCircus Opus, c’est également un quatuor de musiciens aussi talentueux que déjantés qui revisiteront des classiques tels que L’entrée des gladiateurs de Fucik, la Barcarolle d’Offenbach ou le Vol du bourdon de Rimski-Korsakov.\nQue le spectacle commence !\nAvec la collation offerte gracieusement par McCafé à partir de 12 h 15\nArtistes :\nIdée originale et conception musicale : Maurice Laforest\nScénario : Véronika Makdissi-Warren, Maurice Laforest, Bertrand Alain et Benoît Lemay\nMise en scène : Véronika Makdissi-Warren\nInterprétation : Bertrand Alain et Benoît Lemay\nArrangements musicaux : Frédérick Desroches\nInterprétation musicale : Frédérick Desroches (piano), Olivier Forest (percussions), Claudia Gagné (contrebasse) et Sylvain Neault (violon)\nCostumes et décor : Huguette Lauzé\nConseiller en jonglerie : Yohann Trépanier\nRÉGULIER | 19 $\n8ANS ET – | 11 $"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
