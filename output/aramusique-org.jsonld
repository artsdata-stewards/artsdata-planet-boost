    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.aramusique.org/grands-concerts-saison-2023-2024/transtaiga-la-quete-du-retour/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "TRANSTAÏGA : La quête du retour"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Transtaïga, c’est l’histoire d’une expédition qui a mené Samuel Lalande-Markon et son partenaire David Désilets de Montréal à Kuujjuaq. Cette histoire se déploie dans un concert-documentaire par sa manière d’aborder le réel de l’expédition et du territoire parcouru, avec sa narration, son foisonnement visuel et sonore.\nLes somptueuses images projetées du territoire nordique québécois sont accompagnées par une trame musicale baroque propice à la contemplation et qui évoque le sacré — le sacré de la forêt et du territoire.  Une rencontre à la fois spirituelle et sensorielle du territoire, livrée dans un format à mi-chemin entre le concert et le théâtre documentaire.\nAuteur et aventurier : Samuel Lalande-Markon\nComédien : Alexis Déziel\nMusique : Les Boréades de Montréal\nMise en scène : Anne Millaire\nRÉGULIER | 50 $\nABONNÉ ARAMUSIQUE | 40 $\nPRIVILÈGE | 45 $"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
  {
    "@id": "https://www.aramusique.org/grands-concerts-saison-2023-2024/dis-quand-reviendras-tu/",
