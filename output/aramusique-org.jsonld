  {
    "@id": "https://www.aramusique.org/evenement/un-clavier-trois-siecles/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-fr",
        "@value": "fr_FR"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-fr",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-fr",
        "@value": "UN CLAVIER, TROIS SIÈCLES | MUSIQUE INTIMISTE | REPENTIGNY"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "AUTOUR DU PIANO Du clavecin de Bach à l’humour grinçant de Prokofiev, le pianiste David Jalbert traverse trois siècles de grande musique pour cet instrument qui continue d’émerveiller en 2024. Après un détour chez les français Claude Debussy et Francis Poulenc, ce dernier rendant hommage à son amie Édith Piaf, le programme se termine avec le sommet expressif que représente la musique pour piano de Frédéric Chopin.Artiste :David Jalbert, piano RÉGULIER | 35 $. 3 décembre 2024, 20 h Théâtre Alphonse-Desjardins, Repentigny."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-fr",
        "@value": "https://www.aramusique.org/evenement/un-clavier-trois-siecles/"
      }
