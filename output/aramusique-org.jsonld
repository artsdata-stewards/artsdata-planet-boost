    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.aramusique.org/grands-concerts-saison-2023-2024/nuit-blanche/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Nuit Blanche"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Créé à l’occasion de son 15e anniversaire, le Duo Fortin-Poirier présente le concert Nuit Blanche. Le thème de la nuit y est exploré dans toutes ses déclinaisons: le doute, l’angoisse, la passion, la fête, l’amour et le rêve s’y côtoient à travers des œuvres pour piano à quatre mains de grands compositeurs classique et moderne.\nLe ballet des quatre mains sur le clavier continue d’émerveiller grâce à une projection en direct sur grand écran et à une conception d’éclairages signée Alexandre Péloquin..\nArtistes :\nMarie-Christine Poirier, piano\nAmélie Fortin, piano\nRÉGULIER | 45 $\nABONNÉ ARAMUSIQUE | 36 $\nPRIVILÈGE | 41 $"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
