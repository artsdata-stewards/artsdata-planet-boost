  {
    "@id": "https://www.aramusique.org/evenement/ella-et-le-big-band/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-fr",
        "@value": "fr_FR"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-fr",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-fr",
        "@value": "Ella et le Big Band | 26 juin à 17 h 30 au Théâtre Alphonse Desjardins | Aramusique"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "- Formule Cabaret - L’Aramusique vous invite à souligner la fête du jazz ici à Repentigny ! Le 26 juin prochain à 17 h 30 ce sont 20 musiciens d’un Big Band, sous la direction de la cheffe et pianiste Marianne Trudel, qui mettront à l’honneur une des grandes icônes du jazz, la madame Ella Fitzgerald. Les chansons immortelles de cette grande dame du jazz seront interprétées par la chanteuse Élizabeth Cormier.En ce début d’été soyez de la fête et venez écouter et applaudir les excellents musiciens de jazz du Québec au Théâtre Alphonse-Desjardins. Il ne manque plus que vous !ArtistesMarianne Trudel, direction Élizabeth Cormier, voix 20 Musiciens du Big Band. Théâtre Alphonse-Desjardins à Repentigny. 35 $."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-fr",
        "@value": "https://www.aramusique.org/evenement/ella-et-le-big-band/"
      }
