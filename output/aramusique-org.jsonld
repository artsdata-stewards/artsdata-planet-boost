  {
    "@id": "https://aramusique.org/temporary/8f2d757b-edbf-498f-a39b-7f1e542cf41e",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.aramusique.org/wp-content/uploads/2023/07/LE-JAZZ-AUX-COULEURS-DE-LARGENTINE_2023-09-14_1.jpg"
      }
    ],
    "http://schema.org/startDate": [
