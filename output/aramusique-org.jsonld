    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.aramusique.org/grands-concerts-saison-2023-2024/dis-quand-reviendras-tu/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Dis, quand reviendras-tu ?"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "La soprano Myriam Leblanc, accompagnée de Grégoire Jeay à la flûte, de Sylvain Bergeron à la guitare et à l’archiluth et d’Antoine Malette-Chénier à la harpe, vous propose des chansons baroque et moderne sur le thème éternel de l’amour. Un voyage en musique où les poètes et compositeurs de toutes les époques et de différents pays se rejoignent dans cette magnifique folie qui les a tant inspirés.\nL’amour, sans frontières temporelles, offre un passeport à la musique pour s’exprimer dans tous ses états et ses couleurs caractéristiques, donnant ainsi à l’auditeur l’occasion de goûter des œuvres qui n’ont rien en commun de prime abord, mais qui sont réunies par cette thématique universelle et ces instruments particuliers.\nArtistes :\nMyriam Leblanc, soprano\nSylvain Bergeron, archiluth et guitare baroque\nGrégoire Jeay, flûte baroque\nAntoine Malette-Chénier, harpe\nRÉGULIER | 45 $\nABONNÉ ARAMUSIQUE | 36 $\nPRIVILÈGE | 41 $"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
