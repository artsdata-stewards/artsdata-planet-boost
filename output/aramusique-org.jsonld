  {
    "@id": "https://www.aramusique.org/evenement/concert-ephemere/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-fr",
        "@value": "fr_FR"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-fr",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-fr",
        "@value": "CONCERT ÉPHÉMÈRE | MIDIS ARAMUSIQUE"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "François Bourassa et Samuel Blais se retrouvent en duo avec une formule unique: un concert complètement improvisé du début à la fin! Inspirés de leur grand bagage d’improvisateurs de même que par certains de leurs compositeurs préférés, ils se prêtent au jeu de créer dans le moment présent plusieurs œuvres qui n’ont jamais été jouées et qui n’existeront qu’une seule fois, devant public. Tout peut être source d’inspiration: les émotions du moment, le souci des contrastes et peut-être même une suggestion du public? Il faut y être pour le savoir! François Bourassa, piano Samuel Blais, saxophone. Préau du Centre d'art Diane-Dufresne, gratuit."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-fr",
        "@value": "https://www.aramusique.org/evenement/concert-ephemere/"
      }
