    "http://schema.org/performer": [
      {
        "@id": "_:g4461840"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.aramusique.org/apero-jazz-saison-2023-2024/autour-d-henri-salvador/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Autour d'Henri Salvador"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "[EN FORMULE CABARET]\nC’est en jouant du jazz durant les années trente que l’auteur, compositeur, interprète, humoriste et musicien Henri Salvador a entamé sa longue carrière. Il laisse derrière lui des chansons inoubliables telles que Le Jardin d’hiver et Une Chanson douce qui seront interprétées par six grands musiciens bien connus de chez nous : le chanteur Claudel Callender, le pianiste John Roney, le guitariste Francis Tétu, le saxophoniste Samuel Blais, le percussionniste Bertil Schulrabe et le contrebassiste François Marion.\nCe joyeux sextet interprétera également des classiques de la chanson française de Legrand, Moustaki, Bécaud, Piaf, Aznavour, Montand, Nougaro, grands amis d’Henri Salvador.\nArtistes :\nSamuel Blais, saxophone\nClaudel Callender, voix\nFrançois Marion, contrebasse\nJohn Roney, piano\nBertil Schulrabe, percussions\nFrancis Tétu, guitare\nRÉGULIER | 30 $"
      }
    ],
