    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Heather Rankin"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n\t\t\t\t\t\t\t\t\t\tHeather Rankin is an East Coast musical icon, famed for her soaring voice, heartfelt songwriting, and international career as part of the record-breaking Cape Breton supergroup The Rankins. Now, after our sold-out collaborations in 2019 and 2023, Symphony Nova Scotia reunites with Heather for a rich symphonic feast of favourites, including new orchestral arrangements from her award-winning solo career, plus some of The Rankin Family’s greatest hits!\n\t\t\t\t\t\t\t\t\t"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": "\n\t\t\t\t\t\t\t\t\t\tHeather Rankin, vocals\nMartin MacDonald, conductor\t\t\t\t\t\t\t\t\t"
      }
    ]
  },
