    ],
    "http://ogp.me/ns#description": [
      {
        "@value": "Fifteen-year-old Christopher, a mathematics prodigy who struggles to understand the nuances of everyday life, seeks to solve the mystery of who murdered his neighbour’s dog, Wellington, and embarks on an epic journey that will change his life. A story of family, adolescence, and discovering true potential emerges in this highly theatrical Tony-award winning play."
      }
    ],
