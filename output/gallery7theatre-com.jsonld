    "http://ogp.me/ns#url": [
      {
        "@value": "https://gallery7theatre.com/shows-training/a-few-good-men"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@value": "A US Marine dies because of a disciplinary action gone horribly wrong. A young Navy attorney with a reputation for plea bargains is assigned to defend the two soldiers accused of the murder. This high-stakes court-room drama, sprinkled with generous doses of humour, explores honour, integrity, and standing up for the truth, all while examining how our careers shape who we are."
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@value": "website"
      }
