        "@value": "A Few Good Men"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@value": "https://cdn.sanity.io/images/3mfo8cve/production/fa9b3e10c9ff68ec3a20b219faa270806e29608c-1800x1800.jpg?w=1200"
