    "http://ogp.me/ns#url": [
      {
        "@value": "https://gallery7theatre.com/shows-training/snowbound"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@value": "A hilarious and charming new play about two opposites trying to connect in a lonely world. Judith interrupts Patrick’s solitary life when she shows up at his door unexpectedly during a snowstorm searching for baking supplies. A Canadian premiere filled with laughter, a few tears, plenty of snow, some wine, and a pizza, this play will bring a touch of whimsey and warmth to your winter season."
      }
    ],
    "http://ogp.me/ns#type": [
