    "http://ogp.me/ns#url": [
      {
        "@value": "https://gallery7theatre.com/shows-training/jeeves-intervenes"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@value": "Bertie Wooster doesn’t want to get married. His meddling relatives have other ideas. A plan is hatched. Can Jeeves save the day? Based on characters created by PG Wodehouse and chock full of mistaken identity, ridiculous circumstances, and high-stakes antics, this madcap farce will keep you laughing all performance long."
      }
    ],
