    ],
    "http://schema.org/image": [
      {
        "@id": "https://contesvivants.ca/wp-content/uploads/2025/09/Illu_Automne_Laurie-Anne_Deschenes-scaled.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g515900"
      }
