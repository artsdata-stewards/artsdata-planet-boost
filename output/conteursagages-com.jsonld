    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "La Légende d’Automne"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p><span style='font-weight: 400;'>Nous serons de passage à la bibliothèque Philippe-Panneton pour y présenter notre heure du conte réinventée. Un atelier interactif qui commence par la performance d’une histoire de saison. Ensuite, le conteur présent, en interagissant avec les participant.e.s, créera une histoire sur mesure. Un conte unique, qui n’a jamais existé, entièrement improvisé. Une histoire pour s’émerveiller des beautés de l’automne.</span></p> <p><span style='font-weight: 400;'>C’est un moment touchant, drôle et toujours mémorable !</span></p> <p><span style='font-weight: 400;'>Venez écoutez et créez des histoires avec Contes vivants.</span></p> <p><span style='font-weight: 400;'>EN FRANÇAIS</span></p> <p><span style='font-weight: 400;'>5 ans et plus<br /> Événement gratuit et sans inscription. </span><span style='font-weight: 400;'><br /> </span><span style='font-weight: 400;'>45 à 60 minutes, selon le nombre de participant.e.s présent.e.s</span></p> <p>&nbsp;</p> "
      }
    ],
