  {
    "@id": "https://www.conteursagages.com/event_1922_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://contesvivants.ca/evenements/beton-pissenlit-latelier/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://contesvivants.ca/wp-content/uploads/2025/08/4.1-Affiche_Beton_pissenlit_675x675-scaled.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g516120"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.conteursagages.com/nos-evenements"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Béton &amp; Pissenlit - Créons votre histoire de quartier"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Béton et pissenlit est un spectacle de soixante minutes où Félix Morissette fait battre le cœur de son quartier d’enfance.</p> <p>Au fil des récits, un géant de pierre baptise l’île, une tisane empoisonne la solidarité, un bonhomme de neige rebelle sillonne les ruelles, deux frères jardinent la révolution, et le quartier lui-même prend la parole.</p> <p>Contes urbains, légendes de ruelles et percussions de chaudron tissent un univers où humour, tendresse et transition écologique vibrent à l’unisson. Une ode vibrante au vivre-ensemble urbain.</p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-10-5T11:00-4::00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-10-5T12:00-4::00"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
  {
    "@id": "_:g516120",
