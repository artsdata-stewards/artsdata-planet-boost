      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "La Légende d’automne"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Nous serons de passage au Festival Mozaïque pour y présenter notre heure du conte réinventée. Un atelier interactif qui commence par la performance d’une histoire de saison. Ensuite, le conteur présent, en interagissant avec les participant.e.s, créera une histoire sur mesure. Un conte unique, qui n’a jamais existé et qui peut ne plus jamais exister par la suite. Une histoire pour mettre en valeur les beautés de l&rsquo;automne.</p> <p>C’est un moment touchant, drôle et toujours mémorable !</p> <p>Venez écoutez et créez des histoires avec Contes vivants.</p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-9-20T19:30-4::00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-9-20T20:15-4::00"
      }
    ],
