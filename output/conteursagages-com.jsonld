      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Le Grand Bill en musique"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Bill est un minuscule explorateur en quête de sa vraie nature!</p> <p>Entre fleurs, bourdons et rodéos aériens, suivez les aventures drôles et touchantes d’un insecte qui n’arrive pas à suivre la cadence.</p> <p>Un conte captivant et éducatif, rempli d’humour et de découvertes, qui éveillera petits et grands à la beauté du monde des insectes.</p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-7-25T13:00-4::00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-7-25T14:00-4::00"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
