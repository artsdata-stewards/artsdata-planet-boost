        "@id": "https://www.conteursagages.com/nos-evenements"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "L’histoire incroyable d’Été"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Notre heure du conte réinventée est un atelier interactif qui commence par la performance d’une histoire de saison.</p> <p>Ensuite, le conteur, en interagissant avec les participant.e.s, co-crée une histoire sur mesure. Un conte unique, qui n’a jamais existé et qui peut ne plus jamais exister par la suite.</p> <p>C’est un moment touchant, drôle et toujours mémorable !</p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-8-6T16:00-4::00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-8-6T17:00-4::00"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
