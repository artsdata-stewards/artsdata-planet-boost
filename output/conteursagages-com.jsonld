  {
    "@id": "https://www.conteursagages.com/event_2262_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://contesvivants.ca/evenements/la-legende-dautomne-3/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://contesvivants.ca/wp-content/uploads/2025/09/Illu_Automne_Laurie-Anne_Deschenes-scaled.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g516540"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
