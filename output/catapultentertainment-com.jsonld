    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Eight dancers, one giant screen, Mozart’s music: an inventive and ludic choreography in which the projected shadows of the dancers take us on a journey of surprising metamorphosis, where smiles and rapture go hand in hand."
