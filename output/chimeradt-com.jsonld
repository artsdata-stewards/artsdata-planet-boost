  },
  {
    "@id": "http://www.chimeradt.com/temporary/4229240a-2fc7-4b29-b4b1-5ce8e051cf28",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://chimeradt.com/events/legacy-workshoop-hoop-dancing-with-arik-pipestem/"
      }
