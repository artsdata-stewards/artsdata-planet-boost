    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Sunday Smiles Family Entertainment Series: Silly Billy (Kenora, ON)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n\t\t\t\t\t\t\t\t\t\tSilly Billy is on tour this fall! As we return to northern Ontario for the second part of our tour, we are excited to visit Kenora for the first time.\nSilly Billy is a story about a rare white buffalo unhappy with his uniqueness, who goes on a quest to find the magical Unicorn in the hopes of emulating this mythical creature. Through adventures, obstacles, misunderstandings and mishaps, Billy discovers his own self-worth, embraces his difference, and takes his place alongside the Unicorn as the legendary great white buffalo of the plains. This iteration of Silly Billy will feature Chimera artists Nimkii Osawamick stepping into the role of Billy and Emma Curtis resuming her role as the Unicorn.\n3:00 PM at John Paul II School (1290 Keenan Place)\n"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
