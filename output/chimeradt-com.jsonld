    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Among our main projects for the summer is another round of school performances with Prologue Performing Arts! While we’re touring our children’s show Silly Billy all over the Greater Toronto Area (with Arik Pipestem as our courageous Great White Buffalo and Emma Curtis as our beautiful Unicorn) we will also be developing a version of Silly Billy […]"
      },
