    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Soft (Excerpt)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n\t\t\t\t\t\t\t\t\t\tExcerpt of Dora-Nominated work Soft, featuring a duet performed by Mio Sakamoto and Sebastian Bash Hirtenstein.\nSoft was premiered in 2024 at the Harbourfront Centre Theatre, and is choreographed by Malgorzata Nowacka-May, Dramaturgy by Karen Kaeja, and with original music composition by Eric Cadesky.\n \nDANCEWEEKEND DANCE PARTY WITH DJ Grouch\n7-9 PM\nFeaturing dance performances (seating available), mini dance workshops, facilitated dance animation, prizes and your chance to hit the dance floor! Bring your dancing shoes!\nFeaturing performances by:\nCoco Collective presented in partnership with dance Immersion (West African and Caribbean folk)\nThe Chimera Project (Contemporary)\nEnsemble Topaz (Central Asian/Tajik Dance)\nRagamalika Mohanraj (Indian classical- Bharatanatyam)\nKorean Dance Studies Society of Canada(Traditional Korean)\nNisha Ray (Odissi-Indian Classical Dance)\nSusannah Haight  (Contemporary)\nChameleon Coalition (Contemporary Hip Hop Fusion)\nSara Porter (Contemporary)\nEsperides  (Middle Eastern)\nand more!\n"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
