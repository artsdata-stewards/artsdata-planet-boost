    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://chimeradt.com/wp-content/uploads/2024/12/Chimera-Project-Unclearing-2024-682.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2025-2-22T19:00+0:00"
      }
    ],
    "http://schema.org/endDate": [
