    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Northern Lights Performing Arts Pavilion: Silly Billy (Haliburton, ON)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p class='p1'><i>Silly Billy</i> is on tour this fall! As we conclude our highly successful tour in northern Ontario, we are thrilled to wrap up our last performance in Haliburton.</p> <p class='p1'><i>Silly Billy</i> is a story about a rare white buffalo unhappy with his uniqueness, who goes on a quest to find the magical Unicorn in the hopes of emulating this mythical creature. Through adventures, obstacles, misunderstandings and mishaps, Billy discovers his own self-worth, embraces his difference, and takes his place alongside the Unicorn as the legendary great white buffalo of the plains. This iteration of <i>Silly Billy</i> will feature Chimera artists Waawaate Fobister stepping into the role of Billy and Emma Curtis resuming her role as the Unicorn.</p> <p>6:30 PM at the Northern Lights Arts Pavilion (5358 Haliburton County Road 21)</p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-10-26T18:30+0::00"
      }
    ],
