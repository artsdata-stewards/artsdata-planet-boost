    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://chimeradt.com/wp-content/uploads/2025/04/Silly-Billy-126-copy.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2025-10-24T13:00+0:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "en",
        "@value": "2025-10-24T14:00+0:00"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Arts Touring Alliance of Alberta: Silly Billy (Edmonton, AB)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n\t\t\t\t\t\t\t\t\t\tSilly Billy is on tour this fall! As we conclude our highly successful tour in northern Ontario, we are flying back west to attend and present at the Alberta Showcase with the Arts Touring Alliance of Alberta.\nSilly Billy is a story about a rare white buffalo unhappy with his uniqueness, who goes on a quest to find the magical Unicorn in the hopes of emulating this mythical creature. Through adventures, obstacles, misunderstandings and mishaps, Billy discovers his own self-worth, embraces his difference, and takes his place alongside the Unicorn as the legendary great white buffalo of the plains. This iteration of Silly Billy will feature Chimera artists Waawaate Fobister stepping into the role of Billy and Emma Curtis resuming her role as the Unicorn.\n1:00 PM at the Dow Centennial Centre (8700 84 Street)\n"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
