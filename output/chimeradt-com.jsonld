    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Pied Piper Kids Show: Silly Billy (Temiskaming Shores &amp; Cobalt, ON)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p class='p1'><i>Silly Billy</i> is on tour this fall! As we make our way through the beautiful landscapes of northern Ontario, we are excited to visit Temiskaming Shores and Cobalt for the first time.</p> <p class='p1'><i>Silly Billy</i> is a story about a rare white buffalo unhappy with his uniqueness, who goes on a quest to find the magical Unicorn in the hopes of emulating this mythical creature. Through adventures, obstacles, misunderstandings and mishaps, Billy discovers his own self-worth, embraces his difference, and takes his place alongside the Unicorn as the legendary great white buffalo of the plains. This iteration of <i>Silly Billy</i> will feature Chimera artists Waawaate Fobister stepping into the role of Billy and Emma Curtis resuming her role as the Unicorn.</p> <p>6:30 PM at the Cobalt Classic Theatre (30 Silver Street)</p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-10-2T18:30+0::00"
      }
