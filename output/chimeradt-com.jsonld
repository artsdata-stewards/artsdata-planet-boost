  {
    "@id": "http://www.chimeradt.com/events/soft-excerpt/event_11261_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://chimeradt.com/events/soft-excerpt/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://chimeradt.com/wp-content/uploads/2024/12/Chimera-Project-Unclearing-2024-682.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g796940"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "http://www.chimeradt.com/events/soft-excerpt/%23respond"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Soft (Excerpt)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Excerpt of Dora-Nominated work Soft, featuring a duet performed by Mio Sakamoto and Sebastian Bash Hirtenstein.</p> <p>Soft was premiered in 2024 at the Harbourfront Centre Theatre, and is choreographed by Malgorzata Nowacka-May, Dramaturgy by Karen Kaeja, and with original music composition by Eric Cadesky.</p> <p>&nbsp;</p> <p><strong>DANCEWEEKEND DANCE PARTY WITH DJ Grouch</strong></p> <p><strong>7-9 PM<br /> </strong><span data-olk-copy-source='MessageBody'>Featuring dance performances (seating available), mini dance workshops, facilitated dance animation, prizes and your chance to hit the dance floor! Bring your dancing shoes!</span></p> <p><strong>Featuring performances by:</strong></p> <p><a href='http://www.misscocomurray.com/calabash.html'>Coco Collective </a>presented in partnership with <a href='https://danceimmersion.ca/'>dance Immersion </a>(West African and Caribbean folk)<br /> <a href='http://www.chimeradt.org'>The Chimera Project </a>(Contemporary)<br /> <a href='http://topaz.mikeanklewicz.com/'>Ensemble Topaz (</a>Central Asian/Tajik Dance)<br /> <a href='https://danceontario.ca/member/ragamalika-mohanraj/'>Ragamalika Mohanraj</a> (Indian classical- Bharatanatyam)<br /> <a href='http://www.koreandance.net'>Korean Dance Studies Society of Canada</a>(Traditional Korean)<br /> <a href='https://danceontario.ca/member/nisha-ray/'>Nisha Ray </a>(Odissi-Indian Classical Dance)<br /> <a href='https://danceontario.ca/member/susannah-haight-2/'>Susannah Haight  </a>(Contemporary)<br /> <a href='https://www.allirobbcreative.ca/'>Chameleon Coalition</a> (Contemporary Hip Hop Fusion)<br /> <a href='https://www.saraporter.ca/'>Sara Porter </a>(Contemporary)<br /> <a href='https://torontobellydancing.ca/'>Esperides </a> (Middle Eastern)</p> <p>and more!</p> "
      }
    ],
    "http://schema.org/startDate": [
