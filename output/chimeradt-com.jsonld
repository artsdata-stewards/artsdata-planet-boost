    ],
    "http://schema.org/url": [
      {
        "@id": "https://chimeradt.com/events/iroquois-falls-arts-council-silly-billy-iroquois-falls-on/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://chimeradt.com/wp-content/uploads/2025/04/Silly-Billy-126-copy.jpg"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "http://www.chimeradt.com/events/iroquois-falls-arts-council-silly-billy-iroquois-falls-on/%23respond"
