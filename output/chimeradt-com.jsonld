    ],
    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://chimeradt.com/wp-content/uploads/2024/08/H1X4139.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2026-1-12T09:00+0:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "en",
        "@value": "2026-1-16T16:00+0:00"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Legacy Workshoop: Hoop Dancing with Arik Pipestem"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n\t\t\t\t\t\t\t\t\t\tExperience the power, discipline, and beauty of Indigenous Hoop Dancing with the incredible Arik Pipestem.   A proud member of the Tsuut’ina Nation, Arik is an internationally acclaimed hoop dancer, choreographer, and performer. His work fuses traditional powwow styles with contemporary and hip-hop influences, bringing fresh imagination to an ancient art form.\n\n\nThere is no prior hoop dancing experience necessary – all dance artists and movers are welcome to attend.\n\n\nOPEN WORKSHOPS:\nTime: each day from 10 AM – 12 PM – no experience necessary\nLearn technique, momentum, weaving, choreography & improvisation\nCost: $150 for the week or $30 drop-in fee \n\n\n\nMENTORSHIP PROGRAM:\nWe are offering a MENTORSHIP PROGRAM (10 AM – 12 PM + 1 – 5 PM)\nThis is a paid, by-application opportunity for dancers seeking deeper engagement in this amazing artistry.\nThe Mentorship Program will provide in-depth training with Arik & company artists, training in company repertoire with creative exploration & choreography time\nHonorarium: $1,000 per week (based on attendance)\n\n\n\nSCHOLASHIPS \nA limited amount of scholarships to attend the full-day mentorships program is available in the event mentorship spots are filled.\nPlease fill out the application form and select “scholarship application” as an option.\n \n\nWHAT YOU WILL LEARN:\n• Hoop movement fundamentals & artistry\n• Advanced hoop skills for experienced dancers\n• Proper protocols & cultural care\n• Hoop building, repair & maintenance\n• Choreographed routines + improvisation tools\nAll materials will be provided.\n\n \nWorkshops are tailored to all skill levels.\n \nPlease use this link to sign up for the open workshop, or to apply for the Mentorship Program or Scholarships:\n\n \nPlease reach out if you have any questions.\n"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
