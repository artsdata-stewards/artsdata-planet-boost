    ],
    "http://schema.org/url": [
      {
        "@id": "https://chimeradt.com/events/atikokan-childrens-entertainment-series-silly-billy-atikokan-on/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://chimeradt.com/wp-content/uploads/2025/04/Silly-Billy-126-copy.jpg"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://chimeradt.com/events/atikokan-childrens-entertainment-series-silly-billy-atikokan-on/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Atikokan Children&#039;s Entertainment Series: Silly Billy (Atikokan, ON)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p class='p1'><i>Silly Billy</i> is on tour this fall! As we return to northern Ontario for the second part of our tour, we are excited to visit Atikokan for the first time.</p> <p class='p1'><i>Silly Billy</i> is a story about a rare white buffalo unhappy with his uniqueness, who goes on a quest to find the magical Unicorn in the hopes of emulating this mythical creature. Through adventures, obstacles, misunderstandings and mishaps, Billy discovers his own self-worth, embraces his difference, and takes his place alongside the Unicorn as the legendary great white buffalo of the plains. This iteration of <i>Silly Billy</i> will feature Chimera artists Nimkii Osawamick stepping into the role of Billy and Emma Curtis resuming her role as the Unicorn.</p> <p>6:30 PM at St. Patrick School (160 Hemplock Avenue)</p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-10-20T18:30+0::00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-10-20T19:30+0::00"
      }
    ],
