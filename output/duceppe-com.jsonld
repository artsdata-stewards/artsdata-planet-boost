  {
    "@id": "https://duceppe.com/temporary/4e645723-0af0-414e-a021-8c48d6d33998",
    "@type": [
      "http://schema.org/TheaterEvent"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://duceppe.com/prima-facie/#20270421"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g2438600"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://duceppe.com/uploads/DU2627_PRIMAFACIE_VIGNETTE_WEB_1388x1920.jpg"
      }
    ],
    "http://schema.org/sameAs": [
      {
