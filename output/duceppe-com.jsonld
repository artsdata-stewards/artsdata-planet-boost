        "@id": "https://duceppe.com/le-fantome-dans-la-machine/#20261114"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1921680"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://duceppe.com/uploads/DU2627_FANTOME_VIGNETTE_WEB_1388x1920.jpg"
      }
    ],
    "http://schema.org/sameAs": [
