  {
    "@id": "https://duceppe.com/temporary/2e450f2e-3fb3-477c-bacc-66168cb872b4",
    "@type": [
      "http://schema.org/TheaterEvent"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://duceppe.com/ouvert-a-toute-diversite-corporelle/#20260421"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g3466220"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://duceppe.com/uploads/diversite_DU2526_VIGNETTE_WEB_1388x1920.jpg"
      }
    ],
    "http://schema.org/sameAs": [
