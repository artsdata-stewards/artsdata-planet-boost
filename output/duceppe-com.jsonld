  {
    "@id": "https://duceppe.com/glissant-glissant/",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Glissant glissant - Théâtre Duceppe"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Comédie noire absurde de François Ruel-Côté sur la précarité artistique et le besoin de croire. Une grande messe bricolée qui dérape, entre extraterrestres et IA divine. Succès en rappel chez Duceppe à la Cinquième Salle. À l'affiche en mars 2027."
      }
    ],
