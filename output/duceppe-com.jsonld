        "@id": "https://duceppe.com/janette/#20261204"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g4148680"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://duceppe.com/uploads/DUCEPPE_Saison24-25_JANETTE_Vignette_Web_1388x1920.jpg"
      }
    ],
