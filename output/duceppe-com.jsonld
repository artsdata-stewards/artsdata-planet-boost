  {
    "@id": "https://duceppe.com/prima-facie/",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Prima facie | À première vue - Théâtre Duceppe"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Solo théâtral haletant sur le système judiciaire et les victimes d'agression sexuelle. Mise en scène de Louis-Karl Tremblay. Avec Valérie Tellos. Succès mondial enfin à Montréal. À l'affiche en avr-mai 2027."
      }
    ],
