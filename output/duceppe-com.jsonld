  {
    "@id": "https://duceppe.com/tupqan/",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Tupqan | Nos territoires intérieurs - Théâtre Duceppe"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Thriller politique et quête identitaire suivant Polam dans sa mission pour restaurer la paix dans une communauté éloignée. Un spectacle poétique qui interroge nos histoires intimes et collectives. À l’affiche en mars-avril 2026."
      }
