        "@language": "fr-ca",
        "@value": "Janette repas-spectacle sur la scène - Théâtre Duceppe"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Vivez une expérience unique en assistant au spectacle Janette sur scène plutôt que dans la salle, tout en mangeant un repas choisi par Janette Bertrand elle-même et servi par les comédien·nes de la distribution."
      }
    ],
