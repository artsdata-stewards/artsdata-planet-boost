    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Monologue engagé et incisif sur la grossophobie dans le milieu culturel. Texte et interprétation Vincent Millard. Courte pièce en formule 5 à 7. À l’affiche en avril-mai 2026."
