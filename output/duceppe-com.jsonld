    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 4 mai 2026 - Une soirée pour se souvenir, pour se retrouver, et pour applaudir une dernière fois cette femme qui n'a jamais cessé de nous émouvoir."
