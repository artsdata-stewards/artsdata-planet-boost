    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Janette | repas-spectacle sur scène"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "«Le cœur des gens, ça s’atteint par le ventre.» - Janette Janette Bertrand a toujours aimé prendre soin des gens, souvent autour d&#039;un bon repas. C&#039;est pourquoi nous vous offrons la  possibilité de vivre une expérience unique en assistant au spectacle Janette sur scène plutôt que dans la salle, tout en mangeant un repas choisi par Janette Bertrand elle-même et servi par les comédien·nes de la distribution."
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-12-04T19:30:00-05:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-12-04T21:30:00-05:00"
      }
    ],
