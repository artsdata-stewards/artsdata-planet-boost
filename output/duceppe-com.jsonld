  {
    "@id": "https://duceppe.com/what-you-wont-do-for-love/",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Qu'est-ce qu’on ne ferait pas par amour? (What you won’t do for love) - Théâtre Duceppe"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Spectacle avec David Suzuki et Tara Cullis sur l'amour et la préservation du vivant. Une production de Why not Theatre, présentée au Centaur Theatre, en codiffusion avec Duceppe."
      }
    ],
    "http://ogp.me/ns#image": [
