  {
    "@id": "https://duceppe.com/le-fantome-dans-la-machine/",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Le fantôme dans la machine - Théâtre Duceppe"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "«Auto-science-fiction» de Fanny Britt sur la mémoire et les vies non vécues. Mise en scène d’Alexia Bürger. Une œuvre intime et troublante entre réel et fiction. À l'affiche en oct-nov 2026."
      }
    ],
