  {
    "@id": "https://duceppe.com/un-tramway-nomme-desir/",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Un tramway nommé Désir - Théâtre Duceppe"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Relecture audacieuse du classique de Tennessee Williams. Théâtre, danse et fanfare pour un huis clos électrique sur le désir et la folie. Mise en scène de Virginie Brunelle et Jean-Simon Traversy. À l'affiche en jan-fév 2027."
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://duceppe.com/uploads/DU2627_TRAMWAY_FB-SHARE_1200x630.jpg"
      }
    ],
