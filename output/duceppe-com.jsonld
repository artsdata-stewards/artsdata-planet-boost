        "@id": "https://duceppe.com/tupqan/#20260402"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g2719580"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://duceppe.com/uploads/TUPQAN_DUCEPPE2526_VIGNETTE_WEB_1388x1920w.jpg"
      }
    ],
    "http://schema.org/sameAs": [
      {
        "@id": "https://nac-cna.ca/fr/creationfund/project/tupqan-nos-territoires-interieurs"
      },
      {
