    "http://schema.org/description": [
      {
        "@value": "BACKSTAGE, our free interview and music series with exciting special guests &#8211; Fridays at noon EST from Sanctuary and Refuge Projects. This instalment features virtuoso Turkish-Canadian sax player Selcuk Suna with live music and conversation. There are no actual tickets, simply join the Livestream at noon at:\r\nhttps://www.facebook.com/sultansofstring/\r\nhttps://www.youtube.com/sultansofstring \r\nhttps://twitter.com/sultansofstring\r\nhttps://www.linkedin.com/in/sultansofstring/"
