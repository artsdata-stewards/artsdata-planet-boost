    "http://schema.org/name": [
      {
        "@value": "Refuge"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Sanctuary (The Refuge Project) online CD release with Festival of Arabic Music and Arts, with special guests: \r\nLeen Hamo &#8211; vocals, Padideh Ahrarnejad &#8211; tar, Majd Sekkar &#8211; clarinet, Donné Roberts &#8211; vocals and guitar, Tamar Ilana &#8211; vocals and dance, Naghmeh Farahmand &#8211; percussion, Saskia Tomkins &#8211; nyckelharpa, Waleed Abdulhamid, Amir Amiri!\r\nThere are no actual tickets, simply join the Livestream at 7:30 pm EST on our Facebook, YouTube, LinkedIn or Twitter page!"
      }
    ]
  },
