      {
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Luminato Festival Virtual 2020, Artist and activist Ange Loft hosts a conversation inspired by our newly released album Refuge. Elder Duke Redbird, Ifrah Mansour, Waleed Abdulhamid and bandleader Chris McKhool chat about how refugees and displaced persons, particularly those who are artists, can guide us through the present moment. Thanks to Toronto Arts Council, Ontario Arts Council, and Canada Council for their support."
      }
    ]
  },
