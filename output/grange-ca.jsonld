      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "“... what a birthday present for anyone with ears to hear. On a mix of traditional and self-composed pieces, they shine with a crystalline brilliance.” - Chris Nickson RootsWorld USA, 2021."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
