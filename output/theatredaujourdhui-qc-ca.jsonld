  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/senjailler",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/148531/Senjailler_4x5_2023-11-10-201809_difj_9b9a712bdeb65c920d5ea9caeaf68767.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "S'enjailler | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Au sein de leur cercle intime, Naïca, Keza, Safia et Chloé se taquinent, partagent des anecdotes parfois embarrassantes et exposent leur vulnérabilité. Soutenues par une complicité mutuelle, ces jeunes femmes explorent avec sincérité les méandres complexes de leur identité, du féminisme, de la race et de la sexualité, embrassant pleinement leurs contradictions."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/senjailler"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/seuls",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/163280/2008-2009_Seuls_101d7b8599c0cc599ee16e9637ccc19e.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Seuls | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Harwan, un étudiant montréalais d’une trentaine d’années, sur le point de soutenir sa thèse, se retrouve, à la suite d'une série d’événements profondément banals, enfermé une nuit durant dans une des salles du Musée de l’Hermitage à Saint-Petersbourg. La nuit sera longue. Elle durera plus de deux mille ans et l’entraînera, sans qu’il puisse s’en douter une seconde, au chevet de sa langue maternelle oubliée il y a longtemps sous les couches profondes de tout ce qu’il y a de multiple en lui."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/seuls"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
