        "@id": "https://theatredaujourdhui.qc.ca/spectacles/corpstitan-2"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/corpstitan-2"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Le 28 mai 2013, alors qu’elle se rend à vélo à une répétition de théâtre, Audrey Talbot est frappée par un camion poids lourd. Son corps est broyé en une fraction de seconde, mais elle survit grâce à une suite miraculeuse de circonstances et un travail acharné. Entourée d’une distribution chorale de grand talent, elle revient sur son périple surréel vers la renaissance."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Corps titan (titre de survie)"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/coupdevieux/#webpage",
    "@type": [
      "http://schema.org/WebPage"
    ],
