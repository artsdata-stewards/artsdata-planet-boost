    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Pièce de théâtre multidisciplinaire écrite et mise en scène par Soleil Launière sur l’incarcération, la transmission et les choix qui façonnent une vie, au CTD’A à Montréal."
      }
