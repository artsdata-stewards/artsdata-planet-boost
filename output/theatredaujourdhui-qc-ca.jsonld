      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Soeurs | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Le cycle Domestique : voici le nouvel objet de travail de Wajdi Mouawad. Entamé avec Seuls, symbole du fils, cette pièce ouvre la voie à un second solo, Sœurs, lui-même suivi de Frères, puis de Père et Mère qui prendront à leur tour la forme de solos ou de duos. Plusieurs points de vue pour témoigner de la diversité des vécus des membres de la famille."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/soeurs"
