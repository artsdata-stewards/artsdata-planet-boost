        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/866661/DSC_0819_2025-05-21-170940_egcn_4ac10f3ad6782fa99fb0dfb0f118e64d.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Les invités d'honneur | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Chaque année, plusieurs personnes issues du milieu des affaires et de diverses professions relèvent généreusement le défi de monter sur scène lors de trois soirées festives, ayant pour objectif de soutenir la seule institution culturelle exclusivement dédiée à la dramaturgie québécoise."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/sb2025"
      }
