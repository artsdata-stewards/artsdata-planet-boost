  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/la-nuit-du-4-au-5/#webpage",
    "@type": [
      "http://schema.org/WebPage"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/la-nuit-du-4-au-5"
      }
    ],
    "http://schema.org/about": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/#identity"
      }
    ],
    "http://schema.org/isPartOf": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/#website"
      }
    ],
    "http://schema.org/potentialAction": [
      {
        "@id": "_:g4108560"
      }
    ],
    "http://schema.org/primaryImageOfPage": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/#logo"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/la-nuit-du-4-au-5"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Une femme a été agressée. Elle s’est débattue. Elle a crié et ce cri salvateur, réveillant ses voisins et mettant en fuite son agresseur, fait ressurgir toute la vie qui résiste en elle. Mais depuis, sa mémoire lui joue des tours. Cherchant à reconstruire la chronologie des événements et le visage de son agresseur, elle doit naviguer entre souvenirs fuyants et amnésie momentanée."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "La nuit du 4 au 5"
      }
    ]
  },
