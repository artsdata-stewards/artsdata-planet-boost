      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/155779/1968-1969_Tango_101d7b8599c0cc599ee16e9637ccc19e.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Tango | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Un adolescent révolté impose à ses parents, progressistes désenchantés, un brutal retour aux bonnes vieilles conventions bourgeoises. À la fois satire antibourgeoise et farce anti-stalinienne, c'est-à-dire en phase totale avec l'esprit de l'immédiat pré-soixante-huit, la pièce vaudra à son auteur son premier grand succès international."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/tango"
      }
    ],
