  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/queue-cerise/#webpage",
    "@type": [
      "http://schema.org/WebPage"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/queue-cerise"
      }
    ],
    "http://schema.org/about": [
