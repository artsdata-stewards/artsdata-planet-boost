  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/my-name-is-jean-paul/#webpage",
    "@type": [
      "http://schema.org/WebPage"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/my-name-is-jean-paul"
      }
    ],
    "http://schema.org/about": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/#identity"
      }
    ],
    "http://schema.org/isPartOf": [
