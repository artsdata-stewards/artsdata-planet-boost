    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/21"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Le 21, c’est d’abord un jeu de basketball auquel Zoé et Sara s’adonnent chaque semaine. Alors que Zoé vient d’être placée dans le centre jeunesse où Sara est intervenante, il devient vite un terrain d’échanges où se noue entre elles un lien affectif sincère. Telle une partition de musique minutieusement orchestrée, les révélations fusent et dressent le portrait de deux personnages en quête de reconnaissance."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "21"
      }
    ]
  },
