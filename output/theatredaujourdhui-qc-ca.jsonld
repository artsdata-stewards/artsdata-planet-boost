  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/as-is-tel-quel/#webpage",
    "@type": [
      "http://schema.org/WebPage"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/as-is-tel-quel"
      }
    ],
    "http://schema.org/about": [
