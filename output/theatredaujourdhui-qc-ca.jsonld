      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Dédé essaie de recréer mentalement, dans un art absolument ridicule, celui de la mode, quelque chose qui lui échappe et qu'il ne peut changer. Il est floué."
      }
    ],
    "http://ogp.me/ns#url": [
