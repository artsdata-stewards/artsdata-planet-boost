      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/mon-corps-ebloui-debout"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "La poésie d’Émilie Turmel sonde la transmission entre femmes à travers différentes perspectives : l’engourdissement et l’enfermement du corps des jeunes filles (Casse-gueules), le legs de la douleur qui se transmet entre mère et son enfant (Vanités) et la mémoire séculaire des femmes à travers les gestes répétés de l’amour (Berceuses). "
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Mon corps ébloui, debout"
      }
    ]
  },
