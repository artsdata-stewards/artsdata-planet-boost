  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/diguidi-diguidi-ha-ha-ha",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/155797/1969-1970_Diguidi_101d7b8599c0cc599ee16e9637ccc19e.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Diguidi diguidi Ha! Ha! Ha!  | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Ce texte dramatique exorcise les atavismes familiaux et culturels canadiens-français et constitue une sorte de manifeste théâtral : les membres d’une famille nucléaire — le Père, la Mère, le Fils — se débattent avec leurs réflexes de colonisés et exposent crûment les turpitudes de leur réalité aliénée."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/diguidi-diguidi-ha-ha-ha"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
