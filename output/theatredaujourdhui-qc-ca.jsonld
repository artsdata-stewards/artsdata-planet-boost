    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Bacchanale. Six femmes serveuses dans un vaste bar montréalais. Un antre de libations.Six femmes qui représentent chacune une tranche d’âge, une posture, une révolte.Six cris, puis un seul, celui de la bacchanale."
      }
    ],
