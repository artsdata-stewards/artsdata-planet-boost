      {
        "@language": "en",
        "@value": "Ce que nous avons fait | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Ce que nous avons fait n’est pas une pièce, c’est une répétition. C’est un « théâtre-vérité » qui explore la relation entre des parents et leur fille schizophrène. C’est une boucle aliénante qui se referme lentement sur une famille traversée par la folie."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/ce-que-nous-avons-fait"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/centre-dachats",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/167096/2018-2019_Centre-d_achats_101d7b8599c0cc599ee16e9637ccc19e.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Centre d'achats | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Chercher, encore et toujours : le t-shirt, les boucles d’oreilles, le chien, le lapin, le serpent, le tapis volant... Venues pour magasiner en toute tranquillité, sept femmes sautent dans le tourbillon dévastateur de la consommation outrancière et irréfléchie avec candeur et acharnement. Telles sept prisonnières partageant une même cellule, chacune d’elles se heurte aux barreaux inflexibles de son destin."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/centre-dachats"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
