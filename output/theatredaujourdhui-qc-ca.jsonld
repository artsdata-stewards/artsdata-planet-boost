  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/pisserdebout",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/235840/1200x1200_Pisserdebout_D_101d7b8599c0cc599ee16e9637ccc19e.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Pisser debout sans lever sa jupe | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Depuis l’enfance, Olivier Arteau ressent un profond malaise quant à sa façon de se mouvoir quand il est heureux, se jugeant trop féminin et enfantin. Qu’est-ce qui a influencé sa manière d’être dans l’espace? Pourquoi adhère-t-il à la convention voulant que le féminin mine le masculin? Qui dicte nos choix? Qui a réellement le contrôle sur ce que nous sommes?"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/pisserdebout"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
