  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/corps-celestes",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/167652/2019-2020_Corps-celestes_101d7b8599c0cc599ee16e9637ccc19e.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Corps célestes | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Dans un futur aux allures de dystopie, une guerre pour le pétrole fait rage. Alors que la menace d’une marée humaine venue du Nord gronde, Lili  retourne dans sa maison natale. Après quinze ans d’absence et une carrière de réalisatrice de films pornographiques, elle y retrouve sa mère, sa sœur ainée, l’un de ses anciens amants et son neveu Isaac, adolescent à la lucidité exacerbée."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/corps-celestes"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/corpstitan",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/234968/1200x1200_Corpstitan_D_f1b8dbfc55b55f2cd8390ed789b9edc5.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Corps titan (titre de survie) | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Le 28 mai 2013, alors qu’elle se rend à vélo à une répétition de théâtre, Audrey Talbot est frappée par un camion poids lourd. Son corps est broyé en une fraction de seconde, mais elle survit grâce à une suite miraculeuse de circonstances et un travail acharné. Entourée d’une distribution chorale de grand talent, elle revient sur son périple surréel vers la renaissance."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/corpstitan"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
