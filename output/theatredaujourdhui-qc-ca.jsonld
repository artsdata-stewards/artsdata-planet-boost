  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/viqueens-saga-nordique/#webpage",
    "@type": [
      "http://schema.org/WebPage"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/viqueens-saga-nordique"
      }
    ],
    "http://schema.org/about": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/#identity"
      }
    ],
    "http://schema.org/isPartOf": [
      {
