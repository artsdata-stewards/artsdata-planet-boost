        "@id": "https://theatredaujourdhui.qc.ca/#logo"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/chiennes"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "La Trentenaire a la chienne. En termes élégants, elle souffre d’anxiété. Elle est brillante, drôle, cultivée et capable, mais sa vie se fissure à haute vitesse. Elle a la chienne, mais elle ne sait pas pourquoi. Et surtout, elle ne sait pas si elle en a le droit. Elle se concentre sur sa respiration, brasse les ombres, cherche la lumière. Elle semble immobile, et pourtant elle avance, révélant l’ampleur de sa résistance face au monde."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Chienne(s)"
      }
    ]
  },
