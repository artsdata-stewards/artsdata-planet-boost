  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/akuteu",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/238152/1200x1200_Akuteu-D_101d7b8599c0cc599ee16e9637ccc19e.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Akuteu | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Explorant la métaphore de l’animal suspendu que l’on saigne, Soleil Launière fait état du vide et du vertige d’être constamment en suspension entre deux eaux, deux cultures, entre la honte et la fierté, entre les mondes du visible et de l’invisible. À travers des fragments de récits personnels et poétiques, elle partage sa perspective de femme innue qui se fond dans une société majoritairement blanche et questionne les contradictions qui forgent son identité, sa légitimité à prendre la parole au nom des siens et la délicate responsabilité qui en découle."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/akuteu"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
