      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Les histoires de partir | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Qu’arrive-t-il lorsque l’on débarque sur une nouvelle terre? Comment se passe ce moment de nouveauté? Comment négocie-t-on son intégration ou non? Comment se sent-on lorsque l'on est étranger, jusqu’à quel moment se sent-on étranger?"
      }
    ],
    "http://ogp.me/ns#url": [
