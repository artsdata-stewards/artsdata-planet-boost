      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "L’auteur David Paquet, seul en scène, offre à son public complice une soirée de chaleur et de connivence sous la forme d’un stand-up poétique qui dénonce, questionne, examine et plonge le spectateur dans un univers fantaisiste et surréel."
      }
    ],
    "http://ogp.me/ns#url": [
