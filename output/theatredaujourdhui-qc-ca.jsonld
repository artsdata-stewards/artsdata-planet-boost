    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Satire de la justice, de l'histoire, du théâtre, de l'actualité, sous la forme d'une plaidoirie faite par des acteurs-avocats, pendant un procès qui est d'abord un spectacle, devant un juge qui est surtout un banc !"
