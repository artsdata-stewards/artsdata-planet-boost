  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/bashir-lazhar-2",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/402154/Bashir_6328ea5c3df1440557be68a93fab3d95.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Bashir Lazhar | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Bashir Lazhar retrace le parcours d’un immigrant nouvellement arrivé au Québec, qui remplace au pied levé une institutrice qui s’est suicidée dans l’enceinte de l’école. La personnalité de Bashir et ses initiatives pédagogiques se heurtent à la frilosité et à l’incompréhension de ses pairs et des parents d’élèves. Les préjugés latents font surface et révèlent le choc provoqué par la rencontre des cultures."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/bashir-lazhar-2"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
  {
