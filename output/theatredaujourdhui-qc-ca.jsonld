        "@id": "https://theatredaujourdhui.qc.ca/#logo"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/assoiffes"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Assoiffés, c’est l’histoire de deux adolescents, un gars et une fille, Murdoch et Norvège, un qui décide de tout dire et l’autre qui se tait, un qui se fait entendre et l’autre qui se cache. C’est aussi l’histoire de Boon, anthropologue judiciaire, qui à travers ces deux personnages replonge dans sa propre adolescence et retrouve ses rêves abandonnés."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Assoiffés"
      }
    ]
  },
