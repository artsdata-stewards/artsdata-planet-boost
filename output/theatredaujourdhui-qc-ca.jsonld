  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/equinoxe/#webpage",
    "@type": [
      "http://schema.org/WebPage"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/equinoxe"
      }
    ],
    "http://schema.org/about": [
