      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Déterrer les os | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Déterrer les os est une plongée en huis clos entre la narratrice et son corps fautif, ce corps qui déborde et réclame toujours davantage. Ce corps qu’elle rejette, qui est en fait un scaphandre, une cage qu'il faut détruire en secret. Elle s’épuise à le corriger, le nourrir, le vider, le confronter."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
