  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/traversee/#webpage",
    "@type": [
      "http://schema.org/WebPage"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/traversee"
      }
    ],
    "http://schema.org/about": [
