      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/les-hardings"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Un cheminot québécois, un chercheur néo-zélandais et un assureur américain spécialisé dans les compagnies pétrolières portent le même nom : Thomas Harding. En apparence, ils n’ont rien d’autre en commun. Jusqu’au 6 juillet 2013. Cette nuit- là, un train qui déraille fait exploser une ville. Apparaissent alors au grand jour les rails invisibles qui relient leurs existences et les attachent les unes aux autres."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Les Hardings"
      }
    ]
  },
