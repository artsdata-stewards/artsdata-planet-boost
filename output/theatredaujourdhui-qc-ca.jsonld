  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/tout-est-encore-possible",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/163583/2009-2010_Tout-est-encore-possible_101d7b8599c0cc599ee16e9637ccc19e.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Tout est encore possible | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Quatre personnages : une femme blanche, un homme noir, un jeune homme bleu et sa mère. Quatre lieux : un dispensaire dans la jungle, un cabinet de psychanalyste, un appartement montréalais et une terrasse de café. En toile de fond, la mère, les peines d'amour et l'Afrique. Chaque personnage se présente avec une histoire impossible à croire dans un univers où, vraisemblablement, tout est encore possible. Cette série de récits architecturés sous forme de pièce trouvera son point culminant entre une femme blanche et un homme noir que seule l'écriture peut inventer."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/tout-est-encore-possible"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
