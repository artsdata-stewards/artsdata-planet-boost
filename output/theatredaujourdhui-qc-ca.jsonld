      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/m-i-l-f"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Trois femmes, trois mères, trois sexualités, trois voix qui s'entrecroisent : une M.I.L.F. (Mother I'd Like to Fuck), une M.I.L.S. (Mother I'd Like to Save) et une M.I.L.K. (Mother I'd Like to Kill). Trois personnages sans autre fil narratif que leurs expériences, leurs échecs, leurs réussites et leur émancipation. Un regard acide, poétique et engagé qui aborde sans tabous maternité et sexualité."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "M.I.L.F."
      }
    ]
  },
