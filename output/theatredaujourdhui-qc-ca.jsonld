  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/la-nuit-du-4-au-5",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/402191/Nuit4-5_101d7b8599c0cc599ee16e9637ccc19e.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "La nuit du 4 au 5 | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Une femme a été agressée. Elle s’est débattue. Elle a crié et ce cri salvateur, réveillant ses voisins et mettant en fuite son agresseur, fait ressurgir toute la vie qui résiste en elle. Mais depuis, sa mémoire lui joue des tours. Cherchant à reconstruire la chronologie des événements et le visage de son agresseur, elle doit naviguer entre souvenirs fuyants et amnésie momentanée."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/la-nuit-du-4-au-5"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
