    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Véritable autopsie de la nature humaine, Après raconte le séjour à l’hôpital d’un ingénieur accusé du meurtre de ses deux jeunes enfants. L’attente de son procès se fait dans un isolement presque total, interrompu uniquement par les visites de son infirmière."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Après"
