      }
    ],
    "http://schema.org/primaryImageOfPage": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/#logo"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/pisserdebout"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Depuis l’enfance, Olivier Arteau ressent un profond malaise quant à sa façon de se mouvoir quand il est heureux, se jugeant trop féminin et enfantin. Qu’est-ce qui a influencé sa manière d’être dans l’espace? Pourquoi adhère-t-il à la convention voulant que le féminin mine le masculin? Qui dicte nos choix? Qui a réellement le contrôle sur ce que nous sommes?"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Pisser debout sans lever sa jupe"
      }
    ]
  },
