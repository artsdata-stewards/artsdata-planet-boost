  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/anky-ou-la-fuite",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/162011/2008-2009_Anky_101d7b8599c0cc599ee16e9637ccc19e.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Anky ou La fuite | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Combien de voix intérieures possède un individu? Combien en faut-il pour faire une personne à part entière, un être humain complet, complexe, luttant de son mieux pour trouver en lui-même une certaine unanimité? Dans le tumulte de questions soulevées par le monde déshumanisé dans lequel nous vivons, Anky voudrait mettre ses pensées au diapason, faire chanter en chœur des sentiments contradictoires. Tirer une certaine harmonie de son désordre le plus intime."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/anky-ou-la-fuite"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
