    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/seeker"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "2250, Colorado. Lomond est un Seeker : à la suite d’une mutation génétique, il a la capacité de voir, de ressentir et de partager les souvenirs des autres. Convoqué par l’armée dans le cadre d’une mission spéciale dont il ignore encore l’ampleur, il se retrouve confronté à son ex-femme. Aux prises avec l’une des énigmes les plus complexes de sa carrière, il livre un combat acharné pour mettre à jour une vérité ayant des conséquences sur l’humanité tout entière."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Seeker"
      }
    ]
  },
