  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/la-vague-parfaite-un-opera-surf/#webpage",
    "@type": [
      "http://schema.org/WebPage"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/la-vague-parfaite-un-opera-surf"
      }
    ],
    "http://schema.org/about": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/#identity"
      }
    ],
    "http://schema.org/isPartOf": [
      {
