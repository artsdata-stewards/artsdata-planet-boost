  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/la-pudeur-des-urinoirs",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/242028/pudeur-des-urinoirs_cee8e1018e34884801a77d784906e809.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "La pudeur des urinoirs | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Dans la vitrine du théâtre rue Saint-Denis, les artistes pluridisciplinaires Olivier Arteau et Fabien Piché ne peuvent se dérober à la vue des passant·es et sont soumis au regard du public via une diffusion en direct. Ils mettent à l’épreuve leurs limites physiques et psychologiques dans un essai performatif de longue durée qui explore les différents états du corps. Au cours de deux cycles de plusieurs jours, ils se confinent à deux lieux de vie distincts : un tapis roulant et un casier."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/la-pudeur-des-urinoirs"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
