  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/zaman-ou-on-a-le-meme-temps-quon-avait",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/468507/359_054_zaman_Portraits_960x1200_v1_101d7b8599c0cc599ee16e9637ccc19e.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Zamân ou on a le même temps qu'on avait | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Zamân [zamɔn], c’est le « temps » en farsi, en hébreu, en arabe et probablement dans une foule d’autres langues. C’est aussi un spectacle de Mani Soleymanlou qui se joue autour de ce moment très précis où tombe le diagnostic de sa mère : tumeurs au cerveau. Le temps s’étire autant qu’il fait des bonds, oscillant entre les souvenirs du cancer qu’il a lui-même traversé et ses réflexions sur la famille et notre perception de la durée, dans un monde en perpétuelle accélération."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/zaman-ou-on-a-le-meme-temps-quon-avait"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
