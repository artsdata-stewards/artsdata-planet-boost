    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/equinoxe"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/equinoxe"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Un soir de septembre, après une longue absence, les membres d’une troupe de théâtre se retrouvent. Ils auront douze heures, du crépuscule à l’aube, pour décider s’ils rejoueront ensemble. Une nuit comme une ultime épreuve dans laquelle s’engouffrent tous les questionnements sur la loyauté envers le groupe et envers soi-même, les promesses du futur, le sens de faire du théâtre et de le faire ensemble. Le groupe va risquer de se perdre pour, peut-être, mieux se retrouver."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Équinoxe"
      }
    ],
