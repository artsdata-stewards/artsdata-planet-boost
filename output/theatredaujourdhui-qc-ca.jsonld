  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/marguerite-la-pierre/#webpage",
    "@type": [
      "http://schema.org/WebPage"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/marguerite-la-pierre"
