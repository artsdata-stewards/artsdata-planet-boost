        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/mommy-le-retour",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/1121219/359_064_PortraitSansTexte_MommyLeRetour_960x1200_VF_fa78b7501b6429c2bcf0acba2cc21fe0.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Mommy, le retour | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "​​Ressuscitée d’entre les morts, Mommy revient hanter le Québec pour se venger des vivants. Horrifiée par le monde actuel, cette grand-mère rêve de le ramener dans le droit chemin en restaurant sa grandeur passée. Pour y parvenir, elle transforme ses opposants idéologiques en zombies, les enrôlant dans un projet de société proprement fasciste. Tour à tour martyre, tyran et pop star, Mommy se métamorphose pour séduire les foules et prendre le pouvoir."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/mommy-le-retour"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
