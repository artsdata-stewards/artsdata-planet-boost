    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Le brasier | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Avec Le brasier, David Paquet nous arrache le rire comme on nous arracherait une dent. Dans cette pièce magnifiquement construite, l’auteur s’attaque à notre conscience collective défaillante et l’immobilisme qui en résulte, mélangeant humanité et franchise avec le superbe sens de la formule qu’on lui connait."
      }
    ],
    "http://ogp.me/ns#url": [
