  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/les-audaces-de-marcelle-dubois",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/985232/CTDA2025-03-15_web_credMaryseBoyce_6178_101d7b8599c0cc599ee16e9637ccc19e.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Les audaces de Marcelle Dubois | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Le 15 novembre, le hall du CTD’A s’illumine pour célébrer une femme dont la passion a façonné tout un pan du théâtre contemporain : Marcelle Dubois. Fondatrice visionnaire du Jamais Lu, elle a ouvert la voie à une génération d’auteurs et d'autrices, d’idées, de joie et d’inclusion radicale. Cette soirée rend hommage à 25 ans de passion et d’audace au service de la dramaturgie, à travers lectures, prises de parole et clins d’œil complices."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/les-audaces-de-marcelle-dubois"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
