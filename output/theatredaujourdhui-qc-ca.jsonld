      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Le 6 décembre 1989, Fanny Britt avait douze ans. Elle participait à un concert de Noël avec sa chorale, un chœur de filles qui quelques années plus tôt avait compté dans ses rangs une des quatorze jeunes femmes qui se ferait assassiner ce soir-là à l'École Polytechnique."
      }
    ],
