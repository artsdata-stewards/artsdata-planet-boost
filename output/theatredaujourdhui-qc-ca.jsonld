      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/parler-mal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Garder le silence par peur du jugement lié à sa façon de parler est une réalité plus commune qu’on pense. À travers une série de tableaux inspirés de leurs expériences personnelles, d’histoires récoltées sur le terrain et de discussions avec des spécialistes, un acadien et une acadienne confrontent avec humour – mais non sans une certaine douleur – les préjugés liés à leur manière de s’exprimer. Ils ouvrent un dialogue sur les stigmates qu’on entretient à l’égard de la langue, bien déterminés à faire face à leurs malaises linguistiques et à s’en affranchir."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Parler mal"
      }
    ]
  },
