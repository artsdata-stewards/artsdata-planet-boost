    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/ici-par-hasard"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Olga, Macha et André se retrouvent au chalet familial pour disperser les cendres de leur sœur, Irène. Mais un coup de vent change tout : au lieu de s’envoler paisiblement, les cendres atterrissent… dans la bay-window-qui-a-coûté-vraiment-cher-aux-parents. Et la surprise ne s’arrête pas là : Irène refait soudainement surface d’entre les morts, ravie de les retrouver."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Ici par hasard"
      }
    ]
  },
