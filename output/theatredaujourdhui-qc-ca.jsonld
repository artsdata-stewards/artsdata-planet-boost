    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/larchitecte-et-lempereur-dassyrie"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Au delà d'une rencontre entre un homme sauvage et un empereur d'Orient réduits à co-exister sur une île déserte, au delà d'un simple rapport maître-esclave, Arrabal nous entraîne dans un tourbillon de jeux d'enfants et de jeux de vérité pour mettre sous l'objectif de son microscope les faux rapports à la civilisation, les faux-semblants de la société, le tragique de leur passé. "
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "L’architecte et l’empereur d’Assyrie"
      }
    ]
  },
