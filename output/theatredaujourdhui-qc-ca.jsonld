  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/les-tourtereaux-ou-la-vieillesse-frappe-a-laube/#webpage",
    "@type": [
      "http://schema.org/WebPage"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/les-tourtereaux-ou-la-vieillesse-frappe-a-laube"
      }
    ],
    "http://schema.org/about": [
