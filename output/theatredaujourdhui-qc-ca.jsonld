    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/encore-une-fois-si-vous-permettez"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Cette pièce à saveur autobiographique se veut un hommage de l'auteur à sa mère, sa première inspiratrice. Du rire aux larmes, impudique et le verbe haut, le dialogue entre Nana et le narrateur évoque les disputes et les réconciliations, les fous rires et l'amour du théâtre et de la vie."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Encore une fois, si vous permettez"
      }
    ]
  },
