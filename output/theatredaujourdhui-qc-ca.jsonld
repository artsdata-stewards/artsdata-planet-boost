  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/les-audaces-de-marcelle-dubois/#webpage",
    "@type": [
      "http://schema.org/WebPage"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/les-audaces-de-marcelle-dubois"
      }
    ],
    "http://schema.org/about": [
