    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/161755/2007-2008_Glouglou_101d7b8599c0cc599ee16e9637ccc19e.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Glouglou | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Un spectacle plein de cachettes, ponctué de premières fois. De coucous et de glouglous ! Deux tout-petits, un papa, une maman, une maison, les saisons, les rêves, les odeurs et les sons. Quelques larmes et beaucoup de rires. Une histoire qui goute bon. Qui se raconte tout en douceur, comme une berceuse."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/glouglou"
      }
    ],
