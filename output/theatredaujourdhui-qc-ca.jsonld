  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/magna-mater/#webpage",
    "@type": [
      "http://schema.org/WebPage"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/magna-mater"
      }
    ],
    "http://schema.org/about": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/#identity"
      }
    ],
    "http://schema.org/isPartOf": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/#website"
      }
    ],
    "http://schema.org/potentialAction": [
      {
        "@id": "_:g5552980"
      }
    ],
    "http://schema.org/primaryImageOfPage": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/#logo"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/magna-mater"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Un être humain émerge d’un bassin d’eau laiteuse sur une île hors du temps. Guidé par une figure féminine énigmatique, ce corps encore étranger à notre réalité entreprend une quête jalonnée d’épreuves pour apprivoiser sa forme physique. Chaque étape de ce rite de passage transformera sa chair et sa perception afin de lui permettre d’enfin franchir le seuil de l’existence. "
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Magna Mater"
      }
    ]
  },
