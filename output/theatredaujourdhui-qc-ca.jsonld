  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/cyclorama",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/234588/1200x1200_Cyclorama_D_101d7b8599c0cc599ee16e9637ccc19e.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Cyclorama | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Laurence Dauphinais est une créatrice québécoise francophone. Travaillant régulièrement avec des artistes anglophones, elle se questionne : pourquoi les deux communautés artistiques semblent-elles tout ignorer l’une de l’autre ? Avec l’aide de collaborateurs et collaboratrices des deux côtés de la barrière linguistique et suivant un protocole de recherche minutieux, elle plonge dans l’histoire du théâtre montréalais pour faire la lumière sur les récits qui nous ont tissé·es."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/cyclorama"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
