  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/apres",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/165844/2015-2016_Apres_101d7b8599c0cc599ee16e9637ccc19e.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Après | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Véritable autopsie de la nature humaine, Après raconte le séjour à l’hôpital d’un ingénieur accusé du meurtre de ses deux jeunes enfants. L’attente de son procès se fait dans un isolement presque total, interrompu uniquement par les visites de son infirmière."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/apres"
      }
    ],
