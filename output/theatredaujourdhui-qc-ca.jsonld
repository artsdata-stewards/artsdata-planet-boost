    "@id": "https://theatredaujourdhui.qc.ca/spectacles/moinssouvent",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/236119/1200x1200_moinssouvent_D_101d7b8599c0cc599ee16e9637ccc19e.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Je viendrai moins souvent | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Camille a 22 ans quand elle emménage à Montréal. Sa grand-mère Pauline en a 92 quand elle rentre en CHSLD. Chacune vit parallèlement un déracinement, une perte de repères. Poussée par une intuition, Camille enregistre ses visites et collecte les paroles de Pauline. Pendant près de quatre ans, les deux femmes apprivoisent ensemble l’inévitable au rythme des jours, des oublis, de l’effritement et des retrouvailles quotidiennes."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/moinssouvent"
      }
    ],
    "http://ogp.me/ns#site_name": [
