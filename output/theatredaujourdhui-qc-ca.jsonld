      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Une ménagère du Plateau Mont-Royal gagne un million de timbres-primes et voit du coup sa vie complètement bouleversée. Elle invite ses sœurs et ses voisines à une veillée de collage… MUSICALE !"
      }
