  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/la-ou-la-poussiere-se-depose",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/468783/359_054_la-ou-la-poussiere-se-depose_Portraits_960x1200_v2_01_b8d6f6f5fb16eddfc38ee515820d16a0.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Là où la poussière se dépose | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "La maison est un refuge, un endroit empli de vides et de pleins, où les liens se tissent et parfois se défont. Dans un écrin scénique reproduisant les qualités d’écoute d’un studio d’enregistrement, le public est convié à traverser une maison intériorisée. Nous ne sommes pas témoins de la rupture traditionnelle d’un couple, d’une famille, d’un foyer, mais plutôt de la façon dont nos maisons se transforment après une séparation. La maison devient le théâtre de l’effritement d’un vivre-ensemble qui nécessite d’être repensé, où chaque détail raconte une histoire."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/la-ou-la-poussiere-se-depose"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
