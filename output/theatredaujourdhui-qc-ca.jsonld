    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Avec un un arrière-fond des plus féroces, cette pièce jubilatoire et inventive met en scène deux personnages secondaires d’Hamlet de Shakespeare et leur fait vivre le drame d'Elsener. "
      }
    ],
    "http://schema.org/name": [
