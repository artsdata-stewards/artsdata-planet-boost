      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Rodéo, le héros de St-Lien, a construit le cheval de 25 pieds qui trône au village. Juliette cherche un homme, un héros. A travers eux, l'histoire d'un village qui est pour, par et autour d'un festival western qui dure quelques jours par année."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Rodéo et Juliette"
      }
    ]
