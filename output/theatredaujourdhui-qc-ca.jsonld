      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/la-demagogie-des-dragons"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Élevés au Québec sans autre connexion avec leur héritage culturel que leur amour des phở et des bánh mìs, deux artistes québécois entreprennent un voyage aussi réel que loufoque vers leurs racines vietnamiennes. À travers un périple qui les mène du quartier chinois de Montréal jusqu'aux rues animées de Hanoï, ils remettent en question cette tendance qui pousse les artistes minorisés à décortiquer leur identité sur scène."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "La démagogie des dragons"
      }
    ]
  },
