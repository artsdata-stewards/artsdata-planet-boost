  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/madame-louis-xiv",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/158318/1988-1989_Madame-Louis-XIV_101d7b8599c0cc599ee16e9637ccc19e.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Madame Louis XIV | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Pour le bonheur de tous les amateurs de théâtre, Lorraine Pintal redevient Madame Louis 14, le temps de 20 représentations au Théâtre d’Aujourd’hui. Un prodigieux exploit, un grand moment d'intelligence accueilli par la critique et le public avec un cortège d’éloges. Lorraine Pintal assure la conception, l’écriture, la mise en scène et l'interprétation de ce «solo historique» qui vibre de résonances bien contemporaines."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/madame-louis-xiv"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/made-in-beautiful",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/167724/2019-2020_Made-in-beautiful_101d7b8599c0cc599ee16e9637ccc19e.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Made in Beautiful | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Chaque année à l’Halloween, Linda réunit sa famille. Chaque année, les rivalités familiales et l’actualité viennent immanquablement enflammer les échanges. Mais une tradition est une tradition et la famille, aussi dysfonctionnelle soit-elle, reste la famille. Pendant 25 ans, Linda s’entête à rassembler ses proches et nous offre ainsi une succession de tableaux passant en revue les grands bouleversements nationaux et internationaux et leurs effets."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/made-in-beautiful"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
