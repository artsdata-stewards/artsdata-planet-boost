  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/provincetown-playhouse-juillet-1919-javais-19-ans/#webpage",
    "@type": [
      "http://schema.org/WebPage"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/provincetown-playhouse-juillet-1919-javais-19-ans"
      }
    ],
    "http://schema.org/about": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/#identity"
      }
    ],
    "http://schema.org/isPartOf": [
      {
