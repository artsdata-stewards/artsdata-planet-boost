      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/mommy-le-retour"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "​​Ressuscitée d’entre les morts, Mommy revient hanter le Québec pour se venger des vivants. Horrifiée par le monde actuel, cette grand-mère rêve de le ramener dans le droit chemin en restaurant sa grandeur passée. Pour y parvenir, elle transforme ses opposants idéologiques en zombies, les enrôlant dans un projet de société proprement fasciste. Tour à tour martyre, tyran et pop star, Mommy se métamorphose pour séduire les foules et prendre le pouvoir."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Mommy, le retour"
      }
    ]
  },
