  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/judy",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/148615/Judy_4x5_2e99a5d90ac03df7a50077a76b307de1.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Judy | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Six personnages aux prises avec les défis du monde contemporain voient leurs certitudes s’effriter au contact de l’œuvre révolutionnaire de l’artiste visuelle Judy Chicago. Alors qu’ils sont confrontés à des conflits intérieurs et des interrogations sur leur place dans la société, cette figure marquante de l’art et du féminisme devient le catalyseur de leur métamorphose, les poussant à remettre en question leur propre identité et leurs convictions profondément enracinées."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/judy"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
