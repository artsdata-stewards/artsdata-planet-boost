      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Le testament des célébrités | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Pièce de théâtre satirique de Jon Lachlan Stewart, mise en scène par Olivier Morin, sur la célébrité : trois ex-enfants stars relancent une saga après un attentat aux Oscars, au CTD’A à Montréal."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
