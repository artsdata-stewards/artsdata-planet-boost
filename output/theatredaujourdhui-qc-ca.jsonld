      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/pacificpalisades"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "En 2015, Jeffrey Alan Lash, qui prétend être mi-homme mi-extraterrestre et travailler pour les services secrets américains, est retrouvé mort dans sa voiture. Des millions de dollars en armes, munitions et argent comptant sont découverts dans son garage. Fasciné par ce fait divers incongru, un homme prend l’avion pour Los Angeles afin d’enquêter sur cet individu mystérieux. En croisant sur son chemin de nombreuses figures ayant gravité autour de Lash, il découvre progressivement les multiples identités de l’intrigant fabulateur."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Pacific Palisades"
      }
    ]
  },
