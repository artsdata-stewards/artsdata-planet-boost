    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "L’école des rêves fait revivre Épisode Surprenant et Berthelot Petitboire, les deux comédiens ambulants d’Un pays dont la devise est : je m’oublie qui, après avoir parcouru les trente arpents d’un je-me-souviens hypothétique, s’enfoncent maintenant dans l'arrière-pays des chemins en terre et des salle paroissiales à moitié-vides."
      }
    ],
