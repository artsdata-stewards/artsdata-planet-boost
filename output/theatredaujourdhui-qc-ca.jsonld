      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/167211/2018-2019_ColoniseEs_101d7b8599c0cc599ee16e9637ccc19e.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "ColoniséEs | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Pauline Julien, Gérald Godin, une révolution (tranquille), un mois d’octobre (historique) et des promesses (avortées). ColoniséEs, c’est l’histoire qui se parle à elle-même, l’incarnation de nos préoccupations d’hier, d’aujourd’hui et de demain. C’est aussi la parole d’un Québec actuel, inquiet, hésitant mais résilient."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/colonisees"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
