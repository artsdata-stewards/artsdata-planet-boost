      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Récit poétique, Les cendres bleues est l’œuvre d’une nécessité. Un geste de survie. De cette prenante histoire, celle d’un garçon de six ans et demi amoureux d’un jeune homme de vingt ans, naît une beauté sublime et complexe."
      }
    ],
