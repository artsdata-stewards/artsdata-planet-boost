  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/nassara",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/237612/1200x1200_nassara_D_101d7b8599c0cc599ee16e9637ccc19e.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Nassara | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Ouagadougou, Burkina Faso. Marie-Odile est venue de Montréal pour participer à un colloque international sur l'agriculture urbaine. Assise parmi une dizaine d’intervenantes et d'invervenants africains et européens, elle n’arrive pas à rassembler ses idées, bouleversée par un incident étrange survenu la veille et qui a réveillé en elle des douleurs enfouies. Son tour de parole venu, alors qu’elle s’apprête à laisser éclater son trouble, la porte de la salle s’ouvre brusquement et tout bascule."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/nassara"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/neige-sur-abidjan",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/658986/359_054_neige-sur-abidjan_Portraits_960x1200_v2_01_101d7b8599c0cc599ee16e9637ccc19e.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Neige sur Abidjan | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Un Fils et un Père se retrouvent après plus de deux décennies de séparation et de correspondance. À ces deux êtres que tout éloigne, mais qui sont pourtant liés l’un à l’autre, s’ajoute la figure du Griot, gardien de la mémoire de plusieurs générations de leur lignée familiale. Ce dernier invite le Fils à expérimenter un nouveau rapport au monde en venant jouer et interroger ses souvenirs et sa perception de la réalité."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/neige-sur-abidjan"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/neuf-titre-provisoire",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
