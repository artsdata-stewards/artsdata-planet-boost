      }
    ],
    "http://schema.org/potentialAction": [
      {
        "@id": "_:g6411180"
      }
    ],
    "http://schema.org/primaryImageOfPage": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/#logo"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/queue-cerise"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Queue cerise raconte l’étrange histoire de Michelle, une jeune femme qui commence un nouvel emploi auquel elle ne comprend rien du tout. D’ailleurs, personne parmi ses nouveaux collègues ne semble disposé à intervenir pour lui venir en aide. Michelle développe une relation secrète avec le sous-sol du bureau, un espace envoutant duquel on lui avait pourtant dit de se méfier. Ce sous-sol déclenche une métamorphose de son corps mais aussi celle du monde qui l’entoure."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Queue cerise"
      }
    ]
  },
