    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Lequel est un Basquiat | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Samy est un jeune grapheur montréalais d’origine haïtienne dont la marque de fabrique est de laisser sa trace là où des personnes noires ont contribué à l’histoire de la ville. Rapidement, son talent est repéré et une somme colossale lui est proposée pour devenir un faussaire de Jean-Michel Basquiat. Mais pour faire un Basquiat, il faut être un Basquiat. Plus Samy s’immerge dans l’univers déchiré du peintre, plus il perd les fragiles repères de sa personnalité. Deviendra-t-il un Basquiat ? Et à quel prix ?"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/basquiat"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
