    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Le Pool, Blaise Cendrars, Beethoven et le bonheur sont ici chez eux. Pour une fête comme il ne s'en fait plus beaucoup."
      }
    ],
    "http://ogp.me/ns#url": [
