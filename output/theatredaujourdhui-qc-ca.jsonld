      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/mutantes"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Une horde d’étudiants et d’étudiantes, désormais dans la quarantaine, retourne sur les bancs d’école. Sans maître ni modèle, ils sont livrés à eux-mêmes. Dans des tableaux ludiques aux formes diverses, ils et elles doivent relever une série d’épreuves pour tenter, ensemble, de réussir leur graduation. Les mutant·es redoublent de créativité, cherchent les chemins de traverse, les options pérennes et, déjà, se questionnent sur le legs de leur génération. Qu’ont-ils pris au monde? Que lui ont-ils donné? Et surtout, que leur reste-t-il, désormais?"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Les mutant·es"
      }
    ]
  },
  {
    "@id": "_:g5821020",
