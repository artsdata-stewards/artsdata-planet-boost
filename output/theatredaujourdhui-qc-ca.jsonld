  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/une-fin",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/470732/359_054_une-fin_Portraits_960x1200_v2_01_101d7b8599c0cc599ee16e9637ccc19e.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Une fin | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Le soleil est en constante expansion. Vraisemblablement, tout brûlera. Il reste un mois ou peut-être deux. La fin est inéluctable et touchera tout le monde. Une galerie de personnages se déploie, dépeignant une humanité confrontée à ses derniers instants. Ici, nulle tentative d’échapper à son destin. Pas de héros, seulement des êtres ordinaires. Les protagonistes se confrontent à leurs peurs, se livrent à leurs pulsions de vie, révélant toute la complexité de l’expérience humaine et des liens qui nous unissent."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/une-fin"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
