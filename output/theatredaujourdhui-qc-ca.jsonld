  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/parler-mal",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/468796/359_054_parler-mal_Portraits_960x1200_v2_01_101d7b8599c0cc599ee16e9637ccc19e.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Parler mal | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Garder le silence par peur du jugement lié à sa façon de parler est une réalité plus commune qu’on pense. À travers une série de tableaux inspirés de leurs expériences personnelles, d’histoires récoltées sur le terrain et de discussions avec des spécialistes, un acadien et une acadienne confrontent avec humour – mais non sans une certaine douleur – les préjugés liés à leur manière de s’exprimer. Ils ouvrent un dialogue sur les stigmates qu’on entretient à l’égard de la langue, bien déterminés à faire face à leurs malaises linguistiques et à s’en affranchir."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/parler-mal"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/pas-perdus",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/237835/1200x1200_pasperdus_quentin_d_101d7b8599c0cc599ee16e9637ccc19e.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Pas perdus | documentaires scéniques | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Sur scène, une série de courts portraits. Huit protagonistes choisis pour leur vie singulière et la façon surprenante qu’ils et elles ont de se raconter. Des individus aux parcours très différents (aucun n’est un acteur) entre lesquels se tissent une multitude de liens. Leurs voix, captées sur le vif, magnifiées par un traitement sonore enveloppant et doublées de leur présence sur scène, préservent toute la force et l’authenticité d’une parole spontanée qui ne se rejoue pas."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/pas-perdus"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
