    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/aujourdhui-le-black-theatre-workshop-passe-a-lhistoire"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Pour la 50e saison du Centre du Théâtre d’Aujourd’hui, le directeur artistique Sylvain Bélanger a invité 3 artistes pour 3 soirées uniques intitulées Aujourd’hui je passe à l’Histoire!. À chacun, la même question: « qu’est ce que vous ne pouvez faire qu’une seule fois devant le public? ». Une série d’évènements exceptionnels qui célébre l’éphémère et le partage propre à la représentation de théâtre. Rendez-vous en décembre avec le Black Theatre Workshop!"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Aujourd'hui, le Black Theatre Workshop passe à l'histoire!"
      }
    ]
  },
