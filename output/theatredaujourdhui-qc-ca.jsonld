  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/les-tourtereaux-ou-la-vieillesse-frappe-a-laube",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/156031/1972-1973_Les-tourtereaux_101d7b8599c0cc599ee16e9637ccc19e.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Les tourtereaux ou la vieillesse frappe à l’aube | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Héritiers d'une interminable lignée de couples radiophoniques, Gaspard et Ginette, les deux animateurs des Tourtereaux, sont vieux. Célèbres il y a vingt ans, ils s'évertuent encore aujourd'hui à jouer sur les ondes le grand rôle de leur petite vie. Condamnés au silence endormi de leur public et aveuglés par leur propre mensonge, les animateurs déballent tous les clichés qui sont le lot de la culture officielle. Quand la pièce commence, ils animent ce qui sera peut-être leur ultime émission. C'est leur dernière chance. Ils étaient là il y a vingt ans... et ils y sont toujours."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/les-tourtereaux-ou-la-vieillesse-frappe-a-laube"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
