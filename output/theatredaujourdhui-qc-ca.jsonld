  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/papeca/#webpage",
    "@type": [
      "http://schema.org/WebPage"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/papeca"
      }
    ],
    "http://schema.org/about": [
