      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Trois femmes, trois écrivaines, trois performeuses, trois nations sont réunies sur scène pour un happening littéraire autour de la voix féminine, celle qui émerge des eaux. Des voix profondes, guérisseuses, résistantes, insoumises, bienveillantes, maternelles, guerrières."
      }
    ],
    "http://ogp.me/ns#url": [
