    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Ceux qui se sont évaporés | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Emma est partie sans laisser de trace. Femme dans la jeune trentaine, mère, conjointe, fille, amie, elle menait jusqu’à présent une vie normale. Aux prises avec les conséquences de son absence, ses proches cherchent à comprendre. "
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
