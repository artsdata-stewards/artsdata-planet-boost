  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/chevtchenko",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/148583/Chevtchenko_4x5_101d7b8599c0cc599ee16e9637ccc19e.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Chevtchenko | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Chez les Chevtchenko-Tremblay, le patriarche Stefan, tourmenté par la démence et une maladie dégénérative rare, erre dans l’incapacité de se faire comprendre ou de se comprendre lui-même. Ses pensées s’expriment à travers des poèmes ukrainiens qui le hantent depuis sa terre natale. Face à l’inévitable, une union sans précédent émerge entre ses trois fils et leur mère. En dévoilant leurs vulnérabilités, leurs colères et leurs peurs, ils trouvent la force de cultiver l’espoir au cœur de l’adversité."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/chevtchenko"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/chiennes",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/402405/Chiennes_101d7b8599c0cc599ee16e9637ccc19e.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Chienne(s) | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "La Trentenaire a la chienne. En termes élégants, elle souffre d’anxiété. Elle est brillante, drôle, cultivée et capable, mais sa vie se fissure à haute vitesse. Elle a la chienne, mais elle ne sait pas pourquoi. Et surtout, elle ne sait pas si elle en a le droit. Elle se concentre sur sa respiration, brasse les ombres, cherche la lumière. Elle semble immobile, et pourtant elle avance, révélant l’ampleur de sa résistance face au monde."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/chiennes"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
