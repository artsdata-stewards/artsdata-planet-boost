  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/clandestines",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/234542/1200x1200_clandestines_D_101d7b8599c0cc599ee16e9637ccc19e.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Clandestines | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Dans un Canada dystopique, une médecin et une sage-femme pratiquent des avortements dans la clandestinité. Un soir, alors qu’elles attendent leur dernière patiente, l’inattendu se produit et leur vie bascule. Se révèle alors un réseau qui cherche par tous les moyens à remettre en question le statut du fœtus."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/clandestines"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
