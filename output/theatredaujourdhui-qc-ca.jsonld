      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Alix Dufresne fait un retour en force au CTD​’A, plus féroce que jamais! À la barre d’un faux late show déjanté, elle s’entoure d’une équipe de haute voltige comique pour nous livrer une revue de l’année théâtrale aussi festive que cinglante. Invités surprises, house band flamboyant et sketchs délirants sont au programme."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Aujourd'hui ce soir"
      }
    ]
  },
