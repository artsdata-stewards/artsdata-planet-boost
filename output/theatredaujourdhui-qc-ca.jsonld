  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/papeca",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/148649/Papeca_4x5_20b92cde28e2726d1f208af97bea276e.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Papeça | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Seul sur scène, un être venu d’ailleurs se construit et se déconstruit sous nos yeux. À Moscou, c’est le règne de la honte, le silence est roi et les stations s’enfilent sur une route mille fois empruntée et sans issue. Entre le rêve et la réalité, entre ici et là-bas, iel tente de comprendre les codes qui dictent son existence. Une quête depuis longtemps annoncée le mènera en Sibérie où le sol gronde et le brouillard anéantit."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/papeca"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
