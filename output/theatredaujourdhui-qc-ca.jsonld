  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/viqueens-saga-nordique",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/471490/359_054_viqueens-saga-nordique_Bandeaux-Linkedin-perso_1584x396_v1_01_101d7b8599c0cc599ee16e9637ccc19e.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Viqueens : saga nordique | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Julien, fervent amateur de métal nordique et passionné de jeux de rôle vikings, est soudainement transporté à l’époque de ses idoles. Avec stupeur, il découvre que les combattants sanguinaires qu’il admire sont en réalité... des femmes ! Spéculation, vérité, fiction ? Et si les Vikings étaient en fait des Viqueens ? Les guerrières Ulfhild, Frigg et Svanhilde remettront, rapidement — et sans gants blancs — les pendules à l’heure."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/viqueens-saga-nordique"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/virus",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/235654/Le-virus-et-la-proie-c-Marlene-Gelineau-Payette-6_8e6aa24700cd1ee3d1b013d5ca6bd7dd.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Le virus et la proie | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Qui n’a jamais ressenti ce sentiment d’impuissance face à ceux et celles qui détiennent le pouvoir ? Qui n’a jamais éprouvé le besoin urgent d’apostropher ces puissants qui semblent évoluer dans un monde à part ? Ne pouvant plus se taire, quatre personnages s’adressent à Monsieur, figure indéfinissable qui représente différentes factions du pouvoir. Ensemble, ils tentent le tout pour le tout et lancent une charge directe contre l’injustice."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/virus"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
