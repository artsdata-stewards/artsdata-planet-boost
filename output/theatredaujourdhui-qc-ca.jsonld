      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Une femme se voit confier par sa mère mourante la difficile mission de ramener auprès d’elle le fils qu’on lui a arraché vingt ans plus tôt. Affrontant la tempête un soir de février, elle se réfugie dans la lumière apaisante d'une église pour trouver le courage de remonter le fil de la brisure."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "La délivrance"
      }
    ]
