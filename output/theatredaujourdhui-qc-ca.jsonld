    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Bashir Lazhar retrace le parcours d’un immigrant nouvellement arrivé au Québec, qui remplace au pied levé une institutrice qui s’est suicidée dans l’enceinte de l’école. La personnalité de Bashir et ses initiatives pédagogiques se heurtent à la frilosité et à l’incompréhension de ses pairs et des parents d’élèves. Les préjugés latents font surface et révèlent le choc provoqué par la rencontre des cultures."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Bashir Lazhar"
      }
    ]
  },
