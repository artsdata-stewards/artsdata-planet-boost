  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/seuls/#webpage",
    "@type": [
      "http://schema.org/WebPage"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/seuls"
      }
