    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/470402/359_054_bains-libres_Portraits_960x1200_v1_101d7b8599c0cc599ee16e9637ccc19e.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Bains libres | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Les bains libres, ce sont ces enfants qui crient avant de s'immerger : « Check comment chu capable de pas respirer pendant longtemps ». C'est ce sauveteur de 22 ans aux yeux bleus qui nous donne envie de se noyer. Ce sont ces deux adolescents, debout et entrelacés dans la partie peu profonde de la piscine, qui découvrent leur corps devant tout le monde par une belle journée ensoleillée."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/bains-libres"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
