  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/saintlaurent",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/235147/1200x1200_Fillesdusaintlaurent_louise_D_b0c0cd9fc69bcd7037881c1df73715d5.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Les filles du Saint-Laurent | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Un soir, de Côteau-du-Lac à Blanc-Sablon, de Rimouski à Grandes-Bergeronnes, les vagues du fleuve Saint-Laurent se déchainent. Sept cadavres sont recrachés sur ses berges. Sept corps non identifiés, non réclamés que croisent au détour d’une marche, d’une course ou d’un baiser Élodie, Rose, Dora, Charlotte, Martin, Lili, Mathilde, Manon et Anne. Le choc de cette découverte les entraine dans une lutte avec leur propre histoire qui les amènera à faire acte de vie. Ou de survie."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/saintlaurent"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/salut-galarneau",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/156145/1973-1974_Salut-Galarneau_fc43dfb0e5ac64410aafe536f40b0d1c.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Salut Galarneau! | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "La pièce raconte la vie de François Galarneau, fils de pêcheur, propriétaire d'un stand de patates frites, qui rêve d'ethnographie et de littérature. Poussé par sa femme et son frère, il entreprend d'écrire un roman qui l'oblige à plonger en lui-même, à comprendre le monde qui l'entoure et à consentir à y vivre."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/salut-galarneau"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
