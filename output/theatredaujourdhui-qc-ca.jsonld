    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/neuf-titre-provisoire"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "À l’enterrement d’un de leurs amis et collègues, un groupe d’acteurs et d’actrices se souvient, se confie, s’interroge, se tait, s’engueule, s’échappe, dérape. Ils et elles mettent de côté les nombreux personnages de leurs carrières et sont invités ici à se livrer et échanger sur ce qui les fait rager, les enthousiasme, les étonne ou continue de les désespérer."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Neuf [titre provisoire]"
      }
    ]
