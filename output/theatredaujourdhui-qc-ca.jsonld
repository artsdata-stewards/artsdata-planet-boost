      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Nos ghettos | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Deux hommes et une poupée racontent un simple aller-retour à la clinique, devenu odyssée de la rencontre impossible. Nos ghettos, c’est une déambulation improbable dans des espaces familiers. Ponctuée de bonnes volontés et de conscientes lâchetés, cette odyssée intime amène à une désolante mais lucide empilade de vases clos raciaux, sociaux, politiques, culturels, familiaux..."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/nos-ghettos"
      }
    ],
