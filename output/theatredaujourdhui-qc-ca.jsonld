    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/166424/2016-2017_La-delivrance_101d7b8599c0cc599ee16e9637ccc19e.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "La délivrance | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Une femme se voit confier par sa mère mourante la difficile mission de ramener auprès d’elle le fils qu’on lui a arraché vingt ans plus tôt. Affrontant la tempête un soir de février, elle se réfugie dans la lumière apaisante d'une église pour trouver le courage de remonter le fil de la brisure."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/la-delivrance"
