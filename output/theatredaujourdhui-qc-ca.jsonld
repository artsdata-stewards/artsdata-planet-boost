  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/saintlaurent/#webpage",
    "@type": [
      "http://schema.org/WebPage"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/saintlaurent"
      }
    ],
    "http://schema.org/about": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/#identity"
      }
    ],
    "http://schema.org/isPartOf": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/#website"
      }
    ],
    "http://schema.org/potentialAction": [
      {
        "@id": "_:g6545080"
      }
    ],
    "http://schema.org/primaryImageOfPage": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/#logo"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/saintlaurent"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Un soir, de Côteau-du-Lac à Blanc-Sablon, de Rimouski à Grandes-Bergeronnes, les vagues du fleuve Saint-Laurent se déchainent. Sept cadavres sont recrachés sur ses berges. Sept corps non identifiés, non réclamés que croisent au détour d’une marche, d’une course ou d’un baiser Élodie, Rose, Dora, Charlotte, Martin, Lili, Mathilde, Manon et Anne. Le choc de cette découverte les entraine dans une lutte avec leur propre histoire qui les amènera à faire acte de vie. Ou de survie."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Les filles du Saint-Laurent"
      }
    ]
  },
  {
    "@id": "_:g6545080",
    "@type": [
      "http://schema.org/ReadAction"
    ],
    "http://schema.org/target": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/saintlaurent"
      }
    ]
