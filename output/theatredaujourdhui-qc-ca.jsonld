    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/traversee"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/traversee"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Dans un Québec écrasé par la pauvreté et la religion, les vies de trois femmes fascinantes et incroyablement résilientes se dessinent. La traversée du siècle vous invite à suivre leur odyssée au gré des grands bouleversements qu’a connus la société québécoise au XXe siècle et des sujets chers à Michel Tremblay : le métissage, la transcendance des genres, l’homosexualité, la place des femmes, le désir d’émancipation et les traces que laissent tant d’années d’oppression sur l’âme d’un peuple."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "La traversée du siècle"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
