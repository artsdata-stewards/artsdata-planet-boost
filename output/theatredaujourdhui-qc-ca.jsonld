    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "11 auteurs ont chacun comme mission d’écrire une partition de 30 minutes pour minibus. Sorti du théâtre pour naviguer dans la ville, chaque minibus aura un univers propre : science-fiction, studio radio sur thème du polar,… et chaque spectateur choisira à la carte 3 voyages dont il sera complice et interlocuteur."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Après la peur"
      }
    ]
