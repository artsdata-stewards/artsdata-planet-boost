    "@id": "https://theatredaujourdhui.qc.ca/spectacles/le-serum-qui-tue-les-mefaits-de-lacide/#webpage",
    "@type": [
      "http://schema.org/WebPage"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/le-serum-qui-tue-les-mefaits-de-lacide"
      }
