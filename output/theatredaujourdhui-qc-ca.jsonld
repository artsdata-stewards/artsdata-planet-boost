    ]
  },
  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/la-demagogie-des-dragons",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/468312/359_054_la-demagogie-des-dragons_Portraits_960x1200_v1_01_101d7b8599c0cc599ee16e9637ccc19e.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "La démagogie des dragons | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Élevés au Québec sans autre connexion avec leur héritage culturel que leur amour des phở et des bánh mìs, deux artistes québécois entreprennent un voyage aussi réel que loufoque vers leurs racines vietnamiennes. À travers un périple qui les mène du quartier chinois de Montréal jusqu'aux rues animées de Hanoï, ils remettent en question cette tendance qui pousse les artistes minorisés à décortiquer leur identité sur scène."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/la-demagogie-des-dragons"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/la-diseuse-de-bonne-aventure",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/355476/La20diseuse2015.jpg1587756281_4e57d52f89dc62001fa3deff5aab68af_18216ca9446b3b8ddbefb17ab6bf27ca.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "La diseuse de bonne aventure | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Au-delà des espérances, des tromperies et de la naïveté, est-il encore permis de penser à demain? Alors que nous sommes obsédés par un présent narcissique. Je propose deux soirées où auteurs, chanteurs, acteurs viendront nous raconter le confort et l’inquiétude de ce qui nous attend. Une soirée, justement, sans suite. — Marc Séguin"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/la-diseuse-de-bonne-aventure"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
