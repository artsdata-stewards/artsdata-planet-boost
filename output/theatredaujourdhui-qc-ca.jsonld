    "http://schema.org/url": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/saintlaurent"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Un soir, de Côteau-du-Lac à Blanc-Sablon, de Rimouski à Grandes-Bergeronnes, les vagues du fleuve Saint-Laurent se déchainent. Sept cadavres sont recrachés sur ses berges. Sept corps non identifiés, non réclamés que croisent au détour d’une marche, d’une course ou d’un baiser Élodie, Rose, Dora, Charlotte, Martin, Lili, Mathilde, Manon et Anne. Le choc de cette découverte les entraine dans une lutte avec leur propre histoire qui les amènera à faire acte de vie. Ou de survie."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Les filles du Saint-Laurent"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
