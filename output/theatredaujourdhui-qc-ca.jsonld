      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/epopee-nord"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "2035. Après les grands cataclysmes, le peuple commence à s’éparpiller partout dans le Québec. Il est riche de son eau pure, de son hydroélectricité, de ses orangeraies et du tourisme dans les stations balnéaires des Baies du Nord. Le nombre de naissance chez les premières Nations au recensement est stupéfiant. Miraculeux. Inquiétant."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Épopée Nord"
      }
    ]
  },
