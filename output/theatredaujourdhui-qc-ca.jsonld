  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/m-i-l-f",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/167847/2019-2020_MILF_101d7b8599c0cc599ee16e9637ccc19e.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "M.I.L.F. | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Trois femmes, trois mères, trois sexualités, trois voix qui s'entrecroisent : une M.I.L.F. (Mother I'd Like to Fuck), une M.I.L.S. (Mother I'd Like to Save) et une M.I.L.K. (Mother I'd Like to Kill). Trois personnages sans autre fil narratif que leurs expériences, leurs échecs, leurs réussites et leur émancipation. Un regard acide, poétique et engagé qui aborde sans tabous maternité et sexualité."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/m-i-l-f"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
