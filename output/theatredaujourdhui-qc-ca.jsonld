      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Voici le retour attendu de Loup bleu au Centre du Théâtre d’Aujourd’hui! Après s’être attaqué à Dieu, Voltaire, Descartes et Montaigne, Loup bleu aborde l’œuvre monumentale de Tolstoï, Guerre et paix."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Guerre et paix"
      }
    ]
  },
