      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/la-baye"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Dans un pavillon en bord de mer, la famille Louis se prépare à recevoir la famille Jean. Tous les hôtes s'appellent Louis tandis que tous les visiteurs s'appellent Jean. Ce dimanche commence mal : le repas n'est pas prêt, la table n'est pas mise, le père ne fait rien, la mère se désespère et les enfants sont les enfants. Hôtes et invités finiront pourtant par se retrouver autour de la table, présidée par un pépé gâteux. Crocs-en-jambe, perfidies et banalités variées émaille cette réunion de famille."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "La baye"
      }
    ]
  },
