      {
        "@language": "en",
        "@value": "Le 29 février, le hall du CTD’A devient le théâtre d'une soirée musicale exceptionnelle orchestrée par la comédienne et DJ Sarah Laurendeau. Accompagnée de Christina Beaudry-Cárdenas à la batterie, Louis-Philippe Quesnel à la basse et la rappeuse C’Nee Starlette, la créatrice se livre à des improvisations musicales au rythme de poèmes tirés de son projet artistique Les petites."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Ici pour jouer"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
