      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/157974/1986-1987_Pandora_101d7b8599c0cc599ee16e9637ccc19e.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Pandora ou Mon p'tit papa | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Louise, chargée de mission à Paris, se retrouve, par accident, enfermée dans son appartement. Elle s'énerve, rage, tempête, hystérise pour finalement s'abandonner à une sorte de rêve éveillé où elle retrouve son père décédé. Ils revivent devant nous leur relation intense, symbiotique, drôle et touchante."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/pandora-ou-mon-ptit-papa"
