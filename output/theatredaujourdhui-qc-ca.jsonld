      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/bains-libres"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Les bains libres, ce sont ces enfants qui crient avant de s'immerger : « Check comment chu capable de pas respirer pendant longtemps ». C'est ce sauveteur de 22 ans aux yeux bleus qui nous donne envie de se noyer. Ce sont ces deux adolescents, debout et entrelacés dans la partie peu profonde de la piscine, qui découvrent leur corps devant tout le monde par une belle journée ensoleillée."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Bains libres"
      }
    ]
  },
