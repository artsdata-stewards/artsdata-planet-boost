      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/emilie-tient-salon"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Première esclave et première autochtone à avoir lutté juridiquement pour obtenir sa liberté en Nouvelle-France, Marguerite Duplessis fait partie de ces nombreuses héroïnes oubliées par l’Histoire. Inspirée par la résistance et la soif de liberté qui ont guidé le combat de cette activiste, Émilie Monnet lui livre un hommage vibrant avec une triade d’événements sur l’amnésie collective, la mémoire retrouvée et la résilience."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Émilie tient salon"
      }
    ]
  },
