        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/il-pleuvait-sous-les-arbres",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/1347548/Design-sans-titre_516c7187cb6fd957833153cf71fa6fef.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Il pleuvait sous les arbres | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "C’est soir de fête. La rue Saint-Denis scintille, le Centre du Théâtre d’Aujourd’hui s’illumine et, dans le hall transformé en terrain de jeu, un groupe de jeunes artistes se rassemble pour célébrer, créer et tenir tête au froid. Les corps se rapprochent, les voix s’élèvent, les idées s’entrechoquent. À travers prises de parole, élans collectifs et éclats de joie, ils et elles cherchent à inventer un espace où la fête devient un acte de résistance — un lieu où, ensemble, on tente de survivre à l’hiver comme au reste."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/il-pleuvait-sous-les-arbres"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
