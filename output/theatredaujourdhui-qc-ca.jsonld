      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/le-serum-qui-tue-les-mefaits-de-lacide"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Né d'une passion dévorante pour les icônes du cinéma telles que Garbo, Monroe, Valentino, Brando, Moreau, Bardot, Mariano, Belmondo, ainsi que les frères de Daniel ou de Donald, le spectacle conçu par Claude Maher se présente comme une étude comparée des ramages et des ravages de l'amour. En confrontant deux pièces québécoises, l'une ancienne et l'autre contemporaine, Maher explore deux styles d'aimer passionnément, séparés dans le temps mais étrangement similaires dans leurs maniérismes affectés et leur perpétuelle quête de l'extrême."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Le sérum qui tue / Les méfaits de l'acide"
      }
    ]
  },
