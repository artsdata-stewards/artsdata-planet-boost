  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/le-wild-west-show-de-gabriel-dumont",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/402225/WWS_101d7b8599c0cc599ee16e9637ccc19e.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Le Wild West Show de Gabriel Dumont | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "En 1885, au lendemain de la pendaison de Louis Riel, Gabriel Dumont, fier capitaine de la résistance des Métis, prend la fuite et se réfugie aux États-Unis. Il y est recruté par Buffalo Bill, dont les gigantesques spectacles en plein air sont célèbres à travers le continent. Dumont rêvera toute sa vie d'une œuvre de même ampleur pour raconter la lutte des Métis pour la reconnaissance de leurs droits."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/le-wild-west-show-de-gabriel-dumont"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
