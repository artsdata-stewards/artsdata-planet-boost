  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/maurice",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/235806/1200x1200_Maurice_D_e5e224a11749cb7ca56e5a968649632c.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Maurice | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Maurice Dancause, travailleur acharné, brillant économiste et fonctionnaire, se lève un matin et s’effondre. AVC. Neuf jours de coma, quatre ans de réadaptation. Depuis, tout a changé : son cerveau, ses gouts, sa sensibilité, sa personnalité même. Et en toile de fond il y a l’aphasie, ce véritable combat qu’il mène au quotidien pour trouver les mots. Mais loin d’être abattu, Maurice préfère sa nouvelle vie qu’il choisit de vivre pleinement."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/maurice"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
