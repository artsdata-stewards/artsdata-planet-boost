    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/constituons"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "En partenariat avec un réseau de dix partenaires théâtraux dispersés sur le territoire québécois et avec l’Institut du Nouveau Monde, Christian Lapointe a lancé un appel pour réaliser un exercice démocratique inédit. 42 personnes tirées au hasard, à parité homme-femme et représentatives de la population, se sont plongées dans l'écriture de la constitution du Québec de demain. Un projet ambitieux qui redonne au théâtre sa fonction d’agora et au citoyen son pouvoir politique."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Constituons!"
      }
    ]
  },
