  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/lhistoire-de-loie/#webpage",
    "@type": [
      "http://schema.org/WebPage"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/lhistoire-de-loie"
      }
    ],
    "http://schema.org/about": [
