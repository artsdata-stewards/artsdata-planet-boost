  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/aalaapi/#webpage",
    "@type": [
      "http://schema.org/WebPage"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/aalaapi"
