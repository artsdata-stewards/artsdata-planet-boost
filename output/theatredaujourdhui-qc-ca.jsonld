  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/parler-mal/#webpage",
    "@type": [
      "http://schema.org/WebPage"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/parler-mal"
      }
    ],
    "http://schema.org/about": [
