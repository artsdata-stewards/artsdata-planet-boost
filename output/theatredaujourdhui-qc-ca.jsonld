  {
    "@id": "https://theatredaujourdhui.qc.ca/spectacles/okinum",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/imager/images/167481/2018-2019_Okinum_101d7b8599c0cc599ee16e9637ccc19e.jpg"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Okinum | Centre du Théâtre d’Aujourd’hui"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "En langue anishnabemowin, Okinum signifie barrage. Inspiré par le rêve récurrent d'un castor géant, Okinum est une réflexion intime sur la notion de barrages intérieurs, une ode au pouvoir du rêve et à l’intuition. La parole est libérée afin de remonter la rivière de la mémoire des ancêtres et pour se réconcilier, avant tout, avec les différentes facettes d’une identité multiple."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en",
        "@value": "https://theatredaujourdhui.qc.ca/spectacles/okinum"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en",
        "@value": "Centre du Théâtre d’Aujourd’hui"
      }
    ]
  },
