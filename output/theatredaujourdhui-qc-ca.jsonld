    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/jaccuse"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Il y a la fille qui encaisse, qui vend des bas de nylon à partir de 6 heures du matin dans le sous-terrain du métro Bonaventure. Il y a la fille qui agresse, qui a eu le culot de partir sa propre PME dans un contexte économique difficile. Il y a la fille qui adule, une fan inconditionnelle d’Isabelle Boulay. Il y a la fille qui intègre, qui travaille dans un CPE. Puis il y a la fille qui aime, travailleuse autonome qui dilapide beaucoup d’amour et en dirige si peu envers sa petite personne."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "J'accuse"
      }
    ]
  },
