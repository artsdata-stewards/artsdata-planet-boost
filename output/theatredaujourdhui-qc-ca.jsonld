      }
    ],
    "http://schema.org/primaryImageOfPage": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/#logo"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://theatredaujourdhui.qc.ca/spectacles/beaugars"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Bienvenue dans le monde imaginaire de Beau gars où les femmes s’arrogent sans vergogne tous les rôles de pouvoir. Politiciennes, chasseuses, reines, policières, elles sont partout et dominent toutes les sphères de la société. Sur scène, trois narratrices passent au hachoir les univers de films et de séries télévisées, commentant avec un humour décapant les actions de leurs héroïnes fictives, tout en gardant à l’œil un beau gars à moitié nu, homme-objet maintenu à disposition."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Beau gars"
      }
    ]
  },
