      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Based on Syreeta Hector’s relationship to race, and her experiences in classical ballet, Black Ballerina is a powerful exploration of the nuances within one’s identity, and the unconscious ways that we all try to fit in."
      }
    ],
