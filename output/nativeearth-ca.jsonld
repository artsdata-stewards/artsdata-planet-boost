    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A Brian Solomon Electric Moose production presented in partnership with Dancemakers. Interpreted by Brian Solomon and Mariana Medellin-Meinke, the NDN way re-imagines, remixes, and interprets Cree philosophies on medicine teachings, pipe ceremonies, sweat lodges, and death through a highly theatrica"
      }
    ],
