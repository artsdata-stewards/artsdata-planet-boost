    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "NGS (Native Girl Syndrome) by Lara Kramer is a raw and uncompromising dance-theatre work inspired by the stories of Kramer’s grandmother’s experiences as a young Indigenous woman who migrated from a remote First Nations community into an urban setting. The piece delves into the cycles of addiction,"
      }
    ],
