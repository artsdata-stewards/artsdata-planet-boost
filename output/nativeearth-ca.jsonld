    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "This lively historical satire of survival and cultural inheritance shifts perspectives from the male gaze onto women’s power in the past and present through the lens of the rapidly changing world of the Canadian fur trade."
      }
    ],
