    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Following such critically acclaimed works as the lightning-in-a-bottle The Seat Next To The King and the multi-Dora nominated Three Ordinary Man, playwright Steven Elliott Jackson returns to Toronto with the critically lauded 2025 Hamilton Fringe hit, A Question of Character."
      }
