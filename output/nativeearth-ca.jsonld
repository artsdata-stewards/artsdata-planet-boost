    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A Native Earth production in partnership with Blyth Festival, Ipperwash is written and directed by Falen Johnson, with dramaturgy by Yvette Nolan. The story sheds light on the aftermath of the Ipperwash Crisis, weaving personal and historical narratives of the Stoney Point Reserve and Camp Ipperwash"
      }
