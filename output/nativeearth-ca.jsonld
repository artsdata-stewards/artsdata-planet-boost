    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Written by Kevin Loring and directed by Jani Lauzon, Where the Blood Mixes is a poignant drama about the intergenerational impact of the residential school system. Set in the community of Kumsheen, the story follows Floyd as he reconnects with his daughter after years apart, confronting buried traum"
      }
