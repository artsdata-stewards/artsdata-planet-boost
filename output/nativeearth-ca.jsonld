    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "CAMINOS 2019, presented by Aluna Theatre in partnership with Native Earth Performing Arts, was a festival of new performance works-in-progress featuring artists from across the Americas. The event included Mura Buai (Everyone Everyone), a Force Majeure Production in collaboration with Friday Creeati"
      }
