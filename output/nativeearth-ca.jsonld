    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Written and performed by Sheldon Elter and directed by Ron Jenkins, Métis Mutt is an honest, touching, and humorous solo performance blending stand-up comedy, storytelling, and music. Drawing from his own life experiences as a Métis man, Elter explores identity, racism, relationships, and self-disco"
      }
