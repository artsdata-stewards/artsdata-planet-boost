    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "After nearly a decade abroad, Nina, an estranged singer returns home only to discover the inheritance she was promised is not all it seems. Forced to confront a past she tried to forget, Nina has to learn to forgive before it’s too late."
      }
    ],
