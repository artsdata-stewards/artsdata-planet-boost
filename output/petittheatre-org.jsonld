  {
    "@id": "https://petittheatre.org/evenement/corail-et-les-adherences-par-solene-bernier/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
    ],
    "http://ogp.me/ns#type": [
