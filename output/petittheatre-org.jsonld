    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Filles de, l’opéra-rock documentaire en grande première"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Sur scène, au coeur de l'opéra-rock, quatre performeuses nous font ressentir la puissance des relations mères-filles qui jaillit hors du terrain de l’intime dans lequel on l’enferme, pour créer une nouvelle histoire qui s’écrit à plusieurs, comme un appel à être entendu."
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
