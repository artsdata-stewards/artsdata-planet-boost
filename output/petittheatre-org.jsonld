    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Futur Danse - Le Petit Théatre du Vieux Noranda"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le programme Futur Danse vous invite à découvrir les œuvres de Nina Chati et d'Adrian W.S. Batt!"
      },
      {
        "@language": "fr-ca",
        "@value": "Une soirée de danse qui entre en contact avec le mouvement de demain!\n \n\nDécouvrez le solo de Nina Chati où popping et danse contemporaine s'entrelacent pour donner naissance à un personnage en métamorphose. Ensuite, dans un langage corporel organique, les danseurs de la chorégraphie d’Adrian W.S. Batt s'affranchissent des stéréotypes"
      }
    ],
    "http://ogp.me/ns#url": [
