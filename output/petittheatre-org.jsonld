        "@value": "Les Petits Explorateurs"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Les Petits Explorateurs est une initiative du Petit Théâtre du Vieux Noranda qui donne l’opportunité aux voyageurs·es et aventurier·es, de Rouyn-Noranda et de l’Abitibi-Témiscamingue, de venir partager leurs expériences de voyage."
      }
    ],
