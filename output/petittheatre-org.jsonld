  {
    "@id": "https://petittheatre.org/evenement/festival-du-film-de-montagne-de-banff/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
    ],
    "http://ogp.me/ns#type": [
