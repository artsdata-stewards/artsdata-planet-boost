  {
    "@id": "https://petittheatre.org/evenement/limprovisatorium-3/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
    ],
    "http://ogp.me/ns#type": [
