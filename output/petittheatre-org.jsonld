    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Jérôme 50"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Les extraits « La plus belle fille du moshpit », « Y’a pu d’poude dans poude » et « Le pauvre riche » définissent la direction ska-punk-folk-trash du troisième album de Jérôme 50 : Anarcolique, paru le 2 mai 2025."
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
