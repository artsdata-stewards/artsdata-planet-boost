    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Azrieli Music Prizes"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Experience the Orchestra’s power in the world premieres of the 2026 Azrieli Music Prizes laureates. The program spans themes from sacrifice in Nazi-occupied Poland to a centuries-old riddle, the legacy of Occitan <em>trobairitz</em>, and evocative Canadian landscapes. With soloists on viola da gamba, theremin and cello, this concert offers a unique musical journey. Created in 2014, the Azrieli Music Prizes are now among Canada’s major composition competitions.</p>\n"
      }
    ]
  },
  {
    "@id": "https://www.osm.ca/fr/concert/payare-dirige-la-grande-messe-en-ut/",
