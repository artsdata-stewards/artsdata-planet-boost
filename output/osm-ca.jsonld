    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "« C’est un oiseau? C’est un avion? Non, c’est l’Orchestre symphonique de Montréal! » Enfilez votre masque et votre cape, le devoir vous appelle pour un conce..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr",
        "@value": "fr_ca"
      }
    ],
    "http://ogp.me/ns#type": [
