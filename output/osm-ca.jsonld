    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Concours musical international de Montréal – Grand final"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Experience the intensity of the Concours musical international de Montréal’s Final with the Orchestre symphonique de Montréal—the Concours’ official orchestra—under the baton of guest conductor Sascha Goetzel.</p>\n<p>After a demanding journey, emotions run high for the Grand Final of the Concours 2026, which will take place on June 4, at 7:30 p.m. Three exceptional finalists will dazzle the audience as they perform a violin concerto of their choice.</p>\n<p>With intensity, emotion, and absolute mastery of their art, this evening promises unforgettable moments of music, where every note carries the hope of a victory. Don&rsquo;t miss this landmark event celebrating the talent, passion, and future of the violin on the Montreal stage.</p>\n<p>Who will earn the prestigious title of Grand Laureate of the Concours musical international de Montréal 2026?</p>\n"
      }
    ]
  },
