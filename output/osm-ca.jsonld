    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Kent Nagano rencontre Le Vent du Nord - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Ne manquez pas ce concert entrainant où Le Vent du Nord proposera des œuvres originales et des pièces traditionnelles dans une version orchestrale unique. Reels, gigues et autres airs enlevés « swingueront » avec la musique scintillante de Tchaïkovski."
      }
    ],
