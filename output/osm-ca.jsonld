    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "The Miss Chief Cycle"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<div>L&rsquo;artiste Kent Monkman, reconnu pour ses peintures épiques et symboliques, présente en avant-première des extraits de <em>The Miss Chief Cycle</em>, une création lyrique composée de trois scènes basées sur <em>Les Mémoires de Miss Chief Eagle Testickle</em> de Kent Monkman et Gisèle Gordon. Interprétée par de grandes voix canadiennes qui seront accompagnées par des musicien.ne.s de l&rsquo;OSM, cette œuvre unique transposera sur scène des toiles de Kent Monkman, soulevant la division entre la vision du monde du peuple cri et celle des colonialistes européens. Un fabuleux spectacle à ne pas manquer et présenté en première mondiale à la Salle Bourgie !</div>\n<div class=\"margin-top-thinner margin-top-broad-from-xs\"></div>\n<div class=\"margin-top-thinner margin-top-broad-from-xs\">En lien avec l’exposition <em>Kent Monkman : L’Histoire est dépeinte par les vainqueurs</em></div>\n<div class=\"margin-top-thinner margin-top-broad-from-xs\">\n<div>\n<div></div>\n</div>\n</div>\n<div class=\"margin-top-thinner margin-top-broad-from-xs\">Une coproduction du Studio Kent Monkman et de la Salle Bourgie, présentée en collaboration avec le MBAM et l’Orchestre symphonique de Montréal.</div>\n"
      }
    ]
  },
