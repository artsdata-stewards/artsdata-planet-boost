    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Les percussions avec Glass : un univers hypnotique"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p><span class=\"TextRun SCXW141858595 BCX0\" lang=\"FR-CA\" xml:lang=\"FR-CA\" data-contrast=\"auto\"><span class=\"NormalTextRun SCXW141858595 BCX0\">Plongez dans l’univers fascinant des instruments à percussion avec la musique minimaliste et envoûtante de Philip Glass. Laissez-vous emporter par la puissance et l’énergie de</span><span class=\"NormalTextRun SCXW141858595 BCX0\"> ces instruments</span><span class=\"NormalTextRun SCXW141858595 BCX0\"> pour vivre une aventure sonore intense et inoubliable. Une occasion unique de découvrir l’acoustique exceptionnelle de la Maison symphonique en compagnie de</span><span class=\"NormalTextRun SCXW141858595 BCX0\">s</span><span class=\"NormalTextRun SCXW141858595 BCX0\"> percussionnistes </span><span class=\"NormalTextRun SCXW141858595 BCX0\">virtuoses </span><span class=\"NormalTextRun SCXW141858595 BCX0\">de l’OSM!</span></span></p>\n<p>&nbsp;</p>\n<p>&nbsp;</p>\n"
      }
    ]
  },
