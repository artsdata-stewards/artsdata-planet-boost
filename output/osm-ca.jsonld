    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Écho du Levant : Improviser la tradition - Orchestre symphonique de Montréal"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://www.osm.ca/app/uploads/2025/03/osm2526_clarinette-improvisation_1080x1080_ang.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Lors de ce concert éclaté, découvrez le célèbre clarinettiste Kinan Azmeh, dont la critique salue la maitrise instrumentale et l’aisance à évoluer dans diver..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr",
        "@value": "fr_ca"
      }
    ],
    "http://ogp.me/ns#type": [
