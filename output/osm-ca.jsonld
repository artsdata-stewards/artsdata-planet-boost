    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Le Double Concerto pour deux pianos de Glass"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Sous la direction de Fabien Gabel, l’OSM recevra les pianistes Katia et Marielle Labèque<em>.</em> Pour elles, Glass a écrit son <em>Double Concerto pour deux pianos</em>, une œuvre au cours de laquelle les solistes et l’orchestre tissent un tapis sonore en constante mouvance. La sensualité mélodique de la <em>Danse des sept voiles</em> de R. Strauss et de <em>La tragédie de Salomé</em> de Schmitt apportera une touche d’exotisme à ce programme.</p>\n"
      }
    ]
  },
