    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Heroes : symphonie de jeux vidéo"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>En mai, <em>Heroes : symphonie de jeux vidéo</em> nous plongera, sous la baguette de Kevin Zakresky, dans les plus grands thèmes de jeux vidéo, de <em>Fallout</em> à <em>Assassin’s Creed</em>, en passant par <em>World of Warcraft</em> et <em>Final Fantasy</em> avec des projections et séquences de ces jeux marquants pour plusieurs générations.</p>\n<p>Concert avec projections.</p>\n"
      }
    ]
  },
  {
    "@id": "https://www.osm.ca/fr/concert/wagner-et-la-legende-de-lanneau/",
    "@type": [
