      {
        "@id": "https://www.osm.ca/en/concert/nagano-conducts-bachs-christmas-oratorio/"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "_:g1854940"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
