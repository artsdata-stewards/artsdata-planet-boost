    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The OSM Carnival  - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "In this one-of-a-kind concert, let’s learn about the orchestra and insects without fear! Discover The Carnival of the Insects, a recent work by Quebec composer Maxime Goulet. Each short movement highlights an insect and an orchestra instrument that will have the chance to be heard as a soloist. Ants, bees, beetles, and many other insects will be evoked by the timbres of the four instrument families of the orchestra. To complete the celebration, other bugs might just join in! See pedagogical guide "
      }
    ],
