    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://www.osm.ca/app/uploads/2026/02/italienne-mendelssohn-dovgan-1080x1080-osm-2026-2027-en-pastille.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Voici un programme qui respire la joie, l’élan et la vitalité pure. L’univers lumineux de Gluck, avec <em>Orphée et Eurydice</em>, ouvre la soirée dans un so..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr",
        "@value": "fr_ca"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Labadie dirige «L'italienne» de Mendelssohn - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Voici un programme qui respire la joie, l’élan et la vitalité pure. L’univers lumineux de Gluck, avec Orphée et Eurydice, ouvre la soirée dans un souffle d’élégance et de grâce classique. Beethoven, encore jeune et fougueux, prolonge cette allégresse avec un Concerto n° 1 qui scintille de fraîcheur, parfaitement accordé à la musicalité naturelle d’Alexandra Dovgan, nouvelle étoile du piano. Bernard Labadie convie ensuite Mendelssohn dans une Symphonie « Italienne » où l’on entend presque la lumière, les places ensoleillées, les danses spontanées. À travers ce programme rempli d’une joie de vivre contagieuse se dégage l’idée d’une musique dont l’enthousiasme et l’élégance demeurent aussi communicatifs deux siècles après la naissance de ces œuvres. PASTILLE MUSICALE POÉTIQUE : ​ Grand classique du répertoire pour un voyage au coeur des émotions. Des Billets mystères (sièges surprises entre 28 $ et 30 $) sont disponibles pour ce concert! Cliquez sur \"Acheter des billets\" et entrez le code promotionnel MYST pour vous en procurer."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ]
