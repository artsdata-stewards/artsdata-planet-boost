    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "À 21 ans, elle devenait la plus jeune directrice musicale d’un collège à Cambridge. Quelques années plus tard, elle faisait vibrer des millions d’abonnés sur..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr",
