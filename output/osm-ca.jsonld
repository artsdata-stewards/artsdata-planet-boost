    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "In this inventive concert where echoes of the Baroque and musical traditions intersect, the Rwandan inanga, the medieval theorbo, the Persian ghaychak fiddle..."
      }
    ],
    "http://ogp.me/ns#locale": [
