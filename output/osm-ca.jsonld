    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Hockey Sweater"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Settle in at the Maison symphonique and step into the magic of winter with the orchestra, as Roch Carrier’s <em>The Hockey Sweater</em> comes to life in a symphonic adaptation by Canadian composer Abigail Richardson-Schulte, full of humour and surprises.</p>\n<p><em>This concert is presented in French only.</em></p>\n<div style=\"background-color: #f8f4ff; border: 2px solid #7d50b3; padding: 25px; margin: 20px 0; border-radius: 0px; color: #2c2c2c; line-height: 1.6; box-shadow: 0 2px 5px rgba(0,0,0,0.05); width: 100%;\"><strong><em>FAMILY</em> MUSICAL TAG: </strong>​<br />\nConcert for ages 6 and up that will delight the entire family.</div>\n"
      }
    ]
  },
