    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Club d’écoute - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Par l’écoute et la discussion, l’animateur ou l’animatrice de la soirée vous guidera à travers les faits saillants du répertoire de certains concerts. Venez en apprendre davantage sur les principaux thèmes musicaux de la programmation et explorez les œuvres symphoniques avec d’autres mélomanes. Entrée libre. La possibilité de réserver leur place à l'avance est un privilège exclusif aux abonnés de l'OSM. Veuillez noter que ces événements se dérouleront en français."
      }
    ],
    "http://schema.org/inLanguage": [
      {
