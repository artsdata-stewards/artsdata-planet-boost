      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "From 7:00 p.m. to 10:00 p.m., take part in a dynamic and creative workshop to immerse yourself in the world of percussion instruments that “pop!” A fun and friendly experience that will appeal to your musical curiosity. Starting at 10:15 p.m., come and discover percussion instruments in an interactive exhibition, inluding our newest bells recently acquired by the OSM. A unique opportunity to discover these extraordinary instruments! Takes place at Espace OSM Free 1) Percussion Workshop 7:00 p.m. to 10:00 p.m. Every 30 minutes. Registration required 2) Little Percussion Museum 10:15 p.m. to 1:00 a.m. Free entry With Instruments de musique Long &amp; McQuade – Event Partner"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "en",
        "@value": "fr-CA"
      }
