    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Dans le cadre de sa<strong> Série Prestige & Patrimoine</strong>, <strong>GSI Musique</strong> et <strong>Oziko</strong> présentent <strong>Ferland symphoniq..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr",
        "@value": "fr_ca"
      }
    ],
    "http://ogp.me/ns#type": [
