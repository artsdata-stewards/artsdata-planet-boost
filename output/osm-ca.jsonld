      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Rafael Payare leads us into an extraordinary musical self-portrait: <em>Ein Heldenleben</em>, a true biopic before its time, where Richard Strauss casts hims..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "en",
        "@value": "en_us"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
