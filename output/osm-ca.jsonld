      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Sportissimo ! – Matinées scolaires"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<div class=\"wpb_text_column wpb_content_element \">\n<div class=\"wpb_wrapper\">\n<p><strong>Recommended for</strong> students in elementary, grades 5 and 6, and secondary 1 and 2</p>\n</div>\n</div>\n<div class=\"wpb_text_column wpb_content_element \">\n<div class=\"wpb_wrapper\">\n<p>Take a seat in the musical arena of the Maison symphonique to watch a symphonic tournament of epic proportions!</p>\n<p>At the centre, conductor Adam Johnson will give the final instructions for a melodic offensive that will leave you on the edge of your seat. On one side, you’ll see our oboist warming up for a shot at a remarkably athletic passage. Meanwhile, our string section will be drilling its precision, discipline, and speed, for a chance to win top honours! Together, they will take you on a discovery of the the bonds that unite music and sports.</p>\n</div>\n</div>\n<div class=\"wpb_text_column wpb_content_element \">\n<div class=\"wpb_wrapper\">\n<p><span class=\"TextRun SCXW4111135 BCX8\" lang=\"FR-CA\" xml:lang=\"FR-CA\" data-contrast=\"none\"><span class=\"NormalTextRun SCXW4111135 BCX8\">The </span><span class=\"NormalTextRun SpellingErrorV2Themed SCXW4111135 BCX8\">baton</span> <span class=\"NormalTextRun SpellingErrorV2Themed SCXW4111135 BCX8\">is</span> <span class=\"NormalTextRun SpellingErrorV2Themed SCXW4111135 BCX8\">raised</span><span class=\"NormalTextRun SCXW4111135 BCX8\">, and the musical match </span><span class=\"NormalTextRun SpellingErrorV2Themed SCXW4111135 BCX8\">is</span><span class=\"NormalTextRun SCXW4111135 BCX8\"> set to </span><span class=\"NormalTextRun SCXW4111135 BCX8\">begin</span><span class=\"NormalTextRun SCXW4111135 BCX8\">. </span></span><span class=\"TextRun SCXW4111135 BCX8\" lang=\"FR-CA\" xml:lang=\"FR-CA\" data-contrast=\"none\"><span class=\"NormalTextRun SCXW4111135 BCX8\">On </span><span class=\"NormalTextRun SpellingErrorV2Themed SCXW4111135 BCX8\">your</span><span class=\"NormalTextRun SCXW4111135 BCX8\"> marks, </span><span class=\"NormalTextRun SpellingErrorV2Themed SCXW4111135 BCX8\">get</span><span class=\"NormalTextRun SCXW4111135 BCX8\"> set, </span><span class=\"NormalTextRun SpellingErrorV2Themed SCXW4111135 BCX8\">play</span><span class=\"NormalTextRun SCXW4111135 BCX8\">!</span></span><span class=\"EOP SCXW4111135 BCX8\" data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:259}\"> </span></p>\n</div>\n</div>\n"
      }
    ]
