    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Le Grand Bill en musique - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Félix Morissette et Catherine Robert avec la complicité de deux musicien.nes de l’OSM vous invitent à découvrir un conte captivant et éducatif, rempli d’humour et de découvertes, qui éveillera petits et grands à la beauté du monde des insectes. Imaginez… vous émergez au printemps, vous regardez votre reflet dans une goutte d’eau et… impossible de savoir qui vous êtes! C’est exactement ce qui arrive à Bill, un minuscule explorateur qui s’envole pour trouver son identité. De fleurs en fleurs, il danse avec les bourdons, s’entraîne avec les colibris et tente même un rodéo… avec les mouches! Ouvrez grand vos oreilles… et peut-être croiserez-vous Bill dans votre jardin après le spectacle! À partir de 5 ans"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ]
  },
