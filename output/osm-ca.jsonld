      {
        "@language": "fr",
        "@value": "Dans ce programme condensé, la force des individualités de l’Orchestre se déploie comme rarement. Les <em>Danses polovtsiennes</em> de Borodine ouvrent la so..."
      }
    ],
    "http://ogp.me/ns#locale": [
