    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Dubois – Biographie symphonique - Orchestre symphonique de Montréal"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://www.osm.ca/app/uploads/2025/12/osm2526_dubois_1080x1080_bilingue-1.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "A passionate artist, Claude Dubois has always sung our stories, our loves, and our joys. With <strong><em>Dubois Biographie symphonique</em></strong>, <stron..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "en",
        "@value": "en_us"
