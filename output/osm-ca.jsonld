    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Following his enthusiastic reception at the 2024 Virée classique summer concert, the talented oud player Joseph Tawadros makes his grand return to the OSM fo..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "en",
