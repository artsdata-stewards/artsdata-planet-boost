    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><span class=\"TextRun SCXW96947785 BCX0\" lang=\"FR-CA\" xml:lang=\"FR-CA\" data-contrast=\"auto\"><span class=\"NormalTextRun SCXW96947785 BCX0\">This program highlights the </span><span class=\"NormalTextRun SCXW96947785 BCX0\">viola’s</span> <span class=\"NormalTextRun SCXW96947785 BCX0\">deep</span><span class=\"NormalTextRun SCXW96947785 BCX0\">, expressive </span><span class=\"NormalTextRun SCXW96947785 BCX0\">voice</span><span class=\"NormalTextRun SCXW96947785 BCX0\"> in Canadian composer Cassandra </span><span class=\"NormalTextRun SCXW96947785 BCX0\">Miller’s</span><span class=\"NormalTextRun SCXW96947785 BCX0\"> </span></span><span class=\"TextRun SCXW96947785 BCX0\" lang=\"FR-CA\" xml:lang=\"FR-CA\" data-contrast=\"auto\"><span class=\"NormalTextRun SCXW96947785 BCX0\">Concerto</span></span><span class=\"TextRun SCXW96947785 BCX0\" lang=\"FR-CA\" xml:lang=\"FR-CA\" data-contrast=\"auto\"><span class=\"NormalTextRun SCXW96947785 BCX0\">, </span></span><span class=\"TextRun Highlight SCXW96947785 BCX0\" lang=\"EN-CA\" xml:lang=\"EN-CA\" data-contrast=\"auto\"><span class=\"NormalTextRun SCXW96947785 BCX0\">a poignant reflection on separation</span></span> <span class=\"TextRun SCXW96947785 BCX0\" lang=\"FR-CA\" xml:lang=\"FR-CA\" data-contrast=\"auto\"><span class=\"NormalTextRun SCXW96947785 BCX0\">premiered</span> <span class=\"NormalTextRun SCXW96947785 BCX0\">in</span><span class=\"NormalTextRun SCXW96947785 BCX0\"> 2023 by Lawrence Power</span></span><span class=\"TextRun Highlight Strikethrough SCXW96947785 BCX0\" lang=\"FR-CA\" xml:lang=\"FR-CA\" data-contrast=\"auto\"><span class=\"NormalTextRun SCXW96947785 BCX0\">, and an </span><span class=\"NormalTextRun SCXW96947785 BCX0\">excerpt</span> <span class=\"NormalTextRun SCXW96947785 BCX0\">from</span> <span class=\"NormalTextRun SCXW96947785 BCX0\">Wagner’s</span><span class=\"NormalTextRun SCXW96947785 BCX0\"> </span></span><span class=\"TextRun Highlight Strikethrough SCXW96947785 BCX0\" lang=\"FR-CA\" xml:lang=\"FR-CA\" data-contrast=\"auto\"><span class=\"NormalTextRun SCXW96947785 BCX0\">Tristan and Isolde</span></span><span class=\"TextRun Highlight Strikethrough SCXW96947785 BCX0\" lang=\"FR-CA\" xml:lang=\"FR-CA\" data-contrast=\"auto\"><span class=\"NormalTextRun SCXW96947785 BCX0\">, </span><span class=\"NormalTextRun SCXW96947785 BCX0\">both</span><span class=\"NormalTextRun SCXW96947785 BCX0\"> poignant </span><span class=\"NormalTextRun SCXW96947785 BCX0\">reflections</span><span class=\"NormalTextRun SCXW96947785 BCX0\"> on </span><span class=\"NormalTextRun SCXW96947785 BCX0\">separation</span><span class=\"NormalTextRun SCXW96947785 BCX0\">.</span></span><span class=\"TextRun SCXW96947785 BCX0\" lang=\"FR-CA\" xml:lang=\"FR-CA\" data-contrast=\"auto\"> <span class=\"NormalTextRun SCXW96947785 BCX0\">Meanwhile</span><span class=\"NormalTextRun SCXW96947785 BCX0\">, Debussy </span><span class=\"NormalTextRun SCXW96947785 BCX0\">paints</span><span class=\"NormalTextRun SCXW96947785 BCX0\"> a </span><span class=\"NormalTextRun SCXW96947785 BCX0\">vivid</span><span class=\"NormalTextRun SCXW96947785 BCX0\"> portrait of the </span><span class=\"NormalTextRun SCXW96947785 BCX0\">sea</span> <span class=\"NormalTextRun SCXW96947785 BCX0\">with</span> <span class=\"NormalTextRun SCXW96947785 BCX0\">impressionistic</span> <span class=\"NormalTextRun SCXW96947785 BCX0\">colours</span><span class=\"NormalTextRun SCXW96947785 BCX0\">, </span><span class=\"NormalTextRun SCXW96947785 BCX0\">immersing</span> <span class=\"NormalTextRun SCXW96947785 BCX0\">listeners</span><span class=\"NormalTextRun SCXW96947785 BCX0\"> in a </span><span class=\"NormalTextRun SCXW96947785 BCX0\">nostalgic</span><span class=\"NormalTextRun SCXW96947785 BCX0\"> and </span><span class=\"NormalTextRun SCXW96947785 BCX0\">dreamlike</span> <span class=\"NormalTextRun SCXW96947785 BCX0\">soundscape</span><span class=\"NormalTextRun SCXW96947785 BCX0\">. </span><span class=\"NormalTextRun SCXW96947785 BCX0\">Enjoy</span><span class=\"NormalTextRun SCXW96947785 BCX0\"> a musical </span><span class=\"NormalTextRun SCXW96947785 BCX0\">journey</span> <span class=\"NormalTextRun SCXW96947785 BCX0\">that</span> <span class=\"NormalTextRun SCXW96947785 BCX0\">is</span> <span class=\"NormalTextRun SCXW96947785 BCX0\">both</span> <span class=\"NormalTextRun SCXW96947785 BCX0\">powerful</span><span class=\"NormalTextRun SCXW96947785 BCX0\"> and </span><span class=\"NormalTextRun SCXW96947785 BCX0\">poetic</span><span class=\"NormalTextRun SCXW96947785 BCX0\">.</span></span><span class=\"EOP SCXW96947785 BCX0\" data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:240}\"> </span></p>\n"
      }
