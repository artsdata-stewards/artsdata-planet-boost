    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Voïvod symphonique"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Legendary Quebec metal band Voïvod teams up with the OSM in two awesome concerts conducted by Dina Gilbert. Join us for this thrilling event!</p>\n<p><strong>Tickets are also available at the <a href=\"https://placedesarts.com/en/event/voivod-symphonique\" target=\"_blank\" rel=\"noopener\">Place des Arts box office</a>.</strong></p>\n<p>&nbsp;</p>\n<div style=\"border: 5px #85008c solid; padding: 15px;\"><span style=\"text-decoration: underline;\"><strong>Please note that strobe lights will be used during the performance. Exposure to this type of lighting may increase the risk of epilepsy in sensitive individuals, even in those who have never experienced symptoms of the condition.</strong></span></div>\n<p>&nbsp;</p>\n"
      }
    ]
  },
