    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Sportissimo!"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>De la piste de course à la scène de la Maison symphonique, découvrez les liens qui unissent musique et sport. Roulements de tambours ou hymnes nationaux, voyons comment la musique fédère et encourage les athlètes depuis toujours. À vos marques, prêts? Jouez!</p>\n"
      }
    ]
  },
