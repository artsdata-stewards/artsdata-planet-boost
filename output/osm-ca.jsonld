      {
        "@language": "fr",
        "@value": "Voyage musical avec Joseph Tawadros et Beethoven - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Après un accueil triomphal lors du concert d’été de la Virée classique 2024, le talentueux oudiste Joseph Tawadros fait son grand retour à l’OSM pour deux concerts exceptionnels. Il interprétera une œuvre vibrante inspirée des maqams, modes mélodiques du Moyen-Orient, offrant une expérience musicale riche en couleurs et en énergie. Cette pièce explosive se mêle parfaitement à l’intensité rythmique de la Symphonie n° 7 de Beethoven et promet une soirée unique au rythme effervescent."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ]
