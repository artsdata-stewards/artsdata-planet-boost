    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "À seize ans, Schubert signe un <em>Quatuor</em> plein d’élan, héritage de ses concerts familiaux. Debussy, quant à lui, apporte à son unique <em>Quatuor</em>..."
      }
