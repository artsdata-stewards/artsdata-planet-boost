        "@language": "en",
        "@value": "<p><strong>Conteurs à gages</strong></p>\n<p><strong>Félix Morissette</strong>, storyteller</p>\n<p><strong>Catherine Robert</strong>, storyteller</p>\n<p><strong>Éliane Charest-Beauchamp</strong>, violin</p>\n<p><strong>Dominique Bégin</strong>, violin</p>\n"
      }
