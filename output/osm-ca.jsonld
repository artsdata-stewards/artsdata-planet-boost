    ]
  },
  {
    "@id": "_:g12551760",
    "@type": [
      "http://schema.org/Person"
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "<h6 class=\"vc_custom_heading\">ARTISTES DE LA PRODUCTION FRANCOPHONE</h6>\n<p>&nbsp;</p>\n<div class=\"wpb_text_column wpb_content_element \">\n<div class=\"wpb_wrapper\">\n<p><b>Daniel Brière</b>, comédien</p>\n<p><b>Mani Soleymanlou</b>, comédien</p>\n<p><b>Marie-Thérèse Fortin</b>, comédienne</p>\n<p><b>Michel-Maxime Legault</b>, metteur en scène</p>\n</div>\n</div>\n"
      }
    ]
  },
  {
    "@id": "https://www.osm.ca/temporary/9c988373-bc16-48bb-865e-3a3027aa5224",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g12551720"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.osm.ca/app/uploads/2024/01/concert-histoire-du-soldat-stravinsky.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.osm.ca/fr/concert/lhistoire-du-soldat-de-stravinsky/"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "_:g12551760"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.osm.ca/fr/concert/lhistoire-du-soldat-de-stravinsky/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "L’Histoire du Soldat de Stravinsky"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<div class=\"wpb_text_column wpb_content_element \">\n<div class=\"wpb_wrapper\">\n<p><strong>Recommandé pour </strong>les élèves du 2<sup>e</sup> cycle du secondaire et élèves en concentration artistique</p>\n</div>\n</div>\n<div class=\"wpb_text_column wpb_content_element \">\n<div class=\"wpb_wrapper\">\n<p>Suivez les mésaventures d’un soldat aux prises avec le diable dans une œuvre originale de Stravinsky et de Ramuz. Mêlant théâtre, musique de scène et comédie, cette pièce reflète l’esprit du Paris de la Belle Époque avec une ambiance bon enfant et des influences de jazz et de ragtime.</p>\n</div>\n</div>\n"
      }
    ]
  },
