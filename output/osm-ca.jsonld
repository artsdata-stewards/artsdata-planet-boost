      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "<p>To music lovers’ great delight, pianist Louis Lortie will be back with the OSM to take us on a jaunt from the world of Mozart’s Vienna to the Parisian con..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "en",
        "@value": "en_us"
      }
    ],
    "http://ogp.me/ns#type": [
