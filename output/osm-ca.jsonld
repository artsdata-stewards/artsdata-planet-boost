      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "L’OSM présente Innere Musik, un portrait immersif du Grand Orgue Pierre-Béique. Laissez-vous porter par la Fantaisie et Fugue en sol mineur de Jean-Sébastien Bach alors que vous voyagerez à travers les 6 489 tuyaux de cet instrument grandiose!"
      }
    ],
