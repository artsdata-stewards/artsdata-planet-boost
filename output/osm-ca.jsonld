        "@language": "fr",
        "@value": "<div class=\"vc_row wpb_row vc_inner vc_row-fluid vc_row-o-content-middle vc_row-flex\">\n<div class=\"artist_info wpb_column vc_column_container vc_col-sm-12\">\n<div class=\"vc_column-inner\">\n<div class=\"wpb_wrapper\">\n<div class=\"wpb_text_column wpb_content_element \">\n<div class=\"wpb_wrapper\">\n<p><strong>Rafael Payare</strong>, chef d’orchestre</p>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n"
