      {
        "@language": "fr",
        "@value": "López rend un vibrant hommage à la Finlande à travers son poème symphonique <em>Aino</em>, tandis que Dvořák affirme avec éclat son identité slave en inséran..."
      }
    ],
    "http://ogp.me/ns#locale": [
