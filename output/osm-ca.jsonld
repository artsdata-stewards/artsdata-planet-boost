      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Experience the OSM’s fourth album recording under Pentatone Record Label by attending an exceptional concert given by the Orchestra conducted by Rafael Payare. Berlioz’s Le carnaval romain and Symphonie fantastique will be recorded live during the concert."
      }
    ],
