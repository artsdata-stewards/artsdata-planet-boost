    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Stellar: the Organ’s Balancing Act - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Embark on a journey to the stars in this unique concert where the circus arts seamlessly blend with the majestic sounds of the Grand Orgue Pierre-Béique. Immerse yourself in this extraordinary spectacle, accompanied by the music of Philip Glass and Hans Zimmer’s awe-inspiring Interstellar Suite. Open up your eyes and ears: six circus artists will be performing on stage and in the air, responding to the sounds of the Grand Orgue. A breathtaking concert where technical skill, emotion, and pure wonder await!"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "en",
        "@value": "fr-CA"
      }
