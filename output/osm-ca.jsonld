    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Un souffle hispanique traverse ce concert, un fil incandescent reliant nature, mythe et fascination pour l’ailleurs. La <em>Symphonie n° 4</em> de Jimmy Lópe..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr",
