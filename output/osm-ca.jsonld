    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Transfigured Romanticism"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Embark on a journey through the depths of late Romanticism with two Viennese masters, as Schoenberg&rsquo;s Transfigured Night and Johanna Müller-Hermann&rsquo;s richly harmonic compositions ignite passion and rediscovery.</p>\n"
      }
    ]
  },
