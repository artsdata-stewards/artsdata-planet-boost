    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Whether for piano, violin, trumpet, even orchestra, get to know the concerto, a musical form that has travelled through the ages and continues to entice audiences.</p>\n<p><a href=\"https://www.osm.ca/en/news/my-dear-concerto-pedagogical-guide/\" target=\"_blank\" rel=\"noopener\"><strong>See pedagogical guide</strong></a></p>\n"
      }
    ]
