        "@language": "fr",
        "@value": "<div>L'artiste Kent Monkman, reconnu pour ses peintures épiques et symboliques, présente en avant-première des extraits de <em>The Miss Chief Cycle</em>, une..."
      }
    ],
    "http://ogp.me/ns#locale": [
