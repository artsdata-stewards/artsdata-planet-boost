      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Pour célébrer le temps des fêtes en musique, participez à ce concert lors duquel vous serez invités à chanter avec le Chœur de l’OSM : une expérience galvani..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr",
        "@value": "fr_ca"
      }
    ],
    "http://ogp.me/ns#type": [
