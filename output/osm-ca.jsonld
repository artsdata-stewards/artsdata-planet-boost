    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "It ‘’pops’’ with percussion!"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>From 7:00 p.m. to 10:00 p.m., take part in a dynamic and creative workshop to immerse yourself in the world of percussion instruments that “pop!” A fun and friendly experience that will appeal to your musical curiosity.</p>\n<p>Starting at 10:15 p.m., come and discover percussion instruments in an interactive exhibition, inluding our newest bells recently acquired by the OSM. A unique opportunity to discover these extraordinary instruments!</p>\n<p><strong>Takes place at Espace OSM<br />\nFree</strong></p>\n<p>1) Percussion Workshop<br />\n7:00 p.m. to 10:00 p.m.<br />\nEvery 30 minutes. Registration required</p>\n<p>2) Little Percussion Museum<br />\n10:15 p.m. to 1:00 a.m.<br />\nFree entry</p>\n<p><strong>With Instruments de musique Long &amp; McQuade – Event Partner</strong></p>\n"
      }
    ]
  },
