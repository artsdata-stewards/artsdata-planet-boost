    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Emanuel Ax Plays Beethoven  - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Let yourself be swept away by the masterful touch of eight-time Grammy winner Emanuel Ax as he brings his deep sensitivity to Beethoven’s Piano Concerto No.3, a fascinating bridge between the elegance of Classicism and the passion of Romanticism. Then, dive into the grandeur of Prokofiev’s Symphony No.5, a wartime masterpiece brimming with triumphant energy. The evening also features the world premiere of a new work by rising star Isabella Gellis, renowned for her refined and expressive compositions."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "en",
        "@value": "fr-CA"
      }
    ]
