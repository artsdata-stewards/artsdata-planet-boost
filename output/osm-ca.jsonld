      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Discover the brilliant pianist Yulianna Avdeeva, winner of the prestigious 2010 Chopin Competition, as she brings her masterful technique and poetic sensitivity to Chopin’s <em>Piano Concerto No. 1</em>. Her expressive depth and refinement promise to illuminate every note. Meanwhile, Schoenberg’s orchestration of Brahms’ <em>Quartet Op. 25</em> enhances its richness while remaining true to its original spirit—a transformation Brahms himself would have appreciated!</p>\n"
      }
