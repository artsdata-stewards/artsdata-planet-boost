    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Nature Urbaine - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "collectif9 propose un programme détonnant pour quintette à cordes et batterie qui explore plusieurs langages contemporains fortement enracinés dans des cultures folkloriques et urbaines avec le batteur Ronny Desinor. NATURE URBAINE présente des pièces de Gabriella Smith, Giovanni Sollima, Curtis Stewart, Vijay Iyer, John Zorn et Jessie Montgomery. La musique est groovy et percutante, mais aussi parfois dissonante et exploratoire, influencée par le jazz, le funk et la musique folk."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ]
  },
