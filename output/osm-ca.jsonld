    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Le Requiem Allemand par Kent Nagano"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Le chef émérite de l’OSM, Kent Nagano, dirige le poignant <em>Requiem allemand</em> de Brahms, tel qu&rsquo;il fut donné en 1868 à Brême en Allemagne. Cette version historique, présentée pour la toute première fois à l&rsquo;OSM, intègre des extraits d’œuvres baroques, de la <em>Passion selon St Matthieu</em> de Bach et du <em>Messie</em> de Handel. Ces pièces musicales mettent en perspective l&rsquo;héritage de Brahms et soulignent le lien du compositeur avec la grande tradition musicale germanique. Une œuvre qui invite à une réflexion profonde sur la vie et la mort. Un rendez-vous musical unique!</p>\n"
      }
    ]
  },
