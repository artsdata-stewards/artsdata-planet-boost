    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Ce programme établit un pont entre le XVIII<sup>e</sup> siècle et le XXI<sup>e</sup> pour offrir un fascinant contraste entre l’élégance classique de Mozart ..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr",
        "@value": "fr_ca"
      }
    ],
    "http://ogp.me/ns#type": [
