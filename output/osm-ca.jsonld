    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Wagner and Debussy: From Love to the Sea - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "This program highlights the viola’s deep, expressive voice in Canadian composer Cassandra Miller’s Concerto, a poignant reflection on separation premiered in 2023 by Lawrence Power, and an excerpt from Wagner’s Tristan and Isolde, both poignant reflections on separation. Meanwhile, Debussy paints a vivid portrait of the sea with impressionistic colours, immersing listeners in a nostalgic and dreamlike soundscape. Enjoy a musical journey that is both powerful and poetic. "
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "en",
        "@value": "fr-CA"
      }
    ]
