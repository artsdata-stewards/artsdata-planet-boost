        "@id": "_:g11372520"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.osm.ca/app/uploads/2024/01/concert-ensemble-a-tout-coup-1200x1200-1.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.osm.ca/fr/concert/ensemble-a-tout-coup/"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "_:g11372560"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.osm.ca/fr/concert/ensemble-a-tout-coup/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Ensemble à tout coup !"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<div class=\"wpb_text_column wpb_content_element \">\n<div class=\"wpb_wrapper\">\n<p><strong>Recommandé pour</strong> les élèves de 2<sup>e</sup> et 3<sup>e</sup> cycles du primaire</p>\n</div>\n</div>\n<div class=\"wpb_text_column wpb_content_element \">\n<div class=\"wpb_wrapper\">\n<p>Les percussionnistes du quatuor TorQ rêvent en grand ! Avec Adam Johnson à la direction, ils veulent réaliser des choses grandioses et vous invitent à les rejoindre lors d’un concert avec l’OSM. Venez découvrir les œuvres de Brahms, Bernstein et bien d’autres, dans une ambiance de camaraderie et de jeu d’ensemble.</p>\n</div>\n</div>\n"
      }
    ]
  },
