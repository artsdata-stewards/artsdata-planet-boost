    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "L’OSM vous propose un véritable feu d’artifice musical en présentant trois œuvres spectaculaires. <em>Le Concerto n<sup>o</sup> 1</em> de Tchaïkovski, interp..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr",
        "@value": "fr_ca"
