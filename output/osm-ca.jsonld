    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "L'Histoire du Soldat de Stravinsky - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Recommandé pour les élèves du 2e cycle du secondaire et élèves en concentration artistique Suivez les mésaventures d’un soldat aux prises avec le diable dans une œuvre originale de Stravinsky et de Ramuz. Mêlant théâtre, musique de scène et comédie, cette pièce reflète l’esprit du Paris de la Belle Époque avec une ambiance bon enfant et des influences de jazz et de ragtime."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
