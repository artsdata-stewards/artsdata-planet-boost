    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Piano et violoncelle : Un dialogue à travers les saisons - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Découvrez deux interprètes d’exception lors de ce concert où piano et violoncelle dialoguent au fil de compositions inspirées par la Nature. Évoquant la forêt avec la touche poétique de Dvořák, déployant élégance et virtuosité dans le virevoltant Papillon de Fauré, lyriques et graves avec Schubert, les deux instruments culminent dans une démonstration d’intensité signée Schnittke."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
