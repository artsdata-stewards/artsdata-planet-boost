        "@language": "en",
        "@value": "<span class=\"TextRun SCXW80932406 BCX0\" lang=\"FR-FR\" xml:lang=\"FR-FR\" data-contrast=\"auto\"><span class=\"NormalTextRun ContextualSpellingAndGrammarErrorV2Them..."
      }
