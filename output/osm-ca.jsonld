    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.osm.ca/en/concert/immortal-ravel/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Immortal Ravel"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Ravel’s <em>Tombeau de Couperin</em> pays homage to the rich French musical inheritance of the 18th century and to the composer’s comrades who fell in battle. Similarly, Escher’s composition honours Ravel in a distinctly French manner. Inspired by Baroque dances, both works feature intricately textured and nuanced instrumentation.</p>\n"
      }
    ]
  },
  {
