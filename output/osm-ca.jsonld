    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "<p><strong>Cirque Le Monastère</strong><br />\n<strong>Alexandre Alain</strong>, tissus aériens<br />\n<strong>Oona De Cleyn</strong>, suspension capillaire sur bungee<br />\n<strong>Manolo Gonzalo</strong>, numéro MultiLED<br />\n<strong>Cléa Perion</strong>, roue Cyr<br />\n<strong>Arthur Morel Van Hyfte</strong>, prisme aérien<br />\n<strong>Camille Tremblay</strong>, numéro d&rsquo;équilibre<br />\n<strong>Guillaume Blais</strong>, directeur créatif<br />\n<strong>Marie-Ève Demers</strong>, chorégraphe</p>\n"
      }
    ]
  },
