        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Festivités en chants et musiques - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Pour célébrer le temps des fêtes en musique, participez à ce concert lors duquel vous serez invités à chanter avec le Chœur de l’OSM : une expérience galvanisante! Avant le concert, prenez part à la répétition \"Chantons ensemble\" ! De 19h à 19h15, le chef d'orchestre Simon Rivard vous invite à répéter dans la salle de la Maison symphonique les chants que vous pourrez interpréter avec l'orchestre et le chœur durant le concert !"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ]
  },
