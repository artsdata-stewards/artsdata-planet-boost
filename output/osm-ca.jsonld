      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Imaginez Leipzig au cœur de l’hiver 1734 : une fine couche de neige tapisse les rues pavées, les cloches sonnent, la foule se presse dans l’église Saint-Thom..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
