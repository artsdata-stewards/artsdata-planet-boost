      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Beethoven’s masterful Piano Concerto no. 1 adheres to the rules of the Classical style, yet its lighthearted score, interspersed with inflections that foresh..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "en",
        "@value": "en_us"
      }
    ],
    "http://ogp.me/ns#type": [
