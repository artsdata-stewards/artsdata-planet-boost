    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Stravinsky et Ravel à l’orgue - Orchestre symphonique de Montréal"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://www.osm.ca/app/uploads/2023/12/40-stravinsky-ravel-osm-1080x1080-carre.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "<p><em>Le sacre du printemps</em> de Stravinsky et le <em>Boléro</em> de Ravel sont deux œuvres emblématiques du répertoire de l’OSM. Cependant, les avez-vou..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr",
        "@value": "fr_ca"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Stravinsky et Ravel à l’orgue - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le sacre du printemps de Stravinsky et le Boléro de Ravel sont deux œuvres emblématiques du répertoire de l’OSM. Cependant, les avez-vous déjà entendues à l’orgue?? Ce sont ces versions tout à fait surprenantes que vous proposent de découvrir quatre organistes réputés. Le temps d’un concert, le Grand Orgue Pierre-Béique devient orchestre pour réinventer deux chefs-d’œuvre grâce à ses timbres puissants et contrastés. Venez vivre ce moment unique !"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ]
  },
