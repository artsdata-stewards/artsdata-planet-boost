    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Zimmermann et le magistral Concerto pour violon de Brahms - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Frank Peter Zimmermann, l’un des plus grands violonistes actuels, interprétera le Concerto pour violon de Brahms. Dans cette œuvre quasi symphonique, l’orchestre et le soliste dialoguent d’égal à égal. Toutefois, c’est l’énergie festive du violon qui entrainera l’orchestre dans un finale enjoué aux accents tziganes. Contemporaine de Brahms, Emilie Mayer est une compositrice à découvrir : sa fascinante personnalité musicale s’affirme dans sa Symphonie no 7, une partition très originale parcourue d’élans passionnés."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ]
  },
