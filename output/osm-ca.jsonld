    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Schubert intensément! "
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Grâce à l’ajout d’un second violoncelle dans son <em>Quintette</em>, Schubert redessine les frontières de la musique de chambre et donne à son œuvre une ampleur quasi orchestrale. Sommet d’expressivité, <em>l’Adagio</em> revêt un caractère intemporel.</p>\n"
      }
    ]
  },
