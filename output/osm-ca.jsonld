    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "L’Orchestre et le Chœur de l’OSM accompagnent le mythique film de science-fiction réalisée par Stanley Kubrick, <em>2001 : L’Odyssée de l’espace</em>, pour u..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr",
