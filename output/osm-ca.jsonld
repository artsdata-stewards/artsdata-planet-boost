    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Piano et violoncelle : Un dialogue à travers les saisons"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Découvrez deux interprètes d’exception lors de ce concert où piano et violoncelle dialoguent au fil de compositions inspirées par la Nature. Évoquant la forêt avec la touche poétique de Dvořák, déployant élégance et virtuosité dans le virevoltant<em> Papillon</em> de Fauré, lyriques et graves avec Schubert, les deux instruments culminent dans une démonstration d’intensité signée Schnittke.</p>\n"
      }
    ]
  },
