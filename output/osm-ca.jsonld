    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "L’OSM vous invite à expérimenter comment écouter avec son corps, voir avec ses oreilles et ressentir avec ses mains en utilisant la danse, la musique et le dessin. Activité adaptée aux enfants de 3 à 12 ans avec ou sans besoins particuliers."
      }
    ],
