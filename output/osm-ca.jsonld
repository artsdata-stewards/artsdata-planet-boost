    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "L’OSM vous invite à vous installer bien confortablement dans la Maison symphonique pour vous emmener au cœur de l’hiver et de sa magie. Plongez dans la célèb..."
      }
    ],
    "http://ogp.me/ns#locale": [
