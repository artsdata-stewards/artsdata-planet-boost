    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Le grand retour de Kent Nagano avec l’OSM"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Pour son grand retour à Lanaudière en tant que chef émérite de l’Orchestre,Kent Nagano revisite des oeuvres phares de son répertoire, entourés de solistes de premier plan – ce soir, la majestueuse <em>Troisième</em> de Brahms et la subtile <em>Rhapsodie pour clarinette et orchestre</em> de Debussy, défendue par Todd Cope, clarinette-solo de l’OSM.</p>\n<p>Le concert a lieu dans le cadre du Festival de Lanaudière à l’Amphithéâtre Fernand-Lindsay</p>\n"
      }
    ]
  },
