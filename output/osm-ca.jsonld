    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "La Symphonie «Pathétique» de Tchaïkovski - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Plongez dans un tourbillon d’émotions avec deux chefs-d’œuvre poignants. D’abord, le Concerto pour violoncelle d'Elgar, où le soliste Nicolas Altstaedt mettra cet instrument en lumière avec une intensité saisissante. Ensuite la Symphonie n° 6 de Tchaïkovski, dans laquelle, sous des accents nostalgiques, un véritable drame intérieur se déploie. Entre tumulte des passions chez Tchaïkovski et mélancolie chez Elgar, chaque note sublime les tourments et les craintes."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ]
  },
