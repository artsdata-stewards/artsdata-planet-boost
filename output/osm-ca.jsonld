    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Join us for this musical celebration of the holidays, a concert during which you will be invited to sing along with the OSM Chorus—a soul-stirring experience!</p>\n<p><strong>Before the concert, take part in the ‘Let&rsquo;s sing together’ rehearsal! From 7 to 7.15 pm, conductor Simon Rivard invites you to rehearse the songs you&rsquo;ll be singing with the orchestra and choir during the concert!</strong></p>\n"
      }
