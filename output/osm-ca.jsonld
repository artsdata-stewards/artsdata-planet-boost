    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "L’intense Symphonie « Leningrad » de Chostakovitch - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Ce programme juxtapose la pétillante Symphonie no 8 de Beethoven et la puissante Symphonie «Leningrad» de Chostakovitch, une œuvre poignante qui incarne la force de la résistance face à l'oppression. Ce contraste saisissant entre la quête de joie et l’évocation d’un moment historique dramatique promet un concert intense et captivant."
      }
    ],
    "http://schema.org/inLanguage": [
