    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Raconte-moi ta musique avec Dina Gilbert"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>En conversation avec Oscar Salazar Varela, notre cheffe associée Dina Gilbert évoquera son parcours, ses sources d’inspiration, les œuvres du programme qu’elle dirigera en salle et sa future collaboration avec l’OSM. Une excellente occasion de découvrir l’univers et le travail d’une artiste québécoise!</p>\n"
      }
    ]
  },
