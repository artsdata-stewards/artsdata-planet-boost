      {
        "@language": "fr",
        "@value": "Vélo des Beaux-arts : Plaisir en famille - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Inspire-toi de souvenirs partagés en famille pour créer ta propre œuvre d’art. Cette activité s’inspire de la peinture de genre, un style artistique qui représente des moments de la vie de tous les jours. Commence par esquisser une scène de ton quotidien avec des crayons de cire, puis rends-la plus vivante en utilisant des marqueurs de bingo aux couleurs éclatantes. Laisse parler ta créativité pour illustrer la beauté de ce moment en famille."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
