    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "<p>L’Orchestre symphonique de Montréal clôturera avec brio sa 90e saison lors d’une soirée magistrale où quatre organistes de renom se partageront les clavie..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr",
        "@value": "fr_ca"
