    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "<p>Known for the dynamism and precision of his conducting, Maestro Juanjo Mena will lead the OSM in a program showcasing the harp. Driven by the distinctive ..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "en",
        "@value": "en_us"
      }
    ],
    "http://ogp.me/ns#type": [
