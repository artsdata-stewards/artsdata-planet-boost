    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Décors déformés, ombres inquiétantes, créatures hors du réel : Nosferatu le vampire réunit tous les codes du chef-d’œuvre expressionniste allemand. Réalisé e..."
      }
    ],
    "http://ogp.me/ns#locale": [
