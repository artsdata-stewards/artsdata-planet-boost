    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Ce programme réunit deux visions complémentaires de l’espoir : chez Beethoven, la<em> Symphonie n° 9</em> fait retentir l’appel à la fraternité universelle, ..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr",
        "@value": "fr_ca"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
