    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Attend an extraordinary screening of George Balanchine’s ballet, filmed at the Opéra de Paris. Set to music by Mendelssohn, Shakespeare’s play comes to life in a choreographic wonderland combining romantic intrigues and pantomime. Costumes and sets by Christian Lacroix enhance this magnificent performance. Dream away on a magical summer night!"
      }
    ],
