    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>The Mount Royal Youth Orchestra brings together passionate young performers for a soulful program full of contrasts, combining the Nordic poetry of <em>Peer Gynt,</em> the melodic intensity of Dvořák, and the radiant rhythms of « Jupiter, » from Holst&rsquo;s <em>The Planets</em>. A concert packed with energy to share.</p>\n"
      }
