    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://www.osm.ca/app/uploads/2026/03/payare-poulenc-sibelius-1080x1080-osm2627-ang.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Deux voix de la modernité se rencontrent ici : Poulenc et Sibelius, chacun ancré dans son époque, mais profondément attentif à l’héritage du passé. Ainsi, le..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr",
        "@value": "fr_ca"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
