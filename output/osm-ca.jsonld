      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Un concert de 60 minutes personnalisé selon <strong>VOS envies</strong> pour écouter les incontournables de la musique classique!  Et si l’on explorait le gr..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr",
        "@value": "fr_ca"
      }
    ],
    "http://ogp.me/ns#type": [
