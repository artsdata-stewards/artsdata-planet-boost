    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Barbara Hannigan returns for an electrifying evening, bringing the intoxicating rhythms of Offenbach and the sultry nostalgia of the tango in Youkali. Renowned for her stunning performances at the Maison symphonique in 2022 and 2024, the Canadian conductor and soprano is set to mesmerize with her extraordinary talent and magnetic presence in this bold and captivating program. See Barbara Hannigan in concert éclaté on February 5 at 8.30pm. "
      }
    ],
