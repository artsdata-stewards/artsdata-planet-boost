      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Des forêts enchantées de <em>Zelda</em> aux galeries souterraines de <em>Hollow Knight</em>, des planètes luxuriantes de <em>Super Mario Galaxy</em> aux dunes contemplatives de <em>Journey</em>, l’Orchestre de Jeux Vidéo propose une odyssée musicale où la nature devient souffle, mouvement et mémoire. Ces univers prennent vie sur scène pour rappeler combien le jeu vidéo, à sa manière, dialogue avec le monde vivant.</p>\n"
      }
    ]
