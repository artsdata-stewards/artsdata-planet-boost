    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Beethoven’s Heroic Symphony no. 3 with Kent Nagano - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Kent Nagano returns to the OSM to conduct works by two iconic composers: Stravinsky and Beethoven. The latter broke with Classicism and charted a course of Romanticism with his heroic “Eroica” Symphony, a landmark of both philosophical and political significance. Stravinsky, on the other hand, reconnected with tradition by drawing on Russian texts and folk melodies to compose Les noces, a work of undeniable originality and a testament to the composer’s creative vitality."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "en",
        "@value": "fr-CA"
      }
    ]
  },
