    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Discovery Trail: Octobass, Bells and the Maison symphonique"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>This discovery trail has some resonant surprises in store: you’ll have the special privilege of touring the Maison symphonique, a magnificent concert hall with exceptional acoustics; you’ll get to view and hear the OSM’s ten newly acquired carillon bells, as well as learning about the largest instrument of the string family: the octobass!</p>\n<p><strong><a href=\"https://www.osm.ca/en/concert/parcours-decouverte-octobasse-cloches-et-maison-symphonique/#discovery-trail\" target=\"_blank\" rel=\"noopener\">This activity is part of the Discovery Trail</a></strong></p>\n"
      }
    ]
  },
