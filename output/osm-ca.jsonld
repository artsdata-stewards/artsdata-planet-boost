    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Musique pour vents et piano"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Un même esprit lie les <em>Quintettes</em> de Beethoven et de Mozart : instrumentation rare, même tonalité et trois mouvements précédés d’une introduction lente. Beethoven oppose vents et piano soliste, Mozart privilégie le dialogue et quelques solos des vents. Découvrez Clémence de Granval, compositrice la plus jouée à Paris de son vivant.</p>\n<p>Concert de musique de chambre</p>\n<div style=\"background-color: #f8f4ff; border: 2px solid #7d50b3; padding: 25px; margin: 20px 0; border-radius: 0px; color: #2c2c2c; line-height: 1.6; box-shadow: 0 2px 5px rgba(0,0,0,0.05); width: 100%;\"><strong>PASTILLE MUSICALE <em>POÉTIQUE</em></strong> : ​<br />\nGrand classique du répertoire pour un voyage au coeur des émotions.</div>\n"
      }
    ]
  },
