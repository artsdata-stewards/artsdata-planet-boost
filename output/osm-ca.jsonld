    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Salebarbes meets the OSM - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "In October, the Acadian group Salebarbes will join the OSM. Throwing an invitation to Salebarbes is like making sure that the party will rise! The year 2025 of this group has been spectacular and the OSM is happy to welcome them on stage at the opening of its Pop series, to celebrate their huge success in a symphonic version. Under the direction of conductor Dina Gilbert and with symphonic arrangements by Antoine Gratton, get ready to kick your feet and live an evening you will remember for a long time."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "en",
        "@value": "fr-CA"
      }
    ]
