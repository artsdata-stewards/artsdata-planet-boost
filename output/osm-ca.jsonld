    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Labadie, Faust et les classiques viennois - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Deux grands interprètes sont réunis dans un programme consacré à deux figures emblématiques du classicisme viennois : Beethoven et Haydn. Ce dernier rompt audacieusement avec les conventions dans sa Symphonie n°103, tandis que Beethoven infuse une expressivité romantique dans son Concerto pour violon. Les mystérieuses interventions des timbales, qui ouvrent les deux œuvres, tissent un dialogue fascinant et surprenant offrant au public une expérience riche et inoubliable. Ne manquez pas cette occasion de redécouvrir deux des plus grands compositeurs de l’histoire de la musique."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ]
  },
