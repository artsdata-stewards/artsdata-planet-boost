      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "This program immerses us in the heroic world of Richard Strauss, where sweeping romantic fervor meets profound introspection. Death and Transfiguration opens..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "en",
        "@value": "en_us"
      }
