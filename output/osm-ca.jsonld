    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Ravel’s <em>Tombeau de Couperin</em> pays homage to the rich French musical inheritance of the 18th century and to the composer’s comrades who fell in battle..."
      }
    ],
    "http://ogp.me/ns#locale": [
