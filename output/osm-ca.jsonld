    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Mon beau concerto ! – Matinées scolaires"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Thomas Le Duc-Moreau dirigera l’OSM et trois lauréat.es du Concours OSM dans ce concert célébrant la relève et la forme musicale du concerto.</p>\n<p><strong>École secondaire? <a href=\"https://forms.office.com/r/8J00Fy1jck?origin=lprLink\">Inscrivez-vous ici</a>.</strong></p>\n<p>&nbsp;</p>\n<p><strong><a href=\"https://www.osm.ca/fr/actualites/guide-pedagogique-mon-beau-concerto/\" target=\"_blank\" rel=\"noopener\">Consulter le guide pédagogique</a> </strong></p>\n"
      }
    ]
  },
