    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Viennese Tradition - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "López plays with subtly modulated symmetrical phrases; Brahms offers an autumn-hued meditation that glorifies the clarinet; Schoenberg, in Weihnachtsmusik, weaves a dense polyphony around a chorale and the Christmas carol Stille Nacht; finally, his arrangement of the Kaiserwalzer reveals an inventive orchestration deeply rooted in the Viennese tradition. POETIC MUSICAL TAG: ​ A great classic of the repertoire that takes you on an emotional journey."
      }
    ],
