    "http://schema.org/url": [
      {
        "@id": "https://www.osm.ca/fr/concert/rafael-payare-et-limpressionnante-symphonie-no-8-de-chostakovitch/"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "_:g12852840"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
