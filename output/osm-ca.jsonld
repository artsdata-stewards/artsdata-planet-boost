    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Dubois – Biographie symphonique - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "A passionate artist, Claude Dubois has always sung our stories, our loves, and our joys. With Dubois Biographie symphonique, GSI Musique offers a creation in the artist’s image—free and vibrant—where each note becomes a memory and paints the portrait of an artist who continues to move and inspire. The result of many months of work, the singer-songwriter wished to offer an exclusively instrumental production as grand and memorable as the many songs he has shared with his audience throughout his prolific career. From Comme un million de gens to Si Dieu existe, each piece—performed without lyrics and carried by Scott Price’s orchestrations—reveals all the melodic richness and emotional depth of a repertoire firmly anchored in the collective memory. This symphonic concert is performed by l’Orchestre symphonique de Montréal and conducted by maestro Dina Gilbert."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "en",
        "@value": "fr-CA"
      }
    ]
  },
