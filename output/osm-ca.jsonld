    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p><span class=\"TextRun SCXW47242497 BCX0\" lang=\"FR-FR\" xml:lang=\"FR-FR\" data-contrast=\"auto\"><span class=\"NormalTextRun ContextualSpellingAndGrammarErrorV2Themed SCXW47242497 BCX0\">collectif</span><span class=\"NormalTextRun SCXW47242497 BCX0\">9</span></span><span class=\"TextRun SCXW47242497 BCX0\" lang=\"FR-FR\" xml:lang=\"FR-FR\" data-contrast=\"auto\"><span class=\"NormalTextRun SCXW47242497 BCX0\"> propose un programme détonnant pour quintette à cordes et batterie qui explore plusieurs langages contemporains fortement enracinés dans des cultures folkloriques et urbaines avec le batteur </span></span><span class=\"TextRun SCXW47242497 BCX0\" lang=\"FR-FR\" xml:lang=\"FR-FR\" data-contrast=\"auto\"><span class=\"NormalTextRun SCXW47242497 BCX0\">Ronny </span><span class=\"NormalTextRun SpellingErrorV2Themed SCXW47242497 BCX0\">Desinor</span></span><span class=\"TextRun SCXW47242497 BCX0\" lang=\"FR-FR\" xml:lang=\"FR-FR\" data-contrast=\"auto\"><span class=\"NormalTextRun SCXW47242497 BCX0\">. NATURE URBAINE présente des pièces de Gabriella Smith, Giovanni </span><span class=\"NormalTextRun SpellingErrorV2Themed SCXW47242497 BCX0\">Sollima</span><span class=\"NormalTextRun SCXW47242497 BCX0\">, Curtis Stewart, Vijay Iyer, John Zorn et Jessie Montgomery. La musique est </span><span class=\"NormalTextRun SpellingErrorV2Themed SCXW47242497 BCX0\">groovy</span><span class=\"NormalTextRun SCXW47242497 BCX0\"> et percutante, mais aussi parfois dissonante et exploratoire, influencée par le jazz, le funk et la musique folk.</span></span></p>\n"
      }
    ]
