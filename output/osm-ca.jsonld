        "@id": "https://www.osm.ca/fr/concert/la-symphonie-de-la-viree/"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "_:g14918180"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.osm.ca/fr/concert/la-symphonie-de-la-viree/"
