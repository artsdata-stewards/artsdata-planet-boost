    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "<strong>3 représentations à partir de 20h - 21h15 - 22h30</strong>  Entrez à la Maison symphonique pour une soirée éblouissante. Un brillant quintette de cui..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
