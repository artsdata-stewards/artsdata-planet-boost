    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "OSM Conductor Emeritus Kent Nagano leads a moving performance of Brahms’ A German Requiem, as it was presented in 1868 in Bremen, Germany. Making its debut at the OSM, this historic recreation includes excerpts from Baroque masterpieces such as Bach’s St. Matthew Passion and Handel’s Messiah. These musical selections offer insight into Brahms’ artistic heritage and underscore his profound connection to the rich German musical tradition. This masterpiece invites deep contemplation on life and death, promising a truly exceptional musical journey."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "en",
        "@value": "fr-CA"
      }
