    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>In May, under the baton of Kevin Zakresky, <em><strong>Heroes : A Video Game Symphony</strong></em> will immerse us in the greatest video game themes, from <em>Fallout </em>to<em> Assassin&rsquo;s Creed</em>, as well as <em>World of Warcraft</em> and <em>Final Fantasy</em>, with projections and sequences from these landmark games for several generations.</p>\n<p>Concert with screening</p>\n"
      }
