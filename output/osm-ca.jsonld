    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Joined by renowned soloists and commanding colossal vocal and instrumental means, Rafael Payare conducts a monument of the post-Romantic repertoire: Schoenberg’s <em>Gurre-Lieder</em>.</p>\n<p><strong>Here’s <a data-uw-original-href=\"https://www.osm.ca/en/news/five-good-reasons-to-come-and-hear-schoenbergs-gurre-lieder/\" data-uw-rm-brl=\"PR\" href=\"https://www.osm.ca/en/news/five-good-reasons-to-come-and-hear-schoenbergs-gurre-lieder/\">five good reasons to come and hear Schoenberg’s Gurre-Lieder!</a></strong></p>\n"
      }
