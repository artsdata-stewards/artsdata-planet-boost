      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://www.osm.ca/app/uploads/2025/04/osm2526_wagner-debussy_1080x1080_ang.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Dans ce programme, l’alto, avec ses sonorités profondes et émouvantes, exprime la douleur de la séparation qui résonne dans le <em>Concerto</em> de la compos..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
