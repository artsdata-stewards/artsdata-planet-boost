    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://www.osm.ca/app/uploads/2026/01/osm_cuivres-et-cloches-en-lumiere_1080x1080_en.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "<strong>3 représentations à partir de 20h - 21h15 - 22h30</strong>  Entrez à la Maison symphonique pour une soirée éblouissante. Un brillant quintette de cui..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr",
        "@value": "fr_ca"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Cuivres & Cloches en lumière - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "3 représentations à partir de 20h - 21h15 - 22h30 Entrez à la Maison symphonique pour une soirée éblouissante. Un brillant quintette de cuivres illuminera la scène, accompagné de la toute première présentation publique du spectaculaire carillon de 15 cloches. Ensemble, ils créeront des sonorités scintillantes et magiques, conçues pour captiver les publics de tous âges. Ce programme exceptionnel, pensé pour une atmosphère plus intimiste, constitue l’occasion idéale d’une première visite ou d’une redécouverte des musicien·nes l’Orchestre symphonique de Montréal. Trois performances de 30 minutes viendront rythmer la soirée, débutant par une présentation des cloches et culminant dans un concert lumineux. Pour rendre la soirée encore plus mémorable, la Maison symphonique ouvrira ses portes pour une visite autoguidée exclusive. Une célébration inoubliable de sons, de lumière et de découvertes, avec une touche de magie. Les cloches de carillon de l’Orchestre symphonique de Montréal ont été généreusement offertes par Canimex, Drummondville, Québec, Canada."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ]
  },
