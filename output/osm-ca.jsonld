    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Payare Conducts Berlioz and Beethoven - Orchestre symphonique de Montréal"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://www.osm.ca/app/uploads/2024/03/2024-09-19-payare-dirige-berlioz-et-beethoven-1080x1080-1.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Beethoven’s masterful Piano Concerto no. 1 adheres to the rules of the Classical style, yet its lighthearted score, interspersed with inflections that foresh..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "en",
        "@value": "en_us"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Payare Conducts Berlioz and Beethoven - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Beethoven’s masterful Piano Concerto no. 1 adheres to the rules of the Classical style, yet its lighthearted score, interspersed with inflections that foreshadow later works, announces the composer’s highly personal style. Since its premiere, Berlioz’s Symphonie fantastique has continued to elicit enthusiasm from audiences. Its originality, along with its colourful and potent orchestration, have elevated it to the status of an icon of the symphonic repertoire."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "en",
        "@value": "fr-CA"
      }
    ]
