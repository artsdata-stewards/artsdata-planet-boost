    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "L’après-concert - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Retrouvez les musiciens de l’OSM et les autres auditeurs autour d’un verre de vin et amorcez une conversation animée sur le répertoire et les thèmes du concert « Richard Strauss et Poulenc par Barbara Hannigan ». Une consommation sera offerte aux participants. Ouvert à tous les spectateurs du concert. Aucune réservation requise. Places limitées. Arrivez tôt. Premiers arrivés, premiers servis."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
