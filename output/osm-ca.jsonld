    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Avec Bach, rien n’est jamais ordinaire : tout est magistral. Compositeur de génie, pédagogue infatigable, artisan méticuleux, il savait tout faire avec les o..."
      }
    ],
    "http://ogp.me/ns#locale": [
