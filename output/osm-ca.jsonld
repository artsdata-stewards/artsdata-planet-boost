      {
        "@language": "fr",
        "@value": "En équipe avec ta famille, crée une sculpture miniature avec des cure-pipes et des papiers aux couleurs vives. Pour donner forme à ton imagination, observe t..."
      }
    ],
    "http://ogp.me/ns#locale": [
