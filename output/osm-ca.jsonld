    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "D’un quatuor à l’autre"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>À seize ans, Schubert signe un <em>Quatuor</em> plein d’élan, héritage de ses concerts familiaux. Debussy, quant à lui, apporte à son unique <em>Quatuor</em> des harmonies inédites et un lumineux jeu de couleurs sonores. Avec <em>Dreams</em>, Ian Cusson offre une musique évocatrice inspirée d’un film japonais, où chaque mouvement déploie son propre imaginaire.</p>\n<p>Concert de musique de chambre</p>\n<div style=\"background-color: #f8f4ff; border: 2px solid #7d50b3; padding: 25px; margin: 20px 0; border-radius: 0px; color: #2c2c2c; line-height: 1.6; box-shadow: 0 2px 5px rgba(0,0,0,0.05); width: 100%;\"><strong>PASTILLE MUSICALE <em>POÉTIQUE</em></strong> : ​<br />\nGrand classique du répertoire pour un voyage au coeur des émotions.</div>\n"
      }
    ]
  },
