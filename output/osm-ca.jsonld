      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://www.osm.ca/app/uploads/2026/03/cmim-grande-finale-1080x1080-1.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Vivez l’intensité du Concours musical international de Montréal avec l’Orchestre symphonique de Montréal, l’orchestre officiel du Concours, placé sous la dir..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr",
        "@value": "fr_ca"
      }
    ],
    "http://ogp.me/ns#type": [
