    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Conversation about the maqamat with Marwan Fakir and Rachid Zeroual - Orchestre symphonique de Montréal"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://www.osm.ca/app/uploads/2024/05/2024-08-17-les-maqams-avec-marwan-fakir-et-rachid-zerouai-1080x1080-1.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
