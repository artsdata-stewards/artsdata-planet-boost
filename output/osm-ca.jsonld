    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "<p>L’influence du classicisme viennois est perceptible dans la <em>Première Symphonie</em> de Beethoven. Cependant, dans cette partition d’une énergie enflam..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr",
        "@value": "fr_ca"
      }
    ],
    "http://ogp.me/ns#type": [
      {
