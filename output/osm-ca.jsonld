    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Le Double Concerto pour deux pianos de Glass - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Sous la direction de Fabien Gabel, l’OSM recevra les pianistes Katia et Marielle Labèque. Pour elles, Glass a écrit son Double Concerto pour deux pianos, une œuvre au cours de laquelle les solistes et l’orchestre tissent un tapis sonore en constante mouvance. La sensualité mélodique de la Danse des sept voiles de R. Strauss et de La tragédie de Salomé de Schmitt apportera une touche d’exotisme à ce programme."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ]
