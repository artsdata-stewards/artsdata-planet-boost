      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Enjoy this unusual improv match in which music and nature fuel creativity! Two teams of actors, accompanied by improvising musicians, will face off in a contest of daring and fun. Featuring free form, comparative and mixed jousts, audience members will get to vote for their favourites. What’s more, this match tips the hat to music lovers, with signature works of the repertoire. Excitement guaranteed!"
      }
