    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Isle of the Dead at the OSM "
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><strong>Put on your most spellbinding costume</strong> and let yourself be swept away by the dark and sumptuous melodies of Rachmaninov’s <strong><em>Isle of the Dead</em></strong>, accompanied by the mesmerizing film projection by Lucas van Woerkum: an audiovisual journey where fantasy and dread meet in a dazzling fashion. The unbridled virtuosity of Liszt’s <em>Totentanz</em> (Dance of Death), performed by Godwin Friesen, winner of the 2022 OSM Competition, will add a chilling brilliance, illustrating the eternal struggle between life and death. An evening of thrills and mystery, followed by festivities at the Maison symphonique.</p>\n<p><span style=\"text-decoration: underline;\">Program:</span><br />\n<strong>8:30 p.m. – Concert with film projection of Isle of the Dead</strong><br />\n<strong>9:30 p.m. – “Spooky Jazz” Halloween party</strong> in the Foyers, featuring the band <strong>Inspirationz</strong>. Enchanting atmosphere guaranteed!</p>\n<p>A complimentary cocktail will be offered at the Maison symphonique bars, courtesy of the <strong>Distillerie de Montréal</strong>. Limited quantities – first come, first served!</p>\n"
      }
    ]
  },
