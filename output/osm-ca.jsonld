        "@language": "en",
        "@value": "<strong>Put on your most spellbinding costume</strong> and let yourself be swept away by the dark and sumptuous melodies of Rachmaninov’s <strong><em>Isle of..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "en",
        "@value": "en_us"
      }
    ],
    "http://ogp.me/ns#type": [
