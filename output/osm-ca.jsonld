    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Aquaphonie - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "De rigoles en rigolades, Aquaphonie est un spectacle de théâtre de rue clownesque tout en fantaisie sur un sujet sérieux : la protection des ressources naturelles face à leur disparition. Dans une lointaine contrée oubliée règne encore un groupe de protecteurs des eaux. Trois clowns aquanautes en mission répertorient les eaux terrestres. Mais voilà que tout est compromis par une fuite dans leur réservoir principal. Le trio en panique fait jaillir des torrents de solutions toutes plus inefficaces les unes que les autres et se laisse emporter au courant de son imagination."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ]
  },
