    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Recommended for students in elementary cycle 2 and 3 The TorQ Quartet percussionists have great things in mind! With the common vision that unites them, they aspire to grow and to create spectacular artistic experiences. Follow their adventures with the OSM in works by Brahms, Bernstein, and many others! Adam Johnson conducts this concert where friendship and playing together come first!"
      }
