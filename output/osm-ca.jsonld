    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Dans ce récital, le pédalier du Grand Orgue Pierre-Béique sera magistralement dompté par l’organiste Jan Kraybill. Elle vous conduira de l’Allemagne baroque ..."
