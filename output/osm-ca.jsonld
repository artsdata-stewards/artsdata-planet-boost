    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Les pieds en fête! - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dans ce récital, le pédalier du Grand Orgue Pierre-Béique sera magistralement dompté par l’organiste Jan Kraybill. Elle vous conduira de l’Allemagne baroque de Bach aux États-Unis de Sowerby, pour une randonnée musicale très originale. À voir et à entendre! Concert d’orgue sans orchestre."
      }
    ],
