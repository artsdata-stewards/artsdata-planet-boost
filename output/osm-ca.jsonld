    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "L’orgue de Yes à Genesis - Orchestre symphonique de Montréal"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://www.osm.ca/app/uploads/2026/03/yes-genesis-1080x1080-osm2627-ang.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Tubular Bells réinventé par un grand orgue, Genesis propulsé par la pulsation des percussions, Yes et ELP revisités dans une tempête de riffs et de nappes so..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr",
        "@value": "fr_ca"
      }
    ],
    "http://ogp.me/ns#type": [
