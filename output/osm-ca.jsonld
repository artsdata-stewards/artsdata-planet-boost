      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Following his enthusiastic reception at the 2024 Virée classique summer concert, the talented oud player Joseph Tawadros makes his grand return to the OSM for two extraordinary concerts. He will be performing a dynamic piece inspired by the melodic modes of the Middle East, known as maqams, offering a vibrant and energetic musical experience. This powerful composition pairs seamlessly with the rhythmic drive of Beethoven’s Symphony No. 7, promising an evening filled with electrifying rhythms."
      }
    ],
