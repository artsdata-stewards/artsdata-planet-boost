      {
        "@language": "fr",
        "@value": "Des instrumentistes amateurs venus de tout le Québec se réunissent sous la direction d’Adam Johnson et de Rafael Payare pour un concert inspiré par la nature..."
      }
    ],
    "http://ogp.me/ns#locale": [
