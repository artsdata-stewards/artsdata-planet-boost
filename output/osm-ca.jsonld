      {
        "@id": "https://www.osm.ca/fr/concert/salebarbes-rencontre-losm/"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "_:g16520220"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.osm.ca/fr/concert/salebarbes-rencontre-losm/"
