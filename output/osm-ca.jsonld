        "@value": "Aquaphonie - Orchestre symphonique de Montréal"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://www.osm.ca/app/uploads/2025/06/toxic-trottoir-1080x1080-2.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "De rigoles en rigolades, Aquaphonie est un spectacle de théâtre de rue clownesque tout en fantaisie sur un sujet sérieux : la protection des ressources natur..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr",
        "@value": "fr_ca"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
