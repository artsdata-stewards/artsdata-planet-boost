    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "<p><strong>Chloé Chabanole</strong>, violon</p>\n<p><strong>TJ Skinner</strong>, violon</p>\n<p><strong>Cynthia Blanchon</strong>, alto</p>\n<p><strong>Andrea Stewart</strong>, violoncelle</p>\n<p><strong>Thibault Bertin-Maghit</strong>, contrebasse &amp; arrangements</p>\n<p><strong>Ronny Desinor</strong>, batterie</p>\n"
      }
    ]
