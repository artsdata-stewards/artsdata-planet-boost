    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Inspired by nature and animals, composers have long found creative sparks, and in <em>Wild Symphony</em> by bestselling author Dan Brown, young audiences follow Maestro Mouse on a joyful journey through the orchestra and its animal-inspired sounds.</p>\n<p>Benefit concert<br />\nIn French only</p>\n<div style=\"background-color: #f8f4ff; border: 2px solid #7d50b3; padding: 25px; margin: 20px 0; border-radius: 0px; color: #2c2c2c; line-height: 1.6; box-shadow: 0 2px 5px rgba(0,0,0,0.05); width: 100%;\"><strong><em>FAMILY</em> MUSICAL TAG: </strong>​<br />\nConcert for ages 6 and up that will delight the entire family.</div>\n"
      }
    ]
