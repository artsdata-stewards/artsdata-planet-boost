      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://www.osm.ca/app/uploads/2025/04/3f9ec768-4224-4deb-928e-8550f7e3fa9c.gif"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Marie-Ange Nguci, étoile montante du piano, fera ses débuts avec l’OSM dans le <i>Concerto n<sup>o</sup> 3 </i>de Rachmaninov, une œuvre brillante d’une redo..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr",
        "@value": "fr_ca"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Le Concerto pour piano nº 3 de Rachmaninov - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Marie-Ange Nguci, étoile montante du piano, fera ses débuts avec l’OSM dans le Concerto no 3 de Rachmaninov, une œuvre brillante d’une redoutable virtuosité. APÉRO SYMPHONIQUE Dès 17h30, prenez un verre au bar de la Maison symphonique et rencontrez l’humoriste Philippe-Audrey Larrue-St-Jacques dans une ambiance conviviale. De plus, ce concert vous propose une expérience immersive grâce à un guide d'écoute en temps réel. Cliquez ici pour en savoir plus!"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ]
