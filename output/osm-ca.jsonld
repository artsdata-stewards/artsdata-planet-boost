    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "<strong>Première partie : Atelier pédagogique Famille \"SOS concert: mission tempête de neige\" (19h00 – 22h00)</strong> - dans la limite des places disponible..."
      }
    ],
    "http://ogp.me/ns#locale": [
