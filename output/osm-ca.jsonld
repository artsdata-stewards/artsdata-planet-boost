    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Mahler’s Swan Song - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Rafael Payare continues the Mahler cycle he launched in 2022 with Symphony No. 9, an instrumental masterpiece of unparalleled richness, where every note resonates with deep emotion. In this work, Mahler evokes humanity’s reconciliation with the universe, weaving deep spirituality with moments of awe-inspiring beauty. A rare opportunity to experience a concert that is both musically intense and introspective."
      }
    ],
