      {
        "@language": "en",
        "@value": "From August 19 to 28, the OSM will embark on a tour of European festivals in four countries: Scotland, Poland, Denmark and Germany!  Our musicians will shine..."
      }
    ],
    "http://ogp.me/ns#locale": [
