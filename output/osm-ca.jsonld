    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Barbara Hannigan has some exciting surprises lined up for you in this edition of the Concerts éclatés series. Prepare for a vibrant and unforgettable evening..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "en",
        "@value": "en_us"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
