      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.osm.ca/en/concert/together-on-the-beat/"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "_:g11388140"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.osm.ca/en/concert/together-on-the-beat/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Together on the beat!"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<div class=\"wpb_text_column wpb_content_element \">\n<div class=\"wpb_wrapper\">\n<div class=\"wpb_text_column wpb_content_element \">\n<div class=\"wpb_wrapper\">\n<p><strong>Recommended for</strong> students in elementary cycle 2 and 3</p>\n</div>\n</div>\n<div class=\"wpb_text_column wpb_content_element \">\n<div class=\"wpb_wrapper\">\n<p>The TorQ Quartet percussionists have great things in mind! With the common vision that unites them, they aspire to grow and to create spectacular artistic experiences. Follow their adventures with the OSM in works by Brahms, Bernstein, and many others! Adam Johnson conducts this concert where friendship and playing together come first!</p>\n</div>\n</div>\n</div>\n</div>\n"
      }
    ]
  },
