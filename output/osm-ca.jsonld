    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Exilés aux États-Unis, Bartók et Korngold expriment avec émotion la nostalgie de leur terre natale à travers leurs <em>Concertos</em> : influences hongroises..."
      }
    ],
    "http://ogp.me/ns#locale": [
