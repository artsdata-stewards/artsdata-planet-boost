    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "The OSM presents three extraordinary works in an explosive musical fireworks display. Tchaikovsky’s <em>Piano Concerto No. 1</em>, performed by the brilliant..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "en",
        "@value": "en_us"
