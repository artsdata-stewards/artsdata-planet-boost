    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Voïvod symphonique - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Voïvod, le mythique groupe métal québécois, se joindra à l’OSM pour deux concerts exceptionnels dirigés par Dina Gilbert. Soyez des nôtres pour cet événement sensationnel! Des billets sont également en vente à la billetterie de la Place des Arts. &nbsp; Veuillez noter que des stroboscopes seront utilisés lors de la performance. L'exposition à ce type de lumière peut augmenter les risques d'épilepsie chez les personnes sensibles, même chez celles n'ayant jamais présenté de symptômes de cette maladie."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ]
