    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Masaaki Suzuki et la Passion selon saint Jean de Bach - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Spécialiste incontesté de la musique de Bach, Masaaki Suzuki retrouve l’OSM pour diriger l’émouvante Passion selon saint Jean. Sous la plume du compositeur, la musique métamorphose le texte sacré en accentuant son caractère tragique. Les récits de l’évangéliste, d’une ardente expressivité, sont le fil conducteur d’un drame ponctué par des arias contemplatifs. Quant aux chorals méditatifs confiés au chœur, ils charpentent l’œuvre et lui confèrent une dimension universelle et intemporelle."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ]
  },
