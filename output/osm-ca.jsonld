    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Grand Return of Kent Nagano with the OSM"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>The return of Kent Nagano to Lanaudière as the orchestra&rsquo;s honorary conductor, for the first time since 2021, alongside exceptional soloists and conducting works he has presented around the world for decades, is a moment to remember. This evening, he brings you Brahms&rsquo;s majestic 3rd <em>Symphony</em> and Debussy&rsquo;s subtle <em>Rhapsody for Clarinet and Orchestra,</em> with OSM principal clarinetist Todd Cope.</p>\n<p>The concert is part of the Festival de Lanaudière at the Amphithéâtre Fernand-Lindsay</p>\n"
      }
    ]
  },
