      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>From November 19 to 30, for its 59th international tour, the OSM will visit six countries and perform in eight of Europe&rsquo;s most prestigious concert halls: London, Luxembourg, Paris, Hamburg, Berlin, Amsterdam, Munich and Vienna!</p>\n"
      }
    ]
