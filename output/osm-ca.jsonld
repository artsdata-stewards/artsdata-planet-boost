    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Véronique Gens et la mélodie française - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Véritable hymne à la voix, ce programme rend hommage à la mélodie française de la Belle Époque pour un rendez-vous très attendu avec la soprano Véronique Gens. Laissez-vous captiver par la poésie de ces œuvres, rehaussée par l’élégance vocale et la musicalité raffinée d’une des plus grandes mélodistes contemporaines. Un événement pour les amoureux de la musique et de la mélodie française. Ce concert prestigieux est présenté en collaboration avec Editions musicales Palazzetto Bru Zane – Centre de musique romantique française, pour les mélodies de G. Fauré, de J. Massenet, et pour La Nuit et l’Amour d’A. Holmès."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ]
  },
