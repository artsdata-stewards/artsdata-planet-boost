    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><span class=\"TextRun SCXW95278457 BCX8\" lang=\"EN-CA\" xml:lang=\"EN-CA\" data-contrast=\"auto\"><span class=\"NormalTextRun SCXW95278457 BCX8\">This workshop invites participants to improvise with sonic material by activating and transforming pre-recorded sounds that originate from various sources (instruments, urban noises, synthesizers, etc.). </span></span><span class=\"TextRun SCXW95278457 BCX8\" lang=\"EN\" xml:lang=\"EN\" data-contrast=\"auto\"><span class=\"NormalTextRun SCXW95278457 BCX8\">Through manipulations, carried out using controllers and MIDI keyboards, you can explore computer-assisted sound creation in an intuitive and accessible way. In groups or individually, this fun experience is an excellent introduction to audio sampling and processing.</span></span><span class=\"EOP SCXW95278457 BCX8\" data-ccp-props=\"{}\"> </span></p>\n"
