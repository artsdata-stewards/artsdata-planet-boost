    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "L'orchestre sous toutes ses formes ! - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Recommandé pour les élèves de 2e et 3e cycles du primaire Guidés par nos animateurs Isabeau Blanche et Pierre-Louis Renaud, plongeons au cœur de l’orchestre pour faire plus ample connaissance avec ses quatre familles d’instruments, son histoire et quelques-uns de ses secrets!"
      }
    ],
