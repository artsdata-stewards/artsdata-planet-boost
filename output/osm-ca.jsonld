    "http://schema.org/url": [
      {
        "@id": "https://www.osm.ca/fr/concert/stravinsky-et-ravel-a-lorgue/"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "_:g11781580"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.osm.ca/fr/concert/stravinsky-et-ravel-a-lorgue/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Stravinsky et Ravel à l’orgue"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p><em>Le sacre du printemps</em> de Stravinsky et le <em>Boléro</em> de Ravel sont deux œuvres emblématiques du répertoire de l’OSM. Cependant, les avez-vous déjà entendues à l’orgue?? Ce sont ces versions tout à fait surprenantes que vous proposent de découvrir quatre organistes réputés. Le temps d’un concert, le Grand Orgue Pierre-Béique devient orchestre pour réinventer deux chefs-d’œuvre grâce à ses timbres puissants et contrastés. Venez vivre ce moment unique !</p>\n"
      }
    ]
  },
