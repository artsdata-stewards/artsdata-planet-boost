    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Projection familiale : Une guitare à la mer - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Une délicate fouine sillonne la campagne avec une guitare et sa petite valise, pour vendre de magnifiques cravates aux animaux de la ferme. Hélas, personne ne s’intéresse jamais à ses cravates aux couleurs chatoyantes… La petite fouine décide alors de tenter sa chance dans la forêt. Elle y rencontre un hérisson, qui aime la musique aussi, et un capybara, qui a traversé les mers avec son accordéon. Bientôt, sa vie va changer… Réalisé par Sophie Roze Film en VO (français &amp; espagnol) avec sous-titres en anglais © JPL Films / Nadasdy Film"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ]
