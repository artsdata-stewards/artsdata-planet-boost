    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Ce programme juxtapose la pétillante <em>Symphonie n</em><sup><em>o </em></sup><em>8</em> de Beethoven et la puissante <em>Symphonie</em> «Leningrad» de Chostakovitch, une œuvre poignante qui incarne la force de la résistance face à l&rsquo;oppression. Ce contraste saisissant entre la quête de joie et l’évocation d’un moment historique dramatique promet un concert intense et captivant.</p>\n"
      }
