    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Le célèbre Quintette « La truite » de Schubert"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Explorez l&rsquo;élégance des salons viennois avec Schubert et découvrez les trésors méconnus de la musique de chambre de George Onslow, accompagnés du pianiste primé Godwin Friesen, vainqueur du Concours OSM 2022.</p>\n"
      }
    ]
