    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Vibrez aux rythmes enivrants d’Offenbach et de la nostalgie sensuelle du tango dans <em>Youkali</em> avec Barbara Hannigan! Acclamée pour ses performances ex..."
      }
    ],
