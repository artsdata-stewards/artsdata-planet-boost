    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Hicky & Kalo - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Célébrez la nature et l’été avec les étoiles montréalaises de la scène électro. Le duo Hicky &amp; Kalo vous fera danser, vibrer au rythme des mélodies inspirées par la nature. Le projet « Entomophonie » de Leon Louder, ouvrira ce set par l’exploration sonore du monde des insectes. Le tout, illustré par la performeuse visuelle BunBun avec son univers coloré et rythmiquement synchronisé."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ]
