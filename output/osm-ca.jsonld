    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Chopin and Brahms: Masters of Romanticism  - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Discover the brilliant pianist Yulianna Avdeeva, winner of the prestigious 2010 Chopin Competition, as she brings her masterful technique and poetic sensitivity to Chopin’s Piano Concerto No. 1. Her expressive depth and refinement promise to illuminate every note. Meanwhile, Schoenberg’s orchestration of Brahms’ Quartet Op. 25 enhances its richness while remaining true to its original spirit—a transformation Brahms himself would have appreciated!"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "en",
        "@value": "fr-CA"
      }
