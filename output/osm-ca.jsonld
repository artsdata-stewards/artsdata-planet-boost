    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The music of Egyptian-born composer and oud virtuoso Joseph Tawadros draws from the wellsprings of Middle Eastern and Western musical traditions. Join him and Ensemble Obiora on a journey through vibrant, occasionally striking, but always resplendent, musical landscapes. Starting in Albéniz’s Spain, the voyage wraps up in Italy with Tchaikovsky’s fiery Souvenir de Florence, directed by Rafael Payare. Redirection to the Place des Arts website"
      }
    ],
