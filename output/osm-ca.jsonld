    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "L’OSM vous invite aux noces! Assistez à un événement musical unique, <em>Les noces de Figaro </em>de Mozart, dans une mise en espace originale. Laissez-vous ..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr",
        "@value": "fr_ca"
