    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Constellation de cordes – Centre des musiciens du monde - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dans ce concert original où se croisent résonances baroques et traditions musicales, l’inanga rwandaise, le théorbe médiéval, la vièle perse ghaychak et les airs celtiques des Maritimes s’entrelacent dans une œuvre en perpétuel mouvement. Entre improvisation et héritage, une fresque musicale prend vie à la croisée des cultures et des époques."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ]
