    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "By adding a second cello instead of the traditional second viola to his String  Quintet, Schubert redefined the boundaries of chamber music, giving his work an almost orchestral depth. The timeless Adagio is a pinnacle of expressiveness."
      }
