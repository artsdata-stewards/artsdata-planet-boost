      {
        "@language": "en",
        "@value": "<strong>3 performances from 8 p.m. - 9:15 p.m. - 10:30 p.m.</strong>  Step into the Maison symphonique for a dazzling evening. A brilliant brass quintet will..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "en",
        "@value": "en_us"
