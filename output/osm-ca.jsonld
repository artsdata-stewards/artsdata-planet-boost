    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Partagez des moments inoubliables en famille ou entre amis avec les concerts gratuits de l’OSM dans les parcs, magistralement dirigés par Rafael Payare et an..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr",
        "@value": "fr_ca"
      }
    ],
    "http://ogp.me/ns#type": [
