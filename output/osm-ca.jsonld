    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Tradition viennoise"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>López joue sur les phrases symétriques subtilement modulées; Brahms offre une méditation aux teintes automnales, magnifiant la clarinette; Schoenberg, dans <em>Weihnachtsmusik</em>, tisse une polyphonie dense autour d’un choral et du chant de Noël <em>Still Nacht</em>; enfin, son arrangement de la <em>Kaiserwalzer</em> révèle une orchestration inventive, profondément ancrée dans la tradition viennoise.</p>\n<div style=\"background-color: #f8f4ff; border: 2px solid #7d50b3; padding: 25px; margin: 20px 0; border-radius: 0px; color: #2c2c2c; line-height: 1.6; box-shadow: 0 2px 5px rgba(0,0,0,0.05); width: 100%;\"><strong>PASTILLE MUSICALE <em>POÉTIQUE</em></strong> : ​<br />\nGrand classique du répertoire pour un voyage au coeur des émotions.</div>\n"
      }
    ]
  },
