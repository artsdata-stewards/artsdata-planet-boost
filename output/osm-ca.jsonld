    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "L’impressionnante Symphonie no 2 de Rachmaninov"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Osmo Vänskä sera de retour à la Maison symphonique pour diriger la somptueuse <em>Symphonie n<sup>o</sup> 2 </em>de Rachmaninov, une œuvre oscillant entre intimité et exubérance.</p>\n"
      }
    ]
  },
