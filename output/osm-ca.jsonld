    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "L’après-concert"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Retrouvez les musiciens de l’OSM et les autres auditeurs autour d’un verre de vin et amorcez une conversation animée sur le répertoire et les thèmes du concert « Richard Strauss et Poulenc par Barbara Hannigan ».</p>\n<p>Une consommation sera offerte aux participants.</p>\n<p>Ouvert à tous les spectateurs du concert. <u>Aucune réservation requise.</u></p>\n<p><u>Places limitées. Arrivez tôt. Premiers arrivés, premiers servis.</u></p>\n"
      }
    ]
  },
