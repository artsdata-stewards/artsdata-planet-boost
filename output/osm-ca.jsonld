    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Stellaire : l’orgue fait son cirque - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "En route pour un voyage au milieu des étoiles où les arts du cirque jonglent habilement avec la multitude de sonorités du Grand Orgue Pierre-Béique. Découvrez ce spectacle inédit au son des musiques de Philip Glass et de la spectaculaire Suite Interstellar de Hans Zimmer. Ouvrez grand vos yeux et vos oreilles : six artistes circassiens performeront, sur scène et dans les airs, pour répondre aux sons du Grand Orgue. Un concert spectaculaire où virtuosité, émotion et émerveillement sont au programme!"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ]
