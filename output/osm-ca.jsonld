      {
        "@language": "en",
        "@value": "The OSM invites you to a very special wedding! Experience a one-of-a-kind musical event with an innovative staging of Mozart’s<em> Marriage of Figaro</em>. E..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
