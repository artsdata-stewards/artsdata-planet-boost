    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Celebrations in Songs and Music   - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Join us for this musical celebration of the holidays, a concert during which you will be invited to sing along with the OSM Chorus—a soul-stirring experience! Before the concert, take part in the ‘Let's sing together’ rehearsal! From 7 to 7.15 pm, conductor Simon Rivard invites you to rehearse the songs you'll be singing with the orchestra and choir during the concert!"
      }
    ],
