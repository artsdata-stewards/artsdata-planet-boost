    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Immortal Ravel - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Ravel’s Tombeau de Couperin pays homage to the rich French musical inheritance of the 18th century and to the composer’s comrades who fell in battle. Similarly, Escher’s composition honours Ravel in a distinctly French manner. Inspired by Baroque dances, both works feature intricately textured and nuanced instrumentation."
      }
    ],
