    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Clarinetist Kinan Azmeh captivates audiences with his fluid, nuanced playing and remarkable improvisational talent. Joined by the OSM, he will showcase a program that blends creative freedom, Bartók’s folk-inspired motifs, and Carl Philipp Emanuel Bach’s innovative sensitivity. The evening concludes with Mozart’s graceful and elegant Symphony No. 39."
      }
