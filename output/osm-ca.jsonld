    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Constellation de cordes – Centre des musiciens du monde - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "In this inventive concert where echoes of the Baroque and musical traditions intersect, the Rwandan inanga, the medieval theorbo, the Persian ghaychak fiddle, and Celtic tunes from the Maritimes all intertwine to create a work in constant motion. Through improvisation and tradition, this musical tableau will come alive with many meeting points between cultures and eras."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "en",
        "@value": "fr-CA"
      }
    ]
  },
