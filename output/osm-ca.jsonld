    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Vivez une expérience virtuelle immersive en vous mettant dans la peau d’un chef d’orchestre grâce à Partitura !  Choisissez parmi une sélection d’œuvres de V..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr",
        "@value": "fr_ca"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Réalité virtuelle : Partitura - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Vivez une expérience virtuelle immersive en vous mettant dans la peau d’un chef d’orchestre grâce à Partitura ! Choisissez parmi une sélection d’œuvres de Vivaldi, Dvořák ou Ana Sokolović et retrouvez-vous sur le podium de la Maison symphonique avec devant vous, un orchestre à cordes formé de musicien(ne)s de l’OSM. Suivez la partition et, grâce à votre baguette virtuelle, isolez le groupe d’instruments de votre choix pour mieux apprécier ses sonorités. C’est une rare occasion de démystifier l’environnement du chef d’orchestre et d’explorer le langage de la musique classique!"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ]
  },
