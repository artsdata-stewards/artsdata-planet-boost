    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "In this edition of the Concerts éclatés series, discover the acclaimed clarinetist Kinan Azmeh, widely praised by critics for his instrumental mastery and ve..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "en",
        "@value": "en_us"
