      {
        "@language": "en",
        "@value": "When Zubin Mehta raises the baton, an entire sonic world unfolds. A legendary conductor and iconic figure of the OSM, he returns to lead Bruckner’s monumenta..."
      }
    ],
    "http://ogp.me/ns#locale": [
