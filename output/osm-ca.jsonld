      {
        "@language": "en",
        "@value": "Piazzolla revolutionized tango by infusing it with a new freedom: an urban, edgy, poetic breath where the bandoneon becomes the narrator of raw emotions and ..."
      }
    ],
    "http://ogp.me/ns#locale": [
