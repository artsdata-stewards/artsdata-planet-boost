    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Assistez à l’enregistrement du quatrième album de l’OSM lors d’un concert exceptionnel donné par l’Orchestre, dirigé par Rafael Payare. <em>Le carnaval romain </em>et la Symphonie fantastique de Berlioz seront enregistrés en public.</p>\n<p><img decoding=\"async\" src=\"https://www.osm.ca/app/uploads/2024/11/concert-19-dec-fr.jpg\" alt=\"\" /></p>\n"
      }
