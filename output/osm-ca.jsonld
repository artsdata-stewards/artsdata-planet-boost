    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "López’s symphonic poem <em>Aino</em> is a beautiful tribute to Finland, while Dvořák affirms his Slavic identity in his <em>Symphony No. 6</em> by using mate..."
