    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The OSM is delighted to welcome the TSO and conductor Gustavo Gimeno in a programme featuring the exceptional voice of mezzo-soprano Emily D'Angelo. They perform enargeia, a suite of art songs by female composers from medieval times to the present day arranged by Jarkko Riihimäki. To complete the program: Brahms' dramatically intense and creatively powerful Symphony no. 1."
      }
    ],
