  {
    "@id": "_:g15524900",
    "@type": [
      "http://schema.org/Person"
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "<p><strong>Conteurs à gages</strong></p>\n<p><strong>Félix Morissette</strong>, conteur</p>\n<p><strong>Catherine Robert</strong>, conteuse</p>\n<p><strong>Éliane Charest-Beauchamp</strong>, violon</p>\n<p><strong>Dominique Bégin</strong>, violon</p>\n"
      }
    ]
  },
  {
    "@id": "https://www.osm.ca/temporary/98732b29-17d8-4110-983b-2e01aec6503d",
    "@type": [
