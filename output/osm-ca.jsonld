    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://www.osm.ca/app/uploads/2026/02/petrouchka-1080x1080-osm-2026-2027-en-pastille.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "<em>Petrouchka</em>, c’est toute la magie de la marionnette qui soudain prend vie, avec son lot de charme, d’espièglerie et de maladresse touchante. Stravins..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr",
        "@value": "fr_ca"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
