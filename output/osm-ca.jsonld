    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Intense Leningrad Symphony by Shostakovich  - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "This program contrasts Beethoven’s vibrant Symphony No. 8 with Shostakovich’s powerful Leningrad Symphony, a poignant work that captures the spirit of resistance to oppression. The striking juxtaposition of Beethoven’s joy and Shostakovich’s depiction of a dramatic historical moment promises an intense and captivating concert experience."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "en",
        "@value": "fr-CA"
      }
