    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Trick or Treat! – School matinees"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Recommended for all elementary school levels</p>\n<p>Presented in French</p>\n<p>Have you ever wondered if the Maison Symphonique might be haunted by monsters and vampires? Could a conductor’s baton double as a magic wand? What if music truly held magical powers? To find out, dress up in your best costume and step into a world of imagination, where you’ll hear strange tales told by mysterious creatures. Let the magic of music sweep you away!</p>\n<p><strong><a href=\"https://www.osm.ca/en/news/trick-or-treat-pedagogical-guide/\">See pedagogical guide</a> </strong></p>\n"
      }
    ]
  },
