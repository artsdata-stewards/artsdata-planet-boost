    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Seasons of Vivaldi and Piazzola"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Vivaldi’s Baroque-era panache and Piazzolla’s Argentinian tango join in a dialogue that spans the seasons, under the direction of violinist and conductor Rosanne Philippens.</p>\n"
      }
    ]
  },
