    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "With Bach, nothing is ever ordinary—everything is monumental. A visionary composer, an tireless teacher, and a meticulous craftsman, he mastered every aspect..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "en",
