    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Flamboyant Barbara Hannigan "
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Barbara Hannigan returns for an electrifying evening, bringing the intoxicating rhythms of Offenbach and the sultry nostalgia of the tango in <em>Youkali</em>. Renowned for her stunning performances at the Maison symphonique in 2022 and 2024, the Canadian conductor and soprano is set to mesmerize with her extraordinary talent and magnetic presence in this bold and captivating program.</p>\n<p><a href=\"https://my.osm.ca/3716/3717\" data-cke-saved-href=\"https://my.osm.ca/3716/3717\"><strong>See Barbara Hannigan in concert éclaté on February 5 at 8.30pm. </strong></a></p>\n"
      }
    ]
  },
