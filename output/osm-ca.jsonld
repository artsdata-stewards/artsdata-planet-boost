      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://www.osm.ca/app/uploads/2026/02/trois-piano-mozart-1080x1080-osm-2026-2027-en-pastille.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Mozart en <em>sol</em> mineur : une couleur rare, presque une signature émotionnelle. Dans la<em> Symphonie n° 25</em>, le jeune Mozart éclate dans un <em>St..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr",
        "@value": "fr_ca"
