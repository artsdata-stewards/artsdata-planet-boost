    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://www.osm.ca/app/uploads/2024/01/concert-sportissimo-1200x1200-1.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "<div class=\"wpb_text_column wpb_content_element \"> <div class=\"wpb_wrapper\">  <strong>Recommandé pour</strong> les élèves du 3<sup>e</sup> cycle du primaire ..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr",
        "@value": "fr_ca"
      }
    ],
    "http://ogp.me/ns#type": [
