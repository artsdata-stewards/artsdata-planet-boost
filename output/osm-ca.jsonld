    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Enchanting Firebird by Stravinsky "
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Canadian pianist Jaeden Izik-Dzurko, who launched a stellar career after winning the 2022 OSM Competition, the 2024 Concours musical international de Montréal and the Leeds International Piano Competition, takes the stage in this intimate concert hosted by Philippe-Audrey Larrue-St-Jacques. Hear him perform Grieg’s <em>Piano Concerto</em>, a piece known for its captivating mix of lyricism and vigour. Then, allow yourself to be swept away by the enchanting beauty of <em>The Firebird</em>, where lush orchestral colours paint a mesmerizing sonic landscape.</p>\n<p>Arrive early: the first 120 drinks will be free, courtesy of Boréale!</p>\n"
      }
    ]
  },
