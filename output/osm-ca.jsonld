    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Emily D'Angelo et le TSO à la Maison symphonique - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "L’OSM a le plaisir d’accueillir le TSO et son chef Gustavo Gimeno dans un programme mettant à l’honneur la voix exceptionnelle de la mezzo-soprano Emily D’Angelo. Cette dernière interprètera enargeia, une suite de mélodies de diverses compositrices du Moyen Âge et de notre époque, arrangées par Jarkko Riihimäki. La Symphonie no 1 de Brahms, une œuvre d’une grande intensité dramatique, mue par un puissant élan créateur, complètera ce programme."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ]
  },
