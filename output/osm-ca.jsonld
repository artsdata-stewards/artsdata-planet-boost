    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Haydn played a key role in the evolution of the string quartet, and his final Quartet Op. 77  No. 2 is full of subtle experimentation that is both inventive and elegant. Meanwhile, Shostakovich reinterprets classical forms in his Quintet, infusing it with his deeply personal language and profound emotional intensity."
      }
