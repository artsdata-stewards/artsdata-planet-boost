    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Symphonie «Pastorale» et la mythologie de Glass - Orchestre symphonique de Montréal"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://www.osm.ca/app/uploads/2025/03/apero_glass_20mars_ang.gif"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "De la mythologie du Bénin, célébrée par la chanteuse Angélique Kidjo, à la nature bucolique représentée dans la <i>symphonie</i> «Pastorale», vivez un délici..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr",
        "@value": "fr_ca"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Symphonie «Pastorale» et la mythologie de Glass - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "De la mythologie du Bénin, célébrée par la chanteuse Angélique Kidjo, à la nature bucolique représentée dans la symphonie «Pastorale», vivez un délicieux moment d’évasion! APÉRO SYMPHONIQUE Dès 17h30, prenez un verre au bar de la Maison symphonique et rencontrez l’humoriste Philippe-Audrey Larrue-St-Jacques dans une ambiance conviviale. De plus, ce concert vous propose une expérience immersive grâce à un guide d'écoute en temps réel. Cliquez ici pour en savoir plus!"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ]
  },
