    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "De l’Europe au cinéma - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Concert en formule Apéro symphonique où nostalgie, racines européennes et mélodies hollywoodiennes vous transporteront! Ce concert de 60 minutes vous donnera également l’occasion de rencontrer l’humoriste Philippe-Audrey Larrue-St-Jacques, hôte de la soirée et de découvrir ou de redécouvrir la violoniste Simone Lamsma, acclamée lors de sa performance en 2024! Aussi disponible en concert régulier le 3 décembre à 19h30"
      }
    ],
