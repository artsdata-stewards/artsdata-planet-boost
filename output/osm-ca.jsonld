        "@language": "fr",
        "@value": "<p><span style=\"text-decoration: underline;\"><strong>Concert de 15 h 30</strong></span></p>\n<ul>\n<li>15h30 &#8211; Henry Webb</li>\n<li>16h30 &#8211; Mélodie Michel</li>\n</ul>\n<p><span style=\"text-decoration: underline;\"><strong>Concert de 19 h 00</strong></span></p>\n<ul>\n<li>19h &#8211; Johannes Skoog</li>\n<li>20h &#8211; Alma Bettencourt</li>\n</ul>\n"
      }
