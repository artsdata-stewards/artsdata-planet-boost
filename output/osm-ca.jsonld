    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "L'OSM reçoit l'Orchestre de Paris - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dirigé par son talentueux chef Klaus Mäkelä, l'Orchestre de Paris accompagnera le jeune prodige Yunchan Lim dans le célèbre Concerto pour piano no 2 de Rachmaninov. Il sera encadré par deux œuvres annonciatrices des grands changements esthétiques du XXe siècle : le Prélude à l'après-midi d'un faune de Debussy, riche d'inventivité mélodique et de couleurs féériques, et L'Oiseau de feu de Stravinsky, dont les splendeurs orchestrales rivalisent avec les audaces rythmiques."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ]
