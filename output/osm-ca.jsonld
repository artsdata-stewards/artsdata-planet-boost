    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Labadie, Faust et les classiques viennois - Orchestre symphonique de Montréal"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://www.osm.ca/app/uploads/2025/03/osm2526_labadie-faust_1080x1080_ang.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Deux grands interprètes sont réunis dans un programme consacré à deux figures emblématiques du classicisme viennois : Beethoven et Haydn. Ce dernier rompt au..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr",
        "@value": "fr_ca"
      }
    ],
    "http://ogp.me/ns#type": [
