    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Legendary Quebec metal band Voïvod teams up with the OSM in two awesome concerts conducted by Dina Gilbert. Join us for this thrilling event! Tickets are also available at the Place des Arts box office. &nbsp; Please note that strobe lights will be used during the performance. Exposure to this type of lighting may increase the risk of epilepsy in sensitive individuals, even in those who have never experienced symptoms of the condition. &nbsp;"
      }
