    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "In this concert, Handel’s masterful storytelling brings the narrative of Christ to vivid musical life. The powerful chorus elevates this iconic work with extraordinary energy and depth. This is a unique chance to experience one of Handel’s greatest masterpieces under the baton of Rafael Payare—a holiday classic not to be missed!"
      }
