    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "À 100 ans, <em>Le fantôme de l’opéra </em>n’a pas pris une ride! Redécouvrez ce chef-d’œuvre du cinéma fantastique de 1925 illustré musicalement par l’organi..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
