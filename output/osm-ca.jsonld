    "http://schema.org/performer": [
      {
        "@id": "_:g15578520"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.osm.ca/fr/concert/le-concerto-pour-piano-no-3-de-rachmaninov/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Le Concerto pour piano nº 3 de Rachmaninov"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Marie-Ange Nguci, étoile montante du piano, fera ses débuts avec l’OSM dans le <i>Concerto n<sup>o</sup> 3 </i>de Rachmaninov, une œuvre brillante d’une redoutable virtuosité.</p>\n<p style=\"text-align: center;\"><strong>APÉRO SYMPHONIQUE</strong></p>\n<p><strong>Dès 17h30, prenez un verre au bar de la Maison symphonique et rencontrez l’humoriste Philippe-Audrey Larrue-St-Jacques dans une ambiance conviviale.</strong></p>\n<p><a href=\"https://www.osm.ca/fr/guide-decoute-en-temps-reel/\"><span data-teams=\"true\">De plus, ce concert vous propose une expérience immersive grâce à un guide d&rsquo;écoute en temps réel. Cliquez ici pour en savoir plus!</span></a></p>\n"
      }
    ]
  },
