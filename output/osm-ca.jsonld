    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "La Symphonie de la Virée"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Des instrumentistes amateurs venus de tout le Québec se réunissent sous la direction d’Adam Johnson et de Rafael Payare pour un concert inspiré par la nature. Des <em>Hébrides</em> de Mendelssohn au faucon mythique d’Ichmouratov, avec une escapade au Québec et dans les Appalaches, c’est l’incontournable rendez-vous musical de la Virée classique!</p>\n"
      }
    ]
  },
