      {
        "@language": "fr",
        "@value": "<p>Dirigé par son talentueux chef Klaus Mäkelä, l'Orchestre de Paris accompagnera le jeune prodige Yunchan Lim dans le célèbre Concerto pour piano no 2 de Ra..."
      }
    ],
    "http://ogp.me/ns#locale": [
