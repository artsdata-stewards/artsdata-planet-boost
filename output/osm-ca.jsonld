    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "La jeunesse et le talent sont au rendez-vous pour ce concert : trois musiciennes de l’OSM et deux lauréats du Concours OSM uniront leur énergie et leur sensi..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr",
        "@value": "fr_ca"
