    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Fantastic Berlioz!"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Experience the OSM’s fourth album recording under Pentatone Record Label by attending an exceptional concert given by the Orchestra conducted by Rafael Payare. Berlioz’s Le carnaval romain and Symphonie fantastique will be recorded live during the concert.</p>\n<p><img decoding=\"async\" src=\"https://www.osm.ca/app/uploads/2024/11/concert-19-dec-an.jpg\" alt=\"\" /></p>\n"
      }
    ]
  },
