    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Viennese Tradition"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>López plays with subtly modulated symmetrical phrases; Brahms offers an autumn-hued meditation that glorifies the clarinet; Schoenberg, in Weihnachtsmusik, weaves a dense polyphony around a chorale and the Christmas carol Stille Nacht; finally, his arrangement of the Kaiserwalzer reveals an inventive orchestration deeply rooted in the Viennese tradition.</p>\n<div style=\"background-color: #f8f4ff; border: 2px solid #7d50b3; padding: 25px; margin: 20px 0; border-radius: 0px; color: #2c2c2c; line-height: 1.6; box-shadow: 0 2px 5px rgba(0,0,0,0.05); width: 100%;\"><strong><em>POETIC</em> MUSICAL TAG: </strong>​<br />\nA great classic of the repertoire that takes you on an emotional journey.</div>\n"
      }
    ]
  },
