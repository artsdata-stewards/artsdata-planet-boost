    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>The music of Egyptian-born composer and oud virtuoso Joseph Tawadros draws from the wellsprings of Middle Eastern and Western musical traditions. Join him and Ensemble Obiora on a journey through vibrant, occasionally striking<u>,</u> but always resplendent, musical landscapes. Starting in Albéniz’s Spain, the voyage wraps up in Italy with Tchaikovsky’s fiery <em>Souvenir de Florence</em>, directed by Rafael Payare.</p>\n<p>Redirection to the Place des Arts website</p>\n"
      }
