    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Une odyssée musicale avec Zelda & Mario - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Des forêts enchantées de Zelda aux galeries souterraines de Hollow Knight, des planètes luxuriantes de Super Mario Galaxy aux dunes contemplatives de Journey, l’Orchestre de Jeux Vidéo propose une odyssée musicale où la nature devient souffle, mouvement et mémoire. Ces univers prennent vie sur scène pour rappeler combien le jeu vidéo, à sa manière, dialogue avec le monde vivant."
      }
    ],
    "http://schema.org/inLanguage": [
      {
