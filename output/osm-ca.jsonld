    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Lors de ce concert éclaté, Barbara Hannigan vous réserve quelques surprises. Musique et danses sont au rendez-vous en compagnie d’œuvres d’Offenbach, Weill, ..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
