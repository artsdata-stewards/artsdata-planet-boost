    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Mediterranean excursion with the OSJM - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Under the direction of Louis Lavigueur, the talented Orchestre symphonique des jeunes de Montréal presents a program that traverses the sun-drenched lands of the Mediterranean. Vibrant works will punctuate your route from Provence to Spain. Justin Saulnier, Second Prize winner of the 2023 OSM Competition, will take centre stage in Lalo’s impassioned Symphonie espagnole."
      }
    ],
