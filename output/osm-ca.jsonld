    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Wagner et la légende de l’Anneau - Orchestre symphonique de Montréal"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://www.osm.ca/app/uploads/2025/03/osm2526_wagner-legende-de-lanneau_1080x1080_ang.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "<em>Le Ring sans paroles</em> est une suite orchestrale composée à partir des thèmes musicaux les plus marquants de la tétralogie <em>L’anneau du Nibelung</e..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr",
        "@value": "fr_ca"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Wagner et la légende de l’Anneau - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le Ring sans paroles est une suite orchestrale composée à partir des thèmes musicaux les plus marquants de la tétralogie L’anneau du Nibelung de Richard Wagner. Cette version condense l’essence musicale de l’œuvre monumentale de près de 15 heures en une fresque symphonique de 70 minutes. Le Ring de Wagner c’est la quête et la malédiction de l’anneau de pouvoir. Cet anneau magique forgé par le nain Alberich avec l'or volé du Rhin donne un pouvoir absolu, mais apporte ruine et destruction à ses possesseurs. Wotan, roi des dieux, tente de contrôler l’anneau, mais son plan échoue et mène à la chute des dieux. Le héros Siegfried, manipulé et trahi est tué par Hagen, fils d'Alberich. Sa veuve la walkyrie Brünnhilde, fille de Wotan, restitue l’anneau aux eaux du Rhin, scellant ainsi la fin d’un monde. Le Ring sans paroles offre une immersion intense dans cet univers wagnérien, mettant en valeur les moments les plus emblématiques en une seule symphonie, le prélude de L’or du Rhin, La Walkyrie, Siegfried et la fin apocalyptique du Crépuscule des Dieux. Entre le lyrisme exalté du Concerto de Schumann, interprété par le pianiste Yefim Bronfman, et le pouvoir destructeur de l’or dans Le Ring de Wagner, des forces opposées se déchaînent pour un concert de clôture qui marquera une fin de saison spectaculaire !"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ]
  },
