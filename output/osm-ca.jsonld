    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "The <em>Ring Without Words</em> is an orchestral suite that distills the most iconic themes from Richard Wagner’s monumental tetralogy, The <em>Ring of the N..."
      }
    ],
    "http://ogp.me/ns#locale": [
