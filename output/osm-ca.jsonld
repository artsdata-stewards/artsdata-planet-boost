    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Du 19 au 28 août, pour sa 60<sup>e</sup> tournée internationale, l’OSM visitera quatre pays et se produira dans les grands festivals européens : Écosse, Polo..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr",
        "@value": "fr_ca"
