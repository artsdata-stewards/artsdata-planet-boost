    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Strings and Saxophone - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "This program creates a bridge between the 18th and 21st centuries, offering a striking contrast between the classical elegance of Mozart and Bologne and the dramatic intensity of Banks and López. Each piece highlights a distinct facet of the string quartet. Steven Banks, the renowned ambassador of classical saxophone, will also demonstrate how his instrument adds a unique flavour when paired with strings!"
      }
    ],
