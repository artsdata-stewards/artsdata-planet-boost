    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Music of Harry Potter"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Since the release of the film <em>Harry Potter and the Sorcerer’s Stone 25 years ago</em>, the beloved fantasy series and its Hogwarts characters have continued to captivate audiences. Relive the unforgettable melodies from these iconic films, composed by John Williams. Whether you belong to Slytherin, Gryffindor, Hufflepuff, or Ravenclaw, don your house colours and bring the entire family for this magical adventure!</p>\n<p>Concert without screening</p>\n"
      }
    ]
  },
