    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Célébrez la nature et l’été avec les étoiles montréalaises de la scène électro. Le duo Hicky & Kalo vous fera danser, vibrer au rythme des mélodies inspirées..."
      }
    ],
    "http://ogp.me/ns#locale": [
