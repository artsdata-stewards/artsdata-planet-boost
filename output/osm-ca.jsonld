    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Suivez un match d’improvisation inédit où musique et nature inspirent la créativité! Deux équipes de comédiens, accompagnées de musiciens improvisateurs, s’affrontent avec audace et humour. Entre joutes libres, comparées et mixtes, le public vote pour ses favoris. Sans oublier un clin d’œil aux mélomanes avec des œuvres phares du répertoire. Sensations garanties!"
      }
    ],
