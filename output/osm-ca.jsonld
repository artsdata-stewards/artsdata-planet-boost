    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Quatuor n° 1 de Smetana: une vie en 4 mouvements - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "La jeunesse et le talent sont au rendez-vous pour ce concert : trois musiciennes de l’OSM et deux lauréats du Concours OSM uniront leur énergie et leur sensibilité pour mettre à l’honneur une composition de Friesen et une œuvre de jeunesse de Chostakovitch. Tout en retraçant les principales étapes de sa vie, Smetana évoque également l’effervescence de ses jeunes années dans son émouvant Quatuor n° 1."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ]
