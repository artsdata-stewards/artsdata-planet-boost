    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Improvisation and Sound Manipulation Workshop - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "This workshop invites participants to improvise with sonic material by activating and transforming pre-recorded sounds that originate from various sources (instruments, urban noises, synthesizers, etc.). Through manipulations, carried out using controllers and MIDI keyboards, you can explore computer-assisted sound creation in an intuitive and accessible way. In groups or individually, this fun experience is an excellent introduction to audio sampling and processing. "
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "en",
        "@value": "fr-CA"
      }
    ]
  },
