    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Éclatante nostalgie : de l'Europe à Hollywood - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Exilés aux États-Unis, Bartók et Korngold expriment avec émotion la nostalgie de leur terre natale à travers leurs Concertos : influences hongroises chez le premier, réminiscences de l’esprit viennois et mélodies hollywoodiennes chez le second. Mettant en valeur l'éblouissante violoniste Simone Lamsma, ce concert vous plongera dans l'univers captivant de la musique classique, mêlant émotion, cinéma et musique symphonique. Une soirée magique où les mélodies envoûtantes vous transporteront au cœur de leur héritage culturel. Aussi disponible en formule Apéro symphonique le 2 décembre à 18h30"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ]
  },
