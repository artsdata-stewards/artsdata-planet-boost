    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Nature et passion : de Prague à Vérone - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Smetana évoque le parcours de la Moldau, depuis sa source jusqu’à son majestueux passage à Prague, alors que Tchaïkovski conte avec dramatisme et passion les amours tragiques de Roméo et Juliette. Le tout est ponctué par les rythmes entrainants des Danses slaves de Dvořák. Lors de cette rencontre unique entre le Berliner Sibelius Orchester et l’Orchestre Philharmonia Mundi de Montréal, nature, amour et passion prennent vie en musique."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
