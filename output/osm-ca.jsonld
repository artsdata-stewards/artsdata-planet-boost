      {
        "@id": "https://www.osm.ca/en/concert/the-intense-leningrad-symphony-by-shostakovich/"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "_:g18432400"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.osm.ca/en/concert/the-intense-leningrad-symphony-by-shostakovich/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Intense Leningrad Symphony by Shostakovich "
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>This program contrasts Beethoven’s vibrant <em>Symphony No. 8</em> with Shostakovich’s powerful <em>Leningrad Symphony</em>, a poignant work that captures the spirit of resistance to oppression. The striking juxtaposition of Beethoven’s joy and Shostakovich’s depiction of a dramatic historical moment promises an intense and captivating concert experience.</p>\n"
      }
    ]
  },
