    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The OSM Welcomes the Orchestre de Paris - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Led by its gifted conductor Klaus Mäkelä, the Orchestre de Paris will accompany young prodigy Yunchan Lim in Rachmaninoff's celebrated Piano Concerto no. 2. Lim's performance will be preceded and followed by two works heralding the great aesthetic changes of the 20th century: Debussy's Prelude to the Afternoon of a Faun, rich in melodic inventiveness and mesmerizing colours, and Stravinsky's Firebird, whose orchestral splendour rivals with rhythmic audacity."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "en",
        "@value": "fr-CA"
      }
    ]
