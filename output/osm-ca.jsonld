    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Payare dirige les Gurre-Lieder de Schoenberg"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>En compagnie de solistes renommés et à la tête d’un effectif vocal et orchestral colossal, Rafael Payare dirigera un monument du répertoire postromantique : les <em>Gurre-Lieder</em> de Schoenberg.</p>\n<p>\n<strong>Voici <a data-uw-original-href=\"https://www.osm.ca/fr/actualites/cinq-bonnes-raisons-de-venir-ecouter-les-gurre-lieder-de-schoenberg/\" data-uw-rm-brl=\"PR\" href=\"https://www.osm.ca/fr/actualites/cinq-bonnes-raisons-de-venir-ecouter-les-gurre-lieder-de-schoenberg/\">cinq bonnes raisons de venir écouter les Gurre-Lieder de Schoenberg !</a></strong></p>\n"
      }
    ]
  },
