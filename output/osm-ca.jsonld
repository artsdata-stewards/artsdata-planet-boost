    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The OSM Applauds Patrick Norman’s 55-Year Career - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Under the direction of Jean-Marie Zeitouni, the OSM welcomes Patrick Norman to the stage for one final lap to round off 55 years of an outstanding career. He will offer the audience a parade of his greatest hits, orchestrated by Hugo Bégin. Join us for this special event honouring an artist who contributed significantly to the success of country music."
      }
    ],
