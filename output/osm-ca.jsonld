    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "En compagnie de solistes renommés et à la tête d’un effectif vocal et orchestral colossal, Rafael Payare dirigera un monument du répertoire postromantique : les Gurre-Lieder de Schoenberg. Voici cinq bonnes raisons de venir écouter les Gurre-Lieder de Schoenberg !"
      }
    ],
