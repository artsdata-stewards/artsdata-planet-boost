    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Sportissimo ! - Matinées scolaires - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Recommended for students in elementary, grades 5 and 6, and secondary 1 and 2 Take a seat in the musical arena of the Maison symphonique to watch a symphonic tournament of epic proportions! At the centre, conductor Adam Johnson will give the final instructions for a melodic offensive that will leave you on the edge of your seat. On one side, you’ll see our oboist warming up for a shot at a remarkably athletic passage. Meanwhile, our string section will be drilling its precision, discipline, and speed, for a chance to win top honours! Together, they will take you on a discovery of the the bonds that unite music and sports. The baton is raised, and the musical match is set to begin. On your marks, get set, play! "
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "en",
        "@value": "fr-CA"
      }
    ]
  },
