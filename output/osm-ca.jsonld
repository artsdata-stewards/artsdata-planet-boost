    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Chopin and Brahms: Masters of Romanticism  - Orchestre symphonique de Montréal"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://www.osm.ca/app/uploads/2025/03/osm2526_chopin-brahms_1080x1080_fr.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Discover the brilliant pianist Yulianna Avdeeva, winner of the prestigious 2010 Chopin Competition, as she brings her masterful technique and poetic sensitiv..."
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "en",
        "@value": "en_us"
      }
    ],
    "http://ogp.me/ns#type": [
      {
