    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "“A German Requiem” by Kent Nagano "
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>OSM Conductor Emeritus Kent Nagano leads a moving performance of Brahms’ <em>A German Requiem</em>, as it was presented in 1868 in Bremen, Germany. Making its debut at the OSM, this historic recreation includes excerpts from Baroque masterpieces such as Bach’s <em>St. Matthew Passion</em> and Handel’s <em>Messiah</em>. These musical selections offer insight into Brahms’ artistic heritage and underscore his profound connection to the rich German musical tradition. This masterpiece invites deep contemplation on life and death, promising a truly exceptional musical journey.</p>\n"
      }
    ]
  },
