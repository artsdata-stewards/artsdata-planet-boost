    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "L’orchestre sous toutes ses formes !"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<div class=\"wpb_text_column wpb_content_element \">\n<div class=\"wpb_wrapper\">\n<p><strong>Recommandé pour </strong>les élèves de 2<sup>e</sup> et 3<sup>e</sup> cycles du primaire</p>\n</div>\n</div>\n<div class=\"wpb_text_column wpb_content_element \">\n<div class=\"wpb_wrapper\">\n<p>Guidés par nos animateurs Isabeau Blanche et Pierre-Louis Renaud, plongeons au cœur de l’orchestre pour faire plus ample connaissance avec ses quatre familles d’instruments, son histoire et quelques-uns de ses secrets!</p>\n</div>\n</div>\n"
      }
    ]
  },
