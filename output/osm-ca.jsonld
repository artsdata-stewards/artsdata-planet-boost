    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "The Miss Chief Cycle - Orchestre symphonique de Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "L'artiste Kent Monkman, reconnu pour ses peintures épiques et symboliques, présente en avant-première des extraits de The Miss Chief Cycle, une création lyrique composée de trois scènes basées sur Les Mémoires de Miss Chief Eagle Testickle de Kent Monkman et Gisèle Gordon. Interprétée par de grandes voix canadiennes qui seront accompagnées par des musicien.ne.s de l'OSM, cette œuvre unique transposera sur scène des toiles de Kent Monkman, soulevant la division entre la vision du monde du peuple cri et celle des colonialistes européens. Un fabuleux spectacle à ne pas manquer et présenté en première mondiale à la Salle Bourgie ! En lien avec l’exposition Kent Monkman : L’Histoire est dépeinte par les vainqueurs Une coproduction du Studio Kent Monkman et de la Salle Bourgie, présentée en collaboration avec le MBAM et l’Orchestre symphonique de Montréal."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ]
  },
