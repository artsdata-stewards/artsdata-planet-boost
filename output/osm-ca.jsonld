    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Venez célébrer le 50<sup>e</sup> anniversaire de l’Alliance chorale du Québec avec un karaoké communautaire! Que vous aimiez les chansons traditionnelles, populaires ou classiques, joignez votre voix à celles de passionné·es sur les écrans et sur vos téléphones et la magie opère. Joignez-vous à cette grande célébration chorale pour partager la joie de la musique!</p>\n<p><strong><a href=\"https://www.osm.ca/fr/tous-en-choeur-paroles/\" target=\"_blank\" rel=\"noopener\">Découvrez les paroles!</a></strong></p>\n"
      }
    ]
