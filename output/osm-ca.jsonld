        "@id": "https://www.osm.ca/app/uploads/2023/12/33-beethoven-kent-nagano-osm-1080x1080-carre.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.osm.ca/en/concert/beethovens-heroic-symphony-no-3-with-kent-nagano/"
      }
    ],
    "http://schema.org/performer": [
