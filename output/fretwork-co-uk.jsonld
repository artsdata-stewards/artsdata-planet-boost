      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "John Jenkins is beloved of viol consort players for his magnificent consorts in 4, 5 &amp; 6 parts. Yet he also wrote some of the most challenging virtuoso divisions in England. Fretwork explore his Fantasia Suites, as they are called, for multiple viols to the organ. With Silas Wollston."
      }
    ],
