        "@language": "en-us",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The remarkable semi-theatrical experience returns with The Gesualdo Six.  William Byrd’s music was a beacon of hope for Elizabethan Catholics, some of whom worshiped in secret, using his music to celebrate mass.  But they faced prosecution and death if they were discovered."
      }
    ],
