      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "A rare performance of Johann Sebastiani’s St Matthew Passion, published in Königsberg in 1672.  It predates J. S. Bach’s more famous version by over half a century, and calls for more modest forces: four viols and organ accompany the Evangelist, while two violins join with Christus. Instead of Arias"
      }
    ],
