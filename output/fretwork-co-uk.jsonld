      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Dietrich Buxtehude’s extraordinary cycle of seven sacred concerti, called ‘Membra Jesu Nostri’ are a Passiontide reflection on the body of Christ upon the cross. The fifth and centre of the work, ‘Ad Cor’, on the heart, calls for a consort of five viols. Fretwork join Rachel &amp; Julian Podger."
      }
    ],
