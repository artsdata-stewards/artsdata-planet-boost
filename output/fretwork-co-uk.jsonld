    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "On this day, 400 years ago, Orlando Gibbons, one of England’s greatest composers died suddenly in Canterbury. We celebrate his music with Anna Dennis, Alex Chance, Hugo Hymas, Sam Boden &amp; Jimmy Holliday. Nico Muhly wrote My Days as an homage to Gibbons and we reprise this Wigmore  commission"
      }
    ],
