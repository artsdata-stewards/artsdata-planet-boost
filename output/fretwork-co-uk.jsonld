    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Fretwork &amp; The Gesualdo Six come together for an extraordinary semi- theatrical event in the Crypt of St Martin-in-the-Fields in the heart of London, for a glimpse of the perils that recusant Catholics once faced in celebrating their religion.  Supported by The Continuo Foundation"
      }
