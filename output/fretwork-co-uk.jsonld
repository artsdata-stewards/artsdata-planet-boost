    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The fourth concert in our series celebrating the ‘Golden Age’ of English consort music, from Cornyshe to Purcell, with the wonderful voice of Lucy Crowe. This concert features some of William Byrd’s great consort songs, including his moving lament on the death of Philip Sydney, and his frothy, humor"
      }
