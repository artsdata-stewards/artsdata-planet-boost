    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "PORTRAIT ALLA ZAGAYKEVYCH  - VIVIERMIX"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "A Le Vivier production, presented in partnership with CIRMMT.Ukrainian composer Alla Zagaykevych opens the doors to her captivating and multidimensional universe. Deeply inspired by poetry, she presents her works where enchanting atmospheres float, subtly intertwining instrumental music and electronics.In this concert curated by the composer, the NEM joins forces with Chants Libres, Paramirabo, and Productions SuperMusique to perform works from her repertoire."
      }
    ],
