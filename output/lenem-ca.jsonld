    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "An Encounter with Alla Zagaykevych – Open Rehearsal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "A co-production of Le Vivier and the NEM.As part of the Journées de la culture, Le Vivier and the NEM invite the public to discover Ukrainian composer Alla Zagaykevych.Presented as an open rehearsal led and hosted by guest conductor Jean-Michaël Lavoie, the event offers audiences a first glimpse into the composer’s musical world, performed by musicians from the NEM.A Q&amp;A session will follow the rehearsal!"
      }
    ],
