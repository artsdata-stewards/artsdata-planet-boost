    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "... ces échos des éloignements éphémères..."
      },
      {
        "@language": "en",
        "@value": "... ces échos des éloignements éphémères..."
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le NEM&nbsp;présente en première mondiale&nbsp;... ces échos des éloignements éphémères…&nbsp;création du compositeur&nbsp;Sandeep Bhagwati.&nbsp;C'est au mois de février 2021 qu'a eu lieu l'enregistrement, au cœur de l'Abbaye d’Oka, où les musiciennes et les musiciens du NEM ainsi que la cheffe Lorraine Vaillancourt étaient réuni·e·s sous l'oeil des caméras.&nbsp;Écrite en contexte de pandémie,&nbsp;... ces échos des éloignements éphémères…&nbsp;est tel un rebondissement de la pièce&nbsp;Racines éphémères (2008) du même compositeur. Une trame musicale repensée pour le&nbsp;NEM, ainsi que des modes de jeu dits de “comprovisation” – mélange de composition et d’improvisation – ponctuent cette œuvre inédite.L’Abbaye tient aussi un rôle central :&nbsp;spatialisation, réverbération, échos; autant de belles façons de souligner les enjeux et les défis liés à la distanciation dans le processus de création.&nbsp;Le NEM tient à remercier la Fondation SOCAN pour son soutien."
      },
      {
        "@language": "en",
        "@value": "Le NEM&nbsp;présente en première mondiale&nbsp;... ces échos des éloignements éphémères…&nbsp;création du compositeur&nbsp;Sandeep Bhagwati.&nbsp;C'est au mois de février 2021 qu'a eu lieu l'enregistrement, au cœur de l'Abbaye d’Oka, où les musiciennes et les musiciens du NEM ainsi que la cheffe Lorraine Vaillancourt étaient réuni·e·s sous l'oeil des caméras.&nbsp;Écrite en contexte de pandémie,&nbsp;... ces échos des éloignements éphémères…&nbsp;est tel un rebondissement de la pièce&nbsp;Racines éphémères (2008) du même compositeur. Une trame musicale repensée pour le&nbsp;NEM, ainsi que des modes de jeu dits de “comprovisation” – mélange de composition et d’improvisation – ponctuent cette œuvre inédite.L’Abbaye tient aussi un rôle central :&nbsp;spatialisation, réverbération, échos; autant de belles façons de souligner les enjeux et les défis liés à la distanciation dans le processus de création.&nbsp;Le NEM tient à remercier la Fondation SOCAN pour son soutien."
      }
    ],
    "http://schema.org/startDate": [
