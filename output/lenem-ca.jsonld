    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "L'orangeraie - Montréal "
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "La&nbsp;première mondiale de l'opéra&nbsp;L’ORANGERAIE&nbsp;de&nbsp;Zad Moultaka (musique) et Larry Tremblay (livret), se tiendra le&nbsp;19 octobre 2021&nbsp;dans la grande&nbsp;Salle Ludger-Duvernay du Monument-National à Montréal, puis en reprise les 20 et 21 octobre 2021. Il s'agit de la 17e création de Chants Libres, compagnie lyrique de création, en coproduction avec le NEM.&nbsp;Cette nouvelle production sera également présentée les&nbsp;5 et 6 novembre 2021&nbsp;au théâtre&nbsp;Le Diamant à Québec, dans le cadre de leur série — Art Lyrique.&nbsp;Mis en scène par Pauline Vaillancourt et scénographié par l'artiste visuelle Dominique Blain, L'ORANGERAIE fera se réunir sur scène huit chanteur·se·s, un comédien et seize musicien·ne·s, sous la direction de la cheffe Lorraine Vaillancourt.&nbsp;MONTRÉAL : les&nbsp;19, 20 et 21 octobre 2021,&nbsp;Salle Ludger-Duvernay du&nbsp;Monument-NationalQUÉBEC :&nbsp;5 et 6 novembre 2021&nbsp;au théâtre&nbsp;Le Diamant&nbsp;L'opéra L’orangeraie est une production de Chants Libres, compagnie lyrique de création, en coproduction avec le NEM."
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2021-10-20T00:00:00-04:00"
      }
    ]
  },
