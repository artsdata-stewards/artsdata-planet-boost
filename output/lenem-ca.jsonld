    "https://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Sous la direction musicale de Lorraine Vaillancourt, aux côtés de la mezzo-soprano Krisztina Szabó et de la soprano Sharon Azrieli, le NEM présente en première mondiale les oeuvres de la compositrice Keiko Devaux et des compositeurs Yotam Haber et Yitzhak Yedid !Événement gratuit diffusé en direct sur medici.tv et sur la page Facebook des PAM."
      }
    ],
