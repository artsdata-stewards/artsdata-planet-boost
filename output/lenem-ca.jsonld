    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "L'orangeraie - Montreal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The&nbsp;world premiere of the opera&nbsp;L’ORANGERAIE&nbsp;by Zad Moultaka (music) and Larry Tremblay (libretto) will take place on October 19, 2021&nbsp;in the main Salle Ludger-Duvernay of Monument-National in Montreal. It will then be staged again on October 20 and 21, 2021. Co-produced by the NEM, L’ORANGERAIE is the 17th new work produced by the vocal creation company Chants Libres.&nbsp;This new production will also be presented on November 5 and 6, 2021&nbsp;at Le Diamant theatre in Quebec City, as part of its Art Lyrique series.&nbsp;Directed by Pauline Vaillancourt, with a set design by visual artist Dominique Blain, L’ORANGERAIE brings to the stage eight singers, one actor and sixteen instrumentalists, under the musical direction of conductor Lorraine Vaillancourt.MONTREAL:&nbsp;October 19, 20 and 21, 2021,&nbsp;Salle Ludger-Duvernay at&nbsp;Monument-NationalQUEBEC CITY:&nbsp;November 5 and 6, 2021&nbsp;at Le Diamant&nbsp;theatreThe opera L’orangeraie is produced by the vocal creation company Chants Libres and co-produced by the NEM."
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2021-10-20T00:00:00-04:00"
      }
    ]
  },
