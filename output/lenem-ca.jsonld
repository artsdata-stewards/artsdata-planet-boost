    "http://schema.org/mainEntityOfPage": [
      {
        "@id": "_:g8153280"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Chapter 5 – The Rite of Spring"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Under the direction of Jean-Michaël Lavoie, the NEM invites you to explore three unique sonic worlds, united by visceral energy and dramatic intensity. Snežana Nešić presents&nbsp;Impetus – Collaps – Stasis, an architecturally conceived work that evolves like a living organism, moving between bursts of energy, sonic collapse, and hypnotic stillness, while unfolding a rich and contrasting orchestral palette.&nbsp;Denis Gougeon offers&nbsp;En Accordéon, written for Joseph Petric, in which the accordion converses with the orchestra through a blend of formal clarity, elegant lyricism, and subtle rhythmic play, revealing all the colors of the instrument. Finally, Igor Stravinsky’s&nbsp;The Rite of Spring, arranged by François Vallières, captivates with its earthy power and irresistible rhythms, balancing primal violence with hypnotic beauty."
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-10-16T23:30:00-04:00"
      }
    ]
  },
