  {
    "@id": "_:g7157520",
    "http://schema.org/url": [
      {
        "@id": "https://lenem.ca/en/node/4201"
      }
    ],
    "http://schema.org/datePublished": [
      {
        "@type": "http://schema.org/Date",
        "@value": "1981"
      }
    ],
    "http://schema.org/composer": [
      {
        "@id": "_:g7157540"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Bouchara"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://lenem.ca/en/node/4201"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Text in invented language&nbsp;In Bouchara, Claude Vivier immerses us in a sound world that is both strange and captivating. The text, written in an invented language, transcends the limits of words to touch the universal. This deeply introspective work explores themes of love and loss, characteristic of Vivier's unique musical language. Soprano Chelsea Kolic guides the listener on this dreamlike journey, carried by an ensemble vibrant with energy."
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
