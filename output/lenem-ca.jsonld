    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Calme Chaos"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "A COSIMU production, in collaboration with the NEM, École des Saints-Martyrs-Canadiens, and Maison de la culture Ahuntsic.Calme Chaos is a youth concert bringing together on stage a group of budding “fonofonists,” young conductor Charles-Éric Fontaine, and the NEM, in the creation of works for the Fonofone* digital application and instrumental ensemble.The youth ensemble is composed of students from the 3rd cycle of École primaire des Saints-Martyrs-Canadiens.*Fonofone is a sound creation and interpretation application designed by COSIMU for educational purposes."
      }
    ],
