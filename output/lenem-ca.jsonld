  {
    "@id": "_:g5592060",
    "http://schema.org/url": [
      {
        "@id": "https://lenem.ca/en/node/20039"
      }
    ],
    "http://schema.org/composer": [
      {
        "@id": "_:g5592080"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Prélude à l'opéra"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://lenem.ca/en/node/20039"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "À propos\r\n\r\nL’AUTEUR vient s’ajouter à l’action originale du livret, errant dans les lieux vides. Incarné par Mikaël (Sébastien Ricard), un des personnages de L’orangeraie, avec pour seule arme son texte, sa musique préenregistrée dans les lieux mêmes, quelques accessoires, il essaiera d’animer l’espace vide, de son mieux, dans les règles exigées par le mal. Par l’imagination, de sa voix déclamant le texte en superposition, soutenu par l’orchestre et sa musique, bien vivante dans sa tête, il encouragera certains des personnages de l’opéra à chanter leur air malgré le manque de moyen, les fera apparaitre et les aidera au mieux avec des astuces d’éclairage minimal, d’accessoires pathétiques, jusqu’à se dépouiller lui-même, exténué. Il aura voulu faire surgir l’espoir.\r\n"
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
