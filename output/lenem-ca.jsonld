  {
    "@id": "_:g7828380",
    "http://schema.org/url": [
      {
        "@id": "https://lenem.ca/en/node/4241"
      }
    ],
    "http://schema.org/datePublished": [
      {
        "@type": "http://schema.org/Date",
        "@value": "1982"
      }
    ],
    "http://schema.org/composer": [
      {
        "@id": "_:g7828400"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Vision "
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://lenem.ca/en/node/4241"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Text by Teresa of AvilaWith Vision, José Evangelista explores the mystical and spiritual universe of Teresa of Avila, an emblematic figure of Christian spirituality. The work, written for mezzo-soprano and small ensemble, surrounds the Spanish poet's text with minimalist and contemplative music. Evangelista, master of subtle sound textures, invites us to an intimate and transcendent meditation."
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
  {
    "@id": "_:g7828420",
    "http://schema.org/url": [
      {
        "@id": "https://lenem.ca/en/node/20279"
      }
    ],
    "http://schema.org/composer": [
      {
        "@id": "_:g7828440"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Orpheus on Sappho's Shore"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://lenem.ca/en/node/20279"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Libretto by Eleanor Wilner.Luna Pearl Woolf revisits the myth of Orpheus from a contemporary perspective, imbued with poetry and emotion. Eleanor Wilner's libretto transfigures the Greek legend into a reflection on loss, memory and renewal. The voice of countertenor Ian Sabourin, accompanied by an ensemble with rich and evocative sounds, brings to life this work where lyricism and modernity meet."
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
  {
    "@id": "_:g7828460",
    "http://schema.org/url": [
      {
        "@id": "https://lenem.ca/en/node/4201"
      }
    ],
    "http://schema.org/datePublished": [
      {
        "@type": "http://schema.org/Date",
        "@value": "1981"
      }
    ],
    "http://schema.org/composer": [
      {
        "@id": "_:g7828480"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Bouchara"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://lenem.ca/en/node/4201"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Text in invented language&nbsp;In Bouchara, Claude Vivier immerses us in a sound world that is both strange and captivating. The text, written in an invented language, transcends the limits of words to touch the universal. This deeply introspective work explores themes of love and loss, characteristic of Vivier's unique musical language. Soprano Chelsea Kolic guides the listener on this dreamlike journey, carried by an ensemble vibrant with energy."
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
  {
    "@id": "_:g7828500",
    "http://schema.org/url": [
      {
        "@id": "https://lenem.ca/en/node/20280"
      }
    ],
    "http://schema.org/datePublished": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2005"
      }
    ],
    "http://schema.org/composer": [
      {
        "@id": "_:g7828520"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Cantatrix Sopranica"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://lenem.ca/en/node/20280"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Texts by Unsuk Chin, Harry Mathews, Arno Holz, and a song from the Tang dynasty.&nbsp;Inspired by the absurd and experimental humor of Georges Perec and the Oulipo movement, Cantatrix Sopranica is a bold and exuberant work. Unsuk Chin plays with the codes of vocal music, alternating between virtuosity, irony and extravagance. The voices of Justine Ledoux, Bridget Esler and Ian Sabourin mingle and intertwine in a complex and often jubilant dialogue, supported by an ensemble with dazzling textures."
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
