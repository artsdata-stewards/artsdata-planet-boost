  {
    "@id": "_:g7800980",
    "http://schema.org/url": [
      {
        "@id": "https://lenem.ca/fr/node/4241"
      }
    ],
    "http://schema.org/datePublished": [
      {
        "@type": "http://schema.org/Date",
        "@value": "1982"
      }
    ],
    "http://schema.org/composer": [
      {
        "@id": "_:g7801000"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Vision "
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://lenem.ca/fr/node/4241"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Texte de Thérèse d’AvilaAvec&nbsp;Vision, José Evangelista explore l'univers mystique et spirituel de Thérèse d’Avila, une figure emblématique de la spiritualité chrétienne. L’œuvre, écrite pour mezzo-soprano et petit ensemble, enveloppe le texte de la poétesse espagnole dans une musique minimaliste et contemplative. Evangelista, maître des textures sonores subtiles, nous invite à une méditation intime et transcendante."
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
  {
    "@id": "_:g7801020",
    "http://schema.org/url": [
      {
        "@id": "https://lenem.ca/fr/node/20279"
      }
    ],
    "http://schema.org/composer": [
      {
        "@id": "_:g7801040"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Orpheus on Sappho's Shore (Sur le rivage de Shappo) "
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://lenem.ca/fr/node/20279"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Livret d’Eleanor WilnerLuna Pearl Woolf revisite le mythe d’Orphée dans une perspective contemporaine, empreinte de poésie et d'émotion. Le livret d’Eleanor Wilner transfigure la légende grecque en une réflexion sur la perte, la mémoire et le renouveau. La voix du contreténor Ian Sabourin, accompagnée d’un ensemble aux sonorités riches et évocatrices, donne vie à cette œuvre où lyrisme et modernité se rencontrent."
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
  {
    "@id": "_:g7801060",
    "http://schema.org/url": [
      {
        "@id": "https://lenem.ca/fr/node/4201"
      }
    ],
    "http://schema.org/datePublished": [
      {
        "@type": "http://schema.org/Date",
        "@value": "1981"
      }
    ],
    "http://schema.org/composer": [
      {
        "@id": "_:g7801080"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Bouchara"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://lenem.ca/fr/node/4201"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Texte en langue inventée.Dans&nbsp;Bouchara, Claude Vivier nous plonge dans un monde sonore à la fois étrange et envoûtant. Le texte, écrit dans une langue inventée, transcende les limites des mots pour toucher à l’universel. Cette œuvre, profondément introspective, explore les thèmes de l’amour et de la perte, caractéristiques du langage musical unique de Vivier. La soprano Chelsea Kolic guide l’auditeur dans ce voyage onirique, porté par un ensemble vibrant d’énergie."
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
  {
    "@id": "_:g7801100",
    "http://schema.org/url": [
      {
        "@id": "https://lenem.ca/fr/node/20280"
      }
    ],
    "http://schema.org/datePublished": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2005"
      }
    ],
    "http://schema.org/composer": [
      {
        "@id": "_:g7801120"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Cantatrix Sopranica"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://lenem.ca/fr/node/20280"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Textes de Unsuk Chin, Harry Mathews, Arno Holz, et une chanson de la dynastie Tang.Inspirée par l’humour absurde et expérimental de Georges Perec et du mouvement Oulipo,&nbsp;Cantatrix Sopranica&nbsp;est une œuvre audacieuse et exubérante. Unsuk Chin joue avec les codes de la musique vocale, alternant entre virtuosité, ironie et extravagance. Les voix de Justine Ledoux, Bridget Esler et Ian Sabourin se mêlent et s’entrelacent dans un dialogue complexe et souvent jubilatoire, soutenues par un ensemble aux textures éclatantes."
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
