    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "En toute liberté"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "On&nbsp;May 6, 2022 at Salle Claude-Champagne, the NEM, conducted by Lorraine Vaillancourt, presents&nbsp;En toute&nbsp;liberté, a concert&nbsp;celebrating Luis de Pablo&nbsp;and&nbsp;Iannis Xenakis and performed exclusively before a live audience.&nbsp;In their own way, these two artists have left an indelible mark on their era by creating, sharing and transmitting their passion for music and art. The NEM wishes to highlight the legacy of these composers whose works have marked its own history.An NEM concert in its purest tradition!Presented as part of the international programming of the Meta-Xenakis Symposium,&nbsp;in partnership with La Scena Musicale."
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2022-05-06T23:30:00-04:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2022-05-07T01:30:00-04:00"
      }
    ]
  },
