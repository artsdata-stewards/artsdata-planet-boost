    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Concert gala des Prix Azrieli de musique 2020"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "En direct de la Salle Bourgie, découvrez en première mondiale les oeuvres de la lauréate Keiko Devaux et des lauréats Yotam Haber et Yitzhak Yedid. Laissez-vous également transporter par la pièce Dissidence de Pierre Mercure dans un arrangement pour le NEM de Jonathan Monro. Un voyage au coeur de la nouvelle musique juive et canadienne, et une magnifique façon de célébrer l’excellence de la composition musicale!\r\n\r\nLe Concert gala aura lieu à la Salle Bourgie et sa captation audiovisuelle sera réalisée par le partenaire de la Fondation Azrieli, Prodcan Inc. Le concert pourra être visionné gratuitement à domicile sur Medici TV ou sur la page Facebook des Prix Azrieli de musique.\r\n"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2020-10-23T00:00:00-04:00"
      }
    ]
  },
