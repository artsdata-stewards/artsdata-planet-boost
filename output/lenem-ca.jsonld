    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "L'orangeraie - Quebec City"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "After its success in Montreal, L’ORANGERAIE (Zad Moultaka, music, Larry Tremblay, libretto) comes to Quebec City.A new work by Chants Libres co-produced by the NEM, the opera will be presented on November 5 and 6, 2021&nbsp;at Le Diamant theatre in Quebec City, as part of its Art Lyrique series.&nbsp;Directed by Pauline Vaillancourt, with a set design by visual artist Dominique Blain, L’ORANGERAIE brings to the stage eight singers, one actor and sixteen instrumentalists, under the musical direction of conductor Lorraine Vaillancourt.&nbsp;MONTREAL:&nbsp;October 19, 20 and 21, 2021,&nbsp;Salle Ludger-Duvernay at&nbsp;Monument-NationalQUEBEC CITY:&nbsp;November 5 and 6, 2021&nbsp;at Le Diamant&nbsp;theatreThe opera&nbsp;L’orangeraie&nbsp;is produced by the vocal creation company Chants Libres and co-produced by the NEM."
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2021-11-06T19:00:00-04:00"
      }
    ]
  },
