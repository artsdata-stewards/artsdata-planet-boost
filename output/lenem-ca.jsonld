    ],
    "http://schema.org/identifier": [
      {
        "@language": "en",
        "@value": "https://lenem.ca/en/node/4585"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "According to Keiko Devaux, “Canadian music is defined by the voices of those who live here; given the dynamic and plural identity of this country, [our music] is a tapestry that draws on the influence of many interconnected traditions and histories. These collective sonic memories that we have preserved, shared, broadcast and celebrated together are, for me, what defines the Canadian sound.” Her award-winning composition, Arras, is a reflection of her dual French and Japanese-Canadian heritage."
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
