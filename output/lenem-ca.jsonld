      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://lenem.ca/fr/forum-nem/forum-2025"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Discussion – Panel animé par Jean-Michaël Lavoie"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p><strong>Avec:</strong></p><ul><li><span lang=\"FR-CA\">Marianne Perron – Directrice principale, Secteur artistique, Orchestre symphonique de Montréal</span></li><li>Brian Current – Compositeur et chef d’orchestre </li><li>Jean-Michaël Lavoie - Directeur artistique et musical du NEM</li></ul><p><em>Trente minutes avant le concert, le chef du NEM, Jean-Michaël Lavoie, accompagné par <span lang=\"FR-CA\">Marianne Perron, Directrice principale, secteur artistique, Orchestre symphonique de Montréal</span> , et du compositeur et chef Brian Current, animera une discussion conviviale et stimulante. Ensemble, ils survoleront des thèmes essentiels tels que la création, la diffusion et le marché de la musique moderne, en partageant réflexions, expériences et perspectives.</em></p>"
      }
    ]
  },
  {
    "@id": "https://lenem.ca/fr/forum-nem/forum-2025#jour-1-activite-4",
