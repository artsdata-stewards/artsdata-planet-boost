  {
    "@id": "_:g7132440",
    "http://schema.org/url": [
      {
        "@id": "https://lenem.ca/fr/node/20179"
      }
    ],
    "http://schema.org/datePublished": [
      {
        "@type": "http://schema.org/Date",
        "@value": "1982"
      }
    ],
    "http://schema.org/composer": [
      {
        "@id": "_:g7132460"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Trois airs pour un opéra imaginaire"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://lenem.ca/fr/node/20179"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Cette œuvre explore un spectre pulsé se dirigeant vers une pulsion irrégulière, se transformant en contrepoint avant de revenir à une orchestration minimale. L'écriture spectrale de Vivier se termine par une rupture brutale suivie d'un intervalle pur."
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
  {
    "@id": "_:g7132480",
    "http://schema.org/url": [
      {
        "@id": "https://lenem.ca/fr/node/20178"
      }
    ],
    "http://schema.org/datePublished": [
      {
        "@type": "http://schema.org/Date",
        "@value": "1981"
      }
    ],
    "http://schema.org/composer": [
      {
        "@id": "_:g7132500"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Et je reverrai cette ville étrange"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://lenem.ca/fr/node/20178"
      }
    ],
