    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "L'orangeraie - Québec"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Après son succès à Montréal, L'ORANGERAIE (Zad Moultaka, musique, Larry Tremblay, livret) prend la route de Québec.Cette nouvelle création de Chants Libres, en coproduction avec le NEM, sera présentée les&nbsp;5 et 6 novembre 2021&nbsp;au théâtre&nbsp;Le Diamant à Québec, dans le cadre de leur série — Art Lyrique.&nbsp;Mis en scène par Pauline Vaillancourt et scénographié par l'artiste visuelle Dominique Blain, L'ORANGERAIE fera se réunir sur scène huit chanteur·se·s, un comédien et seize musicien·ne·s, sous la direction de la cheffe Lorraine Vaillancourt.&nbsp;MONTRÉAL : les&nbsp;19, 20 et 21 octobre 2021,&nbsp;Salle Ludger-Duvernay du&nbsp;Monument-NationalQUÉBEC :&nbsp;5 et 6 novembre 2021&nbsp;au théâtre&nbsp;Le Diamant&nbsp;L'opéra L’orangeraie est une production de Chants Libres, compagnie lyrique de création, en coproduction avec le NEM."
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2021-11-05T23:30:00-04:00"
      }
    ]
  },
