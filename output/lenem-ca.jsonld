    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "En toute liberté"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le&nbsp;6 mai&nbsp;prochain à la&nbsp;Salle Claude-Champagne, le NEM, sous la direction de Lorraine Vaillancourt, présente&nbsp;En toute&nbsp;liberté. Un concert&nbsp;mettant&nbsp;à l'honneur&nbsp;Luis de Pablo&nbsp;et&nbsp;Iannis Xenakis,&nbsp;offert exclusivement devant public.&nbsp;Cet événement&nbsp;rend hommage à deux regrettées figures d’exception de la musique contemporaine&nbsp;: le compositeur Iannis&nbsp;Xenakis (1922 – 2001), dont la communauté musicale célèbre cette année le centenaire de naissance, et l’inoubliable Luis&nbsp;de&nbsp;Pablo&nbsp;(1930&nbsp;– 2021), ami loyal et collaborateur du NEM, disparu en octobre dernier.&nbsp;– Extrait des notes de programmeDeux artistes qui, chacun à leur façon, ont su marquer leur temps,&nbsp;créant, partageant et transmettant leur ferveur de la Musique et de l’Art. Le NEM entend ainsi souligner le legs de ces compositeurs dont plusieurs œuvres ont jalonné sa propre histoire.&nbsp;Un concert du NEM dans&nbsp;sa plus pure tradition !—Présenté dans le cadre de la programmation internationale du symposium Meta-Xenakis.&nbsp;En partenariat avec La Scena Musicale."
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2022-05-06T23:30:00-04:00"
      }
