    ],
    "http://schema.org/url": [
      {
        "@id": "https://lenem.ca/fr/forum-nem/forum-2025"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Concert Gratuit"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p><strong>Programme:</strong></p><ul><li><span lang=\"FR-CA\"></span><span>Brian Current&nbsp;- </span><em><span>For the Time Being </span></em></li><li><span>Christina Volpini - </span><em><span>winter lunar</span></em></li><li><span>Tom Lachance : </span><em><span>…al fine…</span></em></li><li><span lang=\"FR-CA\">Francis Battah : </span><em><span lang=\"FR-CA\">Musique d’un monde sans carte</span></em><ul><li><span lang=\"FR-CA\"></span></li><li><span lang=\"FR-CA\"></span></li><li><span lang=\"FR-CA\"></span></li></ul></li></ul>"
      }
    ]
