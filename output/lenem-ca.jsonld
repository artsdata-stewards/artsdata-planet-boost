    "http://schema.org/mainEntityOfPage": [
      {
        "@id": "_:g8055840"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Chapter 4 – NEM and the Next Generation"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Forum 2025 FinalsThis year, Francis Battah, Tom Lachance, and Christina Volpini each present a new work, showcasing the diversity and vitality of the Canadian and international contemporary music scene. Brian Current, whose&nbsp;For the Time Being&nbsp;has already been praised for its subtle balance between expressiveness and structural rigor, completes the program by bringing an original and mature voice that engages in dialogue with the new generations of composers.Since its thirteen previous editions, presented in Montreal as well as in Adelaide (2000, Australia), Amsterdam (2006, Netherlands), and Lyon (2008, France), the FORUM has allowed 85 composers from 29 countries to benefit from an exceptional creative experience, nurturing emerging talent and enriching contemporary musical culture on an international scale.*Free event"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-10-15T22:30:00-04:00"
      }
    ]
  },
