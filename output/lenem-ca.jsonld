      {
        "@language": "en",
        "@value": "Spring Concert"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The highlight of a season dedicated to the victims of the war in Ukraine, this concert features works by five composers to discover.The event also marks the final meeting of the year with Ukrainian composer-in-residence at Le Vivier, Alla Zagaykevych, with the premiere of a work written for the NEM.6:00 PM - Pre-concertMeet the visual artist Mario Côté.Concert presented in co-broadcast with Le Vivier.”"
      }
    ],
