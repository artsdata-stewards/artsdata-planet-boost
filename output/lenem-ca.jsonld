        "@value": "2025-10-15T18:00:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g8903040"
      }
    ],
    "http://schema.org/superEvent": [
      {
        "@id": "https://lenem.ca/en/forum-nem/forum-2025#jour-1"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://lenem.ca/en/forum-nem/forum-2025"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Discussion – Panel led by Jean-Michaël Lavoie"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><strong>With:</strong></p><ul><li><span lang=\"FR-CA\"></span><span lang=\"FR-CA\">Marianne Perron – Directrice principale, Secteur artistique, Orchestre symphonique de Montréal</span></li><li>Brian Current – Composer and conductor</li><li>Jean-Michaël Lavoie - Artistic and Musical Director of the NEM</li></ul><div>&nbsp;</div><div><em><span>Thirty minutes before the concert, the NEM’s conductor, Jean-Michaël Lavoie, joined by </span><span lang=\"FR-CA\">Marianne Perron – Directrice principale, Secteur artistique, Orchestre symphonique de Montréal </span><span>and Brian Current, will lead a warm and stimulating conversation. Together, they will explore key themes such as creation, presentation, and the market of modern music, sharing reflections, experiences, and perspectives.</span></em></div>"
      }
    ]
  },
  {
    "@id": "https://lenem.ca/en/forum-nem/forum-2025#jour-1-activite-4",
