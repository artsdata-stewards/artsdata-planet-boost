    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "PORTRAIT ALLA ZAGAYKEVYCH  - VIVIERMIX"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Production Le Vivier, présenté en partenariat avec le CIRMMT.La compositrice ukrainienne Alla Zagaykevych nous ouvre les portes de son univers captivant et multidimensionnel. Très inspirée par la poésie, elle nous présente ses œuvres où flottent des atmosphères envoûtantes, entremêlant subtilement la musique instrumentale et l’électronique.Dans ce concert conçu par la compositrice, le NEM se joint à Chants Libres, Paramirabo et Productions SuperMusique pour interpréter des œuvres de son répertoire."
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
