    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Calme Chaos"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Production de COSIMU, en collaboration avec le NEM, l’école des Saints-Martyrs-Canadiens et la Maison de la culture Ahuntsic.Calme Chaos est un concert jeunesse réunissant sur scène un groupe de “fonofonistes” en herbe, le jeune chef Charles-Éric Fontaine et le NEM, dans des créations d'œuvres pour l'application numérique Fonofone* et ensemble instrumental.L’ensemble de jeunes est formé d’écoliers·ères du 3e cycle de l’école primaire des Saints-Martyrs-Canadiens.*Fonofone est une application de création sonore et d’interprétation conçue par COSIMU à des fins pédagogiques."
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2023-02-24T18:15:00-05:00"
      }
    ]
