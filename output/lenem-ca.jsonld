    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "À la rencontre d’Alla Zagaykevych, répétition publique"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Coproduction Le Vivier et le NEM.&nbsp;Dans le cadre des Journées de la culture, Le Vivier et le NEM convient le public à découvrir la compositrice ukrainienne Alla Zagaykevych.&nbsp;Sous forme de répétition ouverte à tous·te·s, dirigée et animée par le chef invité&nbsp;Jean-Michäel Lavoie, le public est invité·e à assister à une première incursion dans l’univers de la compositrice par des musicien·ne·s du NEM.&nbsp;Une période de questions suivra la répétition !"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2022-10-02T19:45:00-04:00"
      }
