    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Quelque part et autres lieux"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "In shifting between orality and written music, gesture and sound, movement and musical line, we discover and open ourselves to each other’s sensibilities and share this richness with others. Land InSights, Forestare and the Nouvel Ensemble Moderne (NEM) – three different organizations – team up to present a concert that brings together poetry and music.Concert presented as part of the International First Peoples’ Festival, in association with the Orchestre Symphonique de Montréal and in partnership with the Bibliothèque et Archives nationales du Québec."
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2022-08-14T23:00:00-04:00"
      }
