    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Cette œuvre explore un spectre pulsé se dirigeant vers une pulsion irrégulière, se transformant en contrepoint avant de revenir à une orchestration minimale. L'écriture spectrale de Vivier se termine par une rupture brutale suivie d'un intervalle pur."
      }
    ],
    "@type": [
      "http://schema.org/MusicComposition"
    ]
  },
