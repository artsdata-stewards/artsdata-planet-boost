    "http://schema.org/mainEntityOfPage": [
      {
        "@id": "_:g8129660"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Chapitre 5 - Le Sacre du printemps"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Sous la direction de Jean-Michaël Lavoie, le NEM vous invite à explorer trois univers sonores singuliers liés par une énergie viscérale et une intensité dramatique. Snežana Nešić propose&nbsp;Impetus – Collaps – Stasis, une œuvre architecturée qui évolue comme un organisme vivant entre jaillissement d’énergie, effondrement sonore et immobilité hypnotique, déployant une palette orchestrale riche et contrastée. Denis Gougeon présente&nbsp;En Accordéon, écrite pour Joseph Petric, où l’accordéon dialogue avec l’orchestre dans un mélange de clarté formelle, lyrisme élégant et jeux rythmiques subtils révélant toutes les couleurs de l’instrument. Enfin,&nbsp;Le Sacre du printemps&nbsp;d’Igor Stravinsky, arrangé par François Vallières, fascine par sa force tellurique et ses rythmes irrésistibles, entre violence primitive et beauté hypnotique.&nbsp;"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-10-16T23:30:00-04:00"
      }
    ]
  },
