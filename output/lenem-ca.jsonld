      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Free Concert"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><strong>Program:</strong></p><ul><li><span>Brian Current&nbsp;- </span><em><span>For the Time Being</span></em></li><li><span>Christina Volpini - </span><em><span>winter lunar</span></em></li><li><span>Tom Lachance : </span><em><span>…al fine…</span></em></li><li><span lang=\"FR-CA\">Francis Battah : </span><em><span lang=\"FR-CA\">Musique d’un monde sans carte</span></em></li></ul>"
      }
    ]
  },
