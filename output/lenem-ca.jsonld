      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p><span><strong>Programme :</strong></span></p><ul><li><span>Snežana </span><span lang=\"EN-CA\">Nesić –&nbsp;</span><em><span lang=\"EN-CA\">Impetus – Collaps – Stasis</span></em></li><li><span>Denis Gougeon –&nbsp;</span><em><span>En Accordéon (Joseph Petric, accordéon solo)</span></em></li><li><span>Igor Stravinsky –&nbsp;</span><em><span>Le Sacre du printemps</span></em><span>&nbsp;(arrangement François Vallières)</span></li></ul><p><span lang=\"EN-CA\"></span></p>"
      }
