  {
    "@id": "https://www.phtheatre.org/temporary/1f7080bf-fca4-4e5d-a761-9b5fb1968075",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g4039480"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.phtheatre.org/stec_event/haunted-histories/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Haunted Histories: An Evening with the Vancouver Paranormal Society"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Explore the unseen with the Vancouver Paranormal Society. In this special presentation, the team will share their findings and experiences from investigating Presentation House Theatre, a historical building that’s over a hundred years old and rumoured to be home to several spirits.\r\n\r\nWhether you’re a believer, a skeptic, or simply curious, this event promises to be a captivating evening filled with fascinating insights into the paranormal. Don’t miss this unique opportunity to learn about the spirits that call Presentation House Theatre their home!\r\n\r\nFounded in 1993, the Vancouver Paranormal Society is North America’s oldest paranormal research team, known for their professionalism and dedication to investigating the unexplained. Discover the methods behind paranormal investigation and hear about the society’s longstanding relationships with local heritage sites and their spooky encounters over the years.\r\n\r\n<strong>Ages: 10+</strong>\r\n\r\n<strong>A Presentation House Theatre Production</strong>"
      }
    ],
