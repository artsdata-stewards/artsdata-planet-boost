  {
    "@id": "https://www.phtheatre.org/temporary/c75a09c3-3af3-4e6e-b3c8-39c53e315514",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g4838540"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
