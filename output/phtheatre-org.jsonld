    "http://schema.org/url": [
      {
        "@id": "https://www.phtheatre.org/stec_event/pht-community-clothing-swap-2/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "PHT Community Clothing Swap"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<strong>Sunday, January 12, 2025</strong>\r\n\r\n<strong>11:00 AM to 3:00 PM</strong>\r\n\r\nThis is an event that requires no registration! Entry by donation! Walk-ups are welcome.\r\n\r\nPresentation House Theatre’s Community Clothing Swap is back just in time for the winter season! Please bring a maximum of 15 gently used clothing items and swap them for something new-to-you. We welcome clothing for all ages, all sizes, and all genders. This time around, admission is by donation—give what feels right for you! Help us continue to offer these community events and don’t miss out on the chance to give your wardrobe a sustainable makeover for the new year. We hope to see you there!"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-01-12T11:00:00-08:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-01-12T15:00:00-08:00"
      }
