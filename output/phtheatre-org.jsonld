    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Ubu on the Table"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "A hilarious adaptation of Jarry’s bizarre <i>Macbeth</i> parody <i>King Ubu</i>, anything goes in this farcical tabletop puppet show! Two armies of French baguettes face off as tomato bombs explode, an egg beater hovers over fleeing troops and molasses-blood splatters on fork-soldiers as they charge Père Ubu.\r\n\r\nFOR AGES 14+ (ADULT)\r\n\r\nProduced by Theatre de la Pire Espece\r\nPresented by Presentation House Theatre\r\nBased on Alfred Jarry’s King Ubu"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2023-03-25T19:30:00-07:00"
