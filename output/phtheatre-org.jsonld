    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Celebrating Black History: Honouring Heritage, Inspiring the Future"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<strong>Black History Matters through Presentation House Theatre is proud to announce its first fundraiser!</strong> This Black History celebration promises to be a vibrant event dedicated to honouring the achievements, culture, and enduring legacy of Black Canadians.\r\n\r\n<strong>January 15, 2026</strong>\r\n<strong>6:30 PM – 8:30 PM</strong>\r\n<strong>Ticket Prices – $25, $35 or $45 and light refreshments will be served.</strong>\r\n\r\nProceeds from the event will benefit schools on the Lower Mainland to receive the Black History Matters Program. Join us as we celebrate Black history on Black Excellence Day—honouring heritage, inspiring the future, and strengthening our community bonds."
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-01-15T18:30:00-08:00"
      }
