  },
  {
    "@id": "https://www.phtheatre.org/temporary/af038bb7-3928-4c24-916e-8d46374c0777",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1528420"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.phtheatre.org/stec_event/pro-d-day-camps-2/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Pro-D Day Camps"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Our <strong>Pro-D Day Camps</strong> are crafted to spark creativity, encourage imaginative play, and build a deeper connection to the world of theatre. Perfect for caregivers looking for enriching and fun programming. Our classes offer a variety of themes tailored to different age groups.\r\n\r\nThis autumn, we’re offering three dynamic camps: <strong>Acting for Beginners</strong> for ages 5-6, <strong>Introduction to Lighting and Sound Design</strong> for ages 7-8, and <strong>Fundamentals of Acting</strong> for ages 9-11.\r\n<p class=\"cvGsUA direction-ltr align-start para-style-body\"><span class=\"a_GcMg font-feature-liga-off font-feature-clig-off font-feature-calt-off text-decoration-none text-strikethrough-none\"><strong>When:</strong> Friday, October 24, 2025 | 9:00 AM – 3:00 PM\r\n</span><strong><span class=\"a_GcMg font-feature-liga-off font-feature-clig-off font-feature-calt-off text-decoration-none text-strikethrough-none\">Where:</span></strong><span class=\"a_GcMg font-feature-liga-off font-feature-clig-off font-feature-calt-off text-decoration-none text-strikethrough-none\"> Presentation House Theatre | 333 Chesterfield Ave, North Vancouver</span></p>\r\n<strong>Cost:</strong>\r\n$90 per session\r\n$80 per child if more than one child attending\r\n$240 for all three sessions\r\n\r\n<strong>Questions? Call us at 604-990-3474 or email Emily Brown at <a role=\"link\" href=\"mailto:producer@phtheatre.org\">producer@phtheatre.org</a></strong>\r\n<p class=\"cvGsUA direction-ltr align-start para-style-body\"></p>\r\n<p class=\"cvGsUA direction-ltr align-start para-style-body\"><strong><span class=\"a_GcMg font-feature-liga-off font-feature-clig-off font-feature-calt-off text-decoration-none text-strikethrough-none\">For more information, please visit: </span><a class=\"a_GcMg font-feature-liga-off font-feature-clig-off font-feature-calt-off text-decoration-underline text-strikethrough-none\" draggable=\"false\" href=\"https://www.phtheatre.org/pro-d-day-camps/\" target=\"_blank\" rel=\"noopener\">phtheatre.org/pro-d-day-camps/</a></strong></p>"
      }
    ],
