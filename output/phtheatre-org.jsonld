  {
    "@id": "https://www.phtheatre.org/temporary/1aba0589-2141-45bd-a2d2-3d8be4825643",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g3244240"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
