    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Join characters “Seek” and “Hide” as they discover and explore a colourful undersea world of sensory experiences including adorable puppets, and gentle, playful interaction with live musical layers and a rich soundscape. Performed for very young audiences of curious explorers!"
      }
