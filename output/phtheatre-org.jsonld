    "http://schema.org/headline": [
      {
        "@language": "en",
        "@value": "Lasa ng Imperyo/A Taste of Empire"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Superstar&hellip;"
      }
    ],
