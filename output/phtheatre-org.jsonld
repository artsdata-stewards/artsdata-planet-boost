  {
    "@id": "https://www.phtheatre.org/temporary/3ea368b6-0911-4c67-9067-963e789bcce1",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g4796060"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
