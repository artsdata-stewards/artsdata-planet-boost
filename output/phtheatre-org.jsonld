        "@id": "_:g2161960"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.phtheatre.org/stec_event/stand-2025-6/"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.phtheatre.org/stec_event/stand-2025-6/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "STAND: To Be or Not to Be Chica Chica Boom Chic"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<div id=\"comp-mcb32s645\" class=\"Z_l5lU ku3DBC zQ9jDz qvSjx3 Vq6kJx comp-mcb32s645 wixui-rich-text\" data-testid=\"richTextElement\">\r\n<p class=\"font_8 wixui-rich-text__text\">To Be or Not to Be Chica Chica Boom Chic (also known as Samba no Pé, Verse on the Tongue) is part confessional, part carnival, part Jacobean footnote. With a shimmer of Carmen Miranda, a dash of Shakespeare, and the beat of batucada, Luciana invites the audience into a vibrant solo performance that celebrates and interrogates the multifaceted experience of immigrant identity. Through humour, movement, and lecture, the piece asks: What does it mean to be seen, misread, and remade?</p>\r\n\r\n</div>\r\n<div id=\"comp-mcb32s6412\" class=\" \">\r\n<div class=\"comp-mcb32s6412\">\r\n<div data-hook=\"tpa-components-provider\">\r\n<div id=\"gallery-wrapper-comp-mcb32s6412\">\r\n<div id=\"pro-gallery-comp-mcb32s6412\" class=\"pro-gallery\">\r\n<div class=\"\" tabindex=\"-1\" data-key=\"pro-gallery-inner-container\">\r\n<div class=\"pro-gallery-parent-container gallery-columns\" role=\"region\">\r\n<div id=\"pro-gallery-container-comp-mcb32s6412\" class=\"pro-gallery inline-styles one-row hide-scrollbars slider ltr \">\r\n<div id=\"gallery-horizontal-scroll-comp-mcb32s6412\" class=\"gallery-horizontal-scroll gallery-column hide-scrollbars ltr \" data-hook=\"gallery-column\">\r\n<div class=\"gallery-horizontal-scroll-inner\">\r\n<div data-hook=\"group-view\" aria-hidden=\"false\">\r\n<div class=\"item-link-wrapper\" tabindex=\"-1\" data-id=\"96063317-f800-43c8-84ac-1ef8c8b970a1\" data-idx=\"0\" data-hook=\"item-link-wrapper\">\r\n<div id=\"pgi96063317f80043c884ac1ef8c8b970a1_0\" class=\"gallery-item-container item-container-regular has-custom-focus visible clickable\" data-hash=\"96063317-f800-43c8-84ac-1ef8c8b970a1\" data-id=\"96063317-f800-43c8-84ac-1ef8c8b970a1\" data-idx=\"0\" data-hook=\"item-container\" aria-hidden=\"true\"></div>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n</div>"
      }
    ],
