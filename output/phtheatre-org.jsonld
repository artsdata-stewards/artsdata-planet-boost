    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<strong>Saturday, October 5, 2024\r\n7:00 PM</strong>\r\n\r\nFollowing multiple sold out events, Jokers Canada returns for a night of hilarious stand-up comedy. Enjoy an evening with pro headliners &amp; Canada’s best comedians live on Saturday, October 5th. Save money by purchasing online in advance.\r\n\r\n<strong>Ages: 19+ (No Minors)</strong>\r\n\r\n<strong>A Jokers Canada Production</strong>"
      }
    ],
