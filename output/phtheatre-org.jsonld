  {
    "@id": "https://www.phtheatre.org/temporary/62625dea-07f2-47f9-8e90-63c06eb77e93",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g3891100"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.phtheatre.org/stec_event/stand-2024-9/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "STAND: Moving Bodies - Migrant Stories"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<strong>November 7, 2024</strong>\r\n<strong>6:00 PM – 9:00 PM</strong>\r\n<strong>Presentation House Theatre (Gallery)</strong>\r\n\r\n<em><strong>Limited spots available</strong></em>\r\n\r\nInstructor: <strong>Alvin Erasga Tolentino</strong>\r\n\r\nEmbark on a journey through the power of movement and community through dance. This unique workshop invites participants to delve into the profound narratives of migration, exploring themes of identity, integration, and the human experience through poetic gestures and expressive movement. Engage the freedom to dance together while discovering how personal stories can be embodied and communicated through the art of movement. Don’t miss this opportunity to connect, create, and explore with Tolentino in a transformative dance and cultural expression exploration."
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2024-11-07T18:00:00-08:00"
      }
