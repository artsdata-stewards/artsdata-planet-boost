    "http://schema.org/headline": [
      {
        "@language": "en",
        "@value": "STAND: She Planted, You Watered, and I Grow (full version)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "She&hellip;"
      }
    ],
