  {
    "@id": "https://www.phtheatre.org/temporary/4f04a212-8d00-438e-bdac-0052d8feeeb1",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g3889480"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.phtheatre.org/stec_event/ggg-3/"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.phtheatre.org/stec_event/ggg-3/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Grandma. Gangsta. Guerrilla."
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "This ain’t a sob story about war crimes, dementia, nor getting old. It’s a sprint down the memory lane of a butt-kickin’, bar-spittin’, tough grandma who escapes the care home to be with her family. When our favourite Filipino grandma Lola Basyang goes missing, it’s up to her grandchildren Nika and Jun-jun to bring her back to safety. Using their lola’s unfinished memoir, they find clues to her whereabouts, her full-of-beans origin story and the historical turmoils of their motherland. Reminiscent of their immigration stories, they reflect on what it means to maintain family ties in a Western society.\r\n\r\n<strong>Ages: 14+</strong>\r\n\r\n<strong>A Ruby Slippers Theatre Production</strong>\r\n\r\n<strong>Co-Presented by Blackout Art Society and Presentation House Theatre</strong>"
      }
    ],
