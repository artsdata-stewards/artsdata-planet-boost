  {
    "@id": "https://www.phtheatre.org/temporary/bb0a3548-ea64-475c-8c3c-47a26378f56e",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g4646680"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
