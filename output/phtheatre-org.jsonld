    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "PHT Community Clothing Swap"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<strong>Sunday, September 22, 2024</strong>\r\n\r\n<strong>11:00 AM to 3:00 PM</strong>\r\n\r\nThis is a FREE event that requires no registration! Walk-ups are welcome.\r\n\r\nRefresh your closet just in time for fall at Presentation House Theatre’s first-ever Community Clothing Swap! Please bring a maximum of 20 gently used clothing items and swap them for something new-to-you. We welcome clothing for all ages, all sizes, and all genders. And best of all, entry is free! Don’t miss this chance to give your wardrobe a sustainable makeover while connecting with the PHT community. We hope to see you there!"
      }
    ],
