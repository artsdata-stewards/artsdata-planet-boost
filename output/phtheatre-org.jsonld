  {
    "@id": "https://www.phtheatre.org/temporary/6b9951e7-42fc-49df-a4a9-14526e14e7b3",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g8801200"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
