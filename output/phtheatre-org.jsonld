  {
    "@id": "https://www.phtheatre.org/temporary/2a0d65ed-e34f-4b4a-ad59-49f0e53caf2b",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g4540080"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.phtheatre.org/stec_event/stand-2024-14/"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.phtheatre.org/stec_event/stand-2024-14/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "STAND: The Toad Canes / Metamorphosis"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<strong>November 10, 2024</strong>\r\n<strong>7:30 PM – 8:30 PM</strong>\r\n\r\nExperience an allegory of the labyrinth within the web of family relationships and the power dynamics that insidiously sustain its structure. Inspired by Frantz Fanon’s exploration of revolt and violence, this thriller drama unapologetically examines the interplay between repression and transformation. <em><strong>The Toad Canes</strong></em> invites profound contemplation on the ethical quandaries that emerge from raw assertion and confrontation of power.\r\n\r\n<strong>Audience Advisory:</strong> Please be advised that <strong><em>The Toad Canes</em></strong> contains a few scenes depicting violence, blood, and the use of flashing lights."
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2024-11-10T19:30:00-08:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2024-11-10T20:30:00-08:00"
      }
