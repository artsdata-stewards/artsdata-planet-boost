  {
    "@id": "https://www.phtheatre.org/temporary/b456d321-60a6-4d9e-a9d1-409ea9e267f8",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g2225860"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
