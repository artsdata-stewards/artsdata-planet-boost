    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "A joyful theatrical experience for kids (ages 3-7) that explores intergenerational love with warmth, laughter &amp; puppetry. Co-produced by Marionetas de la Esquina and Presentation House Theatre.\r\n\r\n<a href=\"https://www.phtheatre.org/learning-forgetting-apr-2022/\">Click here for full show details.</a>"
      }
