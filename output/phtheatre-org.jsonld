  {
    "@id": "https://www.phtheatre.org/temporary/c7978eb4-fe96-4d56-abb0-19b828251625",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g4284080"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
