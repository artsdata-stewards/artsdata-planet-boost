  {
    "@id": "https://www.phtheatre.org/temporary/d6d510c6-6cd4-48e2-8368-08cc761f57d0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1655720"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
