  {
    "@id": "https://www.phtheatre.org/temporary/9fe214c0-08e9-4267-8dd0-7c8b1620c5ca",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g5097360"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.phtheatre.org/stec_event/little-sister-grimm-3/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Little Sister Grimm"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Bored and tired of doing chores, little Lotte Grimm sneaks a peek at a ‘broken’ fairy tale her older brothers have collected. To fix it, she finds a way to enter the story and save its heroine, but not everything goes as planned…\r\n\r\nBased on historical research and using different types of puppets, this whimsical play gives a fresh perspective on how our classic fairy tales were first recorded, and how women contributed to their preservation. For anyone who loves puppets or fairy tales!\r\n\r\n<strong>For all ages (5+ recommended)</strong>\r\n\r\n<strong>Presented by Fallada Puppetworks in association with Presentation House Theatre</strong>"
      }
    ],
