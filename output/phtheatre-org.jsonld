  {
    "@id": "https://www.phtheatre.org/temporary/0d48ee68-a85d-423f-9183-6b3411b4fad6",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g3764020"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
