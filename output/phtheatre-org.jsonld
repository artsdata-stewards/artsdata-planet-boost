  {
    "@id": "https://www.phtheatre.org/temporary/a7565312-bdd1-4dda-96af-91fa393abde3",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g2268740"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.phtheatre.org/stec_event/pro-d-day-camps-1/"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.phtheatre.org/stec_event/pro-d-day-camps-1/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Pro-D Day Camps"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p class=\"cvGsUA direction-ltr align-center para-style-body\"><strong><span class=\"a_GcMg font-feature-liga-off font-feature-clig-off font-feature-calt-off text-decoration-none text-strikethrough-none\">Looking for an exciting and creative way for </span><span class=\"a_GcMg font-feature-liga-off font-feature-clig-off font-feature-calt-off text-decoration-none text-strikethrough-none\">your child to spend their Pro-D Day?</span></strong></p>\r\n<p class=\"cvGsUA direction-ltr align-start para-style-body\"><span class=\"a_GcMg font-feature-liga-off font-feature-clig-off font-feature-calt-off text-decoration-none text-strikethrough-none\">Register your child for one of the three camps we have to offer: </span><strong><span class=\"a_GcMg font-feature-liga-off font-feature-clig-off font-feature-calt-off text-decoration-none text-strikethrough-none\">Introduction to Storytelling</span></strong><span class=\"a_GcMg font-feature-liga-off font-feature-clig-off font-feature-calt-off text-decoration-none text-strikethrough-none\"> for primary grades, </span><strong><span class=\"a_GcMg font-feature-liga-off font-feature-clig-off font-feature-calt-off text-decoration-none text-strikethrough-none\">Build Your Own Puppet</span></strong><span class=\"a_GcMg font-feature-liga-off font-feature-clig-off font-feature-calt-off text-decoration-none text-strikethrough-none\"> for intermediate grades, and </span><strong><span class=\"a_GcMg font-feature-liga-off font-feature-clig-off font-feature-calt-off text-decoration-none text-strikethrough-none\">Dungeons &amp; Dragons</span></strong><span class=\"a_GcMg font-feature-liga-off font-feature-clig-off font-feature-calt-off text-decoration-none text-strikethrough-none\"> for our teens and tweens.</span></p>\r\n<p class=\"cvGsUA direction-ltr align-start para-style-body\"><strong><span class=\"a_GcMg font-feature-liga-off font-feature-clig-off font-feature-calt-off text-decoration-none text-strikethrough-none\">When:</span></strong><span class=\"a_GcMg font-feature-liga-off font-feature-clig-off font-feature-calt-off text-decoration-none text-strikethrough-none\"> Monday, May 5, 2025 | 9:00 AM – 3:00 PM\r\n</span><strong><span class=\"a_GcMg font-feature-liga-off font-feature-clig-off font-feature-calt-off text-decoration-none text-strikethrough-none\">Where:</span></strong><span class=\"a_GcMg font-feature-liga-off font-feature-clig-off font-feature-calt-off text-decoration-none text-strikethrough-none\"> Presentation House Theatre | 333 Chesterfield Ave, North Vancouver</span></p>\r\n<p class=\"cvGsUA direction-ltr align-start para-style-body\"><strong>Cost:</strong>\r\nIntroduction to Storytelling (Ages 7-8): $90 for the full day\r\nBuild Your Own Puppet (Ages 9-11): $90 for the full day\r\nDungeons and Dragons (Ages 12-14): $110 for the full day</p>\r\n<p class=\"cvGsUA direction-ltr align-start para-style-body\"><strong><span class=\"a_GcMg font-feature-liga-off font-feature-clig-off font-feature-calt-off text-decoration-none text-strikethrough-none\">Questions? Call us at 604-990-3474 or email Emily Brown at </span><a class=\"a_GcMg font-feature-liga-off font-feature-clig-off font-feature-calt-off text-decoration-underline text-strikethrough-none\" draggable=\"false\" href=\"mailto:mailtoproducer@phtheatre.org\" target=\"_blank\" rel=\"noopener\">producer@phtheatre.org</a></strong></p>\r\n<p class=\"cvGsUA direction-ltr align-start para-style-body\"><strong><span class=\"a_GcMg font-feature-liga-off font-feature-clig-off font-feature-calt-off text-decoration-none text-strikethrough-none\">For more information, please visit: </span><a class=\"a_GcMg font-feature-liga-off font-feature-clig-off font-feature-calt-off text-decoration-underline text-strikethrough-none\" draggable=\"false\" href=\"https://www.phtheatre.org/pro-d-day-camps/\" target=\"_blank\" rel=\"noopener\">phtheatre.org/pro-d-day-camps/</a></strong></p>"
      }
    ],
