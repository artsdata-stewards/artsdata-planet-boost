    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Majiawa! Idol Stage"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<strong>Sunday, January 4, 2026\r\nPerformance: 1:00 PM – 4:30 PM\r\nMeet &amp; Greet: 4:45 PM – 7:00 PM</strong><strong>\r\n</strong>\r\n\r\n<em>Majiawa!</em> is a multi-artist idol performance event combining live music, dance, and interactive fan experiences, followed by a post-show meet &amp; greet.\r\n\r\n<strong>Advisories:</strong> Use of flashing lights during the performance."
      }
    ],
