  {
    "@id": "https://www.phtheatre.org/temporary/5192b40c-8e5f-4fea-b89b-2bb11ab5f6fc",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g6671660"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.phtheatre.org/stec_event/fans-gala/"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.phtheatre.org/stec_event/fans-gala/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "FANS Tribute to the Arts"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<div>The Fund for the Arts on the North Shore (FANS) is delighted to announce the long-awaited return of its annual FANS Tribute to the Arts gala. Join this year’s emcee comedian David Jones for an evening of live performances, culinary delights, silent auction and presentations of cash grants for local artists.  The night will culminate with the presentations of the prestigious FANS Distinguished Artist Awards to public artist Jill Anholt and musician Colin James.</div>\r\nBy attending this gala, you are directly supporting burgeoning and established artists on the North Shore.\r\n\r\n<a role=\"link\" href=\"http://www.nsfans.ca/\"><strong>www.nsfans.ca</strong></a>\r\n\r\nDoors open at 7:00 PM.\r\n\r\nPerformances in the theatre start at 8:00 PM.\r\n\r\n<strong>For all ages!</strong>"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2023-11-17T19:00:00-08:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2023-11-17T22:00:00-08:00"
      }
    ],
