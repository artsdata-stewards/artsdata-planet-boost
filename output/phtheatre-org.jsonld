    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "STAND: Empower & Elevate Grant Writing"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<h3>Empower &amp; Elevate\r\nGrant Writing</h3>\r\n<strong>Monday, Nov 6 – 5:30 PM\r\n</strong><strong>Thursday, Nov 9 – 5:30 PM</strong>\r\n\r\nLed by <strong>Amir N. Hosseini</strong>, Blackout Art Society’s Artistic Director, in this workshop, on the first day, we’ll review tips and hints on how to write a compelling grant application.\r\n\r\nOn the second day, all participants will work on a sample grant and compete for a chance to win a $150 grant award."
      }
    ],
