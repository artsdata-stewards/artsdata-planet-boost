  {
    "@id": "https://www.phtheatre.org/temporary/4603cd8e-cd15-4942-8837-46d22ab17b2e",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g5563060"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.phtheatre.org/stec_event/learning-and-forgetting-4/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Learning and Forgetting"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Join young Eva and her brother as they embark on a heartwarming adventure with their beloved Grandpa, whose memories often take flight like butterflies in the wind. Eva and her brother lift Grandpa’s spirits on moving day as he transitions into a new home. Follow along as they learn to find joy in the moment, play in the present, and create new stories together.\r\n\r\nThis joyful theatrical experience for kids explores intergenerational love with warmth, laughter, and puppetry. What makes this show unique is the unexpected element– with each performance, a new senior actor steps into the role of Grandpa, artfully reflecting the complexities of memory loss. A truly unique experience for the whole family.\r\n\r\n<strong>For ages 3-7 and their favourite grown-ups!</strong>\r\n\r\n<strong>Co-Production with Marionetas de las Esquinas and Presentation House Theatre</strong>"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2024-04-28T11:00:00-07:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2024-04-28T12:00:00-07:00"
      }
    ],
