  {
    "@id": "https://www.phtheatre.org/temporary/a438e7f7-44d4-4e72-8279-e64c96417805",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g4369400"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
