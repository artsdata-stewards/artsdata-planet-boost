  {
    "@id": "https://www.phtheatre.org/temporary/254e2bc5-3723-4377-a517-fedcc2770cc8",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g3679400"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.phtheatre.org/stec_event/stand-2024-8/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "STAND: Curation and Artist - Presenter Relations"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<strong>November 6, 2024</strong>\r\n<strong>6:00 PM – 7:30 PM</strong>\r\n<strong>Presentation House Theatre (Gallery)</strong>\r\n\r\n<em><strong>Limited spots available – Expert Guidance for STAND Artists</strong></em>\r\n\r\nInstructor: <strong>Gabrielle Martin</strong>\r\n\r\nIn this session, you will gain valuable insights into PuSh’s curatorial vision and explore how to promote creative projects effectively within contemporary performing arts markets. This workshop is tailored specifically for STAND artists, providing a unique platform to learn from industry experts and enhance your approach to artistic promotion and festival participation."
      }
    ],
