  {
    "@id": "https://www.phtheatre.org/temporary/85a8098f-b100-467e-ac29-579fa568ba90",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1544320"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
