  {
    "@id": "https://www.phtheatre.org/temporary/6b9d2cdb-7533-47ad-9b5e-9f88d746d37d",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1203260"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.phtheatre.org/stec_event/meet-with-actsafe/"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.phtheatre.org/stec_event/meet-with-actsafe/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Meet With Actsafe"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<div class=\"wpb_text_column wpb_content_element\">\r\n<div class=\"wpb_wrapper\">\r\n\r\n<b>Meet With… Actsafe</b>\r\n\r\nThe show must go on—safely. Join us for our first <b>Meet With… Series</b> session. This is an opportunity to grow your skills in business operations and learn from professionals in their respective fields. <b>Meet With… Actsafe</b>, the organization that provides the training, resources, and support to keep BC’s arts and entertainment workers healthy and safe, from stage to screen.\r\n\r\nTake a deep dive into what they do, the resources they offer, and their key contributions to the industry. Get a clear understanding of their purpose, their wide range of industry-specific courses and workshops, and valuable programs. Learn how these services provide customized support to help you create a safer, healthier workplace. There will also be a chance to ask questions and enjoy refreshments while meeting other like minded industry professionals.\r\n\r\nRegister now to learn how Actsafe can be your partner in safety.\r\n\r\nThis is an in-person session at Presentation House Theatre and registration is <b>Pay-What-You-Can.</b>\r\n\r\n</div>\r\n</div>"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-03-11T15:00:00-07:00"
      }
