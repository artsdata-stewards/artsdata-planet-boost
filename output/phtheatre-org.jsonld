      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "My Queer Valentine"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "GOLDbard Creative is proud to present an evening of delightful debauchery. It’s time to put on your most fabulous ensemble (best dressed wins a prize!) and join us for sexy bedtime stories, buxom burlesque performances, and music to get you in the mood. This evening promises to leave you all hot and bothered, so get ready for fun!\r\n\r\nWith performances by:\r\n\r\nAndy Warner, Mistress of Ceremonies and resident poet\r\n\r\nBurlesque goddesses La Dame Derriere and Vita Devour\r\n\r\nAnd music to get you in the mood from: <strong><a href=\"https://www.youtube.com/channel/UCvLi5Rktad-t884JL7GQ6hw\" target=\"_blank\" rel=\"noopener\">GOLDbard</a></strong>"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2023-02-14T20:00:00-08:00"
