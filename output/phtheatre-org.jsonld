  {
    "@id": "https://www.phtheatre.org/temporary/c9420dfb-3026-41b8-976e-d7ad354ac547",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g3785220"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
