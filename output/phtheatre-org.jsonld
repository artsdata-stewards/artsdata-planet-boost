  {
    "@id": "https://www.phtheatre.org/temporary/45ef10a5-c0f1-48e5-bc72-3ec544c4934b",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1316180"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.phtheatre.org/stec_event/haunted-histories-2/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Haunted Histories: An Evening with the Vancouver Paranormal Society"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Explorers of the unseen, the Vancouver Paranormal Society is back at PHT! In this special presentation, the team will share their findings and experiences from investigating Presentation House Theatre, a historical building that’s over a hundred years old and rumoured to be home to several spirits.\r\n\r\n<strong>Want to test your investigative skills?</strong> We will be holding <strong>a raffle to WIN</strong> the opportunity to investigate Presentation House Theatre’s haunted halls with the Vancouver Paranormal Society immediately following the presentation! <strong>Raffle tickets will be available for purchase at the event—be prepared to stay late and commune with the spirits if you enter.</strong>\r\n\r\nWhether you’re a believer, a skeptic, or simply curious, this event promises to be a captivating evening filled with fascinating insights into the paranormal. Don’t miss this chance to learn about the spirits that call Presentation House Theatre their home!\r\n\r\nFounded in 1993, the Vancouver Paranormal Society is North America’s oldest paranormal research team, known for their professionalism and dedication to investigating the unexplained. Discover the methods behind paranormal investigation and hear about the society’s longstanding relationships with local heritage sites and their spooky encounters over the years.\r\n\r\n<em><strong>VPS will have a donation box available for non-perishable food items to donate back to the community.</strong></em>\r\n\r\n<strong>Ages: 10+</strong>\r\n\r\n<strong>A Presentation House Theatre Event</strong>"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-11-22T19:30:00-08:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-11-22T21:30:00-08:00"
      }
