    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Back by popular demand, and following two SOLD OUT events, Jokers Canada is returning to the PH Theatre for another North Vancouver Comedy Classic. Enjoy a fresh lineup of pro comedians for one hilarious night of stand-up.\r\n\r\n<strong>Ages: 19+ (No Minors)</strong>\r\n\r\n<strong>A Jokers Canada Production</strong>"
      }
