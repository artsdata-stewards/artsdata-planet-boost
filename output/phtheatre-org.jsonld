    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Valentines Writing Workshop"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<strong>Price – $25 / $35 / $45</strong>\r\n\r\nOur Adult Education Programs are <strong>Pay-What-You-Can.</strong> We offer sliding scale options at PHT that allow you to pick the price that works for you, no questions asked!\r\n\r\n<strong>Write letters with love!</strong> Celebrate Valentine’s Day by creating something meaningful with your words. Led by Kimberly Sunder, participants will get the chance to craft something personal for their loved ones—whether it be for a partner, a friend, or yourself—draft and polish those love letters, Valentine’s cards, and more! This workshop welcomes writers of all levels, offering a supportive space to explore your heart and unleash your creativity.\r\n\r\nSupplies included."
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-02-02T18:30:00-08:00"
