  {
    "@id": "https://www.phtheatre.org/temporary/f0d1961f-606d-476a-9352-52e9c5dea21c",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g7699900"
