  {
    "@id": "https://www.phtheatre.org/temporary/5cdd09b4-9999-475f-bb01-bd70b364c066",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g4124160"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
