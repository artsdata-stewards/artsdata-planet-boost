  {
    "@id": "https://www.phtheatre.org/temporary/ceab779f-cd97-4efc-b027-10b8359f665f",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g6324840"
      }
    ],
