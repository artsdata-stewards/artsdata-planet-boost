  {
    "@id": "https://www.phtheatre.org/temporary/f46984b2-78f3-46ba-b06a-914d85dfb196",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g7784580"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.phtheatre.org/stec_event/learning-and-forgetting/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Learning and Forgetting"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Young Eva is excited to learn new words and ideas. Her beloved Grandpa forgets – his memories and words aren’t close at hand anymore. But that doesn’t keep them from playing in the present and creating new stories together. This joyful learning in place theatrical experience for kids ages 3-7 explores intergenerational love with warmth, laughter &amp; puppetry.\r\n\r\nEva and her brother lift Grandpa’s spirits on moving day as he transitions into a new home.  Follow along as they find joy in the moment and learn understanding for a lifetime.\r\n\r\nFOR AGES 3 -7\r\n\r\nCo-Production with Marionetas de las Esquinas and Presentation House Theatre"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2023-04-28T16:00:00-07:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2023-04-28T17:00:00-07:00"
      }
    ],
