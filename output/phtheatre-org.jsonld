    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Oh Mother"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "OH MOTHER is a multimedia tour de force inspired by real life stories of motherhood.\r\n\r\nAccompanied by breathtaking videos, Superstein reaches new artistic heights featuring some of Canada’s most innovative musicians–many of whom are also mothers. Meticulously arranged, layers of rich textures, powerful vocals, heartfelt imagery. While it focuses on the parental experience, this free-spirited show is for everyone.\r\n\r\nAndrea Superstein is one of the most versatile vocalists in Canadian music today. Dubbed as “redefining jazz” by the Vancouver Province, her debut performance earned her a nomination for a Galaxie Rising Star award and launched her squarely into the limelight.\r\n\r\n“She’s a genuine original” BBC Music Magazine"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2023-04-01T19:30:00-07:00"
      }
