    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<div class=\"wpb_text_column wpb_content_element \">\r\n<div class=\"wpb_wrapper\">\r\n\r\nFollowing multiple sold out events, Jokers Canada returns to North Vancouver for a night of hilarious stand-up comedy featuring touring headliners &amp; our country’s funniest pro comedians.\r\n\r\n</div>\r\n</div>\r\n<strong>Ages: 19+ (No Minors)</strong>\r\n\r\n<strong>A Jokers Canada Production</strong>"
      }
    ],
