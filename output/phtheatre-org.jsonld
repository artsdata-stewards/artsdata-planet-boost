  {
    "@id": "https://www.phtheatre.org/temporary/66328420-3929-49f1-9bd7-d33f91578178",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g2862660"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.phtheatre.org/stec_event/time-of-your-life/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Time of Your Life: A Funny Fundraiser"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Join us for <strong><em>Time of Your Life</em></strong>, an improv comedy fundraiser for Presentation House Theatre. This is a lighthearted way to have a serious impact, helping raise much needed funds for PHT programs — on stage and in the community.\r\n\r\nWhat better way to say goodbye to our outgoing Artistic Director Kim Selody, and welcome in Keltie Forsyth to take his place, than to have their lives and careers re-enacted by improv comedians?\r\n\r\nEveryone has a story — not everyone has to watch improvisors tell theirs back to them!\r\n\r\nYour ticket grants you access to limitless laughter, a delicious reception, and a drink of your choosing to sip and savour. Arrive early to browse and bid in our Silent Auction.\r\n\r\n<strong>Ages: 12+</strong>\r\n\r\n<strong>A Presentation House Theatre Production</strong>"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-04-01T19:30:00-07:00"
      }
