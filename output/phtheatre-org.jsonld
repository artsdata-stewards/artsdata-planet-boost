        "@id": "https://www.phtheatre.org/stec_event/stand-2025-2/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "STAND: Fundamentals of Contact Improvisation"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Join us for a two-hour introduction to contact improvisation, beginning with breath and sensory warm-ups. We’ll explore gravity and the floor as our first dance partners before moving into shared weight and connection. This workshop invites play, curiosity, and the transformative experience of being fully in our bodies."
      }
    ],
