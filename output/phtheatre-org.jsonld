    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<strong>Saturday, April 12, 2025</strong>\r\n<strong>7:00 PM</strong>\r\n\r\nJokers Canada returns to North Van with a lineup of Canada’s funniest pro comedians. These events always sell out! Save money by purchasing online in advance.\r\n\r\n<strong>Ages: 19+ (No Minors)</strong>\r\n\r\n<strong>A Jokers Canada Production</strong>\r\n\r\n&nbsp;"
      }
    ],
