  {
    "@id": "https://www.phtheatre.org/temporary/717c34b1-a059-4ee8-bec5-5d1d79fd5d28",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g4038660"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
