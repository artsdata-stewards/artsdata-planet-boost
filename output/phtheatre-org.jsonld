  {
    "@id": "https://www.phtheatre.org/temporary/53eb4406-63d7-4e34-afd1-cb2aecdf9f02",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g2417040"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
