    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Robin Hood"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "It's Robin Hood! Come enter the Land of Fancy, “where the weather is always fair, flowers bloom forever, Sheriffs run amok, and only a Merry Band can inspire the people to face him.” This lighthearted adaptation of the Robin Hood tales brings you the characters you know and love, lots of music and laughter, and surprising new twists and turns.\r\n\r\nBest of all, it’s performed outside!\r\n\r\nA Lakeside Players Production presented by Presentation House Theatre"
      }
    ],
    "http://schema.org/startDate": [
