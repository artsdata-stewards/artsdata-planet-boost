  {
    "@id": "https://www.phtheatre.org/temporary/15c90954-1552-49dd-bca6-176c2feb068f",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g8418120"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
