    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Bright: A Holiday Singalong Concert"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Celebrate the most wonderful time of the year with <em><strong>Bright: A Holiday Singalong Concert</strong></em> from Presentation House Theatre!\r\n\r\nGather around for a festive singalong of holiday favourites! Bring your family, friends, and loved ones all together for an unforgettable time of music and merriment. We’ll bring the song lyrics, you bring your voices, and together we’ll make some holiday cheer. A casual and warm embrace of the songs of the season.\r\n\r\n<strong>Festive fun for all ages!</strong>\r\n\r\n<strong>A Presentation House Theatre Production</strong>\r\n\r\n<strong>Presented in partnership with Arts Umbrella</strong>"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
