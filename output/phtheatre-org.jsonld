    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Pop! Pop!"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Join characters “Seek” and “Hide” as they discover and explore a colourful undersea world of sensory experiences including adorable puppets, and gentle, playful interaction with live musical layers and a rich soundscape. Performed for very young audiences of curious explorers aged 2-4 years and their caregivers.\r\n\r\nA Carousel Players and Presentation House Theatre co-production\r\n\r\nWritten by Linda A. Carson with Monica Dufault and Kim Selody"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
