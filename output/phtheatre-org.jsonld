  {
    "@id": "https://www.phtheatre.org/temporary/b8f6650c-44c5-48e2-b0d8-0de7a95c423d",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g5136880"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.phtheatre.org/stec_event/she-planted-you-watered-and-i-grow-2/"
