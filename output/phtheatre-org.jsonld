    ],
    "http://schema.org/headline": [
      {
        "@language": "en",
        "@value": "STAND: Reborn on Stage Monologue Writing"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Reborn&hellip;"
      }
    ],
    "http://schema.org/datemodified": [
