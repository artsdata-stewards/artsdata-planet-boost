      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.phtheatre.org/stec_event/movie-singalong-2/"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.phtheatre.org/stec_event/movie-singalong-2/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Movie Singalong: The Sound of Music"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Climb every mountain with PHT’s first-ever Movie Singalong! Delight in <em><strong>The Sound of Music</strong></em> and join us for a special screening of the 1965 classic movie musical adapted from the stage version of the same name by Rodgers and Hammerstein, starring Julie Andrews and Christopher Plummer. Follow Maria as she’s sent to the house of a retired naval captain to care for his children, who have run off countless governesses. Maria teaches the children to sing, and through her, music is brought back into the hearts and home of the Von Trapp family. Sing along to popular tunes such as “Do-Re-Mi”, “My Favorite Things”, “Edelweiss”, and more!\r\n\r\n<strong>Come decked out in your finest <em>Sound of Music</em>-inspired ensemble for our pre-movie costume contest!</strong> Winner will receive a prize.\r\n\r\nCostumes are not mandatory, but highly encouraged! We ask that you respectfully refrain from wearing any military costumes.\r\n\r\n<strong>Admission includes a complimentary small bag of popcorn.</strong>\r\n\r\n<strong>Ages: 8+</strong>"
      }
    ],
