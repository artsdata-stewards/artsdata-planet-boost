  {
    "@id": "https://www.phtheatre.org/temporary/11c8b2c2-3fd5-4293-91c3-058f554f8b76",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g8038060"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.phtheatre.org/stec_event/hamlet/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Hamlet"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<h6><span style=\"color: #000000;\"><strong>Tickets via Eventbrite:<span style=\"color: #0000ff;\"> <a style=\"color: #0000ff;\" href=\"https://www.eventbrite.com/e/hamlet-2022-tickets-438780222457\" target=\"_blank\" rel=\"noopener\" data-saferedirecturl=\"https://www.google.com/url?q=https://www.eventbrite.com/e/hamlet-2022-tickets-438780222457&amp;source=gmail&amp;ust=1665677225497000&amp;usg=AOvVaw0LZ9sDNeCvJXsTQl7YaEjP\">https://www.eventbrite.com/e/<wbr />hamlet-2022-tickets-<wbr />438780222457</a></span></strong></span></h6>\r\n<h6><span style=\"color: #000000;\">Tickets may be purchased online only via<span style=\"color: #0000ff;\"> <a style=\"color: #0000ff;\" href=\"https://www.eventbrite.com/e/hamlet-2022-tickets-438780222457%20_blank\" target=\"_blank\" rel=\"noopener\" data-saferedirecturl=\"https://www.google.com/url?q=https://www.eventbrite.com/e/hamlet-2022-tickets-438780222457%2520_blank&amp;source=gmail&amp;ust=1665677225497000&amp;usg=AOvVaw06a5J0tTCqfOyx9L-vW_NW\">Eventbrite.com</a>.</span> Phone bookings are not available for this event.</span></h6>\r\n<h6><span style=\"color: #000000;\"><strong>A HUB Happening produced by The Harlequin Theatre Society in association with the PHT Creative HUB</strong></span></h6>\r\n<h6><span style=\"color: #000000;\"><strong>Our version of Hamlet is sure to spook even the bravest theatre-goer!</strong></span></h6>\r\n<h6><span style=\"color: #000000;\"><strong>“Denmark is a prison”  and so is the theatre when it comes to our production of Hamlet. Whether it’s the creepy ghost that follows our protagonist about the castle or the girl who drowns herself after singing a bunch of love songs, we are honouring everything that is scary about one of William Shakespeare’s finest tragedies!</strong></span></h6>"
      }
    ],
