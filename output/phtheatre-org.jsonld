  {
    "@id": "https://www.phtheatre.org/temporary/8e5b6408-ac82-49ca-aceb-b3930ec51598",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g2014940"
      }
    ],
