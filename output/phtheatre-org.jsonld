    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Chapter 21"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Produced by Raven Spirit Dance, Chapter 21 is choreographed by Starr Muranko and directed by Yvette Nolan. This dance/theatre piece explores what happens when a vibrant, active artist comes face to face with a crippling collision of events. Chapter 21 is a reflection on the days that have come to pass, and the art of becoming. A new baby boy; Chromosome 21; the big “C” diagnosis, 21 days between treatments, and 21 days to re-pattern beliefs; Courage; Faith; Resilience."
      }
    ],
