    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Irandokht"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<em>Irandokht</em> is a theater performance by young girls. It’s a powerful performance by young girls, bringing to life the timeless stories of Iran’s mythical heroes. Through storytelling, our young actors explore themes of bravery, justice, and kindness — sharing lessons that inspire today’s youth.\r\n\r\n<strong>Ages: 5+</strong>\r\n\r\n<strong>A community theatre project by families &amp; young artists — created with love, not for profit.</strong>"
      }
    ],
