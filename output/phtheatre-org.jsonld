      }
    ]
  },
  {
    "@id": "https://www.phtheatre.org/temporary/de4fd1d8-559b-4cfc-8482-6bf705155ab5",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g6777900"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.phtheatre.org/stec_event/stand-7/"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.phtheatre.org/stec_event/stand-7/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "STAND: Reborn on Stage Monologue Writing"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<h3>Reborn on Stage\r\nMonologue Writing</h3>\r\n<strong>Friday, Nov 10 – 6:00 PM\r\n</strong><strong>Nov 11 &amp; 12 – 11:00 AM to 5:00 PM</strong>\r\n\r\nJoin an immersive workshop led by <strong>Naghmeh</strong> <strong>Samini</strong>, scriptwriter and lecturer in Dramatic Arts. You’ll learn the craft of writing monologues based on real historical or cultural figures, bringing them back to life on stage.\r\n\r\nParticipants in this three-day workshop will first improve their writing skills in creative writing exercises and then go through the innovative methods of writing monologue (Mono Drama) by focusing on a real character Who has historical or cultural importance. At the end of the workshop, the participants will read their writings in public to get the audience’s feedback.\r\n\r\nNaghmeh has recently led a similar workshop at the University of Tokyo, Japan.\r\n\r\n<strong>Please note this workshop is in Farsi.</strong>"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2023-11-10T18:00:00-08:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2023-11-12T17:00:00-08:00"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
