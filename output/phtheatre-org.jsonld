  {
    "@id": "https://www.phtheatre.org/temporary/e23cde71-6bc2-4546-a6fb-623e15fad642",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1331160"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.phtheatre.org/stec_event/roman-empire-1/"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.phtheatre.org/stec_event/roman-empire-1/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Bulimia is My Roman Empire"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "As a group of Servants attempt to assassinate the Emperor, they discover that power may not be all that they had once desired. Learning that their target is engaged in a number of self-destructive behaviours, our conspirators are forced to follow down a long rabbit hole of strange diets, machismo, and fascism should they want to prove that they deserve the right to rule. As a satire of manhood, ultimately no one’s happy with where they end up.\r\n\r\n<strong>Ages: 14+</strong>\r\n\r\n<strong>A Great Trash Production presented in association with the PHT Creative Hub</strong>"
      }
    ],
