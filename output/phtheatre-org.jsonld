  {
    "@id": "https://www.phtheatre.org/temporary/b6982ceb-5cab-47cb-a64f-2b8d09543486",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g3912260"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.phtheatre.org/stec_event/stand-2024-7/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "STAND: Speaking Body"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<strong>November 4, 2024</strong>\r\n<strong>6:00 PM – 9:00 PM</strong>\r\n<strong>Presentation House Theatre (Gallery)</strong>\r\n\r\n<em><strong>Limited spots available</strong></em>\r\n\r\nInstructor: <strong>Wen Wei</strong>\r\n\r\nThis workshop is designed to help participants develop a unique personal language through their own body and movement, using creative thinking to express cultural identity, individuality, and individual voice. It starts with breathing exercises and stretching warm-ups, progresses to improvisation techniques, and culminates in the creation of a short solo piece, making this an enriching experience for all involved."
      }
    ],
