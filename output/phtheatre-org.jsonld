  {
    "@id": "https://www.phtheatre.org/temporary/e93c7e92-bd1c-4c9a-99d0-cb537cfd1338",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g6261180"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
