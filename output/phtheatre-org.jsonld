    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "World Ender"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<i>World Ender </i>is a musical exploring various publicly-derived answers to one question: “How would the world end for you?” With compiled vignettes of songs and stories, the performance explores answers such as global warming, apocalypse, and more through the lenses of young adults who give these answers. <i>World Ender</i> explores themes of death, existentialism, love, joy, and the human condition.\r\n\r\n<strong>Ages: 13+</strong>\r\n\r\n<strong>Great Trash Productions presented in association with the PHT Creative Hub</strong>"
      }
    ],
