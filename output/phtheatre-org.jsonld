    "http://schema.org/headline": [
      {
        "@language": "en",
        "@value": "Haunted Histories: An Evening with the Vancouver Paranormal Society"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Explore&hellip;"
      }
    ],
