    "http://schema.org/headline": [
      {
        "@language": "en",
        "@value": "7th Annual All-Star Stand-Up Comedy Night"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "PHT’s&hellip;"
      }
    ],
    "http://schema.org/datemodified": [
