  {
    "@id": "https://www.phtheatre.org/temporary/ba41fe0c-cb02-413b-abf8-16a8f0fc0550",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g8226660"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
