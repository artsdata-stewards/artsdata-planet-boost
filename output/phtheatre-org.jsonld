    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Where the Wild Things Are"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Come join the wild rumpus! Max is back for a magical adventure into the land of the Wild Things! This fan-favourite show will bring pure wonder &amp;amp; wow to the whole family.\r\n\r\nAfter 20 years and more than 1,000 performances all around North America, this truly is classic piece of children's\r\ntheatre.\r\n\r\nFun for ages 3 - 6 (and their favourite grown-ups). Come play!\r\n\r\nA Presentation House Theatre Production. Based on the book by Maurice Sendak. Originally adapted for the stage by\r\nTAG Theatre Glasgow, Scotland"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2022-12-10T13:00:00-08:00"
      }
