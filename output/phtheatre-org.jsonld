    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Clementine (& Winston)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "“Clementine (&amp; Winston)” is a play with music about a love story in tumultuous times, one that shaped history. This will be the first public reading of a new play written by Gordon Roberts and Julia Mackey, featuring Colleen Wheeler as Clementine, Gordon Roberts as Winston and Caitriona Murphy, Graham Coffeng, and Linden Banks as everyone else plus Lia Wolfe on piano.\r\n\r\n<strong>Ages: 10+</strong>\r\n\r\n<strong>A reading of a new play presented in association with the PHT Creative Hub</strong>"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2024-04-05T19:00:00-07:00"
      }
