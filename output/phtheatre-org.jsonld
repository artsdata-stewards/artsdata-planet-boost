      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Baking Time"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "It’s Baking Time! The smell of freshly baked bread drifts through the audience as master bakers Bun and Bap try to contain a sticky situation – they’ve over-yeasted a lively batch of dough and it’s GROWING. When Yeasty Beasty rises up and begins to chase newly baked baby Loafy through forests, oceans, and floury snowstorms, Bap and Bun spring to action. But what are they to do?\r\n\r\nIt’s a recipe for pure joy! Expect baking antics, lively music, and lots of opportunities for the audience to safely join in the fun.\r\n\r\n<strong>For ages 3-7 and their favourite grown-ups!</strong>\r\n\r\n<strong>Co-Production with Oily Cart Theatre and Presentation House Theatre</strong>"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2023-12-16T13:00:00-08:00"
      }
