    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Jimmy Jones and His Heavenly Truck"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "In a mythical America, Jimmy Jones reveals the stories and disappointments of his father in the middle of cornfields and legends. This follows the story of an unusual father.\r\n\r\nFeaturing masterful table-top puppetry, this Object Theatre piece was created in May 2016 by four actors during a Théâtre de la Pire Espèce collective laboratory devoted to short forms. The show has been loved and acclaimed by audiences and reviewers at several festivals in both Canada and France.\r\n\r\nThese public performances are part of the company’s two-week 2020 residency at Presentation House Theatre in which they provided workshops and mentorship for experienced local puppetry artists.\r\n\r\nFOR AGES 12+ (ADULT)\r\n\r\nProduced by Theatre de la Pire Espece\r\nPresented by Presentation House Theatre"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2023-03-18T19:30:00-07:00"
      }
