    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Jokers Canada is bringing touring headliners and Canada’s best comedians to North Vancouver on November 18th, 2023. Enjoy a night of hilarious pro stand-up comedy inside The Presentation House Theatre – tickets now on sale.\r\n\r\n<strong>Ages: 19+ (No Minors)</strong>\r\n\r\n<strong>A Jokers Canada Production</strong>"
      }
