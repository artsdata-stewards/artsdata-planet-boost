    ],
    "http://schema.org/author": [
      {
        "@id": "https://www.phtheatre.org/stec_event/stand-2025-5/#person-AraceliFerrara"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.phtheatre.org/stec_event/stand-2025-5/"
      }
    ],
    "http://schema.org/headline": [
      {
        "@language": "en",
        "@value": "STAND: The Opposite / بالعکس"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The&hellip;"
      }
    ],
    "http://schema.org/datemodified": [
