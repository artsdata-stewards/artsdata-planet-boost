  {
    "@id": "https://www.phtheatre.org/temporary/3fee68ab-7713-4d6b-ab6e-99a094342a19",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g6853880"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.phtheatre.org/stec_event/the-three-musketeers-2-2-2-2-2/"
