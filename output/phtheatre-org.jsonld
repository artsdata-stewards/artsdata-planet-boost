    "http://schema.org/headline": [
      {
        "@language": "en",
        "@value": "STAND: A Funny Thing Happened on My Way to Canada"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "A&hellip;"
      }
    ],
    "http://schema.org/datemodified": [
      {
        "@language": "en",
