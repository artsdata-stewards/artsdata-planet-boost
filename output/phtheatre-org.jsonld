  {
    "@id": "https://www.phtheatre.org/temporary/2154e28a-176c-4cfc-8529-2e8fe8fd83a4",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g4604100"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
