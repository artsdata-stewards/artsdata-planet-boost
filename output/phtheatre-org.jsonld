    ]
  },
  {
    "@id": "https://www.phtheatre.org/temporary/ffa41f03-74b0-4cf8-84ae-9e274ad0910a",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g8864880"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.phtheatre.org/stec_event/7th-annual-all-star-stand-up-comedy-night/"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.phtheatre.org/stec_event/7th-annual-all-star-stand-up-comedy-night/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "7th Annual All-Star Stand-Up Comedy Night"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<div data-smartmail=\"gmail_signature\">\r\n<div class=\"vc_row wpb_row vc_row-fluid\">\r\n<div class=\"wpb_column vc_column_container vc_col-sm-12\">\r\n<div class=\"vc_column-inner\">\r\n<div class=\"wpb_wrapper\">\r\n<div class=\"wpb_text_column wpb_content_element \">\r\n<div class=\"wpb_wrapper\">\r\n<div>PHT’s really funny fundraiser is back! We can’t wait to LOL with you at our 7th Annual All-Star Stand-Up Comedy Night!</div>\r\n<div></div>\r\n<div>Featuring the hilarious lineup of four fresh and fave comedians from hit comedy festivals including Just for Laughs, Winnipeg Comedy Festival, Yuk Yuks top comic competitions and CBC’s hit radio show The Debaters — to name a few!</div>\r\n<div></div>\r\n<div>Hosted by the the one and only <strong>John Cullen</strong>, returning to PHT with a bright new line-up of side-splitting talent including:</div>\r\n<ul>\r\n \t<li><strong>Alannah Brittany</strong></li>\r\n \t<li><strong>Malik Elassal</strong></li>\r\n \t<li><b>Damonde</b></li>\r\n</ul>\r\n<div>Ticket price includes endless laughter, delish reception and a drink of your choice for sipping. Come early to browse and bid on our many Silent Auction items.</div>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n<div class=\"vc_row wpb_row vc_row-fluid\">\r\n<div class=\"wpb_column vc_column_container vc_col-sm-12\">\r\n<div class=\"vc_column-inner\">\r\n<div class=\"wpb_wrapper\">\r\n<div class=\"wpb_text_column wpb_content_element \">\r\n<div class=\"wpb_wrapper\">\r\n<h4>A lighthearted way to have a serious impact</h4>\r\n</div>\r\n</div>\r\n<div class=\"wpb_text_column wpb_content_element \">\r\n<div class=\"wpb_wrapper\">\r\n\r\nHelping raise much needed funds for Presentation House Theatre programs — on stage and in the community. <strong><em>Thank you!</em></strong>\r\n\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n</div>"
      }
    ],
    "http://schema.org/startDate": [
      {
