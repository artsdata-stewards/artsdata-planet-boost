  },
  {
    "@id": "https://www.phtheatre.org/temporary/47bd1372-85c8-43d4-a274-6fc81d8287f8",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g2183240"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.phtheatre.org/stec_event/stand-2025-4/"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.phtheatre.org/stec_event/stand-2025-4/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "STAND: Writing the Perfect Grant"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p class=\"font_8 wixui-rich-text__text\"><span class=\"wixui-rich-text__text\">In this practical workshop, arts administrator Mary Ann Anderson (Little Dog Creative Consulting) helps demystify the language of grant guidelines, showing you what funders are asking for. She’ll point out red-flag phrases to avoid and guide you in shaping clear, targeted applications that align with funders’ priorities.</span></p>\r\n<p class=\"font_8 wixui-rich-text__text\"><span class=\"wixui-rich-text__text\">Grant Writing Success! Are you ready to level up your grant writing skills?</span></p>\r\n<p class=\"font_8 wixui-rich-text__text\"><span class=\"wixui-rich-text__text\">Writing a successful grant application can be daunting. Funding priorities can be challenging to discern, and competition for support is more intense than ever. If you're looking for guidance, this workshop offers a practical roadmap for creating strong, compelling applications, whether you're new to grant writing or a seasoned applicant. </span></p>\r\n<p class=\"font_8 wixui-rich-text__text\"><span class=\"wixui-rich-text__text\">Mary Ann Anderson will also introduce SmartGrant, her new interactive tool designed to help BC artists and arts &amp; cultural organizations find relevant funding opportunities.</span></p>"
      }
    ],
    "http://schema.org/startDate": [
