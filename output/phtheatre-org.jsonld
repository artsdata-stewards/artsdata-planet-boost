      }
    ]
  },
  {
    "@id": "https://www.phtheatre.org/temporary/16f6db14-7112-4adb-92a3-609769a4c1b0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g6134200"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.phtheatre.org/stec_event/stand-2/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "STAND: A Funny Thing Happened on My Way to Canada"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<h3>A Funny Thing Happened on My Way to Canada</h3>\r\n<strong>Saturday, Nov 4 – 7:30 PM</strong>\r\n\r\nWritten and Performed by <strong>Grace Chin</strong>\r\n\r\nSometimes, you only know who you are once you find yourself. This one time…a part Peranakan, part Malaysian Chinese “cha bor” went on an unexpected journey of self-discovery – through personal, family, and cultural stories past and present, here and there, imagined and mostly real – when her father moved the family from Malaysia to Canada.\r\n\r\nBe prepared to embark on a poignant journey of self-discovery as Grace Chin’s captivating performance explores the complexities of identity and the immigrant experience.\r\n\r\n<em><strong>A Funny Thing Happened on My Way to Canada</strong></em> has also recently been played at the rEvolver Festival 2023."
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2023-11-04T19:30:00-07:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2023-11-04T21:00:00-07:00"
      }
    ],
