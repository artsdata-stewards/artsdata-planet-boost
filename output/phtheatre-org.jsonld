    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "PHT Community Clothing Swap"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<strong>Sunday, June 22, 2025</strong>\r\n\r\n<strong>11:00 AM to 2:00 PM</strong>\r\n\r\nThis is an event that requires no registration! Entry by donation! Walk-ups are welcome.\r\n\r\nPresentation House Theatre’s Community Clothing Swap is back once again for the summer! Join us this June for a fun, sustainable way to refresh your summer style. Bring up to 15 gently used clothing items and swap them for something new-to-you. We welcome clothing for all ages, all sizes, and all genders. And we will have plus size clothing available, so don't miss out! Admission is by donation—give what feels right for you and help us keep these community events going strong. We hope to see you there!"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-06-22T11:00:00-07:00"
      }
