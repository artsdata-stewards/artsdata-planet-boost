  {
    "@id": "https://www.phtheatre.org/temporary/3360d201-e285-4cd7-8728-e0bd1f38fc7e",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g8270780"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
