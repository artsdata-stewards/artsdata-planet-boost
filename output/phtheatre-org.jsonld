    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "North Shore Zone Festival of Plays - Three Tall Women"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<b>Three Tall Women </b><i><span style=\"font-weight: 400;\">written by Edward Albee and directed by Carla Fuhre. </span></i><span style=\"font-weight: 400;\">Dealing with her husband’s illness and early death and caring for her resentful mother and alcoholic sister, we can empathize with the old woman known as “A”. However, “A” reveals her narcissism and self-pity in displays of bitterness, antisemitism, homophobia, and racism. The three women represent different stages of “A”’s life, having conversations that are at times profound and deeply shocking.</span>"
      }
    ],
