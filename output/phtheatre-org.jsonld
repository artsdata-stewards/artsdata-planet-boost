      {
        "@language": "en",
        "@value": "Stand Festival"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The 2nd annual STAND Festival is a live and online celebration by and for immigrant and refugee theatre artists. Through a series of free workshops, panel discussions and public showcase performances, STAND supports and amplifies the creations and voices of newcomers to Canada through the arts."
      }
    ],
