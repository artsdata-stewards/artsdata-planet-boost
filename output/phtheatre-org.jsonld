  {
    "@id": "https://www.phtheatre.org/temporary/138f2e0b-3120-4a28-9329-35f4ee82914f",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g7530880"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.phtheatre.org/stec_event/spring-fever-a-supergay-cabaret/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Spring Fever, A Supergay Cabaret"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "After their debut show sold out this Valentine’s Day, GOLDbard creative is back with the second Supergay Cabaret show, which promises to deliver more laughs, more boobs &amp; butts, and more wild &amp; wacky games. This highly interactive show promises to deliver another delightful evening of debauchery for everyone’s mutual (and consensual) pleasure. So put on your most fabulous ensemble (best dressed wins a prize!) and join us for sexy bedtime stories, buxom burlesque performances, and music to get you in the mood.\r\n\r\nWith performances by:\r\n\r\nMistress of Ceremonies <strong><a href=\"https://www.instagram.com/andystonewarner/\">Andy Stone Warner</a></strong>\r\n\r\nEnby burlesque performer <strong><a href=\"https://www.instagram.com/lilac.lust/\">Lilac Lust</a></strong>\r\n\r\nBurlesque babe <strong><a href=\"https://www.instagram.com/allthewaymae_burlesque/\">All the way Mae</a></strong>\r\n\r\nAnd music to get you in the mood from:\r\n\r\n<strong><a href=\"https://www.youtube.com/channel/UCvLi5Rktad-t884JL7GQ6hw\" target=\"_blank\" rel=\"noopener\">GOLDbard</a></strong>\r\n\r\n<strong><a href=\"https://open.spotify.com/artist/6HIUYanA7tvewHx1EqxgMK?si=IR87jbT2RtOW3z4BoGMWVQ\">Quayside Voices</a></strong>"
      }
    ],
