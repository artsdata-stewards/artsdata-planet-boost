    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "STAND: The body of a woman as a battlefield in the Bosnian war"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<h3><strong>The body of a woman as a battlefield in the Bosnian war</strong></h3>\r\n<strong>Friday, Nov 3 – 7:30 PM</strong>\r\n\r\nWritten by <strong>Matei</strong> <strong>Visniec</strong>, <strong>Sara</strong> <strong>Poursorkh</strong> takes the lead as the director, with assistance from <strong>Mehrad</strong> <strong>Ramezankhani</strong>, with <strong>Paris</strong> <strong>Lajevard</strong> as the stage manager.\r\n\r\nPerformances by <strong>Yassaman</strong> <strong>Hosseini</strong>, <strong>Arghavan</strong> <strong>Hatamkhan</strong>, <strong>Yeganeh</strong> <strong>Dorri</strong>, <strong>Parniyan</strong> <strong>Golkar</strong>, <strong>Faezeh</strong> <strong>Samani</strong>, <strong>Mahnaz</strong> <strong>Sheikhesmaeili</strong>, <strong>Bahar</strong> <strong>Salamatian</strong>, <strong>Negar</strong> <strong>Goli</strong>, <strong>Afsoon</strong> <strong>Gharib Mombeini</strong>, <strong>Leila Abtahi</strong>, <strong>Rana Madani</strong>, <strong>Shohre Mirzaei</strong>.\r\n\r\nMusic by <strong>Amirhossein Rashidi</strong>.\r\n\r\n<strong>Please note that this show is in Farsi with English subtitles.</strong>"
      }
    ],
