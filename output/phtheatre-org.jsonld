    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "8th Annual All-Star Stand-Up Comedy Night"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "PHT’s really funny fundraiser is back! Get ready to laugh until your sides ache and support a great cause at the same time! Join us for a night of uproarious comedy and charitable giving at our 8th Annual All-Star Stand-Up Comedy Night.\r\n\r\nYour ticket grants you access to limitless laughter, a delicious reception, and a drink of your choosing to sip and savour. Arrive early to browse and bid in our Silent Auction.\r\n\r\n<strong>Ages: 10+</strong>\r\n\r\n<strong>A Presentation House Theatre Production</strong>"
      }
    ],
