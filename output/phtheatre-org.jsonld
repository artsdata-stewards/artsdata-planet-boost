  {
    "@id": "https://www.phtheatre.org/temporary/f0cb0300-e397-405c-863a-bdcaa7905a3e",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g8247900"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.phtheatre.org/stec_event/north-shore-zone-festival-of-plays-shirley-valentine/"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.phtheatre.org/stec_event/north-shore-zone-festival-of-plays-shirley-valentine/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "North Shore Zone Festival of Plays - Shirley Valentine"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<b>Shirley Valentine </b><i><span style=\"font-weight: 400;\">written by Willy Russell and directed by Kayt Roth.  </span></i><span style=\"font-weight: 400;\">As she prepares chips and egg for dinner, ordinary middle-class English housewife Shirley ruminates on her life and tells the wall about her husband, her children, her past, and an invitation from a girlfriend to join her on holiday in Greece to search for romance and adventure.</span>"
      }
    ],
