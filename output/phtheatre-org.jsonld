      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Little Pea"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Created and directed by Agnès Limbos from Belgium, <em>Little Pea </em>(French: <em>Petit Pois</em>) is a play and an exhibition in one; this ground-breaking TYA show tells the story of a little green pea who escapes a refugee camp and crosses roads, mountains, and villages to be reunited with their peers in their vegetable garden. To make the content accessible to young children, the storyteller, a camp guard and clown, uses Object Theater to create a playful and whimsical realm in which children and adults will be immersed.\r\n\r\n<strong>For ages 3-7 and their favourite grown-ups!</strong>\r\n\r\n<strong>Co-Presented by Kleine Compagnie and Presentation House Theatre</strong>"
      }
    ],
