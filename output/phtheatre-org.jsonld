  {
    "@id": "https://www.phtheatre.org/temporary/3951d8ab-7bf7-463b-8f05-f7d05141ad82",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1273980"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.phtheatre.org/stec_event/adult-education-programs-2/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Grant Writing Workshop"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<strong>Price – $5 / $10 / $15 / $20</strong>\r\n\r\nOur Adult Education Programs are <strong>Pay-What-You-Can.</strong> We offer sliding scale options at PHT that allow you to pick the price that works for you, no questions asked!\r\n\r\n<strong>Grants made simple!</strong> This workshop covers the essentials of effective grant writing, including the dos and don’ts of project proposals, how to strengthen your narrative, and a basic overview of theatre funders in B.C. Learn to apply appropriate concepts and formats to grant letters, proposals, and sponsorships with this informative session—setting your projects up for future success!\r\n<p class=\"cvGsUA direction-ltr align-start para-style-body\"></p>"
      }
    ],
