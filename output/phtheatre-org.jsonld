  {
    "@id": "https://www.phtheatre.org/temporary/6a289f8f-7a5c-4c6e-96cd-8ceac2e0fd3c",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g2650080"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
