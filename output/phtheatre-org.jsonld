  {
    "@id": "https://www.phtheatre.org/temporary/877f3719-0192-4839-a9b1-458f54afdfcc",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1104240"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.phtheatre.org/stec_event/summer-camps/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Summer Camps"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Our <strong>Summer Camps</strong> are crafted to spark creativity, encourage imaginative play, and build a deeper connection to the world of theatre. Perfect for caregivers looking for enriching and fun programming. Our classes offer a variety of themes tailored to different age groups.\r\n\r\nWhile each individual class offers their own unique learning outcomes, all our education programming will help teach and inspire the following learning outcomes:\r\n<ul>\r\n \t<li>Respect and kindness towards others</li>\r\n \t<li>Imagination</li>\r\n \t<li>Sparking creativity</li>\r\n \t<li>Critical and reflective thinking</li>\r\n \t<li>Confidence and courage in a safe environment</li>\r\n \t<li>Teaches the value of teamwork and collaboration</li>\r\n</ul>\r\n<strong>Dates:</strong>\r\nAugust 10 – 14, 2026 (Week 1) | 9:00 AM – 3:00 PM\r\nAugust 17 – 21, 2026 (Week 2) | 9:00 AM – 3:00 PM\r\n\r\n<strong>Address:</strong>\r\nPresentation House Theatre | 333 Chesterfield Ave, North Vancouver\r\n\r\n<strong>Cost:\r\n</strong>$450 per week full price\r\n$850 if you book both weeks at once or if there is more than one child\r\n\r\n<strong>Questions? Call us at 604-990-3474 or email Emily Brown at <a role=\"link\" href=\"mailto:producer@phtheatre.org\">producer@phtheatre.org</a></strong>\r\n\r\n&nbsp;\r\n<p class=\"cvGsUA direction-ltr align-start para-style-body\"></p>"
      }
    ],
