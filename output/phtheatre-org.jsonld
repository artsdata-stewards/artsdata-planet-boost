  {
    "@id": "https://www.phtheatre.org/temporary/f3913313-41a3-4800-9763-f7decf2121e0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1948680"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
