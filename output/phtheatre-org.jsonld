  {
    "@id": "https://www.phtheatre.org/temporary/bd3a82eb-e4bc-4dc2-8aba-5caaf4ed8ebd",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1189500"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
