  {
    "@id": "https://www.phtheatre.org/temporary/4489c762-106f-4379-aeba-0c688593cecb",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g3376380"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.phtheatre.org/stec_event/pht-community-clothing-swap-3/"
