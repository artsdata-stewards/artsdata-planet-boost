  {
    "@id": "https://www.phtheatre.org/temporary/aece76a7-f4ba-46a5-a2ab-9efdbe57d017",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g2140600"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.phtheatre.org/stec_event/stand-2025-8/"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.phtheatre.org/stec_event/stand-2025-8/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "STAND: Mami"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<div id=\"comp-mcb32s645\" class=\"Z_l5lU ku3DBC zQ9jDz qvSjx3 Vq6kJx comp-mcb32s645 wixui-rich-text\" data-testid=\"richTextElement\">\r\n<p class=\"font_8 wixui-rich-text__text\"><span class=\"wixui-rich-text__text\">Inspired by Victoria Santa Cruz’s spoken word poem Me gritaron negra, Mami delves into the intergenerational curses passed between mothers and daughters. Performed primarily in English with moments in Spanish, this intimate piece blends storytelling, movement, and sound to explore lineage, healing, and the lived experience of Black identity.</span></p>\r\n<p class=\"font_8 wixui-rich-text__text\"><span class=\"wixui-rich-text__text\"><strong>Please note: </strong>This performance contains references to slavery.</span></p>\r\n\r\n</div>"
      }
    ],
