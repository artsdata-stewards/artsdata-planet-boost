    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<strong>Saturday, February 7, 2026</strong>\r\n<strong>7:00 PM</strong>\r\n\r\nCanada’s best comedians return to North Van on Saturday, February 7th.  These events always sell out—save money by purchasing online in advance. More details @jokerscanada (Instagram &amp; Facebook).\r\n\r\n<strong>Ages: 19+ (No Minors)</strong>\r\n\r\n<strong>A Jokers Canada Production</strong>"
      }
    ],
