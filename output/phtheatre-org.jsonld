  {
    "@id": "https://www.phtheatre.org/temporary/364beb43-a20c-4ffd-9d04-4ea2227d8d7b",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g2204580"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.phtheatre.org/stec_event/stand-2025-3/"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.phtheatre.org/stec_event/stand-2025-3/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "STAND: Dancing Our Identity"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p class=\"font_8 wixui-rich-text__text\"><span class=\"wixui-rich-text__text\">This session is instructed by Margaret Grenier, Executive and Artistic Director of Dancers of Damelahamid. Margaret is an acclaimed choreographer and cultural leader of Gitxsan and Cree ancestry whose work bridges ancestral Indigenous dance forms with contemporary expression.</span></p>\r\n<p class=\"font_8 wixui-rich-text__text\"><span class=\"wixui-rich-text__text\">Designed as an all-level, movement-based experience, the workshop invites participants to explore the diverse styles of Coastal Indigenous dance. Margaret will guide participants through movement techniques while sharing their cultural significance and the vital role of story and traditional knowledge in Indigenous dance.</span></p>"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-10-29T18:30:00-07:00"
