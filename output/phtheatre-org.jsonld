  },
  {
    "@id": "https://www.phtheatre.org/temporary/f655c4db-3956-4f54-b0b0-710e3cf3f8f2",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g2055340"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.phtheatre.org/stec_event/stand-2025-10/"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.phtheatre.org/stec_event/stand-2025-10/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "STAND: The Migration of Objects"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<div id=\"comp-mcb32s645\" class=\"Z_l5lU ku3DBC zQ9jDz qvSjx3 Vq6kJx comp-mcb32s645 wixui-rich-text\" data-testid=\"richTextElement\">\r\n<p class=\"font_8 wixui-rich-text__text\"><span class=\"wixui-rich-text__text\">This exhibition explores migration through the personal belongings of immigrant women. The project blends photography, interactive installation, and narrative to reflect on identity, memory, belonging, and resilience.</span></p>\r\n<p class=\"font_8 wixui-rich-text__text\"><span class=\"wixui-rich-text__text\">The Migration of Objects grew from a Frog Hollow Neighbourhood House workshop, where women in the Pathways to Leadership program shared their stories. Moved by their strength, she created a platform to honour their voices and the objects that hold their histories.</span></p>\r\n<p class=\"font_8 wixui-rich-text__text\"><span class=\"wixui-rich-text__text\">Presented in English, with select stories in their original languages, the exhibition invites reflection through visual and oral storytelling, asking: What do we carry when we leave home, and what carries us forward?</span></p>\r\n\r\n</div>"
      }
    ],
