    "http://schema.org/headline": [
      {
        "@language": "en",
        "@value": "STAND: A Dictionary of Emotions in Wartime"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "It&hellip;"
      }
    ],
    "http://schema.org/datemodified": [
      {
        "@language": "en",
        "@value": "2025-10-28T13:02:05-07:00"
      }
    ]
  },
  {
    "@id": "https://www.phtheatre.org/temporary/5aa402fc-5447-4bf7-a487-723b187797af",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1400940"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.phtheatre.org/stec_event/stand-2025-7/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "STAND: A Dictionary of Emotions in Wartime"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<div id=\"comp-mcb32s645\" class=\"Z_l5lU ku3DBC zQ9jDz qvSjx3 Vq6kJx comp-mcb32s645 wixui-rich-text\" data-testid=\"richTextElement\">\r\n<p class=\"font_8 wixui-rich-text__text\"><span class=\"wixui-rich-text__text\">It is a poignant and immersive theatrical production that explores individuals' personal and collective experiences during the early days of the Russian invasion of Ukraine. Blending documentary elements with experimental staging, the performance draws audiences into the emotional landscape of war, trauma, and displacement through deeply human stories.</span></p>\r\n<p class=\"font_8 wixui-rich-text__text\"><span class=\"wixui-rich-text__text\"><strong>Please note: </strong>This performance references war, trauma, and displacement and includes immersive elements such as loud sounds, flashing lights, and fog.</span></p>\r\n\r\n</div>"
      }
    ],
