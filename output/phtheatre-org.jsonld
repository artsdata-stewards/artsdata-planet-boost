  {
    "@id": "https://www.phtheatre.org/temporary/072c3f4f-2f2d-48d7-8ea1-c2a62b8a2ed7",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g8716100"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.phtheatre.org/stec_event/driving-me-crazy-2/"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.phtheatre.org/stec_event/driving-me-crazy-2/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Driving Me Crazy"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Inspired by stories from three generations, Driving Me Crazy follows Liz, a grandmother fighting to keep her driver’s license, her independence, and her voice in society. Liz is surrounded by her family: a son and daughter-in-law who are addicted to their cars, a granddaughter who is passionate about the environment and  fighting against oil guzzling vehicles, and a grandson on his way to learn hard lessons about drinking and driving.\r\n\r\nAnyone who has driven a car, been driven in a car, or been driven mad by their own family will laugh, cry and gasp at this show.\r\n\r\nFOR AGES TEEN TO ADULT\r\n\r\nA Serendipity Theatre Collective production\r\nPresented by Presentation House Theatre"
      }
    ],
    "http://schema.org/startDate": [
