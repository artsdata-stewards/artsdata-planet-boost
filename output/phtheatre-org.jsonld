      {
        "@id": "https://www.phtheatre.org/stec_event/stand-2025-1/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "STAND: Intro to Flamenco Guided Movement Exploration"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Are you curious about flamenco but have never danced before? This welcoming session introduces the core elements of flamenco—hand and arm movements, rhythmic clapping, simple steps, and gentle footwork—in an easy-to-follow format. No prior dance experience or special shoes are required. Participants will use their new flamenco vocabulary in a guided movement exploration, reflecting on themes of strength, loss, hope, and joy."
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
