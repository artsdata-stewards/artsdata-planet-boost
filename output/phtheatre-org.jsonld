  {
    "@id": "https://www.phtheatre.org/temporary/188017d8-dcfa-49ee-9299-8525240391ee",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1650780"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.phtheatre.org/stec_event/movie-singalong-10/"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.phtheatre.org/stec_event/movie-singalong-10/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Movie Singalong: The Sound of Music"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Climb every mountain with PHT’s Movie Singalong! Delight in <b><i>The Sound of Music</i></b> and join us for a special screening of the 1965 classic movie musical adapted from the stage version of the same name by Rodgers and Hammerstein, starring Julie Andrews and Christopher Plummer. Follow Maria as she’s sent to the house of a retired naval captain to care for his children, who have run off countless governesses. Maria teaches the children to sing, and through her, music is brought back into the hearts and home of the Von Trapp family. Sing along to popular tunes such as “Do-Re-Mi”, “My Favorite Things”, “Edelweiss”, and more!\r\n\r\nCome decked out in your finest Sound of Music-inspired ensemble for our pre-movie costume contest! Winner will receive a prize.\r\n\r\nCostumes are not mandatory, but highly encouraged! We ask that you respectfully refrain from wearing any military costumes.\r\n\r\n<b>Admission includes a complimentary small bag of popcorn.</b>\r\n<b>\r\nAges: 8+</b>"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-05-16T19:00:00-07:00"
      }
