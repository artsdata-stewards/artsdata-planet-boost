    "http://schema.org/headline": [
      {
        "@language": "en",
        "@value": "STAND: Bekhand (بخند): An evening with 50 inspiring Iranian women"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "November&hellip;"
      }
    ],
    "http://schema.org/datemodified": [
