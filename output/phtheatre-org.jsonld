  {
    "@id": "https://www.phtheatre.org/temporary/89b7eb0a-3b71-4033-810f-5735b4b7f9b1",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g4567660"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
