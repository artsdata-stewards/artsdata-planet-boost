  {
    "@id": "https://www.phtheatre.org/temporary/b9429f68-8eb1-4f32-b227-18fd425c4445",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g8524720"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
