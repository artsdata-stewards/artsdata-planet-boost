  {
    "@id": "https://www.phtheatre.org/temporary/28714022-dd7c-4666-909a-08dc157557cf",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1693260"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.phtheatre.org/stec_event/movie-singalong-7/"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.phtheatre.org/stec_event/movie-singalong-7/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Movie Singalong: Moulin Rouge!"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Fall in love with PHT’s Movie Singalong! Join us for a romantic screening of Baz Luhrmann’s 2001 jukebox musical, <b><i>Moulin Rouge!</i></b><b> </b>starring Nicole Kidman and Ewan McGregor. Set in the late 19th century Parisian underworld, a young English poet named Christian starts a passionate love affair with Satine, the star courtesan of the infamous cabaret. Sing your heart out to popular music such as “Lady Marmalade”, “El Tango de Roxanne”, “Come What May”, and more!\r\n\r\nDress to impress in your best glamorous and glittery cabaret-inspired attire for our pre-movie costume contest! Winner will receive a prize.\r\n\r\nCostumes are not mandatory, but highly encouraged!\r\n\r\n<b>Admission includes a complimentary small bag of popcorn.</b>\r\n\r\n<b>Ages: 13+</b>"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-02-21T14:00:00-08:00"
      }
