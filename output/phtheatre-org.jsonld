    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Father’s Day Comedy Classic"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<strong>Sunday, June 15, 2025</strong>\r\n<strong>7:00 PM</strong>\r\n\r\nNo more dad jokes! This year take him to pro stand-up comedy. Tickets are now on sale for Jokers Canada’s Father’s Day Comedy Classic, featuring a lineup of Canada’s funniest comedians. Save money by purchasing online in advance.\r\n\r\n<strong>Ages: 19+ (No Minors)</strong>\r\n\r\n<strong>A Jokers Canada Production</strong>"
      }
    ],
