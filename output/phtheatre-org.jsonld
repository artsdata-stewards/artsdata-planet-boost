  {
    "@id": "https://www.phtheatre.org/temporary/65fe1f07-8a54-46db-b691-e83b8d44d8db",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g5819200"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.phtheatre.org/stec_event/nszf-2024-1/"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.phtheatre.org/stec_event/nszf-2024-1/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "North Shore Zone Festival of Plays 2024: Annual General Meeting"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<div class=\"wpb_text_column wpb_content_element \">\r\n<div class=\"wpb_wrapper\">\r\n<h3><strong>Theatre BC North Shore Zone\r\nAnnual Festival of Plays\r\n</strong></h3>\r\n<h4><strong>An amazing week of comedy and drama,</strong>\r\n<strong>professionally adjudicated by Tamara McCarthy</strong></h4>\r\n</div>\r\n</div>\r\n<div class=\"wpb_text_column wpb_content_element \">\r\n<div class=\"wpb_wrapper\">\r\n\r\n<strong>May 6 – 11, 2024</strong>\r\n<h3>Schedule of Plays:</h3>\r\n<strong>Monday, May 6</strong>\r\n<strong>Annual General Meeting</strong>\r\nfollowed by\r\n<strong>Ice-Breaker Party</strong>\r\n\r\n<strong>Tuesday, May 7</strong>\r\n<em><strong>Proof</strong></em>\r\nby David Auburn\r\nWhite Rock Players’ Club\r\n\r\n<strong>Wednesday, May 8</strong>\r\n<em><strong>Blood Relations</strong></em>\r\nby Sharon Pollock\r\nNorth Vancouver Community Players\r\n\r\n<strong>Thursday, May 9</strong>\r\n<em><strong>Moonglow</strong></em>\r\nby Kim Carney\r\nPivot Theatre\r\n\r\n<strong>Friday, May 10</strong>\r\n<em><strong>Girl in the Goldfish Bowl</strong></em>\r\nby Morris Panych\r\nBetween Shifts Theatre\r\n\r\n<strong>Saturday, May 11</strong>\r\n<strong>Closing Night Entertainment</strong>\r\nfollowed by <strong>Awards Ceremony</strong>\r\nand <strong>Closing Night Party</strong>\r\n\r\n<strong>The Awards Ceremony will include the adjudicator’s choice of play\r\n</strong><strong>to represent the North Shore Zone at Theatre BC’s MAINSTAGE\r\nin Chilliwack from July 2 – 7, 2024.</strong>\r\n\r\n</div>\r\n</div>"
      }
    ],
