      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Movie Singalong: The Greatest Showman"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "PHT’s Movie Singalong is back to bring you the greatest show! Come alive and join us for a captivating screening of <b><i>The Greatest Showman</i></b>, the 2017 original movie musical inspired by the life of American showman P.T. Barnum starring Hugh Jackman, Michelle Williams, Zac Efron, and Zendaya. With show-stopping numbers such as “This Is Me”, “Rewrite the Stars”, and “The Greatest Show”, this fictionalized account celebrates larger-than-life imagination, family, and embracing who you are.\r\n\r\nArrive in your most spectacular circus-inspired attire and participate in our pre-movie costume contest! Winner will receive a prize.\r\n\r\nCostumes are not mandatory, but highly encouraged!\r\n\r\n<b>Admission includes a complimentary small bag of popcorn.</b>\r\n\r\n<b>Ages: 8+</b>"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-09-13T14:00:00-07:00"
