  {
    "@id": "https://www.phtheatre.org/temporary/57307432-2830-4aff-80df-c3229617c2c3",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1146940"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
