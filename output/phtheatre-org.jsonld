        "@id": "_:g1356360"
      }
    ],
    "http://schema.org/author": [
      {
        "@id": "https://www.phtheatre.org/stec_event/stand-2025-9/#person-AraceliFerrara"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
