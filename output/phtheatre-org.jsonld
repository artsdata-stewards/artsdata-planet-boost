  {
    "@id": "https://www.phtheatre.org/temporary/8011747e-1893-4ee5-86e2-de88a3ce443c",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g6007320"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.phtheatre.org/stec_event/stand-8/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "STAND: Strangers A LARP Experience"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<h3>Strangers\r\nA LARP Experience</h3>\r\n<strong>Saturday, Nov 11 – 1:00 PM</strong>\r\n\r\nThis LARP was originally written for Funen Art Academy by <strong>Nina Runa Essendrop</strong> and Co-Produced by Blackout Art Society and Joel Grinke Experience Design.\r\n\r\n<strong>Joel Grinke</strong>, Creative Director and Facilitator, and <strong>Christian Ching</strong>, Facilitator.\r\n\r\n​Experience <em><strong>Strangers</strong></em>, an immersive where you step into the world of refugees or their new neighbours. With no need for prior experience in performing or gaming, you’ll collaboratively shape two unique societies, each with its own customs and language. Explore the challenges and emotions that arise when tragedy forces these cultures to intersect.\r\n\r\n<em><strong>Strangers</strong></em> is an emotional exploration of the refugee experience, cultural identity, and the shared humanity that connects us all."
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2023-11-11T13:00:00-08:00"
      }
