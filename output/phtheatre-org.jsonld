      }
    ]
  },
  {
    "@id": "https://www.phtheatre.org/temporary/4f736a06-eb17-42cd-bf9b-789f9a7140d6",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g2097980"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.phtheatre.org/stec_event/stand-2025-5/"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.phtheatre.org/stec_event/stand-2025-5/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "STAND: The Opposite / بالعکس"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<div id=\"comp-mcb32s645\" class=\"Z_l5lU ku3DBC zQ9jDz qvSjx3 Vq6kJx comp-mcb32s645 wixui-rich-text\" data-testid=\"richTextElement\">\r\n<p class=\"font_8 wixui-rich-text__text\"><span class=\"wixui-rich-text__text\">The Opposite / بالعكس invites audiences to imagine a reversal of reality: what if Vancouver became a warzone, and we were forced to flee to Syria for safety?</span></p>\r\n<p class=\"font_8 wixui-rich-text__text\"><span class=\"wixui-rich-text__text\">Inspired by the resettlement of over 44,000 Syrian refugees in Canada during the Syrian Civil War, this participatory piece places audience members in the role of Canadian refugees, navigating the challenges of displacement, alienation, and resettlement. </span></p>\r\n<p class=\"font_8 wixui-rich-text__text\"><span class=\"wixui-rich-text__text\">Through role reversal and immersive experience, the work offers a powerful reflection on war, identity, and the bureaucratic hurdles refugees face in their search for safety.</span></p>\r\n<p class=\"font_8 wixui-rich-text__text\"><span class=\"wixui-rich-text__text\">The Opposite / بالعكس has been celebrated for its powerful vision. In 2023, Sleman Aldib and Rawd Almasoud were named among the Canadian Arab Institute’s Top 30 Under 30.</span></p>\r\n<p class=\"font_8 wixui-rich-text__text\"><span class=\"wixui-rich-text__text\"><strong>Please note: </strong></span><span class=\"wixui-rich-text__text\">This interactive and participatory performance addresses war, refugee struggles, feelings of isolation, and bureaucratic obstacles.</span></p>\r\n\r\n</div>\r\n<div id=\"comp-mcb32s6412\" class=\" \">\r\n<div class=\"comp-mcb32s6412\">\r\n<div data-hook=\"tpa-components-provider\">\r\n<div id=\"gallery-wrapper-comp-mcb32s6412\">\r\n<div id=\"pro-gallery-comp-mcb32s6412\" class=\"pro-gallery\">\r\n<div class=\"\" tabindex=\"-1\" data-key=\"pro-gallery-inner-container\">\r\n<div class=\"pro-gallery-parent-container gallery-columns\" role=\"region\">\r\n<div id=\"pro-gallery-container-comp-mcb32s6412\" class=\"pro-gallery inline-styles one-row hide-scrollbars slider ltr \">\r\n<div id=\"gallery-horizontal-scroll-comp-mcb32s6412\" class=\"gallery-horizontal-scroll gallery-column hide-scrollbars ltr \" data-hook=\"gallery-column\">\r\n<div class=\"gallery-horizontal-scroll-inner\">\r\n<div data-hook=\"group-view\" aria-hidden=\"false\">\r\n<div class=\"item-link-wrapper\" tabindex=\"-1\" data-id=\"96063317-f800-43c8-84ac-1ef8c8b970a1\" data-idx=\"0\" data-hook=\"item-link-wrapper\">\r\n<div id=\"pgi96063317f80043c884ac1ef8c8b970a1_0\" class=\"gallery-item-container item-container-regular has-custom-focus visible clickable\" data-hash=\"96063317-f800-43c8-84ac-1ef8c8b970a1\" data-id=\"96063317-f800-43c8-84ac-1ef8c8b970a1\" data-idx=\"0\" data-hook=\"item-container\" aria-hidden=\"true\"></div>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n</div>"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-11-05T19:30:00-08:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-11-05T20:30:00-08:00"
      }
    ],
