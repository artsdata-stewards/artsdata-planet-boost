    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<strong>Saturday, September 20, 2025</strong>\r\n<strong>7:00 PM</strong>\r\n\r\nJokers Canada is returning to the Presentation House Theatre! Catch Canada’s best comedians in North Van. These events always sell out! Save money by purchasing online in advance.\r\n\r\n<strong>Ages: 19+ (No Minors)</strong>\r\n\r\n<strong>A Jokers Canada Production</strong>"
      }
    ],
