  {
    "@id": "https://www.phtheatre.org/temporary/fb577d84-9e4d-4563-8074-5783f7a8e088",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1309820"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.phtheatre.org/stec_event/spring-break-camps/"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.phtheatre.org/stec_event/spring-break-camps/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Spring Break Camps"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Our <strong>Spring Break Camps</strong> are crafted to spark creativity, encourage imaginative play, and build a deeper connection to the world of theatre. Perfect for caregivers looking for enriching and fun programming. Our classes offer a variety of themes tailored to different age groups.\r\n\r\nWhile each individual class offers their own unique learning outcomes, all our education programming will help teach and inspire the following learning outcomes:\r\n<ul>\r\n \t<li>Respect and kindness towards others</li>\r\n \t<li>Imagination</li>\r\n \t<li>Sparking creativity</li>\r\n \t<li>Critical and reflective thinking</li>\r\n \t<li>Confidence and courage in a safe environment</li>\r\n \t<li>Teaches the value of teamwork and collaboration</li>\r\n</ul>\r\n<strong>Dates:</strong>\r\nMarch 16 – 20, 2026 (Week 1) | 9:00 AM – 3:00 PM\r\nMarch 23 – 27, 2026 (Week 2) | 9:00 AM – 3:00 PM\r\n\r\n<strong>Address:</strong>\r\nPresentation House Theatre | 333 Chesterfield Ave, North Vancouver\r\n\r\n<strong>Cost:\r\n</strong>$450 per week full price\r\n$850 if you book both weeks at once or if there is more than one child\r\n\r\n<strong>Questions? Call us at 604-990-3474 or email Emily Brown at <a role=\"link\" href=\"mailto:producer@phtheatre.org\">producer@phtheatre.org</a></strong>"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-03-16T09:00:00-07:00"
