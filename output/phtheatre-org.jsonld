  {
    "@id": "https://www.phtheatre.org/temporary/9adda313-90c7-4318-b09d-a7a963fdad3e",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g8165000"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
