  {
    "@id": "https://www.phtheatre.org/temporary/1166427f-d836-4508-8867-d70ab3ae63aa",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g8737220"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.phtheatre.org/stec_event/the-distance-from-newfoundland-to-toronto/"
