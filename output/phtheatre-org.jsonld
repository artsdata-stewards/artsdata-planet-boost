    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Improv for Non-Actors"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<strong>Price – $25 / $35 / $45</strong>\r\n\r\nOur Adult Education Programs are <strong>Pay-What-You-Can.</strong> We offer sliding scale options at PHT that allow you to pick the price that works for you, no questions asked!\r\n\r\n<strong>Unscripted fun that is beginner friendly!</strong> No stage experience? No problem! Join us for a fun, low-pressure introduction to the basics of improvisation. This workshop aims to help participants build teamwork, confidence, and adaptability while exploring their creativity through unscripted play. Perfect for anyone looking to loosen up, laugh, and discover skills that transfer from the rehearsal room to everyday life!"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-01-24T13:00:00-08:00"
      }
