  {
    "@id": "https://www.phtheatre.org/temporary/ea9dc889-dfc9-4cb7-9d58-3e1344599b0c",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g5434920"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.phtheatre.org/stec_event/elvia-talks-vision-vaginal/"
