  {
    "@id": "https://www.phtheatre.org/temporary/0aabc3e4-0a26-4dff-a3fb-c25b133f9511",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g4518820"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
