      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
  {
    "@id": "https://artspring.ca/temporary/336e92b3-0c3b-47a9-91b0-8004570f290c",
    "@type": [
