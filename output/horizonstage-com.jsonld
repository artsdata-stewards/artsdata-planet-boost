    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "MAKANA YOUTH CHOIRS: Fall Concert"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Sun Nov 23, 2:30pm | Join the members of the Makana choirs as they celebrate the winter season through song! This term’s concert is all about Winter Spice! From songs of sugar and nutmeg to some exciting music featuring latin rhythms! This concert is a sure way to get you in the mood for the [&hellip;]&lt;/p&gt;\\n"
      }
