    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;We\\'re thrilled to invite you to the Fourth Annual Goddess Fair, a joyous celebration of feminine creation! Join us for a fantastic weekend of connection, support, and empowerment. Our market features an incredible array of local talent, including artists, crafters, and healers. Enjoy live music, tea, cacao, and scrumptious treats while you explore the many [&hellip;]&lt;/p&gt;\\n"
