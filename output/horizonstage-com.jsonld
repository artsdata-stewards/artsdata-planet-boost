    ],
    "http://schema.org/url": [
      {
        "@id": "https://artspring.ca/event/salt-spring-film-festival-presents-have-you-heard-judi-singh/"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-10-29T19:30:00-07:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
