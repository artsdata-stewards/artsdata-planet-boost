    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "THE GEEZERS &#8212; EXPECT DELAYS"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Let’s face it—Salt Spring traffic isn’t the only outrageous thing on this Island. Buckle up and let The Geezers, Sid Filkow and Patrick Cassidy, take you on a comedy joyride as they navigate the potholes of Island life—and life itself. Think Monty Python colliding head-on with the Three Stooges. This show honours the comedy legacy [&hellip;]&lt;/p&gt;\\n"
      }
    ],
