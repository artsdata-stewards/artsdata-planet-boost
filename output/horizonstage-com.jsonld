    ],
    "http://schema.org/url": [
      {
        "@id": "https://artspring.ca/event/the-geezers-expect-delays/2025-10-28/"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-10-28T19:30:00-07:00"
      }
    ],
    "http://schema.org/endDate": [
