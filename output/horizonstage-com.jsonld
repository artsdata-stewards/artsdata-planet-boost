    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;In 1957, wildlife artist Robert Bateman and biologist Bristol Foster set out on a global expedition in a rugged Land Rover they named the Grizzly Torque – never imagining the extraordinary encounters that lay ahead. As their exhilarating road trip takes them to the far corners of the globe, Bateman draws &amp; paints the people [&hellip;]&lt;/p&gt;\\n"
      }
