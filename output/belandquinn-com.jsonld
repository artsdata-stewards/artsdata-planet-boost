    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Afrofest @ Bell Park - le 22 août 2025 à 18h00"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Through a fusion of Haitian rhythms and jazz, the duo’s musical universe captivates with its magnificent musical arrangements and a trilingual poetic discourse infused with sensitivity. As advocates for female artists, they are joined on stage by two talented musicians, creating an energetic and authentic atmosphere."
      }
    ],
