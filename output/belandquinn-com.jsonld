  {
    "@id": "https://belandquinn.com/event/5671367/703495780/concert-dompter-les-cendres",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Concert | Dompter les cendres @ Mount Elizabeth Theatre - le 14 mars 2025 à 19h30"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Characterizing their sound as a captivating blend of world music (Haiti), soul, jazz and funk, audiences qualify Bel and Quinn’s performances as energetic and moving. The sisters’ voices combine in perfect harmony to bring their unique music to life. Original songs such as “Hommage” and “L’île aux tambours” showcase Bel’s lyrical talents as well as Quinn’s abilities in composition, musical arrangement and electric jazz guitar. Tickets can be purchased at Bradleys Bait & Tackle or at the Door."
      }
    ],
