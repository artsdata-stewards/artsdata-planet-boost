  {
    "@id": "https://belandquinn.com/event/6258915/735769216/mundial-montreal-showcase-2025",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Mundial Montreal | Showcase 2025 @ Cabaret Lion d'Or - le 18 nov. 2025 à 20h00"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Bel and Quinn, duo féminin porté par le son distinctif de la guitare électrique de Quinn, envoûte le public avec ses harmonies captivantes. Sœurs d’origine haïtienne, elles chantent en français, en créole et en anglais, et livrent une musique vibrante mêlant rythmes haïtiens, jazz et soul. Leurs chansons abordent avec sensibilité des thèmes comme l’acceptation de soi, la santé mentale et la guérison, offrant au public une expérience musicale profondément réconfortante."
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
