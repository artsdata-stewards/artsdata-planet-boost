  {
    "@id": "https://belandquinn.com/event/6116262/729498085/bel-and-quinn-jazz-on-the-plaza",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Bel and Quinn | Jazz on the Plaza @ BPAC Plaza - le 10 août 2025 à 14h00"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Meet Bel and Quinn, two sisters of Haitian origin who are making their mark on the Canadian music scene. Characterizing their sound as a captivating blend of world music (Haiti), soul, jazz and funk, audiences qualify Bel and Quinn’s performances as energetic and moving. The sisters’ voices combine in perfect harmony to bring their unique music to life. Nicknamed the Soul Sisters, the duo sings in English, Creole and French. They have been invited to perform at several festivals including Montreal’s International Festival Nuits d’Afrique, Québec Jazz en Juin and Haiti en Folie."
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://images.zoogletools.com/s:bzglfiles/u/208175/9b74e0d4280b1997239dd3ce6243232797fc16f4/original/photo-claudine-cinq-mars-credit-camille-tellier.jpg/!!/meta%3AeyJzcmNCdWNrZXQiOiJiemdsZmlsZXMifQ%3D%3D.jpg"
