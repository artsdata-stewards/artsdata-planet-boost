  {
    "@id": "https://belandquinn.com/event/6446411/752321878/concert-dompter-les-cendres",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Concert | Dompter les cendres @ Pôle culturel de Chambly - le 11 fév. 2026 à 14h00"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Les sœurs Bel and Quinn monteront sur la scène Emma-Albani au Pôle culturel de Chambly le mercredi 11 février 2026 à 14 h. Ce concert promet de captiver le public par ses harmonies vocales envoûtantes et son mélange musical unique. Faits en bref : D'origine haïtienne, le duo fusionne habilement le jazz, la soul et les rythmes traditionnels d'Haïti, chantant en français, créole et anglais des textes explorant l'acceptation de soi et la résilience. Bel and Quinn obtiennent leurs premières nominations aux Prix JUNO ainsi qu’au gala de l’ADISQ 2024 avec leur premier album Donte sann yo dans la catégorie « Album de l'année - musiques du monde ». Le duo a également été finaliste au Gala Dynastie 2025 dans la catégorie « Artiste/groupe musique du monde de l'année ». Engagées pour la reconnaissance des artistes féminines, Bel, parolière, et Quinn, guitariste jazz accomplie et arrangeuse, s'entourent de musiciennes d'exception issues de la scène canadienne pour créer une expérience musicale aussi réconfortante que puissante."
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://images.zoogletools.com/s:bzglfiles/u/208175/b8cda5e26b32c228a4dcb6d4028c8eedf73077bb/original/cr-photo-camille-tellier.jpg/!!/meta%3AeyJzcmNCdWNrZXQiOiJiemdsZmlsZXMifQ%3D%3D.jpg"
      }
    ],
