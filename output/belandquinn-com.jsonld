  {
    "@id": "https://belandquinn.com/event/6514980/757796159/showcase-dakar-music-expo-2026",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Showcase | Dakar Music Expo 2026 @ Théâtre de Verdure - le 26 mars 2026 à 20h00"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Vivez l'effervescence du Dakar Music Expo à travers 3 jours de showcases, de concerts à l'Institut Français du Sénégal à Dakar et dans d'autres lieux. Une célébration de la diversité musicale africaine à travers des projets singuliers et originaux. Des showcases exclusifs aux grandes scènes, découvrez les talents de demain et les légendes d'aujourd'hui dans un cadre exceptionnel qui met en valeur la richesse culturelle du Sénégal et de l'Afrique."
      }
    ],
