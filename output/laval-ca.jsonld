        "@id": "_:g5507000"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.laval.ca/wp-content/uploads/2026/03/oryza-1216x516-1.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://www.laval.ca/carte-interactive/salle-de-spectacle-de-lespace-citoyen-des-confluents/"
      }
    ],
    "http://schema.org/additionalType": [
      {
