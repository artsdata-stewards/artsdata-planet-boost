    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.laval.ca/calendrier-activites/initiation-bmx-7-11-ans-sablon/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Initiation au BMX pour les 7-11 ans"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Viens découvrir le BMX, une discipline dynamique, amusante et accessible! Cette activité gratuite, offerte par le club cycliste Espoirs Laval, s’adresse aux jeunes qui ont déjà intégré le vélo dans leur quotidien, qui sont à l’aise sur 2 roues et qui souhaitent découvrir une nouvelle discipline. Le cours permet une initiation progressive au BMX sur une piste à rouleaux, une piste en boucle composée de bosses et de virages, dans un environnement sécuritaire et encadré. Encadrés par un animateur spécialisé, les participants et participantes se familiariseront à la piste à rouleaux tout en développant les habiletés de base nécessaires pour y rouler de manière sécuritaire et autonome.  Au programme : Notions de sécurité sur la piste à rouleaux Techniques de base en BMX Apprentissage du contrôle du vélo, des virages, du transfert de poids et du rythme Aucune expérience préalable en BMX n’est requise, seulement une bonne aisance à vélo et l'envie de s’amuser.  Le matériel (BMX et casque intégral) est prêté gratuitement pour la durée de l'activité.  En cas de pluie, l'activité est annulée."
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-05-03T09:00:00-04:00"
      }
    ]
  },
