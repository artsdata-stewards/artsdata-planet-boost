    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Exposition : Sportivement Laval"
      },
      {
        "@language": "en",
        "@value": "Exposition : Sportivement Laval"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Connaître les heures d'ouverture de l'exposition Cette activité a été créée dans le cadre du 60e anniversaire de Laval en 2025. La Ville de Laval lance une exposition itinérante qui célèbre la riche histoire sportive de son territoire. Depuis toujours, les Lavallois et Lavalloises pédalent, nagent, patinent, skient et pagaient aux quatre coins de l’île. Découvrez les lieux marquants, les figures inspirantes et les événements qui ont façonné le paysage sportif lavallois. Cette exposition vous invite à plonger dans un patrimoine vivant et en action, reflet de l’énergie et de la passion qui animent Laval depuis six décennies et plus encore!"
      },
      {
        "@language": "en",
        "@value": "Connaître les heures d'ouverture de l'exposition Cette activité a été créée dans le cadre du 60e anniversaire de Laval en 2025. La Ville de Laval lance une exposition itinérante qui célèbre la riche histoire sportive de son territoire. Depuis toujours, les Lavallois et Lavalloises pédalent, nagent, patinent, skient et pagaient aux quatre coins de l’île. Découvrez les lieux marquants, les figures inspirantes et les événements qui ont façonné le paysage sportif lavallois. Cette exposition vous invite à plonger dans un patrimoine vivant et en action, reflet de l’énergie et de la passion qui animent Laval depuis six décennies et plus encore!"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
