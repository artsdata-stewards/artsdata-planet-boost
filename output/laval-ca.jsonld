      {
        "@id": "https://www.laval.ca/HiddenTaxonomy#petits-bonheurs-laval"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.laval.ca/calendrier-activites/marionnettes-oryza-ecc-petits-bonheurs/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Marionnettes – Oryza (2 1/2 ans et plus)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Pour les représentations du 30 avril et du 1er mai, la priorité sera accordée aux groupes. Une nouvelle création présentée par le Théâtre des Petites Âmes, en grande première! Trois glaneuses récolteuses amassent et entassent leurs vies dans leur grenier à grain… ou est-ce plutôt une galère… ou bien encore un terrain de jeu? Jasmine, Rose et Ben vivent au rythme du riz. Celui qui chante. Celui qui danse. Ensemble, elles font et défont les saisons de ce petit grain lumineux qui nourrit tant de petits, entre rires et folies. Inspiré de la toile « Les Glaneuses » accrochée au mur chez nos parents et grands-parents, ORYZA rend hommage à ces femmes, le dos courbé au champ, qui recueillaient les derniers grains après les récoltes. Une version adaptée, La Petite Oryza, sera également présentée en tournée dans le cadre de Petits bonheurs en voyage. Cette activité fait partie de la programmation du Festival Petits bonheurs. Découvrez la programmation complète. L’équipe Idéation et création : Isabelle PayantEn collaboration avec Noémie Godin-Vigneau, Delphine Ricard et Cleo Da FonsecaInterprètes : Cleo Da Fonseca, Noémie Godin-Vigneau, Isabelle PayantScénographie, costumes et marionnettes : Isabelle PayantLumière : Nancy LonchampMusiques et chants : Noémie, Cleo et IsabelleAssistance et régie : Delphine RicardAdministration : Stéphane Guy Consultez le site Internet du Théâtre des Petites Âmes Suivez Le Théâtre des Petites Âmes sur les médias sociaux :"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-04-30T10:00:00-04:00"
      }
    ]
  },
