      {
        "@id": "https://www.laval.ca/calendrier-activites/quand-regardes-mda-danse-jeune-public/"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g3388620"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.laval.ca/wp-content/uploads/2025/04/mda-qtmr-1216x516-1.jpg"
      }
    ],
    "http://schema.org/location": [
