    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Mission immersive IACéta (pour les 10 ans et plus)"
      },
      {
        "@language": "en",
        "@value": "Mission immersive IACéta (pour les 10 ans et plus)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Toi et ton équipe devez réparer une intelligence artificielle défaillante qui tente de comprendre le langage des baleines! Pendant une heure, plonge dans l’aventure à travers 3 étapes palpitantes. Casque VR sur la tête, tablette en main et casque audio aux oreilles, forme ton équipe de 3 et change de rôle à chaque défi! Suivre les Bibliothèques de Laval sur les médias sociaux :"
      },
      {
        "@language": "en",
        "@value": "Toi et ton équipe devez réparer une intelligence artificielle défaillante qui tente de comprendre le langage des baleines! Pendant une heure, plonge dans l’aventure à travers 3 étapes palpitantes. Casque VR sur la tête, tablette en main et casque audio aux oreilles, forme ton équipe de 3 et change de rôle à chaque défi! Suivre les Bibliothèques de Laval sur les médias sociaux :"
      }
    ],
