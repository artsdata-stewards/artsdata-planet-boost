    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Ferme mobile Permaculture, Art, Communauté et Éducation (PACE)"
      },
      {
        "@language": "en",
        "@value": "Ferme mobile Permaculture, Art, Communauté et Éducation (PACE)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Chaque fin de semaine, les familles pourront observer une quinzaine d’animaux en pâturage, dont des alpagas, des moutons et des chèvres, et vivre des rencontres privilégiées en petits groupes. Ainsi, grâce à cette initiative estivale, vous rencontrerez de près des animaux de ferme dans un environnement sécuritaire et encadré. La ferme mobile PACE vous offrira un contact unique avec les animaux grâce à des visites contrôlées à l’intérieur de l’enclos, limitées à 20 personnes simultanément. À propos de la ferme mobile PACE Entreprise familiale de l’Île‑Bizard reconnue pour son approche éducative réfléchie et respectueuse des animaux. Elle offrira tous ses services en français lors des activités. Suivre PACE sur les médias sociaux :"
      },
      {
        "@language": "en",
        "@value": "Chaque fin de semaine, les familles pourront observer une quinzaine d’animaux en pâturage, dont des alpagas, des moutons et des chèvres, et vivre des rencontres privilégiées en petits groupes. Ainsi, grâce à cette initiative estivale, vous rencontrerez de près des animaux de ferme dans un environnement sécuritaire et encadré. La ferme mobile PACE vous offrira un contact unique avec les animaux grâce à des visites contrôlées à l’intérieur de l’enclos, limitées à 20 personnes simultanément. À propos de la ferme mobile PACE Entreprise familiale de l’Île‑Bizard reconnue pour son approche éducative réfléchie et respectueuse des animaux. Elle offrira tous ses services en français lors des activités. Suivre PACE sur les médias sociaux :"
      }
    ],
