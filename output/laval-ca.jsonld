    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Pâques : atelier horticole pour les 12 ans et moins"
      },
      {
        "@language": "en",
        "@value": "Pâques : atelier horticole pour les 12 ans et moins"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "On vous propose des ateliers d'initiation horticole d'une durée d'environ 20 minutes et offerts en continu. Plongez dans l’univers du jardinage en découvrant la Bellis perennis, aussi appelée la pâquerette, l’une des fleurs emblématiques de Pâques. Vous apprendrez des techniques de rempotage et mettrez les mains à la terre lors de nos ateliers pratiques. Chaque enfant repartira fièrement avec sa petite plante, prête à fleurir au jardin pour le printemps! Suivre le Centre de la nature de Laval sur les médias sociaux :"
      },
      {
        "@language": "en",
        "@value": "On vous propose des ateliers d'initiation horticole d'une durée d'environ 20 minutes et offerts en continu. Plongez dans l’univers du jardinage en découvrant la Bellis perennis, aussi appelée la pâquerette, l’une des fleurs emblématiques de Pâques. Vous apprendrez des techniques de rempotage et mettrez les mains à la terre lors de nos ateliers pratiques. Chaque enfant repartira fièrement avec sa petite plante, prête à fleurir au jardin pour le printemps! Suivre le Centre de la nature de Laval sur les médias sociaux :"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
