      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Viens plonger dans un monde magique rempli d’histoires merveilleuses : un moment doux et enchanteur où les livres prennent vie. Contes, comptines et belles aventures t’attendent pour rêver, rire et voyager avec tes personnages préférés! Suivre les Bibliothèques de Laval sur les médias sociaux :"
      },
      {
        "@language": "en",
        "@value": "Viens plonger dans un monde magique rempli d’histoires merveilleuses : un moment doux et enchanteur où les livres prennent vie. Contes, comptines et belles aventures t’attendent pour rêver, rire et voyager avec tes personnages préférés! Suivre les Bibliothèques de Laval sur les médias sociaux :"
      }
    ],
