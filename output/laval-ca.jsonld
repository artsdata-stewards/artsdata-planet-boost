    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Connaître les heures d'ouverture de la serre tropicale Viens colorier une image de Pâques. Une activité qui fera appel à ta créativité. Crayons de couleurs et feuilles pour colorier sur place. À gagner : 1 panier cadeau sucré de Jolipopcake Suivre le Centre de la nature sur les médias sociaux :"
      },
      {
        "@language": "en",
        "@value": "Connaître les heures d'ouverture de la serre tropicale Viens colorier une image de Pâques. Une activité qui fera appel à ta créativité. Crayons de couleurs et feuilles pour colorier sur place. À gagner : 1 panier cadeau sucré de Jolipopcake Suivre le Centre de la nature sur les médias sociaux :"
      }
    ],
