    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "L’empreinte Papineau : l’art de la sérigraphie"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Entrez dans l’univers coloré de la sérigraphie avec L'introvertie. À l’aide d’encres, d’écrans et de pochoirs, découvrez comment superposer formes et motifs pour créer vos propres compositions sur papier. Cet atelier vous invite à expérimenter, jouer avec les couleurs et explorer différentes textures d’impression. Vous repartirez avec vos créations, souvenirs tangibles de ce moment créatif. Suivre André-Benjamin-Papineau sur les médias sociaux :"
      }
    ],
