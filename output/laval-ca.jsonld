    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Rencontres de broderie pour les 12 ans et plus"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Un espace ouvert à toutes et tous pour créer ensemble! On y découvre différentes techniques de broderie, on apprend, on pratique et on partage nos idées. Tout le matériel est fourni, il ne vous reste plus qu’à venir profiter d’un moment créatif et collectif. Suivre les Bibliothèques de Laval sur les médias sociaux : "
      }
    ],
