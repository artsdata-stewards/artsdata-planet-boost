      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Attirée par le soccer dès l'enfance, Marinette Pichon fait ses preuves dans de nombreux clubs en France et aux États-Unis, où elle devient une star. Engagée sur le terrain comme en dehors, elle prend la parole publiquement pour l'instauration d'un véritable statut de football professionnel pour les femmes. Suivre les Bibliothèques de Laval sur les médias sociaux :"
      },
      {
        "@language": "en",
        "@value": "Attirée par le soccer dès l'enfance, Marinette Pichon fait ses preuves dans de nombreux clubs en France et aux États-Unis, où elle devient une star. Engagée sur le terrain comme en dehors, elle prend la parole publiquement pour l'instauration d'un véritable statut de football professionnel pour les femmes. Suivre les Bibliothèques de Laval sur les médias sociaux :"
      }
