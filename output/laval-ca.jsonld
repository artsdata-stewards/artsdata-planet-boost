  {
    "@id": "https://www.laval.ca/events/63761",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.laval.ca/calendrier-activites/quand-regardes-mda-danse-scolaire/"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g3800440"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.laval.ca/wp-content/uploads/2025/04/mda-qtmr-1216x516-1.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://www.laval.ca/carte-interactive/theatre-des-muses-de-la-maison-des-arts-de-laval/"
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "https://www.laval.ca/Category#spectacles"
      },
      {
        "@id": "https://www.laval.ca/Public#enfants"
      },
      {
