  {
    "@id": "https://www.laval.ca/events/108007",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.laval.ca/calendrier-activites/fete-patriotes-atelier-horticole-cdn/"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g5224640"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.laval.ca/wp-content/uploads/2026/03/patriotes-atelier-horticole-tournesol.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://www.laval.ca/carte-interactive/centre-de-la-nature/"
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "https://www.laval.ca/Category#centre-de-la-nature"
