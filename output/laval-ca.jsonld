    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Atelier | Chant et musique – Création en théâtre musical (2 à 6 ans)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Proposé par le Théâtre Omnivore Ouvrez-vous au monde du théâtre musical! Les enfants, accompagnés de leurs parents, partent à la découverte de rythmes, de mélodies et de danses. L’atelier se conclut par la création collective d’une courte chanson composée à partir des mots proposés par les enfants. Cette activité fait partie de la programmation du Festival Petits bonheurs. Découvrez la programmation complète. Visitez le site Internet du Théâtre Omnivore Suivez Théâtre Omnivore sur les médias sociaux :"
      }
    ],
