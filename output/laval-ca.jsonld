    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Les Rendez-vous créatifs – Avec xece, Khadija Baker"
      },
      {
        "@language": "en",
        "@value": "Les Rendez-vous créatifs – Avec xece, Khadija Baker"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Ces ateliers d’un jour en compagnie d’artistes de la programmation ou d’intervenants professionnels vous permettent d’expérimenter une démarche artistique en toute convivialité.   Profitez de 2 avant-midis pour venir discuter avec l’artiste xece, Khadija Baker dans l’exposition Les semences de nos lendemains présentée à la Salle Alfred-Pellan. Puis, dans une zone créative de l’exposition, participer à un atelier de broderie tout en détente.   Suivre la Maison des arts sur les médias sociaux :"
      },
      {
        "@language": "en",
        "@value": "Ces ateliers d’un jour en compagnie d’artistes de la programmation ou d’intervenants professionnels vous permettent d’expérimenter une démarche artistique en toute convivialité.   Profitez de 2 avant-midis pour venir discuter avec l’artiste xece, Khadija Baker dans l’exposition Les semences de nos lendemains présentée à la Salle Alfred-Pellan. Puis, dans une zone créative de l’exposition, participer à un atelier de broderie tout en détente.   Suivre la Maison des arts sur les médias sociaux :"
      }
    ],
