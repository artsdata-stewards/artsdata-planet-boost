    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Ciné-livre : Le plongeur"
      },
      {
        "@language": "en",
        "@value": "Ciné-livre : Le plongeur"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Participez à ce nouveau club, où la littérature s'invite au cinéma pour raconter les plus belles histoires. Chaque mois, découvrez un nouveau livre, puis voyez son adaptation prendre vie sur grand écran! Adapté du roman à succès Le plongeur de Stéphane Larue, ce film suit Stéphane, 19 ans, amateur de rock métal et étudiant qui s'engouffre dans une spirale menaçante : il est accro au jeu. Il prend un emploi de plongeur dans un restaurant pour s'en sortir. Suivre les Bibliothèques de Laval sur les médias sociaux :"
      },
      {
        "@language": "en",
        "@value": "Participez à ce nouveau club, où la littérature s'invite au cinéma pour raconter les plus belles histoires. Chaque mois, découvrez un nouveau livre, puis voyez son adaptation prendre vie sur grand écran! Adapté du roman à succès Le plongeur de Stéphane Larue, ce film suit Stéphane, 19 ans, amateur de rock métal et étudiant qui s'engouffre dans une spirale menaçante : il est accro au jeu. Il prend un emploi de plongeur dans un restaurant pour s'en sortir. Suivre les Bibliothèques de Laval sur les médias sociaux :"
      }
    ],
