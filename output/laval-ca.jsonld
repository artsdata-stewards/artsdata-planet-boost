    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Bibliovente : mégavente annuelle des bibliothèques de Laval"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Faites le plein de documents usagés à prix doux provenant de documents retirés des bibliothèques de Laval ou de dons du public. Merci d'apporter vos sacs ou boîtes pour le transport de vos achats. Les invendus seront offerts à des organismes admissibles au soutien municipal. Privilégiez la mobilité durable : transports en communs, vélo et pistes cyclables, vélopartage et trottinette électrique ou marche et réseau piétonnier. Si vous y aller en voiture, le stationnement est gratuit pour l'événement. Accès par la porte PSud située sur le boulevard de la Concorde. Voir sur le plan. Suivre les Bibliothèques de Laval sur les médias sociaux :"
      }
    ],
