    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Atelier | Silence, on jase! (pour les 12-15 ans)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Plongez dans l’univers du cinéma avec François Lalonde, cinéaste lavallois! Les personnes participantes découvriront le métier de cinéaste, expérimenteront l’écriture de scénario, échangeront autour de courts métrages réalisés par l’artiste et apprendront à lire une image pour mieux parler de cinéma. Une occasion unique d’explorer la création audiovisuelle et d’en comprendre les codes. Suivre les Bibliothèques de Laval sur les médias sociaux : "
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
