    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.laval.ca/calendrier-activites/mda-activite-familiale-atelier-alfred-khadija-baker/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Activité familiale Atelier d’Alfred – Khadija Baker "
      },
      {
        "@language": "en",
        "@value": "Activité familiale Atelier d’Alfred – Khadija Baker "
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "En famille, on visite d’abord l’exposition Les semences de nos lendemains de Khadija Baker et on y observe une grande robe de papiers, des sculptures d’argile et des histoires de jardinage. Ces objets et récits nous invitent à discuter de ce que l’on cultive, et de ce qui nous connecte. On poursuit ensuite en atelier de création afin de créer des fleurs de papier préalablement ensemencées qui pourront être offertes à un ami, ou à la terre.   Suivre la Maison des arts sur les médias sociaux :"
      },
      {
        "@language": "en",
        "@value": "En famille, on visite d’abord l’exposition Les semences de nos lendemains de Khadija Baker et on y observe une grande robe de papiers, des sculptures d’argile et des histoires de jardinage. Ces objets et récits nous invitent à discuter de ce que l’on cultive, et de ce qui nous connecte. On poursuit ensuite en atelier de création afin de créer des fleurs de papier préalablement ensemencées qui pourront être offertes à un ami, ou à la terre.   Suivre la Maison des arts sur les médias sociaux :"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
