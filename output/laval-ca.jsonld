    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Rallye de Pâques"
      },
      {
        "@language": "en",
        "@value": "Rallye de Pâques"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Connaître les heures d'ouverture du chalet-restaurant Allez récupérer votre formulaire, puis, suivez les indices dissimulés dans le parc qui vous permettront de répondre aux questions posées lors de ce rallye. Participez à votre rythme tout en profitant de la beauté naturelle du parc.  Le départ se fait au chalet-restaurant, où vous pourrez choisir la version papier du rallye ou opter pour la version numérique en scannant un code QR. À gagner : un panier cadeau thématique. Le tirage aura lieu le 7 avril parmi les personnes participantes. Suivre le Centre de la nature sur les médias sociaux :"
      },
      {
        "@language": "en",
        "@value": "Connaître les heures d'ouverture du chalet-restaurant Allez récupérer votre formulaire, puis, suivez les indices dissimulés dans le parc qui vous permettront de répondre aux questions posées lors de ce rallye. Participez à votre rythme tout en profitant de la beauté naturelle du parc.  Le départ se fait au chalet-restaurant, où vous pourrez choisir la version papier du rallye ou opter pour la version numérique en scannant un code QR. À gagner : un panier cadeau thématique. Le tirage aura lieu le 7 avril parmi les personnes participantes. Suivre le Centre de la nature sur les médias sociaux :"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
