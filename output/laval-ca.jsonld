      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.laval.ca/calendrier-activites/fete-patriotes-atelier-horticole-cdn/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Fête des Patriotes : atelier horticole"
      },
      {
        "@language": "en",
        "@value": "Fête des Patriotes : atelier horticole"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "On vous propose des ateliers d'initiation horticole d'une durée d'environ 20 minutes et offerts en continu. Célébrez le retour des beaux jours en participant à un atelier de rempotage spécialement conçu pour marquer le début de la saison du jardinage. Plongez dans l’univers du jardinage en découvrant le tournesol nain, une petite fleur éclatante qui évoque le soleil et l’arrivée du printemps. Vous apprendrez des techniques de rempotage et mettrez les mains à la terre lors de nos ateliers pratiques. Chaque personne repartira avec son jeune tournesol (1 plant par personne jusqu'à épuisement des quantités), prêt à grandir et à illuminer la maison ou le jardin! Suivre le Centre de la nature de Laval sur les médias sociaux :"
      },
      {
        "@language": "en",
        "@value": "On vous propose des ateliers d'initiation horticole d'une durée d'environ 20 minutes et offerts en continu. Célébrez le retour des beaux jours en participant à un atelier de rempotage spécialement conçu pour marquer le début de la saison du jardinage. Plongez dans l’univers du jardinage en découvrant le tournesol nain, une petite fleur éclatante qui évoque le soleil et l’arrivée du printemps. Vous apprendrez des techniques de rempotage et mettrez les mains à la terre lors de nos ateliers pratiques. Chaque personne repartira avec son jeune tournesol (1 plant par personne jusqu'à épuisement des quantités), prêt à grandir et à illuminer la maison ou le jardin! Suivre le Centre de la nature de Laval sur les médias sociaux :"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
