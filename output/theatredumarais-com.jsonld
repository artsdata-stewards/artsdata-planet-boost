    "http://schema.org/description": [
      {
        "@value": "Simon Leblanc a plus envie que jamais de sillonner le Québec en quête de paysages et de faces qui rient.&nbsp; Simon repart donc en tournée pour présenter son quatrième spectacle, Présent. Il a hâte de vous voir comme ça s&rsquo;peut pas!&nbsp; À bientôt tout le monde…&nbsp;\n"
      }
    ],
