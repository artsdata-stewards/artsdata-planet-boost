        "@value": "Les jours heureux - Théâtre du Marais"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@value": "https://theatredumarais.com/spectacle/les-jours-heureux-janvier-2024/"
      }
    ],
    "http://ogp.me/ns#site_name": [
