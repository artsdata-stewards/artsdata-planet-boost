      }
    ],
    "http://schema.org/description": [
      {
        "@value": "PIANO VOIX DIAPOS&nbsp;c’est Dumas sans guitare, accompagné d’un pianiste et de diapositives. Dans une mise en scène minimaliste, il se raconte en chansons,&nbsp;revisitant 25 ans de répertoire, avec sensibilité et toujours cette volonté d’offrir une expérience inoubliable et lumineuse au public.\n\n1$ par billet vendu sera remis à la Fondation Cowboys Fringants.\nMerci 💚\n"
      }
    ],
