    ],
    "http://ogp.me/ns#title": [
      {
        "@value": "Les Charbonniers de l'enfer - Théâtre du Marais"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@value": "https://theatredumarais.com/spectacle/les-charbonniers-de-lenfer-novembre-2025/"
      }
