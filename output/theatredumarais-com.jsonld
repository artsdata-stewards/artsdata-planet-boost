      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Après la parution de six albums solos, et six bandes sonores de films et séries télé, l’harmoniciste-chanteur Guy Bélanger offre un nouvel album et une tournée qui présente toute la magnitude de son talent. Son spectacle Voyages et autres histoires propose une balade à la croisée des nombreux chemins du blues et du folk et puise aussi dans les rythmes funk et rock. C’est accompagné de ses musiciens que Guy Bélanger vous présentera plusieurs pièces de son vaste répertoire.\n"
      }
    ],
    "http://schema.org/duration": [
      {
        "@value": "PT2H00M"
      }
