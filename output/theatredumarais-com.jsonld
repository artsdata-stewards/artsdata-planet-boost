    "http://schema.org/description": [
      {
        "@value": "Mariana Mazza revient sur scène pour tester les blagues de son 3e one-woman-show.\nOn ne pensait jamais la voir dans cet état, mais Mariana a envie d’être vulnérable et touchante… mais quand même juste assez conne, question que les gens ne soient pas trop déstabilisés.\n"
      }
    ],
