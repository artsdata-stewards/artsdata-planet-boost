    ],
    "http://schema.org/description": [
      {
        "@value": "Laurent Paquin est déjà de retour sur scène! L’un des humoristes chouchou du Québec veut explorer de nouvelles blagues pour la préparation de son 5e one-man-show. Avec 27 ans de carrière derrière la cravate, Laurent saura encore surprendre son public!\n"
      }
    ],
