    "article:publisher": [
      {
        "@value": "https://www.facebook.com/theatredumarais"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Guitar Story 2.0 est un véritable hommage aux guitaristes les plus influents des 100 dernières années. Formé de cinq musiciens/chanteurs, ce nouveau spectacle saura vous charmer, vous faire rire et vous divertir pour une soirée haute en couleurs. Une mise en scène à couper le souffle, incluant un mur LED, plus de 40 guitares et des chorégraphies mythiques (dont Johnny B. Goode de Marty McFly et Purple Rain de Prince) ajoutent au dynamisme de ce spectacle-concept qui plaira à toutes les tranches d’âge.\n"
      }
    ],
    "http://schema.org/duration": [
      {
        "@value": "PT2H00M"
      }
    ],
