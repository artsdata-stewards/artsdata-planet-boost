    "http://schema.org/description": [
      {
        "@value": "Après s&rsquo;être fait connaître par son alter ego Carole, voyez l&rsquo;humoriste Silvi Tourigny en rodage de son premier one-woman-show. Un melting pot d’observations, d’histoires personnelles et autres curiosités.\n"
      }
    ],
