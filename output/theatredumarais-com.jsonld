    "http://schema.org/description": [
      {
        "@value": "LE FAUSSAIRE :Un documentaire presque vrai sur l’art de faire du faux.&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;Participez à la création de la nouvelle pièce de théâtre documentaire de Parabole théâtre.Voyez 1 heure de la pièce puis donnez votre avis sur ce que vous avez vu. On veut vous entendre \n"
      }
