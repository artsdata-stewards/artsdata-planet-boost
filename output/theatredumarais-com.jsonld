      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Plongez au coeur du bluegrass avec The Big O String Band, une formation passionnée qui redonne vie aux classiques intemporels tout en façonnant un répertoire original riche et vibrant.\nInspirés par les racines profondes de la musique traditionnelle américaine, ces musiciens chevronnés conjuguent virtuosité, harmonies vocales envoûtantes et une énergie contagieuse qui transporte le public dans un voyage musical inoubliable.\n"
      }
    ],
    "http://schema.org/duration": [
      {
        "@value": "PT2H00M"
      }
    ],
