    "http://schema.org/description": [
      {
        "@value": "C’est reparti pour un 3ème spectacle! Mais avant de le sortir, je dois le travailler, le tester, le peaufiner, bref… le RODER ! C’est avec vous que j’ai envie de faire ça!\nBienvenue au rodage de mon 3ème spectacle.\nHâte de vous voir,\nGuillaume\n"
      }
    ],
