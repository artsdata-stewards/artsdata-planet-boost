    "http://schema.org/description": [
      {
        "@value": "Avec toute la folie qu’on lui connait, l’humoriste Patrick Groulx revient sur scène avec un 5e one-man-show en rodage. Celui qui charme le public depuis plus de 25 ans vous invite à être aux premières loges de la création de son tout nouveau spectacle. \n"
      }
