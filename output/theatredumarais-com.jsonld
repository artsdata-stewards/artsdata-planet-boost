    "http://ogp.me/ns#url": [
      {
        "@value": "https://theatredumarais.com/spectacle/la-compagnie-acting-for-climate-montreal-mars-2024/"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@value": "Théâtre du Marais"
      }
    ],
    "article:publisher": [
      {
        "@value": "https://www.facebook.com/theatredumarais"
      }
    ],
    "article:modified_time": [
      {
        "@value": "2024-03-21T18:20:45+00:00"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Après nous avoir fait vibrer avec leur spectacle Branché présenté en nature le long de la Piste Gilles-Leroux il y a 2 ans, Acting for climate vous propose venir voir une étape de travail après 3 semaines de résidence au Marais. Un échange suivra entre vous et elleux pour recevoir vos précieux commentaires et impressions.\n\nRéciproque, c’est un style de mouvement phénoménal et peu connu appelé « reciprocals ». Comme son nom l&rsquo;indique, le reciprocal est un style de mouvement réalisé entre deux personnes à répétition, chaque partenaire prenant alternativement le poids de l&rsquo;autre. Cet échange permet au couple de se déplacer comme un seul corps à travers l&rsquo;espace. Le momentum des mouvements prend alors une vie propre et crée l&rsquo;illusion de faire flotter le duo. Ces mouvements sont issus de la danse théâtre aux États-Unis et possèdent un potentiel énorme lorsqu&rsquo;ils sont combinés avec le langage acrobatique. \n\nHoraire&nbsp;:\n"
      }
    ],
    "http://schema.org/duration": [
      {
        "@value": "PT2H00M"
      }
    ],
