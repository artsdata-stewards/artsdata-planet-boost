    "article:publisher": [
      {
        "@value": "https://www.facebook.com/theatredumarais"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Mi-cuit, c’est mon spectacle… presque prêt!\nIdéal si vous avez envie de rire et si vous souhaitez secrètement qu’une trentenaire qui ne sait pas cuisiner vous donne la recette du bonheur.\nMi-cuit, c’est une liste d’ingrédients et beaucoup de bonne volonté, mais ce n&rsquo;est pas tout à fait terminé. Comme le mot « rodage » a perdu tout son sens, je vous ai préparé cet humble petit gâteau. Je vous promets une soirée qui fait autant de bien que d’éteindre la hotte du four après une longue recette!\n\n"
      }
    ],
    "http://schema.org/duration": [
      {
        "@value": "PT2H00M"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
