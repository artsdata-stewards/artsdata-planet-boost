      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Un concert de Thierry Larose en est un généreux, pluriel, galvanisant, où la seule brèche est en fait un atout: il n’y a pas de quatrième mur. Sa chanson sensible et élastique, propulsée par des élans rock vectoriels, nous porte du lacrymal à l’exaltation : de la pop pour une jeunesse qui veut vivre des émotions autant neuves que nécessaires.&nbsp;\n"
      }
    ],
    "http://schema.org/duration": [
      {
        "@value": "PT2H00M"
