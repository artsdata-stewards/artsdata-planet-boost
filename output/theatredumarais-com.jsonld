    "http://schema.org/description": [
      {
        "@value": "ON/OFF est une œuvre chorégraphique qui s’adresse aux adolescents et aux adultes. Il met en scène un quintette de danseurs en action sur un dispositif étonnant, un tapis de course. Sur cette scénographie à l’espace confiné, le mouvement est aussi contraint qu’exalté, enflammé et acrobatique.&nbsp;\n"
      }
    ],
