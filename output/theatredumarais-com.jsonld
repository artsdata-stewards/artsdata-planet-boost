    "http://ogp.me/ns#site_name": [
      {
        "@value": "Théâtre du Marais"
      }
    ],
    "article:publisher": [
      {
        "@value": "https://www.facebook.com/theatredumarais"
      }
    ],
    "article:modified_time": [
      {
        "@value": "2023-05-03T18:30:07+00:00"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Après plusieurs années passées loin des projecteurs, Philippe Brach est de retour sur scène avec Les gens qu’on aime, le spectacle accompagnant son album du même nom. Si les termes «raffinement», «recul», «brutale lucidité» et «glorieux cynisme» peuvent tous s’appliquer à sa plus récente offrande, c’est d’abord et avant tout sur la fougue et le plaisir qu’il mise pour cette nouvelle incursion sur les planches. Après avoir remporté le Félix du Spectacle de l’année — Auteur.e-compositeur.e-interprète lors du 40e Gala de l’ADISQ, Brach et ses musicien.ne.s proposent un nouveau concert énergique, sans pression et sans filtre, bref, tout ce que méritent les gens qu’on aime.&nbsp;\n"
      }
    ],
    "http://schema.org/duration": [
      {
        "@value": "PT2H00M"
      }
    ],
