    "article:publisher": [
      {
        "@value": "https://www.facebook.com/theatredumarais"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Riche d’une quinzaine de saisons professionnelles, QW4RTZ s&rsquo;élance pour son&nbsp;Dernier tour de piste. La pédale au plancher, les quatre coéquipiers à la voix bien huilée mettent toute la gomme dans un nouveau spectacle de course. Trad, pop, folk, rock, classique, tous les styles s&rsquo;injectent dans leurs quatre cylindres a cappella. Toujours guidés par leur ingénieur en chef Serge Postigo, les quatre amis d&rsquo;enfance réalisent leurs ultimes aspirations et prouvent une fois de plus que, même sans guitare, ils en ont sous le capot.\n"
      }
    ],
