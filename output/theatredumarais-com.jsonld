      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Après un premier spectacle acclamé pour l&rsquo;originalité des angles et la précision des punchs, P-O Forget vous convie maintenant au rodage d&rsquo;une œuvre encore plus éclatée, encore plus incisive et avec votre aide, encore plus hilarante. Venez découvrir ou retrouver cette star montante de l&rsquo;humour Québécois dans sa version la plus authentique.\n"
      }
    ],
