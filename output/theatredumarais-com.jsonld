    "article:publisher": [
      {
        "@value": "https://www.facebook.com/theatredumarais"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Vous les avez adorés dans Conversation avec mon pénis, ils vous ont touchés avec Fondant, les voici de retour dans Voie de contournement.\nLisa a quarante ans et veut un enfant.\nSon conjoint est infertile.\nMais pas Marc, le beau-frère.\nMarc aime bien Lisa.\nLe temps est compté…\n\nPrésenté en formule 6@8, une collation et une consommation vous seront servies à partir de 18 heures.&nbsp;\n\nLe déroulement : \n18h &#8211; Moment festif avec petite collation&nbsp;et une consommation offertes par le Marais!\n19h &#8211; Début pièce&nbsp;\n20h &#8211; Rencontres autour de la création\n20h30&nbsp;&#8211; Vous pouvez même faire autre chose de votre soirée&nbsp;\n"
      }
    ],
    "http://schema.org/duration": [
      {
        "@value": "PT2H00M"
      }
    ],
