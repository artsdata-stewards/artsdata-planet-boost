      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@value": "Théâtre du Marais"
      }
    ],
    "article:publisher": [
      {
        "@value": "https://www.facebook.com/theatredumarais"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Voici maintenant 20 ans que Christine Tassan et les Imposteures roulent leur bosse à travers le monde. Vingt ans à faire rayonner jazz manouche et chansons swing sur des scènes prestigieuses ainsi que dans des villages reculés du Labrador, de Terre-Neuve, de l’île de Vancouver ou de la France. C’est en se remémorant ce parcours incroyablement dense et riche en aventures que les musicien.nes ont eu l’idée de créer « Sur la route ». Ce spectacle captivant transporte le public au cœur de leurs tournées épiques, à travers des paysages grandioses et des anecdotes savoureuses. Vivez l’ascension de la grande muraille de Chine, une balade à vélo dans Stanley Park à Vancouver, la traversée des Rocheuses en pleine tempête de neige ou la visite de Samois-sur-Seine, village de Django Reinhardt !\n"
      }
    ],
