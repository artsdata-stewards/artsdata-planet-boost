    "http://schema.org/description": [
      {
        "@value": "Catherine Major et son complice multi-instrumentiste Maxime Audet-Halde recréent sur scène, dans l&rsquo;espace lumineux enveloppant de l’éclairagiste Stéphane Caissy, l&rsquo;intégralité de l&rsquo;album Carte mère. Un mélange de prouesses techniques et d&rsquo;émotions pures, se savourant les larmes aux yeux et avec une certaine pulsion de se fondre aux pièces qui nous soulèvent.\n"
      }
    ],
    "http://schema.org/duration": [
      {
        "@value": "PT2H00M"
      }
    ],
