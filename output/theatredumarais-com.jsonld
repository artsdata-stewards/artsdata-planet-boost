    "http://ogp.me/ns#site_name": [
      {
        "@value": "Théâtre du Marais"
      }
    ],
    "article:publisher": [
      {
        "@value": "https://www.facebook.com/theatredumarais"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Marie Denise Pelletier célèbre ses 40 ans de carrière avec un retour sur scène en solo et un nouvel album, Sous ma peau de femme. Celle qui a triomphé dans Pour une histoire d’un soir avec Joe Bocan et Marie Carmen au cours des trois dernières années mène une tournée à travers le Québec entre février et novembre 2024. Sur scène, elle est accompagnée de quatre musiciens, Benoit Sarrasin, son fidèle complice, ainsi que Marc Papillon, Carl Mayotte et Francis G. Veillette à la direction musicale.\nCe voyage au pays de Marie Denise Pelletier s’écrit avec le metteur en scène Michel Poirier. La destination ? Un lieu pour redonner au public tout l’amour et la bienveillance qu’elle en a reçus.\n"
      }
    ],
    "http://schema.org/duration": [
      {
        "@value": "PT2H00M"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
