    ],
    "http://schema.org/description": [
      {
        "@value": "Gagnant de l&rsquo;Olivier Découverte année 2023\nMatthieu Pepper recommence à écrire son premier one man show. Pas facile d’écrire une description de show quand on est en pleine création, mais Matthieu nous promet « Un heureux mélange de poésie, de hip hop, de nourriture indienne et d&rsquo;acériculture ».\n&nbsp;\nOn vous invite donc à venir voir cet auteur efficace et Stand-up hors pair à l&rsquo;œuvre en pleine création de son premier spectacle solo en carrière!\n"
      }
    ],
    "http://schema.org/duration": [
      {
        "@value": "PT2H00M"
      }
    ],
