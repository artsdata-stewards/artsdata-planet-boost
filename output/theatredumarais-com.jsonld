    "http://schema.org/description": [
      {
        "@value": "Veranda vous convie à un spectacle au cœur de leur musique bluegrass, bien ancré dans les racines du folk et du bon vieux country. À travers une performance à la fois survoltée, festive et sensible, le groupe vous accompagnera sur les routes sinueuses longeant montagnes et rivières où résonneront banjo, mandoline, violon et guitare.\n"
      }
    ],
    "http://schema.org/duration": [
      {
        "@value": "PT2H00M"
      }
