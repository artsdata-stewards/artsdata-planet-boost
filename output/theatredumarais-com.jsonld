    ],
    "http://ogp.me/ns#site_name": [
      {
        "@value": "Théâtre du Marais"
      }
    ],
    "article:publisher": [
      {
        "@value": "https://www.facebook.com/theatredumarais"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Reflets du temps constitue une mosaïque musicale couvrant plusieurs époques. Inspiré d’une démarche historiquement informée, cet assemblage revêt un caractère unique grâce à l’utilisation d’instruments, d’archets et de cordes correspondant respectivement aux usages des périodes classique, romantique et contemporaine. Chaque œuvre se trouve ainsi imprégnée d’une sonorité, d’une atmosphère, de textures et de couleurs singulières. À travers cette subtile diversité, nous proposons un voyage musical dans le temps autour de trois compositrices qui ont, chacune à leur manière, marqué leur époque : Maddalena Laura Lombardini Sirmen, Fanny Hensel Mendelssohn, Alicia Terzian et Caroline Shaw.\n\n\n"
      }
    ],
