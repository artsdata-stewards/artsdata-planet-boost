    "http://schema.org/description": [
      {
        "@value": "Le guitariste&nbsp;David Jacques&nbsp;présente le concert-expérience&nbsp;Histoires de guitares&nbsp;: une dizaine de&nbsp;guitares historiques de sa collection privée réunies sur scène, la plupart construites par les meilleurs luthiers des 400 dernières années. Chaque guitare est présentée dans un répertoire adapté au caractère de l’instrument, et chacune a une histoire unique à raconter.\n\n\n"
      }
    ],
