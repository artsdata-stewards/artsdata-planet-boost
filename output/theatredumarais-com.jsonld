    "http://schema.org/description": [
      {
        "@value": "Mara nous présente son nouveau spectacle en rodage, inspiré de son neuvième album aux sonorités americana, folk et country, teinté d’un esprit de route californienne. Porté par des guitares acoustiques et des harmonies vocales, il propose un univers intime et chaleureux, qui sera transposé sur scène avec tout le charisme qu’on connaît de l’artiste.\n"
      }
    ],
