    "http://schema.org/description": [
      {
        "@value": "Alexandre Forest entame le rodage de son premier one man show.\nC’est l&rsquo;occasion parfaite de le découvrir et de vous laisser emporter dans son univers. Grâce à un alliage subtil entre autodérision et finesse d&rsquo;esprit, l&rsquo;humoriste réussit à capturer avec brio l’essence des petites et grandes incongruences de la vie quotidienne.\n"
      }
    ],
    "http://schema.org/duration": [
