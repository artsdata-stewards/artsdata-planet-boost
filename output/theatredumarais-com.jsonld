    ],
    "http://schema.org/description": [
      {
        "@value": "Damien Robitaille vous transportera à travers son univers musical riche et varié, vous aurez la chance d&rsquo;entendre ses plus grands succès, mais surtout ses classiques de Noël. L&rsquo;auteur-compositeur-interprète vous promet une soirée magique où l&rsquo;émotion et la bonne humeur seront au rendez-vous!\n"
      }
    ],
