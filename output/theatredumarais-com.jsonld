    "article:publisher": [
      {
        "@value": "https://www.facebook.com/theatredumarais"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Pour son 3e spectacle, Michel Robichaud allie chansons, images projetées et dialogues avec Puppet Mike, son alter ego virtuel.\nIl y présente sa vision de la bébite humaine à la fois empathique, chaotique, contradictoire et drôle à souhait.\nSpécialement accompagné de 4 musiciens pour le spectacle au Marais, il propose d’entrer dans un moment de réflexions, de rires et d’échange dans lequel il est plutôt facile de passer du temps agréable, à moins d’être malcommode de métier.\n"
      }
    ],
    "http://schema.org/duration": [
      {
        "@value": "PT2H00M"
      }
    ],
