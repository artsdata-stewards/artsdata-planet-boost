    "http://schema.org/description": [
      {
        "@value": "Maintenant dans la cinquantaine, il porte un regard humoristique et caustique sur son parcours, le pouvoir des échecs professionnels et la société de performance. Avec une authenticité déroutante, il se met à nu et pause la question: après quoi on court?\n"
      }
    ],
