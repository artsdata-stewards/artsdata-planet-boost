    "article:publisher": [
      {
        "@value": "https://www.facebook.com/theatredumarais"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Étoile montante du jazz vocal et récipiendaire de deux prix Juno, Dominique Fils-Aimé est une auteure-compositrice-interprète montréalaise accordant une place fondamentale à la culture musicale afro-américaine au sein de son travail. En spectacle, elle nous invite à plonger dans les racines de son âme pour explorer le parcours unique, mais interconnecté, des êtres humains. Que ce soit au Canada (en plateau double avec Allison Russell au Koerner Hall de Toronto), en Europe (en première partie de Melody Gardot, de Diana Krall et d’Ibrahim Maalouf) ou aux États-Unis (avec des spectacles acclamés à New York et à Los Angeles), Dominique Fils-Aimé captive ses spectateurs et les emmène dans un voyage transcendant.\n"
      }
    ],
