  {
    "@id": "https://cowboyandy.com/event/6284321/738048416/kelloween-2025",
    "http://opengraphprotocol.org/schema/title": [
      {
        "@value": "Kelloween 2025 @ Kellogg, Idaho - Oct 25, 2025, 12:00PM"
      }
    ],
    "http://opengraphprotocol.org/schema/description": [
      {
        "@value": "The Silver Valley's premiere Halloween festival is back! All sorts of events for families and folks looking to get their Halloween groove on! We'll be playing (rain/snow/shine) some of our best of originals as well as a bevy of cool creepy covers! Get thee to the FEST!"
      }
    ],
