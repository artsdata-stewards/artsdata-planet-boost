  {
    "@id": "https://cowboyandy.com/event/6132317/724074634/kick-offf-summer-learning-concert",
    "http://opengraphprotocol.org/schema/title": [
      {
        "@value": "Kick-Offf Summer Learning Concert! @ Missoula Public Library - Jun 14, 2025, 12:00PM"
      }
    ],
    "http://opengraphprotocol.org/schema/description": [
      {
        "@value": "Join Cowboy Andy and The Salamanders this Saturday, June 14, from 12–1 PM at the Missoula Public Library! We'll be rockin' the parking lot with family-friendly tunes perfect for dancing, singing, and celebrating summer learning. Swing by to kick off your summer with joy, music, and community fun. Free and open to all!"
      }
    ],
