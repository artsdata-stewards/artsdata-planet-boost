  {
    "@id": "https://cowboyandy.com/event/6132324/725515286/north-valley-public-library-music-celebration",
    "http://opengraphprotocol.org/schema/title": [
      {
        "@value": "North Valley Public Library Music Celebration! @ NorthVallyy - Jun 24, 2025, 1:30PM"
      }
    ],
    "http://opengraphprotocol.org/schema/description": [
      {
        "@value": "As part of our Summer Programming, Cowboy Andy, Oscar the Amazing, and Banana Man Mattie to North Valley Public Library. We will bring big music to little people of all sizes! Our all-original rock and roll spans all genres and makes kids and families want to dance, sing, and celebrate!"
      }
    ],
