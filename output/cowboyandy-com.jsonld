  {
    "@id": "https://cowboyandy.com/event/6132312/724074629/bitterroot-public-library-summer-reading-kickoff",
    "http://opengraphprotocol.org/schema/title": [
      {
        "@value": "Bitterroot Public Library - Summer Reading Kickoff! @ Bitterroot Public Library - Jun 9, 2025, 12:00PM"
      }
    ],
    "http://opengraphprotocol.org/schema/description": [
      {
        "@value": "We’re bringing the fun to Hamilton with great rock music that's fun for kids of all ages! Join us at the Bitterroot Public Library this Monday, June 9th on the West Lawn from 12–2 PM for a toe-tapping, family-friendly performance during the library’s Summer Reading Kickoff! Enjoy live music, games, activities, and summer reading sign-ups. Bring a blanket, your dancing feet, and get ready to rock with us!"
      }
    ],
