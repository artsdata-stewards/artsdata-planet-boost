    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Tetyana Haraschuk is an original with a sense of artistry in composition as well as in drumming. The “freaky alien” textures, psychedelic vocals, ‘80s guitar, synth bass and rule-breaking grooves are what define the 25-year-old’s unique alternative jazz rock style. She crafts a wide variety of sound"
      }
