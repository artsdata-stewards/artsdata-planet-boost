    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "There is nuance in the everyday — in its layers of love, joy, and hurt. Singer-songwriter Erin Propp and jazz guitarist Larry Roy reach into the everyday and blur the edges, creating works that are at once deeply personal and achingly relatable. From charming intimate jazz club sets to moving concer"
      }
