    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The WJO is getting a little nuts this Christmas with their rendition of the Duke's classic Nutcracker Suite! If Sugar Plum Fairies and waltzing flowers weren't enough, our second act features Buddy the Elf as he journeys from the North Pole to New York City to a very swinging soundtrack! Featuring s"
      }
