    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Wanting to explore each other's musical worlds, Erin Propp and Yuri Hooker became fast friends and schemed several ways to unite their respective crafts. Yuri's cello wizardry and Erin's singular voice have blended their symphonic and jazz backgrounds to create a new concert of inspired repertoire."
      }
    ],
    "http://ogp.me/ns#image": [
