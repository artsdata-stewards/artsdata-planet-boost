    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Inspired by her African heritage, La chanson française (French ballad), and American gospel,  Kelly Bado  creates music transcending cultural barriers, bringing audiences together in joy and hope.  Doors open at 6:30.   More info &amp; tickets"
      }
    ],
    "http://ogp.me/ns#image": [
