    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "For all of you who love a great jazz singer, the Izzy Asper Jazz season closes May 4 and 5 with the powerhouse TAMMY McCANN QUARTET. Based in Chicago, McCann melds classical technique, a gospel aesthetic, and a knack for making her lyrics come to life. This is your chance to hear “a voice that soars"
      }
    ],
