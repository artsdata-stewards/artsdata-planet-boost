    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "There is nuance in the everyday; in its layers of love, joy, and hurt, and in its emotional currents ever present.  Erin Propp and Larry Roy  reach into the everyday and blur the edges, creating works that are at once deeply personal and achingly relatable. Erin and Larry’s musical abilities are too"
      }
