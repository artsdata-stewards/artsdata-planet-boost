    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Adèle M. Wilding  is an award-winning contemporary jazz vocalist whose performances and recordings showcase her creative gifts. She is active and in demand as a vocalist, composer, arranger, music educator and workshop clinician. Adèle’s rich, soul inflected vocals, original works, and interpretatio"
      }
