    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Kwassa Kwassa: Music and Dance of the Congo  The Winnipeg Jazz Orchestra with the Congolese band True Generation  Music is the cultural bloodline running through the Congo and its influence stretches across the continent and beyond. It is at once a joyous dance, radiant happiness, poetry and prayer"
      }
