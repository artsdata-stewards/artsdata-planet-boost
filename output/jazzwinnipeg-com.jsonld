    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Join the Winnipeg Jazz Orchestra on Thursday, April 18th at the West End Cultural Centre as we explore Duke Ellington's Great Paris Concert! Featuring our own amazing soloists and sprinkled with colourful stories about the maestro and his orchestra, it'll be a swinging night to remember!  The Great"
      }
    ],
