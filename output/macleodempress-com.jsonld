    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Welcome to the Empress Theatre in historic Fort Macleod, Alberta, Canada.&nbsp; Built in 1912, this facility has continuously provided a range of arts and cultural opportunities to the region for more than a hundred years.&nbsp; Opportunities for participation and inclusion, and opportunities to be entertained, enlightened and educated.&nbsp; We hope you'll join us as we lay the foundations for another hundred years.</p>"
      }
    ]
