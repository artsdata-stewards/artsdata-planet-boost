    "http://ogp.me/ns#description": [
      {
        "@language": "en-gb",
        "@value": "It’s a typical small town Friday evening in 1997 and Ashley and Monica are looking for the goods and the party. What else do you do in a small town? Spend endless hours cruising up and down main street, river parties and possibly illegal but harmless shenanigans? Maybe finally talk to your crush? Al"
      }
