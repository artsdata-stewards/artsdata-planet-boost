    "http://ogp.me/ns#description": [
      {
        "@language": "en-gb",
        "@value": "Bones of Crows is a psychological drama told through the eyes of Cree Matriarch, Aline Spears, as she survives Canada's residential school system to continue her family's generational fight in the face of systemic starvation, racism and sexual abuse. Bones of Crows unfolds over one hundred years wit"
      }
