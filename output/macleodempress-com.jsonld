    "http://ogp.me/ns#description": [
      {
        "@language": "en-gb",
        "@value": "Season Tix for all 6 shows are available now for $180 and single tickets will go on sale August 22. It’s a great mix of country and western, folk, singer-songwriter, classical, show tunes, soul, R&amp;B, blulegrass and old time string band music. It really is something for everyone.  The Wardens"
      }
