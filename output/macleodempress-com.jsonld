    "http://ogp.me/ns#description": [
      {
        "@language": "en-gb",
        "@value": "Inside of his book, adventurous Harold can make anything come to life simply by drawing it. After he grows up and draws himself off the book’s pages and into the physical world, Harold finds he has a lot to learn about real life - and that his trusty purple crayon may set off more hilarious hijinks"
      }
