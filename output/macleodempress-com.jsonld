    "http://ogp.me/ns#description": [
      {
        "@language": "en-gb",
        "@value": "Cyrano de Bergerac dazzles everyone with his ferocious wordplay and brilliant swordplay. However, he's convinced his appearance renders him unworthy of the affections of the luminous Roxanne, a devoted friend who's in love with someone else."
      }
    ],
    "http://ogp.me/ns#image": [
