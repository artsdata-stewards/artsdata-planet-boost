    "http://ogp.me/ns#description": [
      {
        "@language": "en-gb",
        "@value": "A journalist and podcaster travels from New York City to Texas to investigate the death of a woman whom he hooked up with. A crime investigation with a journalistic perspective and an Altman-esque American contemporaneity that gradually shapes as a self-discovery journey"
      }
    ],
