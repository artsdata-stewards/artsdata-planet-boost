    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-gb",
        "@value": "When Scott and Teresa learn that their son, Austin, is autistic and has brittle bone disease, they initially worry about his future. However, with Scott's growing faith and Austin's incredible spirit, they become unbreakable as they find joy, gratitude and courage in the most trying times."
      }
    ],
