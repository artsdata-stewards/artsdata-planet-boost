    "http://ogp.me/ns#description": [
      {
        "@language": "en-gb",
        "@value": "The Calgary Men's Chorus is made of 40 guys who sing everything from Michael Jackson to Mozart under the direction of Malcolm Edwards. For nearly 25 years, the CMC has provided a fun, safe space where members of Calgary’s LGBTQ community can meet new friends and learn to sing.   BUY TICKETS"
      }
    ],
