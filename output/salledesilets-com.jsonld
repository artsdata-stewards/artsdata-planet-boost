    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "No Codes est un collectif jazz instrumental basé à Montréal, mené par Benjamin Deschamps, qui repousse les frontières du genre. Leur style […]"
      },
      {
        "@language": "fr-fr",
        "@value": "No Codes est un collectif jazz instrumental basé à Montréal, mené par Benjamin Deschamps, qui repousse les frontières du genre. Leur style distinctif mêle le jazz contemporain, le punk, le groove et le bop. Le groupe, dépourvu d’instrument et de support harmonique, mise sur l’interaction, la spontanéité et l’originalité de leurs compositions."
      }
    ],
