    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "Rémi-Jean LeBlanc, basé à Montréal, est actif sur la scène musicale canadienne depuis 2005 et a collaboré avec une multitude de musiciens […]"
      },
      {
        "@language": "fr-fr",
        "@value": "Rémi-Jean LeBlanc, basé à Montréal, est actif sur la scène musicale canadienne depuis 2005 et a collaboré avec une multitude de musiciens à Montréal et au Canada, y compris Yannick Rieu, Jean-Michel Pilc, Marianne Trudel, Steve Amirault, Carol Welsman, Elizabeth Shepherd, le CNJO et l’Orchestre national de jazz de Montréal. Rémi-Jean a également tourné intensivement"
      }
    ],
