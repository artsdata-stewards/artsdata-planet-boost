      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "Steppettes & cornemuse Après 40 ans dans le métier, c’est un retour aux sources, une salle, une scène, un spot; Chantal Lamarre […]"
      },
      {
        "@language": "fr-fr",
        "@value": "Steppettes & cornemuse\n\nAprès 40 ans dans le métier, c’est un retour aux sources, une salle, une scène, un spot; Chantal Lamarre convie le public à une soirée comme dans les bons vieux cabarets d’antan où on pousse la chansonnette et on ose la steppette.\n\nObservatrice du monde, oiseau moqueur, animatrice et fille de scène"
      }
    ],
    "http://ogp.me/ns#url": [
