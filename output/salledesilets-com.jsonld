    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "Ce duo de comédiens est particulièrement connu du public grâce aux rôles qu’ils ont portés à l’écran et sur scène, mais ce […]"
      },
      {
        "@language": "fr-fr",
        "@value": "Ce duo de comédiens est particulièrement connu du public grâce aux rôles qu’ils ont portés à l’écran et sur scène, mais ce n’est pas la première fois qu’ils nous partagent leur passion pour la musique. Pierre-Luc a fait partie du groupe rock Les Batteux-Slaques et Isabelle fut la chanteuse du populaire groupe Caïman Fu.\n\nCeux qui forment un couple"
      }
    ],
