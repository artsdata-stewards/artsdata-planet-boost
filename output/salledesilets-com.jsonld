    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "Depuis plus de dix ans, Emmanuelle Boucher est une figure clé de la scène musicale québécoise. C’est en 2021 qu’elle a pleinement […]"
      },
      {
        "@language": "fr-fr",
        "@value": "Depuis plus de dix ans, Emmanuelle Boucher est une figure clé de la scène musicale québécoise. C’est en 2021 qu'elle a pleinement embrassé sa passion pour la musique country. Son premier album country a offert quatre grands singles : « CowBoy », « Classique », « Avec Toi » et « Camping Pin Vert ».\n\nTrois"
      }
    ],
