    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "Forts de plus de 20 ans d’expérience, les VooDooMonx proposent de la musique live et du divertissement à des publics du monde […]"
      },
      {
        "@language": "fr-fr",
        "@value": "Forts de plus de 20 ans d'expérience, les VooDooMonx proposent de la musique live et du divertissement à des publics du monde entier. Connus pour leurs collaborations avec des artistes talentueux, ils ont bâti un son et un style axés sur l'énergie, la connexion et la bonne humeur.\n\nLe style VooDooMonx s'inspire des influences des puissants"
      }
    ],
