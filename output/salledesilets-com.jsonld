    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "Less Toches, c’est la collision musicale de cinq personnages explosifs, un big-bang de cumbia inattendu et rafraîchissant sur l’île de Montréal. La […]"
      },
      {
        "@language": "fr-fr",
        "@value": "Less Toches, c'est la collision musicale de cinq personnages explosifs, un big-bang de cumbia inattendu et rafraîchissant sur l'île de Montréal. La magie éternelle des paysans troubadours du Sud, acquiert ici un air poétique, passionné et amusant: Less Toches emprunte son nom d’un oiseau latino-américain, et une expression colombienne voulant dire “maladroit”.\n\nLeurs origines colombiennes, mexicaines,"
      }
    ],
