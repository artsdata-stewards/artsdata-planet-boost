    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "Le fabuleux spectacle d’envergure, ONE THE ABBA MEMORIES SHOW, ne se veut non pas une caricature du légendaire groupe ABBA, mais bien […]"
      },
      {
        "@language": "fr-fr",
        "@value": "Le fabuleux spectacle d’envergure, ONE THE ABBA MEMORIES SHOW, ne se veut non pas une caricature du légendaire groupe ABBA, mais bien la reproduction vocale et musicale intégrale des fabuleuses chansons du groupe. Six artistes sur scène évoluent dans l’univers musical adapté à la fine pointe de la technologie des années 2024. Depuis 2009, quelque"
      }
    ],
