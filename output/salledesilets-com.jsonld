    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "&lt;p&gt;Fallait décrire mon show en quelques lignes pis j’ai décidé de ne pas laisser l’assistante du bureau le faire, ce qui explique &lt;/p&gt;\\n"
      }
