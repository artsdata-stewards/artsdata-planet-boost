    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "Fallait décrire mon show en quelques lignes pis j’ai décidé de ne pas laisser l’assistante du bureau le faire, ce qui explique […]"
      },
      {
        "@language": "fr-fr",
        "@value": "Fallait décrire mon show en quelques lignes pis j’ai décidé de ne pas laisser l’assistante du bureau le faire, ce qui explique pourquoi tu n'as pas encore vu les termes Star du web ou encore Vedette sur les réseaux sociaux. Ces termes-là, c’est comme le mot Flamboyant, Y’a pas un humoriste qui se décrit lui-même comme flamboyant. Ça ne veut"
      }
    ],
