    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "VMG ENTERTAINMENT PRÉSENTE: STA SERA CHI RIDE CON UCCIO Préparez-vous pour une soirée d’humour exceptionnelle ! Directement d’Italie, Uccio De Santis, la […]"
      },
      {
        "@language": "fr-fr",
        "@value": "VMG ENTERTAINMENT PRÉSENTE: STA SERA CHI RIDE CON UCCIO\n\nPréparez-vous pour une soirée d’humour exceptionnelle !\n\nDirectement d’Italie, Uccio De Santis, la star de la comédie italienne, débarque à la Salle Désilets pour un spectacle rempli de rires et d’histoires savoureuses venues tout droit d’Italie !\n\nAvec son mélange unique de stand-up, de sketchs et d’anecdotes hilarantes inspirées"
      }
    ],
