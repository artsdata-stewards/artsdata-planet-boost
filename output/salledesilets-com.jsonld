    "http://ogp.me/ns#title": [
      {
        "@language": "fr-fr",
        "@value": "CHARLES BRUNET | Salle Désilets"
      },
      {
        "@language": "fr-fr",
        "@value": "CHARLES BRUNET"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "Très très bon show J’ai 24 ans. J’suis extra vieux. Vraiment full mature pis profond. J’comprends un peu rien à la vie […]"
      },
      {
        "@language": "fr-fr",
        "@value": "Très très bon show\n\nJ’ai 24 ans. J’suis extra vieux. Vraiment full mature pis profond.\nJ’comprends un peu rien à la vie mais j’commence à comprendre mon métier.\nLe nom le dit, c’est un très très bon show.\nÇa parle d’un peu de tout. Ça parle à tout le monde. Vieux, jeune. Tiktok, Msn. Gauche, Droite. Bonjour,"
      }
    ],
