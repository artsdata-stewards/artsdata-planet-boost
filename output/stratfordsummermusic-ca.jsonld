    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Spend a perfect summer afternoon by the river with the Nathan Hiltz Trio, performing live on the iconic MusicBarge! Acclaimed guitarist Nathan Hiltz is joined by Jake Koffman (sax) and Jon Meyer (bass) for an intimate, soul-stirring set that blends classic jazz traditions with fresh, modern energy."
      }
