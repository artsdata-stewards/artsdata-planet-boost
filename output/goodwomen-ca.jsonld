    "http://schema.org/name": [
      {
        "@value": "Class with Mpoe Mogale"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;This community-centered class takes us on the journey of Jazz--from its birth by enslaved Africans in the Americas to where it finds itself today. Each session includes a warmup, across-the-floor work introducing the foundational steps of Jazz, and a combination that weaves together what we’ve explored. Rooted in ...&lt;/p&gt;\\n"
      }
    ],
