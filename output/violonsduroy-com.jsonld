    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.violonsduroy.com/fr/programmation/hors-serie/pour-la-beaute-des-quatre-saisons-2900/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Pour la Beauté des Quatre saisons"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "À l’occasion du Gala-bénéfice annuel sous la présidence d’honneur de M. Mario Girard, président-directeur général du Port de Québec, les sublimes musiciens de l’orchestre et les jeunes musiciens du programme Émergence1 combineront leur talent pour vous présenter un programme délicatement construit autour du célébrissime chef-d’œuvre Les Quatre saisons de Vivaldi accompagné d’œuvres inspirantes de Telemann, Mendelssohn et Handel. La soirée sera couronnée par des extraits du répertoire musical de la 30e tournée américaine des Violons du Roy qui prendra son envol dès le lendemain du Gala-bénéfice.\n1. La Banque royale du Canada est fière partenaire du programme Émergence des Violons du Roy via son projet Artistes émergents RBC qui contribue à épauler aujourd’hui les talents de demain et appuie des organismes qui offrent aux artistes les meilleures chances de faire avancer leur carrière.\nBillets pour le concert seulement\nBillets en formule Gala"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "fr",
        "@value": "http://schema.org/EventScheduled"
      }
    ]
