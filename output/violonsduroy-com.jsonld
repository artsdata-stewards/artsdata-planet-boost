    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Le Piano de Papou"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Faites découvrir à vos enfants le magnifique piano résidant au Diamant, le piano du compositeur Gilles Tremblay. A travers les nombreux souvenirs racontés par son petit-fils Raphaël Dubé, on y découvre l’univers artistique et créateur du compositeur. Raphaël, violoncelliste aux Violons du Roy, sera entouré de Pascale Giguère au violon et Rosemarie Duval-Laplante au piano. Musiques de Tremblay, Machaut, Monteverdi, Bach, Mozart, Debussy, Messiaen, Vivier.\n\nConseillère dramaturgique et direction de jeu : Véronika Makdissi-Warren\n\nConseillers artistiques : Jean-Sébastien Ouellette et Maurice Laforest\n\n\nNous tenons également à remercier le Conservatoire de musique de Québec pour le prêt d'un support à cloches."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "fr",
        "@value": "http://schema.org/EventScheduled"
      }
    ]
  },
