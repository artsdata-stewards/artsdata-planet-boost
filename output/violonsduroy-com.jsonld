    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Multitalented musician and conductor Matthew Hall has concocted a program highlighting the huge impact that Italian Baroque music had during the 18th century, especially in Germany, where it inspired some of the most celebrated composers of the day. A must for Baroque music fans."
      }
    ],
