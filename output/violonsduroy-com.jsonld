    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Domaine Forget"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Mathieu Lussier, chef d’orchestreAlexandre Tharaud, piano\nLa la land, La Liste de Schindler, L’Affaire Thomas Crown… le cinéma est à l’honneur dans le nouveau projet d’Alexandre Tharaud! Grand amateur de cinéma, le pianiste français a choisi le monde si évocateur des musiques de films. Il rend hommage aux grands musiciens du 7e Art qui ont accompagné sa vie : Michel Legrand, John Williams, Philippe Sarde, Georges Delerue... Toute l'émotion des plus belles musiques de films dans un concert exceptionnel qui marquera 15 ans de collaboration avec Les Violons du Roy, née au Domaine Forget à l’été ’98."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "fr",
        "@value": "http://schema.org/EventScheduled"
      }
    ]
  },
