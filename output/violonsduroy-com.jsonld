    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Classics for strings\nLes Violons du Roy present their first orchestral concert at Printemps de la musique with their 14 permanent musicians. The concert, presented without a conductor, features three works from the most famous repertoire for string orchestra."
      }
    ],
