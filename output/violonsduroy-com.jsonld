    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Cordes sensibles : Andante cantabile"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Pour clore la 10e édition de la série Apéro, cinq musiciens des Violons du Roy vous proposent une oasis de beauté autour de quelques-uns des plus beaux mouvements andante cantabile (modérément, en chantant) jamais composés avec toute la tendresse et la douceur dont sont capables les instruments à cordes.\nDurée : 1 h sans entracte"
      }
    ],
