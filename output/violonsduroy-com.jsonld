    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Vivaldi, Saison 5"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Les Violons du Roy, ainsi que les élèves de l’école secondaire Jean-de-Brébeuf, sont heureux de vous inviter au concert Vivaldi, Saison 5 présenté les 7 et 8 décembre 2023 à 19 h 30 à la salle Henri-Gagnon de l’Université Laval.\nCe spectacle multidisciplinaire, conçu avec les élèves de l’école secondaire Jean-de-Brébeuf, prend racine dans l’œuvre phénoménale du compositeur vénitien. Les adolescents, entourés des musiciens des Violons du Roy et guidés par des artistes reconnus de différentes disciplines, partageront avec le public le fruit de leurs réflexions, de leurs recherches et de leurs échanges.\nCe projet est réalisé grâce au soutien financier du gouvernement du Québec, de la Caisse d’économie solidaire Desjardins, de la Fondation Jeunes en Tête et de Telus."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "fr",
        "@value": "http://schema.org/EventScheduled"
      }
    ]
  },
