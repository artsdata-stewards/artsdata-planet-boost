    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Les Variations Goldberg"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Les musiciens des Violons du Roy replongent avec bonheur dans l’arrangement pour cordes « brillantissime de finesse » (Répertoire des disques compacts) des Variations Goldberg par Bernard Labadie dont l’enregistrement paru il y a plus de 20 ans, et récemment réédité, compte parmi les joyaux de la discographie de l’orchestre."
      }
    ],
