    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "¡Tango!"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Un choix musical varié et original, des échanges et un climat de convivialité avec les musiciens, les Apéros proposent des rencontres uniques et privilégiées.\nUne formule 5 à 7 animée par les artistes incluant une consommation.\nAdmission générale et service de bar à compter de 17 h."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "fr",
