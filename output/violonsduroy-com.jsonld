  {
    "@id": "https://www.violonsduroy.com/fr/programmation/hors-serie/2022-11-13-13h-proust-retrouve-2631/2631",
    "@type": [
      "http://schema.org/MusicEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2022-11-13T13:00:00-05:00"
      }
    ],
