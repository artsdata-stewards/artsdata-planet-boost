    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Leçons de Bach"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Far from having fully explored its vast riches or uncovered all its secrets, Les Violons du Roy have devoted themselves to the music of the great Johann Sebastian Bach for over 40 years. Hailed by the New York Times as \"one of the most admired pianists of his generation,\" Inon Barnatan is internationally recognized for his exceptional sensitivity, impeccable musicality, and collaborations with the world's foremost orchestras.\nDuration: 1 hour and 40 minutes, including a 20-minute intermission"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "en",
        "@value": "http://schema.org/EventScheduled"
      }
    ]
  },
