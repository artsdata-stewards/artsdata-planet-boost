    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Domaine Forget - Le Voyageur : hommage à Gilles Vigneault"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Les Violons du Roy s’ouvrent au vaste monde de la poésie et de la musique de Gilles Vigneault. Tout au long du spectacle Le Voyageur, Les Violons du Roy rendent hommage à Gilles Vigneault, tout autant musicien-poète que poète-musicien. On pourra entendre quelques-unes des plus belles musiques du «plus grand barde de la langue française depuis Ronsard» (Jean Royer) en alternance avec un florilège de ses plus beaux poèmes."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "fr",
        "@value": "http://schema.org/EventScheduled"
      }
    ]
  },
