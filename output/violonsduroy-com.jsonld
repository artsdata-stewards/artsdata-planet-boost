    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Le piano de Papou"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Cet atelier-concert invite les enfants à entrer dans l’univers artistique et créatif du compositeur Gilles Tremblay grâce aux souvenirs qui seront racontés par son petit-fils Raphaël Dubé.\nRaphaël Dubé, violoncelliste aux Violons du Roy, sera entouré de Pascale Giguère, violon-solo de l'orchestre, et de la pianiste Rosemarie Duval-Laplante.\nDes extraits d'œuvres de Tremblay, Machaut, Monteverdi, Bach et bien plus encore seront interprétés.\nDurée : 45 minPublic : Pour enfants de 5 à 12 ans"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "fr",
        "@value": "http://schema.org/EventScheduled"
