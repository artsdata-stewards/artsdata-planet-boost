    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Virtuoso guitarist Miloš has already captured the concert stages of Europe and Asia. He presents an all-baroque program for his first collaboration with Les Violons du Roy and Jonathan Cohen. Miloš will delight us with some of the gems of the baroque repertoire."
      }
    ],
