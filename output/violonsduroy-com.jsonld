    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Les muses de Mozart"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Mozart nous a légué tant de sublimes pages pour la voix humaine dont certaines des plus belles ont été créées par les soeurs Aloysia, Josepha et Constance Weber, l’épouse du compositeur. Ces trois muses seront incarnées ici par la soprano Sarah Dufresne qui fera ses débuts avec Les Violons du Roy auxquels se joindront, en grande première, des musiciens de l’Orchestre de l’Agora.\nEn collaboration avec l'Orchestre de l'Agora\nDurée : 1h06 minutes (concert sans pause)"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "fr",
        "@value": "http://schema.org/EventScheduled"
      }
    ]
