    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Ombre et lumière, du cinéma à écouter"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "De nombreux chefs-d'œuvre musicaux ont été utilisés au cinéma pour leur puissante force d’évocation, tel le célèbre Adagio de Barber, entendu dans plus d’une vingtaine de films. Un autre compositeur américain, Bernard Herrmann, a souvent été associé au grand réalisateur Alfred Hitchcock, pour lequel il a composé de nombreuses partitions originales dont celle du film Psycho qui a marqué l’imaginaire par son utilisation inoubliable des instruments à cordes.\nDurée : 1h55 incluant la pause de 20 minutes"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "fr",
        "@value": "http://schema.org/EventScheduled"
      }
    ]
  },
