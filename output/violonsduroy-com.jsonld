    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Leçons de Bach"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Loin d’en avoir épuisé toute la richesse et percé tous les secrets, Les Violons du Roy fréquentent assidument la musique du grand Jean-Sébastien Bach depuis maintenant plus de 40 ans. Salué par le New York Times comme « l'un des pianistes les plus admirés de sa génération », Inon Barnatan est reconnu internationalement pour sa sensibilité exceptionnelle, son impeccable musicalité et ses collaborations avec les plus grands orchestres du monde.\nDurée : 1h40 incluant la pause de 20 minutes"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "fr",
        "@value": "http://schema.org/EventScheduled"
      }
    ]
  },
