    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "\"Série Apéro - musique en convivialité - Les Goûts réunis\""
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Découvrez la série Apéro : des rencontres musicales uniques dans un climat convivial. Au programme : musique baroque française et italienne avec des œuvres de Jacquet de la Guerre, Couperin, Clérambault, Corelli et Vitali. Formule 5 à 7 avec consommation incluse. Admission générale, service de bar dès 17h."
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://www.violonsduroy.com/media/2skhnqnd/les-gou-ts-re-unis-1800x1800.png?width=1200&height=1200&mode=max"
      }
    ]
  },
