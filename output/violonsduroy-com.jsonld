    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Les Variations Goldberg"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The musicians of Les Violons du Roy happily revisit Bernard Labadie’s “brilliantly conceived” (Répertoire des disques compacts) arrangement for strings for the Goldberg Variations, whose recording, released over 20 years ago and recently rereleased, is one of the orchestra’s crowning achievements."
      }
    ],
