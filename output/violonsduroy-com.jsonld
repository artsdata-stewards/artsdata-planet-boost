    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le guitariste virtuose Miloš a déjà conquis les scènes d’Europe et d’Asie. Il présente un programme entièrement baroque pour sa première collaboration avec Les Violons du Roy et Jonathan Cohen. Miloš nous invite à l’émerveillement avec quelques perles du répertoire baroque."
      }
    ],
