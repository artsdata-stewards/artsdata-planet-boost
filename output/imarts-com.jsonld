    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Join us on August 10th at the Sunset Theatre for a live performance of “Trees.Listen” with Sharlene Wallace!  Trees.Listen is an immersive sonic journey co-composed by Frank Horvat and Sharlene Wallace and inspired by the profound knowledge of acclaimed botanist and climate change visionary Dr. Dian"
      }
    ],
