    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Family Concert: Lift Every Voice: A Concert for Freedom"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Master storyteller Lana Talbot and the combined choruses of Windsor\\'s historic Black churches share music\\'s role in the journey to freedom for 19th century Essex County Black residents. Highlights include Wade in the Water, Amazing Grace, and Lift Every Voice. Geoffrey Larson, conductor Jan Radford, co-host Lana Talbot, guest reader Flo Ndimubandi, solo voice Combined Gospel...&lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": "Organization"
      }
    ],
