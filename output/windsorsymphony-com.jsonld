    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Family Concert: Broadway for Kids – 11:30am"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Singing hits from Frozen, The Lion King, The Little Mermaid, and more, the University Singers from the University of Windsor join the WSO to bring Broadway to the Capitol Theatre stage. Geoffrey Larson, conductor Jan Radford, co-host University Singers from the University of Windsor 10:00am & 11:30am. This concert is 45 minutes. General admission. Adults..."
      }
