    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Great Lakes Chamber Music Festival 2026 Rhythms of Place: Classical Form Meets Folk Rhythm An elegant and uplifting program pairing classical poise with folk-inspired melodies that evoke cultural exchange and shared heritage. FEATURING ZaRiah, Shouse Institute Ensemble, Sphinx Ensemble Milena Pajaro-van de Stadt, viola Trio Eris, Shouse Institute Ensemble Doors open at 6:00pm. PROGRAM Mozart:...&lt;/p&gt;\\n"
      }
