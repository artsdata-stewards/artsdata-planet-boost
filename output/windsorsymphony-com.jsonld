      {
        "@language": "en-us",
        "@value": "Lee Siegel Sings Broadway"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Lee Siegel brings a dynamic and captivating energy to Broadway tunes from musicals like Jesus Christ Superstar, Les Misérables, Miss Saigon and more. Maestro Franz discovered Siegel at the Stratford Festival two summers ago, in a performance of Rent. This concert features students from the St. Clair College Music Theatre program. Martin MacDonald, guest conductor..."
      }
