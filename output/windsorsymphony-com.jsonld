    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Family Concert: Robert Munsch: Thomas&#8217; Snowsuit and The Paper Bag Princess"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Heartwarming and hilarious, two of Canadian author Robert Munsch\\'s favourite children\\'s books take center stage: Thomas\\' Snowsuit and The Paper Bag Princess, accompanied by the musicians of the WSO. Geoffrey Larson, conductor Jan Radford, co-host 10:00am &amp; 11:30am. This concert is 45 minutes. General admission. Adults $10  /  Children $5 Guarantee a seat by purchasing a Family Concert Package...&lt;/p&gt;\\n"
      }
