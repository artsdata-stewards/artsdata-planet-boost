    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;This performance is based on stories from Rudyard Kipling’s Jungle Book. A new ballet follows the story of Mowgli, a young boy who is raised by wolves in a jungle. This kid-friendly ballet was created especially for families. Featuring Dance Barre Windsor. Geoffrey Larson, conductor Jan Radford, co-host Dance Barre Windsor 10:00am &amp; 11:30am. This...&lt;/p&gt;\\n"
      }
