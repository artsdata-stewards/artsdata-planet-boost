  {
    "@id": "https://themcdades.com/event/5787179/698279146/the-mcdades-at-saturday-night-special",
    "http://ogp.me/ns#title": [
      {
        "@value": "The McDades at Saturday Night Special @ Braeside Community Association - Nov 23, 2024, 7:30PM"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@value": "Chinook Musical Society presents a series of high-quality musical acts every year under the name \"Saturday Night Special\". We host performers from folk and country, to blues, Celtic and folk rock. While we do bring in acts from all over North America, and some international, we are especially proud to showcase Canadian and Alberta talent. The evening opens with our house band and two sets from our headliner."
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@value": "https://images.zoogletools.com/s:bzglfiles/u/605471/ad989455c35e10b60a33a35e983e8b7fa6c47f77/original/the-mcdades-2021.jpg/!!/meta%3AeyJzcmNCdWNrZXQiOiJiemdsZmlsZXMifQ%3D%3D.jpg"
