  {
    "@id": "https://themcdades.com/event/6093885/721083531/almonte-celtfest",
    "http://ogp.me/ns#title": [
      {
        "@value": "Almonte Celtfest @ Gemmill Park - Jul 6, 2025"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@value": "Celtfest is an almost entirely free weekend of Ottawa Valley and Celtic entertainment, performed in the natural amphitheatre of Gemmill Park in the heart of Almonte. It is a time to share the historical Celtic traditions with today’s local performers. Celtfest also presents a select group of unique artisans and vendors of specialty goods with a Celtic flair."
      }
    ],
