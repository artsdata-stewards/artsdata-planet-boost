  {
    "@id": "https://themcdades.com/event/6288282/738279057/the-mcdades-celtic-christmas",
    "http://ogp.me/ns#title": [
      {
        "@value": "The McDades Celtic Christmas @ The Empress Theatre - Dec 2, 2025, 7:30PM"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@value": "The long running and celebrated McDade Family Christmas show is finally coming to the Empress Theatre. Alberta’s first family of Celtic music invite you to join them in celebration. Bringing you a Celtic Christmas, The McDades offer you and yours their heartfelt comfort and joy of the season. The McDade Family’s rich blend of soaring vocal harmonies, acoustic instrumentation and energetic fiddle tunes will leave you with the feeling that Christmas is here. Spend an evening enjoying a holiday tradition while listening to seasonal classics as well as some rare gems. Join us for great music and good cheer!"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@value": "https://images.zoogletools.com/s:bzglfiles/u/605471/ae8a6b5117803a5928b1ead4685cbd2a35ddb8ab/original/mcdades-celtic-xmas-image.jpg/!!/meta%3AeyJzcmNCdWNrZXQiOiJiemdsZmlsZXMifQ%3D%3D.jpg"
      }
    ],
    "http://ogp.me/ns#image:width": [
      {
        "@value": "1800"
      }
    ],
    "http://ogp.me/ns#image:height": [
      {
        "@value": "2689"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@value": "https://themcdades.com/event/6288282/738279057"
      }
    ]
  },
