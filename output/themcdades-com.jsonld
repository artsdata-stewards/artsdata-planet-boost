  {
    "@id": "https://themcdades.com/event/4784678/610477493/the-mcdades-with-the-edmonton-symphony-orchestra",
    "http://ogp.me/ns#title": [
      {
        "@value": "The McDades with The Edmonton Symphony Orchestra @ Winspear Centre - Nov 25, 2022, 7:30PM"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@value": "Celtic Adventures with The McDades Conducted by Allan Gilliland Edmonton’s own JUNO award-winning folk band joins the orchestra for a long-awaited reunion. Punching through the traditional boundaries, The McDades’ Celtic-rooted music is an infectious fusion of global rhythms and improvisation, featuring energetic instrumentals and moving vocals. The concert will include original tunes and unique interpretations of folk songs with sparkling new orchestrations, including The Rocky Road to Dublin, Pull the Anchor, McKinley Morganfield's, The Whistleblower, Le Vert Laurier, and Plain Gold Ring."
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@value": "https://images.zoogletools.com/s:bzglfiles/u/605471/16c7f3b04af772ca7e48296f15d72d8178f4f4c3/original/the-mcdades-2022.jpg/!!/meta%3AeyJzcmNCdWNrZXQiOiJiemdsZmlsZXMifQ%3D%3D.jpg"
      }
    ],
