  {
    "@id": "https://www.paquetteproductions.com/event-details/loveu2-saint-john-nb",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "LOVEU2 | SAINT JOHN, NB | paquetteproductions"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Unleashing the Magic of U2 Live! Immerse yourself in a mind-blowing experience as we bring the extraordinary legacy of U2 to life. From their early days to present with fan fave hits like, Sunday Bloody Sunday, Pride (in the name of love), Beautiful Day, Vertigo, and many more!"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://static.wixstatic.com/media/8235ae_f44ba92912e54aabaafbd1951021a563~mv2.jpg/v1/fill/w_600,h_600,al_c,q_80/8235ae_f44ba92912e54aabaafbd1951021a563~mv2.jpg"
