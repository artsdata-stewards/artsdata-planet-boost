  {
    "@id": "https://www.paquetteproductions.com/event-details/spice-girls-show-victoria-bc",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Spice Girls Show | VICTORIA, BC | paquetteproductions"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "“Spice Wannabe” is the USA’s Premiere Spice Girls Tribute show, live from the entertainment capital of the world, Las Vegas! After performing to a SOLD OUT crowd for their very ﬁrst show in Las Vegas, the cast is taking the production on the road to wow audiences across the States and Worldwide."
      }
    ],
    "http://ogp.me/ns#image": [
