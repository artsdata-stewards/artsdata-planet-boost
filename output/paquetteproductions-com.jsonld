    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "It's My Party! | KINGSTON, ON | paquetteproductions"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Step back in time with It’s My Party!, a dazzling, high-energy tribute to the trailblazing women who deﬁned the sound of a generation. Starring The Lovettes, a powerhouse vocal trio from Chicago, this show is a harmony-soaked love letter to the female icons and girl groups of the 1950s and ’60s."
      }
