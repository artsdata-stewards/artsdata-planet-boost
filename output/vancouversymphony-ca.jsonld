  {
    "@id": "https://www.vancouversymphony.ca/event/rachmaninoffs-third-piano-concerto",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Rachmaninoff’s Third Piano Concerto - Vancouver Symphony Orchestra"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Just in time for Valentine’s weekend, an evening of romantic intensity awaits you: Rachmaninoff’s exceedingly passionate Third Piano Concerto."
      }
    ],
