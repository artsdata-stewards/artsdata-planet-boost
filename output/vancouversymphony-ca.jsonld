  {
    "@id": "https://www.vancouversymphony.ca/event/ca-ravels-bolero/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Ravel’s Boléro - Vancouver Symphony Orchestra"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Feel the beat with an evening of pulsing music led by Conductor Naomi Woo. Haydn’s “Drumroll” Symphony kicks things off on a thrilling note."
      }
    ],
    "http://ogp.me/ns#url": [
