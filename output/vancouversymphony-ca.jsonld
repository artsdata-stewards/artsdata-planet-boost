    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Sal Ferreras and his Latin Jazz Sextet pair up with the exuberant VSO in an irresistible evening of joy, rhythm and the eclectic musical styles, traditions and dances of South America and the Caribbean."
      }
    ],
