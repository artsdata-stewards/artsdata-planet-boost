  {
    "@id": "https://www.vancouversymphony.ca/event/mozart-brahms-strauss",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Mozart, Brahms & Strauss - Vancouver Symphony Orchestra"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Led by Maestro Tausk, Richard Strauss’s Till Eulenspiegel opens the concert with swagger, mischief, and a wink, a musical prank dressed in epic orchestral clothing."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://www.vancouversymphony.ca/event/mozart-brahms-strauss/"
      }
    ],
