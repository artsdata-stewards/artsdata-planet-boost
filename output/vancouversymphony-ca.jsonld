    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "CANCELLED: Music of Phil Collins & Genesis - Vancouver Symphony Orchestra"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Phil Collins’ one-of-a-kind drum work and songwriting have left an enduring mark on music. With the megaband Genesis and his numerous solo hits, Phil Collins and bandmates (Tony Banks and Mike Rutherford) penned unforgettable favourites featured in Stuart Chafetz’s symphonic tribute."
      }
    ],
