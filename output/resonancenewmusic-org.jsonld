  {
    "@id": "http://resonancenewmusic.org/events/2019/3/30/modern-songs-fredericton",
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en-us",
        "@value": "RESONANCE New Music"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Flights of Fancy - Fredericton — RESONANCE New Music"
      }
    ],
    "http://ogp.me/ns#latitude": [
      {
        "@language": "en-us",
        "@value": "45.9558998"
      }
    ],
    "http://ogp.me/ns#longitude": [
      {
        "@language": "en-us",
        "@value": "-66.63919099999998"
      }
    ],
    "http://ogp.me/ns#locality": [
      {
        "@language": "en-us",
        "@value": ""
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "http://resonancenewmusic.org/events/2019/3/30/modern-songs-fredericton"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Well-known soprano Sally Dibblee will sing a brand-new set of songs by New Brunswick’s senior and most prolific composer Michael R. Miller. Miller has set six poems written by his late wife Edith Hoisington Miller. Each song tells a small and intimate story, often invoking evocative images of nature"
      }
    ],
    "http://ogp.me/ns#image": [
