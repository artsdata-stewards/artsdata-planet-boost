    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "in October 2020 we made this video. It documents the painting Cloud by Deanna Musgrave with the music that was created and performed for the launch of it's installation back in 2015 by Andrew Reed Miller. Terrific film artistry by F. Chris Giles. a Collaboration with  The Beaverbrook Art Gallery"
      }
    ],
