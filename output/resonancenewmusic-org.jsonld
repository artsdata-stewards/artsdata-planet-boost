    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Well-known soprano Sally Dibblee will sing a brand-new set of songs by New Brunswick’s senior and most prolific composer Michael R. Miller. Miller has set six poems written by his late wife Edith Hoisington Miller. Each song tells a small and intimate story, often invoking evocative images of nature"
      }
