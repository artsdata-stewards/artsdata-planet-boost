    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<h1>2021</h1>\t\t\n\t\t<p style=\"text-align: center;\"><b>September 28 - October 10</b></p>\t\t\n\t\t<h1 style=\"text-align: center;\">Prismatic Artists</h1>\t\t\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/clyde-a-wray-2021/\">\n\t\t\t\t\t\tClyde A. Wray\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/digging-roots-2021/\">\n\t\t\t\t\t\tDigging Roots\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/twin-flames-2021/\">\n\t\t\t\t\t\tTwin Flames\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/open-border-2021/\">\n\t\t\t\t\t\tOpen Borders\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/barbara-kaneratonni-diabo-2021/\">\n\t\t\t\t\t\tBarbara Diabo\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/tyler-simmonds-2021/\">\n\t\t\t\t\t\tTyler Simmonds\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/morgan-toney-2021/\">\n\t\t\t\t\t\tMorgan Toney\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/meagan-musseau-2021/\">\n\t\t\t\t\t\tMeagan Musseau\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/rebecca-thomas-2021/\">\n\t\t\t\t\t\tRebecca Thomas\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/son-latino-2021/\">\n\t\t\t\t\t\tSon Latino\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/illest-omen-2021/\">\n\t\t\t\t\t\tIllest Omen\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/jacques-mindreau-2021/\">\n\t\t\t\t\t\tJacques Mindreau\n\t\t\t\t\t</a>\n\t\t<h1 style=\"text-align: center;\">2021 Program </h1>\t\t\n\t\t\t<a href=\"https://issuu.com/prismaticartsfestival/docs/prismatic_arts_program_2021\">\n\t\t\t\t\t\tView 2021's Program\n\t\t\t\t\t</a>\n\t\t<h1 style=\"text-align: center;\">Industry Events </h1>\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://prismaticfestival.com/index.php/masterclasses-2021/\">\n\t\t\t\t\t\t\t<img width=\"1024\" height=\"216\" src=\"https://prismaticfestival.com/wp-content/uploads/2021/08/industry-events-02-1024x216.png\" alt=\"\" srcset=\"https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2021/08/industry-events-02.png?resize=1024%2C216&amp;ssl=1 1024w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2021/08/industry-events-02.png?resize=300%2C63&amp;ssl=1 300w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2021/08/industry-events-02.png?resize=768%2C162&amp;ssl=1 768w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2021/08/industry-events-02.png?resize=1536%2C324&amp;ssl=1 1536w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2021/08/industry-events-02.png?resize=2048%2C432&amp;ssl=1 2048w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2021/08/industry-events-02.png?resize=1120%2C237&amp;ssl=1 1120w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2021/08/industry-events-02.png?resize=640%2C135&amp;ssl=1 640w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://prismaticfestival.com/index.php/the-talk-2021/\">\n\t\t\t\t\t\t\t<img width=\"1024\" height=\"216\" src=\"https://prismaticfestival.com/wp-content/uploads/2021/08/industry-events-01-1024x216.png\" alt=\"\" srcset=\"https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2021/08/industry-events-01.png?resize=1024%2C216&amp;ssl=1 1024w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2021/08/industry-events-01.png?resize=300%2C63&amp;ssl=1 300w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2021/08/industry-events-01.png?resize=768%2C162&amp;ssl=1 768w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2021/08/industry-events-01.png?resize=1536%2C324&amp;ssl=1 1536w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2021/08/industry-events-01.png?resize=2048%2C433&amp;ssl=1 2048w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2021/08/industry-events-01.png?resize=1120%2C237&amp;ssl=1 1120w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2021/08/industry-events-01.png?resize=640%2C135&amp;ssl=1 640w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" />\t\t\t\t\t\t\t\t</a>\n\t\thttps://youtu.be/dG8_B7ykldwhttps://youtu.be/_VVahFYzNWAhttps://youtu.be/BLTJKN0VfyUhttps://youtu.be/i8_C1LSJrXE\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t<img width=\"1024\" height=\"576\" src=\"https://prismaticfestival.com/wp-content/uploads/2021/09/Prismatic-2021-Sponsors-Funders-09-03-1024x576.png\" alt=\"\" srcset=\"https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2021/09/Prismatic-2021-Sponsors-Funders-09-03.png?resize=1024%2C576&amp;ssl=1 1024w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2021/09/Prismatic-2021-Sponsors-Funders-09-03.png?resize=300%2C169&amp;ssl=1 300w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2021/09/Prismatic-2021-Sponsors-Funders-09-03.png?resize=768%2C432&amp;ssl=1 768w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2021/09/Prismatic-2021-Sponsors-Funders-09-03.png?resize=1120%2C630&amp;ssl=1 1120w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2021/09/Prismatic-2021-Sponsors-Funders-09-03.png?resize=640%2C360&amp;ssl=1 640w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2021/09/Prismatic-2021-Sponsors-Funders-09-03.png?w=1280&amp;ssl=1 1280w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" />"
