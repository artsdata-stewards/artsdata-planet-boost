  {
    "@id": "_:g3153240",
    "@type": [
      "http://schema.org/ImageObject"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://prismaticfestival.com/wp-content/uploads/2021/04/DC_Thomas-1-1-1120x751-1.jpg"
      }
    ],
    "http://schema.org/contentUrl": [
      {
        "@id": "https://prismaticfestival.com/wp-content/uploads/2021/04/DC_Thomas-1-1-1120x751-1.jpg"
      }
    ],
