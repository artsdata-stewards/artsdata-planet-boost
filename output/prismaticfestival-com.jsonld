  {
    "@id": "_:g1887580",
    "@type": [
      "http://schema.org/ImageObject"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://prismaticfestival.com/wp-content/uploads/2019/07/Sina-Bathaie-square.jpg"
      }
    ],
    "http://schema.org/contentUrl": [
      {
