        "@id": "https://prismaticfestival.com/wp-content/uploads/2020/08/OwenLee-1-683x1024.jpg"
      }
    ],
    "http://schema.org/width": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
