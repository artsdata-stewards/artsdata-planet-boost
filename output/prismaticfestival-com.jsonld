  {
    "@id": "_:g4349460",
    "@type": [
      "http://schema.org/ImageObject"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://prismaticfestival.com/wp-content/uploads/2021/08/MeaganMusseau-Headshot-1_2020_5000-1024x683.jpg"
      }
    ],
    "http://schema.org/contentUrl": [
      {
        "@id": "https://prismaticfestival.com/wp-content/uploads/2021/08/MeaganMusseau-Headshot-1_2020_5000-1024x683.jpg"
