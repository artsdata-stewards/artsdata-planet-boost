    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<h1>2018</h1>\t\t\n\t\t<p>September 11 - 16</p>\t\t\n\t\t<p>Prismatic Artists </p>\t\t\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/the-mariachi-ghost-2018/\">\n\t\t\t\t\t\t<strong>The Mariachi Ghost</strong> \n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/sina-bathaie-2018/\">\n\t\t\t\t\t\t<strong>Sina Bathaie</strong>\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/santee-smith-2018/\">\n\t\t\t\t\t\t<strong>Santee Smith</strong>\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/tales-of-an-urban-indian-2018/\">\n\t\t\t\t\t\t<strong>Talk Is Free Theatre</strong>\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/shibaali-2018/\">\n\t\t\t\t\t\t<strong>Habib Meftah Boushehri & Mohsen Sharifian</strong> \n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/ava-2018/\">\n\t\t\t\t\t\t<strong>Sadaf Foroughi</strong>\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/shauntay-grant-2018/\">\n\t\t\t\t\t\t<strong>Shauntay Grant</strong>\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/broken-english-karaoke-2018/\">\n\t\t\t\t\t\t<strong>Stephanie Yee</strong>\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/asheq-2018/\">\n\t\t\t\t\t\t<strong>Onelight Theatre</strong><br\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/rah-eleh-2018/\">\n\t\t\t\t\t\t<strong>Rah-Eleh</strong><br>\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/opening-gala-2018/\">\n\t\t\t\t\t\t<strong>Opening Gala (Rebecca Thomas & Hubert Francis)</strong>\n\t\t\t\t\t</a>\n\t\t<h2 style=\"text-align: center;\">Prismatic 2018 Program </h2>\t\t\n\t\t\t<a href=\"https://issuu.com/prismaticartsfestival1/docs/prismatic_program_2018\">\n\t\t\t\t\t\tView 2018's Program\n\t\t\t\t\t</a>\n\t\t<h2>Industry Events</h2>\t\t\n\t\t\t\t\t\t\t\t\t\t<a href=\"https://prismaticfestival.com/index.php/the-talk-2018/\">The TALKClick Here</a><a href=\"https://prismaticfestival.com/index.php/masterclasses-2018/\">MasterclassesClick Here</a>\t\t\t\t\n\t\t\t\t\t\t\t<svg aria-hidden=\"true\" viewBox=\"0 0 1000 1000\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M646 125C629 125 613 133 604 142L308 442C296 454 292 471 292 487 292 504 296 521 308 533L604 854C617 867 629 875 646 875 663 875 679 871 692 858 704 846 713 829 713 812 713 796 708 779 692 767L438 487 692 225C700 217 708 204 708 187 708 171 704 154 692 142 675 129 663 125 646 125Z\"></path></svg>\t\t\t\t\t\t\tPrevious slide\n\t\t\t\t\t\t\t<svg aria-hidden=\"true\" viewBox=\"0 0 1000 1000\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M696 533C708 521 713 504 713 487 713 471 708 454 696 446L400 146C388 133 375 125 354 125 338 125 325 129 313 142 300 154 292 171 292 187 292 204 296 221 308 233L563 492 304 771C292 783 288 800 288 817 288 833 296 850 308 863 321 871 338 875 354 875 371 875 388 867 400 854L696 533Z\"></path></svg>\t\t\t\t\t\t\tNext slide\n\t\t<h2 style=\"text-align: center;\">Additional Archive Material</h2>\t\t\n\t\t<p><strong>CTV</strong></p><p>Meet The Mariachi Ghost</p><p> </p>https://prismaticfestival.com/wp-content/uploads/2020/07/Meet_Marichi_Ghost-1485674.mp4<p><strong>CTV</strong></p><p>The Mariachi Ghost</p><p>Rencor Vivo Sneak Peek</p>https://prismaticfestival.com/wp-content/uploads/2020/07/Rencor_Vivo_by_Mariachi_Ghost-1485675.mp4\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t<img width=\"1024\" height=\"542\" src=\"https://prismaticfestival.com/wp-content/uploads/2020/07/2018-funders-sponsers-e1603382451463-1024x542.png\" alt=\"2018-sponsers\" srcset=\"https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/07/2018-funders-sponsers-e1603382451463.png?resize=1024%2C542&amp;ssl=1 1024w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/07/2018-funders-sponsers-e1603382451463.png?resize=300%2C159&amp;ssl=1 300w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/07/2018-funders-sponsers-e1603382451463.png?resize=768%2C406&amp;ssl=1 768w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/07/2018-funders-sponsers-e1603382451463.png?resize=1536%2C813&amp;ssl=1 1536w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/07/2018-funders-sponsers-e1603382451463.png?resize=2048%2C1083&amp;ssl=1 2048w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/07/2018-funders-sponsers-e1603382451463.png?resize=1120%2C592&amp;ssl=1 1120w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/07/2018-funders-sponsers-e1603382451463.png?resize=640%2C339&amp;ssl=1 640w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/07/2018-funders-sponsers-e1603382451463.png?w=2560&amp;ssl=1 2560w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" />"
      }
