    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<img width=\"1024\" height=\"468\" src=\"https://prismaticfestival.com/wp-content/uploads/2020/08/Screen-Shot-2020-08-11-at-12.02.25-PM-1024x468.png\" alt=\"Michael Greyeye Prismatic Arts Festival 2015\" loading=\"lazy\" srcset=\"https://prismaticfestival.com/wp-content/uploads/2020/08/Screen-Shot-2020-08-11-at-12.02.25-PM-1024x468.png 1024w, https://prismaticfestival.com/wp-content/uploads/2020/08/Screen-Shot-2020-08-11-at-12.02.25-PM-300x137.png 300w, https://prismaticfestival.com/wp-content/uploads/2020/08/Screen-Shot-2020-08-11-at-12.02.25-PM-768x351.png 768w, https://prismaticfestival.com/wp-content/uploads/2020/08/Screen-Shot-2020-08-11-at-12.02.25-PM-1120x512.png 1120w, https://prismaticfestival.com/wp-content/uploads/2020/08/Screen-Shot-2020-08-11-at-12.02.25-PM-640x292.png 640w, https://prismaticfestival.com/wp-content/uploads/2020/08/Screen-Shot-2020-08-11-at-12.02.25-PM.png 1418w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" />\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t<a href=\"https://www.imdb.com/name/nm0340729/\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\tDesktop\n\t\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t<a href=\"https://twitter.com/MichaelGreyeyes?ref_src=twsrc%5Egoogle%7Ctwcamp%5Eserp%7Ctwgr%5Eauthor\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\tTwitter\n\t\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t<a href=\"https://www.instagram.com/michael_greyeyes/?hl=en\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\tInstagram\n\t\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t<h2>Michael     Greyeyes&nbsp;\nWinter Home\n</h2>\t\t\t\t\t\t\t\t\t\n\t\t<p><strong>Type of Art:</strong> Multi-media Installation </p><p><strong>Dates:  </strong>Aug 19th - 21st </p><p><strong>Location: </strong>Alderney Landing Theatre</p>\t\t\n\t\t<p>Winter Home is a multi-media installation created by Michael Greyeyes for Signal Installation that examines disconnection through a series of projected and static images. This performance action destabilizes trans-historical notions of memory, home, and our attenuation to family history. Iconic photographs of Indigenous people intervene in the space and collide with the presence of the performer troubling our presumptions of authenticity.</p>\t\t\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/2015-archive/\" role=\"button\">\n\t\t\t\t\t\tBack to 2015\n\t\t\t\t\t</a>"
