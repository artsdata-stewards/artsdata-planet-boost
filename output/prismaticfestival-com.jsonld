com/wp-content/uploads/elementor/thumbs/minuteman-press-qpuu53t120rhv1cr5gl28empca0v0wh2p7qrsqbq4m.png\" title=\"minuteman press\" alt=\"minuteman press\" loading=\"lazy\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://agns.ca/\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<img src=\"https://prismaticfestival.com/wp-content/uploads/elementor/thumbs/AGNS-LOGO-COLOUR-03-qpuuwzos2kn9bipmlg63qru820qv86ia1bb0rst64k.png\" title=\"AGNS LOGO COLOUR 03\" alt=\"AGNS LOGO COLOUR 03\" loading=\"lazy\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://symphonynovascotia.ca/\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<img src=\"https://prismaticfestival.com/wp-content/uploads/elementor/thumbs/SNS_RGB_TRANSPARENT-301x173-1-q8al72resysxs9lpslcv3vmp0mc50bsbaw8x920b02.png\" title=\"\" alt=\"\" loading=\"lazy\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://www.easternfronttheatre.com/\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<img src=\"https://prismaticfestival.com/wp-content/uploads/elementor/thumbs/ANSMA-Logo_Acronym-Colour-Light-qrxsl19u9w3cimytsjf65hkavb2tz4itfvcq942rwo.png\" title=\"ANSMA-Logo_Acronym-Colour-Light\" alt=\"ANSMA-Logo_Acronym-Colour-Light\" loading=\"lazy\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://www.easternfronttheatre.com/\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<img src=\"https://prismaticfestival.com/wp-content/uploads/elementor/thumbs/eft_logo-qpuu2gvb9trlpprxiegdy32z0m52qjdx10b29k9d6w.png\" title=\"eft_logo\" alt=\"eft_logo\" loading=\"lazy\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://mulgraveroad.ca/\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<img src=\"https://prismaticfestival.com/wp-content/uploads/elementor/thumbs/mulgrave-theatre-logo-light-1-e1720714019948-qqyld318n97f63wfazf4kictbyw3tr3il8by8n7j1q.png\" title=\"mulgrave theatre logo light 1\" alt=\"mulgrave theatre logo light 1\" loading=\"lazy\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://www.easternfronttheatre.com/\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<img src=\"https://prismaticfestival.com/wp-content/uploads/elementor/thumbs/26-Mikmaw-Native-Friendship-Centre-Logo-2-01-qrxtz5zzdq3tank33mm7xbnhquva6x5pz5gnqlq0l6.png\" title=\"26 &#8211; Mi&#8217;kmaw Native Friendship Centre &#8211; Logo 2-01\" alt=\"26 - Mi&#039;kmaw Native Friendship Centre - Logo 2-01\" loading=\"lazy\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://www.easternfronttheatre.com/\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<img src=\"https://prismaticfestival.com/wp-content/uploads/elementor/thumbs/msvuag-x2-1-qq8t0ztxrjqvcxd256kt3k05rrohnzjcfbgfzr42g8.png\" title=\"msvuag-x2-1\" alt=\"msvuag-x2-1\" loading=\"lazy\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://www.long-mcquade.com/\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<img width=\"549\" height=\"92\" src=\"https://prismaticfestival.com/wp-content/uploads/2023/09/Long-and-Mcquade-logo.png\" alt=\"\" srcset=\"https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2023/09/Long-and-Mcquade-logo.png?w=549&amp;ssl=1 549w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2023/09/Long-and-Mcquade-logo.png?resize=300%2C50&amp;ssl=1 300w\" sizes=\"(max-width: 549px) 100vw, 549px\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://halifaxshoppingcentre.com/\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<img src=\"https://prismaticfestival.com/wp-content/uploads/elementor/thumbs/mall-logo-qs525zh3lb6r8gblf2g295iqg84p6p5thg27xpgz5q.png\" title=\"mall-logo\" alt=\"mall-logo\" loading=\"lazy\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://halifaxshoppingcentre.com/\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<img src=\"https://prismaticfestival.com/wp-content/uploads/elementor/thumbs/Mocean-logo-2-colour-qsxw0k4tlpqg253k88uvzu60hkrcj9zn10m2jflzle.png\" title=\"Mocean logo 2-colour\" alt=\"Mocean logo 2-colour\" loading=\"lazy\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://www.wonderneath.com/\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<img src=\"https://prismaticfestival.com/wp-content/uploads/elementor/thumbs/wonderneath-qtiryvbu0qy6mfymmjbtpqm4gqn4r78xim6r0e6vju.png\" title=\"wonderneath\" alt=\"wonderneath\" loading=\"lazy\" />\t\t\t\t\t\t\t\t</a>"
