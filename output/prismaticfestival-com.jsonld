      }
    ],
    "http://schema.org/height": [
      {
        "@language": "en",
        "@value": "825"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "dinuk-wijeratne-2020"
      }
    ],
    "http://schema.org/headline": [
      {
        "@language": "en",
        "@value": "Dinuk Wijeratne 2020"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<img width=\"600\" height=\"825\" src=\"https://prismaticfestival.com/wp-content/uploads/2019/07/20100517_DinukWijeratne_02.jpg\" alt=\"Dinuk Wijeratne\" loading=\"lazy\" srcset=\"https://prismaticfestival.com/wp-content/uploads/2019/07/20100517_DinukWijeratne_02.jpg 600w, https://prismaticfestival.com/wp-content/uploads/2019/07/20100517_DinukWijeratne_02-218x300.jpg 218w\" sizes=\"(max-width: 600px) 100vw, 600px\" />\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t<p><strong>Dinuk Wijeratne</strong> | Composer &amp; Musician<br /><strong>Skratch Bastid</strong> | Musician<br /><strong>Afiara Quartet</strong> | Musician<br /><strong>Song</strong>: Through the Invisible</p>\t\t\n\t\t\t\t\t<a href=\"https://www.dinukwijeratne.com/\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\tDesktop\n\t\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t<a href=\"https://twitter.com/WijeratneWorks\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\tTwitter\n\t\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t<a href=\"https://www.instagram.com/wijeratneworks/\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\tInstagram\n\t\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t<h2>Dinuk     Wijeratne&nbsp;Shifting Verse</h2>\t\t\t\t\t\t\t\t\t\n\t\t<p><strong>Type of Art:</strong>  Music</p><p><strong>Date: </strong>Sept 17 @ 7:30 pm </p><p><strong>Location: </strong>Grand Parade</p>\t\t\n\t\t<p>Sri Lankan-born Dinuk Wijeratne is a JUNO, SOCAN, ECMA, and Masterworks award-winning composer, conductor, and pianist. He has been described by <i>The New York Times</i> as “exuberantly creative” and by the <i>Toronto Star</i> as “an artist who reflects a positive vision of our cultural future.” </p><p>Dinuk’s boundary-crossing work sees him equally at home in collaborations with symphony orchestras and string quartets, tabla players and DJs, and takes him to international venues as poles apart as the Berlin Philharmonic and the North Sea Jazz Festival. He has appeared at Carnegie Hall, the Kennedy Center, Opera Bastille (Paris), Lincoln Center (New York), Teatro Colón (Buenos Aires), Sri Lanka, Japan, and across the Middle East.</p><p>Dinuk has served both as Composer-in-Residence and Conductor-in-Residence of Symphony Nova Scotia. His countless composition and performance collaborations include those with Yo Yo Ma’s Silk Road Ensemble, Suzie LeBlanc, Kinan Azmeh, Zakir Hussain, Sandeep Das, Joseph Petric, David Jalbert, Bev Johnston, Tim Garland, Ed Thigpen, Ramesh Misra, James Ehnes, Eric Vloeimans, Buck 65, the Gryphon Trio, TorQ Percussion; the Afiara, Danel, and Cecilia String Quartets; and the symphony orchestras of Toronto, Vancouver, Calgary, Winnipeg, Fresno, Buffalo, Illinois, Windsor, Victoria, Asheville, Thunder Bay, and KwaZulu Natal (South Africa).</p>\t\t\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/prismatic-2020/\" role=\"button\">\n\t\t\t\t\t\tBack to 2020\n\t\t\t\t\t</a>"
      }
    ],
