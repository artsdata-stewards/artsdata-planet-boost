  {
    "@id": "_:g2713520",
    "@type": [
      "http://schema.org/ImageObject"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://prismaticfestival.com/wp-content/uploads/2021/04/Asheq-2018-Exorcism-close-1120x745-1.jpg"
