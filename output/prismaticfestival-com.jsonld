    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "the-sanctified-brothers-2014"
      }
    ],
    "http://schema.org/headline": [
      {
        "@language": "en",
        "@value": "The Sanctified Brothers 2014"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<img width=\"1024\" height=\"682\" src=\"https://prismaticfestival.com/wp-content/uploads/2020/07/KSF_7151-1024x682.jpg\" alt=\"\" loading=\"lazy\" srcset=\"https://prismaticfestival.com/wp-content/uploads/2020/07/KSF_7151-1024x682.jpg 1024w, https://prismaticfestival.com/wp-content/uploads/2020/07/KSF_7151-300x200.jpg 300w, https://prismaticfestival.com/wp-content/uploads/2020/07/KSF_7151-768x511.jpg 768w, https://prismaticfestival.com/wp-content/uploads/2020/07/KSF_7151-1536x1022.jpg 1536w, https://prismaticfestival.com/wp-content/uploads/2020/07/KSF_7151-2048x1363.jpg 2048w, https://prismaticfestival.com/wp-content/uploads/2020/07/KSF_7151-1120x745.jpg 1120w, https://prismaticfestival.com/wp-content/uploads/2020/07/KSF_7151-640x426.jpg 640w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" />\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t<p>On Stage:</p><p><b>Jr Smith</b>: Drums</p><p><b>Shawn Downey</b>: Keyboard</p><p><b>Luke Arsenault</b>: Guitar</p><p><b>Marlowe Smith</b>: Bass Guitar</p><p><b>Wallace Smith Jr</b>: Vocals</p><p><b>Wallace Smith Sr</b>: Vocals</p><p><b>Dana Willis</b>: Vocals</p><p><b>Micheal Smith</b>: Vocals</p>\t\t\n\t\t\t\t\t\t\t\t\t\t\t<h3>The Sanctified Brothers</h3>\t\t\t\t\t\t\t\t\t\n\t\t<p><strong>Type of Art:</strong>  Music</p><p><strong>Dates</strong>: Aug 22nd and 24th</p><p><strong>Location:</strong> Alderney Landing - Outdoor Mainstage</p>\t\t\n\t\t<p>The Sanctified Brothers are a booming men’s soul gospel group from North Preston. Nova Scotia has a long tradition of fantastic gospel music and The Sanctified Brothers, formerly known as The Deep River Boys, have quickly established themselves as one of the best groups in Canada. Many have performed and been members of award-winning groups such as The Gospelheirs and The Hallelujah Praise Choir and have performed with Rita MacNeil. The Sanctified Brothers appeared as part of the 2011 and 2012 TD Halifax Jazz Festival.</p>\t\t\n\t\t\t\t\t\t\t<a href=\"https://prismaticfestival.com/wp-content/uploads/2020/07/sanctified-1.jpg\" data-elementor-open-lightbox=\"yes\" data-elementor-lightbox-slideshow=\"dc85140\" data-elementor-lightbox-title=\"sanctified-1\">\t\t\n\t\t</a>\t\t\t\t\t\t\n\t\t\t\t\t\t\t<a href=\"https://prismaticfestival.com/wp-content/uploads/2020/07/santified-2.jpg\" data-elementor-open-lightbox=\"yes\" data-elementor-lightbox-slideshow=\"dc85140\" data-elementor-lightbox-title=\"santified-2\">\t\t\n\t\t</a>\t\t\t\t\t\t\n\t\t\t\t\t\t\t<a href=\"https://prismaticfestival.com/wp-content/uploads/2020/07/sanctified.jpg\" data-elementor-open-lightbox=\"yes\" data-elementor-lightbox-slideshow=\"dc85140\" data-elementor-lightbox-title=\"sanctified\">\t\t\n\t\t</a>\t\t\t\t\t\t\n\t\t\t\t\t\t\tPrevious\n\t\t\t\t\t\t\tNext\n\t\t</a>\t\t\t\t\t\t\n\t\t</a>\t\t\t\t\t\t\n\t\t</a>\t\t\t\t\t\t\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/2014-archive/\" role=\"button\">\n\t\t\t\t\t\tBack to 2014\n\t\t\t\t\t</a>"
      }
    ],
