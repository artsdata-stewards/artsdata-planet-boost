  {
    "@id": "_:g2053120",
    "@type": [
      "http://schema.org/ImageObject"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://prismaticfestival.com/wp-content/uploads/2020/07/Rah-.jpg"
      }
    ],
    "http://schema.org/contentUrl": [
      {
        "@id": "https://prismaticfestival.com/wp-content/uploads/2020/07/Rah-.jpg"
      }
    ],
    "http://schema.org/width": [
