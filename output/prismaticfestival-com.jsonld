    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "2023 Basset &#8211; Prismatic Festival"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Toronto-based indie-folk duo, Basset, are full of timeless heart. Acoustic songwriters Sam Clark and Yasmine Shelton will take you through city streets in the hours before the world has woken, or to a corrugated steel home north of the treeline. "
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "en",
        "@value": "en-US"
      }
    ]
  },
