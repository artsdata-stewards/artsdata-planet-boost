        "@value": "<h1>2019</h1>\t\t\n\t\t<p style=\"text-align: center;\">September 10 - 23</p><h2 style=\"text-align: center;\">Prismatic Artists</h2>\t\t\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/nyata-nyata-2019/\">\n\t\t\t\t\t\t9/15 & 9/16\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/sina-bathaie-2019/\">\n\t\t\t\t\t\t9/16\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/ensemble-kaman-2019/\">\n\t\t\t\t\t\t9/17\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/battle-of-santiago-2019/\">\n\t\t\t\t\t\t9/18\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/digging-roots-2019/\">\n\t\t\t\t\t\t9/17\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/g-r-gritt-2019/\">\n\t\t\t\t\t\t9/18\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/diyet-and-the-love-soldiers/\">\n\t\t\t\t\t\t9/19\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/namu/\">\n\t\t\t\t\t\t9/19 \n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/rebecca-thomas-2019/\">\n\t\t\t\t\t\t9/15\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/cliff-cardinal-2019/\">\n\t\t\t\t\t\t9/15 - 9/18\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/kahawi-dance-theatre-2019/\">\n\t\t\t\t\t\t9/15 & 9/16\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/zoey-roy-2019/\">\n\t\t\t\t\t\t9/15 & 9/16\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/the-tashme-project-2019/\">\n\t\t\t\t\t\t9/18-9/22\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/rah-eleh-2019/\">\n\t\t\t\t\t\t9/12 - 9/22\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/broken-english-karaoke-2019/\">\n\t\t\t\t\t\t9/15-9/21\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/hong-kong-exile-2019/\">\n\t\t\t\t\t\t9/18-9/20\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/esie-mensah-2019/\">\n\t\t\t\t\t\t9/17 & 9/18\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/onelight-theatre-2019/\">\n\t\t\t\t\t\t9/16 - 9/19\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/jacques-mindreau-2019/\">\n\t\t\t\t\t\t9/16\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/constantinople-2019/\">\n\t\t\t\t\t\t9/19\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/paul-wong-2019/\">\n\t\t\t\t\t\t9/16\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/dinuk-wijeratne-2019/\">\n\t\t\t\t\t\t9/16\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/focus-cia-de-danca-2019/\">\n\t\t\t\t\t\t9/16\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/son-latino-2019/\">\n\t\t\t\t\t\t9/16\n\t\t\t\t\t</a>\n\t\t<h2 style=\"text-align: center;\">Prismatic 2019 Program</h2>\t\t\n\t\t\t<a href=\"https://issuu.com/prismaticartsfestival/docs/prismatic-2019-program\">\n\t\t\t\t\t\tView 2019's Program\n\t\t\t\t\t</a>\n\t\t<h2 style=\"text-align: center;\">Industry Events</h2>\t\t\n\t\t\t\t\t\t\t\t\t\t<a href=\"https://prismaticfestival.com/index.php/industry-events/\">The TALKClick Here</a><a href=\"https://prismaticfestival.com/index.php/international-arts-assembly-2019/\">International Arts Assembly Click Here</a>\t\t\t\t\n\t\t\t\t\t\t\t<svg aria-hidden=\"true\" viewBox=\"0 0 1000 1000\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M646 125C629 125 613 133 604 142L308 442C296 454 292 471 292 487 292 504 296 521 308 533L604 854C617 867 629 875 646 875 663 875 679 871 692 858 704 846 713 829 713 812 713 796 708 779 692 767L438 487 692 225C700 217 708 204 708 187 708 171 704 154 692 142 675 129 663 125 646 125Z\"></path></svg>\t\t\t\t\t\t\tPrevious slide\n\t\t\t\t\t\t\t<svg aria-hidden=\"true\" viewBox=\"0 0 1000 1000\" 