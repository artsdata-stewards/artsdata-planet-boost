t=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<img src=\"https://prismaticfestival.com/wp-content/uploads/elementor/thumbs/eft_logo-qpuu2gvbilirxzxtiyw4nvon5bak7pmtoo4j391tgs.png\" title=\"eft_logo\" alt=\"eft_logo\" loading=\"lazy\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://mulgraveroad.ca/\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<img src=\"https://prismaticfestival.com/wp-content/uploads/elementor/thumbs/mulgrave-theatre-logo-light-1-e1720714019948-qqyld318n97f63wfazf4kictbyw3tr3il8by8n7j1q.png\" title=\"mulgrave theatre logo light 1\" alt=\"mulgrave theatre logo light 1\" loading=\"lazy\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://www.easternfronttheatre.com/\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<img src=\"https://prismaticfestival.com/wp-content/uploads/elementor/thumbs/26-Mikmaw-Native-Friendship-Centre-Logo-2-01-qrxtz5zzdq3tank33mm7xbnhquva6x5pz5gnqlq0l6.png\" title=\"26 &#8211; Mi&#8217;kmaw Native Friendship Centre &#8211; Logo 2-01\" alt=\"26 - Mi&#039;kmaw Native Friendship Centre - Logo 2-01\" loading=\"lazy\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://www.easternfronttheatre.com/\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<img src=\"https://prismaticfestival.com/wp-content/uploads/elementor/thumbs/msvuag-x2-1-qq8t0ztxrjqvcxd256kt3k05rrohnzjcfbgfzr42g8.png\" title=\"msvuag-x2-1\" alt=\"msvuag-x2-1\" loading=\"lazy\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://www.long-mcquade.com/\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<img width=\"549\" height=\"92\" src=\"https://prismaticfestival.com/wp-content/uploads/2023/09/Long-and-Mcquade-logo.png\" alt=\"\" srcset=\"https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2023/09/Long-and-Mcquade-logo.png?w=549&amp;ssl=1 549w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2023/09/Long-and-Mcquade-logo.png?resize=300%2C50&amp;ssl=1 300w\" si