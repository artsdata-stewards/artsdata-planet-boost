    ],
    "http://schema.org/url": [
      {
        "@id": "https://prismaticfestival.com/wp-content/uploads/2021/08/son-latino-photo-1024x768.jpg"
      }
    ],
    "http://schema.org/contentUrl": [
      {
        "@id": "https://prismaticfestival.com/wp-content/uploads/2021/08/son-latino-photo-1024x768.jpg"
      }
    ],
    "http://schema.org/width": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": "1200"
      }
    ],
    "http://schema.org/height": [
      {
        "@language": "en",
