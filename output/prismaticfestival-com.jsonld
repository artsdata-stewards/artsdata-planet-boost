    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<h1 style=\"text-align: center;\">INDUSTRY EVENTS </h1>\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://prismaticfestival.com/index.php/open-spaces/\">\n\t\t\t\t\t\t\t<img width=\"1024\" height=\"174\" src=\"https://prismaticfestival.com/wp-content/uploads/2020/08/images-1-04-1024x174.png\" alt=\"Prismatic Arts Festival Open Spaces Program\" loading=\"lazy\" srcset=\"https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/images-1-04.png?resize=1024%2C174&amp;ssl=1 1024w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/images-1-04.png?resize=300%2C51&amp;ssl=1 300w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/images-1-04.png?resize=768%2C130&amp;ssl=1 768w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/images-1-04.png?resize=1536%2C261&amp;ssl=1 1536w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/images-1-04.png?resize=1120%2C190&amp;ssl=1 1120w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/images-1-04.png?resize=640%2C109&amp;ssl=1 640w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/images-1-04.png?w=1920&amp;ssl=1 1920w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://prismaticfestival.com/index.php/masterclasses/\">\n\t\t\t\t\t\t\t<img width=\"1024\" height=\"236\" src=\"https://prismaticfestival.com/wp-content/uploads/2020/08/images-1-02-1024x236.png\" alt=\"Masterclasses\" loading=\"lazy\" srcset=\"https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/images-1-02.png?resize=1024%2C236&amp;ssl=1 1024w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/images-1-02.png?resize=300%2C69&amp;ssl=1 300w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/images-1-02.png?resize=768%2C177&amp;ssl=1 768w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/images-1-02.png?resize=1536%2C354&amp;ssl=1 1536w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/images-1-02.png?resize=1120%2C258&amp;ssl=1 1120w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/images-1-02.png?resize=640%2C148&amp;ssl=1 640w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/images-1-02.png?w=1920&amp;ssl=1 1920w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://prismaticfestival.com/index.php/the-talk-2020/\">\n\t\t\t\t\t\t\t<img width=\"1024\" height=\"201\" src=\"https://prismaticfestival.com/wp-content/uploads/2021/05/Untitled-1-01-1024x201.png\" alt=\"Talk Conference\" loading=\"lazy\" srcset=\"https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2021/05/Untitled-1-01.png?resize=1024%2C201&amp;ssl=1 1024w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2021/05/Untitled-1-01.png?resize=300%2C59&amp;ssl=1 300w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2021/05/Untitled-1-01.png?resize=768%2C151&amp;ssl=1 768w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2021/05/Untitled-1-01.png?resize=1120%2C220&amp;ssl=1 1120w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2021/05/Untitled-1-01.png?resize=640%2C126&amp;ssl=1 640w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2021/05/Untitled-1-01.png?w=1536&amp;ssl=1 1536w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" />\t\t\t\t\t\t\t\t</a>"
