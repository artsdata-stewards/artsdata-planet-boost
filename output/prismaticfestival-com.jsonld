  {
    "@id": "_:g2984220",
    "@type": [
      "http://schema.org/ImageObject"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://prismaticfestival.com/wp-content/uploads/2019/07/Thanks-sponsors-1024x30.jpg"
      }
    ],
    "http://schema.org/contentUrl": [
      {
        "@id": "https://prismaticfestival.com/wp-content/uploads/2019/07/Thanks-sponsors-1024x30.jpg"
      }
    ],
    "http://schema.org/width": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
