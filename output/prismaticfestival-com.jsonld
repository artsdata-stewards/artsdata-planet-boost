_logo_color.png?resize=640%2C213&amp;ssl=1 640w\" sizes=\"(max-width: 1480px) 100vw, 1480px\" />\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img src=\"https://prismaticfestival.com/wp-content/uploads/elementor/thumbs/Halifax-Harbour-Bridges-logo-qc0watzqtl082538n7360vap4pc897a61xs665kz72.png\" title=\"Halifax Harbour Bridges logo\" alt=\"Halifax Harbour Bridges logo\" loading=\"lazy\" />\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://afhalifax.ca/\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<img src=\"https://prismaticfestival.com/wp-content/uploads/elementor/thumbs/sponsor-logos-14-psz3vva37q0blp0kx5kgm1v5900nkfn9ej3xljc6n2.png\" title=\"\" alt=\"\" loading=\"lazy\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img src=\"https://prismaticfestival.com/wp-content/uploads/elementor/thumbs/AFNWA-Logo-qfncmm7knzgpy0lp4m8amxcduovttnxhifab4ehpic.png\" title=\"\" alt=\"\" loading=\"lazy\" />"
