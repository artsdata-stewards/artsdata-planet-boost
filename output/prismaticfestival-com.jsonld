ismaticfestival.com/wp-content/uploads/elementor/thumbs/HJF-dark-horizontal-q8alapeyvz2ttpmkkyabu7wofb0avsdvba5kxen04m.png\" title=\"\" alt=\"\" loading=\"lazy\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://www.halifaxcitadel.ca/\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<img src=\"https://prismaticfestival.com/wp-content/uploads/elementor/thumbs/HCS-LOGO-q8alck5hiih2x1d0p9lqqyyk57u5w6vmxn3x454hfy.png\" title=\"\" alt=\"\" loading=\"lazy\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://artgallery.dal.ca/\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<img src=\"https://prismaticfestival.com/wp-content/uploads/elementor/thumbs/download-removebg-preview-1-q8cowvwek9ggu1e7wi14pk2nzreo7ytns3av4igzsm.png\" title=\"\" alt=\"\" loading=\"lazy\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://mayworkskjipuktukhfx.ca/events/\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<img src=\"https://prismaticfestival.com/wp-content/uploads/elementor/thumbs/MW_LOGOS_2023-1-q8c6108xolbp48qry427grh13sgnaeolser48ex2eo.png\" title=\"\" alt=\"\" loading=\"lazy\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://www.indigenousmusicsummit.com/\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<img src=\"https://prismaticfestival.com/wp-content/uploads/elementor/thumbs/International-Indigenous-Music-Summit-logo-q8c628fdgi5a2wj7u4orq8fjhcg3iaf5xas2obv512.png\" title=\"\" alt=\"\" loading=\"lazy\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://www.halifaxpubliclibraries.ca/\">\n\t\t\t\t\t\t\t<img src=\"https://prismaticfestival.com/wp-content/uploads/elementor/thumbs/HPL_Logo_Horizontal_Master_RGB-qa8lj41vqq1gag58ddwbyqhwnfcy8w92c1otlyr0tm.png\" title=\"\" alt=\"\" loading=\"lazy\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://halifaxurbanfolkfestival.com/\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<im