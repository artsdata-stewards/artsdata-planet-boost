      }
    ],
    "http://schema.org/contentUrl": [
      {
        "@id": "https://prismaticfestival.com/wp-content/uploads/2024/06/DanFroese-Shalan-7569.jpg"
      }
    ],
    "http://schema.org/width": [
      {
        "@language": "en",
        "@value": "1920"
      }
    ],
    "http://schema.org/height": [
