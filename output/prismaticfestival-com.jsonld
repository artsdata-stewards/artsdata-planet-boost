        "@value": "son-latino-2019"
      }
    ],
    "http://schema.org/headline": [
      {
        "@language": "en",
        "@value": "Son Latino 2019"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<img width=\"800\" height=\"600\" src=\"https://prismaticfestival.com/wp-content/uploads/2019/08/son-latino.jpg\" alt=\"\" loading=\"lazy\" srcset=\"https://prismaticfestival.com/wp-content/uploads/2019/08/son-latino.jpg 800w, https://prismaticfestival.com/wp-content/uploads/2019/08/son-latino-300x225.jpg 300w, https://prismaticfestival.com/wp-content/uploads/2019/08/son-latino-768x576.jpg 768w, https://prismaticfestival.com/wp-content/uploads/2019/08/son-latino-640x480.jpg 640w\" sizes=\"(max-width: 800px) 100vw, 800px\" />\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t<p><strong>Mauricio Duarte |</strong> keyboards</p><p><strong>Yonelis Legra Noa |</strong> voice, percussion</p><p><strong>Jorge Loza |</strong> bass</p><p><strong>Maykel Nuñez |</strong> percussion, voice</p><p><strong>Paul “Pablito” St-Amand |</strong> trumpet, flugelhorn, voice, percussion</p><p><strong>Aryam Zubizarreta Perez |</strong> voice, guitar, percussion</p>\t\t\n\t\t\t\t\t<a href=\"https://www.facebook.com/SonLatinoHFX/\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\tFacebook-f\n\t\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t<h2>Son Latino</h2>\t\t\t\t\t\t\t\t\t\n\t\t<p><strong>Type of Performance:</strong>&nbsp; Musical Concert</p>\n<p>(opening act performance for <a href=\"https://prismaticfestival.com/index.php/dinuk-wijeratne-2019/\">Dinuk Wijeratne</a> )</p>\n<p><strong>Dates: </strong>September 10th @ 6:30pm</p>\n<p><strong>Venue: </strong>Halifax Central Library</p>\n<p><strong>Ticket Prices:</strong><strong>&nbsp;</strong><strong>$18</strong>&nbsp;<em>(Gen Ticket)&nbsp;</em>/&nbsp;<strong>$15</strong><em> (Sr./Student)</em></p>\t\t\n\t\t<p>Featuring dynamic musicians from Cuba, Colombia, Mexico, and Canada, Son Latino puts a unique cross-cultural spin on Latin American music.</p><p>The band has rapidly become a favourite live ensemble for salsa dancers and Latin music aficionados in Halifax. Their repertoire is a mixture of traditional and contemporary tunes from all over Latin America, and includes compulsively danceable rhythms like salsa, merengue, bachata, cha cha, and more. With a sound reminiscent of the great Buena Vista Social Club, Son Latino makes it almost impossible for audiences to sit still.</p>\t\t\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/2019-archive/\" role=\"button\">\n\t\t\t\t\t\tBack to 2019\n\t\t\t\t\t</a>"
      }
    ],
