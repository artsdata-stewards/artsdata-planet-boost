    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<h1>2022</h1>\t\t\n\t\t\t<h2>September 26th - October 9th</h2>\t\t\n\t\t\t<h2>Prismatic Artists</h2>\t\t\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/2022-aysanabee\">\n\t\t\t\t\t\tAysanabee\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/2022-boca-del-lupo\">\n\t\t\t\t\t\tBoca del Lupo\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/2022-boma-nnaji\">\n\t\t\t\t\t\tBoma Nnaji\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/2022-brandon-hoax\">\n\t\t\t\t\t\tBrandon Hoax\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/2022-breaking-circus-and-upstream/\">\n\t\t\t\t\t\tBreaking Circus + Upstream\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/2022-celeigh-cardinal/\">\n\t\t\t\t\t\tCeleigh Cardinal\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/2022-cliff-cardinal\">\n\t\t\t\t\t\tCliff Cardinal\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/2022-deedee-austin/\">\n\t\t\t\t\t\tDeedee Austin\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/2022-djely-tapa/\">\n\t\t\t\t\t\tDjely Tapa\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/2022-ebnfloh\">\n\t\t\t\t\t\tEbnflōh\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/2022-emmanuel-nwogbo/\">\n\t\t\t\t\t\tEmmanuel Nwogbo\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/2022-santiago-guzman\">\n\t\t\t\t\t\tSantiago Guzmán\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/2022-sarah-prosper\">\n\t\t\t\t\t\tSarah Prosper\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/2022-tamarzee/\">\n\t\t\t\t\t\tTamarzee\n\t\t\t\t\t</a>\n\t\t\t<h2>Virtual Presentation</h2>\t\t\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/2022-koqm/\">\n\t\t\t\t\t\tKOQM\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/2022-samqwan/\">\n\t\t\t\t\t\tSamqwan\n\t\t\t\t\t</a>\n\t\t\t<h2>Festival Program</h2>\t\t\n\t\t\t<a href=\"https://issuu.com/prismaticartsfestival/docs/prismatic_2022_program-min%20\">\n\t\t\t\t\t\tView 2022's Program\n\t\t\t\t\t</a>\n\t\t\t<h2>Industry Events</h2>\t\t\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/masterclasses-2022/\">\n\t\t\t\t\t\tMasterclasses\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/prismatic-at-contact-east-2022/\">\n\t\t\t\t\t\tPrismatic at <br>Contact East\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/evening-with-prismatic-2022/\">\n\t\t\t\t\t\tAn Evening<br>with Prismatic\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/dance-battle-2022\">\n\t\t\t\t\t\tDance <br>Battle\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/iims-2022\">\n\t\t\t\t\t\tPrismatic & International Indigenous Music Summit\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/the-talk-2022/\">\n\t\t\t\t\t\tThe TALK<br>International\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/workshops-2022\">\n\t\t\t\t\t\tDance Workshop\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/open-spaces/\">\n\t\t\t\t\t\tOpen Spaces Program\n\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://www.canada.ca/en/canadian-heritage.html\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<img width=\"250\" height=\"166\" src=\"https://prismaticfestival.com/wp-content/uploads/2022/08/sponsor-logos-03-e1662144841715.png\" alt=\"\" srcset=\"https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2022/08/sponsor-logos-03-e1662144841715.png?w=250&amp;ssl=1 250w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2022/08/sponsor-logos-03-e1662144841715.png?w=162&amp;ssl=1 162w\" sizes=\"(max-width: 250px) 100vw, 250px\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://canadacouncil.ca/\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<img width=\"300\" height=\"200\" src=\"https://prismaticfestival.com/wp-content/uploads/2022/08/sponsor-logos-07.png\" alt=\"\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://www.halifax.ca/parks-recreation/events\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<img width=\"300\" height=\"200\" src=\"https://prismaticfestival.com/wp-content/uploads/2022/08/sponsor-logos-09.png\" alt=\"\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://artsns.ca/\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<img width=\"300\" height=\"200\" src=\"https://prismaticfestival.com/wp-content/uploads/2022/08/sponsor-logos-10.png\" alt=\"\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://www.td.com/about-tdbfg/our-business/index.jsp?mobile=No\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<img width=\"300\" height=\"200\" src=\"https://prismaticfestival.com/wp-content/uploads/2022/08/sponsor-logos-01.png\" alt=\"\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://www.neptunetheatre.com/\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<img src=\"https://prismaticfestival.com/wp-content/uploads/2022/08/sponsor-logos-15.png\" title=\"\" alt=\"\" loading=\"lazy\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://liveartdance.ca/\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<img width=\"300\" height=\"200\" src=\"https://prismaticfestival.com/wp-content/uploads/2022/08/sponsor-logos-17-1.png\" alt=\"\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://www.dal.ca/faculty/arts/school-of-performing-arts.html\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<img width=\"300\" height=\"200\" src=\"https://prismaticfestival.com/wp-content/uploads/2022/08/sponsor-logos-06.png\" alt=\"\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://downtownhalifax.ca/\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<img width=\"300\" height=\"200\" src=\"https://prismaticfestival.com/wp-content/uploads/2022/08/sponsor-logos-11.png\" alt=\"\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://www.marriott.com/en-us/hotels/yhzmc-halifax-marriott-harbourfront-hotel/overview/\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<img width=\"300\" height=\"200\" src=\"https://prismaticfestival.com/wp-content/uploads/2022/08/sponsor-logos-04.png\" alt=\"\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://atlanticpresenters.ca/\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<img src=\"https://prismaticfestival.com/wp-content/uploads/2022/08/sponsor-logos-16.png\" title=\"sponsor-logos-16\" alt=\"sponsor-logos-16\" loading=\"lazy\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://www.artgalleryofnovascotia.ca/\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<img width=\"300\" height=\"200\" src=\"https://prismaticfestival.com/wp-content/uploads/2022/08/sponsor-logos-08.png\" alt=\"\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://developns.ca/\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<img width=\"300\" height=\"200\" src=\"https://prismaticfestival.com/wp-content/uploads/2022/08/sponsor-logos-13.png\" alt=\"\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"http://novacentre.ca/\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<img width=\"300\" height=\"200\" src=\"https://prismaticfestival.com/wp-content/uploads/2022/08/sponsor-logos-05.png\" alt=\"\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://www.thecarleton.ca/\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<img width=\"300\" height=\"200\" src=\"https://prismaticfestival.com/wp-content/uploads/2022/08/sponsor-logos-02.png\" alt=\"\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://www.rogers.com/\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<img width=\"300\" height=\"200\" src=\"https://prismaticfestival.com/wp-content/uploads/2022/08/sponsor-logos-12-12.png\" alt=\"\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://afhalifax.ca/\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<img width=\"300\" height=\"200\" src=\"https://prismaticfestival.com/wp-content/uploads/2022/08/sponsor-logos-14.png\" alt=\"\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://nscad.ca/\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<img width=\"300\" height=\"300\" src=\"https://prismaticfestival.com/wp-content/uploads/2022/08/NSCAD-logo-01-1.png\" alt=\"\" srcset=\"https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2022/08/NSCAD-logo-01-1.png?w=300&amp;ssl=1 300w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2022/08/NSCAD-logo-01-1.png?resize=150%2C150&amp;ssl=1 150w\" sizes=\"(max-width: 300px) 100vw, 300px\" />\t\t\t\t\t\t\t\t</a>"
