    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<h2>2020</h2>\t\t\n\t\t<p style=\"text-align: center;\">September 17 - 20</p>\t\t\n\t\t\t<a href=\"https://prismaticfestival.com/wp-content/uploads/2020/09/Prismatic-Arts-Festival-COVID-19-Waiver-2020-FINAL.pdf\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\tCOVID-19 Waiver\n\t\t\t\t\t</a>\n\t\t<h2 style=\"text-align: center;\">Prismatic Artists </h2>\t\t\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/jahmila-2020/\">\n\t\t\t\t\t\t09/17\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/owen-osound-lee-2020/\">\n\t\t\t\t\t\t09/17\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/liliona-quarmyne-2020/\">\n\t\t\t\t\t\t09/19\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/clyde-a-wray-2020/\">\n\t\t\t\t\t\t09/19\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/dinuk-wijeratne-2020/\">\n\t\t\t\t\t\t09/17\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/jenelle-duval-2020/\">\n\t\t\t\t\t\t09/19\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/eastern-owl-2020/\">\n\t\t\t\t\t\t09/19\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/boca-del-lupo-with-shauntay-grant/\">\n\t\t\t\t\t\t09/19\n\t\t\t\t\t</a>\n\t\t<h2 style=\"text-align: center;\">Prismatic 2020 Program</h2>\t\t\n\t\t\t<a href=\"https://issuu.com/prismaticartsfestival1/docs/prismatic_2020_program\">\n\t\t\t\t\t\tView 2020's Program\n\t\t\t\t\t</a>\n\t\t<h2 style=\"text-align: center;\">Industry Events</h2>\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://prismaticfestival.com/index.php/shifting-verse/\">\n\t\t\t\t\t\t\t<img width=\"1024\" height=\"190\" src=\"https://prismaticfestival.com/wp-content/uploads/2020/08/images-1-03-1024x190.png\" alt=\"Shifting Verse Prismatic Arts Festival 2020\" srcset=\"https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/images-1-03.png?resize=1024%2C190&amp;ssl=1 1024w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/images-1-03.png?resize=300%2C56&amp;ssl=1 300w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/images-1-03.png?resize=768%2C143&amp;ssl=1 768w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/images-1-03.png?resize=1536%2C286&amp;ssl=1 1536w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/images-1-03.png?resize=1120%2C208&amp;ssl=1 1120w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/images-1-03.png?resize=640%2C119&amp;ssl=1 640w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/images-1-03.png?w=1920&amp;ssl=1 1920w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://prismaticfestival.com/index.php/masterclasses/\">\n\t\t\t\t\t\t\t<img width=\"1024\" height=\"236\" src=\"https://prismaticfestival.com/wp-content/uploads/2020/08/images-1-02-1024x236.png\" alt=\"Masterclasses\" srcset=\"https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/images-1-02.png?resize=1024%2C236&amp;ssl=1 1024w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/images-1-02.png?resize=300%2C69&amp;ssl=1 300w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/images-1-02.png?resize=768%2C177&amp;ssl=1 768w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/images-1-02.png?resize=1536%2C354&amp;ssl=1 1536w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/images-1-02.png?resize=1120%2C258&amp;ssl=1 1120w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/images-1-02.png?resize=640%2C148&amp;ssl=1 640w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/images-1-02.png?w=1920&amp;ssl=1 1920w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://prismaticfestival.com/index.php/the-talk-2020/\">\n\t\t\t\t\t\t\t<img width=\"1024\" height=\"271\" src=\"https://prismaticfestival.com/wp-content/uploads/2020/08/images-1-01-1024x271.png\" alt=\"the TALK\" srcset=\"https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/images-1-01.png?resize=1024%2C271&amp;ssl=1 1024w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/images-1-01.png?resize=300%2C80&amp;ssl=1 300w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/images-1-01.png?resize=768%2C204&amp;ssl=1 768w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/images-1-01.png?resize=1536%2C407&amp;ssl=1 1536w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/images-1-01.png?resize=1120%2C297&amp;ssl=1 1120w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/images-1-01.png?resize=640%2C170&amp;ssl=1 640w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/images-1-01.png?w=1920&amp;ssl=1 1920w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://prismaticfestival.com/index.php/open-spaces/\">\n\t\t\t\t\t\t\t<img width=\"1024\" height=\"174\" src=\"https://prismaticfestival.com/wp-content/uploads/2020/08/images-1-04-1024x174.png\" alt=\"Prismatic Arts Festival Open Spaces Program\" srcset=\"https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/images-1-04.png?resize=1024%2C174&amp;ssl=1 1024w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/images-1-04.png?resize=300%2C51&amp;ssl=1 300w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/images-1-04.png?resize=768%2C130&amp;ssl=1 768w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/images-1-04.png?resize=1536%2C261&amp;ssl=1 1536w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/images-1-04.png?resize=1120%2C190&amp;ssl=1 1120w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/images-1-04.png?resize=640%2C109&amp;ssl=1 640w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/images-1-04.png?w=1920&amp;ssl=1 1920w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t<img width=\"1024\" height=\"515\" src=\"https://prismaticfestival.com/wp-content/uploads/2020/08/funders-and-sponsors-2020-1024x515.png\" alt=\"funders and sponsors-2020\" srcset=\"https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/funders-and-sponsors-2020.png?resize=1024%2C515&amp;ssl=1 1024w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/funders-and-sponsors-2020.png?resize=300%2C151&amp;ssl=1 300w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/funders-and-sponsors-2020.png?resize=768%2C386&amp;ssl=1 768w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/funders-and-sponsors-2020.png?resize=1536%2C773&amp;ssl=1 1536w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/funders-and-sponsors-2020.png?resize=1120%2C564&amp;ssl=1 1120w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/funders-and-sponsors-2020.png?resize=640%2C322&amp;ssl=1 640w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/funders-and-sponsors-2020.png?w=1920&amp;ssl=1 1920w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" />"
