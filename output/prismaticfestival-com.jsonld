        "@id": "https://prismaticfestival.com/wp-content/uploads/2025/07/TourCo-Banner-2.0-e1751481991363-300x135.png"
      }
    ],
    "http://schema.org/contentUrl": [
      {
        "@id": "https://prismaticfestival.com/wp-content/uploads/2025/07/TourCo-Banner-2.0-e1751481991363-300x135.png"
