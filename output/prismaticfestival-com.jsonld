    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<img width=\"1024\" height=\"682\" src=\"https://prismaticfestival.com/wp-content/uploads/2020/07/KSF_8378-1024x682.jpg\" alt=\"reeny-smith\" loading=\"lazy\" srcset=\"https://prismaticfestival.com/wp-content/uploads/2020/07/KSF_8378-1024x682.jpg 1024w, https://prismaticfestival.com/wp-content/uploads/2020/07/KSF_8378-300x200.jpg 300w, https://prismaticfestival.com/wp-content/uploads/2020/07/KSF_8378-768x511.jpg 768w, https://prismaticfestival.com/wp-content/uploads/2020/07/KSF_8378-1536x1022.jpg 1536w, https://prismaticfestival.com/wp-content/uploads/2020/07/KSF_8378-2048x1363.jpg 2048w, https://prismaticfestival.com/wp-content/uploads/2020/07/KSF_8378-1120x745.jpg 1120w, https://prismaticfestival.com/wp-content/uploads/2020/07/KSF_8378-640x426.jpg 640w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" />\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t<p>On Stage: </p><p><b>Jr Smith</b>: Drums</p><p><b>Steve Henry:</b> Piano and Keyboard,</p><p><b>Luke Arsenault:</b> Lead Guitar</p><p><b>Dwayne Wade:</b> Bass Guitar</p><p><b>Mahalia Smith:</b> Background Vocals</p><p><b>Micah Smith</b>: Background Vocals</p>\t\t\n\t\t\t\t\t<a href=\"https://www.facebook.com/iamreeny/\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\tFacebook\n\t\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t<a href=\"https://twitter.com/iamREENY\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\tTwitter\n\t\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t<a href=\"https://www.youtube.com/channel/UCs_R9yI2JEH1G2L7ezRImsg\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\tYoutube\n\t\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t<a href=\"https://www.instagram.com/reenysmith/\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\tInstagram\n\t\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t<h3>Reeny Smith</h3>\t\t\t\t\t\t\t\t\t\n\t\t<p><strong>Type of Art:  </strong>Music</p><p><strong>Dates:</strong> Aug 22nd and 24th</p><p><strong>Location</strong>: Alderney Landing - Outdoor Mainstage</p>\t\t\n\t\t<p>Reeny Smith is an award-winning singer/songwriter. Born into a musically inclined family in North Preston, Nova Scotia, Reeny began singing and playing piano at the age of five. Her roots singing in the church laid a solid foundation for a promising career. She has been awarded several notable awards and high-profile performances. Commonly referred to as the Canadian Alicia Keys, Reeny continues to leave her audiences wanting more of her impeccable vocals, original songs, and modern style. Reeny is certainly on her way to becoming a familiar sound in the Canadian and American Music Industry.</p>\t\t\n\t\t\t\t\t\t\tPrevious\n\t\t\t\t\t\t\tNext\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/2014-archive/\" role=\"button\">\n\t\t\t\t\t\tBack to 2014\n\t\t\t\t\t</a>"
      }
