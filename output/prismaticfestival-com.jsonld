  {
    "@id": "_:g4575180",
    "@type": [
      "http://schema.org/ImageObject"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://prismaticfestival.com/wp-content/uploads/2022/07/Copy-of-IMG_1754-e1657561851557.png"
      }
    ],
    "http://schema.org/contentUrl": [
      {
        "@id": "https://prismaticfestival.com/wp-content/uploads/2022/07/Copy-of-IMG_1754-e1657561851557.png"
      }
    ],
