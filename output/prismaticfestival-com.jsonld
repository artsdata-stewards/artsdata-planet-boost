\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                    \n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                        <a href=\"http://halifaxcentrallibrary.ca/\" target=\"_blank\" rel=\"noopener\"><img src=\"https://prismaticfestival.com/wp-content/uploads/2019/07/HPL_Logo_Horizontal_Master.jpg\" alt=\"Halifax Public Libraries\"></a>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                    \n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                        <a href=\"http://musicnovascotia.ca/\" target=\"_blank\" rel=\"noopener\"><img src=\"https://prismaticfestival.com/wp-content/uploads/2019/08/musicNovaScotia_logo.jpg\" alt=\"Music Nova Scotia\"></a>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                    \n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                        <a href=\"https://musicandbeyond.ca/\" target=\"_blank\" rel=\"noopener\"><img src=\"https://prismaticfestival.com/wp-content/uploads/2019/08/musicBeyond_Logo.jpg\" alt=\"Music &amp; Beyone\"></a>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                    \n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                        <a href=\"https://cresco.ca/\" target=\"_blank\" rel=\"noopener\"><img src=\"https://prismaticfestival.com/wp-content/uploads/2019/08/Cresco_logo.jpg\" alt=\"Cresco\"></a>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                    \n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                        <a href=\"http://www.unitedgulf.ca/\"><img src=\"https://prismaticfestival.com/wp-content/uploads/2019/08/unitedGulf_Logo.jpg\" alt=\"United Gulf Developments Limited\"></a>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                    \n                                    <!-- Add Arrows -->"
