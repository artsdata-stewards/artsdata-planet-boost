      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "good-people-bad-things-2014"
      }
    ],
    "http://schema.org/headline": [
      {
        "@language": "en",
        "@value": "Good People Bad Things 2014"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<img width=\"1024\" height=\"682\" src=\"https://prismaticfestival.com/wp-content/uploads/2020/07/good-people-bad-things.jpg\" alt=\"Good People Bad Things\" loading=\"lazy\" srcset=\"https://prismaticfestival.com/wp-content/uploads/2020/07/good-people-bad-things.jpg 1024w, https://prismaticfestival.com/wp-content/uploads/2020/07/good-people-bad-things-300x200.jpg 300w, https://prismaticfestival.com/wp-content/uploads/2020/07/good-people-bad-things-768x512.jpg 768w, https://prismaticfestival.com/wp-content/uploads/2020/07/good-people-bad-things-640x426.jpg 640w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" />\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t<p>Written and Performed by <strong>Daniel Thau-Eleff</strong></p><p>Direction and Dramaturgy by <strong>Chris Gerrard-Pinker</strong></p><p>With Assistance from <strong>Arne MacPherson</strong></p><p>Media Design by <strong>Steven Hunnie</strong></p>\t\t\n\t\t\t\t\t\t\t\t\t\t\t<h3>Daniel     Thau-Eleff\nGood&nbsp;People Bad Things</h3>\t\t\t\t\t\t\t\t\t\n\t\t<p><strong>Type of Art</strong>: Monologue</p><p><strong>Dates</strong>: Aug 22nd  @ 6 pm</p><p>    Aug 24th @ 4:30 pm</p><p><strong>Location:</strong> Alderney Landing Theatre</p>\t\t\n\t\t<p>In this personal-political monologue, playwright and activist Daniel Thau-Eleff wrestles with the question of evil: Adolf Eichmann and the Nazis, the Israeli/Palestinian conflict and a couple whose relationship becomes abusive. Why do good people do bad things?</p><p>Good People Bad Things has been presented in SummerWorks, Canada’s largest juried arts festival, in Impact (Kitchener/Waterloo), in the Winnipeg Fringe and in Vancouver and Charlottetown.</p>\t\t\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/2014-archive/\" role=\"button\">\n\t\t\t\t\t\tBack to 2014\n\t\t\t\t\t</a>"
      }
    ],
