    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<h1>Plan Your Prismatic</h1>\t\t\n\t\t<p>Schedule</p><p><em> </em></p><p><em>Download PDF version  - </em><em><a href=\"https://prismaticfestival.com/wp-content/uploads/2019/08/Prismatic-2019-Rack-Card-for-website.pdf\">Prismatic 2019 Schedule</a></em></p><p><em>Download PDF version  - <a href=\"https://prismaticfestival.com/wp-content/uploads/2019/09/Prismatic-2019-Program-WEB-1.pdf\">Prismatic 2019 Program</a></em></p>\t\t\n                                <form id=\"wpforms-form-3963\" data-formid=\"3963\" method=\"post\" enctype=\"multipart/form-data\" action=\"/wp-admin/admin-ajax.php\" data-token=\"604f0493c151f939aac4e926a8e58d88\">Jah&#039;mila and Owen O&#039;Sound Lee  at the Carleton<noscript>Please enable JavaScript in your browser to complete this form.</noscript><label for=\"wpforms-3963-field_3\">Name *</label><input type=\"text\" id=\"wpforms-3963-field_3\" name=\"wpforms[fields][3][first]\" required><label for=\"wpforms-3963-field_3\">First</label><input type=\"text\" id=\"wpforms-3963-field_3-last\" name=\"wpforms[fields][3][last]\" required><label for=\"wpforms-3963-field_3-last\">Last</label><label for=\"wpforms-3963-field_5\">Email *</label><input type=\"email\" id=\"wpforms-3963-field_5\" name=\"wpforms[fields][5]\" required><label for=\"wpforms-3963-field_6\">Phone Number *</label><input type=\"text\" id=\"wpforms-3963-field_6\" name=\"wpforms[fields][6]\" required><label for=\"wpforms-3963-field_9\">Names of all members of the party *</label><input type=\"text\" id=\"wpforms-3963-field_9\" name=\"wpforms[fields][9]\" required>First and Last<label for=\"wpforms-3963-field_12\">Number of General Admission Tickets  *</label><select id=\"wpforms-3963-field_12\" name=\"wpforms[fields][12]\" required=\"required\"><option value=\"1\" >1</option><option value=\"2\" >2</option><option value=\"3\" >3</option><option value=\"4\" >4</option><option value=\"5\" >5</option><option value=\"6\" >6</option><option value=\"7\" >7</option><option value=\"8\" >8</option><option value=\"9\" >9</option><option value=\"10\" >10</option><option value=\"0\" >0</option></select>General Admission: $20+tax<label for=\"wpforms-3963-field_13\">Number of Student/Senior/Underwaged *</label><select id=\"wpforms-3963-field_13\" name=\"wpforms[fields][13]\" required=\"required\"><option value=\"1\" >1</option><option value=\"2\" >2</option><option value=\"3\" >3</option><option value=\"4\" >4</option><option value=\"5\" >5</option><option value=\"6\" >6</option><option value=\"7\" >7</option><option value=\"8\" >8</option><option value=\"9\" >9</option><option value=\"10\" >10</option><option value=\"0\" >0</option></select>Student: $10+tax<label for=\"wpforms-3963-field_8\">Has anyone in your party been outside of the Maritime bubble in the last 14 days? *</label><ul id=\"wpforms-3963-field_8\"><li><input type=\"checkbox\" id=\"wpforms-3963-field_8_1\" name=\"wpforms[fields][8][]\" value=\"Yes\" required ><label for=\"wpforms-3963-field_8_1\">Yes</label></li><li><input type=\"checkbox\" id=\"wpforms-3963-field_8_2\" name=\"wpforms[fields][8][]\" value=\"No\" required ><label for=\"wpforms-3963-field_8_2\">No</label></li></ul><input type=\"hidden\" name=\"wpforms[id]\" value=\"3963\"><input type=\"hidden\" name=\"wpforms[author]\" value=\"2\"><button type=\"submit\" name=\"wpforms[submit]\" id=\"wpforms-submit-3963\" value=\"wpforms-submit\" aria-live=\"assertive\" data-alt-text=\"Sending...\" data-submit-text=\"Submit\">Submit</button></form>  <!-- .wpforms-container -->            \n\t\t\t<h1>Ottawa</h1>\t\t\n                September 12 to 22<p><h4><b>September 12 to 22</b></h4><p><b>Oreo</b> by Rah-Eleh</p><p><i>(Artist Talkback on September 17th @5:30pm)</i></p><p><b>GCTC-Gallery</b></p></p>\n                Sunday, September 15th<p><p><b>5:00pm</b></p><p><b>Multiple Performances</b></p><p><b>Ottawa Opening Gala</b></p><p><b>GCTC-Lobby</b></p><p> </p><p><b>7:00pm</b></p><p><b>Mozongi</b> by Nyata Nyata (Artist Talkback)</p><p><b>Gladstone Theatre</b></p><p><b>CBC Special</b> by Cliff Cardinal</p><p><b>GCTC-Studio</b></p><p> </p><p><b>8:00pm</b></p><p><b>Opening Act-Spoken Word</b> by Zoey Roy</p><p><b>Blood Water Earth</b> by Kaha:wi Dance Theatre</p><p><i>(Artist Talkback)</i></p><p><b>GCTC - Mainstage</b></p><p> </p><p><b>10:00pm</b></p><p><b>Broken English Karaoke</b> by Stephanie Yee</p><p><b>GCTC - Lobby</b></p></p>\n                Monday, September 16th<p><p><b>4:30pm</b></p><p><b>Neither Wolf Nor Dog Film Screening</b></p><p><b>Bytowne Cinema</b></p><p> </p><p><b>5:30pm</b></p><p><b>CBC Special</b> by Cliff Cardinal</p><p><b>GCTC - Studio</b></p><p> </p><p><b>6:00pm</b></p><p><b>Asheq </b>by Onelight Theatre</p><p><b>Nouvelle Scene - Studio B</b></p><p> </p><p><b>6:30pm</b></p><p><b>Occupy Chinatown </b>by Paul Wong (Video Screening &amp; Artist Talk)</p><p><b>SAW Gallery</b></p><p> </p><p><b>7:00pm</b></p><p><b>Opening Act - Spoken Word</b> by Zoey Roy</p><p><b>Blood Water Earth</b> by Kaha:wi Dance Theatre</p><p><b>GCTC - Mainstage</b></p><p> </p><p><b>8:00pm</b></p><p><b>Mozongi </b>by Nyata Nyata</p><p><b>Gladstone Theatre</b></p><p> </p><p><b>9:00pm</b></p><p><b>Concert</b> by Sina Bathaie &amp; Jacques Mindreau</p><p><b>Arts Court Studio</b></p><p> </p><p><b>10:00pm</b></p><p><b>Broken English Karaoke</b> by Stephanie Yee</p><p><b>Arts Court Studio</b></p></p>\n                Tuesday, September 17th<p><p><b>4:30pm</b></p><p><b>Ocatvio is dead! Film SCreening</b></p><p><b>Bytowne Cinema</b></p><p> </p><p><b>7:00pm</b></p><p><b>Asheq </b>by Onelight Theatre</p><p><b>Nouvelle Scene - Studio B</b></p><p> </p><p><b>8:00pm</b></p><p><b>CBC Special</b> by Cliff Cardinal</p><p><b>GCTC - Studio</b></p><p> </p><p><b>8:30pm</b></p><p><b>Zayo</b> by Esie Mensah Creations</p><p><b>Nouvelle Scene - Studio A</b></p><p> </p><p><b>9:00pm</b></p><p><b>Concert</b> by Ensemble Kamaan &amp;</p><p>Digging Roots</p><p><b>Arts Court Studio</b></p><p> </p><p><b>10:30pm</b></p><p><b>Broken English Karaoke</b> by Stephanie Yee</p><p><b>Arts Court Studio</b></p></p>\n                Wednesday, September 18th<p><p><b>6:00pm</b></p><p><b>The Living Archives</b> by The Tashme Project</p><p><b>GCTC - Mainstage </b></p><p> </p><p><b>7:00pm</b></p><p><b>Zayo</b> by Esie Mensah Creations</p><p><b>Nouvelle Scene - Studio A</b></p><p> </p><p><b>7:45pm</b></p><p><b>Asheq </b>by Onelight Theatre</p><p><b>Nouvelle Scene - Studio B</b></p><p> </p><p><b>8:30pm</b></p><p><b>CBC Special</b> by Cliff Cardinal</p><p><b>GCTC - Studio</b></p><p> </p><p><b>9:00pm</b></p><p><b>Concert</b> by Quantum Tangle &amp;</p><p>Battle of Santiago</p><p><b>Arts Court Studio</b></p><p><b>Foxconn Frequency (no.3)</b> by Hong Kong Exile</p><p><b>Gladstone Theatre</b></p><p> </p><p><b>10:30pm</b></p><p><b>Broken English Karaoke </b>by Stephanie Yee</p><p><b>Arts Court Studio</b></p></p>\n                Thursday, September 19th<p><p><b>6:00pm</b></p><p><b>The Living Archives</b> by The Tashme Project</p><p><i>(Artist Talkback)</i></p><p><b>GCTC - Mainstage</b></p><p> </p><p><b>7:30pm</b></p><p>Concert by Constantinople</p><p><b>Allsaints events space </b></p><p> </p><p><b>8:00pm</b></p><p><b>Asheq </b>by Onelight Theatre</p><p><b>Nouvelle Scene - Studio  B</b></p><p> </p><p><b>9:00pm</b></p><p><b>Concert</b> by Rebecca Thomas,</p><p>Diyet &amp; the Love Soldiers &amp;</p><p>NAMU</p><p><b>Arts Court Studio</b></p><p><b>Foxconn Frequency (no.3)</b> by Hong Kong Exile</p><p><b>Gladstone Theatre</b></p><p> </p><p><b>10:30pm</b></p><p><b>Broken English Karaoke</b> by Stephanie Yee</p><p><b>Arts Court Studio</b></p></p>\n                Friday, September 20th<p><p><b>6:00pm</b></p><p><b>Short Films Screening</b></p><p><b>Arts Court Theatre</b></p><p> </p><p><b>7:00pm</b></p><p><b>The Living Archives</b> by The Tashme Project</p><p><i>(Artist Talkback)</i></p><p><b>GCTC - Mainstage</b></p><p> </p><p><b>9:00pm</b></p><p><b>Foxconn Frequency (no.3)</b> by Hong Kong Exile</p><p><b>Gladstone Theatre</b></p><p> </p><p><b>10:00pm</b></p><p><b>Broken English Karaoke</b> by Stephanie Yee</p><p><b>Arts Court Studio</b></p></p>\n                Saturday, September 21st<p><p><b>8:00pm</b></p><p><b>The Living Archives</b> by The Tashme Project</p><p><i>(Artist Talkback)</i></p><p><b>GCTC - Mainstage</b></p><p> </p><p><b>10:00pm</b></p><p><b>Broken English Karaoke</b> by Stephanie Yee</p><p><b>GCTC - Lobby</b></p></p>\n                Sunday, September 22nd<p><p><b>4:00pm</b></p><p><b>The Living Archives</b> by The Tashme Project</p><p><i>(Artist Talkback)</i></p><p><b>GCTC - Mainstage</b></p></p>\n\t\t\t<h1>Halifax</h1>\t\t\n                Tuesday, September 10th<p><p><b>6:30pm</b></p><p><b>Concert</b> by Dinuk Wijeratne (opening act Son Latino)</p><p><b>Halifax Central Library</b></p></p>\n                Friday, September 20th<p><p><b>7:00pm</b></p><p><b>Focus Cia De Danca</b> <br />(co-presentation with Live Art Dance)</p><p><b>Dunn Theatre </b></p><p><b>(Dalhousie Arts Centre)</b></p></p>\n                Saturday, September 21st<p><p><b>7:00pm</b></p><p><b>Focus Cia De Danca</b> <br />(co-presentation with Live Art Dance)</p><p><b>Dunn Theatre </b></p><p><b>(Dalhousie Arts Centre)</b></p></p>\n                Monday, September 23rd<p><p><b>7:00pm</b></p><p>NAMU</p><p><b>Halifax Central Library</b></p></p>\n\t\t<p>Tickets</p>\t\t\n\t\t\t<h1>Ottawa</h1>\t\t\n\t\t<h2 style=\"text-align: center;\"><u>Tickets ON SALE!</u></h2><p><strong>Single tickets and passes for all performances in Ottawa are being sold through our presenting partner Great Canadian Theatre Company </strong><em>(GCTC)</em><strong>:</strong>  </p><h4><strong>Buy tickets online</strong> <strong><a href=\"https://www.gctc.ca/shows/prismatic2019\" target=\"_blank\" rel=\"noopener noreferrer\">here</a></strong></h4><p><b>Please Note</b>: On the GCTC box office website, please use the promo code <strong>“prismatic”</strong> to waive the $5 online booking charge. <em>(This charge is per transaction).</em></p><h4><strong>Buy tickets by phone:</strong></h4><p>613-236-5196                  </p><h4><strong>Buy tickets in person: </strong></h4><p>300-1227 Wellington Street W., Ottawa</p><h4><strong>Summer Hours of Operation:</strong> </h4><p><strong>Tuesday - Thursday</strong> 11am-5pm          <strong>Frida</strong>y 11am-2:30pm         <strong>Saturday</strong> 12pm-4pm     <strong>Sunday &amp; Monday</strong> Closed</p><h2> </h2><h2 style=\"text-align: center;\"><u>Tickets at the Door</u></h2><p><strong>Tickets will be available for purchase at the door for events. We will be accepting cash or credit cards. Please be sure to allow a few extra minutes to purchase your ticket.</strong></p><h2> </h2><h2 style=\"text-align: center;\"><u>Passes:</u> </h2><ul><li><strong><a href=\"https://www.gctc.ca/passes-prismatic\" target=\"_blank\" rel=\"noopener noreferrer\">Festival Pass</a></strong> – all arts events and film screenings </li><li><strong><a href=\"https://www.gctc.ca/tickets-prismatic-talk-series\" target=\"_blank\" rel=\"noopener noreferrer\">The TALK 5-day Pass</a></strong> - access to all 2019 TALK sessions</li><li> <a href=\"https://www.gctc.ca/tickets-prismatic-talk-series\" target=\"_blank\" rel=\"noopener noreferrer\"><strong>The TALK</strong></a> <i>- individual day pass to TALK sessions</i></li><li><strong><a href=\"https://www.gctc.ca/passes-prismatic\" target=\"_blank\" rel=\"noopener noreferrer\">Industry Pass</a> </strong>– all arts events, film screenings, participation inTALK, registration for showcases/pitch sessions and networking events (only available to presenters)</li></ul><p><strong>When buying your pass, you will be prompted to create an account on the GCTC website. Creating this account (with the email used to purchase the pass) will give you full access to reserve a spot at the various events associated with your pass.</strong></p><p><strong> You can also get tickets at the door at performances</strong> – <em>subject to availability</em>. </p><h4><strong>Passholders who have questions about using the promo code to reserve tickets can contact: </strong></h4><p><strong>Catherine Ballachey,</strong> <a href=\"mailto:foh@gctc.ca\">foh@gctc.ca</a>, 613-236-5192 ext. </p>\t\t\n\t\t\t<h1>Halifax</h1>\t\t\n\t\t<h2 style=\"text-align: center;\"><u>Tickets ON SALE!</u></h2><p style=\"text-align: right;\"><b>Purchase tickets for the Halifax Performance below.</b></p><h4 style=\"text-align: right;\"><strong>Dinuk Wijeratne <a href=\"https://prismatic.tickethalifax.com/events/97448602/dinuk-wijeratne-diomira\" target=\"_blank\" rel=\"noopener noreferrer\">here</a></strong></h4><h4 style=\"text-align: right;\"><strong>Namu <a href=\"https://prismatic.tickethalifax.com/events/97448854/namu\" target=\"_blank\" rel=\"noopener noreferrer\">here</a></strong></h4><h4 style=\"text-align: right;\"><strong>Focus de Cia </strong><a href=\"https://ots.sumacpages.com/sumac/sumac_start_new_session.php?package=ticketing2&amp;userfolder=../ORG/liveartproductionsociety\" target=\"_blank\" rel=\"noopener noreferrer\"><strong>here</strong></a></h4>\t\t\n\t\t<p>Venues</p>\t\t\n\t\t\t<h1>Ottawa</h1>\t\t\n\t\t<p><a href=\"https://prismaticfestival.com/index.php/accessibility/\"><strong>INFORMATION ON VENUE ACCESSIBILITY</strong></a></p>\t\t\n\t\t\t\t\t\t\t\t\t\t<img width=\"1024\" height=\"682\" src=\"https://prismaticfestival.com/wp-content/uploads/2019/07/aTheatre21_JustinSamanski_WEB-1280x853-1024x682.jpg\" alt=\"GCTC\" loading=\"lazy\" srcset=\"https://prismaticfestival.com/wp-content/uploads/2019/07/aTheatre21_JustinSamanski_WEB-1280x853-1024x682.jpg 1024w, https://prismaticfestival.com/wp-content/uploads/2019/07/aTheatre21_JustinSamanski_WEB-1280x853-300x200.jpg 300w, https://prismaticfestival.com/wp-content/uploads/2019/07/aTheatre21_JustinSamanski_WEB-1280x853-768x512.jpg 768w, https://prismaticfestival.com/wp-content/uploads/2019/07/aTheatre21_JustinSamanski_WEB-1280x853-1120x746.jpg 1120w, https://prismaticfestival.com/wp-content/uploads/2019/07/aTheatre21_JustinSamanski_WEB-1280x853-640x427.jpg 640w, https://prismaticfestival.com/wp-content/uploads/2019/07/aTheatre21_JustinSamanski_WEB-1280x853.jpg 1280w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" />\t\t\t\t\t\t\t\t\t\t\t\n\t\t<p><a href=\"https://www.gctc.ca/visit-us\" target=\"_blank\" rel=\"noopener noreferrer\"><strong>Great Canadian Theatre Company (Irving Greenberg Theatre Centre) </strong></a></p><p><strong>Mainstage and Studio</strong><br />1233 Wellington Street West, Ottawa<br /><a href=\"tel:6132365196\">613-236-5196</a></p><p><strong><a href=\"https://prismaticfestival.com/index.php/accessibility/\" target=\"_blank\" rel=\"noopener noreferrer\">ACCESSIBILITY</a></strong></p>\t\t\n\t\t\t<iframe src=\"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2801.461044680731!2d-75.733925449488!3d45.40004174564171!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4cce043d6dec0b53%3A0x7b42b9eae92e9c17!2s1233+Wellington+St+W%2C+Ottawa%2C+ON+K1Y+0G7%2C+Canada!5e0!3m2!1sen!2sus!4v1563385789775!5m2!1sen!2sus\" width=\"600\" height=\"450\" frameborder=\"0\" style=\"border:0\" allowfullscreen></iframe>\n\t\t\t\t\t\t\t\t\t\t<img width=\"1024\" height=\"683\" src=\"https://prismaticfestival.com/wp-content/uploads/2019/07/Black-Box-Studio1-Pat-Bolduc-1024x683.jpg\" alt=\"Arts Court Theatre\" loading=\"lazy\" srcset=\"https://prismaticfestival.com/wp-content/uploads/2019/07/Black-Box-Studio1-Pat-Bolduc-1024x683.jpg 1024w, https://prismaticfestival.com/wp-content/uploads/2019/07/Black-Box-Studio1-Pat-Bolduc-300x200.jpg 300w, https://prismaticfestival.com/wp-content/uploads/2019/07/Black-Box-Studio1-Pat-Bolduc-768x512.jpg 768w, https://prismaticfestival.com/wp-content/uploads/2019/07/Black-Box-Studio1-Pat-Bolduc-1120x747.jpg 1120w, https://prismaticfestival.com/wp-content/uploads/2019/07/Black-Box-Studio1-Pat-Bolduc-640x427.jpg 640w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" />\t\t\t\t\t\t\t\t\t\t\t\n\t\t<p><strong><a href=\"https://artscourt.ca/plan-your-visit/\" target=\"_blank\" rel=\"noopener noreferrer\">Art Court</a></strong></p><p><strong>Theatre and Studio</strong><br />2 Daly Avenue,<br />Ottawa  (corner of Daly Ave. and Nicholas St.)<br /><a href=\"tel:6135647240\">613-564-7240</a></p><p><strong><a href=\"https://prismaticfestival.com/index.php/accessibility/\" target=\"_blank\" rel=\"noopener noreferrer\">ACCESSIBILITY</a></strong></p>\t\t\n\t\t\t<iframe src=\"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2800.2019991207526!2d-75.69085744948703!3d45.425429243949104!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4cce05014f3e159f%3A0xd9fde41f1b82db4d!2s2+Daly+Ave%2C+Ottawa%2C+ON+K1N+7B9%2C+Canada!5e0!3m2!1sen!2sus!4v1563424549948!5m2!1sen!2sus\" width=\"600\" height=\"450\" frameborder=\"0\" style=\"border:0\" allowfullscreen></iframe>\t\t\n\t\t\t\t\t\t\t\t\t\t<img width=\"612\" height=\"408\" src=\"https://prismaticfestival.com/wp-content/uploads/2019/07/Gladstone-seats-612x408.jpg\" alt=\"Gladstone Theatre\" loading=\"lazy\" srcset=\"https://prismaticfestival.com/wp-content/uploads/2019/07/Gladstone-seats-612x408.jpg 612w, https://prismaticfestival.com/wp-content/uploads/2019/07/Gladstone-seats-612x408-300x200.jpg 300w\" sizes=\"(max-width: 612px) 100vw, 612px\" />\t\t\t\t\t\t\t\t\t\t\t\n\t\t<p><strong><a href=\"https://www.thegladstone.ca/about\" target=\"_blank\" rel=\"noopener noreferrer\">Gladstone Theatre</a></strong></p><p>910 Gladstone Avenue, Ottawa<br><a href=\"tel:6132334523\">613-233-4523</a></p>\n<p><strong><a href=\"https://prismaticfestival.com/index.php/accessibility/\" target=\"_blank\" rel=\"noopener noreferrer\">ACCESSIBILITY</a></strong></p>\t\t\n\t\t\t<iframe src=\"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2801.250966741478!2d-75.71456254948787!3d45.404278545359226!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4cce04360d888a79%3A0x68eea0f379cabdc7!2s910+Gladstone+Ave%2C+Ottawa%2C+ON+K1R+6Y4%2C+Canada!5e0!3m2!1sen!2sus!4v1563425022741!5m2!1sen!2sus\" width=\"600\" height=\"450\" frameborder=\"0\" style=\"border:0\" allowfullscreen></iframe>\t\t\n\t\t\t\t\t\t\t\t\t\t<img width=\"1024\" height=\"684\" src=\"https://prismaticfestival.com/wp-content/uploads/2019/07/nouvelle-scène-1024x684.jpg\" alt=\"La Nouvelle Scene Gilles Desjardins\" loading=\"lazy\" srcset=\"https://prismaticfestival.com/wp-content/uploads/2019/07/nouvelle-scène-1024x684.jpg 1024w, https://prismaticfestival.com/wp-content/uploads/2019/07/nouvelle-scène-300x200.jpg 300w, https://prismaticfestival.com/wp-content/uploads/2019/07/nouvelle-scène-768x513.jpg 768w, https://prismaticfestival.com/wp-content/uploads/2019/07/nouvelle-scène-1120x748.jpg 1120w, https://prismaticfestival.com/wp-content/uploads/2019/07/nouvelle-scène-640x427.jpg 640w, https://prismaticfestival.com/wp-content/uploads/2019/07/nouvelle-scène.jpg 1200w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" />\t\t\t\t\t\t\t\t\t\t\t\n\t\t<p><strong><a href=\"https://www.nouvellescene.com/contactez-nous/\" target=\"_blank\" rel=\"noopener noreferrer\">La Nouvelle Scene Gilles Desjardins</a></strong></p><p><strong>Studio A and Studio B</strong><br />333 King Edward Avenue, Ottawa<br /><a href=\"tel:6132412727\">(613) 241-2727</a></p><p><strong><a href=\"https://prismaticfestival.com/index.php/accessibility/\" target=\"_blank\" rel=\"noopener noreferrer\">ACCESSIBILITY</a></strong></p>\t\t\n\t\t\t<iframe src=\"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2799.9615984024517!2d-75.68890684948684!3d45.43027544362591!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4cce05034f32b1bb%3A0x3efd9d0b0be06e78!2s333+King+Edward+Ave%2C+Ottawa%2C+ON+K1N+7M5%2C+Canada!5e0!3m2!1sen!2sus!4v1563425333424!5m2!1sen!2sus\" width=\"600\" height=\"450\" frameborder=\"0\" style=\"border:0\" allowfullscreen></iframe>\t\t\n\t\t\t\t\t\t\t\t\t\t<img width=\"1024\" height=\"683\" src=\"https://prismaticfestival.com/wp-content/uploads/2019/07/6977832205_870cf9b44b_b-1024x683.jpg\" alt=\"Bytowne Cinema\" loading=\"lazy\" srcset=\"https://prismaticfestival.com/wp-content/uploads/2019/07/6977832205_870cf9b44b_b.jpg 1024w, https://prismaticfestival.com/wp-content/uploads/2019/07/6977832205_870cf9b44b_b-300x200.jpg 300w, https://prismaticfestival.com/wp-content/uploads/2019/07/6977832205_870cf9b44b_b-768x512.jpg 768w, https://prismaticfestival.com/wp-content/uploads/2019/07/6977832205_870cf9b44b_b-640x427.jpg 640w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" />\t\t\t\t\t\t\t\t\t\t\t\n\t\t<p><strong><a href=\"https://www.bytowne.ca/getting-to-the-bytowne\" target=\"_blank\" rel=\"noopener noreferrer\">Bytowne Cinema</a><br /></strong>325 Rideau Street, Ottawa<br /><a href=\"tel:6137893456\">613-789-3456</a></p><p><strong><a href=\"https://prismaticfestival.com/index.php/accessibility/\" target=\"_blank\" rel=\"noopener noreferrer\">ACCESSIBILITY</a></strong></p>\t\t\n\t\t\t<iframe src=\"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2799.9956293527057!2d-75.6869751494869!3d45.4295894436716!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4cce0504bc8b79d9%3A0xd805331b69822493!2s325+Rideau+St%2C+Ottawa%2C+ON+K1N+5Y4%2C+Canada!5e0!3m2!1sen!2sus!4v1563425770907!5m2!1sen!2sus\" width=\"600\" height=\"450\" frameborder=\"0\" style=\"border:0\" allowfullscreen></iframe>\t\t\n\t\t\t<h1>Halifax</h1>\t\t\n\t\t\t\t\t\t\t\t\t\t<img width=\"1024\" height=\"648\" src=\"https://prismaticfestival.com/wp-content/uploads/2019/07/jay-baruchel-IMG_4608-1024x648.jpg\" alt=\"Halifax Central Library – Paul O’Regan Hall\" loading=\"lazy\" srcset=\"https://prismaticfestival.com/wp-content/uploads/2019/07/jay-baruchel-IMG_4608-1024x648.jpg 1024w, https://prismaticfestival.com/wp-content/uploads/2019/07/jay-baruchel-IMG_4608-300x190.jpg 300w, https://prismaticfestival.com/wp-content/uploads/2019/07/jay-baruchel-IMG_4608-768x486.jpg 768w, https://prismaticfestival.com/wp-content/uploads/2019/07/jay-baruchel-IMG_4608-1120x709.jpg 1120w, https://prismaticfestival.com/wp-content/uploads/2019/07/jay-baruchel-IMG_4608-640x405.jpg 640w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" />\t\t\t\t\t\t\t\t\t\t\t\n\t\t<p><strong><a href=\"https://www.halifaxpubliclibraries.ca/locations/sga/\" target=\"_blank\" rel=\"noopener noreferrer\">Halifax Central Library – Paul O’Regan Hall</a><br /></strong>5440 Spring Garden Road, Halifax<br /><a href=\"tel:9024905700\">902-490-5700</a></p><p><strong><a href=\"https://prismaticfestival.com/index.php/accessibility/\" target=\"_blank\" rel=\"noopener noreferrer\">ACCESSIBILITY</a></strong></p>\t\t\n\t\t\t<iframe src=\"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2838.7490329839316!2d-63.57769134951767!3d44.64304609577611!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4b5a223391907ad3%3A0x4ee789c7cb18a6eb!2s5440+Spring+Garden+Rd%2C+Halifax%2C+NS+B3J+1E9%2C+Canada!5e0!3m2!1sen!2sus!4v1563426053301!5m2!1sen!2sus\" width=\"600\" height=\"450\" frameborder=\"0\" style=\"border:0\" allowfullscreen></iframe>\n\t\t\t\t\t\t\t\t\t\t<img width=\"579\" height=\"270\" src=\"https://prismaticfestival.com/wp-content/uploads/2019/07/1368107961801.jpg\" alt=\"Dalhousie Arts Centre – Sir James Dunn Theatre\" loading=\"lazy\" srcset=\"https://prismaticfestival.com/wp-content/uploads/2019/07/1368107961801.jpg 579w, https://prismaticfestival.com/wp-content/uploads/2019/07/1368107961801-300x140.jpg 300w\" sizes=\"(max-width: 579px) 100vw, 579px\" />\t\t\t\t\t\t\t\t\t\t\t\n\t\t<p><strong><a href=\"https://www.dal.ca/faculty/arts/school-of-performing-arts/about/facilities.html\" target=\"_blank\" rel=\"noopener noreferrer\">Dalhousie Arts Centre – Sir James Dunn Theatre</a><br /></strong>6101 University Avenue, Halifax<br /><a href=\"tel:9024943772\">902-494-3772</a></p><p><a href=\"https://prismaticfestival.com/index.php/accessibility/\" target=\"_blank\" rel=\"noopener noreferrer\"><strong>ACCESSIBILITY</strong></a></p>\t\t\n\t\t\t<iframe src=\"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2838.99833513734!2d-63.59082084951788!3d44.637950996111336!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4b5a22252ffc56a5%3A0x124647d5f9654b70!2sArts+Centre%2C+6101+University+Ave%2C+Halifax%2C+NS+B3H+1W8%2C+Canada!5e0!3m2!1sen!2sus!4v1563426330939!5m2!1sen!2sus\" width=\"600\" height=\"450\" frameborder=\"0\" style=\"border:0\" allowfullscreen></iframe>\t\t\n\t\t<p>Hotel</p><h2 style=\"text-align: center;\">Prismatic is proud to partner with Les Suites Hotel to provide beautiful rooms to our Prismatic artists and guests.</h2><p><a href=\"https://www.les-suites.com\" target=\"_blank\" rel=\"noopener noreferrer\"><strong>Les Suites Hotel</strong></a><br />130 Bresser Street, Ottawa<br />613-232-2000</p><p>Book your room using the  Prismatic room rate: <strong>$249</strong> for one bedroom suite<em> (up to 4 guests)</em> and <strong>$349</strong> for two bedroom suite  <em>(up to 6 guests) <strong>(30% discount.)</strong></em></p><p>When you stay at Les Suites Hotel Ottawa, you have the best of everything — spacious comfort, a great location, and impeccable service. For the same price as a regular hotel room, you can relax in a condominium-sized suite with separate living and sleeping areas, a fully equipped kitchen, washer and dryer, and private balcony.</p><p><strong>For more information and to book your suite:</strong> <a href=\"https://www.les-suites.com/\" target=\"_blank\" rel=\"noopener noreferrer\">https://www.les-suites.com</a></p><p><strong> </strong></p>\t\t\n\t\t\t\t\t\t\t\t\t\t<img width=\"1024\" height=\"30\" src=\"https://prismaticfestival.com/wp-content/uploads/2019/07/Thanks-sponsors-1024x30.jpg\" alt=\"Thanks to our Sponsors and Funders\" loading=\"lazy\" srcset=\"https://prismaticfestival.com/wp-content/uploads/2019/07/Thanks-sponsors-1024x30.jpg 1024w, https://prismaticfestival.com/wp-content/uploads/2019/07/Thanks-sponsors-300x9.jpg 300w, https://prismaticfestival.com/wp-content/uploads/2019/07/Thanks-sponsors-768x22.jpg 768w, https://prismaticfestival.com/wp-content/uploads/2019/07/Thanks-sponsors-1120x33.jpg 1120w, https://prismaticfestival.com/wp-content/uploads/2019/07/Thanks-sponsors-640x19.jpg 640w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" />\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                        <a href=\"https://www.gctc.ca/\" target=\"_blank\" rel=\"noopener noreferrer\"><img src=\"https://prismaticfestival.com/wp-content/uploads/2019/07/GCTC-1.jpg\" alt=\"Great Canadian Theatre Company\"></a>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                    \n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                        <a href=\"https://www.canada.ca/en/canadian-heritage.html\" target=\"_blank\" rel=\"noopener noreferrer\"><img src=\"https://prismaticfestival.com/wp-content/uploads/2019/07/Canada-wordmark.jpg\" alt=\"Canada\"></a>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                    \n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                        <a href=\"http://www.arts.on.ca/\" target=\"_blank\" rel=\"noopener noreferrer\"><img src=\"https://prismaticfestival.com/wp-content/uploads/2019/07/oac.jpg\" alt=\"Ontario Arts Council\"></a>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                    \n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                        <a href=\"https://canadacouncil.ca/\" target=\"_blank\" rel=\"noopener noreferrer\"><img src=\"https://prismaticfestival.com/wp-content/uploads/2019/07/canada-council.jpg\" alt=\"Canada Council for the Arts\"></a>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                    \n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                        <a href=\"https://cch.novascotia.ca/\" target=\"_blank\" rel=\"noopener noreferrer\"><img src=\"https://prismaticfestival.com/wp-content/uploads/2019/07/novascotia.jpg\" alt=\"Nova Scotia\"></a>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                    \n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                        <a href=\"https://www.halifax.ca/recreation/arts-culture-heritage/opportunities-artists-halifax\" target=\"_blank\" rel=\"noopener noreferrer\"><img src=\"https://prismaticfestival.com/wp-content/uploads/2019/07/halifax.jpg\" alt=\"Halifax\"></a>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                    \n                                    <!-- Add Arrows -->\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                        <a href=\"https://www.factor.ca/\" target=\"_blank\" rel=\"noopener noreferrer\"><img src=\"https://prismaticfestival.com/wp-content/uploads/2019/08/factor_logo.jpg\" alt=\"Factor\"></a>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                    \n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                        <a href=\"https://www.les-suites.com/\" target=\"_blank\" rel=\"noopener noreferrer\"><img src=\"https://prismaticfestival.com/wp-content/uploads/2019/08/Les-Suites_Logo.jpg\" alt=\"Les Suites Hotel Ottawa\"></a>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                    \n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                        <a href=\"http://eng.gokams.or.kr/\" target=\"_blank\" rel=\"noopener noreferrer\"><img src=\"https://prismaticfestival.com/wp-content/uploads/2019/08/korea-arts_logo.jpg\" alt=\"Halifax\"></a>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                    \n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                        <a href=\"https://liveartdance.ca/\" target=\"_blank\" rel=\"noopener noreferrer\"><img src=\"https://prismaticfestival.com/wp-content/uploads/2019/07/Live-Art-Dance.jpg\" alt=\"Live Art Dance\"></a>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                    \n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                        <a href=\"https://ontariopresents.ca/\" target=\"_blank\" rel=\"noopener noreferrer\"><img src=\"https://prismaticfestival.com/wp-content/uploads/2019/08/ontario-presents_logo.jpg\" alt=\"Ontario Presents\"></a>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                    \n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                        <a href=\"https://www.atlanticpresenters.ca/\" target=\"_blank\" rel=\"noopener noreferrer\"><img src=\"https://prismaticfestival.com/wp-content/uploads/2019/08/atlantic-presents_logo.jpg\" alt=\"Atlantic Presenters Association\"></a>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                    \n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                        <a href=\"https://www.nouvellescene.com/\" target=\"_blank\" rel=\"noopener noreferrer\"><img src=\"https://prismaticfestival.com/wp-content/uploads/2019/08/La-Nouvelle-Scene_Logo.jpg\" alt=\"La Nouvelle Scene\"></a>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                    \n                                    <!-- Add Arrows -->\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                        <a href=\"https://www.thegladstone.ca/\"><img src=\"https://prismaticfestival.com/wp-content/uploads/2019/08/theGladstone_logo.jpg\" alt=\"The Gladstone\"></a>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                    \n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                        <a href=\"https://artscourt.ca/\" target=\"_blank\" rel=\"noopener noreferrer\"><img src=\"https://prismaticfestival.com/wp-content/uploads/2019/08/artsCourt_logo.jpg\" alt=\"Arts Court Theatre\"></a>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                    \n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                        <a href=\"https://saw-centre.com/ \"><img src=\"https://prismaticfestival.com/wp-content/uploads/2019/08/SAW_logo.jpg\" alt=\"\"></a>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                    \n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                        <a href=\"http://halifaxcentrallibrary.ca/\" target=\"_blank\" rel=\"noopener noreferrer\"><img src=\"https://prismaticfestival.com/wp-content/uploads/2019/07/HPL_Logo_Horizontal_Master.jpg\" alt=\"Halifax Public Libraries\"></a>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                    \n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                        <a href=\"http://musicnovascotia.ca/\" target=\"_blank\" rel=\"noopener noreferrer\"><img src=\"https://prismaticfestival.com/wp-content/uploads/2019/08/musicNovaScotia_logo.jpg\" alt=\"Music Nova Scotia\"></a>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                    \n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                        <a href=\"https://musicandbeyond.ca/\" target=\"_blank\" rel=\"noopener noreferrer\"><img src=\"https://prismaticfestival.com/wp-content/uploads/2019/08/musicBeyond_Logo.jpg\" alt=\"Music &amp; Beyone\"></a>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                    \n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                        <a href=\"https://cresco.ca/\" target=\"_blank\" rel=\"noopener noreferrer\"><img src=\"https://prismaticfestival.com/wp-content/uploads/2019/08/Cresco_logo.jpg\" alt=\"Cresco\"></a>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                    \n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                        <a href=\"http://www.unitedgulf.ca/\"><img src=\"https://prismaticfestival.com/wp-content/uploads/2019/08/unitedGulf_Logo.jpg\" alt=\"United Gulf Developments Limited\"></a>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                    \n                                    <!-- Add Arrows -->"
