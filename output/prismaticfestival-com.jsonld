    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<h1>Evening with Prismatic</h1>\t\t\n\t\t<p>Saturday, October 28th | 9PM<br /><a href=\"https://prismaticfestival.com/index.php/our-venues/#neptune-theatre\">Neptune Theatre Scotiabank Lobby</a><br />Free</p>\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t<img width=\"697\" height=\"1024\" src=\"https://prismaticfestival.com/wp-content/uploads/2022/09/EveningPrismatic_Invite-2-697x1024.jpg\" alt=\"\" loading=\"lazy\" srcset=\"https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2022/09/EveningPrismatic_Invite-2.jpg?resize=697%2C1024&amp;ssl=1 697w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2022/09/EveningPrismatic_Invite-2.jpg?resize=204%2C300&amp;ssl=1 204w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2022/09/EveningPrismatic_Invite-2.jpg?resize=768%2C1129&amp;ssl=1 768w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2022/09/EveningPrismatic_Invite-2.jpg?resize=1045%2C1536&amp;ssl=1 1045w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2022/09/EveningPrismatic_Invite-2.jpg?resize=1120%2C1647&amp;ssl=1 1120w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2022/09/EveningPrismatic_Invite-2.jpg?resize=640%2C941&amp;ssl=1 640w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2022/09/EveningPrismatic_Invite-2.jpg?w=1306&amp;ssl=1 1306w\" sizes=\"(max-width: 697px) 100vw, 697px\" />\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/industry-events-2022/\" role=\"button\">\n\t\t\t\t\t\tBack to Industry Events\n\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://www.canada.ca/en/canadian-heritage.html\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<img width=\"250\" height=\"166\" src=\"https://prismaticfestival.com/wp-content/uploads/2022/08/sponsor-logos-03-e1662144841715.png\" alt=\"\" loading=\"lazy\" />\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://canadacouncil.ca/\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\