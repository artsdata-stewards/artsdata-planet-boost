  {
    "@id": "https://prismaticfestival.com/index.php/2024-damini-awoyiga/#primaryimage",
    "@type": [
      "http://schema.org/ImageObject"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2024/06/Damini-prof-head-shot.jpg?fit=1439%2C1920&ssl=1"
