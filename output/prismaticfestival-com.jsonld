      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<img width=\"767\" height=\"1024\" src=\"https://prismaticfestival.com/wp-content/uploads/2021/09/DiggingRoots-Portrait-Hi-Res-pic-Ratul-Debnath-1-767x1024.jpg\" alt=\"\" loading=\"lazy\" srcset=\"https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2021/09/DiggingRoots-Portrait-Hi-Res-pic-Ratul-Debnath-1.jpg?resize=767%2C1024&amp;ssl=1 767w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2021/09/DiggingRoots-Portrait-Hi-Res-pic-Ratul-Debnath-1.jpg?resize=225%2C300&amp;ssl=1 225w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2021/09/DiggingRoots-Portrait-Hi-Res-pic-Ratul-Debnath-1.jpg?resize=768%2C1025&amp;ssl=1 768w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2021/09/DiggingRoots-Portrait-Hi-Res-pic-Ratul-Debnath-1.jpg?resize=1150%2C1536&amp;ssl=1 1150w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2021/09/DiggingRoots-Portrait-Hi-Res-pic-Ratul-Debnath-1.jpg?resize=1120%2C1495&amp;ssl=1 1120w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2021/09/DiggingRoots-Portrait-Hi-Res-pic-Ratul-Debnath-1.jpg?resize=640%2C855&amp;ssl=1 640w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2021/09/DiggingRoots-Portrait-Hi-Res-pic-Ratul-Debnath-1.jpg?w=1438&amp;ssl=1 1438w\" sizes=\"(max-width: 767px) 100vw, 767px\" />\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t<a href=\"http://www.diggingrootsmusic.com/\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\tDesktop\n\t\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t<a href=\"https://www.facebook.com/DiggingRootsMusic\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\tFacebook\n\t\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t<a href=\"https://open.spotify.com/artist/6jXRPYI1uhTRJKuetXMRpj\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\tMusic\n\t\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t<a href=\"https://www.youtube.com/user/DiggingRootsMusic\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\tYoutube\n\t\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t<a href=\"https://www.instagram.com/diggingroots/?hl=fr-ca\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\tInstagram\n\t\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t<a href=\"https://twitter.com/_DiggingRoots\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\tTwitter\n\t\t\t\t\t\t\t\t\t\t\t</a>\n\t\t<p> </p><p><b>ShoShona Kish</b> | Vocals<br /><b>Raven Kanatakta Polson-Lahache </b>| Guitar, Vocals<br /><b>Skye Polson</b> | Drums, Sampler, Vocals<br /><b>Mike Celia</b> | Guitar, Vocals<br /><b>Alana Bridgewater</b> | Vocals<br /><b>André Blais</b> | Bass, Vocals</p>\t\t\n\t\t\t\t\t\t\t\t\t\t\t<h2>Digging Roots</h2>\t\t\t\t\t\t\t\t\t\n\t\t<p>Saturday, October 2nd | 7:30PM</p><p><b>Grand Parade - Grand Oasis Stage</b></p><p><i>Free</i></p>\t\t\n\t\t<p>Digging Roots breathe life into songs from their land, Turtle Island, to raise their voices in solidarity with a global chorus of Indigenous artists, activists and change-makers. For over a decade, JUNO Award winners Digging Roots have traveled the world with a joyful message of resistance, celebrating Anishinabe and Onkwehonwe traditions of round dance and interconnectedness interwoven with the bedrock sounds of blues, soul, and rock n’ roll. </p><p>The beating hearts of Digging Roots, founding duo ShoShona and Raven, have built a home for a talented community of players and collaborators including their son, drummer Skye Polson, and Hill Kourkoutis. More than a band, Diggings Roots have taken their place at the frontline of the fight for equity and representation in the arts, with involvement in industry advocacy and organization, including the International Indigenous Music Summit and Ishkode Records, to empower arts communities worldwide.   </p>\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t<img width=\"1024\" height=\"757\" src=\"https://prismaticfestival.com/wp-content/uploads/2021/09/DiggingRoots-couch-Landscape-Hi-Res-pic-Ratul-Debnath-1-1024x757.jpg\" alt=\"\" loading=\"lazy\" srcset=\"https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2021/09/DiggingRoots-couch-Landscape-Hi-Res-pic-Ratul-Debnath-1.jpg?resize=1024%2C757&amp;ssl=1 1024w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2021/09/DiggingRoots-couch-Landscape-Hi-Res-pic-Ratul-Debnath-1.jpg?resize=300%2C222&amp;ssl=1 300w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2021/09/DiggingRoots-couch-Landscape-Hi-Res-pic-Ratul-Debnath-1.jpg?resize=768%2C568&amp;ssl=1 768w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2021/09/DiggingRoots-couch-Landscape-Hi-Res-pic-Ratul-Debnath-1.jpg?resize=1536%2C1136&amp;ssl=1 1536w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2021/09/DiggingRoots-couch-Landscape-Hi-Res-pic-Ratul-Debnath-1.jpg?resize=1120%2C828&amp;ssl=1 1120w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2021/09/DiggingRoots-couch-Landscape-Hi-Res-pic-Ratul-Debnath-1.jpg?resize=640%2C473&amp;ssl=1 640w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2021/09/DiggingRoots-couch-Landscape-Hi-Res-pic-Ratul-Debnath-1.jpg?w=1920&amp;ssl=1 1920w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" />\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/prismatic-2021/\" role=\"button\">\n\t\t\t\t\t\tBack to 2021\n\t\t\t\t\t</a>"
      }
    ],
