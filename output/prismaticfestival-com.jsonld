    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<img width=\"768\" height=\"1024\" src=\"https://prismaticfestival.com/wp-content/uploads/2021/08/illest-omen-photo-768x1024.jpg\" alt=\"\" loading=\"lazy\" />\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t<p> </p><p><b>Dilshan Weerasinghe</b> | Guitar<br /><b>Nathan Simmons</b> | Bass, Vocals<br /><b>Nicolae Orengo </b>| Drums<br /><b>Behrooz Mihankhah</b> | Keyboard<br /><b>Aaron Klein </b>| Trumpet</p>\t\t\n\t\t\t\t\t\t\t\t\t\t\t<h2>Illest Omen</h2>\t\t\t\t\t\t\t\t\t\n\t\t<p>Wednesday, September 29th | 7PM </p><p><b>YouTube &amp; Facebook Live</b></p><p><em>Free</em></p>\t\t\n\t\t<p>Illest Omen is an R&amp;B jazz collective based in Halifax, Nova Scotia. Comprised of Dilshan Weerasinghe on guitar, Nathan Simmons on bass and vocals, Nicolae Orengo on drums, Behrooz Mihankhah on keys, and Aaron Klein on trumpet, the group combines a variety of styles ranging from neo-soul and R&amp;B to hip-hop and jazz. Influenced by artists such as Roy Hargrove, Anderson .Paak, and Kendrick Lamar, Illest Omen makes R&amp;B jazz music with a heavy hip-hop groove and tons of soul.</p><p><i>Prismatic’s 2021 digital programming is generously supported by </i><b><i>TD Bank Group </i></b><i>and </i><b><i>Light House GO.</i></b></p>\t\t\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/2021-2/\" role=\"button\">\n\t\t\t\t\t\tBack to 2021\n\t\t\t\t\t</a>"
