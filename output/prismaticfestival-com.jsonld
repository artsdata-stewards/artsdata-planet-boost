    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<h1>2015</h1>\t\t\n\t\t<p>August 19 - 23</p>\t\t\n\t\t<p>Prismatic Artists </p>\t\t\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/mohsen-sharifian-2015/\">\n\t\t\t\t\t\tMohsen Sharifian\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/the-mariachi-ghost-2015/\">\n\t\t\t\t\t\tThe Mariachi Ghost \n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/sounds-of-motown-2015/\">\n\t\t\t\t\t\tSounds of Motown \n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/michael-greyeyes-2015/\">\n\t\t\t\t\t\tMichael Greyeyes \n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/gypsophilia-2015/\">\n\t\t\t\t\t\tGypsophilia \n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/reeny-smith-2015/\">\n\t\t\t\t\t\tReeny Smith \n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/jaron-freeman-fox-2015/\">\n\t\t\t\t\t\tJaron Freeman Fox\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/global-savages/\">\n\t\t\t\t\t\tGlobal Savages\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/asia-nugruv-2015/\">\n\t\t\t\t\t\tAsia & Nugruv\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/nomadic-massive/\">\n\t\t\t\t\t\tNomadic Massive\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/dinuk-wijeratne-2015/\">\n\t\t\t\t\t\tDinuk Wijeratne\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/nova-dance-2015/\">\n\t\t\t\t\t\tNova Dance\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/sanctified-brothers-2015/\">\n\t\t\t\t\t\tThe Sanctified Brothers \n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/jeff-ward-2015/\">\n\t\t\t\t\t\tJeff Ward\n\t\t\t\t\t</a>\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/stephanie-yee-2015/\">\n\t\t\t\t\t\tStephanie<br>Yee\n\t\t\t\t\t</a>\n\t\t<h2 style=\"text-align: center;\">Prismatic 2015 Program</h2>\t\t\n\t\t\t<a href=\"https://issuu.com/prismaticartsfestival/docs/prismatic_2015_program\">\n\t\t\t\t\t\tView 2015's Program\n\t\t\t\t\t</a>\n\t\t<h1>Industry Events</h1>\t\t\n\t\t\t\t\t\t\t\t\t\t<a href=\"https://prismaticfestival.com/index.php/2015-activities-tent/\">Activities Tent Click Here</a><a href=\"https://prismaticfestival.com/index.php/2015-visual-arts-2/\">Visual Arts Stephanie Yee, David J. Brooks, Tara Francis Click Here</a><a href=\"https://prismaticfestival.com/index.php/2015-spoken-word/\">Spoken Word Pricelys, Allysa Flint, Christina Magnusson, Roots n’ Rhythm Click Here</a><a href=\"https://prismaticfestival.com/index.php/2015-play-readings/\">Play Readings Leah-Simone Bowen, Garret C. SmithClick Here</a>\t\t\t\t\n\t\t\t\t\t\t\t<svg aria-hidden=\"true\" viewBox=\"0 0 1000 1000\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M646 125C629 125 613 133 604 142L308 442C296 454 292 471 292 487 292 504 296 521 308 533L604 854C617 867 629 875 646 875 663 875 679 871 692 858 704 846 713 829 713 812 713 796 708 779 692 767L438 487 692 225C700 217 708 204 708 187 708 171 704 154 692 142 675 129 663 125 646 125Z\"></path></svg>\t\t\t\t\t\t\tPrevious slide\n\t\t\t\t\t\t\t<svg aria-hidden=\"true\" viewBox=\"0 0 1000 1000\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M696 533C708 521 713 504 713 487 713 471 708 454 696 446L400 146C388 133 375 125 354 125 338 125 325 129 313 142 300 154 292 171 292 187 292 204 296 221 308 233L563 492 304 771C292 783 288 800 288 817 288 833 296 850 308 863 321 871 338 875 354 875 371 875 388 867 400 854L696 533Z\"></path></svg>\t\t\t\t\t\t\tNext slide\n\t\t\t\t\t\t\t\t\t\t\t\t\t<img width=\"616\" height=\"298\" src=\"https://prismaticfestival.com/wp-content/uploads/2021/05/Screen-Shot-2021-05-13-at-12.58.15-PM.png\" alt=\"\" srcset=\"https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2021/05/Screen-Shot-2021-05-13-at-12.58.15-PM.png?w=616&amp;ssl=1 616w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2021/05/Screen-Shot-2021-05-13-at-12.58.15-PM.png?resize=300%2C145&amp;ssl=1 300w\" sizes=\"(max-width: 616px) 100vw, 616px\" />\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t<img width=\"417\" height=\"171\" src=\"https://prismaticfestival.com/wp-content/uploads/2021/05/IPAA_logo-01.png\" alt=\"\" srcset=\"https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2021/05/IPAA_logo-01.png?w=417&amp;ssl=1 417w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2021/05/IPAA_logo-01.png?resize=300%2C123&amp;ssl=1 300w\" sizes=\"(max-width: 417px) 100vw, 417px\" />\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t<h3 style=\"text-align: center;\">Indigenous Performance Network Gathering at the Prismatic Arts Festival</h3>\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t<img width=\"768\" height=\"114\" src=\"https://prismaticfestival.com/wp-content/uploads/2020/08/Screen-Shot-2020-08-10-at-2.40.26-PM-768x114.png\" alt=\"sponsors\" srcset=\"https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/Screen-Shot-2020-08-10-at-2.40.26-PM.png?resize=768%2C114&amp;ssl=1 768w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/Screen-Shot-2020-08-10-at-2.40.26-PM.png?resize=300%2C44&amp;ssl=1 300w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/Screen-Shot-2020-08-10-at-2.40.26-PM.png?resize=640%2C95&amp;ssl=1 640w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/Screen-Shot-2020-08-10-at-2.40.26-PM.png?w=1000&amp;ssl=1 1000w\" sizes=\"(max-width: 768px) 100vw, 768px\" />\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t<img width=\"1024\" height=\"658\" src=\"https://prismaticfestival.com/wp-content/uploads/2020/08/Screen-Shot-2020-08-10-at-2.39.56-PM-1024x658.png\" alt=\"sponsors\" srcset=\"https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/Screen-Shot-2020-08-10-at-2.39.56-PM.png?resize=1024%2C658&amp;ssl=1 1024w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/Screen-Shot-2020-08-10-at-2.39.56-PM.png?resize=300%2C193&amp;ssl=1 300w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/Screen-Shot-2020-08-10-at-2.39.56-PM.png?resize=768%2C494&amp;ssl=1 768w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/Screen-Shot-2020-08-10-at-2.39.56-PM.png?resize=640%2C411&amp;ssl=1 640w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2020/08/Screen-Shot-2020-08-10-at-2.39.56-PM.png?w=1120&amp;ssl=1 1120w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" />"
