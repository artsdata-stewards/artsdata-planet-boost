tent/uploads/2023/07/3-website-Pisuwin-346832991_942014243680661_4538303676708427131_n.jpg?resize=300%2C200&amp;ssl=1 300w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2023/07/3-website-Pisuwin-346832991_942014243680661_4538303676708427131_n.jpg?resize=1024%2C683&amp;ssl=1 1024w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2023/07/3-website-Pisuwin-346832991_942014243680661_4538303676708427131_n.jpg?resize=768%2C512&amp;ssl=1 768w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2023/07/3-website-Pisuwin-346832991_942014243680661_4538303676708427131_n.jpg?resize=1536%2C1024&amp;ssl=1 1536w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2023/07/3-website-Pisuwin-346832991_942014243680661_4538303676708427131_n.jpg?resize=1120%2C747&amp;ssl=1 1120w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2023/07/3-website-Pisuwin-346832991_942014243680661_4538303676708427131_n.jpg?resize=640%2C427&amp;ssl=1 640w\" sizes=\"(max-width: 1920px) 100vw, 1920px\" />\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t<a href=\"https://prismaticfestival.com/index.php/prismatic-2023/\">\n\t\t\t\t\t\tBack to 2023\n\t\t\t\t\t</a>"
