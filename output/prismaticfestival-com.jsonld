    ],
    "http://schema.org/url": [
      {
        "@id": "https://prismaticfestival.com/wp-content/uploads/2020/08/Presentation-Document.009-e1597336794909-956x1024.jpeg"
      }
    ],
    "http://schema.org/contentUrl": [
      {
        "@id": "https://prismaticfestival.com/wp-content/uploads/2020/08/Presentation-Document.009-e1597336794909-956x1024.jpeg"
