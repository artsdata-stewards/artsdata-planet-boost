        "@value": "<h1>2010</h1>\t\t\n\t\t<p>October 10 - 17</p>\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t<img width=\"1024\" height=\"602\" src=\"https://prismaticfestival.com/wp-content/uploads/2021/02/Flyer-Prismatic-2010-1024x602.jpg\" alt=\"\" loading=\"lazy\" srcset=\"https://prismaticfestival.com/wp-content/uploads/2021/02/Flyer-Prismatic-2010-1024x602.jpg 1024w, https://prismaticfestival.com/wp-content/uploads/2021/02/Flyer-Prismatic-2010-300x176.jpg 300w, https://prismaticfestival.com/wp-content/uploads/2021/02/Flyer-Prismatic-2010-768x452.jpg 768w, https://prismaticfestival.com/wp-content/uploads/2021/02/Flyer-Prismatic-2010-1120x659.jpg 1120w, https://prismaticfestival.com/wp-content/uploads/2021/02/Flyer-Prismatic-2010-640x376.jpg 640w, https://prismaticfestival.com/wp-content/uploads/2021/02/Flyer-Prismatic-2010.jpg 1224w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" />\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t<img width=\"1024\" height=\"601\" src=\"https://prismaticfestival.com/wp-content/uploads/2021/05/Screen-Shot-2021-05-05-at-1.42.13-PM-1024x601.png\" alt=\"\" loading=\"lazy\" srcset=\"https://prismaticfestival.com/wp-content/uploads/2021/05/Screen-Shot-2021-05-05-at-1.42.13-PM-1024x601.png 1024w, https://prismaticfestival.com/wp-content/uploads/2021/05/Screen-Shot-2021-05-05-at-1.42.13-PM-300x176.png 300w, https://prismaticfestival.com/wp-content/uploads/2021/05/Screen-Shot-2021-05-05-at-1.42.13-PM-768x451.png 768w, https://prismaticfestival.com/wp-content/uploads/2021/05/Screen-Shot-2021-05-05-at-1.42.13-PM-1536x902.png 1536w, https://prismaticfestival.com/wp-content/uploads/2021/05/Screen-Shot-2021-05-05-at-1.42.13-PM-1120x657.png 1120w, https://prismaticfestival.com/wp-content/uploads/2021/05/Screen-Shot-2021-05-05-at-1.42.13-PM-640x376.png 640w, https://prismaticfestival.com/wp-content/uploads/2021/05/Screen-Shot-2021-05-05-at-1.42.13-PM.png 1920w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" />\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t