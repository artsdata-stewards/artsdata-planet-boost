      }
    ],
    "http://schema.org/contentUrl": [
      {
        "@id": "https://prismaticfestival.com/wp-content/uploads/2021/05/Screen-Shot-2021-05-05-at-1.30.07-PM-1024x571.png"
      }
    ],
    "http://schema.org/width": [
