    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<a href=\"https://prismaticfestival.com/index.php/about/#our-staff\" role=\"button\">\n\t\t\t\t<svg aria-hidden=\"true\" viewBox=\"0 0 448 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M257.5 445.1l-22.2 22.2c-9.4 9.4-24.6 9.4-33.9 0L7 273c-9.4-9.4-9.4-24.6 0-33.9L201.4 44.7c9.4-9.4 24.6-9.4 33.9 0l22.2 22.2c9.5 9.5 9.3 25-.4 34.3L136.6 216H424c13.3 0 24 10.7 24 24v32c0 13.3-10.7 24-24 24H136.6l120.5 114.8c9.8 9.3 10 24.8.4 34.3z\"></path></svg>\t\t\t\n\t\t\t\t\t\tBack to Our Staff\n\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t<img width=\"424\" height=\"640\" src=\"https://prismaticfestival.com/wp-content/uploads/2019/07/Maggie-Full-Body-1-e1656973497736.jpg\" alt=\"Maggie Stewart\" loading=\"lazy\" srcset=\"https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2019/07/Maggie-Full-Body-1-e1656973497736.jpg?w=424&amp;ssl=1 424w, https://i0.wp.com/prismaticfestival.com/wp-content/uploads/2019/07/Maggie-Full-Body-1-e1656973497736.jpg?resize=199%2C300&amp;ssl=1 199w\" sizes=\"(max-width: 424px) 100vw, 424px\" />\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t<a href=\"mailto:maggie@prismaticfestival.com\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\tEnvelope\n\t\t\t\t\t\t<svg viewBox=\"0 0 512 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M502.3 190.8c3.9-3.1 9.7-.2 9.7 4.7V400c0 26.5-21.5 48-48 48H48c-26.5 0-48-21.5-48-48V195.6c0-5 5.7-7.8 9.7-4.7 22.4 17.4 52.1 39.5 154.1 113.6 21.1 15.4 56.7 47.8 92.2 47.6 35.7.3 72-32.8 92.3-47.6 102-74.1 131.6-96.3 154-113.7zM256 320c23.2.4 56.6-29.2 73.4-41.4 132.7-96.3 142.8-104.7 173.4-128.7 5.8-4.5 9.2-11.5 9.2-18.9v-19c0-26.5-21.5-48-48-48H48C21.5 64 0 85.5 0 112v19c0 7.4 3.4 14.3 9.2 18.9 30.6 23.9 40.7 32.4 173.4 128.7 16.8 12.2 50.2 41.8 73.4 41.4z\"></path></svg>\t\t\t\t\t</a>\n\t\t\t<h2>Managing Director</h2>\t\t\n\t\t\t<h2>Maggie Stewart</h2>\t\t\n\t\t<p>Maggie Stewart has extensive hands-on experience in all aspects of performing arts administration. She has been working as a manager and administrator in professional arts since 2002 and is the co-founder and managing director of Onelight Theatre and the Prismatic Arts Festival. Maggie is responsible for strategic and business planning, grant writing, developing major partnerships and sponsorships, and coordinating with staff and board members to ensure effective financial and operational management.</p><p>Maggie currently sits on the boards of several arts organizations and has been invited to participate in conferences and events related to arts and culture, both national and international.</p><p>Maggie holds an undergraduate degree in Political Science and International Development Studies and is a graduate of the Dalhousie University Law School. She is a practicing lawyer, with experience in risk and liability assessment, contracts, regulatory law, employment law, immigration, and other relevant areas of legal expertise. Currently, she operates a solo practice focused on Canadian immigration and citizenship law.</p>"
      }
    ],
