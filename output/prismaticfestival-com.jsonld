    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<img width=\"1024\" height=\"236\" src=\"https://prismaticfestival.com/wp-content/uploads/2020/08/images-1-02-1024x236.png\" alt=\"Masterclasses\" loading=\"lazy\" srcset=\"https://prismaticfestival.com/wp-content/uploads/2020/08/images-1-02-1024x236.png 1024w, https://prismaticfestival.com/wp-content/uploads/2020/08/images-1-02-300x69.png 300w, https://prismaticfestival.com/wp-content/uploads/2020/08/images-1-02-768x177.png 768w, https://prismaticfestival.com/wp-content/uploads/2020/08/images-1-02-1536x354.png 1536w, https://prismaticfestival.com/wp-content/uploads/2020/08/images-1-02-1120x258.png 1120w, https://prismaticfestival.com/wp-content/uploads/2020/08/images-1-02-640x148.png 640w, https://prismaticfestival.com/wp-content/uploads/2020/08/images-1-02.png 1920w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" />\t\t\t\t\t\t\t\t\t\t\t\n\t\t<p style=\"text-align: center;\">co-presented with </p><p style=\"text-align: center;\"><a href=\"https://www.dal.ca/faculty/arts/school-of-performing-arts.html\" target=\"_blank\" rel=\"noopener\">Fountain School of Performing Arts</a></p>\t\t\n\t\t<p style=\"text-align: center;\">Prismatic Arts Festival and The Fountain School of Performing Arts are proud to partner once again to continue bringing unique learning opportunities to students, through workshops and masterclasses, with some of Canada's leading Indigenous artists and artists of colour.</p>\t\t\n\t\t\t\t\t\t\t\t\t\t<img width=\"576\" height=\"576\" src=\"https://prismaticfestival.com/wp-content/uploads/2020/11/tylersimmonds-web.png\" alt=\"Tyler Simmonds Masterclass\" loading=\"lazy\" srcset=\"https://prismaticfestival.com/wp-content/uploads/2020/11/tylersimmonds-web.png 576w, https://prismaticfestival.com/wp-content/uploads/2020/11/tylersimmonds-web-300x300.png 300w, https://prismaticfestival.com/wp-content/uploads/2020/11/tylersimmonds-web-150x150.png 150w\" sizes=\"(max-width: 576px) 100vw, 576px\" />\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t<img width=\"1024\" height=\"1024\" src=\"https://prismaticfestival.com/wp-content/uploads/2020/11/michelle-2-1024x1024.jpg\" alt=\"Michelle Thrush Masterclass\" loading=\"lazy\" srcset=\"https://prismaticfestival.com/wp-content/uploads/2020/11/michelle-2-1024x1024.jpg 1024w, https://prismaticfestival.com/wp-content/uploads/2020/11/michelle-2-300x300.jpg 300w, https://prismaticfestival.com/wp-content/uploads/2020/11/michelle-2-150x150.jpg 150w, https://prismaticfestival.com/wp-content/uploads/2020/11/michelle-2-768x768.jpg 768w, https://prismaticfestival.com/wp-content/uploads/2020/11/michelle-2-1120x1120.jpg 1120w, https://prismaticfestival.com/wp-content/uploads/2020/11/michelle-2-640x640.jpg 640w, https://prismaticfestival.com/wp-content/uploads/2020/11/michelle-2.jpg 1500w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" />\t\t\t\t\t\t\t\t\t\t\t\n\t\t<p style=\"text-align: center;\">*this masterclass is for FSPA students only*</p>"
