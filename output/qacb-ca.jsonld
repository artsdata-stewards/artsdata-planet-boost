    ],
    "http://schema.org/url": [
      {
        "@id": "https://qacb.ca/events/analyse-tableaux-mars-2022-912-905-954-192/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://qacb.ca/events/analyse-tableaux-mars-2022-912-905-954-192/"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "&lt;strong&gt;REPORTÉ&lt;/strong&gt;  &lt;div&gt;Dû à un concours de circonstances défavorables nous devons &lt;b&gt;reporter&lt;/b&gt; à une &lt;b&gt;date ultérieure&lt;/b&gt; l&#039;atelier-&lt;b&gt;démonstration des produits DEMCO&lt;/b&gt;, puisque la représentante de DEMCO qui devait diriger cette rencontre de démonstration a contracté la Covid.&lt;/div&gt;  &lt;div&gt;Donc, cette rencontre sera relogée à une date ultérieure dans la mesure des ouvertures disponibles dans le calendrier .&lt;/div&gt;  &nbsp;    mardi après-midi  13h30 à 15h30    Basée à St-Hubert, la compagnie québécoise DEMCO EnCouleur offre des produits d&#039;arts de qualité depuis plus de 50 ans.    Mme Johanne Zenga, représentante de la compagnie, nous présentera leur gamme de peintures, médiums, vernis, adhésifs et autres produits pour la peinture acrylique et l’aquarelle.    Vous aurez l’occasion d’essayer certains de leurs produits, et nous vous suggérons d’apporter un support (ex : toile cartonnée), ainsi que des pinceaux et des outils appropriés."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Reporté à une date ultérieure: Démonstration de produits DEMCO"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
