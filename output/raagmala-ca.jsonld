      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The legend, Vidushi N. Rajam, is a household name in Indian Classical Music. One of the biggest icons of the Hindustani Violin, Vidushi N. Rajam has played a Jugalbandi with her daughter, Violin maestro, Vidushi Sangeet Shankar. They have been brilliantly accompanied by Tabla Maestro, Pandit Arvind"
      }
    ],
