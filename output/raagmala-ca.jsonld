    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The dynamic Sarod player Anupam Joshi has been an ardent follower of the Swara Samrat Ustad Ali Akbar Khan style of Sarod playing. His performance reflects the essence of the style of the Swara Samrat. He has beautifully presented his Solo Sarod recital. He has been aptly accompanied on the Tabla"
      }
