    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Drums of India presented by Maestro Pandit Bickram Ghosh featuring Vidwan V. Suresh on the Ghatam, Pandit Gopal Barman on the Shri Khol and B. Rajashekar on the Morsing, is one of the most exciting performances of SSF 2020-21. Pure Indian Classical intricacies of both Hindustani and Carnatic"
      }
