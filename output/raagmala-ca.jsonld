    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "SSF: Pt. Sugato Nag &#038; Pt. Prattyush Banerjee (Duet)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;The two extremely popular names of the Shahjanpur Gharana (school of music), worthy disciples of Sarod Legend, Padma Bhushan Pandit Buddhadev Dasgupta – Pandit Sugato Nag on the Sitar and Pandit Prattyush Banerjee on the Sarod have presented an extremely soulful Jugalbandi. They have been ably accompanied by Indranil Mallick. Watch this stellar performance only&lt;br /&gt;&lt;a class=&quot;moretag&quot; href=&quot;https://raagmala.ca/concert/ssf-pt-sugato-nag-pt-prattyush-banerjee-duet/&quot;&gt;+ Read More&lt;/a&gt;&lt;/p&gt;\\n"
      }
    ],
