    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "IMPORTANT CHANGE:\n\nDear friends:\n\nThe Raag-Mala Team is much saddened to inform you that Arshad Ali Khan had to fly back to India from Houston a couple nights ago due to the sudden passing of his father Ustad Akhtar Nawaz Khan. We convey our heartfelt condolences to Arshadbhai and his family"
      }
