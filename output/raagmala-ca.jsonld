    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Raag-Mala Toronto participates in Nuit Blanche at the Aga Khan Museum\nSaturday October 5th 2024\n\n7:30pm North South DialogueRadhika Baskar (Veena) & Pankaj Mishra (Sarangi)\n\nPankaj Mishra, a Sarangi maestro from the Banaras Gharana, was trained by the esteemed Pt. Mahesh Prasad Mishra"
      }
    ],
