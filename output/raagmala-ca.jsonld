    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Indrajit Banerjee\nScintillating Sitar\n\n\nIndrajit Banerjee who has won many awards, is one of the leading exponents of Maihar Gharana. Born into a musical family, he was inspired by his mother, who was a disciple of the late Pt. Nikhil Banerjee. He then learnt from his uncle Pt. Kartick Kumar"
      }
