    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Raag-Mala Toronto in partnership with Shadaj is proud to present a LIVE Online vocal recital by Vidushi Kaushiki Chakraborty with Debjit Patitund on Tabla and Sarwar Hussein on Sarangi and Gourab Chatterjee on Harmonium Saturday November 7th, 2020 10 am EST (Canada) LIVE Online on the &quot;Shadaj Baithak&quot; YouTube channel &nbsp; Facebook Event Link &nbsp; Ticket Type Raag-Mala&lt;br /&gt;&lt;a class=&quot;moretag&quot; href=&quot;https://raagmala.ca/concert/kaushiki-chakraborty-live-online-concert/&quot;&gt;+ Read More&lt;/a&gt;&lt;/p&gt;\\n"
      }
