    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Raag-Mala Toronto participates in Nuit Blanche at the Aga Khan Museum Saturday October 4th 2025 at 8pm Suchismita and Debopriya Chatterjee (Flute) with Harshad Kanetkar on Tabla. In a tradition where vocals and dance often take center stage, sisters Suchismita and Debopriya Chatterjee have carved out their own legacy with the bamboo flute. Disciples of&lt;br /&gt;&lt;a class=&quot;moretag&quot; href=&quot;https://raagmala.ca/concert/suchismita-and-debopriya-chatterjee-flute-with-harshad-kanetkar-on-tabla/&quot;&gt;+ Read More&lt;/a&gt;&lt;/p&gt;\\n"
      }
