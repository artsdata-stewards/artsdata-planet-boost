    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Pt. Shantanu Bhattacharyya &#038; Students LIVE at Aga Khan Museum"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Raag-Mala Toronto, in partnership with the Aga Khan Museum, is proud to present Shantanu Bhattacharya &amp; Students on Saturday October 25th at 7:30pm Pandit Shantanu Bhattacharyya is one of the foremost vocalists of Hindustani classical music today, renowned for his mastery of Khayal and Thumri and for carrying forward the rich legacy of the Patiala&lt;br /&gt;&lt;a class=&quot;moretag&quot; href=&quot;https://raagmala.ca/concert/pt-shantanu-bhattacharyya-students-live-at-aga-khan-museum/&quot;&gt;+ Read More&lt;/a&gt;&lt;/p&gt;\\n"
      }
    ],
