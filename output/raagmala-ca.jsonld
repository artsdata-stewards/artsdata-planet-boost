    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Rachna Bodas\nTorch Bearer of a Timeless Tradition \n\nRachna Bodas is an accomplished Indian classical vocalist endowed with a rich, pure, and vibrant voice. Her dedication and devotion can be seen in her performances, which have earned her wide acclaim and appreciation from the music fraternity"
      }
