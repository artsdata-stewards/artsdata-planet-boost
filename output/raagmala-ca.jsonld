    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "One of the most fascinating young Vocalists of Hindustani style, Brajeswar Mukherjee has presented a fascinating recital engraved with the pure Khayal Gayaki and unbelievable subtleties of craftsmanship. He has been accompanied on the Tabla by Kausik Banerjee and on the Harmonium by  Jyotirmoy"
      }
    ],
    "http://ogp.me/ns#image": [
