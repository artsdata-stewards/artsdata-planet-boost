      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Kathak Maestro Pandit Rajendra Gangani is one of the biggest icons of modern day Kathak. The extremely powerful and vibrant maestro has given a thrilling performance studded with surreal intricacies and sheer elegance. He has been beautifully accompanied by Pt. Fateh Singh Gangani on the Tabla"
      }
    ],
