    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "This year marks an exciting milestone as the festival expands to two nights with all proceeds going to support the Gord Downie & Chanie Wenjack fund.\n"
      }
    ],
    "https://schema.org/headline": [
      {
        "@language": "en",
