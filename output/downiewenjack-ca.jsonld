    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "To help you take #reconciliACTION while you shop for your loved ones this holiday season, we’ve put together DWF’s first-ever Holiday Gift Guide. Below you will find 12 Indigenous-owned businesses, the new DWF Merch Store, and of course, The Bay’s iconic Point Blankets, which support Oshki Wupoowane | The Blanket Fund. Happy Holidays!\nRead more\n"
      }
    ],
    "https://schema.org/datePublished": [
      {
        "@language": "en",
        "@value": "2023-11-20 10:23:57"
      }
    ],
    "https://schema.org/dateModified": [
      {
        "@language": "en",
        "@value": "2023-11-22 14:42:43"
      }
    ],
    "https://schema.org/mainEntityOfPage": [
      {
        "@language": "en",
        "@value": "Holiday Gift Guide: Shop Indigenous Businesses"
      }
    ],
    "https://schema.org/headline": [
      {
        "@language": "en",
        "@value": "\tHoliday Gift Guide: Shop Indigenous Businesses\t\t\t\t"
      }
    ],
    "https://schema.org/name": [
      {
        "@language": "en",
        "@value": "Holiday Gift Guide: Shop Indigenous Businesses"
      }
    ]
  },
