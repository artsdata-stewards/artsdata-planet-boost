    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "La Journée nationale autochtone est l'occasion de célébrer et d'honorer autochtone au Canada. Voici quelques façons de passer àréconciliACTION l'honneur de la Journée autochtone et tout au long de l'année :      Consultez notre site web pour découvrir une liste de ressources destinées à l'apprentissage et à l'enseignement autochtone .    Regardez la conférence TED intitulée « Le Canada a besoin de autochtone dynamiques ».    Découvrez la situation des langues des Premières Nations en Colombie-Britannique.  "
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Journée autochtone (Ressources)"
      }
    ],
