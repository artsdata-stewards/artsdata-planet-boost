    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Téléchargez gratuitement notre nouveau calendrier réconciliACTION ! - Le Gord Downie & Chanie Wenjack Fund"
      },
      {
        "@language": "en",
        "@value": "Download our new, free ReconciliACTION Calendar! - The Gord Downie & Chanie Wenjack Fund"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Vous pouvez télécharger votre copie numérique gratuite du calendrier bilingue réconciliACTION dès aujourd'hui ! Le calendrier anishinaabe est profondément ancré dans les cycles de la lune. La carapace de la tortue correspond visuellement aux jours et aux lunes d'une année lunaire : l'anneau extérieur de la carapace comporte de petites écailles représentant les 28 jours d'un mois lunaire, tandis que les écailles plus grandes au centre symbolisent les 13 lunes de l'année. Chacune de ces lunes porte le nom d'un événement naturel qui a lieu pendant cette période."
      },
      {
        "@language": "en",
        "@value": "You can download your free digital copy of the bilingual ReconciliACTION Calendar today! The Anishinaabe calendar is deeply rooted in the cycles of the moon. The turtle shell is a visual match for the days and moons in a lunar year: the outer ring of the shell has small scales representing the 28 days in a lunar month, while the larger scales in the center symbolize the 13 moons of the year. Each of these moons is named after a natural event that takes place during that time."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "en-US"
      },
      {
        "@language": "en",
        "@value": "en-US"
      }
    ]
  },
