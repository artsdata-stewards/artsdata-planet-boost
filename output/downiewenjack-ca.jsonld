    ],
    "https://schema.org/mainEntityOfPage": [
      {
        "@language": "en",
        "@value": "Understanding the Secret Path"
      }
    ],
    "https://schema.org/headline": [
      {
        "@language": "en",
        "@value": "\tUnderstanding the Secret Path\t\t\t\t"
      }
    ],
