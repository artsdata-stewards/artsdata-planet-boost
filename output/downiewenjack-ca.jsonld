      "https://schema.org/BlogPosting"
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "Canada Newswire – Scotiabank has unveiled its second Downie Wenjack Legacy Space in Toronto, further signifying its commitment to promoting education and discussion around reconciliation.\n"
      }
    ],
    "https://schema.org/headline": [
      {
        "@language": "en",
        "@value": "\tScotiabank Unveils Public Legacy Space in Partnership With The Gord Downie & Chanie Wenjack Fund | Newswire\t\t\t\t"
      }
    ],
    "https://schema.org/author": [
      {
        "@language": "en",
        "@value": "DWF"
      }
    ]
  },
