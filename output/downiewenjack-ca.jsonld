    "https://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "For Christa, the TRC was and remains about Survivors. In her work, she witnesses the ongoing impacts of intergenerational trauma caused by colonial policies. She sees poverty, incarceration, and systemic inequities that remain unchanged, even a decade after the TRC’s Final Report."
      }
    ],
