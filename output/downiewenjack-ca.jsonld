      {
        "@language": "en",
        "@value": "\tDownie Wenjack Legacy Centre Officially open at Amherstview’s W.J. Henderson Arena | The Napanee Beaver\t\t\t\t"
      }
    ],
    "https://schema.org/name": [
      {
        "@language": "en",
        "@value": "Downie Wenjack Legacy Centre Officially open at Amherstview’s W.J. Henderson Arena | The Napanee Beaver"
      }
    ]
  },
