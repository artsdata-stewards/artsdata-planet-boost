  {
    "@id": "_:g7438020",
    "@type": [
      "https://schema.org/BlogPosting"
    ],
    "https://schema.org/image": [
      {
        "@id": "_:g7438040"
      },
      {
        "@id": "_:g7438080"
      }
    ],
    "https://schema.org/publisher": [
      {
        "@id": "_:g7438160"
      }
    ],
    "https://schema.org/author": [
      {
        "@id": "_:g7438240"
      },
      {
        "@language": "en",
        "@value": "communications"
      }
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "Each year on April 7, World Health Day raises awareness of global health issues and promotes access to quality healthcare for all. In Canada, this includes recognizing that equitable access to healthcare has not been a reality for Indigenous children, particularly First Nations children living on reserve. Jordan’s Principle exists because of this inequity.\nRead more\n"
      }
    ],
    "https://schema.org/datePublished": [
      {
        "@language": "en",
        "@value": "2026-04-01 16:52:12"
      }
    ],
