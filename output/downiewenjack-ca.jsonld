  {
    "@id": "_:g7847360",
    "@type": [
      "https://schema.org/BlogPosting"
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "The Minoshkite Indigenous Music & Arts Festival is returning for a third year and has expanded to take place over two nights: Nov. 13 and 14. The event is presented by the Gord Downie & Chanie Wenjack Fund (DWF), Red Music Rising (RMR) and Canada’s Music Incubator (CMI).\n"
      }
    ],
    "https://schema.org/headline": [
      {
        "@language": "en",
        "@value": "\tGig Pick: Minoshkite Indigenous Music & Arts Festival—Nov. 13 and 14 at the Bronson Centre | Apartment613\t\t\t\t"
      }
    ],
    "https://schema.org/author": [
      {
        "@language": "en",
        "@value": "communications"
      }
    ]
  },
