        "@value": "article"
      }
    ],
    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "World Water Day (Resources) - The Gord Downie & Chanie Wenjack Fund"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "World Water Day, celebrated globally on March 22, holds particular significance for Indigenous communities with deep cultural, spiritual, and practical connection to water sources. The 2024 theme, Water for Peace, highlights the need to address the historical and ongoing struggles over access to clean water and the preservation of water rights faced by Indigenous Peoples."
      },
      {
        "@language": "en-us",
        "@value": "World Water Day, celebrated globally on March 22, holds particular significance for Indigenous communities with deep cultural, spiritual, and practical connection to water sources. The 2024 theme, Water for Peace, highlights the need to address the historical and ongoing struggles over access to clean water and the preservation of water rights faced by Indigenous Peoples."
      }
    ],
