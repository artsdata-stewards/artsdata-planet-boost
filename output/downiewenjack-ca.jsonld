    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "A statement from DWF - The Gord Downie & Chanie Wenjack Fund"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "On May 28, we learned about the heartbreaking discovery of 215 children buried at a former residential school on Tk'emlúps te Secwépemc territory in Kamloops, BC. We stand with the Secwépemc community, all the families and communities of these young children, and all those impacted by residential schools in their grief. “It’s really hard when we know what they are going through. We always knew findings would come out one day.” said Daisy Munroe, Chanie Wenjack’s eldest sister."
      },
      {
        "@language": "en-us",
        "@value": "DWF responds to the heartbreaking discovery of 215 children buried at a former residential school on Tk'emlúps te Secwépemc territory in Kamloops, BC."
      }
    ],
