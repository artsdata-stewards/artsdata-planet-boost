        "@language": "en",
        "@value": "communications"
      }
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "Toronto, ON – In partnership with the Gord Downie & Chanie Wenjack Fund (DWF), Hudson’s Bay Foundation is proud to launch four Legacy Space pop-ups, in its Montreal, Toronto Queen Street, Downtown Vancouver, and Yorkdale locations in honour of Indigenous History Month. The pop-ups offer customers a space to connect, reflect on Canada’s true history, and learn about DWF’s work including Oshki Wupoowane | The Blanket Fund.\nRead more\n"
      }
    ],
    "https://schema.org/datePublished": [
      {
        "@language": "en",
        "@value": "2024-06-18 11:41:07"
      }
    ],
    "https://schema.org/dateModified": [
      {
        "@language": "en",
        "@value": "2024-06-20 11:27:32"
      }
    ],
    "https://schema.org/mainEntityOfPage": [
      {
        "@language": "en",
        "@value": "Hudson’s Bay Establishes In-store DWF Legacy Space Pop-ups in Honour of Indigenous History Month"
      }
    ],
    "https://schema.org/headline": [
      {
        "@language": "en",
        "@value": "\tHudson’s Bay Establishes In-store DWF Legacy Space Pop-ups in Honour of Indigenous History Month\t\t\t\t"
      }
    ],
    "https://schema.org/name": [
      {
        "@language": "en",
        "@value": "Hudson’s Bay Establishes In-store DWF Legacy Space Pop-ups in Honour of Indigenous History Month"
      }
    ]
  },
  {
    "@id": "_:g8070820",
