    "http://schema.org/headline": [
      {
        "@language": "en",
        "@value": "Jesse Thistle Joins The Artist Ambassador Program As Our First Author"
      }
    ],
    "http://schema.org/articleSection": [
      {
        "@language": "en",
        "@value": "Blog"
      }
