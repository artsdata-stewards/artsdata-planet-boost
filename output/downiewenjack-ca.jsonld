  {
    "@id": "_:g6625380",
    "@type": [
      "https://schema.org/BlogPosting"
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "\nSources\nBeyond 94: Truth and Reconciliation in Canada| CBC | 2025\nIndigenous Languages Act | 2019\nNational Inquiry into Missing and Murdered Indigenous Women and Girls Final Report | 2019\nPope Francis Apology| CBC | 2022\nTruth and Reconciliation Commission of Canada: Calls to Action | 2015\n"
      }
    ]
  },
