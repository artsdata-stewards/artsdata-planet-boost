    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "\"Mais ils avaient de bonnes intentions : Le négationnisme des pensionnats indiens - The Gord Downie & Chanie Wenjack Fund"
      },
      {
        "@language": "en",
        "@value": "“But they had good intentions”: Indian Residential Schools Denialism - The Gord Downie & Chanie Wenjack Fund"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Avertissement sur le contenu : Ce billet contient des informations sur les pensionnats indiens. L'été dernier, l'université Blue Quills a annoncé qu'elle effectuerait des recherches sur le terrain pour trouver des lieux de sépulture non marqués d'enfants ayant fréquenté le pensionnat indien de Blue Quills (IRS)."
      },
      {
        "@language": "en",
        "@value": "Content warning: This post contain information about residential schools. Last summer, Blue Quills University announced they would be conducting a ground search for unmarked burial sites of children who attended Blue Quills Indian Residential School (IRS)."
      }
    ],
