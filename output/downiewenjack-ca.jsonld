    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "La Baie d'Hudson crée des pop-ups DWF espace patrimonial en magasin en l'honneur du Mois de l'histoire autochtone - The Gord Downie & Chanie Wenjack Fund"
      },
      {
        "@language": "en",
        "@value": "Hudson’s Bay Establishes In-store DWF Legacy Space Pop-ups in Honour of Indigenous History Month - The Gord Downie & Chanie Wenjack Fund"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Toronto, ON - En partenariat avec le Gord Downie & Chanie Wenjack Fund (DWF), la Fondation de la Baie d'Hudson est fière de lancer quatre espaces espace patrimonial dans ses succursales de Montréal, Toronto Queen Street, Downtown Vancouver et Yorkdale, en l'honneur du Mois de l'histoire autochtone . Les pop-ups offrent aux clients un espace pour établir des liens, réfléchir à la véritable histoire du Canada et en apprendre davantage sur le travail de la DWF, y compris Oshki Wupoowane | Les fonds des couvertures."
      },
      {
        "@language": "en",
        "@value": "Toronto, ON – In partnership with the Gord Downie & Chanie Wenjack Fund (DWF), Hudson’s Bay Foundation is proud to launch four Legacy Space pop-ups, in its Montreal, Toronto Queen Street, Downtown Vancouver, and Yorkdale locations in honour of Indigenous History Month. The pop-ups offer customers a space to connect, reflect on Canada’s true history, and learn about DWF’s work including Oshki Wupoowane | The Blanket Fund."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "en-US"
      },
      {
        "@language": "en",
        "@value": "en-US"
      }
    ]
  },
