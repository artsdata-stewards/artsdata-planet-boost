  {
    "@id": "_:g8370640",
    "@type": [
      "https://schema.org/BlogPosting"
    ],
    "https://schema.org/image": [
      {
        "@id": "_:g8370660"
      },
      {
        "@id": "_:g8370700"
      }
    ],
    "https://schema.org/publisher": [
      {
        "@id": "_:g8370780"
      }
    ],
    "https://schema.org/author": [
      {
        "@id": "_:g8370860"
      },
      {
        "@language": "en",
        "@value": "communications"
      }
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "Family members of the late Gord Downie were at the W.J. Hendweson Arena on Monday to officially open a Downie-Wenjack Legacy Room. The space, just inside the main entrance, is dedicated to reflection and reconciliation, a stark reminder of the injustices carried out by the Canadian government towards First Nations.\n"
      }
    ],
    "https://schema.org/datePublished": [
      {
        "@language": "en",
        "@value": "2025-10-21 11:51:05"
      }
    ],
    "https://schema.org/dateModified": [
      {
        "@language": "en",
        "@value": "2025-10-27 11:57:49"
      }
    ],
    "https://schema.org/mainEntityOfPage": [
      {
        "@language": "en",
        "@value": "Downie Wenjack Legacy Centre Officially open at Amherstview’s W.J. Henderson Arena | The Napanee Beaver"
      }
    ],
