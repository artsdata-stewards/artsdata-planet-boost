    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "Content warning: This post contain information about residential schools. This past April, the results of the phase 1 search at Blue Quills were shared in ceremony with the community. The search was led by Dr. Kisha Supernant from the Institute of Prairie and Indigenous Archaeology. \nRead more\n"
      }
    ],
    "https://schema.org/datePublished": [
      {
        "@language": "en",
        "@value": "2023-09-18 12:42:25"
      }
    ],
