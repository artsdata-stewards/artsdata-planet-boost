    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "Hundreds of students and staff at St. Joseph-Scollard Hall recently took part in the school’s inaugural ‘Walk for Wenjack’. \n"
      }
    ],
    "https://schema.org/headline": [
      {
        "@language": "en",
        "@value": "\tSJSH tops national ‘schools’ distance leaderboard after Walk for Wenjack | My North Bay Now\t\t\t\t"
      }
    ],
    "https://schema.org/author": [
      {
        "@language": "en",
        "@value": "communications"
      }
    ]
  },
