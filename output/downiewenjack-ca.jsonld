      {
        "@language": "fr",
        "@value": "Contactez-nous\nE-mail : staff@downiewenjack.ca\nNuméro gratuit : 1-833-666-2414 \nNuméro local : 519-964-0393 \nAdresse :\nBoîte postale 749\nOHSWEKEN, ON\nN0A1M0\n"
      }
    ]
  },
  {
    "@id": "https://downiewenjack.ca/fr/but-they-had-good-intentions-indian-residential-schools-denialism/",
    "https://ogp.me/ns#locale": [
      {
        "@language": "fr",
        "@value": "fr"
      }
    ],
    "https://ogp.me/ns#site_name": [
