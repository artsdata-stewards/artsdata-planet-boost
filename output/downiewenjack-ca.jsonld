    "https://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Poster Contest Highlights - The Gord Downie &amp; Chanie Wenjack Fund"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "The Legacy School Program is proud to announce that there were over 100 submissions to this year’s Legacy Schools Spring Poster Contest, which closed on May 14th. Students were asked to illustrate how mental health influences their relationships with the land, their families and communities. We want to thank all the students who submitted their beautiful posters, and we hope they apply again next year."
      },
      {
        "@language": "fr",
        "@value": "We want to thank all the students who submitted their beautiful posters, and we hope they apply again next year. "
      }
    ],
