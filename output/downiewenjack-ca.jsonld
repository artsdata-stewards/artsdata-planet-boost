  {
    "@id": "_:g7929840",
    "@type": [
      "https://schema.org/BlogPosting"
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "Gord Downie’s new album to be released in October is dedicated to residential school runaway Chanie Wenjack and will be accompanied by an 88-page graphic novel by Jeff Lemire. An animated film, inspired by the music and illustrations will be broadcast on CBC on Oct. 23. (Gord Downie/JeffLemire)\n"
      }
    ],
    "https://schema.org/headline": [
      {
        "@language": "en",
        "@value": "\tThe Secret Path: Gord Downie’s Chanie Wenjack tribute album | CBC\t\t\t\t"
      }
    ],
    "https://schema.org/author": [
      {
        "@language": "en",
        "@value": "communications"
      }
    ]
  },
  {
    "@id": "_:g7929920",
    "@type": [
      "https://schema.org/BlogPosting"
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "Chanie was 12, and Indigenous. He died as the white world’s rules had forced him to live—cut off from his people.\n"
      }
    ],
    "https://schema.org/headline": [
      {
        "@language": "en",
        "@value": "\tThe lonely death of Chanie Wenjack | Maclean’s\t\t\t\t"
      }
    ],
    "https://schema.org/author": [
      {
        "@language": "en",
        "@value": "communications"
      }
    ]
  },
