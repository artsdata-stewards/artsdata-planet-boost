      {
        "@language": "en",
        "@value": "DWF Holiday Gift Guide – 2025"
      }
    ]
  },
  {
    "@id": "_:g7440680",
    "@type": [
      "https://schema.org/BlogPosting"
    ],
    "https://schema.org/image": [
      {
        "@id": "_:g7440700"
      },
      {
        "@id": "_:g7440740"
      }
    ],
    "https://schema.org/publisher": [
      {
        "@id": "_:g7440820"
      }
    ],
    "https://schema.org/author": [
      {
        "@id": "_:g7440900"
      },
      {
        "@language": "en",
        "@value": "communications"
      }
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "The Gord Downie & Chanie Wenjack Fund (DWF) is proud to announce an expanded partnership with Canadian Tire Corporation, Limited (CTC). Building on our existing relationship, CTC will now support Oshki Wupoowane | The Blanket Fund (The Blanket Fund), a national initiative that empowers Indigenous and Indigenous-led cultural, artistic, and educational projects and organizations. \nRead more\n"
      }
    ],
    "https://schema.org/datePublished": [
      {
        "@language": "en",
        "@value": "2025-10-16 09:00:29"
      }
    ],
    "https://schema.org/dateModified": [
      {
        "@language": "en",
        "@value": "2025-10-16 10:33:35"
      }
    ],
    "https://schema.org/mainEntityOfPage": [
      {
        "@language": "en",
        "@value": "Gord Downie & Chanie Wenjack Fund and Canadian Tire Corporation Expand Partnership in Support of Oshki Wupoowane | The Blanket Fund"
      }
    ],
    "https://schema.org/headline": [
      {
        "@language": "en",
        "@value": "\tGord Downie & Chanie Wenjack Fund and Canadian Tire Corporation Expand Partnership in Support of Oshki Wupoowane | The Blanket Fund\t\t\t\t"
      }
    ],
    "https://schema.org/name": [
      {
        "@language": "en",
        "@value": "Gord Downie & Chanie Wenjack Fund and Canadian Tire Corporation Expand Partnership in Support of Oshki Wupoowane | The Blanket Fund"
      }
    ]
  },
  {
    "@id": "_:g7441060",
    "@type": [
      "https://schema.org/BlogPosting"
    ],
    "https://schema.org/image": [
      {
        "@id": "_:g7441080"
      },
      {
        "@id": "_:g7441120"
      }
    ],
    "https://schema.org/publisher": [
      {
        "@id": "_:g7441200"
      }
    ],
    "https://schema.org/author": [
      {
        "@id": "_:g7441280"
      },
      {
        "@language": "en",
        "@value": "communications"
      }
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "In a historic and emotional address in Nuuk, Greenland, Danish Prime Minister Mette Frederiksen formally apologized for a decades-long involuntary birth control program that saw thousands of Inuit women and girls, some as young as 12, fitted with intrauterine devices (IUDs) without their knowledge or consent during the 1960s and 70s.\nRead more\n"
      }
    ],
    "https://schema.org/datePublished": [
      {
        "@language": "en",
        "@value": "2025-10-01 10:04:21"
      }
    ],
    "https://schema.org/dateModified": [
      {
        "@language": "en",
        "@value": "2025-10-01 10:05:00"
      }
    ],
    "https://schema.org/mainEntityOfPage": [
      {
        "@language": "en",
        "@value": "Denmark Apologizes to Greenlandic Women for Decades of Forced Birth Control"
      }
    ],
    "https://schema.org/headline": [
      {
        "@language": "en",
        "@value": "\tDenmark Apologizes to Greenlandic Women for Decades of Forced Birth Control\t\t\t\t"
      }
    ],
    "https://schema.org/name": [
      {
        "@language": "en",
        "@value": "Denmark Apologizes to Greenlandic Women for Decades of Forced Birth Control"
      }
    ]
  },
  {
    "@id": "_:g7441440",
    "@type": [
      "https://schema.org/BlogPosting"
    ],
    "https://schema.org/image": [
      {
        "@id": "_:g7441460"
      },
      {
        "@id": "_:g7441500"
      }
    ],
    "https://schema.org/publisher": [
      {
        "@id": "_:g7441580"
      }
    ],
    "https://schema.org/author": [
      {
        "@id": "_:g7441660"
      },
      {
        "@language": "en",
        "@value": "communications"
      }
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "For Christa, the TRC was and remains about Survivors. In her work, she witnesses the ongoing impacts of intergenerational trauma caused by colonial policies. She sees poverty, incarceration, and systemic inequities that remain unchanged, even a decade after the TRC’s Final Report.\nRead more\n"
      }
    ],
    "https://schema.org/datePublished": [
      {
        "@language": "en",
        "@value": "2025-09-29 16:00:28"
      }
    ],
    "https://schema.org/dateModified": [
      {
        "@language": "en",
        "@value": "2025-09-29 16:11:17"
      }
    ],
    "https://schema.org/mainEntityOfPage": [
      {
        "@language": "en",
        "@value": "Beyond 215: A Conversation with Christa Big Canoe"
      }
    ],
    "https://schema.org/headline": [
      {
        "@language": "en",
        "@value": "\tBeyond 215: A Conversation with Christa Big Canoe\t\t\t\t"
      }
    ],
    "https://schema.org/name": [
      {
        "@language": "en",
        "@value": "Beyond 215: A Conversation with Christa Big Canoe"
      }
    ]
  },
