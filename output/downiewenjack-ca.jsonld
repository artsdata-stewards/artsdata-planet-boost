    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "ReconciliACTIONs At Legacy Schools - The Gord Downie & Chanie Wenjack Fund"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "This past week many of our Legacy Schools took part in Secret Path Week, a week-long event that is held from October 17th to October 22nd to honour the passing of Gord Downie and Chanie Wenjack. Throughout the school year, and especially during Secret Path Week, we encourage our Legacy School educators and students to take part in reconciliACTIONs. These are meaningful actions that work towards reconciliation, creating awareness, learning and sharing to create strong relationships among all Canadians. We would love to acknowledge some of the great reconciliACTIONs that have been led by Legacy Schools not only during Secret Path Week but throughout the 2020 school year. We hope their powerful actions inspire you and those around you to get involved and #DoSomething."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "en",
        "@value": "en-US"
      }
    ]
