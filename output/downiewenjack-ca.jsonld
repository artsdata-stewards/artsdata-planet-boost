    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Projet de loi sur le traité de Waitangi et les principes du traité - Gord Downie & Chanie Wenjack Fund"
      },
      {
        "@language": "en",
        "@value": "The Treaty of Waitangi & Treaty Principles Bill - The Gord Downie & Chanie Wenjack Fund"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le 14 novembre, la députée Māori Hana-Rawhiti Maipi-Clarke a déchiré une copie d'un projet de loi qui réinterprète le traité de Waitangi de 1840 et a mené un haka au Parlement néo-zélandais. Le projet de loi controversé sur les principes du traité propose de nouveaux principes qui, selon ses détracteurs, pourraient porter atteinte aux droits des Māori et à l'intention initiale du traité. En savoir plus sur le traité de Waitangi de 1840 et sur le \"projet de loi sur les principes du traité\"."
      },
      {
        "@language": "en",
        "@value": "On November 14, Māori MP Hana-Rawhiti Maipi-Clarke ripped up a copy of a bill that reinterprets the 1840 Treaty of Waitangi and led a haka in New Zealand’s Parliament. The controversial \"Treaty Principles Bill\" proposes new principles that critics argue could undermine Māori rights and the Treaty’s original intent. Learn more about the 1840 Treaty of Waitangi, and the \"Treaty Principles Bill\"."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "en-US"
      },
      {
        "@language": "en",
        "@value": "en-US"
      }
    ]
