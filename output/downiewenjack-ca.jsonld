        "@id": "_:g7440440"
      }
    ],
    "https://schema.org/author": [
      {
        "@id": "_:g7440520"
      },
      {
        "@language": "en",
        "@value": "communications"
      }
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "This holiday season, take #reconciliACTION by purchasing gifts from DWF’s Holiday Gift Guide. This guide features Indigenous-owned businesses, with options for all budgets and preferences. There is something meaningful for every person on your list!\nRead more\n"
      }
    ],
    "https://schema.org/datePublished": [
      {
        "@language": "en",
        "@value": "2025-10-30 09:17:50"
      }
    ],
    "https://schema.org/dateModified": [
      {
