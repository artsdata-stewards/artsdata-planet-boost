      }
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "The Independent Assessment Process (IAP) and earlier Alternative Dispute Resolution (ADR) were compensation processes established under the Indian Residential Schools Settlement Agreement (IRSSA) for Survivors who experienced abuse in residential schools in Canada. Under a Supreme Court decision, IAP and ADR records are scheduled to be destroyed on September 19, 2027, unless a Survivor chooses otherwise. This timeline is part of a legal ruling to protect privacy and confidentiality.\nRead more\n"
      }
    ],
    "https://schema.org/datePublished": [
      {
        "@language": "en",
        "@value": "2026-03-27 14:03:54"
      }
    ],
    "https://schema.org/dateModified": [
      {
        "@language": "en",
        "@value": "2026-03-27 14:30:50"
      }
    ],
    "https://schema.org/mainEntityOfPage": [
      {
        "@language": "en",
        "@value": "Understanding the Options for IRSSA Records"
      }
    ],
    "https://schema.org/headline": [
      {
        "@language": "en",
        "@value": "\tUnderstanding the Options for IRSSA Records\t\t\t\t"
      }
    ],
    "https://schema.org/name": [
      {
        "@language": "en",
        "@value": "Understanding the Options for IRSSA Records"
      }
    ]
  },
  {
    "@id": "_:g8268000",
    "@type": [
      "https://schema.org/BlogPosting"
    ],
    "https://schema.org/image": [
      {
        "@id": "_:g8268020"
      },
      {
        "@id": "_:g8268060"
      }
    ],
    "https://schema.org/publisher": [
      {
        "@id": "_:g8268140"
      }
    ],
    "https://schema.org/author": [
      {
        "@id": "_:g8268220"
      },
      {
        "@language": "en",
        "@value": "communications"
      }
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "The Millennial Scoop refers to the ongoing crisis of Indigenous children being disproportionately removed from their families and communities by child welfare systems. This is a continuation of harms seen in the Sixties Scoop era, where Indigenous children were taken and placed in non‑Indigenous care, with devastating effects on identity, culture, and family ties. \nRead more\n"
      }
    ],
    "https://schema.org/datePublished": [
      {
        "@language": "en",
        "@value": "2026-02-20 12:27:02"
      }
    ],
    "https://schema.org/dateModified": [
      {
        "@language": "en",
        "@value": "2026-03-27 14:29:55"
      }
    ],
    "https://schema.org/mainEntityOfPage": [
      {
        "@language": "en",
        "@value": "Millennial Scoop, Bill C‑92, and Indigenous Child Welfare"
      }
    ],
    "https://schema.org/headline": [
      {
        "@language": "en",
        "@value": "\tMillennial Scoop, Bill C‑92, and Indigenous Child Welfare\t\t\t\t"
      }
    ],
    "https://schema.org/name": [
      {
        "@language": "en",
        "@value": "Millennial Scoop, Bill C‑92, and Indigenous Child Welfare"
      }
    ]
  },
  {
    "@id": "_:g8268380",
    "@type": [
      "https://schema.org/BlogPosting"
    ],
    "https://schema.org/image": [
      {
        "@id": "_:g8268400"
      },
      {
        "@id": "_:g8268440"
      }
    ],
    "https://schema.org/publisher": [
      {
        "@id": "_:g8268520"
      }
    ],
    "https://schema.org/author": [
      {
        "@id": "_:g8268600"
      },
      {
        "@language": "en",
        "@value": "communications"
      }
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "Bill 5, officially titled the Protect Ontario by Unleashing our Economy Act, 2025, was passed by the Ontario government on June 5, 2025. The legislation makes major changes to 10 provincial laws, including the repeal of the Endangered Species Act, 2007, the Ontario Place Corporation Act, and the creation of a new Special Economic Zones Act.\nRead more\n"
      }
    ],
    "https://schema.org/datePublished": [
      {
        "@language": "en",
        "@value": "2026-02-17 13:17:38"
      }
    ],
    "https://schema.org/dateModified": [
      {
        "@language": "en",
        "@value": "2026-02-25 11:38:28"
      }
    ],
    "https://schema.org/mainEntityOfPage": [
      {
        "@language": "en",
        "@value": "Learn About Bill 5"
      }
    ],
    "https://schema.org/headline": [
      {
        "@language": "en",
        "@value": "\tLearn About Bill 5\t\t\t\t"
      }
    ],
    "https://schema.org/name": [
      {
        "@language": "en",
        "@value": "Learn About Bill 5"
      }
    ]
  },
  {
    "@id": "_:g8268760",
    "@type": [
      "https://schema.org/BlogPosting"
    ],
    "https://schema.org/image": [
      {
        "@id": "_:g8268780"
      },
      {
        "@id": "_:g8268820"
      }
    ],
    "https://schema.org/publisher": [
      {
        "@id": "_:g8268900"
      }
    ],
    "https://schema.org/author": [
      {
        "@id": "_:g8268980"
      },
      {
        "@language": "en",
        "@value": "communications"
      }
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "For Christa, the TRC was and remains about Survivors. In her work, she witnesses the ongoing impacts of intergenerational trauma caused by colonial policies. She sees poverty, incarceration, and systemic inequities that remain unchanged, even a decade after the TRC’s Final Report.\nRead more\n"
      }
    ],
    "https://schema.org/datePublished": [
      {
        "@language": "en",
        "@value": "2025-09-29 16:00:28"
      }
    ],
    "https://schema.org/dateModified": [
      {
        "@language": "en",
        "@value": "2025-09-29 16:11:17"
      }
    ],
    "https://schema.org/mainEntityOfPage": [
      {
        "@language": "en",
        "@value": "Beyond 215: A Conversation with Christa Big Canoe"
      }
    ],
    "https://schema.org/headline": [
      {
        "@language": "en",
        "@value": "\tBeyond 215: A Conversation with Christa Big Canoe\t\t\t\t"
      }
    ],
    "https://schema.org/name": [
      {
        "@language": "en",
        "@value": "Beyond 215: A Conversation with Christa Big Canoe"
      }
    ]
  },
