        "@value": "Gord Downie & Chanie Wenjack Fund \nNuméro d'enregistrement de l'organisme de bienfaisance : 784055915RR0001 \n"
      }
    ]
  },
  {
    "@id": "https://downiewenjack.ca/temporary/ab2842f8-04e9-4593-b060-3d6d655ec65c",
    "@type": [
      "https://schema.org/CreativeWork"
    ],
