        "@value": "The Gord Downie & Chanie Wenjack Fund \nRegistered Charity Number: 784055915RR0001 \n"
      }
    ]
  },
  {
    "@id": "https://downiewenjack.ca/temporary/51ce90b1-9b60-41ba-b80b-970d43639381",
    "@type": [
      "https://schema.org/CreativeWork"
