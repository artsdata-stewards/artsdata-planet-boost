    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "Documentary filmmaker Mike Downie will be the guest speaker later this month, as Albert College welcomes the Kingston native for a pair of talks at the school.\n"
      }
    ],
    "https://schema.org/headline": [
      {
        "@language": "en",
        "@value": "\tQuinte News speaks to Mike Downie ahead of Albert College visit | Quinte News\t\t\t\t"
      }
    ],
