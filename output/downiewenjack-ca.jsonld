    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Lectures recommandées en l'honneur de la Journée nationale pour la vérité et la réconciliation - The Gord Downie & Chanie Wenjack Fund"
      },
      {
        "@language": "en",
        "@value": "Recommended Reading in honour of the National Day for Truth & Reconciliation - The Gord Downie & Chanie Wenjack Fund"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "La Journée nationale pour la vérité et la réconciliation et la Journée des chemises orange sont des moments cruciaux de réflexion et d'apprentissage sur la véritable histoire du Canada et sur les conséquences persistantes des pensionnats. Pour vous aider dans votre cheminement vers la réconciliation, DWF a dressé une liste de lectures recommandées pour approfondir votre compréhension. Chaque livre offre une perspective unique et un aperçu des cultures et des expériences autochtone ."
      },
      {
        "@language": "en",
        "@value": "The National Day for Truth and Reconciliation and Orange Shirt Day are crucial moments for reflection and learning about the true history of Canada and the ongoing impacts of residential schools. To support you on your journey toward reconciliation, DWF has compiled a list of recommended readings to deepen your understanding. Each book offers unique perspective and insight into Indigenous cultures and experiences."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "en-US"
      },
      {
        "@language": "en",
        "@value": "en-US"
      }
    ]
  },
