        "@id": "_:g8182660"
      },
      {
        "@language": "en",
        "@value": "DWF"
      }
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "\nhttps://downiewenjack.ca/wp-content/uploads/2019/10/UnderstandingTheSecretPath-PODCA.mp3\n"
      }
    ],
    "https://schema.org/datePublished": [
      {
        "@language": "en",
        "@value": "2019-10-04 14:26:45"
