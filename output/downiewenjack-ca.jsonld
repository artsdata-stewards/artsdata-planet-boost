    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Wine Rack poursuit son partenariat avec le Gord Downie & Chanie Wenjack Fund pour la quatrième année - Le Gord Downie & Chanie Wenjack Fund"
      },
      {
        "@language": "en",
        "@value": "Wine Rack Continues Partnership with Gord Downie & Chanie Wenjack Fund for Fourth Year - The Gord Downie & Chanie Wenjack Fund"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "À l'approche de la Journée nationale de la vérité et de la réconciliation, le 30 septembre, Wine Rack est fier d'annoncer sa quatrième année consécutive de partenariat avec le Gord Downie & Chanie Wenjack Fund (DWF). Au cours des trois dernières années, les magasins Wine Rack de l'Ontario ont recueilli collectivement plus de 250 000 $ pour soutenir le DWF, un organisme de bienfaisance national autochtone, qui vise à favoriser la compréhension culturelle et à ouvrir la voie à la réconciliation entre les autochtone et les autochtone ."
      },
      {
        "@language": "en",
        "@value": "As the National Day for Truth and Reconciliation on September 30 approaches, Wine Rack proudly announces its fourth consecutive year of partnership with the Gord Downie & Chanie Wenjack Fund (DWF). Over the past three years, Wine Rack stores across Ontario have collectively raised over $250,000 in support of DWF, an Indigenous-led national charity that aims to build cultural understanding and create a path toward reconciliation between Indigenous and non-Indigenous peoples."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "en-US"
      },
      {
        "@language": "en",
        "@value": "en-US"
      }
    ]
