  {
    "@id": "_:g8372920",
    "@type": [
      "https://schema.org/BlogPosting"
    ],
    "https://schema.org/image": [
      {
        "@id": "_:g8372940"
      },
      {
        "@id": "_:g8372980"
      }
    ],
    "https://schema.org/publisher": [
      {
        "@id": "_:g8373060"
      }
    ],
    "https://schema.org/author": [
      {
        "@id": "_:g8373140"
      },
      {
        "@language": "en",
        "@value": "communications"
      }
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "The Gord Downie & Chanie Wenjack Fund (DWF) is proud to announce an expanded partnership with Canadian Tire Corporation, Limited (CTC). Building on our existing relationship, CTC will now support Oshki Wupoowane | The Blanket Fund (The Blanket Fund), a national initiative that empowers Indigenous and Indigenous-led cultural, artistic, and educational projects and organizations. \nRead more\n"
      }
    ],
    "https://schema.org/datePublished": [
      {
        "@language": "en",
        "@value": "2025-10-16 09:00:29"
      }
    ],
    "https://schema.org/dateModified": [
      {
        "@language": "en",
        "@value": "2025-10-16 10:33:35"
      }
    ],
    "https://schema.org/mainEntityOfPage": [
      {
        "@language": "en",
        "@value": "Gord Downie & Chanie Wenjack Fund and Canadian Tire Corporation Expand Partnership in Support of Oshki Wupoowane | The Blanket Fund"
      }
    ],
    "https://schema.org/headline": [
      {
        "@language": "en",
        "@value": "\tGord Downie & Chanie Wenjack Fund and Canadian Tire Corporation Expand Partnership in Support of Oshki Wupoowane | The Blanket Fund\t\t\t\t"
      }
    ],
    "https://schema.org/name": [
      {
        "@language": "en",
        "@value": "Gord Downie & Chanie Wenjack Fund and Canadian Tire Corporation Expand Partnership in Support of Oshki Wupoowane | The Blanket Fund"
      }
    ]
  },
  {
    "@id": "_:g8373300",
    "@type": [
      "https://schema.org/BlogPosting"
    ],
    "https://schema.org/image": [
      {
        "@id": "_:g8373320"
      },
      {
        "@id": "_:g8373360"
      }
    ],
    "https://schema.org/publisher": [
      {
        "@id": "_:g8373440"
      }
    ],
    "https://schema.org/author": [
      {
        "@id": "_:g8373520"
      },
      {
        "@language": "en",
        "@value": "communications"
      }
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "Tim Hortons and its restaurant owners are proud to announce that $942,000 was raised for Indigenous organizations through its fifth annual Orange Sprinkle Donut campaign.\nThe proceeds from Orange Sprinkle Donut sales are being donated to the Orange Shirt Society, the Gord Downie & Chanie Wenjack Fund, the Indian Residential School Survivors Society, Ulnooweg Education Centre, and in Quebec, the New Pathways Foundation (Fondation Nouveaux Sentiers).\n"
      }
    ],
    "https://schema.org/datePublished": [
      {
        "@language": "en",
        "@value": "2025-10-03 11:32:33"
      }
    ],
    "https://schema.org/dateModified": [
      {
        "@language": "en",
        "@value": "2025-10-03 11:32:33"
      }
    ],
    "https://schema.org/mainEntityOfPage": [
      {
        "@language": "en",
        "@value": "Tim Hortons Orange Sprinkle Donut campaign raised $942,000 for Indigenous organizations | PR Newswire"
      }
    ],
    "https://schema.org/headline": [
      {
        "@language": "en",
        "@value": "\tTim Hortons Orange Sprinkle Donut campaign raised $942,000 for Indigenous organizations | PR Newswire\t\t\t\t"
      }
    ],
    "https://schema.org/name": [
      {
        "@language": "en",
        "@value": "Tim Hortons Orange Sprinkle Donut campaign raised $942,000 for Indigenous organizations | PR Newswire"
      }
    ]
  },
