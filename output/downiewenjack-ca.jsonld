    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "Looking for a way to keep your kids engaged while schools are closed? Below is a list of books by Indigenous authors for children of various ages, all of which are available digitally!\n  \n  \n  \n  \n  \n  \n  \n  \n  \n  \n \n \n"
      }
    ],
    "https://schema.org/datePublished": [
      {
        "@language": "en",
        "@value": "2020-03-18 22:19:51"
