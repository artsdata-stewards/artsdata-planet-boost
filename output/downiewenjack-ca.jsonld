  {
    "@id": "_:g8073480",
    "@type": [
      "https://schema.org/BlogPosting"
    ],
    "https://schema.org/image": [
      {
        "@id": "_:g8073500"
      },
      {
        "@id": "_:g8073540"
      }
    ],
    "https://schema.org/publisher": [
      {
        "@id": "_:g8073620"
      }
    ],
    "https://schema.org/author": [
      {
        "@id": "_:g8073700"
      },
      {
        "@language": "en",
        "@value": "communications"
      }
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "Content warning: This newsletter contains information about residential schools. Mental health support is available. Today, May 28, marks two years since the Tk’emlúps te Secwépemc First Nation announced that preliminary findings indicated the remains of 215+ children were buried at the former Kamloops Indian Residential School.\nRead more\n"
      }
    ],
    "https://schema.org/datePublished": [
      {
        "@language": "en",
        "@value": "2023-05-28 09:50:37"
      }
    ],
    "https://schema.org/dateModified": [
      {
        "@language": "en",
        "@value": "2023-09-06 09:56:42"
      }
    ],
    "https://schema.org/mainEntityOfPage": [
      {
        "@language": "en",
        "@value": "Two Years Since 215+"
      }
    ],
    "https://schema.org/headline": [
      {
        "@language": "en",
        "@value": "\tTwo Years Since 215+\t\t\t\t"
      }
    ],
    "https://schema.org/name": [
      {
        "@language": "en",
        "@value": "Two Years Since 215+"
      }
    ]
  },
  {
    "@id": "_:g8073860",
    "@type": [
      "https://schema.org/BlogPosting"
    ],
    "https://schema.org/image": [
      {
        "@id": "_:g8073880"
      },
      {
        "@id": "_:g8073920"
      }
    ],
    "https://schema.org/publisher": [
      {
        "@id": "_:g8074000"
      }
    ],
    "https://schema.org/author": [
      {
        "@id": "_:g8074080"
      },
      {
        "@language": "en",
        "@value": "DWF"
      }
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "Reconciliation is a collective journey with no clear endpoint and this year has further demonstrated how important that journey continues to be.\nWe would like to thank everyone who took reconciliACTION in 2022 and joined us on this journey to foster meaningful relationships between Indigenous and non-Indigenous peoples. Here is a snapshot of how we built awareness and education and made connections to move reconciliation forward this year.\nRead more\n"
      }
    ],
    "https://schema.org/datePublished": [
      {
        "@language": "en",
        "@value": "2022-12-06 10:56:33"
      }
    ],
    "https://schema.org/dateModified": [
      {
        "@language": "en",
        "@value": "2024-06-20 10:53:49"
      }
    ],
    "https://schema.org/mainEntityOfPage": [
      {
        "@language": "en",
        "@value": "2022: A Year in Review"
      }
    ],
    "https://schema.org/headline": [
      {
        "@language": "en",
        "@value": "\t2022: A Year in Review\t\t\t\t"
      }
    ],
    "https://schema.org/name": [
      {
        "@language": "en",
        "@value": "2022: A Year in Review"
      }
    ]
  },
