      {
        "@language": "en",
        "@value": "2025-05-05 13:54:00"
      }
    ],
    "https://schema.org/mainEntityOfPage": [
      {
        "@language": "en",
        "@value": "Blue Quills Residential School Ground Search: An interview with Dr. Sherri Chisan"
      }
    ],
