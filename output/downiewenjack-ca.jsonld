      }
    ],
    "https://schema.org/mainEntityOfPage": [
      {
        "@language": "en",
        "@value": "Facing the Facts: Why Residential School Denialism Must Be Called Out"
      }
    ],
    "https://schema.org/headline": [
      {
        "@language": "en",
        "@value": "\tFacing the Facts: Why Residential School Denialism Must Be Called Out\t\t\t\t"
      }
    ],
    "https://schema.org/name": [
      {
        "@language": "en",
        "@value": "Facing the Facts: Why Residential School Denialism Must Be Called Out"
      }
    ]
  },
  {
    "@id": "_:g8020840",
    "@type": [
      "https://schema.org/BlogPosting"
    ],
    "https://schema.org/image": [
      {
        "@id": "_:g8020860"
      },
      {
        "@id": "_:g8020900"
      }
    ],
    "https://schema.org/publisher": [
      {
        "@id": "_:g8020980"
      }
    ],
    "https://schema.org/author": [
      {
        "@id": "_:g8021060"
      },
      {
        "@language": "en",
        "@value": "communications"
      }
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "On November 14, Māori MP Hana-Rawhiti Maipi-Clarke ripped up a copy of a bill that reinterprets the 1840 Treaty of Waitangi and led a haka in New Zealand’s Parliament. The controversial “Treaty Principles Bill” proposes new principles that critics argue could undermine Māori rights and the Treaty’s original intent. Learn more about the 1840 Treaty of Waitangi, and the “Treaty Principles Bill”.\nRead more\n"
      }
    ],
    "https://schema.org/datePublished": [
      {
        "@language": "en",
        "@value": "2024-11-20 09:34:20"
      }
    ],
    "https://schema.org/dateModified": [
      {
        "@language": "en",
        "@value": "2024-11-20 10:54:33"
      }
    ],
    "https://schema.org/mainEntityOfPage": [
      {
        "@language": "en",
        "@value": "The Treaty of Waitangi & Treaty Principles Bill"
      }
    ],
    "https://schema.org/headline": [
      {
        "@language": "en",
        "@value": "\tThe Treaty of Waitangi & Treaty Principles Bill\t\t\t\t"
      }
    ],
    "https://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Treaty of Waitangi & Treaty Principles Bill"
      }
    ]
  },
  {
    "@id": "_:g8021220",
    "@type": [
      "https://schema.org/BlogPosting"
    ],
    "https://schema.org/image": [
      {
        "@id": "_:g8021240"
      },
      {
        "@id": "_:g8021280"
      }
    ],
    "https://schema.org/publisher": [
      {
        "@id": "_:g8021360"
      }
    ],
    "https://schema.org/author": [
      {
        "@id": "_:g8021440"
      },
      {
        "@language": "en",
        "@value": "communications"
      }
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "This holiday season, take #reconciliACTION by purchasing gifts from DWF’s Holiday Gift Guide. This guide features Indigenous-owned businesses, a new merch collab with DWF Artist Ambassador Violet Gatensby , and of course, HBC’s iconic Point Blankets, which support Oshki Wupoowane | The Blanket Fund. With options for all budgets and preferences, there is something meaningful for every person on your list.\nRead more\n"
      }
    ],
    "https://schema.org/datePublished": [
      {
        "@language": "en",
        "@value": "2024-11-12 01:00:22"
      }
    ],
    "https://schema.org/dateModified": [
      {
        "@language": "en",
        "@value": "2024-12-16 12:11:22"
      }
    ],
    "https://schema.org/mainEntityOfPage": [
      {
        "@language": "en",
        "@value": "DWF Holiday Gift Guide – Moving Reconciliation Forward"
      }
    ],
    "https://schema.org/headline": [
      {
        "@language": "en",
        "@value": "\tDWF Holiday Gift Guide – Moving Reconciliation Forward\t\t\t\t"
      }
    ],
    "https://schema.org/name": [
      {
        "@language": "en",
        "@value": "DWF Holiday Gift Guide – Moving Reconciliation Forward"
      }
    ]
  },
  {
    "@id": "_:g8021600",
    "@type": [
      "https://schema.org/BlogPosting"
    ],
    "https://schema.org/image": [
      {
        "@id": "_:g8021620"
      },
      {
        "@id": "_:g8021660"
      }
    ],
    "https://schema.org/publisher": [
      {
        "@id": "_:g8021740"
      }
    ],
    "https://schema.org/author": [
      {
        "@id": "_:g8021820"
      },
      {
        "@language": "en",
        "@value": "communications"
      }
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "You can download your free digital copy of the bilingual ReconciliACTION Calendar today! The Anishinaabe calendar is deeply rooted in the cycles of the moon. The turtle shell is a visual match for the days and moons in a lunar year: the outer ring of the shell has small scales representing the 28 days in a lunar month, while the larger scales in the center symbolize the 13 moons of the year. Each of these moons is named after a natural event that takes place during that time.  \nRead more\n"
      }
    ],
    "https://schema.org/datePublished": [
      {
        "@language": "en",
        "@value": "2024-09-03 15:35:13"
      }
    ],
    "https://schema.org/dateModified": [
      {
        "@language": "en",
        "@value": "2024-09-03 17:38:24"
      }
    ],
    "https://schema.org/mainEntityOfPage": [
      {
        "@language": "en",
        "@value": "Download our new, free ReconciliACTION Calendar!"
      }
    ],
    "https://schema.org/headline": [
      {
        "@language": "en",
        "@value": "\tDownload our new, free ReconciliACTION Calendar!\t\t\t\t"
      }
    ],
    "https://schema.org/name": [
      {
        "@language": "en",
        "@value": "Download our new, free ReconciliACTION Calendar!"
      }
    ]
  },
  {
    "@id": "_:g8021980",
    "@type": [
      "https://schema.org/BlogPosting"
    ],
    "https://schema.org/image": [
      {
        "@id": "_:g8022000"
      },
      {
        "@id": "_:g8022040"
      }
    ],
    "https://schema.org/publisher": [
      {
        "@id": "_:g8022120"
      }
    ],
    "https://schema.org/author": [
      {
        "@id": "_:g8022200"
      },
      {
        "@language": "en",
        "@value": "communications"
      }
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "As the National Day for Truth and Reconciliation on September 30 approaches, Wine Rack proudly announces its fourth consecutive year of partnership with the Gord Downie & Chanie Wenjack Fund (DWF). Over the past three years, Wine Rack stores across Ontario have collectively raised over $250,000 in support of DWF, an Indigenous-led national charity that aims to build cultural understanding and create a path toward reconciliation between Indigenous and non-Indigenous peoples. \nRead more\n"
      }
    ],
    "https://schema.org/datePublished": [
      {
        "@language": "en",
        "@value": "2024-08-28 01:00:45"
      }
    ],
    "https://schema.org/dateModified": [
      {
        "@language": "en",
        "@value": "2024-08-27 11:29:22"
      }
    ],
    "https://schema.org/mainEntityOfPage": [
      {
        "@language": "en",
        "@value": "Wine Rack Continues Partnership with Gord Downie & Chanie Wenjack Fund for Fourth Year"
      }
    ],
    "https://schema.org/headline": [
      {
        "@language": "en",
        "@value": "\tWine Rack Continues Partnership with Gord Downie & Chanie Wenjack Fund for Fourth Year\t\t\t\t"
      }
    ],
    "https://schema.org/name": [
      {
        "@language": "en",
        "@value": "Wine Rack Continues Partnership with Gord Downie & Chanie Wenjack Fund for Fourth Year"
      }
    ]
  },
  {
    "@id": "_:g8022360",
    "@type": [
      "https://schema.org/BlogPosting"
    ],
    "https://schema.org/image": [
      {
        "@id": "_:g8022380"
      },
      {
        "@id": "_:g8022420"
      }
    ],
    "https://schema.org/publisher": [
      {
        "@id": "_:g8022500"
      }
    ],
    "https://schema.org/author": [
      {
        "@id": "_:g8022580"
      },
      {
        "@language": "en",
        "@value": "communications"
      }
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "The National Day for Truth and Reconciliation and Orange Shirt Day are crucial moments for reflection and learning about the true history of Canada and the ongoing impacts of residential schools. To support you on your journey toward reconciliation, DWF has compiled a list of recommended readings to deepen your understanding. Each book offers unique perspective and insight into Indigenous cultures and experiences.\nRead more\n"
      }
    ],
    "https://schema.org/datePublished": [
      {
        "@language": "en",
        "@value": "2024-08-27 11:49:59"
      }
    ],
    "https://schema.org/dateModified": [
      {
        "@language": "en",
        "@value": "2024-08-27 11:50:44"
      }
    ],
    "https://schema.org/mainEntityOfPage": [
