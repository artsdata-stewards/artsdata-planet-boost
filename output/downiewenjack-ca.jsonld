    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "Content warning: This post contain information about residential schools. In February 2025, a troubling story out of British Columbia made headlines and reignited a painful conversation.\nRead more\n"
      }
    ],
    "https://schema.org/datePublished": [
      {
        "@language": "en",
        "@value": "2025-05-05 13:39:59"
      }
    ],
