        "@value": "Gord Downie &amp; Chanie Wenjack Fund"
      }
    ],
    "https://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "article"
      }
    ],
    "https://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "World Health Day: Honouring Equity Through Jordan’s Principle - The Gord Downie &amp; Chanie Wenjack Fund"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Each year on April 7, World Health Day raises awareness of global health issues and promotes access to quality healthcare for all. In Canada, this includes recognizing that equitable access to healthcare has not been a reality for Indigenous children, particularly First Nations children living on reserve. Jordan’s Principle exists because of this inequity."
      }
    ],
    "https://ogp.me/ns#url": [
