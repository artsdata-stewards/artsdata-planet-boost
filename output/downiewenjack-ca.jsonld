  {
    "@id": "_:g7847680",
    "@type": [
      "https://schema.org/BlogPosting"
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "Canadian Tire is giving new life to one of Canada’s most beloved symbols — the Hudson’s Bay stripes. After winning a competitive bidding war this summer to acquire the iconic pattern and related trademarks from the defunct Hudson’s Bay Company (HBC), the retailer has unveiled its first limited-edition collection just in time for the holidays.\n"
      }
    ],
    "https://schema.org/headline": [
      {
        "@language": "en",
        "@value": "\tCanadian Tire Revives Hudson’s Bay Stripes with Patriotic Holiday Collection | Startup News\t\t\t\t"
      }
    ],
    "https://schema.org/author": [
      {
        "@language": "en",
        "@value": "communications"
      }
    ]
  },
