        "@value": "2025-11-10 16:17:18"
      }
    ],
    "https://schema.org/mainEntityOfPage": [
      {
        "@language": "en",
        "@value": "DWF Holiday Gift Guide – 2025"
      }
    ],
    "https://schema.org/headline": [
