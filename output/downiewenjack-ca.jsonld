    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "Get In Touch\nE-mail: staff@downiewenjack.ca\nToll-free: 1-833-666-2414\nLocal: 519-964-0393\nAddress:\nPO BOX 749\nOHSWEKEN, ON\nN0A1M0\n"
      }
    ]
  },
