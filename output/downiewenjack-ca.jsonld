    ]
  },
  {
    "@id": "https://downiewenjack.ca/temporary/dd5dfd2c-c6f4-4c1c-be1f-74e0129b7206",
    "@type": [
      "https://schema.org/CreativeWork"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://downiewenjack.ca/category/news/page/2/"
      }
    ],
    "https://schema.org/headline": [
      {
        "@language": "en",
        "@value": "AI Policy at DWF        "
      }
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "The Gord Downie & Chanie Wenjack Fund uses secure, purpose-built AI technologies to improve how we deliver resources and support our network. These tools help keep information up to date using publicly available data, reducing delays, minimizing waste, and ensuring materials reach their intended destination. Privacy is important; no personal information is shared outside of DWF, and you can opt out at any time.\n            "
      }
    ]
  },
  {
    "@id": "https://downiewenjack.ca/temporary/2624b2c6-68f2-4cc0-8a32-2424b55befed",
    "@type": [
      "https://schema.org/CreativeWork"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://downiewenjack.ca/category/news/page/2/"
      }
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "About DWF\nInspired by Chanie’s story and Gord’s call to build a better Canada, the Gord Downie & Chanie Wenjack Fund aims to build cultural understanding and create a path toward reconciliation between Indigenous and non-Indigenous peoples. Our goal is to improve the lives of Indigenous people by building awareness, education, and connections between all peoples in Canada.\nSubscribe to our Newsletter\n"
      }
    ]
  },
  {
    "@id": "https://downiewenjack.ca/temporary/e15ac732-5026-4863-b289-b42c8f272077",
    "@type": [
      "https://schema.org/CreativeWork"
    ],
