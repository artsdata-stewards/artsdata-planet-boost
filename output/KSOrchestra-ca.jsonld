    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "WIND SYMPHONIES - Kindred Spirits Orchestra"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Stravinsky’s Symphonies of Wind Instruments uses rhythmic, harmonic, and melodic devices reminiscent of The Rite of Spring, but is orchestrated for only wind instruments, and uses the plural form—Symphonies—not to denote the piece’s formal construction, but rather to invoke the broader term meaning ‘to sound together.’ Henry From then brings to life the same composer’s Concerto for Piano and Winds—a neo-Romantic"
      }
    ],
    "https://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://ksorchestra.ca/events/wind-symphonies/"
      }
    ],
