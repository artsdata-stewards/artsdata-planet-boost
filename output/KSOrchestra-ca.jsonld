    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Join the Kindred Spirits Orchestra in celebrating the opening concert of the season featuring music that conveys the deepest of emotions. French composer Paul Dukas calls the audience to attention with his Fanfare introduction to the Persian inspired “poème dansé”, La Péri. Pianist Dong Xu returns to the limelight to perform a stunning rare work"
      }
