  {
    "@id": "https://ksorchestra.ca/events/the-french-connection/",
    "https://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "https://ogp.me/ns#site_name": [
      {
        "@language": "en-us",
        "@value": "Kindred Spirits Orchestra - Kindred Spirits Orchestra"
      }
    ],
    "https://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "THE FRENCH CONNECTION - Kindred Spirits Orchestra"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Bizet’s second Carmen Suite includes several well-known tunes from the eponymous opera, including the Habanera, with its characteristic snaking chromatic lines representing Carmen’s seductive wiles, and the rousing Toreador song. Valses Nobles et Sentimentales harkens back to Schubert, who published two sets of waltzes entitles “noble” and “sentimental.” Ravel combines both in his set of"
