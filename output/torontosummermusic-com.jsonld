    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Romantic Inspirations - Toronto Summer Music"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Composers in the Romantic era were often inspired by the works of Ludwig van Beethoven. Some even felt like he was too tough an act to follow: Brahms began writing string sextets in part because he felt too intimidated to write more quartets after Beethoven! These pieces all their own tip-of-the-hat to the great Ludwig Van. "
      }
    ],
