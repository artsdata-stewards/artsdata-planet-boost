    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Both Franz Schubert and Kelly-Marie Murphy used Beethoven’s famous Septet in E-flat Major as the starting point for their compositions. Separated by almost 200 years, both composers look through Beethoven’s lens for their inspiration... "
      }
