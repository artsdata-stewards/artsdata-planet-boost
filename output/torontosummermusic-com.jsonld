      {
        "@language": "en",
        "@value": "New Horizons - Toronto Summer Music"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "This amazingly talented group of artists is making big waves in the music world. From Kerson Leong’s “supreme mastery” (Le Devoir), to Angela Schwarzkopf’s JUNO-award-winning performances of new Canadian compositions, and Stéphane Tétreault’s “playing of the highest order” (Gramophone), this trio embodies what New Horizons means to TSM.    "
      }
    ],
