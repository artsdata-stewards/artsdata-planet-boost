      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
  {
    "@id": "https://naccnt.ca/temporary/29e408f5-1d2d-4f03-82fa-f5c9c723fe29",
