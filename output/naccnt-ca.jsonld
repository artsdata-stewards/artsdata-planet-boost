    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Bella Beats Celebration of Dance!"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Join us for a celebration of dance and movement, featuring performances in a variety of genres.&nbsp;This special one-day showcase highlights the passion and artistry of the Bella Beats Dance Troupe as they bring their repertoire to life on stage.Get ready for a fun, energetic performance that will leave you inspired, smiling, and tapping your feet!&nbsp;...&lt;/p&gt;\\n"
      }
