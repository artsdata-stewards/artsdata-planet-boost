    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Kick-Ass Love: An Evening with Trevor Kasteel"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;COURAGE + SUFFERING = RESILIENCE Join Northern builder, father, and mental health advocate Trevor Kasteel for the official launch of his debut book, podcast, and speaker series,&nbsp;Kick-Ass Love, on the two-year anniversary of the public breakdown that changed his life. Trevor chose courage over silence. This evening of storytelling and conversation promises to inspire, provoke...&lt;/p&gt;\\n"
      }
    ],
