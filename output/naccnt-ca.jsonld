        "@language": "en",
        "@value": "TRANSHUMANIST / SUPERHUMAN"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;NEXT ZONE is a Denmark based company working with OPEN STYLE DANCE.&nbsp;&nbsp;Choreographer Lene Boel works with dancers from different street dance backgrounds such as popping, locking, electro, break dance, hip hop, and new circus. She creates a distinct choreographic language which is unique for each production and very visceral. The pieces challenge the language of...&lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": "Organization"
      }
    ],
