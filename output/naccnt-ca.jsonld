    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Pantalone Runs For Mayor: Naughty Night Out"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;PANTELONE RUNS FOR MAYOR!A Commedia dell’Arte Spectacle Commedia dell’Arte,&nbsp;a form of improvisational theatre that relies on stock-characters, slapstick humour costumes, props and masks, is coming to NACC! Something strange is happening in town… The mayor’s gone, the power vacuum is pulling in all the usual suspects, and&nbsp;ambition, greed, and sheer stupidity are on the rise....&lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": "Organization"
      }
    ],
