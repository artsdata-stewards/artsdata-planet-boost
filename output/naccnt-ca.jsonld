    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Comic Strippers"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;19+ ONLY! WARNING! No Extreme Nudity, Just Extreme Hilarity! The award-winning improv comedians are back with a new show with more moves and even quicker wits. A fictitious male stripper troupe (played by some of Canada’s best improvisational comedians) perform a sexylarious improv comedy show. They’re trying to be sexy… but it just comes out...&lt;/p&gt;\\n"
      }
    ],
