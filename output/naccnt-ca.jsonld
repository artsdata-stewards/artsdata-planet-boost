    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Children of God&nbsp;is must-see theatre for Canadians.Marsha Lederman, The Globe and Mail Children of God is a musical about an Oji-Cree family whose children were taken away to a residential school in Northern Ontario. The story of Rita, a mother who was never let past the school’s gate, and her kids, Tom and Julia, who...&lt;/p&gt;\\n"
      }
