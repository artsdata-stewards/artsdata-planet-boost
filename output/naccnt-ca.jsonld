    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;UPPERCUT DANSETEATREINTERNATIONAL GUESTS FROM DENMARK BENCHED is a brutally honest bodily tale about life’s big and very small questions. About settling down. About daring to sit in opposition, about sitting cross legged, about being sat, put off or benched. About taking, creating, and giving space, and preferably remembering to do so before falling on your...&lt;/p&gt;\\n"
      }
