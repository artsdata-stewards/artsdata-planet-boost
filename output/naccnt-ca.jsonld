    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "ICONIC: A Tribute to the Greats (Senior Show)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Three hundred Bella Dance Academy students hit the NACC stage with Iconic: A Tribute to the Greats! Get ready to sing along, tap your feet, and relive the moves you know and love as our dancers bring legendary performers to life. Join us as we celebrate the artists who have shaped music, dance, and pop culture -...&lt;/p&gt;\\n"
      }
    ],
