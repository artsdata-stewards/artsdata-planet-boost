    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Yellowknife’s own&nbsp;Tyler Hawkins, recognized for his versatile guitarist work, levels up with this rare performance on his Baroque Lute featuring the music of Weiss, Bach and Gauthier. He received a BFA Honours in Performance on multi-string classical guitars (1990) and later released both online and CD versions of Tyler Hawkins - Bach on Seventeen Strings...&lt;/p&gt;\\n"
      }
