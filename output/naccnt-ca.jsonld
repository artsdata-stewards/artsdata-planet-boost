    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Alex Mackenzie&#8217;s Never Been Better Tour"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Alex Mackenzie is taking the comedy world by storm, and his Never Been Better tour proves why. Mackenzie gave up everything: his house, his job, and even the respect of his family to pursue his stand-up dreams. He has never looked back. After years of relentless hustle, that gamble is paying off in a big...&lt;/p&gt;\\n"
      }
