    "http://schema.org/name": [
      {
        "@value": "Johnny Cole &#8211; Meet me at The Rex&lt;span style=&quot;color:black&quot;&gt; in Hay River&lt;/span&gt;"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Celebration of Metis Roots For fifty years, Norman Glowach has been playing music in Yellowknife. He started playing the drums, but he also sings and plays guitar. Growing up in Yellowknife, Norm has been fortunate to play many styles of music. At an early age, he played in school bands and stage bands. Professionally, he\\'s...&lt;/p&gt;\\n"
      }
    ],
