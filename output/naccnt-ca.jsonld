    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Tracy Turnblad, a teenager with all the right moves, is obsessed with the Corny Collins Show. Every day after school, she and her best friend Penny run home to watch the show and drool over the hot Link Larkin, much to Tracy\\'s mother Edna\\'s dismay. After one of the stars of the show leaves, Corny...&lt;/p&gt;\\n"
      }
