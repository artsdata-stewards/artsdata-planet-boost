    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Change Makers &#8211; A Choir Concert"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;In an ever-changing world, our choirs sing about Change Makers: the people and things that shape change around us. The music is diverse, inspired by a world premiere performance of&nbsp; “A Pine Point Story,” written for us by Canadian choral composer Stuart Beatch. The song commemorates the poignant and powerful legacy of Everett Klippert and...&lt;/p&gt;\\n"
      }
