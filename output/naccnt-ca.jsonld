    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;By NYATA-NYATA Dance Company Mozongi (Return) is a piece about time and, more precisely, the physics of time. The step is weight, and weight is time. Not repetition, but persistence....&lt;/p&gt;\\n"
      }
