    "http://schema.org/name": [
      {
        "@value": "40th Anniversary Showcase in Inuvik"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;NACC’s 40th Anniversary will be a celebration of exceptional talent and dynamic northern art forms from across the broad expanse of Denendeh. From the great fiddling dynasties flowing deep and swiftly like the great Deh Cho river, to the shining lights of Indigenous voices, the show will celebrate some of the major milestones and remember...&lt;/p&gt;\\n"
      }
