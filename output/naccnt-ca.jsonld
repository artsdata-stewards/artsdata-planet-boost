      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;As the sun-kissed summer of 1958 draws to a close, Danny, a sweet American boy, and Sandy, a wholesome exchange student, exchange vows of everlasting devotion and part ways, seemingly forever. However, an unexpected change of plans reunites the young dreamers at the bustling Rydell High for the new term; only, this year, something has...&lt;/p&gt;\\n"
      }
