    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Hairspray Sing-A-Long"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Tracy Turnblad, a teenager with all the right moves, is obsessed with the Corny Collins Show. Every day after school, she and her best friend Penny run home to watch...&lt;/p&gt;\\n"
