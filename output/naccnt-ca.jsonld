    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "&lt;span style=&quot;color:black&quot;&gt; NACC Presents: &lt;/span&gt;BENCHED"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;UPPERCUT DANSETEATREINTERNATIONAL GUESTS FROM DENMARK BENCHED is a brutally honest bodily tale about life’s big and very small questions. About settling down. About daring to sit in opposition, about sitting...&lt;/p&gt;\\n"
      }
    ],
