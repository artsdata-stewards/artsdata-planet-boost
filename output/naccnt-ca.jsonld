    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Spectacle d’humour avec Neev"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Neev est un humoriste au style mordant, rapide et sans filtre. Avec ses origines marocaines et françaises et son éducation québécoise, il transforme son vécu en anecdotes percutantes et en absurdités brillantes. Habitué des galas Juste pour rire et ComediHa!, il a aussi assuré pendant plusieurs années les premières parties de Louis-José Houde. Il présente...&lt;/p&gt;\\n"
      }
