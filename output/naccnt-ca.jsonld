        "@id": "https://naccnt.ca/event/pantalone-runs-for-mayor-family-friendly/"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-11-07T19:00:00-07:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
