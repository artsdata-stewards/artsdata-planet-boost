    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;“Connections” brings Fireweed Children’s Chorus and Aurora Chorealis on stage together with Òran (from Edmonton’s Korora Choirs) and Munya Mataruse.&nbsp; We sing in our separate formations, and we sing together...&lt;/p&gt;\\n"
      }
