  {
    "@id": "https://dancevictoria.com/event/still-with-us-a-legacy-of-hiv-aids-in-the-arts/2025-11-22/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-ca",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
