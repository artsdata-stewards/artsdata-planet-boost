    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "FREE Dance Improvisation Workshop - Dance Victoria"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Dance Victoria welcomes Residency Artist Stacey Horton, who will use her time at DV Studios to develop the choreography for her latest work, Framed. As part of her residency, Stacey will be offering a free dance improvisation workshop. Register here beginning 10am June 3 What to Expect This all-levels workshop invites creativity, play, and exploration through movement […]"
      }
    ],
