    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "FREE Hung Dance Workshop | BIRDY Repertoire"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Join Taiwan’s Hung Dance for a workshop blending body isolation and Tai Chi, exploring the dynamic balance between motion and stillness. Register online beginning 12pm, Nov. 3 This dance workshop introduces Hung Dance’s signature movement vocabulary, exploring the dynamic interplay between motion and stillness in the body. The technique blends body isolation with Tai Chi [&hellip;]"
      }
    ],
