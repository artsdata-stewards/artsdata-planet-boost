        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "STILL WITH US: A Legacy of HIV/AIDS in the Arts - Dance Victoria"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "This cross-disciplinary project is anchored by an exhibition in downtown Victoria running from 24 October through 1 December 2025. Featuring archival materials, films, and visual art, the exhibit tells a multi-faceted story of loss, advocacy, and hope emanating from the first waves of the AIDS epidemic (1980s through 1990s) and Victoria’s remarkable response. Part of […]"
      }
    ],
