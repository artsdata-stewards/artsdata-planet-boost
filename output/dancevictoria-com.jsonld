    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Open House Q&#038;A for CDP—Projects"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Want to learn more about CDP–Projects? Join us for an in-person Q&amp;A In 2025, Dance Victoria will allocate $44,790 to Western Canadian dance artists through the prestigious Chrystal Dance Prize–Projects (CDP). This award supports exceptional dance research and/or creation between Western Canadian dance artists, collectives, or companies and their international collaborators. We want to hear [&hellip;]"
      }
    ],
