  {
    "@id": "https://www.centrekabir.com/temporary/0ec11f65-968f-40b2-922b-88bb6cc29dc7",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.centrekabir.com/events/soiree-de-poesie-avec-madhur-anand/"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nDans ses efforts d"
      },
      {
        "@language": "fr",
        "@value": "\n\t\t\t\t\t\t\t\t\t\n\t\n\t\t\n\t\t\t\n\n\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tDans ses efforts d’apporter des activités poétiques de haute qualité à la ville, Kabir Centre Poetry Club vous invite chaleureusement à une soirée avec le Dr Madhur Anand.\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\t\n\t\t\t\n\t\t\n\t\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tAnand est professeur d’écologie et a publié son 2ème recueil de poèmes : Oscillations parasites qui traite de sujets liés à l’environnement et à la diaspora indienne et aux oiseaux.\nElle lira la poésie de ce livre, suivie de la lecture de ses mémoires « This Red Line Goes Straight to Your Heart » et s’engagera ensuite dans des questions-réponses avec le public.\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\t\n\t\t\t\n\t\t\n\t\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tFriday 19th August, 6 :30 pm – vendredi 19 août 2022, 18h30\nHall M-450, Grande Bibliotheque, 475 De Maisonnneuve E (Metro : Berri-UQAM)\nAdmission sans frais, réservation conseillée : https://lepointdevente.com/billets/cck220819001\n\n\t\t \n\t \n"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g2063860"
      }
    ],
