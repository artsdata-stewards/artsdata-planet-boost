  },
  {
    "@id": "https://www.centrekabir.com/temporary/5910a199-c4bd-4b5e-be41-d5924624fd40",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.centrekabir.com/en/events/soiree-de-poesie-avec-madhur-anand/var/ri-0.l-L2"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\nCome"
      },
      {
        "@language": "en",
        "@value": "\n\t\t\t\t\t\t\t\t\t\n\t\n\t\t\n\t\t\t\n\n\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tCome meet the distinguished Canadian Governor General Award Winner, Poet & Professor over a cup of tea!\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\t\n\t\t\t\n\t\t\n\t\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tIn its endeavour to bring poetic activities of high quality to town, Kabir Centre Poetry Club warmly invites you to an evening with Dr Madhur Anand. Anand is an Ecology professor and released her 2nd collection of poems : Parasitic Oscillations that deals with topics related to the environment and the Indian diaspora and birds. She will be reading poetry from this book followed by reading from her memoir “This Red Line Goes Straight to Your Heart” and thereafter engage in Q&A with the public.\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\t\n\t\t\t\n\t\t\n\t\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tFriday 19th August, 6 :30 pm – vendredi 19 août 2022, 18h30\nHall M-450, Grande Bibliotheque, 475 De Maisonnneuve E (Metro : Berri-UQAM)\nAdmission Free, Reservation advised: https://thepointofsale.com/tickets/cck220819001\n\n\t\t \n\t \n"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g5070540"
      }
    ],
