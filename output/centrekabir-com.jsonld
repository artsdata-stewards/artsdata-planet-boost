  {
    "@id": "https://www.centrekabir.com/temporary/0b44a88b-9dcc-44f6-942f-43621945b8c5",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.centrekabir.com/events/echos-du-coeur-sherbrooke-copy/"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nLE CENTRE CULTUREL KABIR EST FIER DE PRÉSENTER\nen collaboration avec le Festival Accès Asie\nParles d"
      },
      {
        "@language": "fr",
        "@value": "\n\t\t\t\t\t\t\t\t\t\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tLE CENTRE CULTUREL KABIR EST FIER DE PRÉSENTER\nen collaboration avec le Festival Accès Asie\nParles d’ailleurs\nSUROJIT O BONDHURA – du Pays de Tagore, Chansons Folk & Baul du Bengale\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tArtistes\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tSurojit Chatterjee: Chanteur principal/multi-instrumentaliste\nRajib Mishra – Guitar, percussions\nAgniv Mukherjee – Batterie, tabla, Khol, Khanjira\nMainak Sengupta – Basse, percussions\nJean-François Sauriol – Violoncelle, Mandoline\nRaja Bhattacharya – Sarod\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tDate :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tHeure :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tLieu :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tsamedi 18 mai 2024\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t20h\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tLe Gesu\n1200 rue de Bleury, Montreal\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tBillets :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tlegesu.com\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\n"
      }
    ],
