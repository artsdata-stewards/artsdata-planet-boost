    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n"
      },
      {
        "@language": "en",
        "@value": "\n\t\t\t\t\t\t\t\t\t\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tKABIR CULTURAL CENTRE IS PLEASED TO PRESENT\nMulti-faith Expressions in Classical Music\n \n\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tArtistes\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\t2 to 3 pm: Andrew Kay – Saxophone\nRigved Deshpande – Tabla\n3:20 to 4:20 pm: Aditya Chakravarthy – Chants\nAnjana Srinivasan – Violin\nArvind Venkataraman – Mridangam\n6 to 7 pm: Ensemble Scholastica\nHildegard et ses saintes\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tDate :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tTime :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tVenue :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tSunday October 20, 2024\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t14H – 19H\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tStudio Jean-Valcourt du Conservatoire\n4750 Henri Julien Ave,\nMontreal, Quebec H2T 2C8\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tBillets :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tFree/Gratuit (Donations Welcome)\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\n"
      }
    ],
