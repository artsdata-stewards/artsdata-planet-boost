      {
        "@language": "fr",
        "@value": "\n\t\t\t\t\t\t\t\t\t\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tLE CENTRE CULTUREL KABIR EST FIER DE PRÉSENTER\n\nSONGS OF DHARWAD\nUN SUPERBE CONCERT DE MUSIQUE HINDOUSTANIE CHANTÉE\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tArtistes\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tKaivalya Kumar Gurav\nMushfiq Hashimi\nSubhen Chatterjee\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tDate :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tHeure:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tLieu:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tVendredi 11 avril 2025\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t18h30\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tUnion Française de Montréal\n429 Avenue Viger Est\n(Metro: Champ-de-mars)\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tAdmission :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tthepointofsale.com\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\n"
