    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Écrit par l"
      },
      {
        "@language": "fr",
        "@value": "\n\t\t\t\t\t\t\t\t\t\n\t\n\t\t\n\t\t\t\n\t\t\t\n\t\t\n\t\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tÉcrit par l’auteur célèbre de ‘La vie secrète des abeilles’, un best-seller du New York Times sur deux femmes américaines inoubliables. Sue Monk Kidd présente un chef-d’œuvre d’espoir, d’audace, de quête de liberté et de désir de faire entendre sa voix dans le monde.\n\n\t\t \n\t \n"
      }
    ],
