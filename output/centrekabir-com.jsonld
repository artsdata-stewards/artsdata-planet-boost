  {
    "@id": "https://www.centrekabir.com/temporary/7dbace68-c969-4dfc-94bb-5dab6657b54f",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.centrekabir.com/events/festival-des-films-de-lasie-du-sud-au-saguenay/"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le Centre culturel Kabir a présenté, au printemps 2025, la 14e édition du Festival des films de l’Asie du Sud à Montréal. Tous les films sont soigneusement sous-titrés en français,"
      },
      {
        "@language": "fr",
        "@value": "\n\t\t\t\t\t\t\t\t\tLe Centre culturel Kabir a présenté, au printemps 2025, la 14e édition du Festival des films de l’Asie du Sud à Montréal. Tous les films sont soigneusement sous-titrés en français, favorisant l’accessibilité et le dialogue interculturel. Une mini-édition est organisée au Saguenay du 21 au 23 novembre, grâce à une collaboration inspirante avec les bibliothèques de la Ville de Saguenay, le Cégep de Jonquière et le Cinéclub de Jonquière. Cette initiative tisse des ponts entre les communautés et célèbre la richesse du cinéma sud-asiatique à travers le Québec.\n"
      }
    ],
