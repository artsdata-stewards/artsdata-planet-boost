    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n"
      },
      {
        "@language": "en",
        "@value": "\n\t\t\t\t\t\t\t\t\t\n\t\n\t\t\n\t\t\tARTISTS\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tSANHITA NANDI – CHANTS HINDOUSTANIS\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tSUSHANT ANANTRAM  – HARMONIUM\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tRIGVED DESHPANDE  – TABLA\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tDATE:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tTime:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tVenue:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tSamedi 22 avril 2023\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t8:00pm\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tÉCOLE DE MUSIQUE ARQUEMUSE\n151-A Rue Saint-François E,\nQuébec, QC G1K 2Y6\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tBillets :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tthepointofsale.com\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tWATCH: (237) Promo: Shakhsiyat with Sanhita Nandi – YouTube\nWhat a discover… Sanhita is God’s blessing!\nHer voice flows like pure and clear water in a creek – Reviewer on Amazon.com\n\n\t\t \n\t \n\n"
      }
    ],
