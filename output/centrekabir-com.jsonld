  {
    "@id": "https://www.centrekabir.com/events/ecstasy-of-indian-violin/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-fr",
        "@value": "fr_FR"
      }
    ],
    "http://ogp.me/ns#type": [
