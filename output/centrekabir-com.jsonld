      {
        "@language": "en",
        "@value": "\n\t\t\t\t\t\t\t\t\t\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tKABIR CULTURAL CENTER IS PLEASED TO PRESENT\nGARDEN OF LITERARY DELIGHTS – 2024\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tArtists/Writers\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tVeena Gokhale (Curator)\nJanika Oza \n Mariam Pirbhai \n Mitali Banerjee \n Shahroza Nahrin \n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tDate :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tTime :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tVenue :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tSunday, September 29, 2024\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t6pm to 8pm\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tLe Gesù \n1200 rue De Bleury\nMontréal, QC, H3B 3J3\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tAdmission :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tPlease donate.\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\n"
      }
