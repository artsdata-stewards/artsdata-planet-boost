      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Kabir Cultural Centre presented the 14th edition of the South Asian Film Festival of Montreal in the spring of 2025. All films are carefully subtitled in French, thus promoting intercultural"
      },
      {
        "@language": "en",
        "@value": "\n\t\t\t\t\t\t\t\t\tKabir Cultural Centre presented the 14th edition of the South Asian Film Festival of Montreal in the spring of 2025. All films are carefully subtitled in French, thus promoting intercultural access and dialog. A mini-edition will be presented in Saguenay from 21st to 23rd November, thanks to an inspiring collaboration with the Bibliothèques de la ville de Saguenay, Cégep de Jonquière and the ciné-club of Jonquière. This initiative builds bridges between communities and celebrates the richness of South Asian cinema.\n"
      }
    ],
