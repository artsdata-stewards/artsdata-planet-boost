      {
        "@language": "fr",
        "@value": "\n\t\t\t\t\t\t\t\t\t\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tLE CENTRE CULTUREL KABIR EST HEUREUX DE PRÉSENTER\nEN COLLABORATION AVEC L’ÉCOLE DE MUSIQUE ARQUEMUSE\nBANSURI BLISS\nUN CONCERT ENVOÛTANT DES MÉLODIES\nET DES RYTHMES INDIENS\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tArtistes\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tRonu Majumdar\nIndranil Mallick\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tDate :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tHeure:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tLieu:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tSamedi 22 Mars 2025\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t19h30\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tSalle de concert de l’Arquemuse\n151-A, Rue Saint-François E\nQuébec, G1K 3A7\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tAdmission :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tthepointofsale.com\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\n"
