      {
        "@language": "fr",
        "@value": "\n\t\t\t\t\t\t\t\t\t\n\t\n\t\t\n\t\t\t\n\t\t\t\n\t\t\n\t\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tVenez apprécier et encourager ces jeunes artistes canadiens qui vont donner des mini-concerts. Il y des spectacles de musique Carnatique, de danse Kathak et odissi et la musique hindoustanie performés par des artistes brillants.\nCinq mini-concerts de 14h00 à 20h30, qui vous aménent de la chaleur de l’été indien!!!\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tADMISSION AND SNACKS FREE; DONATIONS WELCOME!\n\n\t\t \n\t \n"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1177080"
      }
    ],
