  {
    "@id": "https://www.centrekabir.com/temporary/c9c7cf4a-6587-48c8-ae67-0d3c7e51eee6",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.centrekabir.com/events/concert-de-soufi-qawwali-avec-fareed-ayaz-abu-muhammad-ensemble/"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "[vc_row css_animation=\"\" row_type=\"row\""
      },
      {
        "@language": "fr",
        "@value": "\n\t\t\t\t\t\t\t\t\t\n\t\n\t\t\n\t\t\t\n\n\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\t\n\n\nANNULÉ à cause des considérations de santé publique.\n\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t\n\t\t\t\n\t\t\n\t\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\t\n\n\nOriginaires du Pakistan, l’Ensemble Fareed Ayaz & Abu Muhammad figure parmi les chanteurs les plus distingués du Qawwali, une musique étonnante que l’occident a su découvrir il y a quelques années grâce à Nusrat Fateh Ali Khan, lui aussi du Pakistan. Le Qawwali est une musique dévotionnelle soufie, désignée comme ‘le chemin du cœur’. Elle trouve ses racines dans la poésie islamique ancestrale et exprime les ardeurs les plus passionnées des grands mystiques soufis. Le Qawwali entraîne l’auditeur dans un monde transcendantal de chants à la fois humains et divins. Initiées par une rythmique méditative, les hymnes et mélodies entonnées évoluent généralement vers une intensité toujours plus percutante. Avec les bras souvent tendus, les chanteurs s’abandonnent chacun à leur tour, à l’émotion intense de leurs inspirations pour le moins riche en effets spectaculaires.\n\n\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\t\n\t\t\t\n\t\t\n\t\n\n\t\n\t\t\n\t\t\t\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\t\t \n\t \n"
      }
    ],
