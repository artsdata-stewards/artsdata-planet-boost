      },
      {
        "@language": "fr",
        "@value": "\n\t\t\t\t\t\t\t\t\t\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tLE CENTRE CULTUREL KABIR EST HEUREUX DE PRESENTER\nEn partenariat avec le Gesù – Centre de créativité\nANANTYA\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tArtistes\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tKaberi Sen\nAnjan Saha\nPankaj Mishra\nArup Chattopadhyay\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tDate :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tHeure :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tLieu :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tdemanche 27 octobre 2024\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t19H\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tAmphithéâtre du Gesù\n1200 rue de Bleury\nMontreal , ON\n(Métro: Place-des-arts)\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tBillets :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tlegesu.tuxedobillet.com\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\n"
      }
