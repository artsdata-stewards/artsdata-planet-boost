  {
    "@id": "https://www.centrekabir.com/temporary/c46681db-e99a-4c86-b5c1-fe34b4cff3c6",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.centrekabir.com/en/events/inescapes/var/ri-0.l-L2"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Nedjma Ziarati is a visual artist born to an Iranian father and an Algerian-German mother, currently based in Montreal. From a young age, she was"
      },
      {
        "@language": "en",
        "@value": "\n\t\t\t\t\t\t\t\t\tNedjma Ziarati is a visual artist born to an Iranian father and an Algerian-German mother, currently based in Montreal. From a young age, she was drawn to the world of drawing and painting, a passion that has shaped her life and artistic path. Her deep love for history and cultures led her to the traditional art of Persian miniature painting, a practice she continues to study and refine with care and persistence. In parallel with her traditional training, Nedjma pursued a BFA in Painting and Drawing at Concordia University, where she developed a contemporary approach to painting. Her current work blends the intricate aesthetics of Persian miniature with a personal visual language—one that reflects her inner world, cultural identity, and lived experience. Through this synthesis, she explores themes of beauty, visibility, memory, and belonging with both intimacy and precision.\nNedjma calls her paintings ‘Inscapes’, meaning inner landscapes where she translates moods, emotions, and memories. These dense visual spaces also address questions of identity and representation, incorporating symbolic or figurative elements that reflect her different facets. Her work seeks to explore how inner experiences can take shape within the image while engaging in dialogue with the outer world.\n"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g4421380"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.centrekabir.com/en/events/inescapes/var/ri-0.l-L2"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "NEXGEN FESTIVAL - INSCAPES"
      }
    ],
    "http://schema.org/image": [
