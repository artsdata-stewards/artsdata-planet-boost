  {
    "@id": "https://www.centrekabir.com/temporary/31e0c00d-bd4f-4e50-bb0b-398f69be0195",
    "@type": [
      "http://schema.org/WebPage"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.centrekabir.com/"
      },
      {
