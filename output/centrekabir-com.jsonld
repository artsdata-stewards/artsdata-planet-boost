    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Meet Sheila James, the award-winning author of ‘Outcaste, a novel’. Sheila is an award-winning author and videographer, produced playwright and has performed, composed and recorded original music for stage, screen and broadcast. She is a recognized leader in equity, diversity and inclusion subject and is the Executive..."
      }
    ],
