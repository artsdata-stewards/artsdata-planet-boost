    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "- Kabir Centrefor Arts & Culture"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Pandit Kaivalya Kumar, hailing from Dharwad in India, is an exciting young exponent of Kirana Gharana. He brings a certain flamboyance to his renditions with sharp tonal quality, agile pace, vocal tenor and feverish dedication to music. He will be accompanied on tabla by the equally flamboyant Pandit Subhen Chatterjee and on melodious harmonium by Pandit Sanatan Goswami"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "en",
        "@value": "en-US"
      }
    ],
