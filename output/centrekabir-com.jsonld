    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.centrekabir.com/en/events/expression-de-danses-multi-foi-nexgen/"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "[vc_empty_space"
      },
      {
        "@language": "en",
        "@value": "\n\t\t\t\t\t\t\t\t\t\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tKABIR CULTURAL CENTER IS PLEASED TO PRESENT\nMulti-faith Expressions through Classical Dances \n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tArtists\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\t2 to 3 pm: Jayeeta Banerjee – Bharatanatyam\n3:30 to 4:30 pm: Surya Jade Edakunni – Kuchipudi\n5 to 6 pm: Ensemble Art of Kathak – Kathak Dance\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tDate :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tTime :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tVenue :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tSaturday October 19, 2024\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t14H – 18H\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tStudio Jean-Valcourt du Conservatoire\n4750 Henri Julien Ave,\nMontreal, Quebec H2T 2C8\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tAdmission :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tFree/Gratuit (Donations Welcome)\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\n"
      }
    ],
