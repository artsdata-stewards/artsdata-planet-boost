  {
    "@id": "https://www.centrekabir.com/temporary/d2d50a7a-19a8-4681-b469-7b17d7697d96",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.centrekabir.com/en/events/expression-de-danses-multi-foi-nexgen-2/var/ri-0.l-L2"
