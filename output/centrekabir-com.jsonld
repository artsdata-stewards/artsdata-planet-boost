        "@language": "en-us",
        "@value": "NEXGEN FESTIVAL - INSCAPES - Le Centre Kabir pour les Arts & la Culture"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Nedjma Ziarati is a visual artist born to an Iranian father and an Algerian-German mother, currently based in Montreal. From a young age, she was drawn to the world of drawing and painting, a passion that has shaped her life and artistic path. Her deep..."
      }
    ],
