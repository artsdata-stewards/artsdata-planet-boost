      {
        "@language": "fr",
        "@value": "\n\t\t\t\t\t\t\t\t\t\n\t\n\t\t\n\t\t\tArtistes\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tMohiniattam\n \nSwathi Sreedharan\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tOdissi\n \nRagamalika Mohanraj\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tDATE:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tHeure:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tLieu:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tdimanche 22 octobre\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t13h  – 15h30\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tConservatoire de musique de Montréal\n4750 Henri Julien Ave, Studio Multimedia\nMontreal, Quebec H2T 2C8\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tBillets :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tconservatoire-montreal.tuxedobillet.com\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\n"
      }
