  {
    "@id": "https://www.centrekabir.com/temporary/8c52013a-e8aa-4356-86f5-d5f5283d1171",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.centrekabir.com/events/ffasm/"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\n\n\n\n\n\nLe festival des films de l’Asie du Sud de Montréal, tant attendu, est ici dans sa 8e édition."
      },
      {
        "@language": "fr",
        "@value": "\n\t\t\t\t\t\t\t\t\t\n\t\n\t\t\n\t\t\t\n\t\t\t\n\t\t\n\t\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\t\n\n\n\nLe festival des films de l’Asie du Sud de Montréal, tant attendu, est ici dans sa 8e édition. Il sera présenté lors de deux fins de semaine dans 10 séances. En tout il y aura 26 films, provenant de 11 pays suivis de discussions super-intéressantes avec des cinéastes et des panélistes. Un événement, absolument à ne pas manquer!\nPOUR LES DÉTAILS DES FILMS ET LA BILLETTERIE,\nVOIR: WWW.SAFFM.CENTREKABIR.COM\n\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t\nFESTIVAL RUNS FROM 26 OCT 2018 TO 4 NOV 2018\nLE FESTIVAL AURA LIEU DU 26 OCT 2018 AU 4 NOV 2018\n\n\n\t\t \n\t \n"
      }
    ],
