  {
    "@id": "https://www.centrekabir.com/temporary/74c6bdc1-d2a9-4907-a758-de6ec57961ff",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.centrekabir.com/en/events/santoor-reverie-montreal/var/ri-0.l-L2"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\nKABIR CULTURAL CENTRE IS PLEASED TO PRESENT\n\n\nSANTOOR REVERIE\nA SERENE AND SPARKLING CONCERT WITH THE\nHUNDRED-STRINGED WONDROUS INSTRUMENT"
      },
      {
        "@language": "en",
        "@value": "\n\t\t\t\t\t\t\t\t\t\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tKABIR CULTURAL CENTRE IS PLEASED TO PRESENT\n\nSANTOOR REVERIE\nA SERENE AND SPARKLING CONCERT WITH THE\nHUNDRED-STRINGED WONDROUS INSTRUMENT FROM KASHMIR\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tArtists\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tPandit Satish Vyas – Santoor\nMukundraj Deo – Tabla\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tDate :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tHeure:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tLieu:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tSaturday 14 June 2025\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t6:30 PM\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tLa Toscadura\n4388 Boul. St Laurent\nMontreal, QC\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tAdmission :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\ttickets.venuepilot.com\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\n"
      }
    ],
