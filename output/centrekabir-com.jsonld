  {
    "@id": "https://www.centrekabir.com/temporary/b00a161f-8fdb-49ae-a69e-cd44a361949c",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.centrekabir.com/en/events/artasie/var/ri-0.l-L2"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "ARTASIA\n\n,\n\nPRESENTED BY KABIR CENTRE IN COLLABORATION WITH PROMIS\n\nRARE OPPORTUNITY DESIGNED ESPECIALLY FOR YOU, FANS OF SOUTH ASIAN CLASSICAL ARTS!\n\nAll you"
      },
      {
        "@language": "en",
        "@value": "\n\t\t\t\t\t\t\t\t\t\n\t\n\t\t\n\t\t\t\n\t\t\t\n\t\t\n\t\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tARTASIA\n,\nPRESENTED BY KABIR CENTRE IN COLLABORATION WITH PROMIS\nRARE OPPORTUNITY DESIGNED ESPECIALLY FOR YOU, FANS OF SOUTH ASIAN CLASSICAL ARTS!\nAll you wanted to know about the classical arts of South Asia… Come to listen to the professionals of these arts and learn their mysteries and beauties through interesting interactive sessions.\nSubjects covered in 12 interactive sessions\nSaturday 8 September: Hindustani Music 3 pm, Carnatic Music: 5 pm, Sarod: 7 pm\nSunday 9 September: Tabla 3 pm, Sitar 5 pm, Kathak Dance 7 pm\nSaturday 15 September: Mridangam 3 pm, Qawwali 5 pm, Odissi Dance 7 pm\nSunday 16 September: Kathakali Dance 3 pm, Bharatanatyam Dance 5 pm, Carnatic Violin 7 pm.\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t\nCoffee & Snacks free; admissions free; Donations welcome. Three sessions each from 3 pm to 9 pm on 8,9,15,16 September Information: 514 620 4182\n\n \n\n\t\t \n\t \n"
      }
    ],
