    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\n"
      },
      {
        "@language": "fr",
        "@value": "\n\t\t\t\t\t\t\t\t\t\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tLE CENTRE CULTUREL KABIR EST HEUREUX DE PRESENTER\nSOIRÉE DE POÉSIE & RÉFLEXIONS\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tArtistes\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tCommissaire: Ambica Sharma\nPoètes and Panélistes: Bhaswati Ghosh & Gurinderjit Singh\nPoètes :\nAfreina Noor\nAmal Khalid\nArwa A Wahid\nLéïa St-Pierre\nDeepinder Singh Sindu\nSaurabh Saraswat\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tDate :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tHeure :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tLieu :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tsamedi 28 septembre 2024\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t18H – 21H\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tLe Gesù \n1200 rue De Bleury\nMontréal, QC, H3B 3J3\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tAdmission :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tS’il vous plaît, faites un don\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\n"
      }
    ],
