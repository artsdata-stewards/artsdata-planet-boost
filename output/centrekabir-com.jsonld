  {
    "@id": "https://www.centrekabir.com/temporary/39df8928-9f8a-4f8e-a0af-514b7f91fef4",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.centrekabir.com/en/events/masterclass-kuchipudi-dance/var/ri-0.l-L2"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Haleem Khan, a master of KUCHIPUDI, with more than 800 shows to his credit will be in Canada to partcipate in"
      },
      {
        "@language": "en",
        "@value": "\n\t\t\t\t\t\t\t\t\t\n\t\n\t\t\n\t\t\t\n\t\t\t\n\t\t\n\t\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tHaleem Khan, a master of KUCHIPUDI, with more than 800 shows to his credit will be in Canada to partcipate in The Great India Festival of Ottawa. We are bringing him to Montreal, so all dance-lovers could learn something about the art of this classical dance of South India. A great opportunity for dance students and their gurus. See http://www.haleemkhan.com.\n\n\t\t \n\t \n"
      }
    ],
