    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nLE CENTRE CULTUREL KABIR EST HEUREUX DE COLLABORER AVEC\nBHARTIYA SANGEETHA SANGHAM DANS LA PRESENTATION DE\nOVIYA SHAKTI (LA FORCE"
      },
      {
        "@language": "fr",
        "@value": "\n\t\t\t\t\t\t\t\t\t\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tLE CENTRE CULTUREL KABIR EST HEUREUX DE COLLABORER AVEC\nBHARTIYA SANGEETHA SANGHAM DANS LA PRESENTATION DE\nOVIYA SHAKTI (LA FORCE DE L’ART)\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tArtistes\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tConception: Ramya Raghavan\nProduction : The Power of Natyam Dance Company de Toronto\nMusique: Madurai R. Muralidaran\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tDate :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tHeure :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tLieu :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tsamedi 14 septembre 2024\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t17h , PORTES OUVERTES À 16h30\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tCollège Vanier\n821 avenue Ste-Croix\nMontréal, QC H4L 3X9\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tBillets :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\twww.canadahelps.org\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\n"
      }
    ],
