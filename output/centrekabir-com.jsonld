      },
      {
        "@language": "fr",
        "@value": "\n\t\t\t\t\t\t\t\t\t\n\t\n\t\t\n\t\t\tARTISTES\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tPRATTYUSH BANERJEE – Sarod\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tINDRANIL MALLICK – Tabla\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tDATE:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tHeure:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tLieu:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tSamedi 17 juin 2023\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t20h\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tÉCOLE DE MUSIQUE ARQUEMUSE\n151-A Saint-Francois Street East, Quebec City, QC, G1K 3A7\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tBillets :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tthepointofsale.com\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\n"
      }
