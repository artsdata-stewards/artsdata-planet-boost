    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "[vc_row css_animation=\"\" row_type=\"row\""
      },
      {
        "@language": "en",
        "@value": "\n\t\t\t\t\t\t\t\t\t\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tKABIR CENTRE in collaboration with FESTIVAL ACCÈS ASIE\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tis pleased to present MYSTIC MUSIC FROM PAKISTAN\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\t\n\t\t\t\n\t\t\n\t\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tSOULFUL QAWWALI\nBY\nABDULLAH MANZOOR NIAZI & WAQAR NIAZI ENSEMBLE\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tSee video : https://vimeo.com/697172597/cec1470b95\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tSaturday 14 May 8 pm\nAuditorium of Grande Bibliothèque\n475 Boul. De Maisonneuve E, Montréal (Metro: Berri-UQAM)\nAdmission- 25$-45$ : lepointdevente.com\nInfo : 514 926 4182\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\t\nOn-site participation Tickets\n\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\t\nLive webcast Tickets\n\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t\n\n\n\t\t \n\t \n"
      }
    ],
