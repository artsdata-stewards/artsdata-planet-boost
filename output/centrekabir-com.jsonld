    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\nKABIR CULTURAL CENTRE IS PLEASED TO PRESENT\nIn collaboration with\nJEUNES MUSICIENS DU MONDE OF QUÉBEC\nUSTAD WASEEM AHMED KHAN\nTHE SOLE"
      },
      {
        "@language": "en",
        "@value": "\n\t\t\t\t\t\t\t\t\t\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tKABIR CULTURAL CENTRE IS PLEASED TO PRESENT\nIn collaboration with\nJEUNES MUSICIENS DU MONDE OF QUÉBEC\nUSTAD WASEEM AHMED KHAN\nTHE SOLE LIVING DESCENDANT & THE MASTER OF AGRA GHARANA\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tArtistes\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tWaseem Ahmed Khan\nAccompanied by virtuoso artists\nSiddesh Bicholkar – Harmonium\nSanjay Deshpande – Tabla\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tDate :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tTime :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tVenue :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tFriday 5th July, 2024\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t7 pm\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tUnion Française\n429 Av. Viger E., Montréal\n(Metro: Champ de mars)\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tAdmission :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tpointofsale.com\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\n"
      }
    ],
