  {
    "@id": "https://www.centrekabir.com/temporary/0ba4e4e2-b256-4dc5-9e9f-d15b7b62e523",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.centrekabir.com/en/events/percussion-fiesta/var/ri-0.l-L2"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Gifted with an ability to summon crystal-clear melodies from his drums, Pandit Anindo Chatterjee is one of India’s greatest living masters of"
      },
      {
        "@language": "en",
        "@value": "\n\t\t\t\t\t\t\t\t\t\n\t\n\t\t\n\t\t\t\n\t\t\t\n\t\t\n\t\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tGifted with an ability to summon crystal-clear melodies from his drums, Pandit Anindo Chatterjee is one of India’s greatest living masters of this instrument. Disciple of the legendary grandmaster and Guru Pandit Gyan Prakash Ghosh, he has practised with legends such as Nikhil Bannerjee and has accompanied venerable masters such as the flutist Hariprasad Chaurasia, the saord virtuoso Ali Akbar Khan, the santoor artist Shivkumar Sharma and the Grande Dame of Hindustani vocal Gangubai Hangal.\nRavi Naimpally began his studies with his uncle late Padmabhushan Nikhil Ghosh in Mumbai, India. In 1990 he became a student of Farukkabhad Gharana and continued his studies with Pandit Anindo Chatterjee. In 1997, he was called ‘the coolest musician of the year’ by Eye Magazine of Toronto.\n\n\t\t \n\t \n"
      }
    ],
