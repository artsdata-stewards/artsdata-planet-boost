    "http://ogp.me/ns#title": [
      {
        "@language": "fr-fr",
        "@value": "FESTIVAL NEXGEN MULTIARTS - 7e Édition Journée de danses - Le Centre Kabir pour les Arts & la Culture"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "Le centre Kabir est fier de présenter, en collaboration avec La maison de la culture Ahuntsic, les dancers(euses) de relève québécois/canadien. Voici les événements proposés: Le féminin divin:  par Natya Collective (Surya, Arushi et Aishwarya, étudiantes de l’Université McGill. Ces danses, en style Bharatanatyam, célèbrent..."
      }
    ],
