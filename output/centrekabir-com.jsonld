  {
    "@id": "https://www.centrekabir.com/temporary/e54c9346-4749-42d4-a314-5d4005d16c30",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.centrekabir.com/en/events/ghazals-geet-bollywood/var/ri-0.l-L2"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "This is a long-awaited evening of popular songs both Bollywood and Ghazals. A double-treat of soulful singing, enhanced by superb"
      },
      {
        "@language": "en",
        "@value": "\n\t\t\t\t\t\t\t\t\t\n\t\n\t\t\n\t\t\t\n\t\t\t\n\t\t\n\t\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tThis is a long-awaited evening of popular songs both Bollywood and Ghazals. A double-treat of soulful singing, enhanced by superb keyboard and harmonium support by two other excellent musicians.\nHita Raghunathan, a trained singer of Hindustani music, ghazals and bhajans, is arguably the most popular South Asian singer in Montreal. Whenever she sings, she draws sold-out audiences. Her singing is full of sweetness and vigour and her diction is simply perfect. She will be accompanied this evening by Mushfiq Hashmi on harmonium and keyboard as well as Rakesh Sethi also on keyboard.\n\n\t\t \n\t \n"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g5636120"
      }
    ],
