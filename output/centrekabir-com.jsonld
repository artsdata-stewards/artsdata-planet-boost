  {
    "@id": "https://www.centrekabir.com/temporary/db0713ce-5d83-4323-b3cf-5005e0e4b0d0",
    "@type": [
      "http://schema.org/WebPage"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.centrekabir.com/"
      },
      {
