  {
    "@id": "https://www.centrekabir.com/events/fareed-ayaz-abu-muhammad-ensemble-sufi-qawwali-concert/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-fr",
        "@value": "fr_FR"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-fr",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-fr",
        "@value": "Concert de Soufi Qawwali avec Fareed Ayaz & Abu Muhammad Ensemble"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "Originaires du Pakistan, l’Ensemble Fareed Ayaz & Abu Muhammad figure parmi les chanteurs les plus distingués du Qawwali, une musique étonnante que l’occident a su découvrir il y a quelques années grâce à Nusrat Fateh Ali Khan, lui aussi du Pakistan."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-fr",
        "@value": "https://www.centrekabir.com/events/fareed-ayaz-abu-muhammad-ensemble-sufi-qawwali-concert/"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "fr-fr",
        "@value": "Le Centre Kabir pour les Arts & la Culture"
