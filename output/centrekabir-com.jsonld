      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nRegard Persan\nSaeed Kamjoo - kamanche\nPooria Pournazeri - tanbour\nZiya Tabassian -"
      },
      {
        "@language": "fr",
        "@value": "\n\t\t\t\t\t\t\t\t\t\n\t\n\t\t\n\t\t\tARTISTES\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tRegard Persan\nSaeed Kamjoo – kamanche\nPooria Pournazeri – tanbour\nZiya Tabassian – percussion\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tPandit Yogesh Samsi – tabla\nAditya Verma – sarod\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tDATE:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tHeure:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tLieu:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tSamedi 23 septembre 2023\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t19h30\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tAuditorium de Bibliothèque et Archives nationales du Québec\n475, boulevard De Maisonneuve Est, Montréal, QC, Canada\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tBillets :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\thttps://lepointdevente.com/billets/hendousan\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\n"
      }
    ],
