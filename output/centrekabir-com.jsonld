    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "[vc_row css_animation=\"\""
      },
      {
        "@language": "en",
        "@value": "\n\t\t\t\t\t\t\t\t\t\n\t\n\t\t\n\t\t\tKabir Cultural Centre is proud to\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tInaugurate its 2022 season with PLURICITY SERIES\nof magnificent South Asian Arts presentations\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t\n\t\t\t\n\t\t\n\t\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tSONIC LANDSCAPES WITH SERENE SURBAHAR\nBY\nMAESTRO USTAD IRSHAD KHAN\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tIrshad Khan is the leading Surbahar player of this generation.\nSee video: https://www.youtube.com/watch?v=kThoPthWgm0\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tHe will be accompanied on tabla by Zaheer-Abbas Janmohamed, a rising and charismatic star of percussion.\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t\n\t\t\t\n\t\t\n\t\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tSaturday 23 April 7 pm\nAuditorium of Grande Bibliothèque\n475 Boul. De Maisonneuve E, Montréal (Metro: Berri-UQAM)\nAdmission: $20-$30, see : https://thepointofsale.com/tickets/cck220422001\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\t\n\t\t \n\t \n\t\n\t\t\n\t\t\t\n\n\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t\n\n\n\t\t \n\t \n"
      }
    ],
