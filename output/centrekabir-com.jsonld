    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The much awaited South Asian Film Festival of Montreal is here in its 8th edition. It will be presented over"
      },
      {
        "@language": "en",
        "@value": "\n\t\t\t\t\t\t\t\t\t\n\t\n\t\t\n\t\t\t\n\t\t\t\n\t\t\n\t\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tThe much awaited South Asian Film Festival of Montreal is here in its 8th edition. It will be presented over two weekends in 10 sessions. 26 films, long and short, from 11 countries followed by great discussions with filmmakers and panelists. An event absolutely not to be missed!\nFOR DETAILS OF FILMS AND TO BUY TICKETS,\nVISIT: WWW.SAFFM.CENTREKABIR.COM\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t\nFESTIVAL RUNS FROM 26 OCT 2018 TO 4 NOV 2018\nLE FESTIVAL AURA LIEU DU 26 OCT 2018 AU 4 NOV 2018\n\n\n\t\t \n\t \n"
      }
    ],
