  {
    "@id": "https://www.centrekabir.com/temporary/354d21c0-e891-4862-91d4-2feb86ffead9",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.centrekabir.com/en/events/paramparik-sitar-vocal-and-tabla-sherbrooke/var/ri-0.l-L2"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "This unique concert offers a contemporary celebration of ancient Indian music, featuring magical vocal improvisations by Arshad Ali Khan, a virtuoso of North"
      },
      {
        "@language": "en",
        "@value": "\n\t\t\t\t\t\t\t\t\t\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tThis unique concert offers a contemporary celebration of ancient Indian music, featuring magical vocal improvisations by Arshad Ali Khan, a virtuoso of North Indian classical singing, alongside the enchanting saxophone melodies of Jonathan Kay, a globally recognized figure in world music, and the mesmerizing rhythms of Pandit Subhen Chatterjee, an unrivaled master of the tabla and Indian percussion. Join these three musical legends as they come together to create an extraordinary musical experience, merging ancestral heritage with modern virtuosity in a live musical masterpiece that you won’t want to miss.\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tArtists\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tVocal : Janab Arshad Ali Khan\nSaxophone: Jonathan Kay\nTabla: Pandit Subhen Chatterjee\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tDATE:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tTime :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tVenue :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tSaturday 23rd March 2024\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t6 pm\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tLe Parvis,\n987, rue du Conseil,\nSherbrooke QC J1G 1L9\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tTickets :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\thttps://thepointofsale.com\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\n"
      }
    ],
