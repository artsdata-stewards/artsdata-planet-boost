  {
    "@id": "https://www.centrekabir.com/temporary/bec95ed2-ac3e-43b3-9947-800f40ad91f2",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.centrekabir.com/events/un-spectacle-de-danse-bollywoodien/"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nPOUR EMBELLIR L’ÉVÉNEMENT"
      },
      {
        "@language": "fr",
        "@value": "\n\t\t\t\t\t\t\t\t\t\n\t\n\t\t\n\t\t\tLE CENTRE KABIR EST HEUREUX DE COLLABORER AVEC LE FESTIVAL ACCÈS ASIE\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tPOUR EMBELLIR L’ÉVÉNEMENT DE CLÔTURE DE LA 27E ÉDITION AVEC\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tUN SPECTACLE DE DANSE BOLLYWOODIENNE SUIVI D’UN ATELIER\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\t\n\t\t\t\n\t\t\n\t\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tAMRITA CHOUDHURY\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tDanseuse, Enseignante, Chorégraphe\n&\npierre angulaire de danse indienne à Montréal\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tCe spectacle respire la joie et les merveilles de la danse indienne et grâce à des rythmes vibrants, des gestes des mains et des mouvements du corps, cette forme de danse nous transporte dans un état d’exubérance. Le spectacle sera suivi d’un atelier destiné au grand public pour que vous puissiez à votre tour prendre part au spectacle. Aucune expérience n’est nécessaire, tout le monde est le bienvenu. Apportez votre sourire, ouvrez votre cœur et préparez-vous à danser!\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tDimanche 29 mai 14h\nParc Lahaie, coin Boul. St. Laurent & Boul. St. Joseph Est\nADMISSION: SANS FRAIS\n\n\t\t \n\t \n"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g512900"
      }
    ],
