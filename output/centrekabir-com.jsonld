    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\n"
      },
      {
        "@language": "fr",
        "@value": "\n\t\t\t\t\t\t\t\t\t\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tLE CENTRE CULTUREL KABIR EST HEUREUX DE PRESENTER\nDes expressions multi-foi avec des danses classiques\n \n\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tArtistes\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\t14h-15h: Jayeeta Banerjee – Bharatanatyamn\n15h30-16h30: Surya Jade Edakunni – Kuchipudi\n17h-18h: Ensemble Art of Kathak – Danses Kathak\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tDate :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tHeure :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tLieu :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tsamedi 19 octobre 2024\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t14H – 18H\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tStudio Jean-Valcourt du Conservatoire\n4750 Henri Julien Ave,\nMontreal, Quebec H2T 2C8\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tBillets :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tGratuit (Dons appréciés)\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\n"
      }
    ],
