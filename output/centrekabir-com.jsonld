      {
        "@id": "https://www.centrekabir.com/en/events/inescapes/var/ri-0.l-L2"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "NEXGEN FESTIVAL - INSCAPES"
      }
    ],
    "http://schema.org/image": [
