  {
    "@id": "https://www.centrekabir.com/temporary/9cdab2d1-c69b-43e4-adcd-49b4e2bd358f",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.centrekabir.com/en/events/nexgen-festival-gold/var/ri-0.l-L2"
