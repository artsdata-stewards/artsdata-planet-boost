    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nSamedi 26\nMathias Nybo - Sitar\nGuru Raghvendra"
      },
      {
        "@language": "fr",
        "@value": "\n\t\t\t\t\t\t\t\t\t\n\t\n\t\t\n\t\t\tARTISTES\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tSamedi 26\nMathias Nybo – Sitar\nGuru Raghvendra – Mridangam\nDeeksha Arya – Bharatanatyam\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tdimanche 27\nRavi K. Singh – Tabla\nKasturi Mishra – Kathak\nSwati Sreedharan – Mohiniattam\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tDATE:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tHeure:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tLieu:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tSamedi 26 au  dimanche 27 août 2023\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t14h\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tSalle Maria-Goretti, Promis\n3333 Chem. de la Côte-Sainte-Catherine, Montréal, QC H3T 1C8, Canada\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tBillets :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tentrée libre\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\n"
      }
    ],
