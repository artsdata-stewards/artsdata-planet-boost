  {
    "@id": "https://www.centrekabir.com/temporary/f7c86226-cedf-4159-b0c4-f091b2c71051",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.centrekabir.com/en/events/pearlsfromelsewhere/"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\nKABIR CULTURAL CENTRE IS PLEASED TO PRESENT\nIn collaboration with Festival Accès Asie\nPearls from elsewhere\nSUROJIT O BONDHURA - From the land"
      },
      {
        "@language": "en",
        "@value": "\n\t\t\t\t\t\t\t\t\t\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tKABIR CULTURAL CENTRE IS PLEASED TO PRESENT\nIn collaboration with Festival Accès Asie\nPearls from elsewhere\nSUROJIT O BONDHURA – From the land of Tagore, Folk and Baul Songs of Bengal\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tArtists\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tSurojit Chatterjee: Lead Singer/Multi-instrumentalist\nRajib Mishra – Guitar, percussions\nAgniv Mukherjee – Drums, tabla, Khol, Khanjira\nMainak Sengupta – Bass, percussions\nJean-François Sauriol – Cello, Mandolin\nRaja Bhattacharya – Sarod\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tDate :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tTime :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tVenue :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tSaturday 18 May, 2024\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t8:00pm\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tLe Gesu\n1200 rue de Bleury, Montreal\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tTickets :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tlegesu.com\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\n"
      }
    ],
