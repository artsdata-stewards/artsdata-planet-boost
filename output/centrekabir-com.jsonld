  {
    "@id": "https://www.centrekabir.com/temporary/7c3fdf70-dd1e-4c71-b311-1bf322137a5f",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.centrekabir.com/en/events/perles-dailleurs-rhythm-rewritten/var/ri-0.l-L2"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Kabir Centre, in collaboration with Festival Accès Asie, presents a spectacular dance collaboration between Indian classical Kathak and Afro-American Tap"
      },
      {
        "@language": "en",
        "@value": "\n\t\t\t\t\t\t\t\t\t\n\t\n\t\t\n\t\t\t\n\t\t\t\n\t\t\n\t\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tKabir Centre, in collaboration with Festival Accès Asie, presents a spectacular dance collaboration between Indian classical Kathak and Afro-American Tap in Perles d’ailleurs – Rhythm Rewritten, with Seema Mehta of Mumbai, India and Jason Samuels Smith of New York. Seema Mehta is the winner of Nari Shakti Puraskar 2019 (an award for exceptional women in India conferred by the President of India) and Jason Samuels Smith is an Emmy Award winner.\nThis dynamic show, with live Indian and Jazz music, is based on extraordinary improvisations and brings together two cultures, two traditions and two exemplary artists who carry on a conversation with their faces, bodies and feet. A rare show of this nature in Montreal, absolutely not to be missed. The live music is presented by Satyaprakash Mishra from Mumbai, Debashis Sarkar et Jayanta Banerjee from Calcutta, Ian de Souza from Toronto and Theo Hill from New York.\n\n\t\t \n\t \n"
      }
    ],
