      },
      {
        "@language": "fr",
        "@value": "\n\t\t\t\t\t\t\t\t\t\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tLE CENTRE CULTUREL KABIR EST HEUREUX DE PRÉSENTER\n\nSAROD SUBLIME\nUN CONCERT DE MUSIQUE SAVANTE\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tArtistes\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tTroilee Dutta – Sarod\nMoisilee Dutta – Sarod\nIndranil Mallick – Tabla\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tDate :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tHeure:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tLieu:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tJeudi 15 mai 2025\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t20h\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tLa Caravane\n4500 Chemin Capelton\nNorth Hatley, QC J0B2C0\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tAdmission :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tthepointofsale.com\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\n"
      }
    ],
