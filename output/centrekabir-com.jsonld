    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nLE CENTRE CULTUREL KABIR EN COLLABORATION AVEC\nLE FESTIVAL ACCES ASIE\nEST FIER DE PRÉSENTER\n\nSAROD SUBLIME\n"
      },
      {
        "@language": "fr",
        "@value": "\n\t\t\t\t\t\t\t\t\t\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tLE CENTRE CULTUREL KABIR EN COLLABORATION AVEC\nLE FESTIVAL ACCES ASIE\nEST FIER DE PRÉSENTER\n\nSAROD SUBLIME\nUN CONCERT DE MUSIQUE SAVANTE\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tArtistes\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tTroilee Dutta – Sarod\nMoisilee Dutta – Sarod\nIndranil Mallick – Tabla\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tDate :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tHeure:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tLieu:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tVendredi 16 mai 2025\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t20h\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tLe Gesù\n1200 Rue de Bleury\nMontreal, QC H3B 3J3\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tAdmission :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tlegesu.tuxedobillet.com\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\n"
      }
    ],
