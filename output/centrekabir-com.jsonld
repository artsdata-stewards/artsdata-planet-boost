    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\nKABIR CULTURAL CENTER IS PLEASED TO PRESENT\nFOR THE FIRST TIME IN EASTERN TOWNSHIPS\n\nBANSURI BLISS\nAN ENCHANTING CONCERT"
      },
      {
        "@language": "en",
        "@value": "\n\t\t\t\t\t\t\t\t\t\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tKABIR CULTURAL CENTER IS PLEASED TO PRESENT\nFOR THE FIRST TIME IN EASTERN TOWNSHIPS\nBANSURI BLISS\nAN ENCHANTING CONCERT OF INDIAN\nFLUTE AND RHYTHMS\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tArtists\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tRonu Majumdar\nIndranil Mallick\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tDate :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tTime :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tVenue :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tThursday 20th March 2025\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t7:00 pm\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tLa Caravane\n4500 Chemin Capelton\nNorth Hatley, QC J0B2C0\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tAdmission :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tthepointofsale.com\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\n"
      }
    ],
