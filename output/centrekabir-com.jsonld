    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\n"
      },
      {
        "@language": "fr",
        "@value": "\n\t\t\t\t\t\t\t\t\t\n\t\n\t\t\n\t\t\tPOÈTES\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tMirabel\nYusuf Saadi\nManikya Singh\nClaudel Jean\nMary\nAryan Aggarwal\nAbhishek Koyalkar\nJohny Hans\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tDATE:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tHeure:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tLieu:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tSamedi 30 septembre 2023\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t18h\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tAtwater Library Adair Auditorium\n1200 Atwater Ave, Westmount, Quebec H3Z 1T4\nEntry through side door at 4023 Tupper Street West, Westmount, QC H3Z 1T4\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tBillets :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tFrais d’admission\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\n"
      }
    ],
