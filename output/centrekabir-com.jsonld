    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nLE CENTRE CULTUREL KABIR EST HEUREUX DE PRÉSENTER\nen collaboration avec\nJEUNES MUSICIENS DU MONDE, QUÉBEC\nUSTAD WASEEM AHMED KHAN\nGRAND VRTUOSE"
      },
      {
        "@language": "fr",
        "@value": "\n\t\t\t\t\t\t\t\t\t\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tLE CENTRE CULTUREL KABIR EST HEUREUX DE PRÉSENTER\nen collaboration avec\nJEUNES MUSICIENS DU MONDE, QUÉBEC\nUSTAD WASEEM AHMED KHAN\nGRAND VRTUOSE ET SEUL DESCENDANT VIVANT DU STYLE AGRA EN INDE\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tArtistes\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tWaseem Ahmed Khan\nAccompagné de superbes arties\nSiddesh Bicholkar – Harmonium\nSanjay Deshpande – Tabla\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tDate :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tHeure :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tLieu :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tvendredi 5 juillet 2024\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t19h\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tUnion Française\n429 Av. Viger E., Montréal\n(Metro: Champ de mars)\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tBillets :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tpointofsale.com\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\n"
      }
    ],
