        "@value": "\nPRATTYUSH BANERJEE - "
      },
      {
        "@language": "fr",
        "@value": "\n\t\t\t\t\t\t\t\t\t\n\t\n\t\t\n\t\t\tARTISTES\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tPRATTYUSH BANERJEE – Sarod\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tINDRANIL MALLICK – Tabla\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tDATE:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tHeure:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tLieu:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tDimanche 18 juin 2023\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t14h30\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tChapelle Saint-Cyriac\n5618, rue de la Chapelle, Jonquière, QC, Canada\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tBillets :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tthepointofsale.com\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\n"
      }
