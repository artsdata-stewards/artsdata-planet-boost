      },
      {
        "@language": "en",
        "@value": "\n\t\t\t\t\t\t\t\t\t\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tKABIR CULTURAL CENTER IS PLEASED TO PRESENT\n\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tArtists\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tUwe Neumann\nIndranil Mallick\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tDate :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tTime :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tVenue :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tSunday 20th October, 2024\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t7.30pm\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tStudio Jean-Valcourt\nConservatoire de musique\n4750, avenue Henri-Julien\nMontréal H2T 2C8\n(Metro Mont-Royal)\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tAdmission:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\thttps://conservatoire-montreal.tuxedobillet.com\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\n"
      }
    ],
