    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Kabir Cultural Centre presented the 14th edition of the South Asian Film Festival of Montreal in the spring of 2025. All films are carefully subtitled in French, thus promoting intercultural access and dialog. A mini-edition will be presented in Saguenay from 21st to 23rd November,..."
      }
