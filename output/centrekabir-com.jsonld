    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nLE CENTRE CULTUREL KABIR EST HEUREUX DE PRÉSENTER\nEN ESTRIE POUR LA PREMIÈRE FOIS\n\nBANSURI BLISS\nUN CONCERT ENVOÛTANT"
      },
      {
        "@language": "fr",
        "@value": "\n\t\t\t\t\t\t\t\t\t\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tLE CENTRE CULTUREL KABIR EST HEUREUX DE PRÉSENTER\nEN ESTRIE POUR LA PREMIÈRE FOIS\nBANSURI BLISS\nUN CONCERT ENVOÛTANT DES MÉLODIES\nET DES RYTHMES INDIENS\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tArtistes\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tRonu Majumdar\nIndranil Mallick\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tDate :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tHeure:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tLieu:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tJeudi 20 Mars 2025\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t19h\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tLa Caravane\n4500 Chemin Capelton\nNorth Hatley, QC J0B2C0\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tAdmission :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tthepointofsale.com\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\n"
      }
    ],
