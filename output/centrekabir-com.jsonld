    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\n"
      },
      {
        "@language": "fr",
        "@value": "\n\t\t\t\t\t\t\t\t\t\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tLE CENTRE CULTUREL KABIR EST HEUREUX DE PRÉSENTER\nSAROD SUBLIME\nUN CONCERT DE MUSIQUE SAVANTE\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tArtistes\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tTroilee Dutta – Sarod\nMoisilee Dutta – Sarod\nIndranil Mallick – Tabla\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tDate :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tHeure:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tLieu:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tDimanche 18 mai 2025\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t14:30\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tChapelle Saint-Cyriac\n5621 Rue de la chapelle\nLac Kénogami, QC G7X 0H9\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tAdmission :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tthepointofsale.com\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\n"
      }
    ],
