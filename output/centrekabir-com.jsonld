        "@value": "\n\t\t\t\t\t\t\t\t\t\n\t\n\t\t\n\t\t\tPOETS\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tMirabel\nYusuf Saadi\nManikya Singh\nClaudel Jean\nMary\nAryan Aggarwal\nAbhishek Koyalkar\nJohny Hans\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tDATE:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tTime:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tVenue:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tSaturday 30th  September 2023\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t6:00 pm\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tAtwater Library Adair Auditorium\n1200 Atwater Ave, Westmount, Quebec H3Z 1T4\nEntry through side door at 4023 Tupper Street West, Westmount, QC H3Z 1T4\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tAdmission:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tFree\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\n"
