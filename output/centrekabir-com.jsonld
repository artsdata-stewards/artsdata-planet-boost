  {
    "@id": "https://www.centrekabir.com/temporary/6b61aa75-f513-4647-a339-500b5df2d101",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.centrekabir.com/events/rencontre-avec-lautrice/"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Rencontrez Sheila James en personne. Sheila est une artiste multidisciplinaire canadienne:  autrice, vidéaste, dramaturge, musicienne et militante. Son travail explore les thèmes de l’exclusion,"
      },
      {
        "@language": "fr",
        "@value": "\n\t\t\t\t\t\t\t\t\t\n\t\n\t\t\n\t\t\tRencontrez Sheila James en personne. Sheila est une artiste multidisciplinaire canadienne:  autrice, vidéaste, dramaturge, musicienne et militante. Son travail explore les thèmes de l’exclusion, du racisme, du féminisme et des identités queer2. Elle a réalisé plusieurs vidéos primées à l’international, et a occupé des postes de direction dans des organismes culturels, notamment au Conseil des arts du Canada, et elle est actuellement directrice de l’initiative I-IDEAS (Inclusion, Diversité, Équité, Accès et Justice sociale) au CHEO.\nNbre. de sièges limité. Réservez par courriel à: info@centrekabir.com.\n\n\t\t \n\t \n"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g4060500"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
