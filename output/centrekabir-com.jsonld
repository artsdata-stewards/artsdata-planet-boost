  {
    "@id": "https://www.centrekabir.com/temporary/ecb69c27-0d8c-40ba-890b-38f2d52667bb",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.centrekabir.com/events/fete-de-percussion/"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Pandit ANINDO CHATTERJEE est un artiste originaire de Calcutta, qui se distingue par son jeu exceptionnel et son pouvoir d’allier rapidité, clarté"
      },
      {
        "@language": "fr",
        "@value": "\n\t\t\t\t\t\t\t\t\t\n\t\n\t\t\n\t\t\t\n\t\t\t\n\t\t\n\t\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tPandit ANINDO CHATTERJEE est un artiste originaire de Calcutta, qui se distingue par son jeu exceptionnel et son pouvoir d’allier rapidité, clarté et douceur. Il est également connu pour ses compositions variées, inspirées de différentes écoles de tabla. Ses concerts en tournée internationale sont souvent enrichis de master classes réputées. Une école portant son nom a été créée aux USA. Attention, quand ce virtuose joue, il vous hypnotise!\nRavi Naimpally a commencé ses etudes auprès de son oncle le regretté Padmabhushan Nikhil Ghosh à Mumbai, Inde. En 1990 il fut élève officiel du gharana Farukkabad et continue ses études avec le Pandit Anindo Chatterjee. En 1997, il fut appelé ‘le musicien le plus cool de l’année’par le journal torontois le Eye Magazine.\n\n\t\t \n\t \n"
      }
    ],
