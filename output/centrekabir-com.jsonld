  {
    "@id": "https://www.centrekabir.com/temporary/0b9aa71a-1382-4e8d-8b88-1236d4077d90",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.centrekabir.com/events/paysages-sonores-de-musique-indienne/"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "[vc_row css_animation=\"\" row_type=\"row\""
      },
      {
        "@language": "fr",
        "@value": "\n\t\t\t\t\t\t\t\t\t\n\t\n\t\t\n\t\t\tLe centre culturel Kabir\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tEst fier d’inaugurer sa saison 2022 avec la série PLURICITÉ\nde spectacles d’arts sud-asiatiques\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t\n\t\t\t\n\t\t\n\t\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tPAYSAGES SONORES DE MUSIQUE INDIENNE\nAVEC\nUSTAD IRSHAD KHAN\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tautorité incontesté du Surbahar\nVoir vidéo : https://www.youtube.com/watch?v=kThoPthWgm0\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tAccompagnement sur tabla par Zaheer-Abbas Janmohamed, une vedette montante et charismatique.\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t\n\t\t\t\n\t\t\n\t\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tsamedi 23 avril, 19h\nAuditorium de la Grande Bibliothèque\n475 Boul. De Maisonneuve E, Montréal (Métro: Berri-UQAM)\nAdmission: 20-30$, voir : https://lepointdevente.com/billets/cck220422001\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t\n\t\t \n\t \n\t\n\t\t\n\t\t\t\n\n\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t\n\n\n\t\t \n\t \n"
      }
    ],
