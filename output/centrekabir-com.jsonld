      {
        "@language": "fr",
        "@value": "\n\t\t\t\t\t\t\t\t\t\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tLE CENTRE CULTUREL KABIR EST HEUREUX DE PRÉSENTER\n\nBANSURI BLISS\nUN CONCERT ENVOÛTANT DES MÉLODIES\nET DES RYTHMES INDIENS\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tArtistes\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tRonu Majumdar\nIndranil Mallick\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tDate :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tHeure:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tLieu:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tVendredi 21 Mars 2025\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t6:30 pm\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tUnion Française\n429 Avenue Viger Est (Metro: Champ-de-Mars)\nMontréal, QC H2L 2N9\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tAdmission :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tthepointofsale.com\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\n"
