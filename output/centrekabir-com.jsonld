  {
    "@id": "https://www.centrekabir.com/temporary/25536fcd-87f0-477a-9b47-e2cd511c3df1",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.centrekabir.com/events/club-de-lecture/"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Winston Smith travaille pour le ministère de la Vérité à Londres, ville principale de Airstrip One. Big Brother regarde depuis"
      },
      {
        "@language": "fr",
        "@value": "\n\t\t\t\t\t\t\t\t\t\n\t\n\t\t\n\t\t\t\n\t\t\t\n\t\t\n\t\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tWinston Smith travaille pour le ministère de la Vérité à Londres, ville principale de Airstrip One. Big Brother regarde depuis chaque affiche, la police de la pensée découvre chaque acte de trahison. Lorsque Winston découvre l’amour avec Julia, il découvre que la vie ne doit pas nécessairement être ennuyeuse et assourdissante et qu’elle se réveille à de nouvelles possibilités. \n\n\t\t \n\t \n"
      }
    ],
