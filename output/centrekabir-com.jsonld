  {
    "@id": "https://www.centrekabir.com/temporary/438e8ae1-9792-44f7-a84d-b9a41f1b6b86",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.centrekabir.com/events/artasie/"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "ARTASIE\n\nPRÉSENTÉ PAR LE CENTRE KABIR EN COLLABORATION AVEC PROMIS\n\nPROJET SPÉCIALEMENT CONCU POUR VOUS, LES AMATEURS DES ARTS SUD-ASIATIQUES!\n\nTout ce que"
      },
      {
        "@language": "fr",
        "@value": "\n\t\t\t\t\t\t\t\t\t\n\t\n\t\t\n\t\t\t\n\t\t\t\n\t\t\n\t\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tARTASIE\nPRÉSENTÉ PAR LE CENTRE KABIR EN COLLABORATION AVEC PROMIS\nPROJET SPÉCIALEMENT CONCU POUR VOUS, LES AMATEURS DES ARTS SUD-ASIATIQUES!\nTout ce que vous voulez apprendre sur les arts classiques du sous-continent indien… Venez écouter les professionels expliquer et démystifier leurs arts et révéler leur beauté.\nSujets couverts en 12 séances interactives:\nSamedi 8 Septembre: Musique hindoustani 15h00, Musique Carnatic:17h00, Sarod: 19h00\nDimanche 9 Septembre: Tabla 15h00, Sitar 17h00, Danse Kathak 19h00\nSamedi 15 Septembre: Mridangam 15h00, Qawwali 17h00, Danse Odissi 19h00\nSamedi 16 Septembre: Danse Kathakali 15h00, Danse Bharatanatyam 17h00, Violin style carnatic 19h00.\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t\nCoffee & Snacks free; admissions free; Donations welcome. Three sessions each from 3 pm to 9 pm on 8,9,15,16 September Information: 514 620 4182\n\n \n\n\t\t \n\t \n"
      }
    ],
