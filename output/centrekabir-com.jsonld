    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\nKABIR CULTURAL CENTER IS PLEASED TO PRESENT\n\n\nSANTOOR REVERIE\nA SERENE AND SPARKLING CONCERT WITH THE\nHUNDRED-STRINGED WONDROUS INSTRUMENT"
      },
      {
        "@language": "en",
        "@value": "\n\t\t\t\t\t\t\t\t\t\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tKABIR CULTURAL CENTER IS PLEASED TO PRESENT\n\nSANTOOR REVERIE\nA SERENE AND SPARKLING CONCERT WITH THE\nHUNDRED-STRINGED WONDROUS INSTRUMENT FROM KASHMIR\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tArtists\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tPandit Satish Vyas – Santoor\nMukundraj Deo – Tabla\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tDate :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tTime :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tVenue :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tFriday 13th June 2025\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t8:00 pm\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tCentre culturel Le Parvis\n987 Rue de Conseil\nSherbrooke, QC J1G 1L9\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tAdmission :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tthepointofsale.com\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\n"
      }
    ],
