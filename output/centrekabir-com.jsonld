  {
    "@id": "https://www.centrekabir.com/temporary/aee0aacc-4c47-47f9-b076-e897ac480b3f",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.centrekabir.com/events/ghazals-geet-bollywood/"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "C"
      },
      {
        "@language": "fr",
        "@value": "\n\t\t\t\t\t\t\t\t\t\n\t\n\t\t\n\t\t\t\n\t\t\t\n\t\t\n\t\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tC’est une soirée tant attendue de chansons populaires à la fois Bollywood et Ghazals. Une soirée de chants envoutants, renforcée par un superbe soutien sur clavier et sur harmonium par deux autres excellents musiciens.\nHita Raghunathan, formée en Hindustani music, ghazals and bhajans, est sans doute la chanteuse sud-asiatique la plus populaire de Montréal . Chaque fois qu’elle chante, c’est guichet fermé. Son chant est plein de douceur et de vigueur et sa diction est simplement parfaite!. Elle sera accompagnée ce soir de Mushfiq Hashmi sur harmonium et clavier ainsi que de Rakesh Sethi également sur clavier.\n\n\t\t \n\t \n"
      }
    ],
