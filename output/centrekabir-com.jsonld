    "http://schema.org/image": [
      {
        "@id": "data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
      },
      {
        "@id": "https://www.centrekabir.com/wp-content/uploads/2019/02/Centre_Kabir_Logo_Black-2018-FR.png"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
