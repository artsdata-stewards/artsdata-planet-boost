    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nPRATTYUSH BANERJEE - "
      },
      {
        "@language": "fr",
        "@value": "\n\t\t\t\t\t\t\t\t\t\n\t\n\t\t\n\t\t\tARTISTES\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tPRATTYUSH BANERJEE – Sarod\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tINDRANIL MALLICK – Tabla\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tDATE:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tHeure:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tLieu:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tVendredi 16 juin 2023\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t19h\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tAuditorium de Bibliothèque et Archives nationales du Québec\n475, boulevard De Maisonneuve Est, Montréal, QC, Canada\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tBillets :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tthepointofsale.com\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\n"
      }
    ],
