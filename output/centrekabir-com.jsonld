    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "[vc_empty_space"
      },
      {
        "@language": "fr",
        "@value": "\n\t\t\t\t\t\t\t\t\t\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tLE CENTRE CULTUREL KABIR EST HEUREUX DE PRÉSENTER\n\nBANSURI BLISS\nUN CONCERT ENVOÛTANT DES MÉLODIES\nET DES RYTHMES INDIENS\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tArtistes\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tRonu Majumdar\nIndranil Mallick\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tDate :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tHeure:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tLieu:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tDimanche 23 Mars 2025\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t14h30\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tChapelle Saint-Cyriac\n5621 Rue de la chapelle Lac Kénogami\nSaguenay, QC G7X 0H9\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tAdmission :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tthepointofsale.com\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\n"
      }
    ],
