    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\n"
      },
      {
        "@language": "fr",
        "@value": "\n\t\t\t\t\t\t\t\t\t\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tLE CENTRE CULTUREL KABIR EST HEUREUX DE PRESENTER\nDes expressions multi-foi avec la musique savante\n \n\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tArtistes\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\t14h-15h: Andrew Kay – Saxophone\nRigved Deshpande – Tabla\n15h20-16h20: Aditya Chakravarthy – Chants\nAnjana Srinivasan – Violin\nArvind Venkataraman – Mridangam\n18h-19h: Ensemble Scholastica\nHildegard et ses saintes\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tDate :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tHeure :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tLieu :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tdimanche 20 octobre 2024\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t14H – 19H\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tStudio Jean-Valcourt du Conservatoire\n4750 Henri Julien Ave,\nMontreal, Quebec H2T 2C8\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tBillets :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tFree/Gratuit (Donations Welcome)\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\n"
      }
    ],
