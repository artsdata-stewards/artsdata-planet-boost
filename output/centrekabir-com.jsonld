  {
    "@id": "https://www.centrekabir.com/temporary/7b85a5a1-3276-451f-a524-738a6559a5d2",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.centrekabir.com/events/sanhita-nandi-une-voix-envoutante/"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\n"
      },
      {
        "@language": "fr",
        "@value": "\n\t\t\t\t\t\t\t\t\t\n\t\n\t\t\n\t\t\tARTISTES\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tSANHITA NANDI – CHANTS HINDOUSTANIS\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tSUSHANT ANANTRAM  – HARMONIUM\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tRIGVED DESHPANDE  – TABLA\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tDATE:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tHeure:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tLieu:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tVendredi 21 avril 2023\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t19h30\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tAuditorium de la Grande Bibliotheque\n475 De Maisaonneuve Eas, Montréal\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tBillets :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tthepointofsale.com\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tQuelle décoverte! Sanhita est bénédiction divine !\nSa voix coule comme de l’eau pure et claire dans un ruisseau – Client sur amazon.com\n\n\t\t \n\t \n\n"
      }
    ],
