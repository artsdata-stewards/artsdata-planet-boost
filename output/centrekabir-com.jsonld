    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n"
      },
      {
        "@language": "en",
        "@value": "\n\t\t\t\t\t\t\t\t\t\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tKABIR CULTURAL CENTER IS PLEASED TO COLLABORATE WITH\nBHARTIYA SANGEETHA SANGHAM IN PRESENTING\nOVIYA SHAKTI (THE STRENGTH OF ART)\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tArtists\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tConception: Ramya Raghavan\nProduction : The Power of Natyam Dance Company de Toronto\nMusique: Madurai R. Muralidaran\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tDate :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tTime:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tVenue:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tSaturday 14 September, 2024\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tAt 5 PM , DOORS OPEN 4:30 PM\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tCollège Vanier\n821 avenue Ste-Croix\nMontréal, QC H4L 3X9\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tAdmission :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tcanadahelps.org\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\n"
      }
    ],
