  {
    "@id": "https://www.centrekabir.com/temporary/f0b9ca3b-aee1-4e84-bc98-5014dbf2b6fb",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.centrekabir.com/events/songs-of-dharwad-hindustani-vocal-concert-2/"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\n"
      },
      {
        "@language": "fr",
        "@value": "\n\t\t\t\t\t\t\t\t\t\n\t\n\t\t\n\t\t\t\n\n\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t\n\n\nANNULÉ à cause des considérations de santé publique.\n\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\t\n\t\t\t\n\t\t\n\t\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\t\n\n\nPandit Kaivalya Kumar, originaire de Dharwad en Inde, est un jeune représentant passionnant de Kirana Gharana. Son grand-père Ganapat Rao Gurav était parmi les premiers étudiants du vénérable Abdul Karim Khan, le fondateur de Kirana Gharana. Il apporte une certaine flamboyance à ses interprétations avec une qualité tonale nette, un rythme agile, un ténor vocal et un dévouement fiévreux à la musique. Il sera accompagné sur tabla par le tout aussi flamboyant Pandit Subhen Chatterjee et sur l’harmonium tout a fait mélodieux de Pandit Sanatan Goswami. Il s’agit d’un rare concert vocal de musique hindoustani, à la fois méditatif et mélodieux, évocateur du bon vieux temps des légendaires Bhimsen Joshi et Amir Khan, à ne pas manquer !\n\n\n\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\t\n\t\t\t\n\t\t\n\t\n\n\t\n\t\t\n\t\t\t\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t\n\n\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t\n\n\t\t \n\t \n"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1681100"
      }
    ],
