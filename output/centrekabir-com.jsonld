  {
    "@id": "https://www.centrekabir.com/temporary/1377cefc-b418-46ee-b498-1ba70144f5cc",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.centrekabir.com/en/events/echos-du-coeur-sherbrooke/var/ri-0.l-L2"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Laissez-vous emporter par les mélodies"
      },
      {
        "@language": "en",
        "@value": "\n\t\t\t\t\t\t\t\t\t\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tKABIR CULTURAL CENTRE IS PLEASED TO PRESENT\nECHOES OF THE HEART\nHarmonies of the Sarod & the Tabla\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tLaissez-vous emporter par les mélodies envoûtantes d’Abhisek Lahiri au sarod et les rythmes palpitants d’Indranil Mallick au tabla. Ne manquez pas cet événement unique qui célèbre le meilleur de la musique classique indienne, une véritable ode à l’émotion artistique qui capte l’essence et l’âme de l’Inde, un pays au patrimoine riche et aux traditions envoûtantes.\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tArtists\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tSarod: Abhisek Lahiri\nTabla: Indranil Mallick\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tDate :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tTime :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tVenue :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tThursday 25 April 2024\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t6:00 PM\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tLe Parvis\n987 rue du Conseil, Sherbrooke\nQC J1G 1L9\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tTickets :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tlepointdevente.com\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\n"
      }
    ],
