      {
        "@language": "fr",
        "@value": "[vc_row_inner row_type=\"row\" type=\"full_width\""
      },
      {
        "@language": "fr",
        "@value": "\n\t\t\t\t\t\t\t\t\t\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tLE CENTRE CULTUREL KABIR EST HEUREUX DE PRESENTER\n\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tArtistes\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tUwe Neumann\nINDRANIL MALLICK\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\t\n\t\t\t\n\t\t\n\n\n\t\n\t\t\n\t\t\tDate :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tHeure :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tLieu :\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tdimanche 20 octobre 2024\n\n\t\t \n\t \n\t\n\t\t\n\t\t\t19h30\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tStudio Jean-Valcourt\nConservatoire de musique\n4750, avenue Henri-Julien\nMontréal H2T 2C8\n(Metro Mont-Royal)\n\n\t\t \n\t \n\t\n\t\t\n\t\t\tAdmission:\n\n\t\t \n\t \n\t\n\t\t\n\t\t\thttps://conservatoire-montreal.tuxedobillet.com\n\n\t\t \n\t \t\n\t\t\t\n\t\t\n\n\n\n"
      }
