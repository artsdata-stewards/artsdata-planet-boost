    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Siraba - Laval 2"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p><em>Siraba</em> signifie la grande voie, une proposition de dialogue entre 3 continents…<br /> Assistez à un concert extérieur aux traditions anciennes renouvelées du Mali, de l&rsquo;Afrique de l&rsquo;ouest en passant par l&rsquo;Amérique du sud et l&rsquo;Europe!</p> <p><strong>Musiciens :</strong> <strong>Adama Daou </strong>: balafon; <strong>Gabriel Schwartz</strong>: flûte, pandeiro; <strong>Aboulaye Koné </strong>: guitare électrique; <strong>Christian Obam </strong>: basse électrique</p> <p>Une discussion en bord de scène aura lieu avec les artistes après le spectacle.</p> <p>Concert offert dans le cadre des Zones musicales à la Maison des Arts de Laval.</p> "
      }
    ],
    "http://schema.org/startDate": [
      {
