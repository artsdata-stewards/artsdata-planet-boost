    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "SYMBIOSE"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\n                Vous aimeriez écouter les mélodies vocales des forêts du Cameroun sous une trame de fond de musique italienne et de rythmes latins?\nLe trio Café Korigé sera au Théâtre Alphonse-Desjardins à Repentigny le 21 Février. \nArtistes :\nGeremia Lodi : flûte, voix, percussions corporelles\nKomty Ondoua : voix\nRicardo Soriano : piano, cajón, bongos, violon\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
