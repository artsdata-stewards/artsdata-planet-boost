    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Découvrez le répertoire yeddish lors dans le cadre de notre série Concerts intimes, dans une formule acoustique raffinée, en formule quatuor"
      },
      {
        "@language": "fr-ca",
        "@value": "Langue des Juifs d’Europe de l’Est, le yiddish a voyagé jusqu’au Canada avec les vagues successives d’immigration du XXe"
      }
