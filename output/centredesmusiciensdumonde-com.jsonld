    "http://schema.org/image": [
      {
        "@language": "fr",
        "@value": "https://centredesmusiciensdumonde.com/wp-content/uploads/2024/09/DSC05501-ok-scaled-e1727542336632.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
