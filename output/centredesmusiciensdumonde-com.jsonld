      }
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "Current MonthCentre des musiciens du monde5043 Saint-Dominique Street\n\t\t\t\t    \t{\"@context\": \"http://schema.org\",\"@type\": \"Event\",\n\t\t\t\t\"@id\": \"event_47296_0\",\n\t\t\t\t\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\n\t\t\t\t\"eventStatus\":\"https://schema.org/EventScheduled\",\n\t\t\t\t\"name\": \"Renaissance Dances Workshop – April\",\n\t\t\t\t\"url\": \"https://centredesmusiciensdumonde.com/en/calendrier/renaissance-dances-workshop-april/var/ri-0.l-L2\",\n\t\t\t\t\"startDate\": \"2026-4-11T14:00-4:00\",\n\t\t\t\t\"endDate\": \"2026-4-11T16:00-4:00\",\n\t\t\t\t\"image\":\"https://centredesmusiciensdumonde.com/wp-content/uploads/2026/02/Atelier-Danses-Renaissance-avril.png\", \n\t\t\t\t\"description\":\"<p>The <strong>Renaissance</strong> was an important period for the development of <strong>dance</strong> in the West, as it saw the emergence of the very first dance treatises.<br /> This series of <strong>workshops</strong> offered by <strong>Anne-Marie Gardette</strong> will focus on the dances of the Italian courts of the Quattrocento and Cinquecento (bassa danza, balletto, etc.). The ball repertoire in use in France at the end of the 16th century, according to Thoinot Arbeau&#8217;s essential Orchésographie (branle, pavane, gaillarde, etc.), will also be covered.</p> <p>These two-hour workshops are open to all, and musicians who play this repertoire (Praetorius, Attaingnant, Gervaise, Phalèse, etc.) and want to learn about the dances are also welcome.</p> <p>Each workshop will cover different dances, so they can be taken independently.</p> <p>Open to all.<br /> Upcoming workshops:<br /> May 2<br /> From 2:00 pm to 4:00 pm</p> \",\"location\":[{\"@type\":\"Place\",\"name\":\"Centre des musiciens du monde\",\"address\":{\"@type\": \"PostalAddress\",\"streetAddress\":\"5043 Saint-Dominique Street\"}}],\"organizer\":[{\"@type\":\"Organization\",\"name\":\"Centre des musiciens du monde\"}]}\n\t\t\t\tsat11apr14 h 00 min16 h 00 minRenaissance Dances Workshop – April14 h 00 min - 16 h 00 min(GMT-04:00) Centre des musiciens du mondeCentre des musiciens du monde5043 Saint-Dominique Street\n\t\t\t\t    \t{\"@context\": \"http://schema.org\",\"@type\": \"Event\",\n\t\t\t\t\"@id\": \"event_47097_0\",\n\t\t\t\t\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\n\t\t\t\t\"eventStatus\":\"https://schema.org/EventScheduled\",\n\t\t\t\t\"name\": \"April traditional song veillée\",\n\t\t\t\t\"url\": \"https://centredesmusiciensdumonde.com/en/calendrier/april-traditional-song-veillee/var/ri-0.l-L2\",\n\t\t\t\t\"startDate\": \"2026-4-24T19:30-4:00\",\n\t\t\t\t\"endDate\": \"2026-4-24T22:30-4:00\",\n\t\t\t\t\"image\":\"https://centredesmusiciensdumonde.com/wp-content/uploads/2026/02/273x195-veillee.png\", \n\t\t\t\t\"description\":\"<p>Every last Friday of the month, come share, listen, or simply discover a repertoire of traditional songs from here and elsewhere starting at 7:30 pm with a veillée!<br /> Regulars, newcomers, and accompanying musicians are all welcome!</p> <p>The veillée is hosted by <strong>Lysandre Chartrand.</strong></p> <p>Fridays, April 24, and May 29, 2026, from 7:30 pm to 10:30 pm<br /> Cost: $10 (cash only)</p> \",\"location\":[{\"@type\":\"Place\",\"name\":\"Centre des musiciens du monde\",\"address\":{\"@type\": \"PostalAddress\",\"streetAddress\":\"5043 Saint-Dominique Street\"}}],\"organizer\":[{\"@type\":\"Organization\",\"name\":\"Lysandre Chartrand\"}]}\n\t\t\t\tfri24apr19 h 30 min22 h 30 minApril traditional song veillée19 h 30 min - 22 h 30 min(GMT-04:00) Centre des musiciens du monde\t\t\t\n\t\t\t\t\n\t\t\t\n\t\t\t\t\t \t\n\t\t \t\t\n\t\t \t\t\n\t\t \t\n\t\t\t\t\n\t\t\t\n\t\t\t\t\t\t\n\t\t\t"
      }
    ]
  },
