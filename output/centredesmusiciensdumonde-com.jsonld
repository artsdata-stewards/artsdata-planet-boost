    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Carnet de soie : échos d&#039;est en ouest"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>A musical journey along the Silk Road, between China, India, and Italy. With guzheng, sarod, flutes, dubuk, and tabor, the musicians travel through time.</p> <p>From the Han Dynasty to the Renaissance, guided by an imaginary traveler, they discover unfamiliar landscapes, beauty, and solitude. A performance presented by the World Musicians Center.</p> <p><strong>Musicians : </strong>Ran Wang, <em>ghuzeng </em>| Annette Bauer, <em>sarod, recorders, duduk, pipe and tabor</em></p> "
      }
    ],
