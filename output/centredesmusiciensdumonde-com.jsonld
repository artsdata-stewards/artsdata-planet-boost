    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Cajón workshop - Spanish rumba"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n                A versatile instrument par excellence, the cajón can provide a solid rhythmic foundation in a multitude of contexts: it adapts easily to almost any musical style.\nThis winter, join us for a series of intensive cajón workshops specially designed to teach you how to accompany different musical styles on the cajón.\nIn three 1.5-hour sessions, you will learn to recognize, understand, and play the essential rhythms of Spanish rumba.\nWe will work with audio tracks to help you clearly perceive how your cajón playing fits into the musical ensemble.\nWednesdays, February 11, 18, 25, from 6:00 p.m. to 7:30 p.m.\nUpcoming workshops: \nFunk-pop: March 11, 18, 25, from 6:00 p.m. to 7:30 p.m.\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
