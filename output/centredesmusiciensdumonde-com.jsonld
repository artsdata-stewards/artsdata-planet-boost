    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "SYMBIOSE"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Would you like to listen to the vocal melodies of <strong>Cameroon</strong>&#8216;s forests against a backdrop of Italian music and Latin rhythms?<br /> The <strong>Café Korigé</strong> trio will be at the Alphonse-Desjardins Theater in Repentigny on February 21.</p> <p>Artists:<br /> <strong>Geremia Lodi</strong>: flute, vocals, body percussion<br /> <strong>Komty Ondoua</strong>: vocals<br /> <strong>Ricardo Soriano</strong>: piano, cajón, bongos, violin</p> "
      }
    ],
