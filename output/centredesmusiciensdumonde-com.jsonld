  {
    "@id": "https://centredesmusiciensdumonde.com/en/calendrier/polyphonies-dukraine-4/event_43801_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://centredesmusiciensdumonde.com/en/calendrier/polyphonies-dukraine-4/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://centredesmusiciensdumonde.com/wp-content/uploads/2025/05/970c6c9a1359bcbc95b1574913dc64ab.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g4400080"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://centredesmusiciensdumonde.com/en/calendrier/polyphonies-dukraine-4/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Ukrainian a cappella songs"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<div class='ewa-rteLine'> <p>The Murmorosi ensemble draws its inspiration from the Ukrainian tradition of polyphonic singing. Their repertoire includes both traditional songs performed a capella and a variety of original compositions and updated rearrangements of Ukrainian folklore.</p> <p>Murmurosi is a Montreal-based ensemble made up of Natalia Telentso and Eli Camilo, accompanied on occasion by guest musicians and singers, dedicated to the transmission of traditional Ukrainian polyphonic song (a UNESCO World Heritage Site). Their a cappella repertoire pays tribute to the ancestral voices of rural Ukraine, with rich, expressive harmonies. Performing at a number of Canadian festivals, they share old songs from village life, full of emotion and beauty. Their debut album, Bohutyn, explores the meeting of traditional songs and contemporary compositions. For this concert, they will be joined by Kateryna Kovshun for a polyphonic trio and a capella performance.</p> </div> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-6-26T18:00-4::00"
      }
