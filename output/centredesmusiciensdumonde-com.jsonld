    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><em>Siraba</em> means the great way, a proposal for dialogue between 3 continents&#8230;<br /> Attend an outdoor concert featuring the ancient traditions of Mali, West Africa, South America and Europe!</p> <p><strong>Musicians:</strong> <strong>Adama Daou</strong>: <em>balafon</em>;<strong> Gabriel Schwartz</strong>: <em>flute, pandeiro</em>; <strong>Aboulaye Koné</strong>: <em>electric guitar</em>; <strong>Christian Obam</strong>: <em>electric bass</em></p> "
      }
    ],
