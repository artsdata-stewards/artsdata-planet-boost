    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Siraba Laval 2"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><em>Siraba</em> means the great way, a proposal for dialogue between 3 continents&#8230;<br /> Attend an outdoor concert featuring the ancient traditions of Mali, West Africa, South America and Europe!</p> <p><strong>Musicians:</strong> <strong>Adama Daou</strong>: balafon; <strong>Gabriel Schwartz</strong>: flute, pandeiro; <strong>Aboulaye Koné</strong>: electric guitar; <strong>Christian Obam</strong>: electric bass</p> <p>An onstage discussion with the artists will take place after the show.</p> <p>Concert offered as part of Zones musicales at Maison des Arts de Laval.</p> "
      }
    ],
