        "@value": "https://centredesmusiciensdumonde.com/wp-content/uploads/2025/05/Capture-decran-le-2025-05-09-a-11.45.16.png"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2025-6-5T18:00-4:00"
      }
    ],
    "http://schema.org/endDate": [
