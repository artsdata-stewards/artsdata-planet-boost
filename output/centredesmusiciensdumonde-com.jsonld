    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Carnets de soie - Toronto"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n                Discover an itinerary where each note becomes a pause on the path to discovering the Other. The artists celebrate the richness of their respective cultures (Persian and Mongolian), woven together like silk threads, seeking harmonies beyond borders and distances.\nWith the morin khuur (horse-headed fiddle) and the santur (table zither), melodies intertwine like the paths that crisscross the desert and steppe.\nArtists: Uuriintuya Khalivan, morin-khuur | Sadaf Amini, santur\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
