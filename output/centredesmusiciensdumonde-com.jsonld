  {
    "@id": "https://centredesmusiciensdumonde.com/calendrier/constellation-de-cordes-13/event_41588_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://centredesmusiciensdumonde.com/calendrier/constellation-de-cordes-13/"
      }
    ],
    "http://schema.org/image": [
      {
