    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "You will listen to a combination of traditional Maritime tunes with Rwandan melodies, accompanied by Baroque melodies on the lute and gheychak."
      },
      {
        "@language": "en-ca",
        "@value": "This concert brings together four artists from different musical traditions. You will listen to a combination of traditional Maritime tunes"
      }
