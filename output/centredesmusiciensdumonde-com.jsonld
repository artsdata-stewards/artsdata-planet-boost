    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Concert des Ensembles et des Chœurs du Centre des musiciens du monde"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\n                Venez assistez au concert des étudiants et étudiantes du Centre des musiciens du monde !\n\nDécouvrez les sonorités des Balkans, d’Amérique latine, d’Europe de l’Est, du Moyen-Orient et de la Turquie et venez célébrer l’excellence des étudiants et étudiantes de l’école de musique du Centre des musiciens du monde lors de leur concert de fin de session.\n\nLe 6 décembre 2025, 14h (ouverture des portes à 13h30)Accès via l’église Saint-Enfant-Jésus du Mile End\n\nChaque billet vendu contribue à soutenir les activités du Centre et de son école de musique.\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
