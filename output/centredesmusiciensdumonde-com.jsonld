      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Siraba in Côte des Neiges"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><strong>Siraba</strong> means “the great path,” a proposal for dialogue between three continents&#8230;<br /> Attend a concert featuring the renewed ancient traditions of <strong>Mali</strong>, <strong>West Africa</strong>, <strong>South America</strong>, and <strong>Europe</strong>!</p> <p><strong>Artists:</strong><br /> Adama Daou: balafon;<br /> Gabriel Schwartz: flute, pandeiro;<br /> Aboulaye Koné: electric guitar;<br /> Christian Obam: electric bass.</p> "
      }
    ],
