    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "Change starts with people like you. Every gesture of kindness, every dollar, and every minute of your time brings us closer to achieving our mission.\n"
      }
    ]
  },
  {
    "@id": "https://centredesmusiciensdumonde.com/temporary/caa895fd-3e9a-4e7e-903b-1e301efb6a83",
