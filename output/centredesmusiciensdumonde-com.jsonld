  },
  {
    "@id": "https://centredesmusiciensdumonde.com/temporary/74bf9433-e46c-4c61-99dc-8b92b928cea3",
    "@type": [
      "https://schema.org/CreativeWork"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://centredesmusiciensdumonde.com/en/calendar/intimate-concerts/"
      }
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "The Centre des musiciens du monde invites you to the Intimate Concerts series, launched in 2024 in the choir of the Saint-Enfant Jésus church, an exceptional venue offering remarkable acoustics for rare moments of communion with music.\nWith a limited capacity of 50 seats, the intimate atmosphere is ideal for savoring every note and every breath in a silence and resonance conducive to listening. Each evening is an exploration of an instrument and the culture it embodies, highlighting traditional music passed down orally through the generations.\nThese interpretations, both respectful of heritage and imbued with each artist’s unique sensibility, forge a link between past and present. Come discover inspired melodies, ancestral harmonies, and sound stories where the diversity of the world is expressed in all its splendor.\nAn experience for the soul and the senses.\n"
      }
    ]
  },
  {
    "@id": "https://centredesmusiciensdumonde.com/temporary/d68e9491-9238-4575-b0fd-762cbb055891",
    "@type": [
      "https://schema.org/CreativeWork"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://centredesmusiciensdumonde.com/en/calendar/intimate-concerts/"
      }
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "Current MonthSaint-Enfant-Jesus Church5039 Saint-Dominique Street\n\t\t\t\t    \t{\"@context\": \"http://schema.org\",\"@type\": \"Event\",\n\t\t\t\t\"@id\": \"event_44583_0\",\n\t\t\t\t\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\n\t\t\t\t\"eventStatus\":\"https://schema.org/EventScheduled\",\n\t\t\t\t\"name\": \"The Valley of Dreams\",\n\t\t\t\t\"url\": \"https://centredesmusiciensdumonde.com/en/calendrier/the-valley-of-dreams/var/ri-0.l-L2\",\n\t\t\t\t\"startDate\": \"2026-4-15T19:30-4:00\",\n\t\t\t\t\"endDate\": \"2026-4-15T20:30-4:00\",\n\t\t\t\t\"image\":\"https://centredesmusiciensdumonde.com/wp-content/uploads/2025/08/CONCERT-6.png\", \n\t\t\t\t\"description\":\"<p>With <em><strong>The Valley of Dreams</strong></em>, the <strong>Perse-Inca duo</strong> formed by <strong>Federico Tarazona</strong> (charango) and <strong>Showan Tavakol</strong> (kamancheh) continue the journey they began with their first album, Échos des montagnes.<br /> In this new phase, Andean and Persian strings respond to each other like two ancient voices reunited across time. True to the spirit of the initial project, the artists weave soundscapes where each note becomes a link between two worlds.</p> <p>Between improvisation, original compositions, and subtle references to tradition, this concert invites a timeless dialogue, imbued with nuances and vibrant sensations.</p> <p><strong>Artists:</strong><br /> Federico Tarazona: charango<br /> Showan Tavakol: kamancheh</p> \",\"location\":[{\"@type\":\"Place\",\"name\":\"Saint-Enfant-Jesus Church\",\"address\":{\"@type\": \"PostalAddress\",\"streetAddress\":\"5039 Saint-Dominique Street\"}}],\"organizer\":[{\"@type\":\"Organization\",\"name\":\"Centre des musiciens du monde\"}]}\n\t\t\t\twed15apr19 h 30 min20 h 30 minThe Valley of DreamsConcert intime19 h 30 min - 20 h 30 min(GMT+01:00) Saint-Enfant-Jesus Church\n    Event DetailsWith The Valley of Dreams, the Perse-Inca duo formed by Federico Tarazona (charango) and Showan Tavakol (kamancheh) continue the journey they began with their first album, Échos des montagnes.\nIn    \n        \n            Event Details\n            \n                With The Valley of Dreams, the Perse-Inca duo formed by Federico Tarazona (charango) and Showan Tavakol (kamancheh) continue the journey they began with their first album, Échos des montagnes.\nIn this new phase, Andean and Persian strings respond to each other like two ancient voices reunited across time. True to the spirit of the initial project, the artists weave soundscapes where each note becomes a link between two worlds.\nBetween improvisation, original compositions, and subtle references to tradition, this concert invites a timeless dialogue, imbued with nuances and vibrant sensations.\nArtists:\nFederico Tarazona: charango\nShowan Tavakol: kamancheh\n            \n                    \n    \n\n\t\t\t\n\t\t\t\t\t\t\t\t\t\t\n\t\t\t\tTicket officeI reserve my place\n\t\t\n\t\t\t\t\t\t\t\n\t\t\t\t\t\n\t\t\t\t\t\n\t\t\t\t\t\n\t\t\t\t\t\n\t\t\t\t\t\n\t\t\t\t\t\n\t\t\t\t\n\t\n\t\t\n\t\t\t\n\t\t\tLocationSaint-Enfant-Jesus Church5039 Saint-Dominique StreetOther Events\n\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\n\t\t\t\t\t \t\n\t\t \t\t\n\t\t \t\t\n\t\t \t\n\t\t\t\t\n\t\t\t\n\t\t\t\t\t\t\n\t\t\t\n"
      }
    ]
