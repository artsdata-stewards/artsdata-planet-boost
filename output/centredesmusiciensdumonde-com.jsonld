  {
    "@id": "https://centredesmusiciensdumonde.com/calendrier/stage-polyphonies-georgiennes/event_45959_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://centredesmusiciensdumonde.com/calendrier/stage-polyphonies-georgiennes/"
