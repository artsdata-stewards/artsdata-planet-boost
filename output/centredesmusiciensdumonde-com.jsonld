    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p><span data-contrast='none'>D’improvisation en co-composition, </span><span data-contrast='none'>le <strong>Duo Perse-Inca</strong> </span><span data-contrast='none'>puise</span><span data-contrast='none'> dans différents genres et rythmes traditionnels et fait coexister</span> <span data-contrast='none'>textures modales du Moyen-Orient et pentatoniques des Andes, aussi bien que </span><span data-contrast='none'>mélodies orientales et harmonies occidentales.</span><span data-ccp-props='{'> </span></p> <p>Avec <strong>Federico Tarazona</strong>, <em>composition, charango</em> et <strong>Showan Tavakol</strong>, <em>composition, kamancheh</em></p> "
      }
    ],
