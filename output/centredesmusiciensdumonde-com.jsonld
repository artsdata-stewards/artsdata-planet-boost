  {
    "@id": "https://centredesmusiciensdumonde.com/programmation/event_47106_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://centredesmusiciensdumonde.com/calendrier/veillee-de-chansons-traditionnelles-de-lamerique-francophone/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://centredesmusiciensdumonde.com/wp-content/uploads/2026/02/273x195-veillee.png"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g488140"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g488180"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
