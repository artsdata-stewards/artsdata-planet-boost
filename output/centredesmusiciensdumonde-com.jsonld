    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le virtuose iranien du kamancheh Kayhan Kalhor et le célèbre joueur de baglama anatolien Erdal Erzincan se réunissent sur scène à Montréal."
      },
      {
        "@language": "fr-ca",
        "@value": "Dans cette rare rencontre entre maîtres musicaux, deux des plus grands représentants des traditions anciennes au monde se réunissent sur"
      }
