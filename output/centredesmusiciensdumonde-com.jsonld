    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Carnets de soie - Toronto"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Discover an itinerary where each note becomes a pause on the path to discovering the Other. The artists celebrate the richness of their respective cultures (Persian and Mongolian), woven together like silk threads, seeking harmonies beyond borders and distances.</p> <p>With the morin khuur (horse-headed fiddle) and the santur (table zither), melodies intertwine like the paths that crisscross the desert and steppe.</p> <p><strong>Artists: Uuriintuya Khalivan</strong>, m<em>orin-khuur</em> | <strong>Sadaf Amini</strong>, <em>santur</em></p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-9-27T20:00-4::00"
      }
