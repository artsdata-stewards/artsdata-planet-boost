    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Stage - Chant classique arabe"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p><span data-contrast='none'>Rejoignez <strong>Lamia Yared</strong> pour trois soirées immersives dédiées aux </span><i><span data-contrast='none'>maqams</span></i><span data-contrast='none'> de la musique arabe, explorés à travers le répertoire raffiné des </span><i><span data-contrast='none'>muwashahat</span></i><span data-contrast='none'>.<br /> Durant ce <strong>stage intensif</strong> en <strong>chant classique arabe</strong>, vous y découvrirez leurs intervalles et leurs rythmes caractéristiques, tout en abordant les bases essentielles de l’interprétation et de la technique du chant oriental. </span></p> <p><span data-contrast='none'>Un format idéal pour affiner l’oreille, la voix et la musicalité!</span><span data-ccp-props='{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559738&quot;:0,&quot;335559739&quot;:0}'> </span></p> <p><span data-ccp-props='{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559738&quot;:0,&quot;335559739&quot;:0}'> </span><span data-contrast='none'>Les 19, 20 février de 18h à 20h et le 21 février</span><span data-ccp-props='{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559738&quot;:0,&quot;335559739&quot;:0}'> de 15h à 17h.</span></p> "
      }
    ],
