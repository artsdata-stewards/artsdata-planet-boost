      }
    ],
    "https://schema.org/mainContentOfPage": [
      {
        "@language": "fr",
        "@value": "\nUn univers de traditions musicales en mouvement\n\nLieu de création, de formation et de diffusion dédié au développement et à la promotion des différentes traditions musicales du monde. \n\nVoyez nos concerts\nDécouvrez nos cours \n\n"
      }
    ]
