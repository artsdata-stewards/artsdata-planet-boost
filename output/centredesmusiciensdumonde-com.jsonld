        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
  {
    "@id": "https://centredesmusiciensdumonde.com/temporary/892a5eeb-0cd8-4689-bf04-401922f80130",
    "@type": [
      "https://schema.org/WPFooter"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
