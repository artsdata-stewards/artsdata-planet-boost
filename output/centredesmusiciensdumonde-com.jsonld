    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Constellation de cordes - Virée classique"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n                Against a backdrop of 17th-century sounds, the voices and instruments of the Constellation de cordes project blend and overlap to weave a work constantly renewed by the improvisations of Deo Munyakazi (Rwanda) on his inanga zither.\nArtists: Janelle Lucyck, violin & vocals | Deo Munyakazi, inanga & vocals | Kerry Bursey, theorbo | Reza Abaee, ghaychak fiddle\nFree concert as part of the Orchestre Symphonique de Montréal’s Virée Classique OSM.\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
