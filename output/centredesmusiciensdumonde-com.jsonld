    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "April traditional song veillée"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Every last Friday of the month, come share, listen, or simply discover a repertoire of traditional songs from here and elsewhere starting at 7:30 pm with a veillée!<br /> Regulars, newcomers, and accompanying musicians are all welcome!</p> <p>The veillée is hosted by <strong>Lysandre Chartrand.</strong></p> <p>Fridays, April 24, and May 29, 2026, from 7:30 pm to 10:30 pm<br /> Cost: $10 (cash only)</p> "
      }
    ],
