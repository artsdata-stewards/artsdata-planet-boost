    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Chaque dernier vendredi du mois, partagez, écoutez ou simplement découvrez une veillée de chansons traditionnelles d’ici et d’ailleurs!"
      },
      {
        "@language": "fr-ca",
        "@value": "Chaque dernier vendredi du mois, venez partager, écouter ou simplement découvrir du répertoire de chansons traditionnelles d’ici et d’ailleurs"
      }
