    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Scintillement de cordes intérieures"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\n                Dans ce concert solo de santour (cithare persane), la musique circule entre improvisations et compositions originales de l’artiste Sadaf Amini.\nLes pièces sélectionnées pour cette soirée s’appuient sur des années d’imprégnation rythmique et mélodique porteuse d’émotions variées autour de la joie et de la tristesse, en de leurs transformations subtiles. \nLe voyage passe de structures d’inspiration classique en rythmes et en mélodies traversées par des couches sonores abstraites et en développement perpétuel. \nArtiste :\nSadaf Amini : santour\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
  {
    "@id": "https://centredesmusiciensdumonde.com/temporary/29cd4022-bab6-44ad-890d-74bef202d93f",
