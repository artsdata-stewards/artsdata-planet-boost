    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://centredesmusiciensdumonde.com/wp-content/uploads/2023/02/DSC_4090-copy-scaled.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
        "@value": "2025-6-17T18:00-4:00"
      }
