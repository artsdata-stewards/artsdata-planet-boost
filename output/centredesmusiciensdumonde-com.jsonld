    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Veillée de chansons traditionnelles d&#039;avril"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Chaque dernier vendredi du mois, venez partager, écouter ou simplement découvrir du répertoire de <strong>chansons traditionnelles</strong> d’ici et d’ailleurs dès 19h30 avec une <strong>veillée</strong>!<br /> Bienvenue aux habitués, nouveaux et musiciens d&rsquo;accompagnement!</p> <p>La veillée est animée par <strong>Lysandre Chartrand </strong></p> <p>Les vendredis 24 avril et 29 mai 2026 de 19h30 à 22h30<br /> Tarif : 10 $ (argent comptant seulement)</p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
