      }
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "Explore world music traditions with classes for all ages and levels. Learn rare instruments and discover unique repertoires taught by expert musicians.\n"
      }
    ]
  },
  {
    "@id": "https://centredesmusiciensdumonde.com/temporary/e18f72b2-9931-4c8b-8d80-41260d174a2d",
    "@type": [
      "https://schema.org/CreativeWork"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://centredesmusiciensdumonde.com/en/home/"
      }
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "We support professional artists in their creative and acoustic exploration through our creative residencies. This support includes:\n\ncompensation for composition work\na substantial number of rehearsal hours\naccess to the Centre’s facilities\npublic presentation of the works\nsupport for provincial, federal, and international outreach\n\n"
      }
    ]
  },
  {
