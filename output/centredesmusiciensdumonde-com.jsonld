  {
    "@id": "https://centredesmusiciensdumonde.com/calendrier/le-baobab-voyageur-chants-a-cappella-du-monde/event_43916_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://centredesmusiciensdumonde.com/calendrier/le-baobab-voyageur-chants-a-cappella-du-monde/"
