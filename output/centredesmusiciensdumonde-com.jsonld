    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Fruit d’une résidence de création, ce rapprochement défie les frontières et rassemble des cultures sœurs par la terre."
      },
      {
        "@language": "fr-ca",
        "@value": "Le Centre des musiciens du monde nous propose une rencontre inusitée entre la culture musicale du Pays basque et celle"
      }
    ],
