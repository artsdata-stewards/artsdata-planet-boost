    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://centredesmusiciensdumonde.com/en/calendar/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Traditional songs from French-speaking America Veillée"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>On <strong>Quebec&#8217;s Canadian Francophonie Day</strong>, the Centre des musiciens du monde invites Montrealers to a <strong>traditional songs from French-speaking America Veillée</strong>, hosted by <strong>Lysandre Chartrand</strong>, on March 27, 2026, in Montreal from 7:30 p.m. to 11 p.m.<br /> Come share, listen, and connect over the French-language song repertoires of <strong>Quebec</strong>, <strong>Acadia</strong>, <strong>Ontario</strong>, and the <strong>Prairies</strong>.</p> <p>Admission: $10 (cash only)</p> <p><em>This project is made possible thanks to the financial support of the Government of Quebec, under its programs supporting the Canadian Francophonie.</em></p> <p><a href='https://www.quebec.ca/gouvernement/politiques-orientations/langue-francaise/francophonie-canadienne'><img class='alignnone size-full wp-image-47110' src='https://centredesmusiciensdumonde.com/wp-content/uploads/2026/02/QUEBEC_w3_COUL_ParticipFinanc-1.png' alt='' width='199' height='72' /></a></p> "
      }
    ],
