    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Traditional songs from French-speaking America Veillée"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n                On Quebec’s Canadian Francophonie Day, the Centre des musiciens du monde invites Montrealers to a traditional songs from French-speaking America Veillée, hosted by Lysandre Chartrand, on March 27, 2026, in Montreal from 7:30 p.m. to 11 p.m.\nCome share, listen, and connect over the French-language song repertoires of Quebec, Acadia, Ontario, and the Prairies.\nAdmission: $10 (cash only)\nThis project is made possible thanks to the financial support of the Government of Quebec, under its programs supporting the Canadian Francophonie.\n\n            "
      }
    ],
    "http://schema.org/eventStatus": [
