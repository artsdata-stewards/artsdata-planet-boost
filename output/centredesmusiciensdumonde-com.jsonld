    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Soirée persane"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Vous êtes musicien·ne·s ? En amont du concert de musique persane avec Sadaf Amini, apportez votre instrument pour célébrer le nouvel an iranien Nowruz en découvrant l’ensemble de musique persane du Centre, dirigé par le joueur de gheychak Reza Abaee.<br /> Thé, bouchées et fruits seront servis sur place.<br /> Rejoignez l’ensemble le temps d’une soirée!</p> <p>Prérequis : pratiquer un instrument capable de produire des quarts de ton.</p> <p>De 17h30 à 19h<br /> Entrée libre<br /> Centre des musiciens du monde<br /> 5043, rue Saint-Dominique, Montréal<br /> Salles 203 et 204</p> "
      }
    ],
