  {
    "@id": "https://centredesmusiciensdumonde.com/calendrier/constellation-de-cordes-8/event_41319_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://centredesmusiciensdumonde.com/calendrier/constellation-de-cordes-8/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://centredesmusiciensdumonde.com/wp-content/uploads/2023/10/media-social-festival-2023-1080x1080-1.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g2994020"
