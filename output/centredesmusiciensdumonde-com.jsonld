      {
        "@language": "en",
        "@value": "Ensembles and Choirs concert of the Centre des musiciens du monde"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<div class='x14z9mp xat24cr x1lziwak x1vvkbs xtlvy1s'>Come see the <strong>students</strong> of the Centre des musiciens du monde perform!</div> <div class='x14z9mp xat24cr x1lziwak x1vvkbs xtlvy1s'>Discover the sounds of the <strong>Balkans</strong>, <strong>Latin America</strong>, <strong>Eastern Europe</strong>, <strong>Middle East</strong>, and <strong>Turkey</strong>, and cheer on our students at their end-of-session concert.</div> <div></div> <div class='x14z9mp xat24cr x1lziwak x1vvkbs xtlvy1s'>December 6, 2025, 2 p.m. (doors open at 1:30 p.m.)<br class='html-br' />Access via the Saint-Enfant-Jésus church in Mile End</div> <div></div> <div class='x14z9mp xat24cr x1lziwak x1vvkbs xtlvy1s'>Each ticket sold helps support the activities of the Center and its <strong>music school</strong>.</div> "
      }
    ],
