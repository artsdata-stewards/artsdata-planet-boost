    ],
    "http://schema.org/image": [
      {
        "@id": "https://centredesmusiciensdumonde.com/wp-content/uploads/2023/05/thumbnail_Uwe-Neumann.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g4350160"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
