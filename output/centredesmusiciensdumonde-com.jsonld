  {
    "@id": "https://centredesmusiciensdumonde.com/calendrier/federico-tarazona-charango-du-perou/event_41945_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://centredesmusiciensdumonde.com/calendrier/federico-tarazona-charango-du-perou/"
