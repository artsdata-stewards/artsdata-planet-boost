    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://centredesmusiciensdumonde.com/en/calendrier/the-sparkle-of-inner-strings/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Sparkle of Inner Strings"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>In this solo <strong>santur</strong> (Persian zither) concert, the music flows between improvisations and original compositions by artist <strong>Sadaf Amini.<br /> </strong> The pieces selected for this evening are based on years of rhythmic and melodic immersion, conveying a range of emotions centered on joy and sadness, and their subtle transformations.</p> <p>The journey moves from classically inspired structures to rhythms and melodies interwoven with abstract layers of sound in perpetual development.</p> <p><strong>Artist:</strong><br /> Sadaf Amini: santur</p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
