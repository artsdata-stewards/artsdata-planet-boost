    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Students concert &#8211; 7 June at 2 p.m.<br /> 📍 Location: Parc Lahaie: 4921, boulevard Saint-Laurent<br /> Montréal (Québec)<br /> (If the weather does not permit, the concert will take place at the Centre des musiciens du monde, 5043 rue Saint-Dominique, just across the street)</p> <p>Programme:<br /> Coming soon</p> <p>Come one, come all to enjoy this wonderful musical afternoon! 🌞🎵</p> "
      }
