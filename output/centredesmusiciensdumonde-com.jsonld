  {
    "@id": "https://centredesmusiciensdumonde.com/en/calendrier/masmoudi-quartette-in-saskatoon/event_47148_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://centredesmusiciensdumonde.com/en/calendrier/masmoudi-quartette-in-saskatoon/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://centredesmusiciensdumonde.com/wp-content/uploads/2024/09/DSC_4163-copy-scaled-e1726693312605.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g5655540"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g5655580"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://centredesmusiciensdumonde.com/en/calendrier/masmoudi-quartette-in-saskatoon/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Masmoudi Quartette in Saskatoon"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>When cultures meet in the music of the <strong>Masmoudi Quartet</strong>, the result is truly extraordinary. Jazz is enriched by the interaction between Western and Middle Eastern instruments to create a tapestry of sound that is both familiar and unexpected. The group&#8217;s leader, <strong>Mohamed Masmoudi</strong>, is originally from Tunisia, and his music incorporates influences from a life devoted to study, travel, and performance. His works are known for their melodic richness and multifaceted texture. A sample of Masmoudi&#8217;s repertoire is a journey through moods and landscapes, from the lively Labyrinth to the sensual Moorish Tango.</p> <p>Audiences will be intrigued by this unique mosaic of classical, jazz, and world music.</p> <p>Artists:<br /> <strong>Mohamed Masmoudi</strong>: oud<br /> <strong>Guillame Martineau</strong>: piano<br /> <strong>Gabriel Paquin-Buki</strong>: clarinet<br /> <strong>Rémi-Jean Leblanc:</strong> double bass.</p> <p><em>Presented by the Saskatoon Symphony Orchestra and the Saskatoon Jazz Society.</em></p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-2-26T19:30-4::00"
      }
    ],
    "http://schema.org/endDate": [
