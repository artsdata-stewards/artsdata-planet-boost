        "@value": "Siraba à Côte des Neiges"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p><strong>Siraba</strong> signifie la grande voie, une proposition de dialogue entre 3 continents…<br /> Assistez à un concert aux traditions anciennes renouvelées du <strong>Mali</strong>, de l&rsquo;<strong>Afrique de l&rsquo;ouest</strong> en passant par l&rsquo;<strong>Amérique du sud</strong> et l&rsquo;<strong>Europe</strong>!</p> <p><strong>Artistes :</strong><br /> Adama Daou : balafon;<br /> Gabriel Schwartz: flûte, pandeiro;<br /> Aboulaye Koné : guitare électrique;<br /> Christian Obam : basse électrique.</p> "
      }
    ],
