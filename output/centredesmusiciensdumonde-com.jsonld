    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Carnet de soie : échos d'est en ouest"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n                A musical journey along the Silk Road, between China, India, and Italy. With guzheng, sarod, flutes, dubuk, and tabor, the musicians travel through time.\nFrom the Han Dynasty to the Renaissance, guided by an imaginary traveler, they discover unfamiliar landscapes, beauty, and solitude. A performance presented by the World Musicians Center.\nMusicians : Ran Wang, ghuzeng | Annette Bauer, sarod, recorders, duduk, pipe and tabor\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
