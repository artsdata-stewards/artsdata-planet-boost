    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Un mariage de chants traditionnels des Maritimes et du Rwanda, accompagnés par des mélodies baroques au théorbe et au gheychak."
      },
      {
        "@language": "fr-ca",
        "@value": "Avec en toile de fond des sonorités du XVIIe siècle, les voix et instruments du projet  Constellation de cordes se mêlent et"
