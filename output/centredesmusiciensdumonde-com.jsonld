      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "fr",
        "@value": "2026-3-27T22:30-4:00"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Veillée de chansons traditionnelles de l’Amérique francophone"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\n                À l’occasion de la Journée québécoise de la francophonie canadienne, le Centre des musiciens du monde invite le public montréalais à une Veillée de chansons traditionnelles de l’Amérique francophone, animée par Lysandre Chartrand, le 27 mars 2026 prochain à Montréal de 19h30 à 23h.\nVenez partager, écouter et tisser des liens autour des répertoires francophones chantés du Québec, de l’Acadie, de l’Ontario et des Prairies.\nTarif : 10 $ (argent comptant seulement)\nCe projet est réalisé grâce à l’appui financier du gouvernement du Québec, en vertu des programmes de soutien en matière de francophonie canadienne\n\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
