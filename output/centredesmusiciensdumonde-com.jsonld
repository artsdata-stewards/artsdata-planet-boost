  {
    "@id": "https://centredesmusiciensdumonde.com/calendrier/annette-bauer-ran-wang-a-bromont/event_45109_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://centredesmusiciensdumonde.com/calendrier/annette-bauer-ran-wang-a-bromont/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://centredesmusiciensdumonde.com/wp-content/uploads/2024/08/19_jun_CMM_jmalobaton_-13-e1725711929972.jpg"
