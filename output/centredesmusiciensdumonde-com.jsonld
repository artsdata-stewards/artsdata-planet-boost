    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "Join workshops and training sessions exploring musical traditions and repertoires from around the world\n"
      }
    ]
  },
  {
    "@id": "https://centredesmusiciensdumonde.com/temporary/4b1fbec0-ae28-4d86-a357-7f98acf6e089",
    "@type": [
