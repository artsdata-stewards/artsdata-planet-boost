    "http://schema.org/image": [
      {
        "@id": "https://centredesmusiciensdumonde.com/wp-content/uploads/2024/09/Nazih_Borish_14032020_113-photo©Michael-Slobodian-copie-scaled-e1727538622802.jpg"
