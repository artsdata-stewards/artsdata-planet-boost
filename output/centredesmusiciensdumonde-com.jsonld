    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Ukrainian a cappella songs"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n                \nThe Murmorosi ensemble draws its inspiration from the Ukrainian tradition of polyphonic singing. Their repertoire includes both traditional songs performed a capella and a variety of original compositions and updated rearrangements of Ukrainian folklore.\nMurmurosi is a Montreal-based ensemble made up of Natalia Telentso and Eli Camilo, accompanied on occasion by guest musicians and singers, dedicated to the transmission of traditional Ukrainian polyphonic song (a UNESCO World Heritage Site). Their a cappella repertoire pays tribute to the ancestral voices of rural Ukraine, with rich, expressive harmonies. Performing at a number of Canadian festivals, they share old songs from village life, full of emotion and beauty. Their debut album, Bohutyn, explores the meeting of traditional songs and contemporary compositions. For this concert, they will be joined by Kateryna Kovshun for a polyphonic trio and a capella performance.\n\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
