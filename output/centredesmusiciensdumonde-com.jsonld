    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Workshop - Classical Arabic singing"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Join<strong> Lamia Yared</strong> for three immersive evenings dedicated to the <em>maqams</em> of Arabic music, explored through the refined repertoire of <em>muwashahat</em>.<br /> During this <strong>intensive workshop</strong> in <strong>classical Arabic singing</strong>, you will discover their characteristic intervals and rhythms, while learning the essential basics of Oriental singing technique and interpretation.</p> <p>An ideal format for refining your ear, voice, and musicality!</p> <p>February 19 and 20 from 6 to 8 pm and February 21 from 3 to 5 pm</p> <p>&nbsp;</p> "
      }
    ],
