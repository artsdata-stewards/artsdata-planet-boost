        "@value": "Concerts intimes\n"
      }
    ]
  },
  {
    "@id": "https://centredesmusiciensdumonde.com/temporary/c161a7d7-5461-4e4e-b987-a86804ca966c",
    "@type": [
      "https://schema.org/CreativeWork"
