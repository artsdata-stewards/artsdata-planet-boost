  {
    "@id": "https://centredesmusiciensdumonde.com/calendrier/ganbold-curtet-chants-diphoniques-de-mongolie/event_42859_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
