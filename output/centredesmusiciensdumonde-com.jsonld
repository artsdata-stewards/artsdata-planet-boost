  },
  {
    "@id": "https://centredesmusiciensdumonde.com/en/calendrier/the-sparkle-of-inner-strings/event_44577_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://centredesmusiciensdumonde.com/en/calendrier/the-sparkle-of-inner-strings/"
      }
    ],
