    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Ensembles and Choirs concert of the Centre des musiciens du monde"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n                Come see the students of the Centre des musiciens du monde perform!\nDiscover the sounds of the Balkans, Latin America, Eastern Europe, Middle East, and Turkey, and cheer on our students at their end-of-session concert.\n\nDecember 6, 2025, 2 p.m. (doors open at 1:30 p.m.)Access via the Saint-Enfant-Jésus church in Mile End\n\nEach ticket sold helps support the activities of the Center and its music school.\n            "
      }
    ],
