    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Los Gemelos is a flamenco-Cuban jazz duo formed by Montreal pianist Gabriel Evangelista and Havana percussionist Hanser Santos."
      },
      {
        "@language": "en-ca",
        "@value": "This nickname, which means “the twins,” evokes their resemblance and complicity: on one side, a Spanish pianist dedicated to Cuban"
