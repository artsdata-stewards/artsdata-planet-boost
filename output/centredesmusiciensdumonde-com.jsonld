  {
    "@id": "https://centredesmusiciensdumonde.com/portfolio/duo-perse-inca/event_44580_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://centredesmusiciensdumonde.com/calendrier/la-vallee-des-reves/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://centredesmusiciensdumonde.com/wp-content/uploads/2025/08/CONCERT-6.png"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g8181700"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g8181740"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://centredesmusiciensdumonde.com/portfolio/duo-perse-inca/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "La vallée des rêves"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p><span class='TextRun SCXW14220135 BCX0' lang='FR-CA' xml:lang='FR-CA' data-contrast='none'><span class='NormalTextRun SCXW14220135 BCX0'>Avec </span><em><strong><span class='NormalTextRun SCXW14220135 BCX0' data-ccp-charstyle='apple-converted-space' data-ccp-charstyle-defn='{&quot;ObjectId&quot;:&quot;2fd183b4-ad5c-5199-9fc7-89a6d0356079|1&quot;,&quot;ClassId&quot;:1073872969,&quot;Properties&quot;:[201342446,&quot;1&quot;,201342447,&quot;5&quot;,201342448,&quot;1&quot;,201342449,&quot;1&quot;,469777841,&quot;Aptos&quot;,469777842,&quot;&quot;,469777843,&quot;Aptos&quot;,469777844,&quot;Aptos&quot;,201341986,&quot;1&quot;,469769226,&quot;Aptos&quot;,268442635,&quot;24&quot;,469775450,&quot;apple-converted-space&quot;,201340122,&quot;1&quot;,134233614,&quot;true&quot;,469778129,&quot;apple-converted-space&quot;,335572020,&quot;1&quot;,469778324,&quot;Default Paragraph Font&quot;]}'>La vallée des rêves</span></strong></em><span class='NormalTextRun SCXW14220135 BCX0' data-ccp-charstyle='apple-converted-space' data-ccp-charstyle-defn='{&quot;ObjectId&quot;:&quot;2fd183b4-ad5c-5199-9fc7-89a6d0356079|1&quot;,&quot;ClassId&quot;:1073872969,&quot;Properties&quot;:[201342446,&quot;1&quot;,201342447,&quot;5&quot;,201342448,&quot;1&quot;,201342449,&quot;1&quot;,469777841,&quot;Aptos&quot;,469777842,&quot;&quot;,469777843,&quot;Aptos&quot;,469777844,&quot;Aptos&quot;,201341986,&quot;1&quot;,469769226,&quot;Aptos&quot;,268442635,&quot;24&quot;,469775450,&quot;apple-converted-space&quot;,201340122,&quot;1&quot;,134233614,&quot;true&quot;,469778129,&quot;apple-converted-space&quot;,335572020,&quot;1&quot;,469778324,&quot;Default Paragraph Font&quot;]}'>,</span><span class='NormalTextRun SCXW14220135 BCX0' data-ccp-charstyle='apple-converted-space' data-ccp-charstyle-defn='{&quot;ObjectId&quot;:&quot;2fd183b4-ad5c-5199-9fc7-89a6d0356079|1&quot;,&quot;ClassId&quot;:1073872969,&quot;Properties&quot;:[201342446,&quot;1&quot;,201342447,&quot;5&quot;,201342448,&quot;1&quot;,201342449,&quot;1&quot;,469777841,&quot;Aptos&quot;,469777842,&quot;&quot;,469777843,&quot;Aptos&quot;,469777844,&quot;Aptos&quot;,201341986,&quot;1&quot;,469769226,&quot;Aptos&quot;,268442635,&quot;24&quot;,469775450,&quot;apple-converted-space&quot;,201340122,&quot;1&quot;,134233614,&quot;true&quot;,469778129,&quot;apple-converted-space&quot;,335572020,&quot;1&quot;,469778324,&quot;Default Paragraph Font&quot;]}'> le <strong>duo </strong></span></span><span class='TextRun SCXW14220135 BCX0' lang='FR-CA' xml:lang='FR-CA' data-contrast='none'><span class='NormalTextRun SCXW14220135 BCX0' data-ccp-charstyle='Emphasis'><strong>Perse-Inca</strong> formé de</span></span><span class='TextRun SCXW14220135 BCX0' lang='FR-CA' xml:lang='FR-CA' data-contrast='none'><span class='NormalTextRun SCXW14220135 BCX0'> <strong>Federico Tarazona</strong> (charango) et </span><strong><span class='NormalTextRun SpellingErrorV2Themed SCXW14220135 BCX0'>Showan</span> <span class='NormalTextRun SpellingErrorV2Themed SCXW14220135 BCX0'>Tavakol</span></strong><span class='NormalTextRun SCXW14220135 BCX0'> (kamancheh) prolongent le voyage entamé avec leur premier album</span><span class='NormalTextRun SCXW14220135 BCX0' data-ccp-charstyle='apple-converted-space'> </span></span><em><span class='TextRun SCXW14220135 BCX0' lang='FR-CA' xml:lang='FR-CA' data-contrast='none'><span class='NormalTextRun SCXW14220135 BCX0' data-ccp-charstyle='Emphasis'>Échos des montagnes</span></span></em><span class='TextRun SCXW14220135 BCX0' lang='FR-CA' xml:lang='FR-CA' data-contrast='none'><span class='NormalTextRun SCXW14220135 BCX0'>.<br /> </span></span><span class='TextRun SCXW14220135 BCX0' lang='FR-CA' xml:lang='FR-CA' data-contrast='none'><span class='NormalTextRun SCXW14220135 BCX0'>Dans cette nouvelle étape, les cordes andines et persanes se répondent comme deux voix anciennes qui se retrouvent à travers le temps. Fidèles à l’esprit du projet initial, les artistes tissent des paysages sonores où chaque note devient un trait d’union entre deux mondes. </span></span></p> <p><span class='TextRun SCXW14220135 BCX0' lang='FR-CA' xml:lang='FR-CA' data-contrast='none'><span class='NormalTextRun SCXW14220135 BCX0'>Entre improvisation, compositions originales et</span><span class='NormalTextRun SCXW14220135 BCX0' data-ccp-charstyle='apple-converted-space'> </span></span><span class='TextRun SCXW14220135 BCX0' lang='FR-CA' xml:lang='FR-CA' data-contrast='none'><span class='NormalTextRun SCXW14220135 BCX0' data-ccp-charstyle='Strong'>références subtiles aux traditions</span></span><span class='TextRun SCXW14220135 BCX0' lang='FR-CA' xml:lang='FR-CA' data-contrast='none'><span class='NormalTextRun SCXW14220135 BCX0'>,</span></span><span class='TextRun SCXW14220135 BCX0' lang='FR-CA' xml:lang='FR-CA' data-contrast='none'><span class='NormalTextRun SCXW14220135 BCX0' data-ccp-charstyle='apple-converted-space'> ce concert </span></span><span class='TextRun SCXW14220135 BCX0' lang='FR-CA' xml:lang='FR-CA' data-contrast='none'><span class='NormalTextRun SCXW14220135 BCX0' data-ccp-charstyle='apple-converted-space'> </span><span class='NormalTextRun SCXW14220135 BCX0'>invite à un dialogue intemporel,</span><span class='NormalTextRun SCXW14220135 BCX0' data-ccp-charstyle='apple-converted-space'> empreint</span></span><span class='TextRun SCXW14220135 BCX0' lang='FR-CA' xml:lang='FR-CA' data-contrast='none'><span class='NormalTextRun SCXW14220135 BCX0' data-ccp-charstyle='Strong'> de nuances et de sensations vibrantes</span></span><span class='TextRun SCXW14220135 BCX0' lang='FR-CA' xml:lang='FR-CA' data-contrast='none'><span class='NormalTextRun SCXW14220135 BCX0'>.</span></span><span class='EOP SCXW14220135 BCX0' data-ccp-props='{&quot;335551550&quot;:6,&quot;335551620&quot;:6}'> </span></p> <p><strong>Artistes : </strong><br /> <span class='TextRun SCXW14220135 BCX0' lang='FR-CA' xml:lang='FR-CA' data-contrast='none'><span class='NormalTextRun SCXW14220135 BCX0'>Federico Tarazona : charango<br /> </span></span><span class='TextRun SCXW14220135 BCX0' lang='FR-CA' xml:lang='FR-CA' data-contrast='none'><span class='NormalTextRun SpellingErrorV2Themed SCXW14220135 BCX0'>Showan</span> <span class='NormalTextRun SpellingErrorV2Themed SCXW14220135 BCX0'>Tavakol : </span><span class='NormalTextRun SCXW14220135 BCX0'>kamancheh</span></span></p> "
      }
    ],
