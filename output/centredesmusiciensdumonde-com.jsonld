    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Perse-Inca Duo"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>From improvisation to co-composition, the <strong>Perse-Inca Duo</strong> draws on a variety of traditional rhythms and genres, bringing together Middle Eastern modal textures and Andean pentatonics, as well as Eastern melodies and Western harmonies.</p> <p>With <strong>Federico Tarazona</strong>, <em>composition, charango</em> and <strong>Showan Tavakol</strong>, <em>composition, kamancheh.</em></p> <p>Three 30-minute concerts:<br /> 11 a.m., 12 p.m. and 1 p.m.</p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-6-28T11:00-4::00"
      }
    ],
    "http://schema.org/endDate": [
