    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p><span class='TextRun SCXW257361568 BCX0' lang='FR-CA' xml:lang='FR-CA' data-contrast='none'><span class='NormalTextRun SCXW257361568 BCX0' data-ccp-parastyle='Normal (Web)'>Dans ce concert solo de <strong>santour</strong> (cithare persane), la musique circule entre improvisations et compositions originales de l’artiste</span><strong><span class='NormalTextRun SCXW257361568 BCX0' data-ccp-parastyle='Normal (Web)'> Sadaf </span><span class='NormalTextRun SpellingErrorV2Themed SCXW257361568 BCX0' data-ccp-parastyle='Normal (Web)'>Amini</span></strong><span class='NormalTextRun SCXW257361568 BCX0' data-ccp-parastyle='Normal (Web)'>.<br /> </span><span class='NormalTextRun SCXW257361568 BCX0' data-ccp-parastyle='Normal (Web)'>Les pièces </span><span class='NormalTextRun SCXW257361568 BCX0' data-ccp-parastyle='Normal (Web)'>sélectionnées pour cette soirée </span><span class='NormalTextRun SCXW257361568 BCX0' data-ccp-parastyle='Normal (Web)'>s’appuient sur des années d’imprégnation </span><span class='NormalTextRun SCXW257361568 BCX0' data-ccp-parastyle='Normal (Web)'>rythm</span><span class='NormalTextRun SCXW257361568 BCX0' data-ccp-parastyle='Normal (Web)'>ique</span><span class='NormalTextRun SCXW257361568 BCX0' data-ccp-parastyle='Normal (Web)'> et </span><span class='NormalTextRun SCXW257361568 BCX0' data-ccp-parastyle='Normal (Web)'>mélodi</span><span class='NormalTextRun SCXW257361568 BCX0' data-ccp-parastyle='Normal (Web)'>que</span> <span class='NormalTextRun SCXW257361568 BCX0' data-ccp-parastyle='Normal (Web)'>porteuse</span> <span class='NormalTextRun SCXW257361568 BCX0' data-ccp-parastyle='Normal (Web)'>d</span><span class='NormalTextRun SCXW257361568 BCX0' data-ccp-parastyle='Normal (Web)'>’</span><span class='NormalTextRun SCXW257361568 BCX0' data-ccp-parastyle='Normal (Web)'>émotions </span><span class='NormalTextRun SCXW257361568 BCX0' data-ccp-parastyle='Normal (Web)'>variées </span><span class='NormalTextRun SCXW257361568 BCX0' data-ccp-parastyle='Normal (Web)'>autour </span><span class='NormalTextRun SCXW257361568 BCX0' data-ccp-parastyle='Normal (Web)'>de </span><span class='NormalTextRun SCXW257361568 BCX0' data-ccp-parastyle='Normal (Web)'>la </span><span class='NormalTextRun SCXW257361568 BCX0' data-ccp-parastyle='Normal (Web)'>joie</span><span class='NormalTextRun SCXW257361568 BCX0' data-ccp-parastyle='Normal (Web)'> et de </span><span class='NormalTextRun SCXW257361568 BCX0' data-ccp-parastyle='Normal (Web)'>la </span><span class='NormalTextRun SCXW257361568 BCX0' data-ccp-parastyle='Normal (Web)'>tristesse</span><span class='NormalTextRun SCXW257361568 BCX0' data-ccp-parastyle='Normal (Web)'>,</span><span class='NormalTextRun SCXW257361568 BCX0' data-ccp-parastyle='Normal (Web)'> e</span><span class='NormalTextRun SCXW257361568 BCX0' data-ccp-parastyle='Normal (Web)'>n </span><span class='NormalTextRun SCXW257361568 BCX0' data-ccp-parastyle='Normal (Web)'>de leurs transformations </span><span class='NormalTextRun SCXW257361568 BCX0' data-ccp-parastyle='Normal (Web)'>subtiles</span><span class='NormalTextRun SCXW257361568 BCX0' data-ccp-parastyle='Normal (Web)'>. </span></span></p> <p><span class='TextRun SCXW257361568 BCX0' lang='FR-CA' xml:lang='FR-CA' data-contrast='none'><span class='NormalTextRun SCXW257361568 BCX0' data-ccp-parastyle='Normal (Web)'>Le voyage passe de structures d’inspiration classique </span><span class='NormalTextRun SCXW257361568 BCX0' data-ccp-parastyle='Normal (Web)'>en </span><span class='NormalTextRun SCXW257361568 BCX0' data-ccp-parastyle='Normal (Web)'>rythmes et </span><span class='NormalTextRun SCXW257361568 BCX0' data-ccp-parastyle='Normal (Web)'>en </span><span class='NormalTextRun SCXW257361568 BCX0' data-ccp-parastyle='Normal (Web)'>mélodies </span><span class='NormalTextRun SCXW257361568 BCX0' data-ccp-parastyle='Normal (Web)'>traversées par des </span><span class='NormalTextRun SCXW257361568 BCX0' data-ccp-parastyle='Normal (Web)'>couches sonores </span><span class='NormalTextRun SCXW257361568 BCX0' data-ccp-parastyle='Normal (Web)'>abstrait</span><span class='NormalTextRun SCXW257361568 BCX0' data-ccp-parastyle='Normal (Web)'>es </span><span class='NormalTextRun SCXW257361568 BCX0' data-ccp-parastyle='Normal (Web)'>et en développement perpétuel</span><span class='NormalTextRun SCXW257361568 BCX0' data-ccp-parastyle='Normal (Web)'>.</span></span><span class='EOP SCXW257361568 BCX0' data-ccp-props='{&quot;134233117&quot;:true,&quot;134233118&quot;:true,&quot;335551550&quot;:6,&quot;335551620&quot;:6}'> </span></p> <p><strong>Artiste :</strong><br /> <span class='TextRun SCXW257361568 BCX0' lang='FR-CA' xml:lang='FR-CA' data-contrast='none'><span class='NormalTextRun SCXW257361568 BCX0' data-ccp-parastyle='Normal (Web)'>Sadaf </span><span class='NormalTextRun SpellingErrorV2Themed SCXW257361568 BCX0' data-ccp-parastyle='Normal (Web)'>Amini : santour</span></span></p> "
      }
