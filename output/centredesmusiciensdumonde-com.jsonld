        "@language": "fr",
        "@value": "https://centredesmusiciensdumonde.com/wp-content/uploads/2026/01/stage-cajon-funk-pop.png"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "fr",
        "@value": "2026-3-18T18:00-4:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "fr",
        "@value": "2026-4-1T19:30-4:00"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Stages de cajón - Funk-pop"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\n                Instrument polyvalent par excellence, le cajón peut fournir une base rythmique solide dans une multitude de contextes : il s’adapte aisément à presque tous les styles musicaux.\nCet hiver, rejoignez-nous pour une série de stages intensifs de cajón spécialement conçus pour apprendre à accompagner différents styles musicaux au cajón.\nEn 3 sessions d’1h30 chacune, vous serez en mesure de reconnaître, comprendre et jouer les rythmes essentiels du Funk-pop.\nLe travail se fera avec des pistes audio afin de vous aider à percevoir clairement comment votre jeu de cajón s’intègre dans l’ensemble musical.\nLes mercredis 18, 25 mars et 1er avril\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
