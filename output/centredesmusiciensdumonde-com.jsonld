    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Une nuit dans le jardin d’Éden"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\n                Avec Une nuit dans le jardin d’Éden, le pianiste Guillaume Martineau et le clarinettiste Gabriel Paquin-Buki nous entraînent dans un voyage où les frontières musicales s’effacent. Leur duo navigue avec aisance entre le raffinement du classique et la chaleur du folklore, ponctuant leur dialogue d’improvisations jazz et de créations originales. \nLes racines vibrantes du klezmer se mêlent aux parfums envoûtants des rives méditerranéennes, tandis que des éclats de rythmes latins viennent danser sur les terres de l’Europe romantique. \nArtistes : \nGuillaume Martineau : piano\nGabriel Paquin-Buki : clarinette\n\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
