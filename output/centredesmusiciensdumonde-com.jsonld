    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Music from Latin America"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Discover traditional South American rhythms such as the bambuco, pasillo, Zulian dance and milonga, and the cultural history behind each piece in the Altiplano Ensemble&#8217;s rich repertoire.</p> <p>Altiplano is a young musical ensemble founded in Montreal by three Colombian musicians: Leandro Ruiz, Iván Ortiz and Pedro Botia. Through this project, they are committed to spreading the cultural wealth of their native country by interpreting the traditional rhythms of various Latin American countries.</p> "
      }
    ],
