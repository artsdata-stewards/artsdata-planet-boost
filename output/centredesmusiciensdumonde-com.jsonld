    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Valley of Dreams"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>With <em><strong>The Valley of Dreams</strong></em>, the <strong>Perse-Inca duo</strong> formed by <strong>Federico Tarazona</strong> (charango) and <strong>Showan Tavakol</strong> (kamancheh) continue the journey they began with their first album, Échos des montagnes.<br /> In this new phase, Andean and Persian strings respond to each other like two ancient voices reunited across time. True to the spirit of the initial project, the artists weave soundscapes where each note becomes a link between two worlds.</p> <p>Between improvisation, original compositions, and subtle references to tradition, this concert invites a timeless dialogue, imbued with nuances and vibrant sensations.</p> <p><strong>Artists:</strong><br /> Federico Tarazona: charango<br /> Showan Tavakol: kamancheh</p> "
      }
    ],
