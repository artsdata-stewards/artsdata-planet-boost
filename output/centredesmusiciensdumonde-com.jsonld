  {
    "@id": "https://centredesmusiciensdumonde.com/calendrier/concert-chorale-folklorique-turque/event_47267_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://centredesmusiciensdumonde.com/calendrier/concert-chorale-folklorique-turque/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://centredesmusiciensdumonde.com/wp-content/uploads/2026/02/evt-concert-eleves-chorale-turque.png"
