    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Musicians Ran Wang and Annette Bauer cross the Silk Road from east to west, from China to Italy via India."
      },
      {
        "@language": "en-ca",
        "@value": "The program is inspired by different physical and emotional landscapes that an imaginary traveller might encounter - from the observation"
      }
