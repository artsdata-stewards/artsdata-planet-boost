    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Gabriel Evangelista solo"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n                For his solo concert, pianist Gabriel Evangelista offers us his compositions and arrangements of pieces from the flamenco, jazz and Afro-Cuban repertoires. His expressive style, sometimes gentle, sometimes lively, will energize any audience.\nConcert will be offer at tha Public Piano on Laurier Avenue, near Querbes street\n            "
      }
    ],
