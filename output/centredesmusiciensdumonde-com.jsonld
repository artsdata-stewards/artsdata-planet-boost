    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Constellation de cordes - Virée classique"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\n                Avec en toile de fond des sonorités du XVIIe siècle, les voix et instruments du projet Constellation de cordes se mêlent et se superposent pour tisser une œuvre sans cesse renouvelée par les improvisations de Deo Munyakazi (Rwanda) sur sa cithare inanga.\nArtistes : Janelle Lucyck, violon & chant | Deo Munyakazi, inanga & voix | Kerry Bursey, théorbe | Reza Abaee, vièle ghaychak\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
