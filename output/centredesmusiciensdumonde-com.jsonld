      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Pour son concert en solo, le pianiste <strong>Gabriel Evangelista</strong> nous offre ses compositions et arrangements de pièces issues du répertoire flamenco, jazz, et de musique afro-cubaine. Son style expressif, tantôt doux, tantôt très animé, énergisera tout public.</p> <p>Le concert sera offert au Piano public sur l&rsquo;Avenue Laurier, près de la rue Querbes.</p> "
      }
    ],
