    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "An intimate concert where Andean and Persian strings respond to each other like two ancient voices reunited across time."
      },
      {
        "@language": "en-ca",
        "@value": "With The Valley of Dreams, the Perse-Inca duo formed by Federico Tarazona (charango) and Showan Tavakol (kamancheh) continue the journey"
      }
