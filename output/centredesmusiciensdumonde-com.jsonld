    "http://schema.org/image": [
      {
        "@language": "fr",
        "@value": "https://centredesmusiciensdumonde.com/wp-content/uploads/2024/09/Red-Bold-Modern-Music-Event-Announcement-Instagram-Post-695-x-380-px.png"
      }
    ],
    "http://schema.org/startDate": [
