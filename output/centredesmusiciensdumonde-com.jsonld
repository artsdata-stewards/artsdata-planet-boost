    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Deo Munyakazi - inanga du Rwanda"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\n                Deo Munyakazi est un musicien rwandais renommé pour sa maîtrise de l’inanga, une cithare traditionnelle des Grands Lacs d’Afrique. Cet instrument, essentiel à la musique rwandaise, sert à raconter des histoires et transmettre des valeurs culturelles.\n\nDeo s’illustre par son engagement à préserver cet héritage tout en l’actualisant. Ses performances, à la fois techniques et sensibles, captivent l’auditoire, reflétant la beauté méconnue de la culture rwandaise. En tant qu’ambassadeur musical, il valorise les traditions orales tout en construisant des ponts avec d’autres styles.\n\nUn artiste incontournable pour découvrir la richesse sonore du Rwanda à travers la présentation de nouvelles mélodies traditionnelles par Deo.\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
