  {
    "@id": "https://centredesmusiciensdumonde.com/en/calendrier/siraba-outdoor-concert/event_44155_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://centredesmusiciensdumonde.com/en/calendrier/siraba-outdoor-concert/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://centredesmusiciensdumonde.com/wp-content/uploads/2024/09/2023_11_27_ADAMA-DAOU16745-copie-scaled-e1727542495185.jpg"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://centredesmusiciensdumonde.com/en/calendrier/siraba-outdoor-concert/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Siraba outdoor concert"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><em>Siraba</em> means the great way, a proposal for dialogue between 3 continents&#8230;<br /> Attend an outdoor concert featuring the ancient traditions of Mali, West Africa, South America and Europe!</p> <p><strong>Musicians :</strong> <strong>Adama Daou</strong>: balafon;<strong> Gabriel Schwartz</strong>: flute, pandeiro; <strong>Aboulaye Koné</strong>: electric guitar; <strong>Christian Obam</strong>: electric bass</p> <p><strong>Pre-concert workshop:</strong> discovery and introduction to the balafon by Adama Daou, from 3:30 to 4:30 p.m.</p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-7-27T19:00-4::00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-7-27T20:00-4::00"
      }
    ],
