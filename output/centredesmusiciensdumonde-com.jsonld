      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "An unmissable artist for discovering the rich soundscape of Rwanda through the presentation of new traditional melodies by Deo."
      },
      {
        "@language": "en-ca",
        "@value": "Deo Munyakazi is a renowned Rwandan musician, famous for his mastery of the inanga, a traditional harp from the African Great"
      }
