    ],
    "http://schema.org/url": [
      {
        "@id": "https://centredesmusiciensdumonde.com/en/calendrier/gabriel-evangelista-solo-2/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://centredesmusiciensdumonde.com/wp-content/uploads/2024/09/094A3668-1r-e1726788503699.jpg"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://centredesmusiciensdumonde.com/en/calendrier/gabriel-evangelista-solo-2/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Gabriel Evangelista solo"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>For his solo concert, pianist <strong>Gabriel Evangelista</strong> offers us his compositions and arrangements of pieces from the flamenco, jazz and Afro-Cuban repertoires. His expressive style, sometimes gentle, sometimes lively, will energize any audience.</p> <p>Concert will be offer at tha Public Piano on Laurier Avenue, near Querbes street</p> "
