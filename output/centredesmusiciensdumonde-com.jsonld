  {
    "@id": "https://centredesmusiciensdumonde.com/calendrier/concert-intime-windborne/event_39715_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://centredesmusiciensdumonde.com/calendrier/concert-intime-windborne/"
