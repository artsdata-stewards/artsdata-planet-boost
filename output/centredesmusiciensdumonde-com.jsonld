    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Constellation de cordes - Virée classique"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Avec en toile de fond des sonorités du XVIIe siècle, les voix et instruments du projet <strong><em>Constellation de cordes</em></strong> se mêlent et se superposent pour tisser une œuvre sans cesse renouvelée par les improvisations de Deo Munyakazi (Rwanda) sur sa cithare <em>inanga</em>.</p> <p><strong>Artistes</strong> : <strong>Janelle Lucyck</strong>, <em>violon &amp; chant</em> | <strong>Deo Munyakazi</strong>, <em>inanga &amp; voix</em> | <strong>Kerry Bursey</strong><em>, théorbe</em> | <strong>Reza Abaee</strong><em>, vièle ghaychak</em></p> "
      }
    ],
    "http://schema.org/startDate": [
