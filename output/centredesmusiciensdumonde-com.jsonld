    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Andalusyria - Centre Sanaaq"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p><strong>Andalusyria</strong> réunit deux artistes talentueux qui ont créé un répertoire original au carrefour des traditions flamenco et arabes.<br /> <strong>Nazih Borish</strong>, musicien établi à Montréal, est un virtuose autodidacte du oud qui a fondé sa propre école de musique dans sa ville natale, Lattakia en Syrie; <strong>Gabriel Evangelista</strong>, montréalais d’origine espagnole, est un pianiste de flamenco-jazz. Tous deux ont développé leur propre langage musical au fil de leur carrière et s’investissent dans cette rencontre artistique qui lie leurs horizons culturels et personnels.</p> <p>Le résultat: une grande poésie construite sur des envolées de notes improvisées, uniques d’une représentation à l’autre.</p> "
      }
    ],
