    "http://schema.org/image": [
      {
        "@language": "en",
        "@value": "https://centredesmusiciensdumonde.com/wp-content/uploads/2023/10/media-social-festival-2023-1080x1080-1.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "en",
