      {
        "@language": "fr",
        "@value": "https://centredesmusiciensdumonde.com/wp-content/uploads/2025/05/Capture-decran-le-2025-05-09-a-11.45.16-1.png"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "fr",
        "@value": "2025-5-25T10:00-4:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@language": "fr",
        "@value": "2025-5-25T15:00-4:00"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Masterclass du grand maître de la musique turque, Fikret Karakaya"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\n                Fikret Karakaya donnera un masterclass les 24 et 25 mai, de 10 heures à 15 heures. Ce sera au Centre des Musiciens du Monde. Le but sera de travailler sur la musicalité, le phrasé, l’intonation, la compréhension des makams, etc.\nVoici comment se déroulera les masterclass:\nVous emmenez votre instrument ainsi que deux ou trois pièces du répertoire ottoman/turc, avec les partitions. Vous les jouerez devant Mr Karakaya, et il vous conseillera sur des façons dʼinterpréter, sur lʼintonation, le phrasé, etc.\nLes places sont limitées, et je vous demanderais de réserver votre place le plus vite possible, avant que ce soit plein, ainsi que de verser l’argent de ce masterclass. Pour cela, écrivez à royerartusonicolas@gmail.com.\n\nPrix du masterclass: 200$ pour les deux jours\nVous pouvez aussi assister au masterclass en tant quʼauditeur pour 50$ pour les deux jours.\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
  {
    "@id": "https://centredesmusiciensdumonde.com/temporary/1331188f-d713-42e0-b31e-23ffdc3ad12d",
