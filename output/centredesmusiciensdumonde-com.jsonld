    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Persian evening"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Are you a musician? Before the Persian music concert featuring Sadaf Amini, bring your instrument to celebrate the Iranian New Year, Nowruz, and discover the Center&#8217;s Persian music ensemble, led by gheychak player Reza Abaee.<br /> Tea, snacks, and fruit will be served on site.<br /> Join the ensemble for an evening!</p> <p>Prerequisite: play an instrument capable of producing quarter tones.</p> <p>From 5:30 pm to 7 pm<br /> Free admission<br /> Centre des musiciens du monde<br /> 5043 Saint-Dominique Street, Montreal<br /> Rooms 203 and 204</p> "
      }
    ],
    "http://schema.org/startDate": [
