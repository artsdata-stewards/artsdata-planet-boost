    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p><span class='TextRun SCXW208830246 BCX0' lang='FR-CA' xml:lang='FR-CA' data-contrast='none'><span class='NormalTextRun SCXW208830246 BCX0'>Avec</span><span class='NormalTextRun SCXW208830246 BCX0' data-ccp-charstyle='apple-converted-space' data-ccp-charstyle-defn='{&quot;ObjectId&quot;:&quot;2fd183b4-ad5c-5199-9fc7-89a6d0356079|1&quot;,&quot;ClassId&quot;:1073872969,&quot;Properties&quot;:[201342446,&quot;1&quot;,201342447,&quot;5&quot;,201342448,&quot;1&quot;,201342449,&quot;1&quot;,469777841,&quot;Aptos&quot;,469777842,&quot;&quot;,469777843,&quot;Aptos&quot;,469777844,&quot;Aptos&quot;,201341986,&quot;1&quot;,469769226,&quot;Aptos&quot;,268442635,&quot;24&quot;,469775450,&quot;apple-converted-space&quot;,201340122,&quot;1&quot;,134233614,&quot;true&quot;,469778129,&quot;apple-converted-space&quot;,335572020,&quot;1&quot;,469778324,&quot;Default Paragraph Font&quot;]}'> </span></span><em><strong><span class='TextRun SCXW208830246 BCX0' lang='FR-CA' xml:lang='FR-CA' data-contrast='none'><span class='NormalTextRun SCXW208830246 BCX0' data-ccp-charstyle='Emphasis'>Une nuit dans le jardin d’Éden</span></span></strong></em><span class='TextRun SCXW208830246 BCX0' lang='FR-CA' xml:lang='FR-CA' data-contrast='none'><span class='NormalTextRun SCXW208830246 BCX0'>, le pianiste <strong>Guillaume Martineau</strong> et le clarinettiste <strong>Gabriel Paquin-</strong></span><strong><span class='NormalTextRun SpellingErrorV2Themed SCXW208830246 BCX0'>Buki</span></strong><span class='NormalTextRun SCXW208830246 BCX0'> nous entraînent dans un voyage où les frontières musicales s’effacent. Leur duo navigue avec aisance entre le raffinement du classique et la chaleur du folklore, ponctuant leur dialogue d’improvisations jazz et de créations originales. </span></span></p> <p><span class='TextRun SCXW208830246 BCX0' lang='FR-CA' xml:lang='FR-CA' data-contrast='none'><span class='NormalTextRun SCXW208830246 BCX0'>Les racines vibrantes du </span><strong><span class='NormalTextRun SpellingErrorV2Themed SCXW208830246 BCX0'>klezmer</span></strong><span class='NormalTextRun SCXW208830246 BCX0'> se mêlent aux parfums envoûtants des rives méditerranéennes, tandis que des éclats de rythmes latins viennent danser sur les terres de l’Europe romantique.</span></span><span class='EOP SCXW208830246 BCX0' data-ccp-props='{&quot;335551550&quot;:6,&quot;335551620&quot;:6}'> </span></p> <p><strong>Artistes : </strong><br /> <span class='TextRun SCXW208830246 BCX0' lang='FR-CA' xml:lang='FR-CA' data-contrast='none'><span class='NormalTextRun SCXW208830246 BCX0'>Guillaume Martineau : piano<br /> Gabriel Paquin-<span class='NormalTextRun SpellingErrorV2Themed SCXW208830246 BCX0'>Buki : clarinette</span><br /> </span></span></p> "
      }
