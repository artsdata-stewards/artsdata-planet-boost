    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Musiques d'Amérique latine - Centre des musiciens du monde"
      },
      {
        "@language": "fr-ca",
        "@value": "Musiques d'Amérique latine"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Découvrez les rythmes traditionnels de l’Amérique du Sud tels que le bambuco, le pasillo, la danse zulienne et la milonga, et l’histoire culturelle qui se cache derrière chaque pièce du riche répertoire d’Altiplano Ensemble. Altiplano est un jeune ensemble musical fondé à Montréal par trois musiciens colombiens : Leandro Ruiz, Iván Ortiz et Pedro Botia. […]"
      },
      {
        "@language": "fr-ca",
        "@value": "Découvrez les rythmes traditionnels de l'Amérique du Sud tels que le bambuco, le pasillo, la danse zulienne et la milonga,"
