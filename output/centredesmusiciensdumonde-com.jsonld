    ],
    "http://schema.org/location": [
      {
        "@id": "_:g4517260"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://centredesmusiciensdumonde.com/calendrier/musiques-peulh-du-burkina-faso-3/"
