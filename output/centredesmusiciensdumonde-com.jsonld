    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Stages de cajón - Bossa Nova"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\n                Instrument polyvalent par excellence, le cajón peut fournir une base rythmique solide dans une multitude de contextes : il s’adapte aisément à presque tous les styles musicaux.\nCet hiver, rejoingnez-nous pour une série de stages intensifs de cajón spécialement conçus pour apprendre à accompagner différents styles musicaux au cajón.\nEn 3 sessions d’1h30 chacune, vous serez en mesure de reconnaître, comprendre et jouer les rythmes essentiels de la bossa-nova.\nLe travail se fera avec des pistes audio afin de vous aider à percevoir clairement comment votre jeu de cajón s’intègre dans l’ensemble musical.\nLes jeudis 15, 22 et 29 janvier.\nStages suivants : \nRumba espagnole :  11, 18, 25 février, de 18h à 19h30\nFunk-pop : 11, 18, 25 mars, de 18h à 19h30\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
  {
    "@id": "https://centredesmusiciensdumonde.com/temporary/d971942b-3ec1-42e6-b1e9-25abe5c66de5",
