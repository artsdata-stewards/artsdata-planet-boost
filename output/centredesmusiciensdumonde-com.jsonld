  },
  {
    "@id": "https://centredesmusiciensdumonde.com/en/calendrier/renaissance-dance-workshop/event_46682_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://centredesmusiciensdumonde.com/en/calendrier/renaissance-dance-workshop/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://centredesmusiciensdumonde.com/wp-content/uploads/2026/01/495x400-Danses-Renaissance-140225.png"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g5363100"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g5363140"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://centredesmusiciensdumonde.com/en/calendrier/renaissance-dance-workshop/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Renaissance dance workshop"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Discover the steps and figures of historical <strong>Renaissance dances</strong> repertoires, a lavish period of Italian and French courts in the 15th and 16th centuries, in this first monthly workshop of a series of four.</p> <p>On the program for this workshop with <strong>Anne-Marie Gardette</strong>: Spagnoletta by Caroso (Il Ballarino, Venice, 1581), Bassa danza Cupido by Guglielmo Ebreo (Ms, 1463), the ballroom dances from Thoinot Arbeau&#8217;s Orchésographie, pavane and gaillarde, common and cut branles (round dances) including the Branle des chevaux and the Branle de la guerre. We will also dance the dance of the Bouffons (sword dance).</p> <p>Open to all.</p> <p>Upcoming workshops:<br /> March 14, April 4, and May 2<br /> From 2:00 p.m. to 4:00 p.m.</p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-2-14T14:00-4::00"
      }
