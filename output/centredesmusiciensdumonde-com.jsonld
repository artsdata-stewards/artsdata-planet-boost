    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Masmoudi Quartette in Canmore"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>When cultures meet in the music of the <strong>Masmoudi Quartet</strong>, the result is truly extraordinary. <strong>Jazz</strong> is enriched by the interaction between Western and Middle Eastern instruments to create a tapestry of sound that is both familiar and unexpected. The group&#8217;s leader, <strong>Mohamed Masmoudi</strong>, is originally from Tunisia, and his music incorporates influences from a life devoted to study, travel, and performance. His works are known for their melodic richness and multifaceted texture. A sample of Masmoudi&#8217;s repertoire is a journey through moods and landscapes, from the lively Labyrinth to the sensual Moorish Tango.</p> <p>Artists:<br /> <strong>Mohamed Masmoudi</strong>: oud<br /> <strong>Guillame Martineau</strong>: piano<br /> <strong>Gabriel Paquin-Buki</strong>: clarinet<br /> <strong>Rémi-Jean Leblanc</strong>: double bass.</p> "
      }
    ],
