    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Veillée de chansons traditionnelles de mai"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\n                Chaque dernier vendredi du mois, venez partager, écouter ou simplement découvrir du répertoire de chansons traditionnelles d’ici et d’ailleurs dès 19h30 avec une veillée!\nBienvenue aux habitués, nouveaux et musiciens d’accompagnement!\nLa veillée est animée par Lysandre Chartrand \nLe vendredi 29 mai 2026 de 19h30 à 22h30\nTarif : 10 $ (argent comptant seulement) \n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
