    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Constellation de cordes - Virée classique"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Against a backdrop of 17th-century sounds, the voices and instruments of the<strong><em> Constellation de cordes</em></strong> project blend and overlap to weave a work constantly renewed by the improvisations of Deo Munyakazi (Rwanda) on his inanga zither.</p> <p><strong>Artists: Janelle Lucyck</strong>, <em>violin &amp; vocals</em> | <strong>Deo Munyakazi</strong>, <em>inanga &amp; vocals</em> | <strong>Kerry Bursey</strong>, <em>theorbo</em> | <strong>Reza Abaee</strong>, <em>ghaychak fiddle</em></p> <p>Free concert as part of the <strong>Orchestre Symphonique de Montréal&#8217;s Virée Classique OSM</strong>.</p> "
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
