    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Stage - Chant classique arabe"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\n                Rejoignez Lamia Yared pour trois soirées immersives dédiées aux maqams de la musique arabe, explorés à travers le répertoire raffiné des muwashahat.\nDurant ce stage intensif en chant classique arabe, vous y découvrirez leurs intervalles et leurs rythmes caractéristiques, tout en abordant les bases essentielles de l’interprétation et de la technique du chant oriental. \nUn format idéal pour affiner l’oreille, la voix et la musicalité! \n Les 19, 20 février de 18h à 20h et le 21 février de 15h à 17h.\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
