    "http://schema.org/image": [
      {
        "@id": "https://centredesmusiciensdumonde.com/wp-content/uploads/2023/10/Creation-sans-titre-7-2-e1726793557547.png"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "_:g4952860"
