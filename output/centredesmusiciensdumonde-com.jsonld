    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Siraba outdoor concert"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n                Siraba means the great way, a proposal for dialogue between 3 continents…\nAttend an outdoor concert featuring the ancient traditions of Mali, West Africa, South America and Europe!\nMusicians : Adama Daou: balafon; Gabriel Schwartz: flute, pandeiro; Aboulaye Koné: electric guitar; Christian Obam: electric bass\nPre-concert workshop: discovery and introduction to the balafon by Adama Daou, from 3:30 to 4:30 p.m.\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
