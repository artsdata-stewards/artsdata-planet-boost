    ],
    "https://schema.org/text": [
      {
        "@language": "fr",
        "@value": "Lieu de création, de formation et de diffusion dédié au développement et à la promotion des différentes traditions musicales du monde. \n"
      }
    ]
  },
  {
    "@id": "https://centredesmusiciensdumonde.com/temporary/1c79dbab-576e-455b-9c8a-a110c691d64c",
    "@type": [
      "https://schema.org/CreativeWork"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://centredesmusiciensdumonde.com/"
      }
    ],
    "https://schema.org/text": [
      {
        "@language": "fr",
        "@value": "Le changement commence avec des gens comme vous. Chaque acte de gentillesse, chaque dollar et chaque moment de votre temps nous rapproche de la réalisation de notre mission.\n"
      }
    ]
  },
  {
    "@id": "https://centredesmusiciensdumonde.com/temporary/b8cd6716-c976-422f-b771-ce81dc1ea742",
    "@type": [
      "https://schema.org/CreativeWork"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://centredesmusiciensdumonde.com/"
      }
    ],
    "https://schema.org/text": [
      {
        "@language": "fr",
        "@value": "Découvrez les traditions musicales du monde grâce à nos cours pour tous les âges et niveaux. Apprenez à jouer des instruments rares et à explorer des répertoires uniques auprès de musicien·ne·s chevronné·e·s.\n"
      }
    ]
  },
  {
    "@id": "https://centredesmusiciensdumonde.com/temporary/bbe7d2d3-86f8-4db7-b777-a91ca45c4f2d",
    "@type": [
      "https://schema.org/CreativeWork"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://centredesmusiciensdumonde.com/"
      }
    ],
    "https://schema.org/text": [
      {
        "@language": "fr",
        "@value": "Nous soutenons des artistes professionnel·e·s dans leur démarche créative et acoustique au sein de nos résidences de création. Cet accompagnement inclut :\n\nune rémunération pour la composition\nun nombre conséquent d’heures de répétition\nl’accès aux locaux du Centre\nla diffusion publique des œuvres\nun soutien au rayonnement provincial, fédéral et international\n\n"
      }
    ]
  },
  {
    "@id": "https://centredesmusiciensdumonde.com/temporary/147dadc0-0b51-4c38-98c2-400aa04ef6da",
    "@type": [
      "https://schema.org/CreativeWork"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://centredesmusiciensdumonde.com/"
      }
    ],
    "https://schema.org/text": [
      {
        "@language": "fr",
        "@value": "Prenez part à des stages et ateliers sur différents répertoires issus des traditions musicales du monde.\n"
      }
    ]
  },
  {
    "@id": "https://centredesmusiciensdumonde.com/temporary/bbf6f2c3-96c8-4bb4-8b79-c8280fc4c3ea",
