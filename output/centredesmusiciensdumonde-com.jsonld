    "http://schema.org/image": [
      {
        "@language": "fr",
        "@value": "https://centredesmusiciensdumonde.com/wp-content/uploads/2025/03/concert-intime-13.png"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "fr",
        "@value": "2025-4-24T20:00-4:00"
