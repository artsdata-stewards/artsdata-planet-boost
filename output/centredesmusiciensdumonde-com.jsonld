  {
    "@id": "https://centredesmusiciensdumonde.com/en/calendrier/sava-croatian-polyphonies-klapa/event_42592_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://centredesmusiciensdumonde.com/en/calendrier/sava-croatian-polyphonies-klapa/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://centredesmusiciensdumonde.com/wp-content/uploads/2025/03/concert-intime-2.png"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g3614780"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://centredesmusiciensdumonde.com/en/calendrier/sava-croatian-polyphonies-klapa/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Sava - Musique vocale de Croatie (klapa)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Klapa (or klapsko pjevanje) is a multi-part singing tradition from the southern Croatian regions of Dalmatia. Sung in several voices, homophonic and a capella, the term klapa means ‘group of people’. With its rich blend of harmonies, klapa songs celebrate love, wine, homeland and the sea. Since 2012, this traditionally male genre has been included on UNESCO&#8217;s Representative List of the Intangible Cultural Heritage of Humanity.</p> <p>Sava is a female vocal ensemble performing polyphonic a cappella music from the Balkans. With Sarah Albu, Antonia Branković, Dina Cindrić and Sara Rousseau.</p> "
      }
    ],
    "http://schema.org/startDate": [
