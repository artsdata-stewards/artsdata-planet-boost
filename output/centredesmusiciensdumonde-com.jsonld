  {
    "@id": "https://centredesmusiciensdumonde.com/en/calendrier/ganbold-curtet-diphonic-songs-from-mongolia/event_42866_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://centredesmusiciensdumonde.com/en/calendrier/ganbold-curtet-diphonic-songs-from-mongolia/"
      }
