  {
    "@id": "https://centredesmusiciensdumonde.com/en/calendar/event_47050_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://centredesmusiciensdumonde.com/en/calendrier/silk-notebooks-echoes-from-east-to-west-in-ville-saint-laurent/var/ri-0.l-L2"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://centredesmusiciensdumonde.com/wp-content/uploads/2024/08/19_jun_CMM_jmalobaton_-13-e1725711929972.jpg"
      }
    ],
    "http://schema.org/organizer": [
