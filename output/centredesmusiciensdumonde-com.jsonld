    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Musique ottomane avec Fikret Karakaya"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\n                Accompagné au oud/ud par Nicolas Royer-Artuso, le maître Fikret Karakaya montrera la richesse des mélodies ottomanes, des modes propres à cette musique, ainsi que lʼart de lʼornementation, à travers son jeu au kemençe, petite lyre au son puissant. Ce concert exceptionnel sera un hommage aux grands compositeurs de lʼépoque ottomane et à l’art de l’improvisation (taksim).\nFirket Karakaya est chanteur, joueur de kemençe et de çeng, est compositeur, musicologue, écrivain et luthier. Il a été jusquʼà sa retraite musicien et présentateur pour TRT (la radio nationale de Turquie). Il est le fondateur et directeur de lʼEnsemble Bezmara invité à se produire dans de nombreux pays, et onze albums à son actif.\nNicolas Royer-Artuso est compositeur, musicien (oud, violon électronique et guitare fretless), linguiste, musicologue et écrivain. Son travail a été présenté en Allemagne, Angleterre, Arménie, Autriche, Brésil, Canada, Colombie, Finlande, France, Géorgie, Hollande, Italie, Liban, Lituanie, Pologne, Turquie et aux États-Unis.\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
  {
    "@id": "https://centredesmusiciensdumonde.com/temporary/d208f02f-2946-4f4e-9dcd-f1442d580052",
    "@type": [
      "https://schema.org/WPFooter"
    ],
