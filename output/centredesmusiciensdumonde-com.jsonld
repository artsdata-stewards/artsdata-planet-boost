    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Atelier de Danses Renaissance - Mai"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\n                La Renaissance est une période importante pour l’essor de la danse en Occident, car on y voit apparaître les tout premiers traités de danse.\nCette série d’ateliers offert par Anne-Marie Gardette s’intéressera aux danses des cours italiennes des Quattrocento et Cinquecento (bassa danza, balletto,…). Le répertoire de bal en usage en France à la fin du XVIe siècle selon l’incontournable Orchésographie de Thoinot Arbeau (branle, pavane, gaillarde,…) seront également abordés.\nCes ateliers de 2h chacun, sont ouverts à toutes et à tous, bienvenue également aux musicien.nes qui jouent ce répertoire (Praetorius, Attaingnant, Gervaise, Phalèse, etc.) et qui veulent en connaître les danses.\nChacun des ateliers abordera différentes danses, ils peuvent donc être suivis de manière indépendante.\nOuverts à toutes et à tous.\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
  {
    "@id": "https://centredesmusiciensdumonde.com/temporary/e2a3d1d4-795a-4982-9401-f14cd46c07d9",
    "@type": [
      "https://schema.org/WPFooter"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
