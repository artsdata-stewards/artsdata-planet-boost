      }
    ],
    "http://ogp.me/ns#locale:alternate": [
      {
        "@language": "fr-ca",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "article"
      },
      {
        "@language": "fr-ca",
        "@value": "event"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Masmoudi Quartette - Centre des musiciens du monde"
      },
      {
        "@language": "fr-ca",
        "@value": "Masmoudi Quartette"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Une musique qui fait voyager! Traversée par les sonorités du jazz, les subtilités du classique, les inflexions klezmer et les rythmes du tango."
      },
