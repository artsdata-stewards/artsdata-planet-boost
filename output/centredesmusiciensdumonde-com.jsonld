    "http://schema.org/image": [
      {
        "@language": "fr",
        "@value": "https://centredesmusiciensdumonde.com/wp-content/uploads/2025/09/Stage-de-guiterneluth-m.png"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@language": "fr",
        "@value": "2025-9-25T12:00-4:00"
      }
