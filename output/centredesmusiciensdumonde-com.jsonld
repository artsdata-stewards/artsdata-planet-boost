    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "!! COMPLET !! Nazih Borish - oud du Moyen-Orient"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\n                Nazih Borish est un virtuose du oud, l’instrument à cordes arabe à l’origine des luths européens, et un musicien de renom dans le monde de la musique orientale. Né en Syrie, il a été formé dès son plus jeune âge dans la riche tradition musicale arabe.\n\nSa technique exceptionnelle et son interprétation unique du oud lui ont valu une reconnaissance internationale. Il allie tradition et innovation, tout en respectant l’essence de la musique classique arabe. Ses performances captivantes mêlent improvisations subtiles et compositions raffinées.\n\nNazih Borish est également un compositeur accompli, créant des œuvres qui explorent de nouvelles dimensions du oud tout en restant fidèle à ses racines.\n\nPar son jeu expressif et sa maîtrise du répertoire classique arabe, il est l’un des ambassadeurs les plus influents de la musique arabe contemporaine qui tisse des liens avec d’autres traditions musicales du monde.\n            "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
