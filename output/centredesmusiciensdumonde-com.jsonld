    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Carnet de soie : échos d&#039;est en ouest"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Voyage musical sur la route de la soie, entre Chine, Inde et Italie. Avec guzheng, sarode, flûtes, dubuk et tabor, les musiciennes traversent les époques.</p> <p>De la dynastie Han à la Renaissance, guidées par un voyageur imaginaire, elles découvrent paysages inconnus, beauté et solitude. Spectacle présenté par le Centre des musiciens du monde.</p> <p><strong>Musiciennes : </strong>Ran Wang, <em>ghuzeng </em>| Annette Bauer, <em>sarode, flûtes à bec, duduk, tabor</em></p> "
      }
    ],
