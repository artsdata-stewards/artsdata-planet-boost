  {
    "@id": "https://centredesmusiciensdumonde.com/calendrier/andalusyria/event_40866_0",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://centredesmusiciensdumonde.com/calendrier/andalusyria/"
