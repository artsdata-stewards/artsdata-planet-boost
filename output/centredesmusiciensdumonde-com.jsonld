        "@value": "Un univers de traditions musicales en mouvement\n"
      }
    ]
  },
  {
    "@id": "https://centredesmusiciensdumonde.com/temporary/77df7cd1-f737-4c92-9ed4-b14494007a52",
    "@type": [
