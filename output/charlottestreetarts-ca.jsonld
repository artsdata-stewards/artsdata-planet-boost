    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>The Charlotte Street Arts Centre (CSAC) is an important space for arts and culture activities in downtown Fredericton. The Centre is located in the old Charlotte Street School, an historical building dating back to 1884. CSAC provides spaces to artists and organizations in all disciplines, including visual, performing, musical, and literary as well as to a variety of cultural groups. The building features the Charlotte Glencross Gallery, a fully technically-equipped auditorium upstairs (available for rental for events), artist studios and a basement cafe &amp; restaurant.</p>"
      }
    ]
  },
