    "http://schema.org/image": [
      {
        "@id": "https://images.squarespace-cdn.com/content/v1/594981edbf629ab7571b4b81/9e4642fe-4a20-4db0-b794-3f3999ebb8ff/Untitled+design+%2833%29.png"
