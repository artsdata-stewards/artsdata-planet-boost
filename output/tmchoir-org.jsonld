  {
    "@id": "https://www.tmchoir.org/event/verdi-requiem-gw/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Verdi’s Requiem - Toronto Mendelssohn Choir"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Enthralling, dramatic, and yet eerily beautiful—nothing compares to Verdi’s Requiem. This spellbinding masterwork weaves together a thrilling symphonic score and breathtaking solos with one of the most harrowing sacred texts—a powerful cry for deliverance."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://www.tmchoir.org/event/verdi-requiem-gw/"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en-us",
        "@value": "Toronto Mendelssohn Choir"
      }
    ],
