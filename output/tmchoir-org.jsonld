    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Singsation with Jean-Sébastien Vallée"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Join Artistic Director Jean-Sébastien Vallée for a Singsation workshop. It’s a community singing workshop, and a wonderful way to spend a Saturday morning – with people who love to sing! The Theme: Bach’s Passions: Drama, Devotion, and Music Experience an inspiring Singsation with our own Artistic Director, Jean-Sébastien Vallée, as we explore Bach’s extraordinary settings..."
      },
      {
        "@language": "en",
        "@value": "Join Artistic Director Jean-Sébastien Vallée for a Singsation workshop. It’s a community singing workshop, and a wonderful way to spend a Saturday morning – with people who love to sing!..."
      }
    ],
