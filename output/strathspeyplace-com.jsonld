    "http://schema.org/name": [
      {
        "@value": "Happy ha ha Holidaze!!"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;The Ha Ha Holiday show that promises to deliver plenty of la la laughter&lt;br /&gt;\\nand some chair-dancin’, toe-tappin musical moments.&lt;/p&gt;\\n&lt;p&gt;You can also expect a visit from a quirky character or two, too. If you’re&lt;br /&gt;\\nlooking to forget about the stress of the real world for awhile, spend&lt;br /&gt;\\nsome time with the Holidaze crew for their unique seasonal celebration&lt;br /&gt;\\nfull of good feelings. We’ll meet you there! CAST FEATURES: Heather&lt;br /&gt;\\nRankin, Jenn Sheppard, Terrance Murphy, Colin Grant, Fred Lavery,&lt;br /&gt;\\nStephen Muise and Emily Dingwall. &lt;/p&gt;\\n"
      }
    ],
