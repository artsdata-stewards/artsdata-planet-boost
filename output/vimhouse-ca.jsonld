    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "EAST OF THE SUN &#8211; SE:UM and Jasmine Jazz (New West)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Friday, May 3rd, 2024 Show: 7:30 PM Doors: 6:30 PM Venue: The Anvil Theatre -777 Columbia St, New Westminster, BC V3M 1B6 Get your tickets in advance ($14-$28) A cultural celebration as renowned ensembles SE:UM (from Korea) and Jasmine Jazz share the stage for an evening of east-meets-west, genre-defying exploration. https://youtu.be/MIVOrpC4_dM?si=zvJ-0g4QokduGF8L SE:UM is a renowned [&hellip;]&lt;/p&gt;\\n"
      }
    ],
