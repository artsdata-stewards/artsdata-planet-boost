    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;UNDER THE ATRIUM: RAHAEL &amp; SUGARFUNGUS FRIDAY, SEPTEMBER 15th, 2023 KW PRODUCTION STUDIO Woodwards Building - #10 – 111 Hastings St W, Vancouver, BC V6B 1H4 Doors: 7:30 PM Show: 8:00 PM ALL AGES / DRY EVENT Sliding Scale Ticket Pricing + PWYC At The Door TICKETS: https://vim-undertheatrium-sept15.eventbrite.ca Rahael Rahael creates an immersive and cinematic [&hellip;]&lt;/p&gt;\\n"
      }
    ],
