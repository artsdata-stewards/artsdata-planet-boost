        "@language": "en",
        "@value": "  12 events found.            [{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"&#8216;The Way We Were&#8217; with Timothy Noel\",\"description\":\"&lt;p&gt;TiMiNo Entertainment proudly presents The Way We Were, an unforgettable night of music featuring Edmonton\\u2019s own Timothy Noel and his band, The RearViews. The concert supports Ronald McDonald House Charities (RMHC) Alberta, with $5 from every ticket directly benefiting the charity. The evening will also mark the release of Timothy Noel\\u2019s first professional single, \\u201cRight&hellip;&lt;/p&gt;\\\\n\",\"url\":\"https://www.albertamusic.org/event/the-way-we-were-with-timothy-noel/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-11-08T19:00:00-07:00\",\"endDate\":\"2025-11-08T22:00:00-07:00\",\"location\":{\"@type\":\"Place\",\"name\":\"festival place\",\"description\":\"\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Sherwood Park\",\"addressRegion\":\"AB\"},\"telephone\":\"\",\"sameAs\":\"\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Natalie Inga &#038; The Ladybros EP Release Party\",\"description\":\"&lt;p&gt;Join Natalie Inga in celebrating the latest release of her EP : \\\\'Know When to Leave\\\\'&lt;/p&gt;\\\\n\",\"url\":\"https://www.albertamusic.org/event/natalie-inga-the-ladybros-ep-release-party/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-11-13T20:30:00-07:00\",\"endDate\":\"2025-11-13T22:30:00-07:00\",\"location\":{\"@type\":\"Place\",\"name\":\"The King Eddy\",\"description\":\"\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"438 9 Avenue SE\",\"addressLocality\":\"Calgary\",\"addressRegion\":\"AB\"},\"telephone\":\"\",\"sameAs\":\"\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Paul Woida Live at Festival Place\",\"description\":\"&lt;p&gt;Paul Woida is a one-man band who uses live looping to deliver the power and dynamics of a full band. After nearly signing with a major label in Nashville, he chose to forge his own path and release music independently. Just one year into his independent journey, Paul has already earned over 1.1 million streams.&hellip;&lt;/p&gt;\\\\n\",\"url\":\"https://www.albertamusic.org/event/paul-woida-live-at-festival-place/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-11-14T19:00:00-07:00\",\"endDate\":\"2025-11-14T21:00:00-07:00\",\"location\":{\"@type\":\"Place\",\"name\":\"festival place\",\"description\":\"\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Sherwood Park\",\"addressRegion\":\"AB\"},\"telephone\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"22.00 \\u2013 27.00\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.albertamusic.org/event/paul-woida-live-at-festival-place/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-10-14T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Matthew and the Keys\",\"description\":\"&lt;p&gt;MATTHEW AND THE KEYS, LIVE AT @nakedcybercafe ! Come on down and sing, dance and groove with us. Go to the link in my bio for tickets to the show. This one is ALL AGES! 7 pm doors, 8 pm for the show! Advanced tickets: $10.00 for kids under 12 years old, $15.00 general admission&hellip;&lt;/p&gt;\\\\n\",\"url\":\"https://www.albertamusic.org/event/matthew-and-the-keys/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-11-15T19:00:00-07:0