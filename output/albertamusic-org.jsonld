urpose while still holding onto that youthful&hellip;&lt;/p&gt;\\\\n\",\"url\":\"https://www.albertamusic.org/event/104-szn-s-a-l-a-k-release-party/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-03-14T18:00:00-06:00\",\"endDate\":\"2026-03-14T20:00:00-06:00\",\"location\":{\"@type\":\"Place\",\"name\":\"10905 106 Ave\",\"description\":\"\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Edmonton\",\"addressRegion\":\"AB\"},\"telephone\":\"\",\"sameAs\":\"\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Caroline Parke Album Release Party\",\"description\":\"&lt;p&gt;Join Caroline Parke for the celebration of her album, &quot;All the Moving Parts&quot; at Edmonton\\\\'s The Rooster &nbsp; &nbsp;&lt;/p&gt;\\\\n\",\"url\":\"https://www.albertamusic.org/event/caroline-parke-album-release-party/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-03-28T14:00:00-06:00\",\"endDate\":\"2026-03-28T17:00:00-06:00\",\"location\":{\"@type\":\"Place\",\"name\":\"the rooster\",\"description\":\"\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"10732 Whyte ave\",\"addressLocality\":\"Edmonton\",\"addressRegion\":\"Alberta\"},\"telephone\":\"\",\"sameAs\":\"\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"The Big Little Concert\",\"description\":\"&lt;p&gt;Three family artists. One stage. Endless fun! Join Beppie, Seeka Sings, and Beth Portman for an unforgettable musical experience that the whole family will enjoy. Live Music, dancing, singing, and crafting right in the heart of the Whitemud Crossing Library. &nbsp; Event cost (free, fixed price or\\u00a0range): $15&lt;/p&gt;\\\\n\",\"url\":\"https://www.albertamusic.org/event/the-big-little-concert/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-04-18T14:00:00-06:00\",\"endDate\":\"2026-04-18T18:00:00-06:00\",\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Cosmopolitan Music Society : Latin Dance Party\",\"description\":\"&lt;p&gt;It\\\\'s time to dance! Join the Cosmopolitan Music Society Jazz Big Band, Cosmopolitones, and special guest - dance instructor extraordinaire- Maxwell Aguilar, in an evening of hot and lively music and dance. Ticket price includes over an hour of dance lessons led by Maxwell and members of his dance school, Caribbean Touch. Showtime: Friday, April&hellip;&lt;/p&gt;\\\\n\",\"url\":\"https://www.albertamusic.org/event/cosmopolitan-music-society-latin-dance-party/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-04-24T19:00:00-06:00\",\"endDate\":\"2026-04-24T22:00:00-06:00\",\"performer\":\"Organization\"}]   {\"slug\":\"list\",\"prev_url\":\"https:\\/\\/www.albertamusic.org\\/events\\/list\\/page\\/2\\/?tribe-bar-date=2026-04-25&eventDisplay=past\",\"next_url\":\"https:\\/\\/www.albertamusic.org\\/events\\/list\\/?tribe-bar-date=2026-04-25\",\"view_class\":\"Tribe\\\\Events\\\\Views\\\\V2\\\\Views\\\\List_View\",\"view_slug\":\"list\",\"view_label\":\"List\",\"title\":\"Events Archive - Alberta Music\",\"events\":[15657,15649,15654,15660,15652,15665,15662,15625,15646,15627,15854,15852],\"url\":\"https:\\/\\/www.albertamusic.org\\/events\\/list\\/?tribe-bar-date=2026-04-25&eventDisplay=past\",\"url_event_date\":\"2026-04-25\",\"bar\":{\"keyword\":\"\",\"date\":\"2026-04-25\"},\"today\":\"2026-04-19 00:00:00\",\"now\":\"2026-04-19 20:09:59\",\"home_url\":\"https:\\/\\/www.albertamusic.org\",\"rest_url\":\"https:\\/\\/www.albertamusic.org\\/wp-json\\/tribe