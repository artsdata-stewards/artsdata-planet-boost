        "@value": "  11 events found.            [{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"John Hewitt and Abigayle Oakley &#8211; Analog Books\",\"description\":\"\",\"url\":\"https://www.albertamusic.org/event/john-hewitt-and-abigayle-oakley-analog-books/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-02-25T18:00:00-07:00\",\"endDate\":\"2026-02-25T20:00:00-07:00\",\"location\":{\"@type\":\"Place\",\"name\":\"analog books\",\"description\":\"\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"322 6th St\",\"addressLocality\":\"Lethbridge\",\"addressRegion\":\"AB\"},\"telephone\":\"\",\"sameAs\":\"\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"John Hewitt and the New Americans &#8211; Lacombe Performing Arts Centre\",\"description\":\"\",\"url\":\"https://www.albertamusic.org/event/john-hewitt-and-the-new-americans-lacombe-performing-arts-centre/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-02-27T18:00:00-07:00\",\"endDate\":\"2026-02-27T20:00:00-07:00\",\"location\":{\"@type\":\"Place\",\"name\":\"lacombe performing arts centre\",\"description\":\"\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"5227 Calgary Edmonton Trail\",\"addressLocality\":\"Lacombe\",\"addressRegion\":\"AB\"},\"telephone\":\"\",\"sameAs\":\"\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Jillian Treidler Album Release Party\",\"description\":\"&lt;p&gt;Join Jillian Treidler and Social Eyes at the Aviary on Feb 27th to celebrate the release of Jillian\\\\'s debut album - &quot;Death in the Family&quot; &nbsp; Where : The Aviary&hellip;&lt;/p&gt;\\\\n\",\"url\":\"https://www.albertamusic.org/event/jillian-treidler-album-release-party/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-02-27T19:00:00-07:00\",\"endDate\":\"2026-02-27T21:00:00-07:00\",\"location\":{\"@type\":\"Place\",\"name\":\"the aviary\",\"description\":\"\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"9314 111 Ave NW, Edmonton, AB T5G 0A3, Canada\",\"addressLocality\":\"Edmonton\",\"addressRegion\":\"AB\"},\"telephone\":\"\",\"sameAs\":\"\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"104 SZN : &#8220;S.A.L.A.K.&#8221; Release Party\",\"description\":\"&lt;p&gt;Stop Acting Like a Kid. A soundtrack to growth, pressure, purpose, and staying young at heart. This night will be a celebration of life. EP RELEASE PARTY This night marks&hellip;&lt;/p&gt;\\\\n\",\"url\":\"https://www.albertamusic.org/event/104-szn-s-a-l-a-k-release-party/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-03-14T18:00:00-06:00\",\"endDate\":\"2026-03-14T20:00:00-06:00\",\"location\":{\"@type\":\"Place\",\"name\":\"10905 106 Ave\",\"description\":\"\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Edmonton\",\"addressRegion\":\"AB\"},\"telephone\":\"\",\"sameAs\":\"\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Caroline Parke Album Release Party\",\"description\":\"&lt;p&gt;Join Caroline Parke for the celebration of her album, &quot;All the Moving Parts&quot; at Edmonton\\\\'s The Rooster &nbsp; &nbsp;&lt;/p&gt;\\\\n\",\"url\":\"https://www.albertamusic.org/event/caroline-parke-album-release-party/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-03-28T14:00:00-06:00\",\"endDate\":\"2026-03-28T17:00:00-06:00\",\"location\":{\"@type\":\"Place\",\"name\":\"the rooster\",\"description\":\"\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"10732 Whyte ave\",\"addressLocality\":\"Edmonton\",\"addressRegion\":\"Alberta\"},\"telephone\":\"\",\"sameAs\":\"\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"The Big Little Concert\",\"description\":\"&lt;p&gt;Three family artists. One stage. Endless fun! Join Beppie, Seeka Sings, and Beth Portman for an unforgettable musical experience that the whole family will enjoy. Live Music, dancing, singing, and&hellip;&lt;/p&gt;\\\\n\",\"url\":\"https://www.albertamusic.org/event/the-big-little-concert/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-04-18T14:00:00-06:00\",\"endDate\":\"2026-04-18T18:00:00-06:00\",\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Cosmopolitan Music Society : Latin Dance Party\",\"description\":\"&lt;p&gt;It\\\\'s time to dance! Join the Cosmopolitan Music Society Jazz Big Band, Cosmopolitones, and special guest - dance instructor extraordinaire- Maxwell Aguilar, in an evening of hot and lively music&hellip;&lt;/p&gt;\\\\n\",\"url\":\"https://www.albertamusic.org/event/cosmopolitan-music-society-latin-dance-party/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-04-24T19:00:00-06:00\",\"endDate\":\"2026-04-24T22:00:00-06:00\",\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Samarpan Music and Dance Festival\",\"description\":\"&lt;p&gt;Join the 9th annual Samarpan Festival, presented by the Samarpan Foundation of Indian Music and Dance - a registered non profit organization dedicated to celebrating music, poetry, and artistic expression&hellip;&lt;/p&gt;\\\\n\",\"url\":\"https://www.albertamusic.org/event/samarpan-music-and-dance-festival/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-04-25T18:00:00-06:00\",\"endDate\":\"2026-04-25T21:00:00-06:00\",\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Beltuner : Live in Edmonton\",\"description\":\"&lt;p&gt;Where the pulse of Parisian accordion melody meets Gypsy swing and Balkan rhythms collide with Jazz improvisation, Beltuner takes you on a vibrant and unforgettable musical adventure. Don\\\\'t miss out&hellip;&lt;/p&gt;\\\\n\",\"url\":\"https://www.albertamusic.org/event/beltuner-live-in-edmonton/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-04-25T19:00:00-06:00\",\"endDate\":\"2026-04-25T21:30:00-06:00\",\"location\":{\"@type\":\"Place\",\"name\":\"fringe theatre\",\"description\":\"\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"10330 84 Ave NW\",\"addressLocality\":\"edmonton\",\"addressRegion\":\"AB\"},\"telephone\":\"\",\"sameAs\":\"\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"The Sinners Cabaret\",\"description\":\"&lt;p&gt;The Sinners Cabaret: Halfway to Halloween Celebration lands May 17 at Starlite Room / Temple \\ud83d\\udda4 A one-night-only underground cabaret of drag, burlesque, magic, live music, and pop up market!&hellip;&lt;/p&gt;\\\\n\",\"url\":\"https://www.albertamusic.org/event/the-sinners-cabaret/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-05-17T18:00:00-06:00\",\"endDate\":\"2026-05-17T22:30:00-06:00\",\"location\":{\"@type\"