    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Where the pulse of Parisian accordion melody meets Gypsy swing and Balkan rhythms collide with Jazz improvisation, Beltuner takes you on a vibrant and unforgettable musical adventure. Don&#8217;t miss out on this bold musical fusion experience! Date : April 25, 2026 Time: 7:00 pm Venue: Fringe Theatre, Edmonton, AB Tickets: $12 for members, $17 for&hellip;"
      },
      {
        "@language": "en",
        "@value": "Where the pulse of Parisian accordion melody meets Gypsy swing and Balkan rhythms collide with Jazz improvisation, Beltuner takes you on a vibrant and unforgettable musical adventure. Don&#8217;t miss out&hellip;"
      }
