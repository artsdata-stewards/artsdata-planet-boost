        "@value": "  12 events found.            [{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"New Moon Folk Club &#8211; Jed and the Valentine and Abigayle Oakley\",\"description\":\"&lt;p&gt;Join Jed and the Valentine and Abigayle Oakley for a double bill performance at the New Moon Folk Club&lt;/p&gt;\\\\n\",\"url\":\"https://www.albertamusic.org/event/new-moon-folk-club-jed-and-the-valentine-and-abigayle-oakley/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-02-11T08:00:00-07:00\",\"endDate\":\"2026-02-11T17:00:00-07:00\",\"location\":{\"@type\":\"Place\",\"name\":\"new moon folk club\",\"description\":\"\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"10819 71 ave nw\",\"addressLocality\":\"Edmonton\",\"addressRegion\":\"AB\"},\"telephone\":\"\",\"sameAs\":\"\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Flowshine On Tour &#8211; Calgary\",\"description\":\"&lt;p&gt;Join Flowshine at Calgary\\\\'s Pig &amp; Whistle as they tour Western Canada in promotion of their new track, &quot;After School at Bobby\\\\'s House&quot;&lt;/p&gt;\\\\n\",\"url\":\"https://www.albertamusic.org/event/flowshine-on-tour-calgary/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-02-15T18:00:00-07:00\",\"endDate\":\"2026-02-15T20:00:00-07:00\",\"location\":{\"@type\":\"Place\",\"name\":\"Pig &#038; Whistle\",\"description\":\"\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"4105 4 St NW\",\"addressLocality\":\"Calgary\",\"addressRegion\":\"AB\"},\"telephone\":\"\",\"sameAs\":\"\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"River Valley Sessions &#8211; John Hewitt\",\"description\":\"&lt;p&gt;Join John Hewitt for a house concert and conversation at a River Valley Sessions performance! Tickets on sale now! &nbsp; &nbsp;&lt;/p&gt;\\\\n\",\"url\":\"https://www.albertamusic.org/event/river-valley-sessions-john-hewitt/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-02-18T18:30:00-07:00\",\"endDate\":\"2026-02-18T20:30:00-07:00\",\"location\":{\"@type\":\"Place\",\"name\":\"little brick\",\"description\":\"\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"1004 90 St\",\"addressLocality\":\"Edmonton\",\"addressRegion\":\"AB\"},\"telephone\":\"\",\"sameAs\":\"\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Abigayle Oakley Albertan Tour\",\"description\":\"&lt;p&gt;Starting on Feb 20th, Abigayle Oakley sets out on her tour cross Alberta - Feb 20 - Edmonton Feb 21 - Drayton Valley Feb 22 - Fort Saskatchewan Feb 25- Lethbridge Feb 27- Lacombe Feb 28- Nanton March 1 - High River &nbsp; Check out https://www.abigayleoakley.com/ for more info!&lt;/p&gt;\\\\n\",\"url\":\"https://www.albertamusic.org/event/abigayle-oakley-albertan-tour/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-02-20T00:00:00-07:00\",\"endDate\":\"2026-02-20T23:59:59-07:00\",\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Swing Dance Party ft. Cosmopolitones, Jazz Big Band, and Sugar Swing Dancers\",\"description\":\"&lt;p&gt;Join us for a Swing Dance Party featuring the Cosmopolitones, Jazz Big Band, and the Sugar Swing Dancers. Cosmopolitones\\u00a0conducted by Joel Gray Jazz Big Band\\u00a0conducted by Dale Chapman and showcasing The Sugar Swing Dancers \\u00a0 Friday, February 20th, 2026 Concert at 7 pm (doors at 6 pm) \\u00a0 Tickets: $40 ticket\\u00a0available through Showpass includes 1&hellip;&lt;/p&gt;\\\\n\",\"url\":\"https://www.albertamusic.org/event/swing-dance-party-ft-cosmopolitones-jazz-big-band-and-sugar-swing-dancers/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-02-20T18:00:00-07:00\",\"endDate\":\"2026-02-20T21:00:00-07:00\",\"location\":{\"@type\":\"Place\",\"name\":\"old strathcona performing arts centre\",\"description\":\"\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"8426 Gateway Blvd\",\"addressLocality\":\"Edmonton\",\"addressRegion\":\"AB\"},\"telephone\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"40\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.albertamusic.org/event/swing-dance-party-ft-cosmopolitones-jazz-big-band-and-sugar-swing-dancers/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2026-02-11T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"John Hewitt and Abigayle Oakley &#8211; Analog Books\",\"description\":\"\",\"url\":\"https://www.albertamusic.org/event/john-hewitt-and-abigayle-oakley-analog-books/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-02-25T18:00:00-07:00\",\"endDate\":\"2026-02-25T20:00:00-07:00\",\"location\":{\"@type\":\"Place\",\"name\":\"analog books\",\"description\":\"\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"322 6th St\",\"addressLocality\":\"Lethbridge\",\"addressRegion\":\"AB\"},\"telephone\":\"\",\"sameAs\":\"\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"John Hewitt and the New Americans &#8211; Lacombe Performing Arts Centre\",\"description\":\"\",\"url\":\"https://www.albertamusic.org/event/john-hewitt-and-the-new-americans-