    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Cœur de pirate en concert à Sainte-Thérèse | Rive-Nord 2026 – Réservez vos billets"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Cœur de pirate revient sur scène en 2026 avec Cavale, un spectacle envoûtant entre douceur et éclat. Retrouvez-la à Sainte-Thérèse, sur la Rive-Nord, pour une soirée unique où sa voix affilée et sa présence scénique captivante vous transporteront. Réservez vos billets pour cet événement incontournable de la chanson francophone!"
      }
    ],
