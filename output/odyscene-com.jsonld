  {
    "@id": "https://odyscene.com/programmation/jerome-50/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Jérôme 50 - Odyscène"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Jérôme 50, c’est un écriveur de chansons à succès, mais aussi un performeur sans égal. Puisant dans les références musicales adolescentes du tournant du millénaire, il se réapproprie les styles ska, skate-punk et folk trash, s’influençant de NoFX et Gogol Bordello autant que de Québec Redneck Bluegrass Project, Les Colocs et Les Cowboys fringants. Il y en a pour tout le monde dans ce nouveau spectacle."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://odyscene.com/programmation/jerome-50/"
      }
