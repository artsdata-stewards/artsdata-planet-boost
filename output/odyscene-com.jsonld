  {
    "@id": "https://odyscene.com/programmation/guy-nantel-en-rodage/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Guy Nantel - Odyscène"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Guy Nantel fait le point sur la question fondamentale qui hante le Québec depuis des décennies : C'est quoi un vrai Québécois? Il en profite pour remettre en question des thèmes comme la pertinence du vedettariat, de même que la compétence de nos dirigeants ainsi que la capacité pour les citoyens d'ici à faire les bons choix pour eux-mêmes.   Un autre spectacle classique à la sauce Guy Nantel qui nous plonge dans une réflexion sur ce que nous sommes, à travers un humour subversif et provocateur. "
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://odyscene.com/programmation/guy-nantel-en-rodage/"
      }
    ],
