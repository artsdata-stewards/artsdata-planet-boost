  {
    "@id": "https://odyscene.com/programmation/sofia-duhaime/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Sofia Duhaime - Odyscène"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Sofia Duhaime offre un spectacle intime et chaleureux coloré d’anecdotes. Mélangeant le folk, le rock, et la chanson française, Sofia crée une atmosphère lumineuse.  Les paroles sensibles et délicates des chansons se mélangent à une voix pleine de vulnérabilité et d’émotion.  Accompagnée de ses musiciens, Sofia dévoile un côté rock qui révèle une voix puissante et une énergie contagieuse"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://odyscene.com/programmation/sofia-duhaime/"
      }
