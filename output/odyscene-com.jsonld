  {
    "@id": "https://odyscene.com/programmation/marie-annick-lepine-2/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
    ],
    "http://ogp.me/ns#type": [
