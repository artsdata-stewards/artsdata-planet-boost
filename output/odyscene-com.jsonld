    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Maxime Gervais - Odyscène"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "L’humoriste Maxime Gervais, ex-membre des cultissimes Pic-Bois et tendre humain au blagues déjantées revient en force après le succès de son premier spectacle, Big Max.   Place aux expérimentations, à l’absurde, au mystère et la Liberté (avec un gros L) : le show C’était magnifique est là pour vous décoiffer, voire même, vous fucker ben raide. Maxime Gervais vous en fait lui-même la promesse : vous ressortirez complètement transformé.e.s de son spectacle où il multiplie les personnages, célèbre la vie, expie ses cauchemars et – quand même pas pire important de le rappeler – fait des jokes.   Spectacle réservé aux 18 ans et plus."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://odyscene.com/programmation/maxime-gervais-cetait-magnifique/"
      }
