    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Bleu Jeans Bleu - Odyscène"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Les gars de Bleu Jeans Bleu font du bien. Ils l’ont toujours fait, et ils poursuivent sur leur lancée avec un tout nouveau spectacle, la tournée&nbsp;Record NºV. L’élégance d’un parfum haut de gamme, le réconfort d’un macaroni à la viande. L’énergie d’un Monster Truck, la finesse d’une Mercedes vintage. Ce nouveau spectacle allie irrésistiblement leur musique efficace à leur humour décalé, dans une parfaite complicité avec le public — une signature qui fait de&nbsp;BJB&nbsp;un des groupes chouchous de la scène québécoise. Ambiance feutrée, décor italo-romantique… laissez-vous envoûter par&nbsp;la fragrance du bonheur pur!"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ]
