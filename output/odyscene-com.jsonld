    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "J’aurais pu appeler ce show d’humour-là « Étalon en talons » ou « Entre Bâton Rouge et matante » mais après j’ai désaoulé pis je me suis rendue compte que vous allez sûrement vous reconnaître dans mon personnage que certains..."
      }
