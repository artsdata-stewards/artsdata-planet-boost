    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Léa Stréliski - Odyscène"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Dans le rodage de son tout premier spectacle solo, Léa Stréliski espère explorer en cinq tableaux ce qui la constitue. Une occasion de venir la voir travailler ses blagues, apprendre à la connaître et rire avec elle de tout ce qu’elle est : la sœur d’une vedette, une moitié de française, l’épouse un peu lesbienne d’un homme, la mère de deux gars ados et celle d’une fille qu’elle tente de toutes ses forces de préparer au monde qui l’attend. À suivre."
      }
    ],
    "http://ogp.me/ns#url": [
