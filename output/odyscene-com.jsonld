    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Big O'String Band - Odyscène"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Plongez au cœur du bluegrass avec The Big O String Band, une formation passionnée qui redonne vie aux classiques intemporels tout en façonnant un répertoire original riche et vibrant. Inspirés par les racines profondes de la musique traditionnelle américaine, ces musiciens chevronnés conjuguent virtuosité, harmonies vocales envoûtantes et une énergie contagieuse qui transporte le public dans un voyage musical inoubliable."
      }
    ],
