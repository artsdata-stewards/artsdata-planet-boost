      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Ian Kelly - Odyscène"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Accompagné du multi-instrumentiste Joshua Total et parfois, de sa fille Mahika, Ian présenteun spectacle naturel et en toute simplicité. Avec vingt ans de carrière derrière la cravate, Ianpeut compter sur ses meilleures chansons pour bâtir un répertoire survolant un parcourséclectique et varié dans une performance vraie et dépourvue d'artifice. De Take Me Home àDevenir vieux, en passant par Montréal et I Need Your Love, guitares, piano et une voixremplie d'émotion pour livrer des paroles qui n'ont rien d'artificiel."
      }
    ],
    "http://ogp.me/ns#url": [
