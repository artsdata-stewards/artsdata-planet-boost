    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Martin Petit - Odyscène"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Présentation du spectacle Un monde meilleur avec Martin Petit  Un monde meilleur devient réalité avec le 5Ème one-man show de Martin Petit!  Les politiciens nous le promettent à tous les 4 ans, les religions à la fin de nos jours mais Martin Petit a décidé que c’était maintenant.  Une invitation à regarder le monde avec enthousiasme et entrain, et rendre ce monde meilleur encore meilleur!   "
      }
    ],
