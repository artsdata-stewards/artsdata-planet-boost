    "http://schema.org/potentialAction": [
      {
        "@id": "_:g9334040"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "La magie de la chimie - Sortie scolaire - Secondaire - Odyscène"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Thèmes abordés: science, interactivité, apprentissages Récipiendaire du prix Hubert-Reeve et créateur des expériences du magazine scientifique Les Débrouillards, Yannick Bergeron n’a pas fini de vous surprendre. Il vous transportera dans son univers de démonstrations scientifiques exceptionnelles et phénoménales. Vêtu de son sarrau emblématique, notre enseignant vous fera découvrir des réactions chimiques uniques afin d’animer tous vos sens. Auteur, enseignant et membre de l’Ordre des chimistes du Québec, ce communicateur hors pair poursuit sa mission de susciter l’intérêt des jeunes pour les sciences avec son approche ludique et singulière. Lauréat du prix de la personnalité scientifique de La Presse Radio-Canada, on peut voir Yannick Bergeron dans de multiples émissions télé en tant que chroniqueur et vulgarisateur scientifique. Figure reconnue au Québec et dans la francophonie canadienne, il n’a pas fini de vous surprendre avec ses mille et un projets en cours et à venir ! Apprendre n’aura jamais été aussi amusant !"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ]
  },
