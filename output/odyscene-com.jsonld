    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Kevin Parent - Odyscène"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "En toute simplicité, seul avec sa guitare, Kevin Parent nous plonge dans l’univers de&nbsp;Pigeon d’argile&nbsp;comme si c’était hier.&nbsp; Sorti en 1995, ce premier album est rapidement devenu un classique, propulsant l’artiste au sommet des palmarès et franchissant le cap des 375 000 exemplaires vendus.&nbsp; Pour célébrer les 30 ans de ce disque marquant, Kevin revisite ses chansons avec une intensité renouvelée, offrant un moment intime, vrai et chaleureux.&nbsp; Une soirée complice où la proximité avec l’artiste est au cœur de l’expérience.&nbsp;"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
