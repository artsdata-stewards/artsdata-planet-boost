    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Joe Grass - Odyscène"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le spectacle de Joe Grass consiste en une exploration de chansons et de formes, où le public devient le quatrième membre du groupe. Défiant les genres, ils vous font voyager, vous jettent des sorts et vous racontent des histoires ancrées dans le présent. Le trio, composé de Joe Grass (guitare), Morgan Moore (basse) et Robbie Kuster (batterie), interprète des titres du dernier album de Joe, Falcon’s Heart.  À bientôt!"
      }
    ],
