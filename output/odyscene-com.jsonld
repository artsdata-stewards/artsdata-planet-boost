    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Vivre un épuisement professionnel, c&rsquo;est aussi vivre une recharge professionnelle. Autrement dit : travailler mon deuxième one-man-show de façon encore plus efficace, sans perdre de temps avec des niaiseries. Là, j&rsquo;aimerais bien te vanter mon spectacle pour te convaincre de..."
      }
