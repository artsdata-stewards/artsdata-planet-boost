    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Ciné-Groulx : Shifting baselines - Odyscène"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Là où le Rio Grande se jette dans la mer, les fusées de SpaceX décollent sous le regard inquiet des astronomes. Les touristes accourent en masse pendant que les écologistes évaluent les dégâts. Bienvenue à Boca Chica, aux États-Unis. « SHIFTING BASELINES souligne magnifiquement qu’il est important d’espérer et de se tourner humblement vers l’infini tout en gardant les pieds sur terre. » (Catherine Lemieux-Lefebvre, Ciné-Bulles)"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
