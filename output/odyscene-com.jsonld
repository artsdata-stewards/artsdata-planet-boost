  {
    "@id": "https://odyscene.com/programmation/ari-cui-cui-et-les-jeux-droles/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
    ],
    "http://ogp.me/ns#type": [
