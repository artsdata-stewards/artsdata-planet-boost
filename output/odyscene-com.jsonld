    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Jérôme 50, c’est un écriveur de chansons à succès, mais aussi un performeur sans égal. Puisant dans les références musicales adolescentes du tournant du millénaire, il se réapproprie les styles ska, skate-punk et folk trash, s’influençant de NoFX et Gogol..."
      }
