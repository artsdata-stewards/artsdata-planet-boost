    "http://schema.org/name": [
      {
        "@value": "L&rsquo;art de négocier son salaire"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Négocier son salaire est une compétence essentielle qui peut avoir un impact significatif sur votre carrière. Vous recevrez quelques conseils pour maîtriser cet art: Faire vos recherches en vous renseignant sur les salaires du marché Évaluer votre valeur Ne pas se précipiter Savoir dire non ou accepter Conclure sur une note positive &nbsp;&lt;/p&gt;\\n"
      }
    ],
