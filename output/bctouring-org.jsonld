    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "April 2, 2026, 12:00 pm – 1:00 pm BC Live hosts block booking meetings for Presenters on Zoom. These meetings provide an opportunity to pitch artists, discuss programming and collaborate on tours. Agenda: Theatre Programming + ALL things Performance Zoom link: https://us02web.zoom.us/j/89743993320 Log into the ATC: https://arts-tc.ca/ Petrice Brett, Block Booking Coordinator: petrice@bclive.ca"
      }
