    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The BC Live Performance Network will hold its Annual General Meeting (AGM) for members on Zoom on Thursday, April 16, 2026, at 11:00 AM (PT)/12:00 PM (MT). RSVP: Please register here to attend the meeting. Details, including the Agenda, Minutes, Financial Statement and Board list, will be added here prior to the meeting."
