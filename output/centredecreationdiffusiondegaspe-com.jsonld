      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Mon équipe m’a demandé d’écrire, en moins de 100 mots, un petit texte qui allait simplement expliquer au public que j’étais dorénavant en train de bâtir mon deuxième spectacle."
      }
    ],
