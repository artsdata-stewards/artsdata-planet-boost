    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Nearly 5,000 years after he was bestowed with the almighty powers of the Egyptian gods-and imprisoned just as quickly-Black Adam is freed from his earthly tomb, ready to unleash his unique form of justice on the modern world.&#010;&#010;2H 4Min     ---     PG"
      }
