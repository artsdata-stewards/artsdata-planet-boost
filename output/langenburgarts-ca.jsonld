  {
    "@id": "https://www.langenburgarts.ca/event-details/kinjo-young",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Kinjo & Young"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "<p>This acoustic show brings virtuosic musicianship, heartfelt songwriting and beautiful vocal harmonies together in one performance. Kinjo &amp; Young have toured the world as seasoned artists for decades before uniting their talents into one project. Blues, funk, reggae and soul are the main staples of this dynamic duo, or trio when joined by Adam Esposito on drums. Stories of their long standing musical adventures and blistering guitar solos compliment the amazing grooves and thoughtful lyrics of their songs. Kinjo &amp; Young offer a show for audiences of all ages and musical tastes. </p>\n<p></p>\n<p><a rel=\"noopener noreferrer noopener noreferrer noopener noreferrer\" target=\"_blank\" href=\"http://www.kinjoyoung.com/\">www.kinjoyoung.com</a></p>"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://static.wixstatic.com/media/3b1f4b_d1c9fe0098234b4bb3433903c4960f17~mv2.jpg/v1/fill/w_830,h_569,al_c,q_85/3b1f4b_d1c9fe0098234b4bb3433903c4960f17~mv2.jpg"
