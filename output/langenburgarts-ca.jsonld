    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "On Christmas Eve, a young boy embarks on a magical adventure to the North Pole on the Polar Express, while learning about friendship, bravery, and the spirit of Christmas.&#010;G    -   1Hr 40min"
