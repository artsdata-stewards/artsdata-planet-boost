  {
    "@id": "https://www.langenburgarts.ca/event-details/misery-mountain-boys",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Misery Mountain Boys"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "<p>You might hear the tunes of the Misery Mountain Boys drifting from behind a rotating bookcase of a 1930’s speakeasy. Harkening back to a simpler time, the MMB’s music is infused with tongue in cheek wit, playfulness, and nostalgia. With a mix of catchy originals and contemporary songs reimagined in driving swing, the band’s performance delivers as both classic and fresh. The band offers a generous variety of sweaty jazz numbers, velvety love songs, and swingin&#39; jump-blues, with plenty of lighthearted stories and laughs along the way.</p>"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://static.wixstatic.com/media/3b1f4b_0a4557a52e2d4a6ea37bcead86900522~mv2.jpg/v1/fill/w_4497,h_2896,al_c,q_90/3b1f4b_0a4557a52e2d4a6ea37bcead86900522~mv2.jpg"
