    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "2H 28 MIN&#010;After his home is conquered by the tyrannical emperors who now lead Rome, Lucius is forced to enter the Colosseum and must look to his past to find strength to return the glory of Rome to its people."
      }
    ],
    "http://schema.org/eventStatus": [
