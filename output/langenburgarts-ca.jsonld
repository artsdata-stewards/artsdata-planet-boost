    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "You are invited to an ART OPEN HOUSE EVENT Showcasing paintings by MEGAN RUZYCKI&#010;Come meet Megan, child of flowers. Her wish is that her work brings warmth, peace and a dash of excitement to the viewer - a BIG ART HUG!&#010;Enjoy beautiful art, wine &amp; Goodies"
      }
