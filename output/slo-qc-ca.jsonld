      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Une autrice (extra)ordinaire : entretien-spectacle avec Catherine Ethier"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "&lt;p&gt;Chroniqueuse au verbe distinctif et joyeusement rétro qui s\\'illustre à&nbsp;Radio-Canada, VRAK et dans bien d\\'autres médias, Catherine Ethier&nbsp;nous a offert l\\'an dernier l\\'excellent roman&nbsp;Une femme extraordinaire (Stanké). Le temps d\\'une soirée festive, Julien Morissette s\\'entretiendra avec l\\'autrice, alors que la comédienne Annie Cloutier et le comédien Alexandre-David Gagnon interpréteront de savoureux extraits de ce roman [&hellip;]&lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Organization"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
