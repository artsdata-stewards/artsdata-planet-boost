    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Salon #4 – Transformations : Kama La Mackerel + invité&lt;span aria-hidden=&quot;true&quot; x=&quot;&quot;&gt;·e·&lt;/span&gt;s"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "&lt;p&gt;Suite au grand succès rencontré par les Salons lors de son quarantième anniversaire, AXENÉO7 revient avec une quatrième itération en collaboration avec la Maison des arts littéraires de la ville de Gatineau, sur le thème des Transformations. Les artistes Kama La Mackerel, Karina Pawlikowski et Maude Veilleux seront invitées pour une soirée de réflexions et [&hellip;]&lt;/p&gt;\\n"
      }
    ],
