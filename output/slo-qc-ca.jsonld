      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://slo.qc.ca/programmation-mal/categorie/residence/liste/?posts_per_page=26&eventDisplay=past"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "L&rsquo;EFFET HA! DES CHOSES ou LA CHAMBRE DE MARY (ce que Mary ne savait pas)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "&lt;p&gt;La rencontre entre Pascale Bérubé, Pierre-Luc Clément et Lisa L\\'Heureux fait des flammèches! Osez cette soirée située quelque part entre la performance, la poésie, l\\'œuvre sonore et l\\'installation artistique. L\\'EFFET HA! DES CHOSES ou LA CHAMBRE DE MARY (ce que Mary ne savait pas) est le résultat d\\'une résidence artistique à laquelle les artistes auront [&hellip;]&lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Organization"
      }
    ],
