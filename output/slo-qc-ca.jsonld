    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Seul dans l&rsquo;arène, le poète&nbsp;Mathieu Arsenault&nbsp;performe un monologue ininterrompu. Avec son écriture comme seul dispositif scénique, il critique l&rsquo;industrie culturelle, confronte le public à ses habitudes de consommation mais dévoile [&hellip;]"
      }
