  {
    "@id": "https://slo.qc.ca/programmation-mal/etiquette/mal-2025/liste/?posts_per_page=25&eventDisplay=past",
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://slo.qc.ca/wp-content/uploads/2025/04/gabarit-8.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "<p>Demain, l’hiver est un spectacle de poésie imaginé par Félix Lahaye, Célia Gouin-Arsenault et Mattis Savard-Verhoeven et mis en musique par Philippe Noël. Dans un montage rassemblant une vingtaine de poèmes québécois, les interprètes et musicien·ne·s établissent un dialogue où chaque auteur·trice d’hier et d’aujourd’hui tente une réponse à la question que pose Elkahna Talbi […]</p>"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://slo.qc.ca/programmation-mal/demain-lhiver/"
      },
