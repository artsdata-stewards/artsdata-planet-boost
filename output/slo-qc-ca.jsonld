    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "<p>L’histoire en flammes | parcours audio   La Bibitte (Sudbury, ON) en collaboration avec la Maison des arts littéraires de Gatineau   Soyez parmi les premier·ère·s à plonger dans le […]</p>"
      },
      {
        "@language": "fr-ca",
        "@value": "L'histoire en flammes est un parcours audio immersif qui vous plonge dans le passé brûlant des incendies du Vieux Hull."
