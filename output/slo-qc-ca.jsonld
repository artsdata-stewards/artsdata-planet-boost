  {
    "@id": "https://slo.qc.ca/programmation-mal/maman-est-un-mythe/",
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://slo.qc.ca/wp-content/themes/twentytwenty/images/img_fb_share2021.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "<p>Une conteuse. Un cercle de hauts-parleurs. Et une invitation : un aller-simple pour visiter la maternité d’aujourd’hui.  Avec Maman est un mythe, la mère est une femme à part entière… comme […]</p>"
      },
      {
        "@language": "fr-ca",
