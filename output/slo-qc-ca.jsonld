    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "<p>Visites scolaires (COMPLET) Bourgeons éclatés promet d’être un rendez-vous annuel incontournable pour les jeunes lecteurs et lectrices et leurs familles en les mettant en contact avec une diversité d’activités littéraires […]</p>"
      },
      {
        "@language": "fr-ca",
        "@value": "Bourgeons éclatés, c'est l'occasion d'offrir aux élèves et aux familles de chouettes activités pour jouer avec les mots. "
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
