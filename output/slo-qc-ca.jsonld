    "http://schema.org/image": [
      {
        "@id": "https://slo.qc.ca/wp-content/uploads/2024/05/MAL2024_Effet_POST-1080x1080-Leffet-ha-2.png"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://slo.qc.ca/programmation-mal/leffet-ha-des-choses-ou-la-chambre-de-mary-ce-que-mary-ne-savait-pas/"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2024-11-16T20:00:00-05:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
