    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://slo.qc.ca/wp-content/uploads/2025/04/Visuel-insta.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "<p>Dans ce cabaret littéraire riche en émotions, des duos formés d’avance permettent des rencontres profondes entre des autrices noires de différentes générations. Chacune s’adresse à l’autre au moyen d’une lettre portant sur le thème de la sororité. Ces vérités, partagées de part et d’autre, soulèvent des questions fondamentales à l’heure de la montée des extrêmes […]</p>"
      }
    ],
    "http://ogp.me/ns#url": [
