    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "<p>Après plus de 100 représentations de Mononk Jules, le chasseur d’histoire et grand rassembleur Jocelyn Sioui revient avec Frétillant et Agile, une épopée spectaculaire pour tout public drôle et pleine […]</p>"
      },
      {
        "@language": "fr-ca",
        "@value": "Marionnettiste aguerri et fabuleux conteur, Jocelyn Sioui s’amuse à sortir de l’ombre des personnages colorés, plus grands que nature."
      }
    ],
