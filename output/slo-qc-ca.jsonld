    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dans ce cabaret littéraire riche en émotions, des duos formés d’avance permettent des rencontres profondes entre des autrices noires de différentes générations. Chacune s’adresse à l’autre au moyen d’une lettre [&hellip;]"
      }
    ],
