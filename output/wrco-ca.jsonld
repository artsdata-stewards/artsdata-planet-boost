    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Ken Lavigne performs with WRCO  - Christmas Concert! "
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "UPDATE: Join us for our fun filled traditional Christmas Spectacular with the wonderful Tenor Ken Lavigne performing nostaligic classics ! Christmas the way it used to be!  Be sure to book early our Christmas  Concerts always sell out ! Buy Raffle tickets to win one months FREE music lessons."
      }
    ],
