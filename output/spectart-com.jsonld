    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spectart.com/programmation/souldia/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Souldia"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Après une année non conventionnelle et chargée en émotions, Souldia est plus déterminé que jamais à présenter son nouveau show. Haut en couleurs et plus percutant que jamais, le rappeur ose en nous proposant un spectacle énergique complètement hors du commun, passant par des sonorités rock’n’roll, voire même punk, bien agencées à son style cru. Souldia est au sommet de sa forme et sûr de lui pour un nouveau départ sur scène ahurissant!"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Souldia"
      }
    ]
  },
