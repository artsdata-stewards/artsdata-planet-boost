    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "NEXUS &#8211; Représentation A"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Au désir de trouver sa place et de se découvrir.nSe découvrir, non pas seul•e, mais à travers les liens que l’on tisse, les groupes que l’on rejoint, les mondes que l’on habite et les danses qui nous portent.nLes élèves en hip-hop de l’École de danse Quatre Temps vous ouvrent la porte de leurs univers festifs, chacun animé par une couleur unique.nEt si trouver son identité propre consistait à rassembler un peu de tout ce qui nous entoure?"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "NEXUS &#8211; Représentation A"
      }
    ]
  },
