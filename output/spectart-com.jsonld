    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spectart.com/programmation/elfe-2-representation-b/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "ELFE 2 &#8211; Représentation B"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Plongez à nouveau dans la magie des fêtes avec Elfe 2, la suite éclatante de notre production inspirée du film culte Le lutin et de l’univers pétillant des ‘’Radio City Rockettes’’.nÀ travers des tableaux dansés hauts en couleur, Buddy entraînera petits et grands dans une aventure où humour, tendresse et énergie débordante se mêlent. Entre traditions revisitées et rythmes électrisants, Elfe 2 célèbre la joie d’être ensemble et nous rappelle qu’il suffit parfois d’une étincelle pour rallumer la magie du temps des fêtes!"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "ELFE 2 &#8211; Représentation B"
      }
    ]
  },
