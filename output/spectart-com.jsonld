    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spectart.com/programmation/ensemble-antoine-perreault/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Ensemble Antoine-Perreault"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Cette année, pour Noël, l&rsquo;Ensemble Antoine-Perreault vous offre un concert dédié à la musique symphonique qui vous fera voyager dans le monde réel et fantastique grâce à des pièces incomparables choisies parmi les plus belles du répertoire.nJoignez-vous aux musiciennes et musiciens de cet orchestre d&rsquo;harmonie bien connu de Rimouski pour amorcer les fêtes en beauté avec des œuvres de compositeurs de renom tels Bedrich Smetana, Antonin Dvořák, Sergei Prokofiev, David Lovrien, Johan de Meij et Gustav Holst.nC&rsquo;est un rendez-vous musical à ne pas manquer!"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Ensemble Antoine-Perreault"
      }
    ]
  },
