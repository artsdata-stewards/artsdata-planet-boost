    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spectart.com/programmation/cirkalors/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Cirk&rsquo;Alors"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "CIRK ALORS : Cirque miniature pour clown à-tout-fairenDans un espace circulaire pareil à un cirque miniature, un clown vous ouvre les portes de son chapiteau. Entre un numéro de sacs plastiques sauvages, d’équilibre sur notes de musique, de domptage de tigre indiscipliné, de bol zen Yin pour esprit Yang, la poésie s’invite sous les guirlandes rouges et jaunes. La performance rivalise d’humour, la démesure tient, ici, dans le tout petit et tout devient enfin possible. CIRK ALORS entraîne le spectateur dans un voyage tendre, sensible et drôle au centre de la piste aux étoiles, là où les codes du cirque seront revisités. Approchez, approchez mais méfiez-vous du tigre tout de même.n&nbsp;"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Cirk&rsquo;Alors"
      }
    ]
