    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spectart.com/programmation/alphonse-bisaillon/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Alphonse Bisaillon"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Alphonse Bisaillon est un véritable caméléon musical, dont les influences variées et profondes se mêlent pour créer un projet captivant. Influencé autant par Charlebois, Boris Vian que Bill Evans, il modernise la chanson française avec une touche de musique progressive. Ses compositions, enrichies par des éléments aussi éclectiques que des violons, des synthétiseurs et du rap, promettent une expérience auditive véritablement unique.nAlphonse Bisaillon ne se contente pas de suivre les conventions musicales ; il les défie et les réinvente avec une créativité apparemment illimitée. Ses arrangements sophistiqués et ses paroles soigneusement travaillées offrent une profondeur et une complexité qui invitent à une écoute attentive et réfléchie.n&nbsp;"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Alphonse Bisaillon"
      }
    ]
  },
