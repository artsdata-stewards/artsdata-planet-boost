    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Tina Leon"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Tina Leon propose un nouveau spectacle intitulé Push &amp; Pull afin de nous présenter ses deux mini-albums sur la scène. Au travers de rythmes Soul, RnB et Jazz aux mélodies riches et envoûtantes, elle nous invite à participer à un voyage haut en couleurs. Avec ses musiciens(nes) chevronnés, l’auteure-compositrice-interprète originaire de Montréal nous offre une performance mémorable qui vous mettra au défi de ne pas danser."
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Tina Leon"
      }
    ]
  },
