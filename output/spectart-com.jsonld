    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Coucou Passe-Partout, le spectacle"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Après l&rsquo;immense succès télévisuel de l’émission, Passe-Partout, Passe-Carreau et Passe-Montagne sillonneront enfin les routes du Québec à la rencontre de leurs poussinots et poussinettes. Retrouvez-les sur scène dans un spectacle de 50 minutes incluant des jeux participatifs et les chansons populaires de l&rsquo;émission préférée des tout-petits à Télé-Québec. Un spectacle à la fois divertissant et stimulant pour tous les enfants d&rsquo;âge préscolaire&#8230; et les parents nostalgiques!nMise en scène : Marc-St Martin"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Coucou Passe-Partout, le spectacle"
      }
    ]
  },
