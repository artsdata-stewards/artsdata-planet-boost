  {
    "@id": "https://spectart.com/temporary/989f87b2-65ed-4e43-9329-34f091466af2",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spectart.com/je-suis-william/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://spectart.com/wp-content/uploads/2025/05/Design-sans-titre-2025-05-12T104948.117.png"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
