      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://spectart.com/wp-content/uploads/2025/05/Design-sans-titre-2025-05-12T112156.675.png"
      }
    ],
    "http://schema.org/startDate": [
      {
