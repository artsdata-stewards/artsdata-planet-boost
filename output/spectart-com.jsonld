    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spectart.com/programmation/harmonium-symphonique-projection/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Harmonium symphonique"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Un concert symphonique unique et grandiose sur grand écran.nRedécouvrez toute la beauté de l&rsquo;œuvre du groupe légendaire Harmonium dans un spectacle à grand déploiement offrant une facture visuelle impressionnante et des performances colossales. Sous la direction de la cheffe d’orchestre Dina Gilbert, l’Orchestre Symphonique de Montréal, le Choeur des Jeunes Chanteurs de Laval, Luce Dufault, Kim Richardson ainsi que quelques comédiens revisitent ces pièces d’anthologie qui ont séduit et marqué toute une génération. Une expérience riche en émotions qui comble l’imaginaire.nConcert capté à la Salle Wilfrid-Pelletier de la Place-des-Arts"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Harmonium symphonique"
      }
    ]
  },
