  {
    "@id": "https://spectart.com/temporary/1aa99c89-ecf6-4a9d-9677-711c1116f26c",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spectart.com/sri-lanka-perle-de-locean-indien/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://spectart.com/wp-content/uploads/2025/05/LGE-Sri-Lanka.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-04-01T19:30:00"
      }
    ],
