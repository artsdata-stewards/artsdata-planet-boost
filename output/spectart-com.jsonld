    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spectart.com/programmation/manu-militari/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Manu Militari"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Nouvelle Vague, le cinquième opus de Manu Militari, paraît le 3 décembre 2021 sous Les Productions Grande Plume. L’album de 12 chansons a notamment été produit par Benny Adam et Gary Wide. Un retour bien attendu par les fans du rappeur après plusieursnannées d’absence.nAprès près de 20 ans de carrière, le nom de Manu Militari résonne toujours aussi fort auprès de milliers de fans qui le suivent à travers ses spectacles et ses nouveaux albums. Réalisé sans trucage ni effets spéciaux, son spectacle mise tout sur le texte, soutenu par une rythmique terriblement efficace. Entouré d&rsquo;un DJ et d&rsquo;un hype man, dans la pure tradition du hip-hop, ses armes de séduction sont les mots et le beat."
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Manu Militari"
      }
    ]
  },
