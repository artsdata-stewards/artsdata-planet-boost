    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Marie Michèle Desrosiers"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Après avoir sillonné les routes du Québec en 2024, le spectacle Un piano pour Noël revient en décembre 2025 avec l&rsquo;exceptionnelle Marie Michèle Desrosiers. Accompagnée d’un orchestre à cordes et du talentueux pianiste et arrangeur Stéphane Aubin (Les 4 saisons d&rsquo;André Gagnon), ils revisitent les plus belles mélodies de Noël, incluant des extraits de l’album emblématique NOËL d’André Gagnon, dans une ambiance imprégnée de l&rsquo;esprit et de la signature musicale du compositeur. Cette rencontre musicale inoubliable rend hommage à l’amitié profonde qui unit nos deux grandes figures de la musique québécoise, Marie Michèle Desrosiers et André Gagnon. Une belle occasion de souligner les 50 ans de l’album Neiges et de célébrer la magie des fêtes tous ensemble !"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Marie Michèle Desrosiers"
      }
    ]
  },
