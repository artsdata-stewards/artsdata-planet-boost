      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Hot, sweaty dance floors with feet stomping and everybody moving. Grooves for days. Monster horns, crushing percussion and shredding psych-rock guitars. These are among the elements that make up the&hellip;"
      }
