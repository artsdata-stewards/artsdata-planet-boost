        "@value": "Five Alarm Funk - Winnipeg Folk Festival"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Hot, sweaty dance floors with feet stomping and everybody moving. Grooves for days. Monster horns, crushing percussion and shredding psych-rock guitars."
      }
    ],
