    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "The Paper Kites - SOLD OUT - Winnipeg Folk Festival"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Give them your tired, your lonely, your lovesick, your unsure, The Paper Kites have a song for each of them. “I created a world based on the idea of watching other people, but a lot of the songs are extensions of myself or people I know,” he says."
      }
    ],
    "http://ogp.me/ns#url": [
