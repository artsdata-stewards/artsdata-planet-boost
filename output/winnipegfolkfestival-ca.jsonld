        "@value": "Reuben and the Dark - Winnipeg Folk Festival"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Reuben and the Dark is the spirited folk-rock outfit led by Reuben Bullock, whose music blends introspective lyrics with the irrepressible pulse and complicit harmonies of his band."
      }
    ],
