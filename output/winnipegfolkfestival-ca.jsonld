    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Joel Plaskett"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;From rocking Halifax’s Marquee Club to performing for the masses at Massey Hall or touring the country with his father, Joel Plaskett has forged a reputation as one of Canada’s most engaging performers and respected singer-songwriters. Plaskett’s songs are a perennial part of the national playlist, a fixture on “best of” lists, and the soundtrack&hellip;&lt;/p&gt;\\n"
      }
    ],
