    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Del Barber - Winnipeg Folk Festival"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "With nominations for JUNO Awards, Western Canadian Music Awards, and Canadian Folk Music Awards - Del Barber has shaped the folk music canon in Canada with five critically acclaimed studio albums under his belt, as well as a myriad of fans."
      }
    ],
