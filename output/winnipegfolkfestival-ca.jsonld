    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Courtney Marie Andrews"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "On the honey shores of Cape Cod in a beach shack, Courtney Marie Andrews found self-love and her voice.  Every morning, she’d walk 6-8 miles around the back trails of an island and meditate on her life, perusing old memories and patterns like browsing a used bookshop. That summer of introspection led her to a joyous sense of beginnings and ends."
      }
    ],
