        "@language": "en",
        "@value": "\n\n\t\t\n\t\n\t\t\n\t\n\t\t6 events found.\t\n\t\n\t\t\n\t\n\n\t\t\n\t\n\n\t\t\n\t\n\n\t\n\n\n\t\t\n[{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Bahamas\",\"description\":\"&lt;p&gt;JUNO Award-winning Afie Jurvanen, who performs as Bahamas, returns to Winnipeg this September. Bahamas is praised for his exceptional guitar skills, minimalist soulful sound, and clever, honest songwriting. He blends&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/76ac26e7-88de-48d3-8fb5-d47e7ddebc04.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/bahamas/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-09-25T20:00:00-05:00\",\"endDate\":\"2026-09-25T23:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"Burton Cummings Theatre\",\"description\":\"&lt;p&gt;Wheelchair accessible main floor Wheelchair and companion seating is available with a 1 to 1 arrangement in loge 1 and loge 2. A Chair will be provided for the companion,&hellip;&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"364 Smith Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3B 2H2\",\"addressCountry\":\"Canada\"},\"telephone\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"54.00\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/bahamas/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2026-03-11T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Vieux Farka Tour\\u00e9\",\"description\":\"&lt;p&gt;Co-Presented with Festival du Voyageur Co-presented by the Winnipeg Folk Festival and Festival du Voyageur, this show features one of the world\\u2019s most celebrated guitarists. Often called \\u201cThe Hendrix of&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/Vieux-Farka-Toure-8-photo-by-Kiss-Diouara-1.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/vieux-farka-toure/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-09-29T20:00:00-05:00\",\"endDate\":\"2026-09-29T23:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"Centre Culturel Franco-Manitobain\",\"description\":\"\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"340 Provencher Blvd\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R2H0G7\",\"addressCountry\":\"Canada\"},\"telephone\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"37.50\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/vieux-farka-toure/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2026-06-18T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"SYML: Solo in North America\",\"description\":\"&lt;p&gt;SYML is the solo venture of Seattle artist Brian Fennell. Welsh for \\u201csimple,\\u201d SYML makes music that taps into the instincts that drive us toward places of sanctuary, whether that&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/SYML_070425-30_c_Millie-Hudson-scaled.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/syml/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-10-09T20:00:00-05:00\",\"endDate\":\"2026-10-09T23:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"Burton Cummings Theatre\",\"description\":\"&lt;p&gt;Wheelchair accessible main floor Wheelchair and companion seating is available with a 1 to 1 arrangement in loge 1 and loge 2. A Chair will be provided for the companion,&hellip;&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"364 Smith Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3B 2H2\",\"addressCountry\":\"Canada\"},\"telephone\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"49.50\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/syml/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2026-04-23T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Moontricks\",\"description\":\"&lt;p&gt;Based in the rustic Kootenay Mountains of Western Canada, Nathan Gurley and Sean Rodman of the nationally renowned electro-folk duo Moontricks draw inspiration from the ongoing cycles of the natural&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/Moontricks_08-21Promo_LouisBockner-8102299-scaled.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/moontricks/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-10-15T20:00:00-05:00\",\"endDate\":\"2026-10-15T23:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"The Park Theatre\",\"description\":\"&lt;p&gt;Park Theatre Wheelchair accessible venue Wheelchair seating available (4 spots) Limited accessible seating available Seating is available for visually impaired patrons are available Accessible seats must be purchased through Ticketmaster&hellip;&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"698 Osborne Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3L 2B9\",\"addressCountry\":\"Canada\"},\"telephone\":\"204-478-7275\",\"sameAs\":\"https://myparktheatre.com/\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"37.50\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/moontricks/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2026-05-26T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"The East Pointers &#8211; SOLD OUT\",\"description\":\"&lt;p&gt;JUNO Award-winning band, The East Pointers, are innovators within the ever-evolving world of modern folk. They craft a joy-conjuring, dancefloor-shaking, roof-rattling fusion of folk, pop, and dance music.\\u00a0In the studio,&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/Credit_-Sandra_Layden_2026-scaled.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/the-east-pointers/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-10-22T20:00:00-05:00\",\"endDate\":\"2026-10-22T23:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"The Park Theatre\",\"description\":\"&lt;p&gt;Park Theatre Wheelchair accessible venue Wheelchair seating available (4 spots) Limited accessible seating available Seating is available for visually impaired patrons are available Accessible seats must be purchased through Ticketmaster&hellip;&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"698 Osborne Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3L 2B9\",\"addressCountry\":\"Canada\"},\"telephone\":\"204-478-7275\",\"sameAs\":\"https://myparktheatre.com/\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"44.00\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/the-east-pointers/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2026-04-15T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Hawksley Workman Duo\",\"description\":\"&lt;p&gt;Hawksley Workman is a JUNO Award-winning, Gold Record-certified singer-songwriter and multi-instrumentalist. From his groundbreaking, self-produced indie debut For Him and the Girls (1999) to his chart-topping singles of the 2020s,&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/Hawksley-Workman-by-Ivan-Otis-1-scaled-e1728056460905.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/hawksley-workman-duo/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-10-24T20:00:00-05:00\",\"endDate\":\"2026-10-24T23:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"The Park Theatre\",\"description\":\"&lt;p&gt;Park Theatre Wheelchair accessible venue Wheelchair seating available (4 spots) Limited accessible seating available Seating is available for visually impaired patrons are available Accessible seats must be purchased through Ticketmaster&hellip;&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"698 Osborne Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3L 2B9\",\"addressCountry\":\"Canada\"},\"telephone\":\"204-478-7275\",\"sameAs\":\"https://myparktheatre.com/\"},\"performer\":\"Organization\"}]\n\n\t\t\n\t{\"slug\":\"list\",\"prev_url\":\"https:\\/\\/www.winnipegfolkfestival.ca\\/events-calendar\\/list\\/?eventDisplay=past\",\"next_url\":\"\",\"view_class\":\"Tribe\\\\Events\\\\Views\\\\V2\\\\Views\\\\List_View\",\"view_slug\":\"list\",\"view_label\":\"List\",\"title\":\"Events Archive - Winnipeg Folk Festival\",\"events\":[59716,60220,59919,60121,59860,60146],\"url\":\"https:\\/\\/www.winnipegfolkfestival.ca\\/events-calendar\\/list\\/\",\"url_event_date\":false,\"bar\":{\"keyword\":\"\",\"date\":\"\"},\"today\":\"2026-09-0