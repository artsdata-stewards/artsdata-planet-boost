        "@language": "en",
        "@value": "\n\n\t\t\n\t\n\t\t\n\n\t\t\t\t\t\t\n\t\t\n\n\t\t\t\n\t\n\t\n\t\t\n\tJoel Plaskett\n\n\n\t\n\n\n\n\t\n\t\t\n\t\n\n\n\t\n\t\t\n\n\t\t\t\t\t\t\n\t\t\n\n\t\t\t\n\t\n\t\n\t\t\n\t\n\t\t\t\t\n\t\t\t\t\t\n\t\n\t\n\n\n\t\n\t\t\n\tSeptember 19, 2022 @ 8:00 pm\nDoors open at 7:00 PM\n\n\t\n\n\n\n\t\t\t\n\t\n\t\n\t\t\n\t\n\t\t\t\t\n\t\t\t\t\t\n\t\n\t\n\n\n\t\n\t\t\n\tThe Park Theatre\n698 Osborne Street, Winnipeg, MB\n\n\t\n\n\n\n\t\t\t\n\t\n\t\n\t\t\n\t\n\t\t\t\t\n\t\t\t\t\t\n\t\n\t\n\n\n\t\n\t\t\n\t$29.50\nAdvance plus fees\n\n\t\n\n\n\n\t\n\n\n\t\t\t\n\t\n\t\n\t\t\n\t\t\t\n\t\t\t\t\t\n\t\t\t\t\t\tBUY TICKETS\n\t\t\t\t\t\n\n\t\n\n\n\t\n\t\t\n\tAll sales are final except in the event of a full cancellation.\n\n\t\n\n\n\t\n\t\t\n\tTickets purchased for the May 4, 2020 or the September 20, 2021 show will be honoured on this date.\n\n\t\n\n\n\n\t\n\t\t\n\t\n\n\n\n\n\t"
