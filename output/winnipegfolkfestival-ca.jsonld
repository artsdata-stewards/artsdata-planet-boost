  {
    "@id": "http://www.winnipegfolkfestival.ca/genid/f69425a9a8512657",
    "@type": [
      "https://schema.org/WebPage"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.winnipegfolkfestival.ca/concert/ariel-posen/"
