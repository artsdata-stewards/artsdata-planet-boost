    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Vance Joy - Winnipeg Folk Festival"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Australian indie folk singer/songwriter Vance Joy began his career playing the Melbourne open-mike scene at the end of the 2000s while completing his law degree. Finding success with his intimate Bon Iver-influenced songs, Joy decided to put law on hold and pursue a music career instead."
      }
    ],
    "http://ogp.me/ns#url": [
