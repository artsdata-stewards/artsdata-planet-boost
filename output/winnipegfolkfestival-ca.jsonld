    "@id": "https://www.winnipegfolkfestival.ca/concert/09-24-2022-whitehorse/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Whitehorse - Winnipeg Folk Festival"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Since their debut, Whitehorse has traveled from magnetic folk duo to full-blown rock band and beyond. In truth Whitehorse is never fully either one or the other, but an ever-evolving creative partnership that challenges both artists."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://www.winnipegfolkfestival.ca/concert/09-24-2022-whitehorse/"
      }
    ],
