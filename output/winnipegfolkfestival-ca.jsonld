  {
    "@id": "http://www.winnipegfolkfestival.ca/genid/be37d80be29bf4ab",
    "@type": [
      "http://schema.org/Person"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.winnipegfolkfestival.ca/events-calendar/list/?eventDisplay=past"
