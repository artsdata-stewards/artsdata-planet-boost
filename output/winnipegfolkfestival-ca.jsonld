    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Tim Baker"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Tim Baker is a prolific wild-eyed dreamer. In 2022, Baker has returned with The Festival, a sonic embrace, a call in for love, and a cry out for connection. Baker wants us to bring our pain and suffering, and align it all with melody. The Festival is a kaleidoscopic view in these complicated times. Best&hellip;&lt;/p&gt;\\n"
      }
    ],
