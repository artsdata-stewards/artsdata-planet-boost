      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Choir! Choir! Choir! is a Toronto-based singing group led by creative directors Nobu Adilman and Daveed Goldman. The duo takes a non-traditional approach; there are no auditions, and the audience is the choir."
      }
    ],
    "http://ogp.me/ns#url": [
