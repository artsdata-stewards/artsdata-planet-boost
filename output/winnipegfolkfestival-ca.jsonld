    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Whitehorse"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Since their debut, Whitehorse has traveled from magnetic folk duo to full-blown rock band and beyond. In truth Whitehorse is never fully either one or the other, but an ever-evolving creative partnership that challenges both artists, Melissa McClelland and Luke Doucet, to explore new instrumental and lyrical terrain with each record. Steamy, swampy and squalling&hellip;&lt;/p&gt;\\n"
      }
    ],
