    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Leif Vollebekk is a Montreal adopted singer-songwriter. He will release his highly anticipated fourth full-length album New Ways on November 1st, the follow-up to his breakthrough Polaris Music Prize finalist, Juno-nominated record Twin Solitude. The record is now at over 22 million streams and was critically acclaimed by Uncut, NPR Music, The Fader, The Sunday Times Culture, The Line of Best Fit, Paste, Brooklyn Vegan, WXPN, KCRW and Exclaim! to&hellip;&lt;/p&gt;\\n"
      }
    ],
