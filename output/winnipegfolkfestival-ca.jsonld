    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Jeremy Dutcher - Winnipeg Folk Festival"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Jeremy Dutcher is a Two-Spirit song carrier, composer, activist, and ethnomusicologist from Tobique First Nation in Eastern Canada. He gained international acclaim for his album Wolastoqiyik Lintuwakonawa, which earned him the 2018 Polaris Music Prize and Indigenous Music Album of the Year at the 2019 JUNO Awards."
      }
    ],
    "http://ogp.me/ns#url": [
