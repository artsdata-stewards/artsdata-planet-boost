  {
    "@id": "https://www.winnipegfolkfestival.ca/concert/leith-ross/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Leith Ross - SOLD OUT - Winnipeg Folk Festival"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Leith Ross is a songwriter, singer, and artist born and raised in a small town outside of Ottawa, Ontario, Canada. They’ve been a sensitive and overly artistic person since birth and when they started writing songs around the age of 12 it quickly became Leith’s favourite way to be sensitive and overly artistic."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://www.winnipegfolkfestival.ca/concert/leith-ross/"
