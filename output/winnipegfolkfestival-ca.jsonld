  {
    "@id": "http://www.winnipegfolkfestival.ca/genid/6383b544b6f1654b",
    "@type": [
      "https://schema.org/WebPage"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.winnipegfolkfestival.ca/concert/hawksley-workman/"
