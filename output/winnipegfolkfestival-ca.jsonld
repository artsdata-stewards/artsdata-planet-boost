  {
    "@id": "http://www.winnipegfolkfestival.ca/genid/0fefede4c1faf1bf",
    "@type": [
      "https://schema.org/WebPage"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.winnipegfolkfestival.ca/events-calendar/list/?eventDisplay=past"
      }
    ],
    "https://schema.org/mainContentOfPage": [
      {
        "@language": "en",
        "@value": "\n\n\t\t\n\t\n\t\t\n\t\n\t\t69 events found.\t\n\t\n\t\t\n\t\n\n\t\t\n\t\n\n\t\t\n\t\n\n\t\n\n\n\t\t\n[{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Joel Plaskett\",\"description\":\"&lt;p&gt;Plaskett\\u2019s songs are a perennial part of the national playlist, a fixture on \\u201cbest of\\u201d lists, and the soundtrack to the lives of faithful fans across the country and around the world.&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/Window-photo-photo-by-Matt-Williams-scaled.jpeg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/09-19-2022-joel-plaskett/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2022-09-19T20:00:00-05:00\",\"endDate\":\"2022-09-19T23:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"The Park Theatre\",\"description\":\"&lt;p&gt;Park Theatre Wheelchair accessible venue Wheelchair seating available (4 spots) Limited accessible seating available Seating is available for visually impaired patrons are available Accessible seats must be purchased through Ticketmaster over the phone at 1-855-682-6736 No hearing devices are available No assigned parking Visit\\u00a0myparktheatre.com&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"698 Osborne Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3L 2B9\",\"addressCountry\":\"Canada\"},\"telephone\":\"204-478-7275\",\"sameAs\":\"https://myparktheatre.com/\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Joel Plaskett\",\"description\":\"&lt;p&gt;From rocking Halifax\\u2019s Marquee Club to performing for the masses at Massey Hall or touring the country with his father, Joel Plaskett has forged a reputation as one of Canada\\u2019s most engaging performers and respected singer-songwriters. Plaskett\\u2019s songs are a perennial part of the national playlist, a fixture on \\u201cbest of\\u201d lists, and the soundtrack&hellip;&lt;/p&gt;\\\\n\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"29.50\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/09-19-2022-joel-plaskett/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2022-08-25T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Whitehorse\",\"description\":\"&lt;p&gt;Since their debut, Whitehorse has traveled from magnetic folk duo to full-blown rock band and beyond. In truth Whitehorse is never fully either one or the other, but an ever-evolving creative partnership that challenges both artists.&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/WH-2022.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/09-24-2022-whitehorse/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2022-09-24T20:00:00-05:00\",\"endDate\":\"2022-09-24T23:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"The Park Theatre\",\"description\":\"&lt;p&gt;Park Theatre Wheelchair accessible venue Wheelchair seating available (4 spots) Limited accessible seating available Seating is available for visually impaired patrons are available Accessible seats must be purchased through Ticketmaster over the phone at 1-855-682-6736 No hearing devices are available No assigned parking Visit\\u00a0myparktheatre.com&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"698 Osborne Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3L 2B9\",\"addressCountry\":\"Canada\"},\"telephone\":\"204-478-7275\",\"sameAs\":\"https://myparktheatre.com/\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Whitehorse\",\"description\":\"&lt;p&gt;Since their debut, Whitehorse has traveled from magnetic folk duo to full-blown rock band and beyond. In truth Whitehorse is never fully either one or the other, but an ever-evolving creative partnership that challenges both artists, Melissa McClelland and Luke Doucet, to explore new instrumental and lyrical terrain with each record. Steamy, swampy and squalling&hellip;&lt;/p&gt;\\\\n\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"35.00\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/09-24-2022-whitehorse/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2022-09-16T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"The Paper Kites &#8211; SOLD OUT\",\"description\":\"&lt;p&gt;Give them your tired, your lonely, your lovesick, your unsure,\\u00a0The Paper Kites\\u00a0have a song for each of them. \\u201cI created a world based on the idea of watching other people, but a lot of the songs are extensions of myself or people I know,\\u201d he says.&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/ThePaperKites-Website-scaled.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/09-28-2022-the-paper-kites/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2022-09-28T20:00:00-05:00\",\"endDate\":\"2022-09-28T23:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"The Park Theatre\",\"description\":\"&lt;p&gt;Park Theatre Wheelchair accessible venue Wheelchair seating available (4 spots) Limited accessible seating available Seating is available for visually impaired patrons are available Accessible seats must be purchased through Ticketmaster over the phone at 1-855-682-6736 No hearing devices are available No assigned parking Visit\\u00a0myparktheatre.com&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"698 Osborne Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3L 2B9\",\"addressCountry\":\"Canada\"},\"telephone\":\"204-478-7275\",\"sameAs\":\"https://myparktheatre.com/\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"The Paper Kites\",\"description\":\"&lt;p&gt;\\u201cOur hotel window in New York City looked straight into the apartment building across the street. You could see all these windows lighting up and people getting home from their nights out.\\u00a0We just sat there and watched them. It was fascinating. It was living art.\\u201d Sam Bentley, frontman for\\u00a0The Paper Kites\\u00a0spoke of the moment the&hellip;&lt;/p&gt;\\\\n\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"35.00\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/09-28-2022-the-paper-kites/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2022-09-19T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"The Rural Alberta Advantage\",\"description\":\"&lt;p&gt;The Rise, the new EP from The Rural Alberta Advantage, is the first word in a conversation, the first step on a new, unkept trail.&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/TheRuralAlbertaAdvantage-PRESS-WEB-scaled.jpeg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/the-rural-alberta-advantage/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2022-10-03T20:00:00-05:00\",\"endDate\":\"2022-10-03T23:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"The Park Theatre\",\"description\":\"&lt;p&gt;Park Theatre Wheelchair accessible venue Wheelchair seating available (4 spots) Limited accessible seating available Seating is available for visually impaired patrons are available Accessible seats must be purchased through Ticketmaster over the phone at 1-855-682-6736 No hearing devices are available No assigned parking Visit\\u00a0myparktheatre.com&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"698 Osborne Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3L 2B9\",\"addressCountry\":\"Canada\"},\"telephone\":\"204-478-7275\",\"sameAs\":\"https://myparktheatre.com/\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"The Rural Alberta Advantage\",\"description\":\"&lt;p&gt;The Rise, the new EP from The Rural Alberta Advantage, is the first word in a conversation, the first step on a new, unkept trail. It\\u2019s the beginning of a new era for the Toronto trio, and the first of three pieces in a year-long puzzle, which will be constructed over three separate releases. On&hellip;&lt;/p&gt;\\\\n\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"27.50\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/the-rural-alberta-advantage/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2022-09-21T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Basia Bulat\",\"description\":\"&lt;p&gt;Introducing The Garden: a STRINGS ALBUM and a RETROSPECTIVE from a room in Montreal with the windows open, and the wind moving, and the leaves changing, and a spring-coloured secret on the tip of Basia Bulat\\u2019s tongue.&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/Basia-Bulat-by-Richmond-Lam-WEB-scaled.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/basia-bulat/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2022-10-06T20:00:00-05:00\",\"endDate\":\"2022-10-06T23:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"The Park Theatre\",\"description\":\"&lt;p&gt;Park Theatre Wheelchair accessible venue Wheelchair seating available (4 spots) Limited accessible seating available Seating is available for visually impaired patrons are available Accessible seats must be purchased through Ticketmaster over the phone at 1-855-682-6736 No hearing devices are available No assigned parking Visit\\u00a0myparktheatre.com&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"698 Osborne Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3L 2B9\",\"addressCountry\":\"Canada\"},\"telephone\":\"204-478-7275\",\"sameAs\":\"https://myparktheatre.com/\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Basia Bulat\",\"description\":\"&lt;p&gt;Introducing The Garden: a STRINGS ALBUM and a RETROSPECTIVE from a room in Montreal with the windows open, and the wind moving, and the leaves changing, and a spring-coloured secret on the tip of Basia Bulat\\u2019s tongue. The band made it in a pandemic. Bulat and her old friend Mark Lawson, with whom she recorded&hellip;&lt;/p&gt;\\\\n\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"27.50\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/basia-bulat/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2022-09-21T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Moontricks &#8211; SOLD OUT\",\"description\":\"&lt;p&gt;Combining their love of folk, blues, and electronic music, Nathan Gurley and Sean Rodman are blazing their own trail, merging musical worlds previously unacquainted and capturing audiences along the way.&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/Moontricks_Promo-2019-1a-Louis-Bockner-Photography-WEBSITE-scaled.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/10-14-2022-moontricks/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2022-10-14T20:00:00-05:00\",\"endDate\":\"2022-10-14T23:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"The Park Theatre\",\"description\":\"&lt;p&gt;Park Theatre Wheelchair accessible venue Wheelchair seating available (4 spots) Limited accessible seating available Seating is available for visually impaired patrons are available Accessible seats must be purchased through Ticketmaster over the phone at 1-855-682-6736 No hearing devices are available No assigned parking Visit\\u00a0myparktheatre.com&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"698 Osborne Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3L 2B9\",\"addressCountry\":\"Canada\"},\"telephone\":\"204-478-7275\",\"sameAs\":\"https://myparktheatre.com/\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Moontricks\",\"description\":\"&lt;p&gt;Nestled deep in the beautiful Kootenay mountains of Western Canada lies the home of Moontricks, a duo whose timeless sound captures the essence of their rugged roots. Combining their love of folk, blues, and electronic music, Nathan Gurley and Sean Rodman are blazing their own trail, merging musical worlds previously unacquainted and capturing audiences along&hellip;&lt;/p&gt;\\\\n\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"25.00\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/10-14-2022-moontricks/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2022-09-23T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Moontricks &#8211; SOLD OUT\",\"description\":\"&lt;p&gt;Nestled deep in the beautiful Kootenay mountains of Western Canada lies the home of Moontricks, a duo whose timeless sound captures the essence of their rugged roots.&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/Moontricks_Promo-2019-1a-Louis-Bockner-Photography-WEBSITE-scaled.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/10-15-2022-moontricks/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2022-10-15T19:00:00-05:00\",\"endDate\":\"2022-10-15T22:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"The Good Will\",\"description\":\"&lt;p&gt;The Good Will Wheelchair accessible venue Accessible seats must be purchased through Ticketmaster over the phone at 1-855-682-6736 No hearing devices available No assigned parking Visit\\u00a0thegoodwill.ca&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"625 Portage Avenue\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3B 2G4\",\"addressCountry\":\"Canada\"},\"telephone\":\"\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Moontricks\",\"description\":\"&lt;p&gt;Nestled deep in the beautiful Kootenay mountains of Western Canada lies the home of Moontricks, a duo whose timeless sound captures the essence of their rugged roots. Combining their love of folk, blues, and electronic music, Nathan Gurley and Sean Rodman are blazing their own trail, merging musical worlds previously unacquainted and capturing audiences along&hellip;&lt;/p&gt;\\\\n\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"25.00\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/10-15-2022-moontricks/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2022-09-26T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"The Milk Carton Kids + Katie Pruitt\",\"description\":\"&lt;p&gt;Listening to The Milk Carton Kids \\u2014 Joey Ryan and Kenneth Pattengale \\u2014 talk about their creative process, it\\u2019s easy to imagine them running in opposite directions even while yoked together. \\u201cJoey and I famously have an adversarial relationship,\\u201d Pattengale says.&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/TMCK-KP.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/10-27-2022-the-milk-carton-kids-katie-pruitt/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2022-10-27T20:00:00-05:00\",\"endDate\":\"2022-10-27T23:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"Burton Cummings Theatre\",\"description\":\"&lt;p&gt;Wheelchair accessible main floor Wheelchair and companion seating is available with a 1 to 1 arrangement in loge 1 and loge 2. A Chair will be provided for the companion, who will be seated directly beside the wheelchair space. (8 spots available including companion seats, 4 on each side)* Seating is also available for visually/hearing&hellip;&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"364 Smith Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3B 2H2\",\"addressCountry\":\"Canada\"},\"telephone\":\"\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"The Milk Carton Kids\",\"description\":\"&lt;p&gt;Listening to The Milk Carton Kids \\u2014 Joey Ryan and Kenneth Pattengale \\u2014 talk about their creative process, it\\u2019s easy to imagine them running in opposite directions even while yoked together. \\u201cJoey and I famously have an adversarial relationship,\\u201d Pattengale says. They dig at each other in interviews and on stage, where Ryan plays his&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/TMCK-Website.jpeg\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"35.00 \\u2013 45.00\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/10-27-2022-the-milk-carton-kids-katie-pruitt/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2022-09-20T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Leif Vollebekk\",\"description\":\"&lt;p&gt;Leif Vollebekk is a Montreal-adopted singer-songwriter. He will release his highly anticipated fourth full-length album\\u00a0New Ways\\u00a0on November 1st, the follow-up to his breakthrough\\u00a0Polaris Music Prize\\u00a0finalist,\\u00a0Juno-nominated\\u00a0record\\u00a0Twin Solitude.\\u00a0&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/Leif-Vollebekk_Credit-Gregory-Alan-Isakov-website-scaled.jpeg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/11-02-2022-leif-vollebekk/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2022-11-02T20:00:00-05:00\",\"endDate\":\"2022-11-02T23:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"The Park Theatre\",\"description\":\"&lt;p&gt;Park Theatre Wheelchair accessible venue Wheelchair seating available (4 spots) Limited accessible seating available Seating is available for visually impaired patrons are available Accessible seats must be purchased through Ticketmaster over the phone at 1-855-682-6736 No hearing devices are available No assigned parking Visit\\u00a0myparktheatre.com&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"698 Osborne Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3L 2B9\",\"addressCountry\":\"Canada\"},\"telephone\":\"204-478-7275\",\"sameAs\":\"https://myparktheatre.com/\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Leif Vollebekk\",\"description\":\"&lt;p&gt;Leif Vollebekk\\u00a0is a Montreal adopted singer-songwriter. He will release his highly anticipated fourth full-length album\\u00a0New Ways\\u00a0on November 1st, the follow-up to his breakthrough\\u00a0Polaris Music Prize\\u00a0finalist,\\u00a0Juno-nominated\\u00a0record\\u00a0Twin Solitude.\\u00a0The record is now at over\\u00a022 million streams\\u00a0and was critically acclaimed by\\u00a0Uncut, NPR Music, The Fader, The Sunday Times Culture, The Line of Best Fit, Paste, Brooklyn Vegan, WXPN, KCRW\\u00a0and\\u00a0Exclaim!\\u00a0to&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/Leif-Vollebekk_Credit-Gregory-Alan-Isakov-website-scaled.jpeg\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"35.00\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/11-02-2022-leif-vollebekk/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2022-09-23T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Five Alarm Funk\",\"description\":\"&lt;p&gt;Hot, sweaty dance floors with feet stomping and everybody moving. Grooves for days. Monster horns, crushing percussion and shredding psych-rock guitars.&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/FAF-FALL-2022-POSTER-1920-x-1005-web.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/10-03-2022-five-alarm-funk/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2022-11-03T20:00:00-05:00\",\"endDate\":\"2022-11-03T23:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"The Park Theatre\",\"description\":\"&lt;p&gt;Park Theatre Wheelchair accessible venue Wheelchair seating available (4 spots) Limited accessible seating available Seating is available for visually impaired patrons are available Accessible seats must be purchased through Ticketmaster over the phone at 1-855-682-6736 No hearing devices are available No assigned parking Visit\\u00a0myparktheatre.com&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"698 Osborne Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3L 2B9\",\"addressCountry\":\"Canada\"},\"telephone\":\"204-478-7275\",\"sameAs\":\"https://myparktheatre.com/\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Five Alarm Funk\",\"description\":\"&lt;p&gt;Hot, sweaty dance floors with feet stomping and everybody moving. Grooves for days. Monster horns, crushing percussion and shredding psych-rock guitars. These are among the elements that make up the Five Alarm Funk experience. The Vancouver-based band is eight strong and over a decade deep into a career that has seen it release five acclaimed&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/FAF-Web-Event-1.jpg\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"29.50\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/10-03-2022-five-alarm-funk/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2022-09-26T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Five Alarm Funk &#8211; SOLD OUT\",\"description\":\"&lt;p&gt;Hot, sweaty dance floors with feet stomping and everybody moving. Grooves for days. Monster horns, crushing percussion and shredding psych-rock guitars.&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/FAF-FALL-2022-POSTER-1920-x-1005-web.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/10-04-2022-five-alarm-funk/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2022-11-04T20:00:00-05:00\",\"endDate\":\"2022-11-04T23:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"The Park Theatre\",\"description\":\"&lt;p&gt;Park Theatre Wheelchair accessible venue Wheelchair seating available (4 spots) Limited accessible seating available Seating is available for visually impaired patrons are available Accessible seats must be purchased through Ticketmaster over the phone at 1-855-682-6736 No hearing devices are available No assigned parking Visit\\u00a0myparktheatre.com&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"698 Osborne Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3L 2B9\",\"addressCountry\":\"Canada\"},\"telephone\":\"204-478-7275\",\"sameAs\":\"https://myparktheatre.com/\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Five Alarm Funk\",\"description\":\"&lt;p&gt;Hot, sweaty dance floors with feet stomping and everybody moving. Grooves for days. Monster horns, crushing percussion and shredding psych-rock guitars. These are among the elements that make up the Five Alarm Funk experience. The Vancouver-based band is eight strong and over a decade deep into a career that has seen it release five acclaimed&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/FAF-Web-Event-1.jpg\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"29.50\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/10-04-2022-five-alarm-funk/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2022-09-23T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Tim Baker\",\"description\":\"&lt;p&gt;Tim Baker is a prolific wild-eyed dreamer. In 2022, Baker has returned with The Festival, a sonic embrace, a call-in for love, and a cry-out for connection.&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/TB-Website-scaled.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/11-24-2022-tim-baker/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2022-11-24T20:00:00-06:00\",\"endDate\":\"2022-11-24T23:00:00-06:00\",\"location\":{\"@type\":\"Place\",\"name\":\"The Park Theatre\",\"description\":\"&lt;p&gt;Park Theatre Wheelchair accessible venue Wheelchair seating available (4 spots) Limited accessible seating available Seating is available for visually impaired patrons are available Accessible seats must be purchased through Ticketmaster over the phone at 1-855-682-6736 No hearing devices are available No assigned parking Visit\\u00a0myparktheatre.com&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"698 Osborne Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3L 2B9\",\"addressCountry\":\"Canada\"},\"telephone\":\"204-478-7275\",\"sameAs\":\"https://myparktheatre.com/\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Tim Baker\",\"description\":\"&lt;p&gt;Tim Baker is a prolific wild-eyed dreamer. In 2022, Baker has returned with The Festival, a sonic embrace, a call in for love, and a cry out for connection. Baker wants us to bring our pain and suffering, and align it all with melody. The Festival is a kaleidoscopic view in these complicated times. Best&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/TB-Website-scaled.jpg\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"33.50\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/11-24-2022-tim-baker/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2022-09-23T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"William Prince\",\"description\":\"&lt;p&gt;William Prince approaches the big questions with humility and curiosity, and his songwriting is a masterclass in skillful simplicity.&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/William-Prince-Press-Photo-website-scaled.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/11-26-2022-william-prince/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2022-11-26T20:00:00-06:00\",\"endDate\":\"2022-11-26T23:00:00-06:00\",\"location\":{\"@type\":\"Place\",\"name\":\"Burton Cummings Theatre\",\"description\":\"&lt;p&gt;Wheelchair accessible main floor Wheelchair and companion seating is available with a 1 to 1 arrangement in loge 1 and loge 2. A Chair will be provided for the companion, who will be seated directly beside the wheelchair space. (8 spots available including companion seats, 4 on each side)* Seating is also available for visually/hearing&hellip;&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"364 Smith Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3B 2H2\",\"addressCountry\":\"Canada\"},\"telephone\":\"\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"William Prince\",\"description\":\"&lt;p&gt;William Prince approaches the big questions with humility and curiosity, and his songwriting is a masterclass in skillful simplicity. Since his JUNO Award win in 2017, Prince\\u2019s momentum has continued to build, with each new album adding depth and dimension to an exceptional body of work that has received international acclaim. From national network television&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/William-Prince-Press-Photo-website-scaled.jpg\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"36.00 \\u2013 53.00\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/11-26-2022-william-prince/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2022-09-23T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Ruby Waters &#8211; SOLD OUT\",\"description\":\"&lt;p&gt;Her sound is similar to her journey \\u2013 eclectic, always evolving, and unfeigned. Hailing from the small town of Shelburne, Ontario and born to two artists, Ruby was immersed in a musician\\u2019s world at a young age.&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/Ruby-Waters-Website-scaled.jpeg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/12-06-2022-ruby-waters/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2022-12-06T20:00:00-06:00\",\"endDate\":\"2022-12-06T23:00:00-06:00\",\"location\":{\"@type\":\"Place\",\"name\":\"The Park Theatre\",\"description\":\"&lt;p&gt;Park Theatre Wheelchair accessible venue Wheelchair seating available (4 spots) Limited accessible seating available Seating is available for visually impaired patrons are available Accessible seats must be purchased through Ticketmaster over the phone at 1-855-682-6736 No hearing devices are available No assigned parking Visit\\u00a0myparktheatre.com&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"698 Osborne Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3L 2B9\",\"addressCountry\":\"Canada\"},\"telephone\":\"204-478-7275\",\"sameAs\":\"https://myparktheatre.com/\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Ruby Waters\",\"description\":\"&lt;p&gt;Her sound is similar to her journey \\u2013 eclectic, always evolving, and unfeigned. Hailing from the small town of Shelburne, Ontario and born to two artists, Ruby was immersed in a musician\\u2019s world at a young age. Now, an artist herself, she plugs in and belts out, unapologetically leaving you in awe. Ruby recently released&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/Ruby-Waters-Website-scaled.jpeg\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"20.00\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/12-06-2022-ruby-waters/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2022-09-23T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"JP Hoe Hoe Hoe &#8211; POSTPONED TO DEC. 16\",\"description\":\"&lt;p&gt;The JP Hoe Hoe Hoe Holiday Show has become a tried and true tradition for so many of us and never fails to sell out quickly! We\\u2019re excited to bring this beloved show back for the 17th time to the Burton Cummings Theatre on December 10, 2022. Join us for an unforgettable evening of music and holiday magic!&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/Event-scaled.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/12-10-2022-jp-hoe-hoe-hoe/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2022-12-10T20:00:00-06:00\",\"endDate\":\"2022-12-10T23:00:00-06:00\",\"location\":{\"@type\":\"Place\",\"name\":\"Burton Cummings Theatre\",\"description\":\"&lt;p&gt;Wheelchair accessible main floor Wheelchair and companion seating is available with a 1 to 1 arrangement in loge 1 and loge 2. A Chair will be provided for the companion, who will be seated directly beside the wheelchair space. (8 spots available including companion seats, 4 on each side)* Seating is also available for visually/hearing&hellip;&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"364 Smith Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3B 2H2\",\"addressCountry\":\"Canada\"},\"telephone\":\"\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"JP Hoe\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"25.50 \\u2013 49.50\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/12-10-2022-jp-hoe-hoe-hoe/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2022-10-25T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Hayden\",\"description\":\"&lt;p&gt;For over 25 years Hayden has been making music on his own terms and on his own schedule. The Polaris Prize and Juno nominee has produced, engineered and mixed most of his records at home, creating a world of his own.&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/hayden-for-event.png\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/02-07-2023-hayden/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2023-02-07T20:00:00-06:00\",\"endDate\":\"2023-02-07T23:00:00-06:00\",\"location\":{\"@type\":\"Place\",\"name\":\"The Park Theatre\",\"description\":\"&lt;p&gt;Park Theatre Wheelchair accessible venue Wheelchair seating available (4 spots) Limited accessible seating available Seating is available for visually impaired patrons are available Accessible seats must be purchased through Ticketmaster over the phone at 1-855-682-6736 No hearing devices are available No assigned parking Visit\\u00a0myparktheatre.com&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"698 Osborne Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3L 2B9\",\"addressCountry\":\"Canada\"},\"telephone\":\"204-478-7275\",\"sameAs\":\"https://myparktheatre.com/\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Hayden\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"40.00\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/02-07-2023-hayden/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2022-12-15T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Bruce Cockburn\",\"description\":\"&lt;p&gt;One of Canada\\u2019s finest artists, Bruce Cockburn has enjoyed an illustrious career shaped by politics, spirituality, and musical diversity. His remarkable journey has seen him embrace folk, jazz, rock, and worldbeat styles while travelling to such far-flung places as Guatemala, Mali, Mozambique, and Nepal, and writing memorable songs about his ever-expanding world of wonders.&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/2021-portland-DSC05828-300dpi-by-daniel-keebler-cr-Website.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/02-10-2023-bruce-cockburn/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2023-02-10T20:00:00-06:00\",\"endDate\":\"2023-02-10T23:00:00-06:00\",\"location\":{\"@type\":\"Place\",\"name\":\"Burton Cummings Theatre\",\"description\":\"&lt;p&gt;Wheelchair accessible main floor Wheelchair and companion seating is available with a 1 to 1 arrangement in loge 1 and loge 2. A Chair will be provided for the companion, who will be seated directly beside the wheelchair space. (8 spots available including companion seats, 4 on each side)* Seating is also available for visually/hearing&hellip;&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"364 Smith Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3B 2H2\",\"addressCountry\":\"Canada\"},\"telephone\":\"\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Bruce Cockburn\",\"description\":\"&lt;p&gt;One of Canada\\u2019s finest artists, Bruce Cockburn has enjoyed an illustrious career shaped by politics, spirituality, and musical diversity. His remarkable journey has seen him embrace folk, jazz, rock, and worldbeat styles while travelling to such far-flung places as Guatemala, Mali, Mozambique, and Nepal, and writing memorable songs about his ever-expanding world of wonders. \\u201cMy&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/2021-portland-DSC05828-300dpi-by-daniel-keebler-cr-Website.jpg\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"39.50 \\u2013 69.50\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/02-10-2023-bruce-cockburn/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2022-09-23T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Vance Joy\",\"description\":\"&lt;p&gt;Australian indie folk singer/songwriter Vance Joy began his career playing the Melbourne open-mike scene at the end of the 2000s while completing his law degree. Finding success with his intimate Bon Iver-influenced songs, Joy decided to put law on hold and pursue a music career instead.&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/Vance-Joy-Website.png\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/02-21-2023-vance-joy/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2023-02-21T20:00:00-06:00\",\"endDate\":\"2023-02-21T23:00:00-06:00\",\"location\":{\"@type\":\"Place\",\"name\":\"Centennial Concert Hall\",\"description\":\"\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"555 Main Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3B 1C3\",\"addressCountry\":\"Canada\"},\"telephone\":\"\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Vance Joy\",\"description\":\"&lt;p&gt;Australian indie folk singer/songwriter Vance Joy began his career playing the Melbourne open-mike scene at the end of the 2000s while completing his law degree. Finding success with his intimate Bon Iver-influenced songs, Joy decided to put law on hold and pursue a music career instead. Born James Keogh, the singer took the name Vance&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/Vance-Joy-Website.png\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"54.00 \\u2013 89.00\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/02-21-2023-vance-joy/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2022-09-23T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Ocie Elliott &#8211; SOLD OUT\",\"description\":\"&lt;p&gt;Ocie Elliott pen tunes that feel lived-in. You can hear their memories, experiences, and emotions in the dusty acoustic guitars, the sparse production, and the graceful harmonies between Jon Middleton and Sierra Lundy. Their life together plays out in the music as if projected on the big screen of an old small-town theater.&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/OcieElliott_PromoPhoto1_KellyLovettPhotography-copy-scaled.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/ocie-elliott/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2023-02-27T20:00:00-06:00\",\"endDate\":\"2023-02-27T23:00:00-06:00\",\"location\":{\"@type\":\"Place\",\"name\":\"The Park Theatre\",\"description\":\"&lt;p&gt;Park Theatre Wheelchair accessible venue Wheelchair seating available (4 spots) Limited accessible seating available Seating is available for visually impaired patrons are available Accessible seats must be purchased through Ticketmaster over the phone at 1-855-682-6736 No hearing devices are available No assigned parking Visit\\u00a0myparktheatre.com&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"698 Osborne Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3L 2B9\",\"addressCountry\":\"Canada\"},\"telephone\":\"204-478-7275\",\"sameAs\":\"https://myparktheatre.com/\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Ocie Elliott\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"29.50\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/ocie-elliott/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2022-12-23T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Ocie Elliott &#8211; SOLD OUT\",\"description\":\"&lt;p&gt;Ocie Elliott pen tunes that feel lived-in. You can hear their memories, experiences, and emotions in the dusty acoustic guitars, the sparse production, and the graceful harmonies between Jon Middleton and Sierra Lundy. Their life together plays out in the music as if projected on the big screen of an old small-town theater.&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/OcieElliott_PromoPhoto1_KellyLovettPhotography-copy-scaled.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/02-28-2023-ocie-elliott/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2023-02-28T20:00:00-06:00\",\"endDate\":\"2023-02-28T23:00:00-06:00\",\"location\":{\"@type\":\"Place\",\"name\":\"The Park Theatre\",\"description\":\"&lt;p&gt;Park Theatre Wheelchair accessible venue Wheelchair seating available (4 spots) Limited accessible seating available Seating is available for visually impaired patrons are available Accessible seats must be purchased through Ticketmaster over the phone at 1-855-682-6736 No hearing devices are available No assigned parking Visit\\u00a0myparktheatre.com&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"698 Osborne Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3L 2B9\",\"addressCountry\":\"Canada\"},\"telephone\":\"204-478-7275\",\"sameAs\":\"https://myparktheatre.com/\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Ocie Elliott\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"29.50\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/02-28-2023-ocie-elliott/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2022-11-23T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Andy Shauf\",\"description\":\"&lt;p&gt;Hailed as \\u201ca gifted storyteller\\u201d (NPR Music) for 2016\\u2019s The Party and 2020\\u2019s The Neon Skyline, Shauf writes albums that unfold like short fiction, full of colorful characters, fine details and a rich emotional depth.&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/MAIN-Andy-Shauf-by-Angela-Lewis-2-Web-Event-scaled.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/03-17-2023-andy-shauf/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2023-03-17T20:00:00-05:00\",\"endDate\":\"2023-03-17T23:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"Burton Cummings Theatre\",\"description\":\"&lt;p&gt;Wheelchair accessible main floor Wheelchair and companion seating is available with a 1 to 1 arrangement in loge 1 and loge 2. A Chair will be provided for the companion, who will be seated directly beside the wheelchair space. (8 spots available including companion seats, 4 on each side)* Seating is also available for visually/hearing&hellip;&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"364 Smith Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3B 2H2\",\"addressCountry\":\"Canada\"},\"telephone\":\"\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Andy Shauf\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"27.50 \\u2013 37.50\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/03-17-2023-andy-shauf/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2022-11-14T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Matt Andersen and The Big Bottle of Joy\",\"description\":\"&lt;p&gt;When Matt Andersen steps on stage, he brings a lifetime of music to every note he plays. His latest album, The Big Bottle of Joy, is all about hard-won celebration; a dozen songs infused with raw blues-rock, rollicking Americana, thoughtful folk, and ecstatic gospel.&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/Matt-Andersen-Website-scaled.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/02-30-2023-matt-andersen/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2023-03-30T20:00:00-05:00\",\"endDate\":\"2023-03-30T23:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"Club Regent Event Centre\",\"description\":\"&lt;p&gt;Limited mobility Handicap parking Wheelchair access to the building, including slot machines and select table games Available wheelchairs and walkers Gender-neutral accessible washrooms Impaired hearing Voice/TTY phones Impaired sight Service dog access Large print menus in our lounge areas Braille phone with enlarged numbers Braille/tactile bingo cards with enlarged print Player and dealer card announcements&hellip;&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"1425 Regent Avenue West\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R2C3B2\",\"addressCountry\":\"Canada\"},\"telephone\":\"\",\"sameAs\":\"https://www.casinosofwinnipeg.com/club-regent-event-centre-home/\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Matt Andersen\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"29.00 \\u2013 39.00\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/02-30-2023-matt-andersen/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2022-11-22T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Reuben and the Dark\",\"description\":\"&lt;p&gt;Reuben and the Dark is the spirited folk-rock outfit led by Reuben Bullock, whose music blends introspective lyrics with the irrepressible pulse and complicit harmonies of his band.&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/RATD-@-Wildhorse-Saloon-2021-\\u2014-6-copy-scaled.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/03-30-2023-reuben-and-the-dark/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2023-03-30T20:00:00-05:00\",\"endDate\":\"2023-03-30T23:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"The Park Theatre\",\"description\":\"&lt;p&gt;Park Theatre Wheelchair accessible venue Wheelchair seating available (4 spots) Limited accessible seating available Seating is available for visually impaired patrons are available Accessible seats must be purchased through Ticketmaster over the phone at 1-855-682-6736 No hearing devices are available No assigned parking Visit\\u00a0myparktheatre.com&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"698 Osborne Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3L 2B9\",\"addressCountry\":\"Canada\"},\"telephone\":\"204-478-7275\",\"sameAs\":\"https://myparktheatre.com/\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Reuben and the Dark\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"29.50 \\u2013 34.50\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/03-30-2023-reuben-and-the-dark/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2022-11-28T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Del Barber\",\"description\":\"&lt;p&gt;With nominations for JUNO Awards, Western Canadian Music Awards, and Canadian Folk Music Awards - Del Barber has shaped the folk music canon in Canada with five critically acclaimed studio albums under his belt, as well as a myriad of fans.&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/Del-Barber_Upload-a-press-photo--scaled.jpeg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/del-barber/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2023-04-20T20:00:00-05:00\",\"endDate\":\"2023-04-20T23:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"The Park Theatre\",\"description\":\"&lt;p&gt;Park Theatre Wheelchair accessible venue Wheelchair seating available (4 spots) Limited accessible seating available Seating is available for visually impaired patrons are available Accessible seats must be purchased through Ticketmaster over the phone at 1-855-682-6736 No hearing devices are available No assigned parking Visit\\u00a0myparktheatre.com&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"698 Osborne Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3L 2B9\",\"addressCountry\":\"Canada\"},\"telephone\":\"204-478-7275\",\"sameAs\":\"https://myparktheatre.com/\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Del Barber\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"29.50\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/del-barber/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2023-02-21T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Choir! Choir! Choir!\",\"description\":\"&lt;p&gt;Choir! Choir! Choir!\\u00a0is a Toronto-based singing group led by creative directors Nobu Adilman and Daveed Goldman. The duo takes a non-traditional approach; there are no auditions, and the audience is the choir.&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/Untitled-1.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/choir-choir-choir/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2023-04-22T20:00:00-05:00\",\"endDate\":\"2023-04-22T22:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"The Park Theatre\",\"description\":\"&lt;p&gt;Park Theatre Wheelchair accessible venue Wheelchair seating available (4 spots) Limited accessible seating available Seating is available for visually impaired patrons are available Accessible seats must be purchased through Ticketmaster over the phone at 1-855-682-6736 No hearing devices are available No assigned parking Visit\\u00a0myparktheatre.com&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"698 Osborne Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3L 2B9\",\"addressCountry\":\"Canada\"},\"telephone\":\"204-478-7275\",\"sameAs\":\"https://myparktheatre.com/\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Choir! Choir! Choir!\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"30.00\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/choir-choir-choir/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2023-03-10T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Leith Ross &#8211; SOLD OUT\",\"description\":\"&lt;p&gt;Leith Ross is a songwriter, singer, and artist born and raised in a small town outside of Ottawa, Ontario, Canada. They\\u2019ve been a sensitive and overly artistic person since birth and when they started writing songs around the age of 12 it quickly became Leith\\u2019s favourite way to be sensitive and overly artistic.&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/Leith-Ross-Website.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/leith-ross/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2023-06-16T20:00:00-05:00\",\"endDate\":\"2023-06-16T22:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"West End Cultural Centre\",\"description\":\"&lt;p&gt;Building Accessibility The front entrance of our building is nearly at sidewalk level. There are no steps, however, there is a small incline at the door threshold of about 2 inches. In the entranceway, there is an elevator that can take people up to the lobby. The elevator is locked, but during events there is&hellip;&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"586 Ellice Ave\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3B 1Z8\",\"addressCountry\":\"Canada\"},\"telephone\":\"12042980396\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Leith Ross\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"30.00 \\u2013 35.00\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/leith-ross/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2023-02-13T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Leith Ross &#8211; SOLD OUT\",\"description\":\"&lt;p&gt;Leith Ross is a songwriter, singer, and artist born and raised in a small town outside of Ottawa, Ontario, Canada. They\\u2019ve been a sensitive and overly artistic person since birth and when they started writing songs around the age of 12 it quickly became Leith\\u2019s favourite way to be sensitive and overly artistic.&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/Leith-Ross-Website.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/leith-ross-2/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2023-06-17T20:00:00-05:00\",\"endDate\":\"2023-06-17T23:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"West End Cultural Centre\",\"description\":\"&lt;p&gt;Building Accessibility The front entrance of our building is nearly at sidewalk level. There are no steps, however, there is a small incline at the door threshold of about 2 inches. In the entranceway, there is an elevator that can take people up to the lobby. The elevator is locked, but during events there is&hellip;&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"586 Ellice Ave\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3B 1Z8\",\"addressCountry\":\"Canada\"},\"telephone\":\"12042980396\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Leith Ross\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"30.00 \\u2013 35.00\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/leith-ross-2/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2023-02-17T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Courtney Marie Andrews\",\"description\":\"&lt;p&gt;On the honey shores of Cape Cod in a beach shack, Courtney Marie Andrews found self-love and her voice.\\u00a0 Every morning, she\\u2019d walk 6-8 miles around the back trails of an island and meditate on her life, perusing old memories and patterns like browsing a used bookshop. That summer of introspection led her to a joyous sense of beginnings and ends.&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/App-CMA.png\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/07-26-2023-courtney-marie-andrews/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2023-07-26T20:00:00-05:00\",\"endDate\":\"2023-07-26T23:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"The Good Will\",\"description\":\"&lt;p&gt;The Good Will Wheelchair accessible venue Accessible seats must be purchased through Ticketmaster over the phone at 1-855-682-6736 No hearing devices available No assigned parking Visit\\u00a0thegoodwill.ca&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"625 Portage Avenue\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3B 2G4\",\"addressCountry\":\"Canada\"},\"telephone\":\"\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Courtney Marie Andrews\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"22.50\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/07-26-2023-courtney-marie-andrews/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2023-05-23T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Dan Mangan\",\"description\":\"&lt;p&gt;Dan Mangan is a two-time JUNO award-winning and two-time Polaris Music Prize-listed musician and songwriter. He lives in Vancouver, British Columbia with his wife and two sons. He has toured extensively in North America, Europe &amp; Australia. Dan also scored the feature film Hector And The Search For Happiness starring Simon Pegg as well as television shows for Netflix (Hilda) and AMC (Unspeakable).&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/DanMangan-LayLow-Credit-Gen-Monro-BW.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/11-10-2023-dan-mangan/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2023-10-05T20:00:00-05:00\",\"endDate\":\"2023-10-05T23:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"Burton Cummings Theatre\",\"description\":\"&lt;p&gt;Wheelchair accessible main floor Wheelchair and companion seating is available with a 1 to 1 arrangement in loge 1 and loge 2. A Chair will be provided for the companion, who will be seated directly beside the wheelchair space. (8 spots available including companion seats, 4 on each side)* Seating is also available for visually/hearing&hellip;&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"364 Smith Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3B 2H2\",\"addressCountry\":\"Canada\"},\"telephone\":\"\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Dan Mangan\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"24.50 \\u2013 39.50\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/11-10-2023-dan-mangan/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2023-04-11T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Jeremy Dutcher\",\"description\":\"&lt;p&gt;Jeremy Dutcher is a Two-Spirit song carrier, composer, activist, and ethnomusicologist from Tobique First Nation in Eastern Canada. He gained international acclaim for his album Wolastoqiyik Lintuwakonawa, which earned him the 2018 Polaris Music Prize and Indigenous Music Album of the Year at the 2019 JUNO Awards.&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/App-J-Dutch.png\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/jeremy-dutcher/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2023-10-28T20:00:00-05:00\",\"endDate\":\"2023-10-28T23:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"Burton Cummings Theatre\",\"description\":\"&lt;p&gt;Wheelchair accessible main floor Wheelchair and companion seating is available with a 1 to 1 arrangement in loge 1 and loge 2. A Chair will be provided for the companion, who will be seated directly beside the wheelchair space. (8 spots available including companion seats, 4 on each side)* Seating is also available for visually/hearing&hellip;&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"364 Smith Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3B 2H2\",\"addressCountry\":\"Canada\"},\"telephone\":\"\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Jeremy Dutcher\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"24.50 \\u2013 39.50\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/jeremy-dutcher/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2023-05-24T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Loreena McKennitt\",\"description\":\"&lt;p&gt;Loreena McKennitt is well known as a composer and singer. In a recording career spanning more than two decades, Ms. McKennitt\\u2019s \\u2018eclectic Celtic\\u2019 music has received critical acclaim world-wide, and gold, platinum and multi-platinum sales awards in 15 countries across four continents.&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/loreena_mckennitt_harp_fuji_creamypink_cropped__large.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/loreena-mckennitt/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2023-11-09T19:30:00-06:00\",\"endDate\":\"2023-11-09T22:30:00-06:00\",\"location\":{\"@type\":\"Place\",\"name\":\"Centennial Concert Hall\",\"description\":\"\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"555 Main Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3B 1C3\",\"addressCountry\":\"Canada\"},\"telephone\":\"\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Loreena McKennitt\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"60 \\u2013 120\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/loreena-mckennitt/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2023-04-03T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Ruby Waters with Tia Wood &#038; Slim Krusty\",\"description\":\"&lt;p&gt;Ruby Waters Her sound is similar to her journey \\u2013 eclectic, always evolving, and unfeigned. Hailing from the small town of Shelburne, Ontario and born to two artists, Ruby was immersed in a musician\\u2019s world at a young age. Now, an artist herself, she plugs in and belts out, unapologetically leaving you in awe. Ruby&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/3-scaled-e1728056055579.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/ruby-waters-with-tia-wood-slim-krusty/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2024-10-09T20:00:00-05:00\",\"endDate\":\"2024-10-09T20:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"Burton Cummings Theatre\",\"description\":\"&lt;p&gt;Wheelchair accessible main floor Wheelchair and companion seating is available with a 1 to 1 arrangement in loge 1 and loge 2. A Chair will be provided for the companion, who will be seated directly beside the wheelchair space. (8 spots available including companion seats, 4 on each side)* Seating is also available for visually/hearing&hellip;&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"364 Smith Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3B 2H2\",\"addressCountry\":\"Canada\"},\"telephone\":\"\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Ruby Waters\",\"description\":\"&lt;p&gt;Her sound is similar to her journey \\u2013 eclectic, always evolving, and unfeigned. Hailing from the small town of Shelburne, Ontario and born to two artists, Ruby was immersed in a musician\\u2019s world at a young age. Now, an artist herself, she plugs in and belts out, unapologetically leaving you in awe. Ruby recently released&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/Ruby-Waters-Website-scaled.jpeg\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"43.00\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/ruby-waters-with-tia-wood-slim-krusty/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2024-10-04T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Boy Golden with Wyatt C. Louis\",\"description\":\"&lt;p&gt;Boy Golden Boy Golden\\u2019s forthcoming album For Eden\\u00a0takes listeners on a journey through ten heartfelt stories inspired by his dreams and real-life experiences. Since his 2020 debut Church of Better Daze, he has explored both inward and outward, blending folk, bluegrass, Americana, and pop. His honest storytelling evokes deep emotions, offering a unique travel companion&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/Website-BG-e1728055981105.png\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/boy-golden-with-wyatt-c-louis/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2024-10-20T20:00:00-05:00\",\"endDate\":\"2024-10-20T20:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"Burton Cummings Theatre\",\"description\":\"&lt;p&gt;Wheelchair accessible main floor Wheelchair and companion seating is available with a 1 to 1 arrangement in loge 1 and loge 2. A Chair will be provided for the companion, who will be seated directly beside the wheelchair space. (8 spots available including companion seats, 4 on each side)* Seating is also available for visually/hearing&hellip;&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"364 Smith Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3B 2H2\",\"addressCountry\":\"Canada\"},\"telephone\":\"\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Boy Golden\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"32.50\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/boy-golden-with-wyatt-c-louis/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2024-10-04T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Hawksley Workman\",\"description\":\"&lt;p&gt;Hawksley Workman Hawksley Workman is a multi-talented singer-songwriter who has won a JUNO Award and has been certified Gold Record. His music career spans from his indie debut in 1999 to chart-topping singles in 2020. Hawksley\\u2019s work ranges from major-label international hits to indie releases deeply rooted in Canadiana. He has a collection of 17&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/Hawksley-Workman-by-Ivan-Otis-1-scaled-e1728056460905.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/hawksley-workman/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2024-10-21T20:00:00-05:00\",\"endDate\":\"2024-10-21T20:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"The Park Theatre\",\"description\":\"&lt;p&gt;Park Theatre Wheelchair accessible venue Wheelchair seating available (4 spots) Limited accessible seating available Seating is available for visually impaired patrons are available Accessible seats must be purchased through Ticketmaster over the phone at 1-855-682-6736 No hearing devices are available No assigned parking Visit\\u00a0myparktheatre.com&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"698 Osborne Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3L 2B9\",\"addressCountry\":\"Canada\"},\"telephone\":\"204-478-7275\",\"sameAs\":\"https://myparktheatre.com/\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Hawksley Workman\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"35.00\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/hawksley-workman/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2024-10-04T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Five Alarm Funk with The Funky Miracles\",\"description\":\"&lt;p&gt;Five Alarm Funk Five Alarm Funk is Canada\\\\'s premiere sonic and visual assault. With 20 years experience, in high voltage Funk infusion, FAF has carved a new path of live entertainment. The engagement, the hilarity, the precision and execution have heralded these manic Funk Bots with eight studio albums, two JUNO nominations, three Western Canadian&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/FAF-2024-e1728055938564.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/five-alarm-funk-with-the-funky-miracles/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2024-10-24T20:00:00-05:00\",\"endDate\":\"2024-10-24T20:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"The Park Theatre\",\"description\":\"&lt;p&gt;Park Theatre Wheelchair accessible venue Wheelchair seating available (4 spots) Limited accessible seating available Seating is available for visually impaired patrons are available Accessible seats must be purchased through Ticketmaster over the phone at 1-855-682-6736 No hearing devices are available No assigned parking Visit\\u00a0myparktheatre.com&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"698 Osborne Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3L 2B9\",\"addressCountry\":\"Canada\"},\"telephone\":\"204-478-7275\",\"sameAs\":\"https://myparktheatre.com/\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Five Alarm Funk\",\"description\":\"&lt;p&gt;Hot, sweaty dance floors with feet stomping and everybody moving. Grooves for days. Monster horns, crushing percussion and shredding psych-rock guitars. These are among the elements that make up the Five Alarm Funk experience. The Vancouver-based band is eight strong and over a decade deep into a career that has seen it release five acclaimed&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/FAF-Web-Event-1.jpg\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"37.50\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/five-alarm-funk-with-the-funky-miracles/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2024-10-04T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Danny Michel &#038; Steve Poltz\",\"description\":\"&lt;p&gt;You\\u2019re in for a mesmerizing blend of heartfelt storytelling, humour, and unmatched musicianship. These two natural entertainers bring their unique personalities and quick wit, turning every performance into an intimate, unforgettable experience. The atmosphere is equal parts cozy and electric\\u2014where anything can happen. Expect impromptu duets, hilarious tales, and soulful moments that leave you laughing,&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/399698817_10167895212215467_4921534648302790855_n-e1728056820859.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/danny-michel-steve-poltz/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2024-11-19T20:00:00-06:00\",\"endDate\":\"2024-11-19T20:00:00-06:00\",\"location\":{\"@type\":\"Place\",\"name\":\"West End Cultural Centre\",\"description\":\"&lt;p&gt;Building Accessibility The front entrance of our building is nearly at sidewalk level. There are no steps, however, there is a small incline at the door threshold of about 2 inches. In the entranceway, there is an elevator that can take people up to the lobby. The elevator is locked, but during events there is&hellip;&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"586 Ellice Ave\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3B 1Z8\",\"addressCountry\":\"Canada\"},\"telephone\":\"12042980396\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Danny Michel\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"35.00\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/danny-michel-steve-poltz/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2024-10-04T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Moontricks with Dirtwire &#038; Will Evans\",\"description\":\"&lt;p&gt;The 2024 Festival favourites are back! Prepare for an unforgettable night of music that pushes the boundaries of folk while honoring its traditional roots. This concert features the electrifying duo Moontricks, composed of Nathan Gurley and Sean Rodman. Hailing from Western Canada, Moontricks draws deep inspiration from the cycles of nature, creating a unique sound&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/Moontricks_08-21Promo_LouisBockner-8102328-scaled-e1728056200374.jpeg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/moontricks-with-dirtwire-will-evans/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2024-11-21T20:00:00-06:00\",\"endDate\":\"2024-11-21T20:00:00-06:00\",\"location\":{\"@type\":\"Place\",\"name\":\"Burton Cummings Theatre\",\"description\":\"&lt;p&gt;Wheelchair accessible main floor Wheelchair and companion seating is available with a 1 to 1 arrangement in loge 1 and loge 2. A Chair will be provided for the companion, who will be seated directly beside the wheelchair space. (8 spots available including companion seats, 4 on each side)* Seating is also available for visually/hearing&hellip;&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"364 Smith Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3B 2H2\",\"addressCountry\":\"Canada\"},\"telephone\":\"\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Moontricks\",\"description\":\"&lt;p&gt;Nestled deep in the beautiful Kootenay mountains of Western Canada lies the home of Moontricks, a duo whose timeless sound captures the essence of their rugged roots. Combining their love of folk, blues, and electronic music, Nathan Gurley and Sean Rodman are blazing their own trail, merging musical worlds previously unacquainted and capturing audiences along&hellip;&lt;/p&gt;\\\\n\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"39.50\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/moontricks-with-dirtwire-will-evans/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2024-10-04T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"JP Hoe Hoe Hoe &#8211; SOLD OUT\",\"description\":\"&lt;p&gt;It\\\\'s the most magical time of the year!\\u00a0Don\\u2019t miss your chance to grab tickets for the 19th annual JP Hoe Hoe Hoe Holiday Show, happening December 20, 2024, at the Burton Cummings Theatre! A beloved tradition, this festive event delivers an unforgettable night of music and holiday spirit. Tickets sell out fast, so act quickly&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/WFF-Website-Event.png\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/jp-hoe-hoe-hoe/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2024-12-20T20:00:00-06:00\",\"endDate\":\"2024-12-20T23:00:00-06:00\",\"location\":{\"@type\":\"Place\",\"name\":\"Burton Cummings Theatre\",\"description\":\"&lt;p&gt;Wheelchair accessible main floor Wheelchair and companion seating is available with a 1 to 1 arrangement in loge 1 and loge 2. A Chair will be provided for the companion, who will be seated directly beside the wheelchair space. (8 spots available including companion seats, 4 on each side)* Seating is also available for visually/hearing&hellip;&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"364 Smith Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3B 2H2\",\"addressCountry\":\"Canada\"},\"telephone\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"29.50 \\u2013 59.50\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/jp-hoe-hoe-hoe/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2024-10-16T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Cassidy Mann, Nic Dyson, and Slow Leaves\",\"description\":\"&lt;p&gt;Cassidy Mann Cassidy Mann is a singer-songwriter who transforms small moments into poetic songs that feel personal and relatable. Her debut EP, If It\\u2019s Not Forever, explores the emotions tied to early relationships, offering comfort through honest storytelling.\\u00a0With roots in Sagkeeng First Nation, her Indigenous heritage inspires her work, reflecting traditions of preserving culture through&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/2025-Corporate.png\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/folk-fest-in-the-city-workshops-cassidy-mann-nic-dyson-and-slow-leaves/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-01-18T14:00:00-06:00\",\"endDate\":\"2025-01-18T14:00:00-06:00\",\"location\":{\"@type\":\"Place\",\"name\":\"Charleswood Library\",\"description\":\"\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"4910 Roblin Boulevard\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"addressCountry\":\"Canada\"},\"telephone\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"0\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/folk-fest-in-the-city-workshops-cassidy-mann-nic-dyson-and-slow-leaves/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-01-07T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Mama&#8217;s Broke with Dominique Adams\",\"description\":\"&lt;p&gt;Back by popular demand, Mama\\\\'s Broke\\u2014a 2024 Folk Fest favourite\\u2014returns with their haunting harmonies and powerful, story-driven performances.\\u00a0Prepare for a dynamic experience: foot-stomping energy interwoven with moments of quiet reflection. This show will be an emotional journey that honours folk traditions while pushing musical boundaries in bold, unexpected ways. &nbsp; Mama\\\\'s Broke Mama\\\\'s Broke is&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/Mamas-Broke-e1729697900195.png\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/mamas-broke/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-02-09T20:00:00-06:00\",\"endDate\":\"2025-02-09T20:00:00-06:00\",\"location\":{\"@type\":\"Place\",\"name\":\"West End Cultural Centre\",\"description\":\"&lt;p&gt;Building Accessibility The front entrance of our building is nearly at sidewalk level. There are no steps, however, there is a small incline at the door threshold of about 2 inches. In the entranceway, there is an elevator that can take people up to the lobby. The elevator is locked, but during events there is&hellip;&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"586 Ellice Ave\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3B 1Z8\",\"addressCountry\":\"Canada\"},\"telephone\":\"12042980396\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Mama&#8217;s Broke\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"24.50 \\u2013 34.50\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/mamas-broke/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2024-10-22T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Sam Fournier, Jane Fuentez and Clementine\",\"description\":\"\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/2025-Corporate.png\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/tbd/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-02-22T14:00:00-06:00\",\"endDate\":\"2025-02-22T14:00:00-06:00\",\"location\":{\"@type\":\"Place\",\"name\":\"Millennium Library\",\"description\":\"\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"251 Donald Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3C 3P5\",\"addressCountry\":\"Canada\"},\"telephone\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"0\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/tbd/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-01-07T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Jeremie Albino with Benjamin Dakota Rogers\",\"description\":\"&lt;p&gt;Don\\\\'t miss this soulful, blues-infused experience, grounded in warmth and authenticity. Jeremy\\u2019s music draws deeply from folk, blues, and Americana, bringing a raw, honest energy to the stage. A show that will really bring the Folk Fest musical experience to the city. Jeremie Albino Jeremie Albino, a Toronto-born musician, blends country storytelling, R&amp;B rhythms, and&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/Jeremie-Albino-LEAD-Press-Photo-scaled-e1729697985655.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/jeremie-albino-with-benjamin-dakota-rogers/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-03-08T20:00:00-06:00\",\"endDate\":\"2025-03-08T20:00:00-06:00\",\"location\":{\"@type\":\"Place\",\"name\":\"The Park Theatre\",\"description\":\"&lt;p&gt;Park Theatre Wheelchair accessible venue Wheelchair seating available (4 spots) Limited accessible seating available Seating is available for visually impaired patrons are available Accessible seats must be purchased through Ticketmaster over the phone at 1-855-682-6736 No hearing devices are available No assigned parking Visit\\u00a0myparktheatre.com&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"698 Osborne Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3L 2B9\",\"addressCountry\":\"Canada\"},\"telephone\":\"204-478-7275\",\"sameAs\":\"https://myparktheatre.com/\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"32.50\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/jeremie-albino-with-benjamin-dakota-rogers/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2024-10-04T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Nathaniel Rateliff &#038; The Night Sweats with The Teskey Brothers\",\"description\":\"&lt;p&gt;Nathaniel Rateliff, a Denver-based vocalist and songwriter, blends folk, Americana, roots rock, and rhythm &amp; blues. Gaining critical acclaim for introspective folk albums, he found commercial success in 2015 with Nathaniel Rateliff &amp; the Night Sweats. Signed to Stax, the band released several albums, including The Future (2021) and South of Here (2024). Rateliff\\u2019s personal&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/NathanielRateliffTheNightSweats_PressPhoto_PhotoCredit_AlysseGafkjen-scaled-1-e1729699431394.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/nathaniel-rateliff-the-night-sweats/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-03-15T20:00:00-05:00\",\"endDate\":\"2025-03-15T20:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"Canada Life Centre\",\"description\":\"\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\"},\"telephone\":\"\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Nathaniel Rateliff &#038; The Night Sweats\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"49.50 \\u2013 89.50\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/nathaniel-rateliff-the-night-sweats/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2024-10-18T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Xander Boulard, Ben Notes, and skyblues\",\"description\":\"\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/2025-Corporate.png\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/xander-boulard-ben-notes-and-skyblues/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-03-22T13:00:00-05:00\",\"endDate\":\"2025-03-22T14:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"Millennium Library\",\"description\":\"\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"251 Donald Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3C 3P5\",\"addressCountry\":\"Canada\"},\"telephone\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"0\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/xander-boulard-ben-notes-and-skyblues/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-01-07T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Wild Rivers with Anna Graves\",\"description\":\"&lt;p&gt;Platinum-selling indie trio Wild Rivers, Khalid Yassein , Devan Glover , and Andrew Oliver , have a gift for penning introspective lyrics and genre-fluid melodies that transmit wisdom beyond their years. That expertise can be found across their new album, Better Now (out October 18)\\u2014a companion to their latest record, Never Better, released this past&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/WR-Vertical-Press-credit-Justin-Broadbent-scaled-e1732032734976.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/wild-rivers/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-04-19T20:00:00-05:00\",\"endDate\":\"2025-04-19T23:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"Burton Cummings Theatre\",\"description\":\"&lt;p&gt;Wheelchair accessible main floor Wheelchair and companion seating is available with a 1 to 1 arrangement in loge 1 and loge 2. A Chair will be provided for the companion, who will be seated directly beside the wheelchair space. (8 spots available including companion seats, 4 on each side)* Seating is also available for visually/hearing&hellip;&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"364 Smith Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3B 2H2\",\"addressCountry\":\"Canada\"},\"telephone\":\"\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Wild Rivers\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"30.00 \\u2013 45.00\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/wild-rivers/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2024-11-19T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Arlo Jones, Lily Bee Vanderhooft, and Melody Pearson Munroe\",\"description\":\"\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/2025-Corporate.png\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/tbd-3/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-04-26T13:00:00-05:00\",\"endDate\":\"2025-04-26T14:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"Bill and Helen Norrie Library\",\"description\":\"\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"15 Poseidon Bay\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3M 3E4\",\"addressCountry\":\"Canada\"},\"telephone\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"0\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/tbd-3/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-01-07T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Noah Reid with Madeleine Roger\",\"description\":\"&lt;p&gt;Acclaimed Canadian singer-songwriter Noah Reid has announced a 30+ date North American tour in support of his latest album, Adjustments. The tour begins September 11 in Chicago, IL, and wraps October 26 in Northampton, MA, with stops across the U.S. and Canada in iconic venues from coast to coast. Noah Reid has earned a permanent&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/Table-scaled.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/noah-reid/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-09-15T20:00:00-05:00\",\"endDate\":\"2025-09-15T20:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"Burton Cummings Theatre\",\"description\":\"&lt;p&gt;Wheelchair accessible main floor Wheelchair and companion seating is available with a 1 to 1 arrangement in loge 1 and loge 2. A Chair will be provided for the companion, who will be seated directly beside the wheelchair space. (8 spots available including companion seats, 4 on each side)* Seating is also available for visually/hearing&hellip;&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"364 Smith Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3B 2H2\",\"addressCountry\":\"Canada\"},\"telephone\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"30.00 \\u2013 45.00\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/noah-reid/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-05-12T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Jonathan Richman\",\"description\":\"&lt;p&gt;Show starts right at 8PM. \\u201cRichman is one of America\\u2019s most unique and dynamic songwriters\\u2026\\u201d \\u2013 Nashville Scene \\u201cRichman didn\\u2019t need much else besides a beat to work his magic.\\u201d \\u2013 New York Daily News \\u201cBuy tickets early. Buy tickets often. This is just good general life advice, but even more so when you\\u2019re talking&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/DrielyS-5409-Cropped.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/jonathan-richman-featuring-tommy-larkins-on-the-drums/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-10-11T20:00:00-05:00\",\"endDate\":\"2025-10-11T20:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"West End Cultural Centre\",\"description\":\"&lt;p&gt;Building Accessibility The front entrance of our building is nearly at sidewalk level. There are no steps, however, there is a small incline at the door threshold of about 2 inches. In the entranceway, there is an elevator that can take people up to the lobby. The elevator is locked, but during events there is&hellip;&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"586 Ellice Ave\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3B 1Z8\",\"addressCountry\":\"Canada\"},\"telephone\":\"12042980396\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"35.00 \\u2013 40.00\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/jonathan-richman-featuring-tommy-larkins-on-the-drums/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-06-26T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Leith Ross (SOLD OUT)\",\"description\":\"&lt;p&gt;Support A Songwriters Circle (artists who will join is yet to be announced) Hailing from a small town near Ottawa, Ontario, singer-songwriter Leith Ross (they / them)\\u00a0channels their honest and emotional storytelling through introspective lyrics and a blend of indie\\u00a0folk with alternative and rock sounds. In 2020, they first introduced their artistry and independently released&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/1_Credit-Adam-Kelly-scaled.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/leith-ross-3/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-10-17T20:00:00-05:00\",\"endDate\":\"2025-10-17T20:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"The Park Theatre\",\"description\":\"&lt;p&gt;Park Theatre Wheelchair accessible venue Wheelchair seating available (4 spots) Limited accessible seating available Seating is available for visually impaired patrons are available Accessible seats must be purchased through Ticketmaster over the phone at 1-855-682-6736 No hearing devices are available No assigned parking Visit\\u00a0myparktheatre.com&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"698 Osborne Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3L 2B9\",\"addressCountry\":\"Canada\"},\"telephone\":\"204-478-7275\",\"sameAs\":\"https://myparktheatre.com/\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"35.00\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/leith-ross-3/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-06-09T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Leith Ross (Second Show)\",\"description\":\"&lt;p&gt;With A Winnipeg Songwriting Circle&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/1_Credit-Adam-Kelly-scaled.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/leith-ross-second-show-added/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-10-18T20:00:00-05:00\",\"endDate\":\"2025-10-18T20:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"The Park Theatre\",\"description\":\"&lt;p&gt;Park Theatre Wheelchair accessible venue Wheelchair seating available (4 spots) Limited accessible seating available Seating is available for visually impaired patrons are available Accessible seats must be purchased through Ticketmaster over the phone at 1-855-682-6736 No hearing devices are available No assigned parking Visit\\u00a0myparktheatre.com&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"698 Osborne Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3L 2B9\",\"addressCountry\":\"Canada\"},\"telephone\":\"204-478-7275\",\"sameAs\":\"https://myparktheatre.com/\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"35.00\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/leith-ross-second-show-added/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-06-25T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"FONTINE, Kris Ulrich, and Taylor Jackson\",\"description\":\"&lt;p&gt;Join FONTINE, Kris Ulrich (host),\\u00a0and\\u00a0Taylor Jackson for a FREE Folk Fest workshop experience.&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/Library-Series-1.png\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/library-series-fontine-kris-ulrich-and-taylor-jackson/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-10-25T13:00:00-05:00\",\"endDate\":\"2025-10-25T14:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"Transcona Library\",\"description\":\"\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"1 Transcona Boulevard\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R2C 5R6\",\"addressCountry\":\"Canada\"},\"telephone\":\"(204) 986-3950\",\"sameAs\":\"https://www.winnipeg.ca/recreation-leisure/libraries/locations-and-hours/transcona-library\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"0\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/library-series-fontine-kris-ulrich-and-taylor-jackson/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-10-02T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Abrielle Turenne, Bush Lotus and Sam Fournier\",\"description\":\"\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/library-series-11-08-2025/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-11-08T13:00:00-06:00\",\"endDate\":\"2025-11-08T14:00:00-06:00\",\"location\":{\"@type\":\"Place\",\"name\":\"Louis Riel Library\",\"description\":\"\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"1168 Dakota Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R2N 3T8\",\"addressCountry\":\"Canada\"},\"telephone\":\"204-986-4573\",\"sameAs\":\"https://www.winnipeg.ca/recreation-leisure/libraries/locations-and-hours/louis-riel-library\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"0\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/library-series-11-08-2025/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-10-02T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Julian Taylor &#038; Logan Staats\",\"description\":\"\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/Julian-Logan-Web-copy.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/julian-taylor-logan-staats/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-11-20T20:00:00-06:00\",\"endDate\":\"2025-11-20T20:00:00-06:00\",\"location\":{\"@type\":\"Place\",\"name\":\"The Park Theatre\",\"description\":\"&lt;p&gt;Park Theatre Wheelchair accessible venue Wheelchair seating available (4 spots) Limited accessible seating available Seating is available for visually impaired patrons are available Accessible seats must be purchased through Ticketmaster over the phone at 1-855-682-6736 No hearing devices are available No assigned parking Visit\\u00a0myparktheatre.com&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"698 Osborne Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3L 2B9\",\"addressCountry\":\"Canada\"},\"telephone\":\"204-478-7275\",\"sameAs\":\"https://myparktheatre.com/\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"30.00 \\u2013 35.00\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/julian-taylor-logan-staats/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-07-30T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Foxwarren (SOLD OUT)\",\"description\":\"&lt;p&gt;No one in Foxwarren has ever made a record quite like 2. The Canadian quintet, built on 20 years of friendship, ostensibly plays folk music, where warm tones and cantering rhythms buoy songs of characters wrestling with existential quandaries inside of twilit vocals. But after touring their lauded 2018 self-titled debut, Foxwarren decided to do&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/Foxwarren_The2er_Full-1-e1759500070673.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/11-26-2025-foxwarren/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-11-26T20:00:00-06:00\",\"endDate\":\"2025-11-26T20:00:00-06:00\",\"location\":{\"@type\":\"Place\",\"name\":\"The Park Theatre\",\"description\":\"&lt;p&gt;Park Theatre Wheelchair accessible venue Wheelchair seating available (4 spots) Limited accessible seating available Seating is available for visually impaired patrons are available Accessible seats must be purchased through Ticketmaster over the phone at 1-855-682-6736 No hearing devices are available No assigned parking Visit\\u00a0myparktheatre.com&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"698 Osborne Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3L 2B9\",\"addressCountry\":\"Canada\"},\"telephone\":\"204-478-7275\",\"sameAs\":\"https://myparktheatre.com/\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Foxwarren\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"30.00\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/11-26-2025-foxwarren/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-04-22T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"The Strumbellas\",\"description\":\"&lt;p&gt;Formed in 2008, multi-award winning internationally renowned alternative rock band The Strumbellas have built their career on crafting exceptional songs, easily connecting with fans through their honest and relatable lyricism and versatile sound. The two-time JUNO Award winners have spent much of their time on the road, delivering standout performances at such notable festivals as&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/TheStrumbellas_Website-1-e1759499309563.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/the-strumbellas-2025/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-11-26T20:00:00-06:00\",\"endDate\":\"2025-11-26T20:00:00-06:00\",\"location\":{\"@type\":\"Place\",\"name\":\"Burton Cummings Theatre\",\"description\":\"&lt;p&gt;Wheelchair accessible main floor Wheelchair and companion seating is available with a 1 to 1 arrangement in loge 1 and loge 2. A Chair will be provided for the companion, who will be seated directly beside the wheelchair space. (8 spots available including companion seats, 4 on each side)* Seating is also available for visually/hearing&hellip;&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"364 Smith Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3B 2H2\",\"addressCountry\":\"Canada\"},\"telephone\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"30.00 \\u2013 45.00\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/the-strumbellas-2025/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-08-28T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Georgia Harmer\",\"description\":\"&lt;p&gt;Georgia Harmer is known for her ethereal voice and lyricism. She has emerged as one of Canada\\\\'s most compelling voices in indie music. Her songs display a vast emotional range and striking vulnerability. Harmer\\\\'s upcoming sophomore album, Eye of the Storm, will be released this summer and showcases an evolution in her songwriting. Her debut&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/E-News-Georgia-Harmer-1-e1759499742737.png\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/georgia-harmer/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-11-29T20:00:00-06:00\",\"endDate\":\"2025-11-29T20:00:00-06:00\",\"location\":{\"@type\":\"Place\",\"name\":\"The Park Theatre\",\"description\":\"&lt;p&gt;Park Theatre Wheelchair accessible venue Wheelchair seating available (4 spots) Limited accessible seating available Seating is available for visually impaired patrons are available Accessible seats must be purchased through Ticketmaster over the phone at 1-855-682-6736 No hearing devices are available No assigned parking Visit\\u00a0myparktheatre.com&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"698 Osborne Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3L 2B9\",\"addressCountry\":\"Canada\"},\"telephone\":\"204-478-7275\",\"sameAs\":\"https://myparktheatre.com/\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"25.00\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/georgia-harmer/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-06-04T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Ariel Posen\",\"description\":\"&lt;p&gt;Ariel Posen\\\\'s music occupies the space between genres. It\\\\'s a rootsy sound that nods to his influences \\u2014 heartland rock &amp; roll, electrified Americana, blue-eyed soul, R&amp;B, Beatles-inspired pop \\u2014 while still moving forward, pushing Posen into territory that\\\\'s uniquely his own. Along the way, Posen has received standing ovations not only from his audiences,&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/ArielPosen9of153-FB-EVENT-e1759499606384.png\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/ariel-posen/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-12-12T20:00:00-06:00\",\"endDate\":\"2025-12-12T20:00:00-06:00\",\"location\":{\"@type\":\"Place\",\"name\":\"The Park Theatre\",\"description\":\"&lt;p&gt;Park Theatre Wheelchair accessible venue Wheelchair seating available (4 spots) Limited accessible seating available Seating is available for visually impaired patrons are available Accessible seats must be purchased through Ticketmaster over the phone at 1-855-682-6736 No hearing devices are available No assigned parking Visit\\u00a0myparktheatre.com&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"698 Osborne Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3L 2B9\",\"addressCountry\":\"Canada\"},\"telephone\":\"204-478-7275\",\"sameAs\":\"https://myparktheatre.com/\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"30.00\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/ariel-posen/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-07-22T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"JP Hoe Hoe Hoe Holiday Show\",\"description\":\"&lt;p&gt;Spreading that holiday joy for the 20th time! Tickets go on sale Thursday, October 23 at 10:00 AM. Don\\u2019t miss your chance to grab tickets to the annual JP Hoe Hoe Hoe Holiday Show, happening December 19, 2025, at Burton Cummings Theatre! A beloved tradition, this festive event promises an unforgettable night of music and&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/JPH_burt_screen_hor2-scaled.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/jp-hoe-hoe-hoe-holiday-show/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-12-19T20:00:00-06:00\",\"endDate\":\"2025-12-19T20:00:00-06:00\",\"location\":{\"@type\":\"Place\",\"name\":\"Burton Cummings Theatre\",\"description\":\"&lt;p&gt;Wheelchair accessible main floor Wheelchair and companion seating is available with a 1 to 1 arrangement in loge 1 and loge 2. A Chair will be provided for the companion, who will be seated directly beside the wheelchair space. (8 spots available including companion seats, 4 on each side)* Seating is also available for visually/hearing&hellip;&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"364 Smith Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3B 2H2\",\"addressCountry\":\"Canada\"},\"telephone\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"29.50 \\u2013 64.50\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/jp-hoe-hoe-hoe-holiday-show/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-10-21T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Jake Vaadeland &#8211; SOLD OUT\",\"description\":\"&lt;p&gt;Jake Vaadeland\\u2019s Goodness Gracious, It\\u2019s Christmas! Returns for a Second Year! Following the success of last year\\u2019s debut holiday tour, Jake Vaadeland is back with a\\u00a0second Goodness Gracious, It\\u2019s Christmas! tour\\u2014bringing festive cheer, timeless music, and\\u00a0his signature style to theatres across Canada once again. The show will feature music from\\u00a0his upcoming Christmas EP, including favourites&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/Jake-Vaadeland-the-Sturgeon-River-Boys-_-photocredit_MortenFog-copy-1.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/jake-vaadelands-goodness-gracious-its-christmas/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-12-22T20:00:00-06:00\",\"endDate\":\"2025-12-22T20:00:00-06:00\",\"location\":{\"@type\":\"Place\",\"name\":\"The Park Theatre\",\"description\":\"&lt;p&gt;Park Theatre Wheelchair accessible venue Wheelchair seating available (4 spots) Limited accessible seating available Seating is available for visually impaired patrons are available Accessible seats must be purchased through Ticketmaster over the phone at 1-855-682-6736 No hearing devices are available No assigned parking Visit\\u00a0myparktheatre.com&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"698 Osborne Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3L 2B9\",\"addressCountry\":\"Canada\"},\"telephone\":\"204-478-7275\",\"sameAs\":\"https://myparktheatre.com/\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"35.00\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/jake-vaadelands-goodness-gracious-its-christmas/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-09-10T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Jo Miller, Keri Latimer, and Onna Lou\",\"description\":\"\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/library-series-02-07-2026/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-02-07T13:00:00-06:00\",\"endDate\":\"2026-02-07T14:00:00-06:00\",\"location\":{\"@type\":\"Place\",\"name\":\"Henderson Library\",\"description\":\"\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"1-1050 Henderson Highway\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R2K 2M5\",\"addressCountry\":\"Canada\"},\"telephone\":\"204-986-4314\",\"sameAs\":\"https://www.winnipeg.ca/recreation-leisure/libraries/locations-and-hours/henderson-library\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"0\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/library-series-02-07-2026/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-10-02T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Matt Andersen\",\"description\":\"&lt;p&gt;When Matt Andersen steps on stage, he brings a lifetime of music to every note\\u00a0he plays. His latest album, The Hammer &amp; The Rose, is a veritable garden of\\u00a0heart; a (mostly) delicate collection of tender folk and stirring soul numbers that\\u00a0find the New Brunswick-born songwriter thoughtfully tending to the most\\u00a0important things in life. Andersen\\u2019s stage&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/Matt-Andersen-WEB-scaled-e1759499386308.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/matt-andersen-with-mariel-buckley/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-02-23T20:00:00-06:00\",\"endDate\":\"2026-02-23T20:00:00-06:00\",\"location\":{\"@type\":\"Place\",\"name\":\"Burton Cummings Theatre\",\"description\":\"&lt;p&gt;Wheelchair accessible main floor Wheelchair and companion seating is available with a 1 to 1 arrangement in loge 1 and loge 2. A Chair will be provided for the companion, who will be seated directly beside the wheelchair space. (8 spots available including companion seats, 4 on each side)* Seating is also available for visually/hearing&hellip;&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"364 Smith Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3B 2H2\",\"addressCountry\":\"Canada\"},\"telephone\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"29.50 \\u2013 49.50\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/matt-andersen-with-mariel-buckley/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-10-01T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Jaxon Haldane, Arlo and Nick Hamm\",\"description\":\"\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/library-series-mar-14-2026/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-03-14T13:00:00-05:00\",\"endDate\":\"2026-03-14T14:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"Millennium Library\",\"description\":\"\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"251 Donald Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3C 3P5\",\"addressCountry\":\"Canada\"},\"telephone\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"0\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/library-series-mar-14-2026/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-10-02T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Matt Berninger\",\"description\":\"&lt;p&gt;In 2023, after ten years of living in Los Angeles, Berninger (along with his wife and teenage daughter) moved to Connecticut. This change of scene suited him; he began to spend his days outside, painting, reading, smoking weed and listening to music, much of it his own. He wrote lyrics all over old baseballs, and&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/LEAD-MATT-PRESS-anderson-WEB-1.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/matt-berninger/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-03-15T20:00:00-05:00\",\"endDate\":\"2026-03-15T23:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"Burton Cummings Theatre\",\"description\":\"&lt;p&gt;Wheelchair accessible main floor Wheelchair and companion seating is available with a 1 to 1 arrangement in loge 1 and loge 2. A Chair will be provided for the companion, who will be seated directly beside the wheelchair space. (8 spots available including companion seats, 4 on each side)* Seating is also available for visually/hearing&hellip;&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"364 Smith Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3B 2H2\",\"addressCountry\":\"Canada\"},\"telephone\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"67.35\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/matt-berninger/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-12-02T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"William Prince &#8211; SOLD OUT\",\"description\":\"&lt;p&gt;The distance traveled on William Prince\\u2019s new album, Further From the Country, is generational, aspirational, and metaphysical. Expansive and declarative, Further From the Country is the work of an artist who meets the challenge of putting incisive and enduring words to this age of uncertainty. William Prince\\u2019s perspective - a songwriter who carries great legacies&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/WP-WEB-1.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/william-prince/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-04-25T20:00:00-05:00\",\"endDate\":\"2026-04-25T20:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"Centennial Concert Hall\",\"description\":\"\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"555 Main Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3B 1C3\",\"addressCountry\":\"Canada\"},\"telephone\":\"\",\"sameAs\":\"\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Leith Ross \\u2013 SOLD OUT\",\"description\":\"&lt;p&gt;Hailing from a small town near Ottawa, Ontario, singer-songwriter Leith Ross (they / them)\\u00a0channels their honest and emotional storytelling through introspective lyrics and a blend of indie folk with alternative and rock sounds. In 2020, they first introduced their artistry and\\u00a0independently released their debut Motherwell EP. Recorded live, it received widespread praise\\u00a0from tastemakers and fans&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/1_Credit-Adam-Kelly-scaled.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/leith-ross-4/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-04-27T20:00:00-05:00\",\"endDate\":\"2026-04-27T23:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"Side Stage\",\"description\":\"\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"700 Osborne Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3L 2B9\",\"addressCountry\":\"Canada\"},\"telephone\":\"\",\"sameAs\":\"https://www.sidestagewpg.com/\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Leith Ross\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"40.00\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/leith-ross-4/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2026-02-05T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"An Evening with Whitehorse\",\"description\":\"&lt;p&gt;For the first time, Whitehorse hit the road as a true family band \\u2014 a full-circle moment where two decades of music-making now spans generations on stage. &nbsp; With their new album All I Want Is All of It, Whitehorse return to the sound that first defined them: folk-rock romanticism, raw storytelling, and the lived-in&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/Whitehorse-2026-Promo-copy.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/whitehorse/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-06-12T20:00:00-05:00\",\"endDate\":\"2026-06-12T23:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"The Park Theatre\",\"description\":\"&lt;p&gt;Park Theatre Wheelchair accessible venue Wheelchair seating available (4 spots) Limited accessible seating available Seating is available for visually impaired patrons are available Accessible seats must be purchased through Ticketmaster over the phone at 1-855-682-6736 No hearing devices are available No assigned parking Visit\\u00a0myparktheatre.com&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"698 Osborne Street\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3L 2B9\",\"addressCountry\":\"Canada\"},\"telephone\":\"204-478-7275\",\"sameAs\":\"https://myparktheatre.com/\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"48\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/whitehorse/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2026-03-10T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"The Cat Empire: Riebl Tedesco McGill\",\"description\":\"&lt;p&gt;Making their Canadian debut, Riebl Tedesco McGill bring together three of Australia\\u2019s most accomplished and genre-defying musicians for a rare and intimate live experience. Uniting the distinct voices of Felix Riebl, Richard Tedesco, and Ollie McGill, this collaborative trio blends songwriting, virtuoso musicianship, and deep musical storytelling into something truly unique. From the fiery, intricate&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/Horizontal-TRIO-scaled.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/the-cat-empire-riebl-tedesco-mcgill/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-06-18T20:00:00-05:00\",\"endDate\":\"2026-06-18T23:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"West End Cultural Centre\",\"description\":\"&lt;p&gt;Building Accessibility The front entrance of our building is nearly at sidewalk level. There are no steps, however, there is a small incline at the door threshold of about 2 inches. In the entranceway, there is an elevator that can take people up to the lobby. The elevator is locked, but during events there is&hellip;&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"586 Ellice Ave\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3B 1Z8\",\"addressCountry\":\"Canada\"},\"telephone\":\"12042980396\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"40.00 \\u2013 45.00\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/the-cat-empire-riebl-tedesco-mcgill/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2026-04-01T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Willows &#038; Tinge\",\"description\":\"&lt;p&gt;Willows is coming to Winnipeg for a free concert on Friday, June 26, co-presented by the s\\u0101kihiw\\u0113 festival, the Winnipeg Folk Festival, and The Forks! She\\u2019ll be trading songs with Tinge under the canopy at The Forks for the full 90 minutes. Indigenous Coffeehouse Live Willows &amp; Tinge Presented by the s\\u0101kihiw\\u0113 festival, the Winnipeg&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/Untitled-1.png\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/willows-tinge/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-06-26T19:00:00-05:00\",\"endDate\":\"2026-06-26T20:30:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"The Forks\",\"description\":\"\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"1 Forks Market Road\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3C4L9\",\"addressCountry\":\"Canada\"},\"telephone\":\"\",\"sameAs\":\"https://www.theforks.com/\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"0\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/willows-tinge/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2026-05-07T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Richard Inman\",\"description\":\"&lt;p&gt;He\\u2019s got a new record! Hear it here first!\\u00a0Road-weary, dusty and worn down from thousands of miles, hundreds of shows a year, from Canada to Denmark, Germany and back, Richard Inman is an authentic story telling troubadour. Playing for thousands at festivals or dozens in a smoke filled back road bar in rural Saskatchewan, Inman\\\\'s&hellip;&lt;/p&gt;\\\\n\",\"image\":\"https://www.winnipegfolkfestival.ca/wp-content/uploads/DSC_00023-copy.jpg\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/richard-inman/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-08-14T20:00:00-05:00\",\"endDate\":\"2026-08-14T23:00:00-05:00\",\"location\":{\"@type\":\"Place\",\"name\":\"West End Cultural Centre\",\"description\":\"&lt;p&gt;Building Accessibility The front entrance of our building is nearly at sidewalk level. There are no steps, however, there is a small incline at the door threshold of about 2 inches. In the entranceway, there is an elevator that can take people up to the lobby. The elevator is locked, but during events there is&hellip;&lt;/p&gt;\\\\n\",\"url\":\"\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"586 Ellice Ave\",\"addressLocality\":\"Winnipeg\",\"addressRegion\":\"Manitoba\",\"postalCode\":\"R3B 1Z8\",\"addressCountry\":\"Canada\"},\"telephone\":\"12042980396\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"20.00\",\"priceCurrency\":\"CAD\",\"url\":\"https://www.winnipegfolkfestival.ca/concert/richard-inman/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2026-06-25T00:00:00+00:00\"},\"performer\":\"Organization\"}]\n\n\t\t\n\t{\"