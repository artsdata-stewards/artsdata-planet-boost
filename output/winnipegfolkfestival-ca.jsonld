  {
    "@id": "http://www.winnipegfolkfestival.ca/genid/e0988567603d9093",
    "@type": [
      "https://schema.org/WebPage"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.winnipegfolkfestival.ca/concert/02-07-2023-hayden/"
