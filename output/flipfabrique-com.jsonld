      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@value": "Sur scène, six mystérieuses invitations, maisseulement cinq invités. Que faire pour passer le temps ? Préparez-vous à de l’épatante comédie acrobatique et des prouesses à couper le souffle avec l’artiste renommé Jamie Adkins et la troupe de cirque acclamée FLIP Fabrique."
      }
    ],
