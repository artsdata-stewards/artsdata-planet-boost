    "http://ogp.me/ns#title": [
      {
        "@value": "SUMMER BREAK - Flip Fabrique"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@value": "Do you remember packing for summer camp  for the first time alone? Of this thirst for independence? Of the bus route away from your parents? Do you remember your embarrassment when meeting those who were going to share your dormitory? Of these new friends that you made but have never seen again? Do you remember […]"
      }
