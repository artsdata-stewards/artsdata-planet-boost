    "http://ogp.me/ns#title": [
      {
        "@value": "Féérie des fêtes au quartier Petit Champlain - Flip Fabrique"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@value": "La magie du cirque s’empare du quartier Petit Champlain pour le temps des fêtes. Les artistes de FLIP Fabrique offrent des prestations surprises aux promeneurs de ce quartier historique emblématique de la ville de Québec. En plus du charme de ses maisons de pierres enneigées, le quartier est entièrement décoré pour l’occasion, pour une promenade […]"
      }
    ],
    "http://ogp.me/ns#url": [
