      {
        "@language": "en",
        "@value": "AREA 33 by Natalie Meisner | Osprey Arts Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "This award-winning play by Shelburne County native, Natalie Meisner gets its world premiere with a five day, six performance run at your Osprey Arts Centre. This comedy is set against the backdrop of the lobster fishing industry in and around Barrington and the Shag Harbour Incident museum."
      }
