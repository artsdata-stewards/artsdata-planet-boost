  {
    "@id": "https://www.ospreyartscentre.ca/events-1/shirley-jackson-her-good-rockin-daddys",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Shirley Jackson & Her Good Rockin' Daddys | Osprey Arts Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "With Shirley Jackson & Her Good Rockin' Daddys, you get a six piece East Coast horns-powered sound inspired by the early years of Big Band Music. Come for the blues. Stay for the swing. Either way, you'll have a rockin' good time."
      }
    ],
