  {
    "@id": "https://www.ospreyartscentre.ca/events-1/bluebirds-a-play-by-vern-thiessen",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "BLUEBIRDS - A Play by Vern Thiessen | Osprey Arts Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "A fitting prelude to Remembrance Day, \"Bluebirds,\" by award-winning playwright, Vern Thiessen details the trials and tribulations of three nurses caring for wounded Canadian soldiers in WWI. Don't miss this stunning live performance which played to sold out audiences in its New Brunswick premiere."
      }
    ],
