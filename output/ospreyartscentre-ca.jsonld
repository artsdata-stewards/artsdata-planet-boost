  {
    "@id": "https://www.ospreyartscentre.ca/events-1/area-33-by-natalie-meisner-2025-07-27-19-30-1",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "AREA 33 by Natalie Meisner | Osprey Arts Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "This award-winning play by Shelburne County native, Natalie Meisner gets its world premiere with a five day, six performance run at your Osprey Arts Centre. Set against the backdrop of the lobster fishing industry in and around Barrington, NS, Area 33 is a comedy about serious stuff."
      }
    ],
