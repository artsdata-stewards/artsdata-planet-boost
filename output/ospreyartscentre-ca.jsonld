    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Ziya Tabassian "
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "From Musique Royale, the people responsible for Best of Boxwood, comes Ziya Tabassian and his band with a rare offering of music rooted in Persian culture, featuring the drum-like tombak and melding classical Western percussion with Tabassian's Eastern roots to create a singular sound all its own."
      }
    ],
    "http://schema.org/eventStatus": [
