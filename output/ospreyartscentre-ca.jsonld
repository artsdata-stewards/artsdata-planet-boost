    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "SUBhuman, A Staged Reading (NEW DATE) | Osprey Arts Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "A staged reading with professional actors of a play by award-winning playwright, Natalie Meisner. $15, General Admission, Tickets at the door on the night of performance. Ticket sales go to support ongoing OAC theatre programming."
      }
    ],
    "http://ogp.me/ns#image": [
