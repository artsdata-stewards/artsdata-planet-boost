    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Enjoy a night of traditional bluegrass with a touch of country and gospel as the boys of Common Ground combine high energy virtuosity on the strings with gorgeous 3-part harmonies to create pure bluegrass bliss. Special guest host, ECBMA Emcee, Kyle Warren Smith. Tickets on sale soon."
