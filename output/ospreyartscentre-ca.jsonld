  {
    "@id": "https://www.ospreyartscentre.ca/events-1/ukulele-camp-gala-concert",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Ukulele Camp Gala Concert | Osprey Arts Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "As a finale to the Dock Street Uke Camp, this concert features on stage, alone and together, ukulele masters, Bryan Laplante, Nigel D'eon, and Manitoba Hal Brolund. You'll be surprised at how, in the right hands, such a little instrument can produce such a big, complex and beautiful sound."
      }
    ],
