  {
    "@id": "https://www.ospreyartscentre.ca/events-1/rocky-horror-picture-show-and-halloween-dance-party",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Rocky Horror Picture Show and Halloween Dance Party | Osprey Arts Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Come in costume or not to enjoy the freakishly fun cult classic, Rocky Horror and stay for the Halloween Dance Party to follow. Cabaret seating makes it all the more of a party and a costume party may just bring out the ghoul in you. See you at the theatre. It's just a jump to the left!"
      }
    ],
