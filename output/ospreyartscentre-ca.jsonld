  {
    "@id": "https://www.ospreyartscentre.ca/events-1/i-hate-shakespeare/form",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "I Hate Shakespeare | Osprey Arts Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "I hate Shakespeare. You hate Shakespeare. Let’s face it, we pretty much ALL hate Shakespeare! Well not after you see what Shelburne’s NEW community theatre troupe does to the old bard. Get ready for a hilarious and rip-roaring rundown of Will’s classics with zombies, talking cows, and much more."
      }
    ],
