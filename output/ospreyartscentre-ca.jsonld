  {
    "@id": "https://www.ospreyartscentre.ca/events-1/remembrance-day-reception",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Remembrance Day Reception | Osprey Arts Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Your Osprey is pleased to host a Remembrance Day Reception following the ceremony at the cenotaph. OPEN TO THE PUBLIC. Refreshments will be provided with live music courtesy of Shelly MacIntosh, and Lisa and Alex Buchanan. Join us to honour all those who've served and their families. Lest we forget."
      }
