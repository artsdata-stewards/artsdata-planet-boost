    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Ray Bonneville | Osprey Arts Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "We are proud to bring renowned bluesman, Ray Bonneville, to the Osprey stage. Ray’s New Orleans-inspired blues originals have led him to open for such acts as B.B. King, Muddy Waters, Robert Cray, and Dr. John.  Ray will be joined by veteran session man, Geoff Arsenault."
      }
