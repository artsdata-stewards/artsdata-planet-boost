  {
    "@id": "https://www.ospreyartscentre.ca/events-1/new-years-eve-dinner-dance",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "NEW YEAR'S EVE: DINNER & DANCE | Osprey Arts Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Come dance the night away with One Meter Up, a 4-piece high energy, rock & roll dance band from Shelburne, NS. Playing music from the 70s, 80s & 90s, the band members are Danny Atwell (vocals and guitar), Anthony Gosbee (guitar), Bruce Bennett (bass) and Rick Snow (drums)."
      }
    ],
    "http://ogp.me/ns#image": [
