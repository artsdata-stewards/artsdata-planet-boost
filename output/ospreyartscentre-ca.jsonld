    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "No need for tickets when your Osprey Arts Centre  becomes Santa's Village for a day. Parents can shop unique artisanal wares while their kids can have a chat with the big man himself, getting their pictures taken with Jolly St. Nick (just to prove he really does exist)."
