        "@value": "Community Theatre Variety Show"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Shelburne's soon-to-be-named (they promise) Community Theatre Troupe presents an evening of fun and fellowship with members performing a variety of comic bits, sketches, musical numbers, staged readings, monologues and more. $15.  General Admission, Tickets at the Door."
      }
