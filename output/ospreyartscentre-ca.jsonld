    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Adria Jackson is a Canadian born singer/harpist with Celtic and Scandinavian roots. Having performed as part of the Osprey's Ancient River Festival in  2023, this amazing classically trained soprano returns with her harp for an evening on the Osprey stage! Tickets: $20 adults, $10 students"
