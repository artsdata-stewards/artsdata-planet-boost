    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Due to an illness in the band, this show has been postponed to Saturday, September 27. Tickets will be automatically transferred to that date. If that date doesn't work for you, expect an email from Ticketpro with instructions on requesting a refund. We apologize for this inconvenience."
