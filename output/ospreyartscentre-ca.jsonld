    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "NEW YEAR'S EVE: DINNER &amp; DANCE"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Come dance the night away with One Meter Up, a 4-piece high energy, rock &amp; roll dance band from Shelburne, NS. Playing music from the 70s, 80s &amp; 90s, the band members are Danny Atwell (vocals and guitar), Anthony Gosbee (guitar), Bruce Bennett (bass) and Rick Snow (drums)."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
  {
    "@id": "https://www.ospreyartscentre.ca/events-1/ns-hip-hop-showcase",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "NS Hip-Hop Showcase | Osprey Arts Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "The Osprey Arts Centre presents rising artists on the Canadian hip-hop scene, Megz, ilogicc,  and Paollo13, along with veteran rapper, Ben Nickerson and with DJ Hotcue on the ones and twos.  Looking for a Hip-Hop fix? We've got you covered. Come out and show these talented artists the love."
      }
