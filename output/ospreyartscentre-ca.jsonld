    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Charlie A'Court and Band | Osprey Arts Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "The Osprey Arts Centre presents Charlie A’Court in a four piece band playing the best of Charlie’s extensive catalogue. As a five-time East Coast Music Award winner and eight-time Nova Scotia Music Award winner, A'Court has earned awards for Blues, Pop, and R&B/Soul Recordings of the Year."
      }
