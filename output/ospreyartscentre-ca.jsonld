    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Sweet Kids Dance Company Winter Recital"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Join us for Sweet Kids Dance Company's very first recital as we celebrate the hard work and enthusiasm of our young dancers! Our first session of performers, ages 2 to 10, will take the stage to showcase their talent, growth, and love for dance. Tickets must be purchased in advance."
      }
    ],
