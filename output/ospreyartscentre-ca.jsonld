    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "\"CAROUSEL\" - Maritime Concert Opera | Osprey Arts Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Carousel, by Richard Rodgers (music) and Oscar Hammerstein II (book and lyrics) includes such well-known songs \"If I Loved You\", \"June Is Bustin' Out All Over\" and \"You'll Never Walk Alone\". Maritime Concert Opera is a regional opera company based in Lunenburg, NS."
