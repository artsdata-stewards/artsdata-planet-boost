  {
    "@id": "https://www.ospreyartscentre.ca/events-1/campbell-johnston/form",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Campbell & Johnston | Osprey Arts Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "The Osprey welcomes award winning power-duo, Campbell & Johnston and their soulful blend of vintage blues-rock, roots & folk with a modern twist. Trading off lead vocals, harmonies and guitar solos, the chemistry is palpable and the musicianship top notch. See you at the theatre."
      }
    ],
