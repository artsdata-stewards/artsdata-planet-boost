        "@language": "en",
        "@value": "The Marriage of Figaro  | Osprey Arts Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Perennial favourite Maritime Concert Opera returns to your Osprey with Mozart's \"The Marriage of Figaro.\" A stellar cast of ten is directed by Nina Scott-Stoddardt in this choral rendition of one of the most famous operas of all time. You won't want to miss it. Reserved Seating."
      }
