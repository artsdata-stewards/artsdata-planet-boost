      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Jessica Rhaye & the Ramshackle Parade have graced many stages including the National Arts Centre, Hughs Room Live while being nominated for Music NB Live Act of the Year and Fans Choice in 2020 and ECMA nomination for Group Recording of the Year in 2021.\nTickets: $30/adults, $15/students"
