      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Elage Diouf, Senegalese born singer-songwriter and master percussionist, skillfully merges the rhythms of his native Senegal with musical influences from all over the world. His African-infused pop and his five piece band will deliver a night to remember."
