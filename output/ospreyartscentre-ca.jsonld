    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Due to the wildfire in Shelburne County, Scott MacKay's performance scheduled for June 10th will be postponed to a later date. To anyone who purchased tickets, you will be contacted soon with more information. Keep an eye out for a new date for this performance. Thank you 💙"
