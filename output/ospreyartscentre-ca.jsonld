    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Joe H. Henry (Trio) | Osprey Arts Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "With a voice as powerful as a wayward freight train, singer-songwriter Joe H Henry bellows the flames of gritty roots with a whole lot of soul. The son of award-winning Canadian country musician Harvey Henry, Joe was born to sing. Tickets on sale soon. Check back here."
      }
    ],
