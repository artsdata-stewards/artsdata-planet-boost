    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Michael will put on the coffee (or tea/hot chocolate).  Bring a snack if you\\'d like, to share. Come for the companionship, thought provoking, lively and humorous conversation.  Get out of the house. Meet your neighbours.  Refreshments by donation.&lt;/p&gt;\\n"
      }
