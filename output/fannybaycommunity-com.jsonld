    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "FBCA Concert Series: Keith Alessi: Tomatoes tried to kill me but banjos saved my life"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Concert Series: Keith Alessi Doors open at 6:30. Advance tickets are available at the following retailers: $35 Cash Weinberg’s Good Food, Buckley Bay Laughing Oyster Books, Courtenay Salish Sea Market, Bowser Online or at door: $38fannybayhall.tickit.ca&lt;/p&gt;\\n"
      }
    ],
