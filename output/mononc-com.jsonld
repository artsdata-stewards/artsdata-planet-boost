  {
    "@id": "https://mononc.com/event/6498839/756398254/mononc-serge-anonymus-a-st-gabriel-de-brandon",
    "http://opengraphprotocol.org/schema/title": [
      {
        "@language": "fr",
        "@value": "Mononc' Serge & Anonymus à St-Gabriel-de-Brandon @ Bal Maski - le 31 oct. 2026 à 20h00"
      }
    ],
    "http://opengraphprotocol.org/schema/description": [
      {
        "@language": "fr",
        "@value": "🪚 3e MASSACRE AU MASKINONGÉ ENSANGLANTÉ 🐟🩸 🚧 Pour clôturer le 3e MME, le Bal Maski de Sang-Gabriel-de-l'Abandon reçoit Mononc' Serge & Anonymus pour une rare version en petite salle de leur tournée Métal canadien-français ! 🎟 Billets à 36,66 $ taxes et frais inclus (nbre très très limité) : https://lepointdevente.com/billets/mononc-anonymus-mme *Des billets «flottants» sont aussi disponibles, si le besoin s'en fait sentir. 🎃 C’est l’Halloween! Mettez vos plus beaux ou plus laids habits métal canadien-français!!! 🚪 Portes 18:00 🎸 Prestation 20:00 📀 Dj set 22:00"
      }
    ],
