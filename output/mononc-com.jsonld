  {
    "@id": "https://mononc.com/event/6437446/751808401/mononc-serge-solo-a-coatirock",
    "http://opengraphprotocol.org/schema/title": [
      {
        "@language": "fr",
        "@value": "Mononc' Serge solo à Coatirock @ Pavillon des arts et de la culture de Coaticook - le 18 avr. 2026"
      }
    ],
    "http://opengraphprotocol.org/schema/description": [
      {
        "@language": "fr",
        "@value": "De midi à minuit, 13 groupes défileront sur la scène du Pavillon des arts avec un seul objectif en tête : rocker toute la ville de Coaticook! Présenté par le Pavillon des arts et porté par Maxime Fortin du groupe Daft 222, ce nouveau festival souhaite mettre en lumière le meilleur de la musique rock de la région de Coaticook et de l’Estrie, en plus de faire venir les noms qui ont marqué le rock au Québec. Prépare-toi pour douze heures de rock, sans arrêt!"
      }
    ],
    "http://opengraphprotocol.org/schema/image": [
      {
        "@language": "fr",
        "@value": "https://images.zoogletools.com/s:bzglfiles/u/225098/6397ac13e2154cd2e927533c833be76d722f8bb1/original/capture-d-e-cran-le-2026-02-02-a-10-51-25.png/!!/meta%3AeyJzcmNCdWNrZXQiOiJiemdsZmlsZXMifQ%3D%3D.png"
      }
