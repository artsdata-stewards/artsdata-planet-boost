      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Entre QRBP, Pépé et sa guitare, le bruit d’un moteur de chaloupe et le son d’un feu qui crépite, la musique de Tom Folly, musicien autodidacte, raconte et poétise les histoires de pêche et les brosses jusqu’aux petites heures. Accompagné de son banjo, du guitariste et percussionniste Charles Boivin…"
      }
    ],
