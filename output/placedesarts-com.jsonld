    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le dynamisme et l’excellence de L'Orchestre symphonique de McGill seront au rendez-vous à la Maison symphonique! Le Maestro Alexis Hauser terminera sa 20 e saison en dirigeant l'exceptionnel orchestre d'étudiant·e·s dans un programme enlevant de Beethoven et Mahler.  Le professeur Axel Strauss se…"
      }
