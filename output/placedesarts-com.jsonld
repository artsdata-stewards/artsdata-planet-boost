        "@id": "https://www.placedesarts.com/evenement/cantiques-de-lamour"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Plongez dans l’univers de <i>Cantiques de l’amour</i>, une fresque musicale dont l’origine est une rencontre improbable : l’envoûtant chanteur Khaled Al-Hafez, porteur de la mémoire du Levant, la contralto magicienne Gabrielle Cloutier, dont la voix façonne les paysages intérieurs et le souffle choral de l’Ensemble Vox, gardien des harmonies sacrées.</p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Cantiques de l'amour"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@language": "fr",
        "@value": "Festival du Monde Arabe"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Gabrielle Cloutier, Khaled Al-Hafez, Ensemble Vox"
      }
