    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p><i>La redoutable symphonie d’El Kapoutchi</i>, un spectacle humoristique inspiré du célèbre antihéros créé par Alexandre Courteau pour les petites oreilles de 5 à 9 ans, mais qui sait aussi satisfaire les plus grandes.</p>"
      }
