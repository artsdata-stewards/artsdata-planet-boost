    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Qu’est-ce qu’un bon «allié» pour la cause autochtone? | Salon urbain"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "La cause autochtone utilise les mots « allié, complice et co-résistant » pour distinguer le niveau d’engagement des allochtones dans les différentes luttes. L’actualité regorge de nouveaux faits qui bousculent nos a priori. Comment démêler le tout et se faire une tête? Quels conseils nous donnent…"
      }
    ],
