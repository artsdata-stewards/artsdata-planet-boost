    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Mettant en vedette Maude Cyr-Deschênes, Olivier Dion, Matthieu Lévesque, Nathalie Simard, Océane Kitura Bohémier-Tootoo et Laurent Lucas, <i>Evangéline </i>est une fresque historique musicale empreinte de modernisme. Une vision cinématographique d'une épopée qui prend racine en terre autochtone, en Nouvelle-Écosse.</p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Évangéline – Le spectacle musical"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@language": "fr",
        "@value": "Gestev"
      }
    ],
    "http://schema.org/performer": [
