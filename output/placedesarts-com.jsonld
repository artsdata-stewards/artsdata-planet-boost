    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | LUNA | Théâtre Maisonneuve"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Quatre chorégraphes s'inspirent de l’effet de la Lune sur la Terre pour illustrer notre monde : les jeux d’influence, la coexistence des peuples, nos différences et notre évolution synchrone à la fois.   LUNA se veut un regard sur l’humain et sur ce qui nous lie inévitablement, sur l’énergie et la…"
      }
    ]
  },
