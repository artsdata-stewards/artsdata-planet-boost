    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Vertiges en solos | Des airs de Noël | Salle Claude-Léveillée"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Pour la première fois depuis 1997, les artistes de Vertiges célèbrent Noël à travers un ensemble de chansons qui mettent leurs personnalités de l’avant.  Quoi de mieux qu’un répertoire pop de Noël pour amorcer le temps des Fêtes? Au cours du spectacle en deux parties, célébrez la magie de Noël en…"
      }
    ],
