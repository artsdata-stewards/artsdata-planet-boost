        "@value": "<p>Chaque année, durant les Fêtes, le public montréalais se réunit pour <i>Casse-Noisette</i>, chorégraphié par le Québécois Fernand Nault sur la brillante partition de Piotr Tchaïkovski.</p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Casse-Noisette"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@language": "fr",
        "@value": "Les Grands Ballets"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Fernand Nault, Les Grands Ballets, Orchestre des Grands Ballets"
      }
