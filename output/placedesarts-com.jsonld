      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Dans mon baluchon | Salle Claude-Léveillée"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Conte musical et fantaisiste qui aborde avec douceur et humour les thèmes de la solitude, de l'imaginaire et de la différence. On a tous en soi les outils nécessaires pour ne jamais s'ennuyer. Prépare ton baluchon. On part en voyage sur la lune. "
      }
    ],
