    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Après avoir terminé sa tournée mondiale Careless Love , l'auteure-compositrice-interprète de jazz Madeleine Peyroux  reprend la route, cette fois-ci accompagnée de l’artiste de renom Martha Wainwright .  Le spectacle comprendra des interprétations des morceaux favoris du répertoire de Peyroux,…"
      }
