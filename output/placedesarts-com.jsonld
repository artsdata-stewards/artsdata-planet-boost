    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>The Headhunters, le légendaire ensemble jazz-funk codirigé par le percussionniste Bill Summers et le batteur Mike Clark, avec Donald Harrison, maître du jazz de la NEA, de passage au Festival International de Jazz de Montréal à l'été 2026.</p>"
      }
