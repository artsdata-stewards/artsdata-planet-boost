    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Le Petit Prince | Maison symphonique"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "« On ne voit bien qu’avec le cœur. »  Les mots du Petit Prince résonnent encore plus fortement lorsque le récit est porté par la superbe musique d’Éric Champagne.  De sa planète à la nôtre, on suit les aventures du célèbre garçonnet et ses rencontres avec le businessman, l’allumeur de réverbères,…"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
