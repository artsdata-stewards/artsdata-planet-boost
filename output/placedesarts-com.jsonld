    "http://schema.org/url": [
      {
        "@id": "https://www.placedesarts.com/evenement/john-pizzarelli"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Reconnu comme l'un des meilleurs interprètes contemporains du Great American Songbook, John Pizzarelli a élargi son répertoire en y incluant la musique de Paul McCartney, Joni Mitchell, Neil Young, Tom Waits, Antônio Carlos Jobim et les Beatles. Le guitariste et chanteur a également été salué par le Boston Globe pour avoir « redonné vie au Great American Songbook et remis le jazz au goût du jour ».</p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "John Pizzarelli sings Tony Bennett"
      }
    ],
    "http://schema.org/organizer": [
