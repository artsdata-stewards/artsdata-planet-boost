    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Gregory Alan Isakov, horticulteur et musicien né à Johannesburg et établi au Colorado, s’est imposé dans les univers indie-rock et folk avec six albums acclamés, dont <i>Evening Machines</i>, nommé aux Grammy Awards, et son plus récent, <i>Appaloosa Bones</i>. </p>"
      }
    ],
