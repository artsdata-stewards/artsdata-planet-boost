    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Hommage à Ginette Reno rassemble sur scène l’orchestre La Sinfonia de Lanaudière et ses 30 musiciens, dirigé par le Maestro Stéphane Laforest, ainsi que quatre grandes voix du Québec : Kim Richardson , Mélissa Bédard , Marie-Denise Pelletier et Stéphanie Bédard . Ensemble, ils rendront hommage à la…"
      }
    ],
