      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Blending classical finesse with raw emotional depth, Canadian-Algerian soprano Fairouz Oudjida illuminates ancestral traditions, breathing new intensity into a treasured heritage of song. Her powerful voice traces the breathtaking ornamentations of Andalusian music like so many restored jewels, weaving together the nûbas of the Maghreb and the mouwachahat of the Levant in timeless harmony.</p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Légendaire Andalousie"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@language": "en",
        "@value": "Festival du Monde Arabe"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": "Fairouz Oudjida"
      }
    ],
