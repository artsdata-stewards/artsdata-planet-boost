    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Louis-José Houde - Mille mauvais choix | Théâtre Maisonneuve"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Un récit personnel; petit traité sur les déceptions, les égarements et les choix, campé au cœur de la vie atypique d’un privilégié. Ce que l’on croyait devenir et ce que l’on devient. Sur fond de littérature, de judaïsme et d’hommage au rock progressif. Plus facile à faire qu’à décrire."
      }
    ],
