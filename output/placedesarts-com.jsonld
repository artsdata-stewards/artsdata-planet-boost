      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Plongez dans l’univers unique de Pierre Verville avec <i>Pour une dernière voix</i>, un spectacle solo mêlant humour et imitations, et oscillant entre fiction et réalité. Car Pierre, dans ses magnifiques délires insomniaques, s’imagine sur scène en animateur de radio qui raconte sa propre vie, alors que son auditoire est là, dans la salle, juste devant lui…</p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Pierre Verville | Pour une dernière voix"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@language": "fr",
        "@value": "Productions Martin Leclerc"
      }
    ],
