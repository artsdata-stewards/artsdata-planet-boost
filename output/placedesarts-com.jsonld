    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Entre les époques et les styles, c’est à un périple au travers l’histoire de son instrument que nous convie le pianiste Inon Barnatan, de retour au Festival après quinze ans d’absence. De la danse baroque au grand cycle de variations, en passant par la musique d’aujourd’hui et le kaléidoscope de…"
      }
    ],
