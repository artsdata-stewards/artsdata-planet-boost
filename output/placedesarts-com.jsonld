    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Mahler et le chant de la nuit | Amphithéâtre Fernand-Lindsay"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Gustav Mahler et sa Septième , c’est un cosmos entier qui tient dans le creux de la main, celui du monde viennois et d’une certaine idée de la culture : de l’apothéose du classicisme à la modernité énigmatique du premier vingtième siècle, jamais poussée aussi loin, peut-être, que dans ce mastodonte…"
      }
    ],
