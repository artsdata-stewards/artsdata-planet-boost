    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Over more than 20 years as a recording artist, the jazz piano phenomenon Hiromi has shifted seamlessly from one spellbinding project to the next. In the process, she’s earned a reputation as one of the most explosive live performers in jazz history and a global ambassador for the art form.</p>"
      }
