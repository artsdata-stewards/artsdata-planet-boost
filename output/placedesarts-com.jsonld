    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>« Ouvert à toute diversité corporelle ». Vraiment? On lit souvent cette mention dans les appels de casting des productions télé. « Pure hypocrisie! » selon le comédien Vincent Millard. </p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Ouvert à toute diversité corporelle"
      }
    ],
