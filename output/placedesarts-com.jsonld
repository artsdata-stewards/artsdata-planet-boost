    "http://schema.org/url": [
      {
        "@id": "https://www.placedesarts.com/evenement/lena-chamamyan"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Pour son retour, toujours très attendu au Festival du Monde Arabe, Lena Chamamyan promet une véritable odyssée sensorielle. Sa voix claire et profonde oscille entre la douceur d’une caresse et l’élan d’une prière. Ses textes, empreints de poésie, célèbrent la beauté du quotidien, la nostalgie de l’exil et l’espoir obstiné au cœur de l’adversité.</p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Lena Chamamyan"
      }
    ],
