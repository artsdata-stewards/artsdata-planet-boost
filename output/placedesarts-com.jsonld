    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Vous vous évaderez le temps d’une soirée avec le pianiste virtuose Jean-Philippe Sylvestre.  Entre les couleurs teintées de jazz New-Yorkais de Gershwin et Bernstein, vous pourrez traverser également le grand romantisme du XIXe siècle avec Chopin, Liszt et Scriabine!  Après s’être produit sur les…"
      }
