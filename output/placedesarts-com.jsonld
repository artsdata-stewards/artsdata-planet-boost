    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Notre-Dame de Paris : le film | Maison symphonique"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "En création mondiale, la musique du compositeur québécois Gabriel Thibaudeau accompagnera Notre-Dame de Paris, un film muet réalisé en 1923 par Wallace Worsley, d’après le célèbre roman de Victor Hugo. À l’affiche, découvrez Lon Chaney, inoubliable et impressionnant Quasimodo, désespérément épris…"
      }
    ],
