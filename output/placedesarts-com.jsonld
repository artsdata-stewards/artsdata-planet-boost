    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Celui qui est tombé dans la marmite du oud étant petit revient au Festival du Monde Arabe avec une maturité extravagante.  Mêlant le blues et le jazz, mais aussi le chant à une musique orientale redéfinie, le prodigieux Mohamed Abozekry dévoile au public l’esthétique pionnière de ses sonorités…"
      }
    ],
