    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Dans cet Apéro Symphonique de 60 minutes, venez découvrir le talent du lauréat du Concours OSM 2024, Jason Xu, avec la <i>Ballade</i> de Frank Martin, mettant en valeur toute la richesse technique du saxophone.</p>"
      }
    ],
