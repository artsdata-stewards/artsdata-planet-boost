    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Prisé par les publics de tous les horizons, Ballets Jazz Montréal s’illustre à nouveau avec une création captivante signée Jo Strømgren, figure prolifique des arts de la scène internationaux. D’une créativité sans limite!</p>"
      }
    ],
