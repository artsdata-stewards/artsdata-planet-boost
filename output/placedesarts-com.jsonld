    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "À l'occasion de cette Virée classique, l'OSM invite le jeune Ensemble Obiora, constitué de musiciennes et musiciens dits issus de la diversité, pour un concert haletant sur le thème des Amériques. L'ensemble présentera une adaptation du somptueux Quatuor « Américain » de Dvořák ainsi que la…"
      }
    ],
