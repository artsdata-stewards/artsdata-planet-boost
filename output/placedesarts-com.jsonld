      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Americas shaped the modern world and profoundly transformed the history of music. With <i>Un mar de músicas</i> (A Sea of Music), Jordi Savall — a visionary of historically informed performance — weaves a dialogue between European Baroque traditions and the songs of enslaved peoples from 1440 to 1880.</p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Jordi Savall | Un mar de músicas 1440-1880"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@language": "en",
        "@value": "Traquen'Art"
      }
    ],
