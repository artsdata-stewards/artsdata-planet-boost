    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "De par son naturalisme radical, le monumental Catalogue d’oiseaux d’Olivier Messiaen fait figure d’exception dans la littérature pour piano seul. Il est le grand hymne à la nature d’un créateur qui ne se lassa jamais de s’émerveiller devant la beauté stupéfiante des paysages ou la magie des chants…"
      }
    ],
