    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Un retour aux sources par un « battle » de danse de rue créatif. Cinq artistes renommés de la communauté Montréalaise ont chacun imaginé un concept original avec leurs propres règlements. Par le “freestyle”, des danseurs de Hip Hop, Break, Popping, House et Waacking se prêtent au jeu pour devenir…"
      }
    ],
