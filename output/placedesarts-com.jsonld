    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Empreints de noblesse et de sérénité, les  Rückert-Lieder  de Mahler mettront en valeur la voix exceptionnelle de la soprano bulgare Sonya Yoncheva. Ce concert présentera également le majestueux poème symphonique  Une vie de héros  de Richard Strauss à travers lequel on peut percevoir la vie du…"
      }
    ],
