    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p style=\"margin-left:0cm;\">La célèbre Symphonie n<sup>o</sup> 5<i> </i>de Beethoven, avec ses premières notes inoubliables, incarne à la fois la lutte et la lumière, tandis que la <i>Grande Messe en do mineur</i> de Mozart déploie une puissance dramatique et une ferveur inégalée. </p>"
      }
    ],
