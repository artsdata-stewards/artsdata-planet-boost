    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Les athlètes de la flûte à bec | Piano nobile de la Salle…"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "À la course, en équilibre ou à bout de doigts, préparez-vous à une performance athlétique enlevante avec Flûte Alors! Les quatre virtuoses s’entraînent jour et nuit pour développer les doigts les plus agiles, les langues les plus fortes et les oreilles les plus fines du monde. De la sopranino à la…"
      }
    ],
