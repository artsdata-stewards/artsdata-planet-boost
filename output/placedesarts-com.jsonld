      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Immerse yourself in <i>Canticles of Love</i>, a musical tapestry born from an improbable encounter between the captivating singer Khaled Al-Hafez, a keeper of the Levant’s heritage; the magical contralto Gabrielle Cloutier, whose voice maps the contours of inner landscapes; and the spirited energy of Ensemble Vox choir, guardian of sacred harmonies.</p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Canticles of Love"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@language": "en",
        "@value": "Festival du Monde Arabe"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": "Gabrielle Cloutier, Khaled Al-Hafez, Ensemble Vox"
      }
    ],
