    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Brahms et Nielsen : Vigueur, virtuosité, vitalité | Maison symphonique"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Les précédents passages de Juraj Valčuha à l’OSM ont donné lieu à des concerts mémorables. Le chef slovaque est de retour pour diriger une œuvre dans l’air du temps, la Symphonie n  o   4 du Danois Carl Nielsen, dont les quatre mouvements ininterrompus célèbrent les forces régénératrices de la vie…"
      }
    ],
