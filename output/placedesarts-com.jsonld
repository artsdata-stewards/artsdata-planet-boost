    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Dans une Espagne romantique et intemporelle, les cœurs battent, se déchaînent et se brisent pour Don Juan. Jeune noble à la beauté farouche, libertin sans scrupule, le fils de Don Luis déchaîne les passions : séducteur cruel et blasphémateur, il attise le désir des unes, attire la haine des…"
      }
    ],
