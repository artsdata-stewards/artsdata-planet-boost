      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Ils sont pères, fils, cousins, beaux-frères; ils ont 23, 40, 65 ans et se connaissent depuis le début des temps. Petit clan égypto-québécois réuni dans un chalet en plein bois, avec assez de bouffe pour nourrir un régiment (on n’est jamais trop prudent), le groupe s’apprête à souligner l’anniversaire de Ralph et à goûter aux plaisirs simples de la forêt laurentienne. Entre hommes.</p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Frères"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@language": "fr",
        "@value": "Duceppe"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Paul Ahmarani, Mustapha Aramis, Étienne Coppée, Neil Elias, Ariel Ifergan, Alexis Lefebvre, Nour Shoukry, Manuel Tadros, Antoine Yared"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
