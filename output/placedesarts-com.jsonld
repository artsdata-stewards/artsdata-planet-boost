    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.placedesarts.com/evenement/julia-mirzoev-felix-hong"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Julia Mirzoev et Felix Hong ont choisi de nous présenter, en duo, des œuvres qui célèbrent le lyrisme et la richesse expressive du répertoire romantique pour violon et piano : la Sonate <i>Grand Duo</i> de Schubert, empreinte de profondeur, la <i>Sonate n° 2 </i>de Grieg, qui évoque la poésie nordique, en passant par le <i>Poème Élégiaque</i> de Ysaÿe et la <i>Romance</i> d’Amy Beach.</p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Julia Mirzoev & Felix Hong"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@language": "fr",
        "@value": "Pro Musica"
      }
    ],
    "http://schema.org/performer": [
