    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p><i>La Création</i> d’Uwe Scholz est une interprétation visuelle de l’oratorio monumental de Joseph Haydn, une œuvre inspirée de la Genèse biblique qui retrace la naissance du monde.</p>"
      }
    ],
