      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>À l'automne 2026, l'auteure-compositrice-interprète canadienne primée, Loreena McKennitt, commémorera le 30e anniversaire de son album, <i>The Mask and Mirror</i>, avec une tournée vaste dans l'est du Canada. Largement acclamé pour sa « fécondation interculturelle », l'album tisse ensemble des influences celtiques, espagnoles et marocaines.</p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Loreena McKennitt | The Mask and Mirror – 30e anniversaire"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@language": "fr",
        "@value": "Rubin Fogel Productions"
      }
    ],
    "http://schema.org/performer": [
