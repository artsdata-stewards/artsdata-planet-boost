      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "À la chaleur de la voix humaine se joignent des couleurs plus inattendues. De Schubert, Nachtgesang im Walde , pour chœur d'hommes et quatre cors, nous emmène en forêt dans une balade nocturne mais lumineuse pour y célébrer la nature. Les Trois pièces pour chœur mixte de Clara Schumann sont plus…"
      }
    ],
