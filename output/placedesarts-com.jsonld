    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | La triomphale Neuvième Symphonie de Beethoven | Maison symphonique"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Avec Le chant du destin , Brahms met en musique la poésie de Friedrich Hölderlin, écho romantique à l’Antiquité grecque liant destin et consolation. Ces thèmes se retrouvent dans la Neuvième Symphonie de Beethoven, hymne à la fraternité humaine. Ces deux chefs-d’œuvre pour chœur et orchestre…"
      }
    ],
