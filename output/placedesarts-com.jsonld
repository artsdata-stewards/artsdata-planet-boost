    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Venez à la rencontre de l’auteur-compositeur pour le plaisir de découvrir ses plus récentes chansons, et d’être bercé par ses plus grands classiques. Jamais sans ses fidèles musiciens, Francis Cabrel récidive pour notre plus grand bonheur!"
      }
