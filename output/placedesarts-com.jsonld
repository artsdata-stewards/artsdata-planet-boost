    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Qu'est-ce qu'on a fait de nos rêves? Hommage à Sylvain Lelièvre |…"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Véritable maître dans l’art de marier les mots et la musique, Sylvain Lelièvre est au cœur du projet artistique Qu’est-ce qu’on a fait de nos rêves… . Vingt ans après son décès, son immense talent lui survit et ses chansons n’ont pas pris une ride. Dans une mise en scène de Joe Bocan, elles seront…"
      }
    ],
