    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Alexandre Forest - Pour ne pas mourir demain | Salle Claude-Léveillée"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "« Qu’est-ce que, moi, Alexandre Forest peut apporter de plus dans le monde? Je veux que ma vie soit utile, mais je dois avouer que j'en ai déjà assez de me défendre contre le gluten (plus compliqué que vous pourriez le croire). Bref j’essaie de savoir quoi faire pour vivre et, surtout, pour ne pas…"
      }
    ],
