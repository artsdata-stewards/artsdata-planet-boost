    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>The Bad Plus are the ultimate originals. A democratic unit with a clear vision and a refusal to conform to convention. For the past two decades they have played with spirit and adventure, made their own rules and done so with a bold sense of creativity and intent. </p>"
      }
    ],
