    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Amine Hachem est une figure de proue de l'opéra, des comédies musicales et des concerts internationaux. Acclamé pour ses performances captivantes par iHeart Radio, il est reconnu pour sa capacité à repousser les limites de la musique lyrique en l'intégrant avec des sons non conventionnels du monde entier.</p>"
      }
    ],
