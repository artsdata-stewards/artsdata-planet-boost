    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Step into the enchanting world of the Arab world’s most iconic melodies and voices in <i>The Arab Legends</i>, an exceptional concert presented by Mazzika Orchestra. This unique performance pays tribute to the timeless icons of Arabic music — songs that have transcended generations and continue to inspire.</p>"
      }
