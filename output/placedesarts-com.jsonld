    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Michel Rivard - Le tour du bloc - 50 ans de chansons | Théâtre…"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Une promenade imaginaire, poétique et souriante, autour de cinquante ans de chansons. Un trajet théâtral et musical qui reliera une quinzaine de chansons marquantes, avec la complicité d’un Flybin Band enrichi par la présence de claviers et d’instruments à vent. Un anniversaire en douceur avant…"
      }
    ],
