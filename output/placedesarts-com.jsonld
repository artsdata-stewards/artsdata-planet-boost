    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Mozart de toute beauté : Le grand retour de Jonathan Cohen | Maison…"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Les Violons du Roy accueillent de nouveau la sublime soprano française Sandrine Piau, une artiste majeure de la scène lyrique mondiale. Elle interprétera quelques-uns des plus beaux airs d’opéra de Mozart dont elle est l’une des plus éloquentes interprètes. Pour célébrer son retour à la tête des…"
      }
    ],
