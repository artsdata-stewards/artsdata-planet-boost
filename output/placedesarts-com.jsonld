    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Embarquez dans un voyage musical à travers les paysages sauvages et époustouflants du sud de l’Argentine, la Terre de Feu. Le Quatuor Cobalt vous invite à découvrir l’univers vibrant du tango argentin aux musicalités inspirées par les couleurs et reliefs de ces terres australes. Des sonorités…"
      }
    ],
