      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p><i>Parapapam</i>! Un événement festif et chaleureux, célébrant la magie de Noël dans toute sa splendeur. Pour cette nouvelle édition, trois grandes voix, Mélissa Bédard, Christian Marc Gendron et Vladimir Kornéev, illumineront la Maison symphonique lors de cinq représentations d’exception avec Manon Séguin comme invitée.</p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Parapapam"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@language": "fr",
        "@value": "Les Agents Doubles Productions"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Mélissa Bédard, Christian Marc Gendron, Vladimir Kornéev, Manon Séguin"
      }
    ],
