    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Melody Gardot est une musicienne dotée d'une sensibilité et d'un équilibre rare et remarquable. C'est une chanteuse dont la voix est immédiatement reconnaissable, caractérisée par une délicatesse envoûtante et une précision émotionnelle pénétrante. </p>"
      }
    ],
