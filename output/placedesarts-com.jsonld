    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Step into a world of splendor and romance, dazzling excess, opulence, grandeur, and glory! A world where bohemians and aristocrats mingle and revel in an electrifying spectacle. Welcome to <i>Moulin Rouge! The Musical</i>!</p>"
      }
