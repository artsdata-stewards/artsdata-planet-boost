      {
        "@language": "fr-ca",
        "@value": "Place des Arts | L’Éternelle Renarde, sur les traces de Pauline Julien | Salle…"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Après un succès retentissant en 2018-2019, La Renarde, sur les traces de Pauline Julien, revient en formule intimiste et revisitée. Sa parole étant toujours d’actualité et son lègue encore important, vous aurez la chance de (re)plonger dans son œuvre avec cette nouvelle version qu’est L’Éternelle…"
      }
    ],
