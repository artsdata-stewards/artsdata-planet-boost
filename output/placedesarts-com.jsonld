    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Avec leur nouveau spectacle intitulé <i>Peace</i>, le Soweto Gospel Choir revient en Amérique du Nord pour présenter un concert vibrant et coloré alliant des chants de liberté sud-africains, des chants spirituels traditionnels, des classiques ainsi que de la musique enjouée d’Aretha Franklin, d’Harry Belafonte, de Peter Gabriel, de Kate Bush, de Leonard Cohen et bien d’autres!</p>"
      }
    ],
