    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "En présence d'artistes professionnels et des hôtes rigolos Dahlia et Phinéas, la Fête famille Ta voix enchantée propose un parcours de 3 ateliers de 11 h à 13 h (chant lyrique, chant choral et bricolage), suivi d’une zone de jeux libre (jeu de quilles, jeux à la craie, cerceaux, cordes à sauter et…"
      }
