    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Le temps des fêtes avec Nagano | Maison symphonique"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Œuvre emblématique du temps des fêtes, Casse-Noisette de Tchaïkovski séduit petits et grands grâce à son ambiance féérique et ses sonorités scintillantes. Profonde et chaleureuse, la voix de Marie-Nicole Lemieux illuminera ce concert dans la création mondiale d’une œuvre du compositeur canadien…"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
