    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Taj is a towering musical figure — a legend who transcended the blues not by leaving them behind, but by revealing their magnificent scope. As he traced origins to the American South, the Caribbean, Africa, and elsewhere, he created entirely new sounds. </p>"
      }
    ],
