    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Flanqué de trois de ses frères, avec lesquels il formait jadis un populaire groupe de musique, le troll Branch part à la rescousse de leur quatrième frangin, kidnappé par deux artistes sans talent, à qui il insuffle ses dons vocaux. Selon l'aîné, seule la note de l'harmonie familiale absolue saura…"
      }
    ],
