    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Pour un final en majesté! Pour clôturer cette édition 2025, l’Orchestre du Festival International Bach Montréal a invité le chœur suisse J.S. Bach de Saint-Gall (J.S.-Bach-Stiftung St. Gallen) à se joindre à lui pour interpréter une des œuvres les plus importantes de Bach.</p>"
      }
    ],
