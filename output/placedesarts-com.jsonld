    "http://schema.org/url": [
      {
        "@id": "https://www.placedesarts.com/evenement/y-una-noche"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Spectacle atypique de la scène flamenca, ... <i>Y Una Noche</i> s’élève comme une rêverie incandescente, flottant dans un univers parallèle. Ici, le rêve prend chair, la dualité se dissipe, laissant s’épanouir une symphonie où se croisent le flamenco et le chant arabo-andalou, fusionnant l’écho des ancêtres avec la pulsation du présent.</p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Y Una Noche"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@language": "fr",
        "@value": "Festival du Monde Arabe"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "LaBounita, Rae Bowhay, Mabel Chong, Philippe Jean, Miguel Medina"
      }
    ],
