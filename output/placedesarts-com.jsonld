    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Avec <i>Un mar de músicas </i>(Une mer de musique), Jordi Savall — grand visionnaire de l’interprétation historique — tisse un dialogue entre le baroque européen et les chants des peuples réduits en esclavage de 1440 à 1880. </p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Jordi Savall | Un mar de músicas 1440-1880"
