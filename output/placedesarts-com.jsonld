    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | JOAT.EXE | 10 ans d’histoire | Théâtre Maisonneuve"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Ce court documentaire, qui sera projeté sur la scène du Théâtre Maisonneuve, retrace le parcours du festival depuis ses débuts modestes il y a dix ans dans les quartiers vibrants de Montréal jusqu’à son arrivée à la Place des Arts en 2022. Avec une trame sonore originale signée par les talentueux…"
      }
    ],
