    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Dans le duo  Temps Avenir , la scène se transforme en un nouveau territoire régi par ses propres lois et par ses propres mouvements sur une musique jouée en direct par Charles Bicari. Ce changement d’atmosphère altère entièrement le corps et l’âme des interprètes. À travers une gestuelle frénétique…"
      }
    ],
