    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>À la demande générale et fort du succès retentissant de ses représentations à guichets fermés en 2022, 2023, 2024 et 2025, le spectacle <i>Hommage à Metallica symphonique</i> présenté par la formation AnesthesiA s'arrête à la Place des Arts, accompagné par l’Orchestre FILMharmonique.</p>"
      }
    ],
