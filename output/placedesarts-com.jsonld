    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Plus grands que nature | Maison symphonique"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Une marionnette espiègle prend vie et, avec ses acolytes, transforme l’orchestre en théâtre où se jouent leurs amours déçues, tel est le programme du très rythmique Petrouchka de Stravinski, où se décèle l’influence de Glazounov. En ouverture, le tragique Idomeneo de Mozart où se mêlent destin,…"
      }
    ],
