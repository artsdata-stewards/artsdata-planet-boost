    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Préparez-vous pour une soirée palpitante de musique qui explore les forces brutes de la nature et des émotions humaines, avec deux pièces audacieuses et inoubliables : Carmina Burana de Carl Orff et Le Sacre du printemps d’Igor Stravinsky. </p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Carmina Burana et Le sacre du printemps"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@language": "fr",
        "@value": "Orchestre Philharmonique et Choeur des Mélomanes"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Aline Kutan, Spencer Britten, Hugo Laporte"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
