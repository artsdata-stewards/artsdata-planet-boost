    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le lauréat du Concours OSM 2019 Bryan Cheng et le violon solo  de l’OSM Andrew Wan s’unissent dans un programme inusité qui prendra la forme d’un dialogue entre violon et violoncelle, avec comme pièce de résistance, la Sonate de Ravel. Celle-ci fut écrite en 1921 en hommage à Claude Debussy et fait…"
      }
    ],
