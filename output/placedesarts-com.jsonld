    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | DenDana, aux dunes de Paris | Salle Claude-Léveillée"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "À la croisée des influences blues, rock et de musique traditionnelle, le chanteur algérien DenDana retrace son exil en France, jalonné de rencontres décisives, tout en reprenant les chansons de son patrimoine saharien. Un périple musical aux émotions contagieuses et aux textes d’une rare poésie."
      }
    ],
