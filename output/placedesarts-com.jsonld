    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Éternel Orlando | Maison symphonique"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "L’Orlando de Virginia Woolf traverse les siècles. Éternellement jeune, le personnage change de vie et de genre, mais reste fasciné par l’art. Alors que l’histoire de la littérature anglaise imprègne la nouvelle de Woolf, c’est la musique et son évolution qui jalonnent ce spectacle mariant théâtre…"
      }
    ],
