      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Immerse yourself in Pierre Verville's unique universe with Pour une dernière voix, a solo show combining humor and impersonations, shifting between fiction and reality. In his magnificent insomniac delusions, Pierre imagines himself on stage as a radio host narrating his own life, while his audience is there, in the room, right in front of him...</p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Pierre Verville | Pour une dernière voix"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@language": "en",
        "@value": "Productions Martin Leclerc"
      }
    ],
