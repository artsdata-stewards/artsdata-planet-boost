    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Une histoire d’Halloween beaucoup plus fascinante qu’effrayante.  Le Bal de l’Halloween vous propose une expérience participative où trois artistes, deux musiciens et une danseuse, vous invitent à danser au rythme, entre autres, du «  reel » des citrouilles!  Conte , musique et danse font partie…"
      }
