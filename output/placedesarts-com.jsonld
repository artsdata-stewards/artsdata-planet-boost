    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p style=\"margin-left:0px;\">Après avoir remporté les Olivier du spectacle de l’année et d’auteur de l’année, ainsi que le Félix du spectacle d’humour de l’année, Pierre-Yves Roy-Desmarais élève son art à un niveau supérieur avec son deuxième spectacle. </p>"
      }
