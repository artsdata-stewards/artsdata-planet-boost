    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-07-04T00:00:00"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.placedesarts.com/evenement/taj-mahal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Taj est une figure musicale imposante, une légende qui a transcendé le blues non pas en le laissant derrière lui, mais en révélant son magnifique champ d'application. En remontant ses origines jusqu'au sud des États-Unis, aux Caraïbes, en Afrique et ailleurs, il a créé des sons entièrement nouveaux. </p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Taj Mahal et Phantom Blues Band"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@language": "fr",
        "@value": "Festival International de Jazz de Montréal"
      }
    ],
    "http://schema.org/performer": [
