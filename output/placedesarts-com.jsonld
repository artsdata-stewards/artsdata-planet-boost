    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | David Goudreault - En marge du texte | Théâtre Maisonneuve"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Suite au succès de son premier spectacle solo, David Goudreault récidive avec une performance scénique alliant humour et poésie.  Révélant les secrets de son processus de création, l'écrivain confronte les grands textes de la francophonie aux aléas du quotidien.  Pour le meilleur et pour le rire."
      }
    ],
