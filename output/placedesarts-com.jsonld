    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Assistez à la grande finale de la 32e édition du concours Ma première Place des Arts! Le suspense est à son comble! Des huit demi-finalistes, quatre ont su conquérir le jury pour obtenir une place à la grande finale : Aleksi Campagne, Florence Breton, Vaillance et Désolée Sarah. </p>"
      }
    ],
