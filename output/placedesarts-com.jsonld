    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Paule Tremblay, autrice, compositrice et pianiste adore donner vie à ses chansons sur scène. Accompagnée par Pascal Dufour à la basse et Catherine Deguire aux chœurs, elle présentera les chansons de son nouvel album À l’encre rouge . Des chansons empreintes de sensibilité et d’humanité où la joie…"
      }
    ],
