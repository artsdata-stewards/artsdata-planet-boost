    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "L'Orchestre FILMharmonique se lance dans une nouvelle aventure avec le chef-d'œuvre en stop-motion de Tim Burton!  Sur une musique composée par le légendaire Danny Elfman, le film suit les aventures sincères, mais malencontreuses de Jack Skellington, le roi des citrouilles bien-aimé de la ville…"
      }
