    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Parapapam! A festive, heartwarming event that celebrates the magic of Christmas in all its wonder. For this new edition, three remarkable voices, Mélissa Bédard, Christian Marc Gendron and Vladimir Kornéev, will light up the <i>Maison symphonique</i> in five outstanding performances with special guest Manon Séguin.</p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Parapapam"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@language": "en",
        "@value": "Les Agents Doubles Productions"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": "Mélissa Bédard, Christian Marc Gendron, Vladimir Kornéev, Manon Séguin"
      }
    ],
