    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Jofroi - Et ton rire un oiseau | Salle Claude-Léveillée"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Depuis cinquante ans, Jofroi chante. De sa Belgique natale à son havre gardois de Cabiac, de Montréal à la Réunion, de Dakar à Paris, Jofroi sème aux quatre coins du monde les mots d’une langue française qu’il manie comme personne. Il chante l’amour. L’amour de la nature, l’amour de la vie, l’amour…"
      }
    ],
