    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Winterreise | Maison symphonique"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Alors que l'hiver enveloppe le monde de son étreinte feutrée, l'Ensemble ArtChoral vous invite à découvrir la mélancolie poétique de Schubert. À travers des mélodies obsédantes et des refrains glaçants, son Winterreise raconte l'odyssée émotionnelle d'un vagabond solitaire à travers les paysages…"
      }
    ],
