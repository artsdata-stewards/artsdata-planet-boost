      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Maintenant dans la cinquantaine, Louis Morissette  porte un regard humoristique et caustique sur son parcours, le pouvoir des échecs professionnels, et la société de performance. Avec une authenticité déroutante, il se met à nu et pose la question : après quoi on court?"
      }
