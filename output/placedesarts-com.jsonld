    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Laissez-vous emporter par le talent du pianiste Emanuel Ax, gagnant de huit Grammy Awards, qui insufflera toute sa sensibilité au <i>Concerto n° 3</i> de Beethoven, une œuvre fascinante à la croisée du romantisme.</p>"
      }
    ],
