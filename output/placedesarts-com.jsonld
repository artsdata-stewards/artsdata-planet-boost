    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Experience an exceptional evening at the Gala of the 31<sup>st </sup>edition of the CINEMANIA Film Festival. Be the first to discover <i>Où vont les âmes</i> the highly anticipated new feature film by Brigitte Poupart, distributed by Axia Films and produced by Bravo Charlie.</p>"
