      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Fauré, Debussy et Chausson pour cordes et piano | Cinquième Salle"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Avec sa formation très originale, le Concert de Chausson se situe à la croisée de la musique de chambre et du concerto. Oscillant entre tensions et charme délicat, cette œuvre est empreinte d’un puissant lyrisme. Quant à Debussy, il adresse quelques clins d’œil à l’Espagne en confiant au…"
      }
    ],
