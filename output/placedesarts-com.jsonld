      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Cette pièce tout en mouvement pose un regard enjoué sur la façon dont les amitiés se construisent, se brisent et se renouent. Une aventure fantasque avec des tentes qui prennent vie, des tuques à pompons et beaucoup de plaisir en bottes de pluie!"
      }
    ],
