      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>« C’est quoi votre rêve le plus fou? Devenir le meilleur dans votre domaine? Vous mettre en super forme? Vous débarrasser de votre dépendance à la bouffe ou à votre téléphone? Pensez-y quelques secondes… Vous le voyez ce rêve-là? Il est juste là, au bout de vos doigts... Êtes-vous prêts à le réaliser? » lance la fondatrice d’Essor, la Québécoise Éliza Williams.</p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Boîte noire"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@language": "fr",
        "@value": "Duceppe"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Lamia Benhacine, Frédéric Blanchette, Vincent-Guillaume Otis, Madeleine Sarr, Catherine-Anne Toupin, Victor Andres Trelles Turgeon, Aimé Tuyishime"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
