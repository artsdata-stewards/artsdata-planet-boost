    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "L'accordéoniste, pianiste et chanteur Steve Normandin se passionne depuis toujours pour l’interprète Édith Piaf . Aujourd’hui, il partage ses coups de cœur qu’il puise dans le vaste répertoire de la chanteuse. Normandin interprète non seulement les chansons mais il en raconte certains aspects de…"
      }
    ],
