    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Yazid est un auteur-compositeur-interprète francophone de Montréal d'origine Marocain. Son style de musique se situe entre le folk acoustique et le rock québécois, avec des influences de funk, blues, pop et de musique traditionnelle marocaine.  Depuis toujours, la musique a été pour Yazid le moyen…"
      }
