    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Le retour de William Christie et les Arts Florissants | Amphithéâtre…"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Les débuts chez nous de William Christie et les Arts Florissants, l’été dernier, était à marquer d’une pierre blanche : virtuosité, beauté et enchantement, en adéquation parfaite avec l’Amphithéâtre et son cadre naturel irrésistible. Ils nous reviennent cette année et nous révèlent une tout autre…"
      }
    ]
  },
