    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Témoin lucide des enjeux actuels, Virginie Brunelle pose un regard incisif sur une planète en hypertension. Elle signe une chorégraphie impérieuse, vibrant combat pour l’amour et la solidarité.</p>"
      }
    ],
