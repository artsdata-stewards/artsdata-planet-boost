      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Les girafes déambulent. Les oiseaux plongent. Les gazelles bondissent. Toute la savane du Serengeti prend vie comme jamais auparavant. Et alors que la musique s’élève, le Rocher des Lions émerge lentement de la brume. Voici <i>Le Roi Lion</i> de Disney, qui fait son grand retour triomphal à la Salle Wilfrid-Pelletier!</p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Disney’s The Lion King"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@language": "fr",
        "@value": "evenko, Broadway Across Canada"
      }
    ],
