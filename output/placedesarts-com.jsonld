      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Découverte et célébration de la culture cambodgienne | Salon urbain"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Imprégnez-vous de la culture cambodgienne et découvrez l’histoire du Cambodge à travers des expositions de peintures et de photographies, des spectacles de danse et de musique traditionnelles, des conférences, ainsi que des dégustations de mets. Des activités inspirées des traditions asiatiques…"
      }
    ],
