    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Gregory Alan Isakov, a Johannesburg-born, Colorado-based horticulturist and musician, has made a strong mark in indie-rock and folk with six acclaimed albums, including the Grammy-nominated <i>Evening Machines</i> and his latest, <i>Appaloosa Bones</i>. </p>"
