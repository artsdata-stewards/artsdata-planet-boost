    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p style=\"margin-left:0px;\">After winning the Olivier Awards for Show of the Year and Writer of the Year, as well as the Félix Award for Comedy Show of the Year, Pierre-Yves Roy-Desmarais takes his art to the next level with his second show. </p>"
      }
    ],
