    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "La mégère apprivoisée  de William Shakespeare. Traduit par François-Victor Hugo, adapté et mis en scène par Martin Lavigne.  La mégère apprivoisée , l’une des premières comédies romantiques de Shakespeare , a traversé les époques par ses thèmes universels. D’un côté, Catharina, une jeune femme…"
      }
    ],
