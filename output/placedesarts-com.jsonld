    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Ce programme juxtapose la pétillante <i>Symphonie n<sup>o</sup> 8 </i>de Beethoven et la puissante <i>Symphonie </i>« Leningrad » de Chostakovitch, une œuvre poignante qui incarne la force de la résistance face à l'oppression.</p>"
      }
    ],
