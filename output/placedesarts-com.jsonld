    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p style=\"margin-left:0cm;\">Une soirée chic et <i>jazzy</i> aux couleurs de Manhattan vous attend avec les plus grands succès de Frank Sinatra, interprétés par les grandes voix de Marc Hervieux et de Marie-Ève Janvier porté par l’Orchestre FILMharmonique.</p>"
      }
    ],
