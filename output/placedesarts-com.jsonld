      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Elenit - Euripides Laskaridis | Théâtre Jean-Duceppe"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Un monde hors du temps, entre le rêve et la fin des idéaux. Propulsés par la force motrice d’une éolienne, un théâtre de personnages étranges et une bête préhistorique gravitent autour d’une créature enfumée. Après Titans qui a ébloui le public du FTA en 2018, le fabuleux performeur grec Euripides…"
      }
    ],
