    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>L’Orchestre et le Chœur de l’OSM accompagnent le mythique film de science-fiction réalisée par Stanley Kubrick, <i>2001 : l’Odyssée de l’espace</i>, pour un voyage philosophique où futurisme et poésie se rencontrent.</p>"
      }
    ],
