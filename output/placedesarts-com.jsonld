    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Sylvie Paquette propose un voyage à travers trois décennies de chansons, dans la foulée de la parution de Jusqu’ici , son huitième et son plus récent album. Accompagnée du talentueux André Papanicolaou , l’autrice-compositrice-interprète revisite des pièces de son répertoire et offre de nouveaux…"
      }
