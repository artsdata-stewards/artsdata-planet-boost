    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Comedian, presenter, and actor Alphé Gagné has been on the cultural landscape for several years now. In addition to regularly hosting evenings at Le Bordel and Le Terminal, he is also heard on CKOI and opens for Louis-José Houde. With an innate sense of what works and a captivating stage presence, Alphé is now bringing you a trial run of his first 60-minute set: 1/16-Spectacle de blagues en construction (1/16-Jokes in Progress). Anecdotes, stand-up, improvisation… his know-it-all attitude and irreverent style always see him putting it all on the line. Be among the first to witness what promises to be a madcap and captivating show-in-progress! "
      }
    ],
    "http://schema.org/headline": [
      {
        "@language": "en",
        "@value": "Alphé Gagné - 1/16, spectacle de blagues en construction | Salle Claude-Léveillée"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "en",
        "@value": "en-ca"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Alphé Gagné - 1/16, spectacle de blagues en construction | Salle Claude-Léveillée"
      }
    ]
  },
