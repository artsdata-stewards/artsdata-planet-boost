      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Joshua Redman's new album <i>Words Fall Short</i> follows his acclaimed <i>Where Are We</i>, marking a natural evolution in his artistry rather than a departure. While the previous album featured a vocalist, this latest work is centered around new, previously unheard compositions developed during the pandemic and brought to life by a fresh, younger quartet. </p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Joshua Redman Group"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@language": "en",
        "@value": "Festival International de Jazz de Montréal"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": "Joshua Redman"
      }
    ],
