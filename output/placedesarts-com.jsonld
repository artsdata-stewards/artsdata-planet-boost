    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Nagano et Kantorow : de Sibelius à Tchaïkovski | Maison symphonique"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "À l’occasion de ses débuts avec l’OSM, le jeune pianiste français Alexandre Kantorow, médaillé d’or du Concours Tchaïkovski en 2019, interprétera le Deuxième Concerto du compositeur russe, sous la baguette du chef émérite de l'OSM Kent Nagano. Mais avant, ce dernier diffusera une aura de lumière…"
      }
    ],
