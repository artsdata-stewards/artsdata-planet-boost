    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Mass in Blue - Le jazz vocal s’invite à la messe | Cinquième Salle"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "La  Mass in Blue  (messe en bleu) a été composée en 2003 par le compositeur et chef anglais Will Todd (né en 1970). L’idée de l’œuvre est claire : fusionner la musique chorale classique et le jazz. À travers les six mouvements d’une messe chantée – Kyrie, Gloria, Credo, Sanctus, Benedictus, Agnus…"
      }
    ],
