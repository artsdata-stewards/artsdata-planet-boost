    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Chief Xian aTunde Adjuah — formerly Christian Scott — is a two-time Edison Award-winning, six-time Grammy Award-nominated, Doris Duke Award in the Arts awardee. He is a sonic architect, trumpeter, multi-instrumentalist, composer, producer, designer of innovative technologies and musical instruments.</p>"
      }
