    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Leong et Tétreault : cordes étincelantes | Maison symphonique"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Sous les archets de Kerson Leong et de Stéphane Tétreault, le Double concerto pour violon, violoncelle et orchestre de Brahms présente une vision romantique du concerto grosso. Avec ses mélodies puissantes et son parcours dramatique finement tissé, il charme et étonne tour à tour."
      }
    ],
