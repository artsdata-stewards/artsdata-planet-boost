    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Les arts vivants à l’ère numérique : petite ou grande mutation? | Salon…"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "La fragmentation de la consommation des arts de la scène, l’essoufflement du modèle d’abonnement, les changements sociodémographiques du public et le virage numérique, voici quelques-unes des mutations auxquelles le monde du spectacle était déjà confronté et ce, même avant la pandémie de COVID-19. …"
      }
    ],
