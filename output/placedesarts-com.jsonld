    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Vivez une soirée d'exception à l'occasion du Gala de la 31<sup>e</sup> édition du festival de films CINEMANIA où vous pourrez découvrir en grande première <i>Où vont les âmes</i>, le nouveau long métrage très attendu de Brigitte Poupart, distribué par Axia Films et produit par Bravo Charlie. </p>"
      }
