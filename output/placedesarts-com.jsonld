    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>David Sedaris—America’s pre-eminent humorist and master storyteller—takes the stage with his razor-sharp wit and outrageous, true-to-life tales. Author of bestsellers like <i>Me Talk Pretty One Day, Calypso, </i>and<i> Happy-Go-Lucky, </i>Sedaris has sold over 16 million books worldwide and is adored for his ability to turn the everyday into something unforgettable.</p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "An Evening with David Sedaris"
      }
