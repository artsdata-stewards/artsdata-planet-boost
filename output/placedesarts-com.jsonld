    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Tony vend des billets | Coulisses du Théâtre Jean-Duceppe"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Tony vend des billets. Depuis 15 ans. C'est sa job. Le monde de la billetterie s’automatise, mais ça prend encore quelqu’un pour faire marcher la machine. Surtout quand la machine plante, ou que le groupe à l’affiche est refoulé aux douanes. Aujourd'hui, Tony entraîne Jazz, un apprenti «producer»…"
      }
    ],
