    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Spectacle Famille avec Cie Sursaut | Cinquième Salle"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Vous plongerez dans l'univers envoûtant de la légende des Moires ! Vous pourrez découvrir ces trois sorcières, incarnations des sœurs du destin, dansant avec des tresses démesurées, dans un spectacle captivant pour tous les âges. Après la représentation, rejoignez-les pour une rencontre conviviale…"
      }
    ],
