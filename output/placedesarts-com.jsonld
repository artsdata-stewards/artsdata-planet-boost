    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | La 9e de Beethoven, de Haïti à Jérusalem | Théâtre Maisonneuve"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Alexandre Da Costa et l’ Orchestre Philharmonique du Québec vous invitent à la grande symphonie chorale de Beethoven, comme elle n’a jamais été présentée. Vous pourrez l’entendre chantée en français, en créole haïtien, en innu, en anglais et en hébreu, et ponctuée de chansons d’opéra, jazz et rock…"
      }
    ],
