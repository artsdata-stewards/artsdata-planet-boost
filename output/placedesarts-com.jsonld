    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Louise Farrenc et Cécile Chaminade ne sont pas nées compositrices, mais le sont devenues contre vents et marées. La Symphonie de Farrenc rappelle Brahms ou Mendelssohn avec une touche de France, tandis que le Concertino de Chaminade et la Sonate de Poulenc mettent en valeur la polyvalence de la…"
      }
    ],
