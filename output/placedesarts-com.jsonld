    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Au cœur palpitant de Montréal, l’âme de l’Algérie se déploie telle une caresse venue du désert, le temps d’une veillée où le chaâbi, qu’il soit algérois ou kabyle, se fond dans un univers poético-musical qui nous projette dans des temps ancestraux plus vivants que jamais.</p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Chaâbi de Montréal, algérois et kabyle"
      }
    ],
