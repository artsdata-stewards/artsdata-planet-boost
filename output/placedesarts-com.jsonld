    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Attend this free conference by Miloud Chennoufi, Professor of International Relations and Director of Graduate Studies at the Canadian Forces College, Toronto, seeking to explore questions, examining the challenges of mapping a shifting boundary between lived horror and its formal recognition.</p>"
      }
