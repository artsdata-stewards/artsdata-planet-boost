      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Du contrepoint fleuri aux vastes espaces minimalistes, Bach et Glass se partagent l’affiche d’un concert axé sur le dialogue entre ces deux compositeurs majeurs. La Lettone Iveta Apkalna, organiste titulaire à la Philharmonie de l’Elbe à Hambourg, nous propose ainsi un voyage édifiant au cœur d’un…"
      }
    ],
