        "@value": "https://www.placedesarts.com/evenement/beethoven-pastoral-0"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Beethoven pastoral | Maison symphonique"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "La Symphonie n o 6 « Pastorale » nous transporte loin de la ville, dans la campagne et les sous-bois dépeints par Beethoven. Elle trouve aujourd’hui un écho dans les préoccupations environnementales en rappelant la fragilité de la nature qui nous entoure. Avec son funeste deuxième mouvement,…"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://cdn.placedesarts.com/event/event-transform/_1200x630_crop_center-center_82_none_ns/241017_marathonbeethoven_om_1600x1064.jpg?mtime=1728577289"
      }
    ],
    "http://ogp.me/ns#image:width": [
