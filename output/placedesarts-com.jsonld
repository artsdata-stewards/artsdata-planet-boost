    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Pour clore en beauté sa saison musicale et célébrer les 75 ans de la Faculté de musique de l’Université de Montréal, l’Orchestre de l’Université de Montréal (OUM) vous convie à un concert grandiose à la Maison symphonique.</p>"
      }
