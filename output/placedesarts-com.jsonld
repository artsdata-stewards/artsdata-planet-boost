    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Odette, héroïne ensorcelée du <i>Lac des cygnes,</i> incarne ce moment unique dans la vie d’une ballerine, où tout bascule entre métamorphose et dépassement de soi.</p>"
      }
    ],
