    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Les danseuses Valeska et Florence Leclerc auront recours aux plus belles traditions de danse du Moyen-Orient pour cette soirée où l’étoffe des costumes suivra le mouvement enivrant des gestuelles les plus sensuelles et raffinées. Danses persanes et orientales seront mises à l’honneur, rappelant une…"
      }
    ],
