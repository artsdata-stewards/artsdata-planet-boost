    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Let yourself be swept away by the masterful touch of eight-time Grammy winner Emanuel Ax as he brings his deep sensitivity to Beethoven’s <i>Piano Concerto No. 3</i>, a fascinating bridge between the elegance of Classicism and the passion of Romanticism.</p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Emanuel Ax Plays Beethoven"
      }
    ],
