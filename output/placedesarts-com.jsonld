    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Avec plus de 20 ans de carrière, la pianiste de jazz Hiromi est passée avec brio d'un projet fascinant à un autre et s'est forgée une réputation comme l'une des artistes les plus explosives de l'histoire du jazz et comme ambassadrice mondiale de cet art. </p>"
      }
