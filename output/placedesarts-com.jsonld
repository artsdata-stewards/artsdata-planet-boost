      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Joue-moi une poésie | Maison symphonique"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Vers, rimes, cigale, fourmi; laissez-vous transporter dans le monde des fables et de la poésie. Pour ce voyage, nul besoin d’être poète ou musicien... Grâce au chef d’orchestre et aux invités, découvrez comment des compositeurs tels que Saint-Saëns et Dukas s’inspirent des mots et les transposent…"
      }
    ],
    "http://ogp.me/ns#image": [
      {
