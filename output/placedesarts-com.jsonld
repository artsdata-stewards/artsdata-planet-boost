    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Immerse yourself in a fascinating sonic universe with the Nouvel Ensemble Moderne under the direction of Jean-Michaël Lavoie. This program brings together three works, each pushing the limits of contemporary musical expression.</p>"
