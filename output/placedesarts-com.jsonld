      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p style=\"margin-left:0px;\">Compositeur, arrangeur, éducateur et « scientifique du son » autoproclamé, Isaiah Collier s'est imposé comme l'une des voix les plus passionnantes du jazz contemporain. Originaire de Chicago, son travail lui a valu de nombreuses distinctions de la part d'institutions et de publications prestigieuses à travers le monde.  </p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Isaiah Collier"
      }
