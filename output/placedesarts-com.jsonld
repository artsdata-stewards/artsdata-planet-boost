    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Le pianiste visionnaire Omar Sosa et la fascinante violoniste-chanteuse Yilian Cañizares unissent leurs talents pour créer <i>Aguas</i>, un album — et un spectacle — magnifique et profondément personnel.</p>"
      }
    ],
