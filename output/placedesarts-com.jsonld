    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Lobgesang - Concert 50e anniversaire du Choeur St-Laurent | Maison…"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le Chœur St-Laurent célèbre son 50 e anniversaire avec la présentation du Lobgesang de Mendelssohn. Composé en 1840, ce « chant de louanges » est une symphonie-cantate en 11 mouvements pour solistes, chœur, et orchestre. Aussi au programme, le Schicksalslied de Brahms (1871), une oeuvre pour chœur…"
      }
    ],
