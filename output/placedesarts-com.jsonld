    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>In Farsi and in Arabic, “sefr” is the word for zero: the void. After exploring the numbers 1 to 9 to examine identity in all its forms, Mani Soleymanlou goes back to the beginning with <i>ZÉRO</i>.</p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "ZÉRO"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@language": "en",
        "@value": "Duceppe"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": "Mani Soleymanlou"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
