      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Depuis des siècles, depuis de nombreuses années, sur les scènes des cabarets et des théâtres, Plume Latraverse a traîné sa carcasse, sa guitare et ses chansons… Entraîné dans une mission ménestrelle sans issue, missionnaire autoroutier et souterrain à travers toutes les folies de ce monde.</p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Plume Latraverse | Rémissionnaire (Le Trio Laid frappe encore)"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@language": "fr",
        "@value": "Place des Arts"
      }
    ],
    "http://schema.org/performer": [
