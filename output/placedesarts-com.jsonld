    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Stacey Kent est une chanteuse de jazz américaine dans la lignée des plus grands, avec une légion de fans et une multitude de distinctions et de récompenses, dont une nomination aux Grammy Awards et, plus récemment, le Prix Ella Fitzgerald du Festival de jazz de Montréal. </p>"
      }
