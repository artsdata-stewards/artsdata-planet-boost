      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Boudchart revient au Canada avec un programme musical envoûtant qui fera vibrer la Place des Arts et emportera les spectateurs dans un voyage émotionnel inoubliable. Le public chantera à l'unisson les grands succès de la musique marocaine et orientale moderne et classique, fusionnant leurs voix…"
      }
    ],
