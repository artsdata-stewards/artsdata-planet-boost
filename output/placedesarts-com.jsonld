    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p style=\"margin-left:0px;\"><i>Piano voix diapos</i><strong> </strong>is a guitar less Dumas, accompanied by a pianist and a slideshow. In a minimalist set-up, he shares his story through songs, revisiting 25 years of his own repertoire with sensitivity and a constant desire to offer the audience an unforgettable and uplifting experience!</p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Dumas | Piano voix diapos"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@language": "en",
        "@value": "La Tribu"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": "Dumas"
      }
    ],
