    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Maintes fois ovationnés par le public de Danse Danse, Hofesh Shechter et sa formidable tribu nous embarquent pour une plongée vertigineuse, tête première, dans un univers fantasmé où rêve et réalité s’entrechoquent. Un événement!</p>"
      }
    ],
