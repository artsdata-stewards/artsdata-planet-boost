    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>L’heure bleue : cet instant entre le jour et la nuit, où le ciel se voile d’un bleu diaphane. Un entre-deux suspendu, où l’on vacille entre ce qui fut et ce qui sera, entre la naissance et le deuil.</p>"
      }
    ],
