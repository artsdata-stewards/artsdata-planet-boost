    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Laissez-vous emporter par la passion! La joie éclatante du <i>Magnificat</i> de Bach se marie à merveille avec l’intensité du Concerto pour violon en mi mineur de Felix Mendelssohn, l’un des plus émouvants de tous les temps.</p>"
      }
