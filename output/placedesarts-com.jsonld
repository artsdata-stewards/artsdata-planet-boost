    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p style=\"margin-left:0px;\">Un événement qui se veut plus qu’une simple programmation : une véritable expérience de rencontre, où la musique ouvre les sens, le cinéma stimule la réflexion et la parole tisse le lien entre créateurs et spectateurs.</p>"
      }
