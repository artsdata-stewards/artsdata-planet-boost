    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Myriam Beldi - Écoute ma voix | Cinquième Salle"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Les rythmes du chaâbi s’élancent. Ses mélodies, habitées d’un souffle nouveau et superbement féminin résonnent au son surprenant mais envoûtant du rock et du groove. On y entend parfois des vers chantés en français sans que s’y invite le scandale. Une expérience à la fois originale et enivrante qui…"
      }
    ],
