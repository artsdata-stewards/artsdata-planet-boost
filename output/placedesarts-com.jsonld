    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Vienne au tournant du 19 e siècle, patrie de Haydn, Beethoven, Schubert, plus tard de Brahms, et tant d’autres encore… De cette concentration, de cette effervescence naissent certains des plus beaux chefs-d’œuvre de l’histoire. On y fait de la musique à chaque coin de rue, on la joue certes dans…"
      }
