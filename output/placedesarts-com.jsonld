    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Nikos Vertis | Théâtre Maisonneuve"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le chanteur grec à succès, Nikos Vertis, est de retour à Montréal à la demande générale après cinq ans!  Ce concert montréalais promet un voyage captivant à travers les succès les plus appréciés de Niko Vertis, y compris des sélections de son dernier album. Avec sa voix puissante et son catalogue…"
      }
    ],
