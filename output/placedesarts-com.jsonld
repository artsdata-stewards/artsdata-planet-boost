    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "De la féérie de Casse-Noisette à l’entrainante musique traditionnelle du Québec, c’est à un concert très stimulant que vous convient l’OSM et le groupe Le Vent du Nord. Ce dernier proposera des œuvres de son cru et des pièces traditionnelles dans une version orchestrale. Reels, gigues et autres…"
      }
    ],
