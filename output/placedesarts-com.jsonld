      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "La pianiste et compositrice américaine Amy Beach a écrit son Trio avec piano en 1938, au crépuscule d’une longue carrière prolifique, commencée dès l’âge de quatre ans. L’œuvre témoigne de ses différentes influences, allant du romantisme au modernisme français, en passant par le folklore. Quant au…"
      }
    ],
    "http://ogp.me/ns#image": [
