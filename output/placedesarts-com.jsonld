    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Cécile McLorin Salvant est compositrice, chanteuse et artiste visuelle. Elle est une curatrice éclectique, qui déniche des chansons rarement enregistrées et oubliées, riches en récits, en dynamiques de pouvoir intéressantes, en rebondissements inattendus et en humour.</p>"
      }
    ],
