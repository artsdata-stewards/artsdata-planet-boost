    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Attention! Billy Tellier  et ses invités sont là! Préparez-vous à n'avoir aucun répit, du rire garanti! Méfiez-vous de ses allures de bon garçon! Au cours de cette soirée, il nous partagera ses récentes observations avec son humour un peu baveux."
      }
