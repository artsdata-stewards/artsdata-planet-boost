    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Place des Arts | Ivan Coyote | Playlist | Salle Claude-Léveillée"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Writer and performer Ivan Coyote has crafted a playlist of stories that sing to us about how they managed to discover a coded but very possible queer future.  Tickets on the Place des Arts website!"
      }
    ],
    "http://ogp.me/ns#image": [
