      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Julia Mirzoev and Felix Hong have chosen to present, as a duo, works that celebrate the lyricism and expressive richness of the romantic repertoire for violin and piano: Schubert's Grand Duo Sonata, imbued with depth, Grieg's Sonata No. 2, which evokes Nordic poetry, passing through Ysaÿe's Poème Élégiaque and Amy Beach's Romance.</p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Julia Mirzoev & Felix Hong"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@language": "en",
        "@value": "Pro Musica"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": "Julia Mirzoev, Felix Hong"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
