    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Les suites de Bach, ce ne sont ni plus ni moins qu’une sorte d’Everest du violoncelle, une somme inaltérable, fondatrice, une cathédrale musicale, un aimant pour les interprètes comme pour les mélomanes. La virtuose Alisa Weilerstein, qui ne s’est plus produite au Festival depuis plus d’une…"
      }
