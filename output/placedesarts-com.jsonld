      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>The Bad Plus est un groupe résolument original. Une formation démocratique avec une vision claire et un refus de se conformer aux conventions. Au cours des deux dernières décennies, ses membres ont joué avec enthousiasme et audace, établissant leurs propres règles avec une créativité et une détermination sans faille. </p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "The Bad Plus"
      }
    ],
