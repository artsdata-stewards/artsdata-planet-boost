    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Au début des années 1900, les travaux de construction d’un pont entre la rive sud et la rive nord du fleuve Saint-Laurent, à proximité de la Ville de Québec, virent à la catastrophe lorsque le pont s’effondre, tuant 33 ouvriers et travailleurs de la communauté mohawk de Kahnawake. Parmi les…"
      }
    ],
