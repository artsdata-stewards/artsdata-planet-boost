      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Monique Désy Proulx presents her latest album, <i>Les herbes folles</i>, a collection of songs written over time that reflect her journey as an artist and a woman. Accompanied on piano and vocals by virtuoso double bassist Étienne Lafrance, and clarinetist and vocalist Hélène Liessens, Monique tells her story.</p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Monique Désy Proulx | Les herbes folles"
      }
