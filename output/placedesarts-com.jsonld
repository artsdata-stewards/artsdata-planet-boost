    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Après nous avoir offert un <i>Hamlet</i> entre danse et théâtre aux côtés de Robert Lepage, le chorégraphe Guillaume Côté met le feu aux poudres dans sa toute nouvelle création pour neuf interprètes.</p>"
      }
    ],
