      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Plongez dans l’univers envoûtant des plus grandes voix et mélodies du monde arabe lors d’un concert exceptionnel, <i>Les Légendes Arabes,</i> présenté par Mazzika Orchestra. Ce spectacle rend hommage aux icônes intemporelles de la musique orientale – des chansons qui ont traversé le temps et marqué des générations.</p>"
      }
    ],
    "http://schema.org/name": [
