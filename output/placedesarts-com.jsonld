    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Chaâbi revisité, jazz manouche, et chansons engagées! Le chanteur compositeur algérien Amine Chibane déploie une tapisserie musicale où langues du monde, rythmes et genres s’entremêlent avec une harmonie fougueuse pour mieux célébrer Amour et Liberté. Sa voix, chaleureuse et rassembleuse, se fait…"
      }
