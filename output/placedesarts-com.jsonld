      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Beethoven et le destin | Maison symphonique"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Pa-pa-pa-pam! Le destin frappe à la porte. Les quatre notes qui lancent la Symphonie n o 5 sont d’une puissance inégalée, tandis que la Symphonie n o 4 est un joyau classique au cœur d’un élan romantique. Quant à la « petite » Symphonie n o 8 , l’humour s’y mêle spontanément au drame, ouvrant la…"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://cdn.placedesarts.com/event/event-transform/_1200x630_crop_center-center_82_none_ns/241017_marathonbeethoven_om_1600x1064.jpg?mtime=1728577281"
      }
    ],
    "http://ogp.me/ns#image:width": [
