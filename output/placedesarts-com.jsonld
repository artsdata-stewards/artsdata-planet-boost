    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le poids des papillons  est le second album de l'auteur-compositeur interprète Alain Tremblay, originaire de l'Isle-aux-coudres dans Charlevoix. Nouvelle sonorité efficace, mais toujours les bons mots pour décrire les émotions.  Entouré de musiciens accomplis (Guy Tourville, Jean-François Beaudet…"
      }
    ],
