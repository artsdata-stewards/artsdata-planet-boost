    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Le père Noël est une ordure | Théâtre Maisonneuve"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Avec Le père Noël est une ordure , Monarque frappe à nouveau un grand coup en faisant revivre sur scène un grand classique français avec, en prime, une distribution exceptionnelle composée des remarquables Jean-Michel Anctil , Mario Jean , Pierre-François Legendre , Claude Prégent , Josée Deschênes…"
      }
    ],
