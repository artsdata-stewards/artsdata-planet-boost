    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Le loup | Théâtre Jean-Duceppe"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Sentant ses souvenirs lui échapper, un homme profite d’un moment de lucidité foudroyant pour faire le ménage de sa vie avant que la maladie n’emporte son esprit. Sa compagne, avec qui il a partagé son quotidien pendant plus de 30 ans, reçoit ces élans de sollicitude de manière inattendue.  D’abord…"
      }
    ],
    "http://ogp.me/ns#image": [
