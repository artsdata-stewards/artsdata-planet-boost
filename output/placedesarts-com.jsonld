    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>The journey promises miles of intense emotions. <i>La Onzième Folie</i> speeds by at full throttle. Lynda Lemay drives fast and with precision. She knows exactly where she’s headed—and she goes where no one else has dared venture: into the deepest corners of the heart.</p>"
      }
    ],
