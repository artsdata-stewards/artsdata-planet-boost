      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.placedesarts.com/evenement/legendaire-andalousie"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Alliant finesse classique et profondeur émotionnelle, la soprano canado-algérienne Fairouz Oudjida sublime les traditions ancestrales, insufflant aux chants hérités une intensité nouvelle. Sa voix puissante épouse les ornementations de la musique andalouse comme autant de joyaux ressuscités, faisant dialoguer les nûbas du Maghreb avec les mouwachahat de l’Orient dans une harmonie intemporelle.</p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Légendaire Andalousie"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@language": "fr",
        "@value": "Festival du Monde Arabe"
      }
    ],
