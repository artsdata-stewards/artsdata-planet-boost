    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Exiled in the United States, Bartók and Korngold poured their longing for home into their concertos—one steeped in Hungarian traditions, the other blending Viennese charm with Hollywood melodies.</p>"
      }
