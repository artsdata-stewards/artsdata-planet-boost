      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Beethoven héroïque | Maison symphonique"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Au programme, la clé de voûte du style symphonique de Beethoven : l’élégance lumineuse de la Symphonie n o 2 , suivie de la colossale Symphonie n o 3 « Eroica ». De l’une à l’autre, le compositeur chemine d’un classicisme le rapprochant du style de Mozart et Haydn à un éclatement de la forme qui…"
      }
    ],
    "http://ogp.me/ns#image": [
