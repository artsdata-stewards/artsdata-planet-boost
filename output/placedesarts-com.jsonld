    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | King Dave | Théâtre Jean-Duceppe"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Une rencontre improbable dans un party, un premier vol, une altercation dans un bar, un incendie dans un parc. Une peine d’amour, une trahison. En quelques jours, presque par accident, la vie de Dave bascule. Submergé par la peine, la colère et la peur, le jeune homme enchaîne les mauvaises…"
      }
    ],
