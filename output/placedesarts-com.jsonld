    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Créée par le scénariste de <i>Schitt’s Creek </i>primé aux Emmy Awards<i>,</i> David West Read, cette nouvelle comédie musicale hilarante renverse complètement le scénario de la plus grande histoire d’amour jamais racontée. <i>& Juliet</i> pose la question : que se passerait-il si Juliette ne mettait pas fin à ses jours à cause de Roméo?</p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "& Juliet"
      }
    ],
