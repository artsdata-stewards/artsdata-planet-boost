    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>In fall 2026, award-winning Canadian singer/songwriter, Loreena McKennitt, will be commemorating the 30th anniversary of her album, <i>The Mask and Mirror</i>, with an extensive tour of Eastern Canada. Widely acclaimed for its ‘cross-cultural fertilization’, the album weaves together Celtic, Spanish and Moroccan influences. </p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Loreena McKennitt | The Mask and Mirror – 30th Anniversary"
      }
    ],
