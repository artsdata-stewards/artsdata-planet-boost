    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>A majestic finale! To close this 2025 edition, the Montreal International Bach Festival Orchestra has invited the Swiss J.S. Bach Choir of St. Gallen (J.S.-Bach-Stiftung St. Gallen) to join in a performance of one of Bach's most important works.</p>"
      }
    ],
