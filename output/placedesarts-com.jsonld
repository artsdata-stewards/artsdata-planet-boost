    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Escapade musicale latino-américaine avec Rafael Payare | Maison…"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "De l’immensité des plaines vénézuéliennes évoquée par la musique impressionniste d’Estévez, au malambo plein de feu du ballet Estancia de l’Argentin Ginastera, en passant par le Brésil de Villa-Lobos, l’OSM présente un éventail très attrayant de musiques tout imprégnées des couleurs et des paysages…"
      }
    ],
