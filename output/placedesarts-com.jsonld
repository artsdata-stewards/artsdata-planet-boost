      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Exilés aux États-Unis, Bartók et Korngold expriment avec émotion la nostalgie de leur terre natale à travers leurs Concertos : influences hongroises chez le premier, réminiscences de l’esprit viennois et mélodies hollywoodiennes chez le second.</p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Éclatante nostalgie : de l'Europe à Hollywood"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@language": "fr",
        "@value": "Orchestre symphonique de Montréal (OSM)"
      }
    ],
    "http://schema.org/performer": [
