    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Tarek Ghriri propose un voyage musical mouvementé à travers l’Inde, le Moyen-Orient et l’Espagne.  Célébrant à travers ses chansons une beauté à plusieurs visages, cet alchimiste des sonorités résilientes rend hommage à ceux qui ont perdu la vie dans la recherche d’un avenir meilleur. "
      }
    ],
