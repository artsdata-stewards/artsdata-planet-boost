    "http://schema.org/url": [
      {
        "@id": "https://www.placedesarts.com/evenement/joshua-redman-group"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p style=\"margin-left:0px;\">Le nouvel album de Joshua Redman, <i>Words Fall Short</i>, marque une évolution naturelle dans son art plutôt qu'un changement radical suite à son précédent album <i>Where Are We</i>. Alors que celui-ci mettait en vedette un chanteur, son nouvel opus s'articule autour de nouvelles compositions inédites, développées pendant la pandémie et interprétées par un quatuor jeune et plein de fraîcheur. </p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Joshua Redman Group"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@language": "fr",
        "@value": "Festival International de Jazz de Montréal"
      }
    ],
    "http://schema.org/performer": [
