    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Le Père Nicolas Noël vous invite à vivre un tout nouveau spectacle musicale festif en compagnie de ses fidèles lutins, Pamalin et Trémaline!</p>"
      }
    ],
