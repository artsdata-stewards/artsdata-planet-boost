      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Chief Xian aTunde Adjuah — anciennement Christian Scott — a remporté deux fois le prix Edison, a été nominé six fois aux Grammy Awards et a reçu le prix Doris Duke dans la catégorie Arts. Il est architecte sonore, trompettiste, multi-instrumentiste, compositeur, producteur, concepteur de technologies innovantes et d'instruments de musique. </p>"
      }
    ],
    "http://schema.org/name": [
