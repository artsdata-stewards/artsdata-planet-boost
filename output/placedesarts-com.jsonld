    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Le voyage promet des kilomètres d’émotions fortes. <i>La Onzième Folie</i> défile à vive allure. Lynda Lemay conduit vite et bien. Elle sait où elle s’en va, et elle va là où personne d’autre n’est allé. Creux dans les chemins du cœur.</p>"
      }
    ],
    "http://schema.org/name": [
