    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Jacques Lacombe et l’OSM en ouverture | Amphithéâtre Fernand-Lindsay"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "C’est l’occasion, tant et si longtemps espérée, d’une réunion sur les cimes entre l’OSM, son ancien premier chef invité Jacques Lacombe, et le public lanaudois. C’est un concert qui évoque la liberté, la force tragique du destin, la transformation perpétuelle du monde – et de nous-mêmes; c’est…"
      }
    ],
