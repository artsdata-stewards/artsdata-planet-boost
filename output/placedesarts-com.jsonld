      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Le mécano de la Génerale en ciné-concert | Maison symphonique"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Partez à l’aventure avec Johnnie et Annabelle à bord de la locomotive The General qui traverse les États-Unis en pleine guerre de Sécession. Ce film muet de 1926, mettant en vedette Buster Keaton et Marion Mack, sera habillé d’une improvisation en direct à l’orgue signée James Kennerley. "
      }
    ],
