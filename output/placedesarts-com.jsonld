    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Les œuvres du compositeur et oudiste Joseph Tawadros se nourrissent aux sources des musiques traditionnelles égyptiennes et de la musique occidentale. Avec l’ensemble Obiora, Tawadros vous conduira à travers des paysages musicaux chatoyants, parfois surprenants, toujours enivrants! Après une…"
      }
    ],
