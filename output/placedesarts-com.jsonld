    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Représentation des afrodescendants sur nos scènes et nos écrans : quels…"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "À l’occasion du Mois de l’histoire des Noirs, un Entretien Arts et Société se penchera sur l’enjeu de la représentation des afrodescendants sur nos scènes et nos écrans, et tentera d’identifier quels sont les progrès des dernières années.   L’animatrice Catherine Perrin s’entretiendra avec Emilie…"
      }
    ],
