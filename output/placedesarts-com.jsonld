    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Les musiciens de l'Orchestre symphonique de Montréal, réunis en formation réduite d'orchestre de chambre, vous offriront un répertoire éclectique couvrant 400 ans d'histoire de la musique instrumentale. Au programme, les œuvres de plusieurs grands compositeurs tels que Gabrieli, Bach, Wirén, Dukas,…"
      }
