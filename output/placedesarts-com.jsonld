    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | De Mozart à Chostakovitch : l’humanité en mouvement | Maison symphonique"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Mozart en visite à Paris lors d’une tournée européenne; Ravel ébloui par l’effervescence de la vie nord-américaine; Chostakovitch assistant au retour des soldats russes en 1945. Dans la joie, la tourmente ou l’espoir, trois œuvres importantes témoignent d’une humanité en mouvement, à la rencontre…"
      }
    ],
