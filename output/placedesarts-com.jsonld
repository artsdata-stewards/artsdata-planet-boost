    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>En farsi et en arabe, zéro se dit « sefr » : le vide. Après avoir exploré les chiffres de 1 à 9 pour parler d’identité sous toutes ses formes, Mani Soleymanlou revient à l’origine de tout avec <i>ZÉRO</i>.</p>"
      }
    ],
