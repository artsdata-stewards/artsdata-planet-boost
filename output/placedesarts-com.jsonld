    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Jean-Marc Parent - L'Évènement JMP | Salle Wilfrid-Pelletier"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Les histoires de Jean-Marc sont surprenantes, émouvantes, intelligentes, drôles… et on ne s’en lasse jamais.  Jean-Marc Parent est authentique et il aime que tout le monde se retrouve dans ses mille et une anecdotes. Un raconteur qui fait des blagues ou un humoriste qui raconte? Il est tout ça à la…"
      }
    ],
