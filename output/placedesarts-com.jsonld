      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Vous pourrez participer à un événement d’importance en assistant à la création des œuvres des quatre lauréats du Prix Azrieli de musique 2024. Évocation des grands paysages canadiens, culture préhispanique mexicaine, livre des Psaumes et philosophie juive : autant de sources d’inspiration et…"
      }
    ],
