    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Nielsen et Bartók : concerto en double | Maison symphonique"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le charme d’une belle mélodie, au violon de Yukari Cousineau, est irrésistible. Et c’est ce que propose le Concerto pour violon de Nielsen : simplicité, bonne humeur et mélodies enivrantes. Comme une transe, chacun des deux mouvements commence avec une lenteur méditative et inquiétante, pour…"
      }
    ],
