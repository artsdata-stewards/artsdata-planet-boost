    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Cysoul 100% live Montreal | Cinquième Salle"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Dans le cadre de sa tournée mondiale, l’artiste camerounais Cysoul dépose ses valises à Montréal pour la toute première fois.   Pour ce spectacle, il interprétera ses deux albums, ainsi que ses deux EPs dans son style pop ethnique. Il aura pour invités le jeune Hen’s, et l’artiste Bel’yv."
      }
    ],
