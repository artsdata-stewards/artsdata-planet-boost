    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Après avoir présenté sa nouvelle revue musicale  Dance of Sands  à Paris, Amsterdam, Madrid, Genève, Marrakech et Casablanca, Aleph revient vous enchanter à Montréal sur la scène du Théâtre Maisonneuve. Un mélange subtil de jazz, de flamenco et d'oriental.  Un spectacle à ne pas manquer!"
      }
