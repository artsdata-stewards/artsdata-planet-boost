    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Lauréat de la 31e édition du concours Ma première Place des Arts, Kourage est un énigmatique personnage qui siphonne son inspiration dans son réservoir d’échecs personnels. Il propose des chansons incarnées qui parfois soignent l’âme, parfois ravivent des blessures sentimentales. </p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Kourage"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@language": "fr",
        "@value": "Société pour l’avancement de la chanson d’expression française"
      }
    ],
