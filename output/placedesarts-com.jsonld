      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Beethoven choral | Maison symphonique"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Vous pourrez ressentir tout le chemin parcouru entre les débuts prometteurs et la finale révolutionnaire d’un parcours inégalé. Les premières mesures de la Symphonie n o 1 laissent déjà entrevoir l’humour insolent du compositeur dont le style atteint son paroxysme dans la Symphonie n o 9 .…"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://cdn.placedesarts.com/event/event-transform/_1200x630_crop_center-center_82_none_ns/241017_marathonbeethoven_om_1600x1064.jpg?mtime=1728577272"
      }
    ],
