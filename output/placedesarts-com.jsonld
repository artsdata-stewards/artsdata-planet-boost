    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "One evening, when he least expects it, Pierre-Yves Roy-Desmarais experiences an event that will change the course of his life.  He tries, as best he can, to keep control of his life, but time becomes blurry, memories start to blend together, and units of measurement stop making sense.  With everything that’s happening to him, he feels like he’s living the equivalent of a full year — in just one year.   Une année en un an is a show combining stand-up, songs, and cheese, lasting 75 centimeters. "
      }
    ],
    "http://schema.org/headline": [
      {
        "@language": "en",
        "@value": "Pierre-Yves Roy-Desmarais | Une année en un an"
      }
    ],
