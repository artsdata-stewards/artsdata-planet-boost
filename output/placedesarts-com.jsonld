    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Enrico Macias | La dernière tournée | Salle Wilfrid-Pelletier"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Après 60 ans de carrière intemporelle, Enrico Macias remonte sur les planches en novembre 2024 pour un dernier tour au Québec!  Construit sur le tempo d’une journée, le spectacle d’Enrico Macias éclot avec ses premiers succès dans une ambiance music-hall; la journée se poursuit jusqu’au soir au son…"
      }
    ],
