      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>David Sedaris — l’humoriste américain par excellence et maître du récit autobiographique — monte sur scène avec son humour tranchant et ses histoires vraies aussi absurdes qu’hilarantes. Auteur à succès de <i>Me Talk Pretty One Day</i>, <i>Calypso</i> et <i>Happy-Go-Lucky</i>, Sedaris a vendu plus de 16 millions de livres à travers le monde. Il est adoré pour sa façon unique de transformer le quotidien en moments inoubliables.</p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Une soirée avec David Sedaris "
      }
    ],
    "http://schema.org/organizer": [
      {
        "@language": "fr",
        "@value": "evenko"
      }
    ],
