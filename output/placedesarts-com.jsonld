    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p style=\"margin-left:0px;\">Les Chambristes du Grand Montréal with a Jazz Trio invite you to step into the magic of the holiday season with <i>A Charlie Brown Christmas</i>. Inspired by the legendary jazz pianist Vince Guaraldi’s iconic album, this concert brings back the warmth and nostalgia of those beloved melodies.</p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "A Charlie Brown Christmas"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@language": "en",
        "@value": "Conservatoire de musique la Montérégie"
      }
    ],
