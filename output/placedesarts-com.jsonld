    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Avec sa voix chaleureuse et bien à lui, Francis Degrandpré, vous transportera dans son univers new country marqué de chasse, de pêche et de plaisir entre ami. Durant son spectacle, à travers les chansons de son premier album, vous ressentirez l’ambiance d’une soirée bien arrosée entre amis autour…"
      }
    ],
