    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Ce concert de clôture du Festival 2023 met en lumière la relation de Tchaïkovski avec sa protectrice Nadezhda von Meck. Découvrez son rôle unique de muse de l'un des plus grands compositeurs romantiques de tous les temps : Piotr Ilitch Tchaïkovski.  En guise d'apothéose de cette 28 e édition du…"
      }
