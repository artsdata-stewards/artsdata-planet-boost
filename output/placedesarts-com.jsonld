    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Alexandre Bisaillon - Toute | Salle Claude-Léveillée"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "« Dans ce spectacle-là, j'ai le goût de parler de toute, toute ce qui me fait rire, toute ce qui m'angoisse, toutes mes travers et toute ce que je suis. En fait j'ai le goût de parler de toute ce que je ne me permettais pas de parler avant d'accepter que toute se dit.    Toute c'est un show…"
      }
    ],
