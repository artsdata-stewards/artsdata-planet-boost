    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Rafael Payare et le lyrisme de Bruckner | Maison symphonique"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Avec Brahms, Bruckner est l’autre grand symphoniste de la fin du XIX e  siècle. Sa Symphonie n  o   7 , véritable joyau de lyrisme aux accents épiques, a fait l’unanimité dès sa création à Leipzig en 1884 et contribué à la renommée de son compositeur. Cette symphonie est un hommage au grand maître…"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
