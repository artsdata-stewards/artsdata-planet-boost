    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Lumières symphoniques : de Ravel à Barber | Maison symphonique"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Dans la version orchestrale du Tombeau de Couperin , créée en 1920, Ravel rend hommage à des amis morts au front à travers quatre danses héritées de la Renaissance, d’une grande chaleur humaine. Toute chaleur semble avoir disparu dans l’œuvre de Lili Boulanger, D’un soir triste , ultime souffle…"
      }
    ],
