    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | L'impérial Concerto pour piano no. 5 de Beethoven | Maison symphonique"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "En y introduisant d’audacieuses innovations, Beethoven engage son ultime Concerto pour piano dans la voie du romantisme. Quant à la relation qui s’instaure entre le soliste et l’orchestre, elle reflète la position du compositeur dans la société du XIX e siècle, un artiste indépendant s’opposant…"
      }
    ],
