    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Depuis maintenant 31 ans, Pink Martini est un moteur inépuisable de joie qui continue de porter la mission de son fondateur Thomas Lauderdale, à savoir la connexion multiculturelle et l'inclusion, sur les scènes légendaires des six continents. </p>"
      }
