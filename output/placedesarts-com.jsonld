    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>This program contrasts Beethoven’s vibrant <i>Symphony No. 8</i> with Shostakovich’s powerful <i>Leningrad Symphony</i>, a poignant work that captures the spirit of resistance to oppression.</p>"
      }
    ],
