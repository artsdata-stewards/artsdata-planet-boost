    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Rejoignez le célèbre violoncelliste, compositeur et chanteur multilingue Ian Maksin pour un autre voyage musical étonnant à la recherche de l'amour et de l'illumination. Inspiré par la musique de Vivaldi, Mozart, Piazzolla et fusionné avec la musique traditionnelle d'Afrique, du Moyen-Orient et des…"
      }
    ],
