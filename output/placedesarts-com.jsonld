    "http://schema.org/url": [
      {
        "@id": "https://www.placedesarts.com/evenement/monique-desy-proulx"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Monique Désy Proulx nous présente ici son tout récent disque,<i> Les herbes folles</i>, une collection de chansons écrites au fil du temps et témoignant d’un parcours d’artiste et de femme. Au piano et à la voix, accompagnée du contrebassiste virtuose Étienne Lafrance, ainsi que de la clarinettiste et choriste Hélène Liessens, Monique se raconte.</p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Monique Désy Proulx | Les herbes folles"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@language": "fr",
        "@value": "Monique Désy Proulx"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Monique Désy Proulx"
