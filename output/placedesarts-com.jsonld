    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Le grandiose Requiem de Verdi | Maison symphonique"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Œuvre aux dimensions théâtrales, le grandiose Requiem de Verdi réunira quatre solistes de renom ainsi qu’un vaste effectif choral et instrumental sous la direction de Rafael Payare. Le lyrisme profond des voix solistes, la puissance du chœur et de l’orchestre ou les effets saisissants du célèbre…"
      }
    ],
