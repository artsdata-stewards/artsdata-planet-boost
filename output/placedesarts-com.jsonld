    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Après trois albums aux textes éloquents, d’une richesse musicale saluée par le public et la critique, Émile Proulx-Cloutier nous éblouit une fois de plus avec sa voix percutante, assumée et émouvante, confirmant qu’il a su définir le son d’un univers musical bien à lui.</p>"
      }
    ],
    "http://schema.org/name": [
