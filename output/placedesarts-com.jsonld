    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>After three albums with eloquent lyrics and musical richness praised by audiences and critics alike, Émile Proulx-Cloutier dazzles us once again with his powerful, confident, and moving voice, confirming that he has defined the sound of a musical universe all his own.<br /> </p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
