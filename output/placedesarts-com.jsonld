    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Place des Arts | Pantelis - Le dernier des vrais | Salle Claude-Léveillée"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "À une époque où une mauvaise blague peut coûter la carrière à un comédien, Pantelis va de l'avant et refuse d'être censuré. Des politiciens aux célébrités, en passant par les amis et la famille, personne n'est à l'abri du ridicule. Pas même Pantelis lui-même. "
      }
    ],
