    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Place des Arts | Les Grands Ballets Dance Vivaldi’s Four Seasons | Amphithéâtre…"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "The tradition continues: after their triumphant Lanaudière performances in 2019 and 2021, Les Grands Ballets return to the Amphitheatre to revisit two phenomenal choreographies acclaimed both by audiences and critics: one set to Mozart’s exquisite Jeunehomme Concerto , and the other, to Vivaldi’s…"
      }
    ]
  },
