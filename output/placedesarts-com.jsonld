    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Place des Arts | Aida: The Season’s Final Bow | Amphithéâtre Fernand-Lindsay"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Aida is among Verdi’s most emblematic operas—unquestionably one of the most beloved of the entire repertoire. This monument combines ill-fated love and political intrigue with the allure of ancient Egypt. Yannick Nézet-Séguin conducts a world-class vocal cast in this opulent conclusion to the…"
      }
    ],
