      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Assistez à cette conférence gratuite de Miloud Chennoufi, professeur de relations internationales et directeur des études supérieures au Collège des Forces canadiennes de Toronto, qui propose d’explorer des questions autour du génocide, en mettant en lumière la difficulté de tracer une frontière claire entre l’horreur vécue et sa reconnaissance institutionnelle.</p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Génocide en direct : comment définir la frontière de l’inhumain?"
      }
