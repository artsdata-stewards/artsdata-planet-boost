      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>En mai, <i>Heroes : Symphonie de jeux vidéo</i> nous plongera, sous la baguette de Kevin Zakresky, dans les plus grands thèmes de jeux vidéo, de <i>Fallout</i> à <i>Assassin’s Creed</i>, en passant par <i>World of Warcraft</i> et <i>Final Fantasy</i> avec des projections et séquences de ces jeux marquants pour plusieurs générations.</p>"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Heroes : Symphonie de jeux vidéo"
      }
