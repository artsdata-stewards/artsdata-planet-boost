      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Établi en 1998, le Quatuor Calder est la fine fleur des quatuors à cordes américains du moment. Il s’arrête pour la première fois à Lanaudière cet été – avec dans ses bagages deux des plus beaux quatuors de Beethoven, dont le magnifique opus 131, œuvre confondante de modernité."
      }
