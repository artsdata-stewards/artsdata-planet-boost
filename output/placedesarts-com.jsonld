    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>Un spectacle de contes originaux qui célèbre ses 20 ans! Construit à partir de récits de vie récoltés en Abitibi : région natale de Renée Robitaille, ce spectacle <i>Hommes de pioche</i> a été présenté à plus de 100 reprises devant des publics de Russie, d’Arménie, du Congo, de Cuba, de la France, de la Suisse et du Canada.</p>"
      }
    ],
