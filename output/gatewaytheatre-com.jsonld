    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Mid-Autumn Festival Celebration"
      }
    ],
    "http://schema.org/keywords": [
      {
        "@language": "en",
        "@value": "family, friendly, celebration, concert, craft, gathering"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Celebrate the full moon at Gateway Theatre’s annual Mid-Autumn celebration. This family-friendly afternoon begins with a delightful concert in the historic Minoru Chapel featuring beloved local performers. Afterwards, continue the festivities with arts and crafts activities for all ages. Rooted in tradition and shared joy, this special gathering invites families and friends to come together and celebrate a holiday honoured across generations."
      }
    ],
