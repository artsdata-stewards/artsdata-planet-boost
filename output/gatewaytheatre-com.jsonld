      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "With equal measures of pluck and positivity, little orphan Annie charms everyone’s hearts despite a next-to-nothing start in 1930s New York City. With unforgettable songs like “Tomorrow” and “Hard Knock Life,” Annie is the timeless Broadway classic that brings joy, laughter, and holiday cheer — and features a real, live dog as Annie’s beloved Sandy! It’s the perfect holiday outing. Fun for kids, nostalgic for parents, grandparents, and a feel-good tradition for everyone."
      }
    ],
