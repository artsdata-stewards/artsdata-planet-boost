    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "In celebration of Richmond Pride week, Gateway Theatre presents True Voices, a free community event of live storytelling from members of the LGBTQ2S+ community. Gather together as storytellers share personal experiences filled with humour, honesty, and resilience, followed by a Q&A over tea."
      }
