      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "She Shoots, She Scores!"
      }
    ],
    "http://schema.org/keywords": [
      {
        "@language": "en",
        "@value": "hockey, kids, book, women, girls, family, all ages"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "She Shoots, She Scores! tells the story of a determined girl who challenges expectations by pursuing her love of hockey. The play is inspired by a book by hockey legend Cammi Granato, and looks at teamwork, confidence, perseverance, and personal accountability. Featuring actors playing multiple roles, the production is physical, fast-paced, and inventive. She Shoots, She Scores! is an inspiring and joyful experience - not just for hockey fans, but for any young person finding the courage to try something new."
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "en",
        "@value": "00:55:00"
      }
