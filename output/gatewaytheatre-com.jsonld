    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Silk Road Music: Lunar New Year Celebration"
      }
    ],
    "http://schema.org/keywords": [
      {
        "@language": "en",
        "@value": "chinese folk music, classical music, fusion music "
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Celebrate Lunar New Year with the award-winning Silk Road Music! Join us for a celebratory concert, blending the rich traditions of Asian and non-Asian music. For over two decades, Silk Road Music’s pioneering musical fusions have blended Chinese folk and classical music with jazz, blues, Brazilian, Celtic, Spanish, Arabic and Aboriginal music to create a unique sound. Don’t miss this unforgettable performance that promises to enchant, showcasing the harmonious fusion of East and West."
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "en",
