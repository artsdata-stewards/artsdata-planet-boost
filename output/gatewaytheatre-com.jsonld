    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Wildwoman"
      }
    ],
    "http://schema.org/keywords": [
      {
        "@language": "en",
        "@value": "regal, royal history, history drama, beauty and the beast"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Catherine de Medici, young newlywed to King Henry II, expects a life of politics—but court is a cruel world where her only role is to bear heirs. Surrounded by rivals, she finds unexpected kinship with a wild, imprisoned man who awakens her feral side. Once unleashed, no one is safe. Based on the true story that inspired Beauty and the Beast, Kat Sandler’s Wildwoman is a sexy, viciously funny thrill ride about what happens when we let the monster out."
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "en",
        "@value": "02:30:00"
      }
    ],
