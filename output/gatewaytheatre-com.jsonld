    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Ms. Holmes & Ms. Watson - Apt. 2B"
      }
    ],
    "http://schema.org/keywords": [
      {
        "@language": "en",
        "@value": "sherlock holmes, holmes, mystery, comedy, farce"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "This sharp and comedic reinvention of the classic detective tale is exactly what you’re looking for this fall. Join us for this modern take, following the eccentric Sherlock Holmes and Joan Watson as they stumble through post-pandemic life, solving crimes with chaotic brilliance. Watch as their dysfunctional partnership comes to life, as they face a cunning supervillain who just might have all the answers."
      }
    ],
