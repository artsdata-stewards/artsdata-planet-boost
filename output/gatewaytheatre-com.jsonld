    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Secret Ingredients"
      }
    ],
    "http://schema.org/keywords": [
      {
        "@language": "en",
        "@value": "cake, ingredients, deliver, messages, comedy, intimate"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "A playful and experimental theatre performance that uses cake to explore the quirks, nuances, joy and heartache of human relationships. Like overhearing tantalizing gossip at a small cafe, this intimate show satisfies an itch to peek into relatable details of other people's lives while also inviting reflection on our own unspoken feelings."
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "en",
        "@value": "01:10:00"
      }
