    "http://schema.org/keywords": [
      {
        "@language": "en",
        "@value": "singing, dancing, tap, music, musical, family, all ages"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "A Tony Award-Winning, tap dancing musical spectacular. Peggy Sawyer is a small-town girl with big Broadway dreams. When she arrives in New York City, she lands her first role in a glitzy new musical on Broadway. When the show's leading lady breaks her ankle just before opening night, Peggy gets her chance in the spotlight and just watch her shine. With high-energy choreography, sensational tap numbers, and a dazzling story full of optimism and ambition, 42nd Street celebrates Broadway, Times Square and old-school showbiz charm with wit, humour and glamour."
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "en",
        "@value": "02:30:00"
