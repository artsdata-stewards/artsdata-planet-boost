      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Step into one of Richmond's most beloved heritage sites, the Minoru Chapel, and be transported into the exhilarating world of Songs for a New World, an intimate song cycle of the first musical by Tony Award winner Jason Robert Brown. This unique theatrical show weaves together a series of characters, each standing on the precipice of change, navigating the unknown with courage, fear and determination."
      }
    ],
