        "@value": "La Société nationale du Québec à Laval (SNQ Laval), par son initiative de dialogue interculturel l'Assemblement, se joint à la Table de concertation des afrodescendants de Laval, ses membres et Les Artistes de Réminescences pour célébrer l'ouverture du Mois de l'Histoire des Noirs 2026 à Laval."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventCancelled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
