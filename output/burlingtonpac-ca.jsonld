    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Canadian Arabic Orchestra Marwan Khoury &#038; The Canadian Arabic Orchestra"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Experience an unforgettable night of music and emotion as the renowned Lebanese singer, composer, and songwriter Marwan Khoury takes the stage at the Burlington Performing Arts Centre on October 25, 2025, at 7:30 PM — joined by the talented ensemble of the Canadian Arabic Orchestra. Known for his soulful voice and timeless hits, Marwan Khoury&hellip;"
      }
    ],
