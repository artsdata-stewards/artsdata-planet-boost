    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Burlington Symphony Orchestra: Music of Thanksgiving"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Join the BSO as we celebrate the season of Thanksgiving with the music of Beethoven, Vivaldi, Benjamin (Daniel Wang, Oboe) and Gershwin’s Rhapsody in Blue: (Talisa Blackman, piano) Show Length Act 1: 55 mins. Intermission: 20 min. Act 2: 50 mins."
      },
      {
        "@language": "en",
        "@value": "Join the BSO as we celebrate the season of Thanksgiving with the music of Beethoven, Vivaldi, Benjamin (Daniel Wang, Oboe) and Gershwin’s Rhapsody in Blue: (Talisa Blackman, piano) Show Length&hellip;"
      }
    ],
