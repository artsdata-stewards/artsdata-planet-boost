    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Bounty Enterprises Inc Hotel California: The Best of the Eagles"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "When The Eagles stopped to catch their breath a few decades ago, having sold over 100 million records, collected six Grammy’s, and enjoyed six #1 albums, Hotel California began a pioneering journey through their history-making music that has taken them around the globe and thrilled hundreds of thousands of Eagles fans. It’s been a journey they could never have&hellip;"
      },
      {
        "@language": "en",
        "@value": "When The Eagles stopped to catch their breath a few decades ago, having sold over 100 million records, collected six Grammy’s, and enjoyed six #1 albums, Hotel California began a pioneering journey through their&hellip;"
      }
    ],
