    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Magic Men Australia: Larger Than Life World Tour 2025 Featuring Will Parfitt"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;We just made history… and now it’s your turn. The Magic Men Australia “Larger than life” WORLD TOUR is storming into town for ONE UNFORGETTABLE NIGHT — and trust us, you do not want to miss what everyone will be talking about! Fresh off BREAKING A WORLD RECORD in Scandinavia for the largest ladies’ night&hellip;&lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": "Organization"
      }
    ],
