    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "CULTURE DAYS"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "CELEBRATE CULTURE DAYS AT THE BPAC! BPAC is proud to join the nationwide Culture Days celebration with a full day of FREE performances, tours and arts activities! Plan to start your day with yoga and meditation in the BPAC lobby and then choose your own adventure from there! BPAC’S CULTURE DAYS SCHEDULE YOGA @ BPAC&hellip;"
      },
      {
        "@language": "en",
        "@value": "CELEBRATE CULTURE DAYS AT THE BPAC! BPAC is proud to join the nationwide Culture Days celebration with a full day of FREE performances, tours and arts activities! Plan to start&hellip;"
