        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "State Ballet Theatre of Ukraine: Swan Lake - The Burlington Performing Arts Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "The magician Rothbart turns the beautiful Odette and her friends into swans, and only at night do they turn into humans. Only boundless and sincere love can break this spell.…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
