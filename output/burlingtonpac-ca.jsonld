        "@language": "en-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "RHAPSODY IN BLUE A GERSHWIN CELEBRATION - The Burlington Performing Arts Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Featuring ADRIANNE PIECZONKA, DANIEL VNUKOWSKI, JONELLE SILLS, JUSTIN WELSH and STEPHANE MAYER 2024 marks the 100th anniversary of Rhapsody in Blue, the first composition to successfully combine classical music and jazz.…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
