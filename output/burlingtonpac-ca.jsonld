        "@value": "Southern Ontario Lyric Opera Tosca"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The beauty and power of Puccini’s beloved opera “Tosca” has forever captured the hearts of music lovers everywhere and will be performed fully staged with full orchestra. Come and experience the passion and magic of live opera! Sabatino Vacca, Conducto Show Length Act I: 45 min Intermission: 20 min Act II: 45 min Intermission: 20&hellip;"
      },
      {
        "@language": "en",
        "@value": "The beauty and power of Puccini’s beloved opera “Tosca” has forever captured the hearts of music lovers everywhere and will be performed fully staged with full orchestra. Come and experience&hellip;"
      }
    ],
