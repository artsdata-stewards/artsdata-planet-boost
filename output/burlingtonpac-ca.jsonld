    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Paquette Productions Presents Walk Right Back: The Everly Brothers Story"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;DIRECT FROM THE UK! Following an incredible sell out tour, Walk Right Back returns to stages in 2025 by popular demand. From the producers of the UK’s smash hit show That’ll Be The Day, this phenomenal production tells the story of the most successful musical duo of all time – The Everly Brothers. Featuring hits&hellip;&lt;/p&gt;\\n"
      }
    ],
