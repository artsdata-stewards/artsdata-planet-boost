    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Perfect for the whole family, this world-class performance combines grand illusions, comedy-magic, and mind-bending mentalism. Based on a true story about a historic Ottawa Valley home lovingly restored and named…"
