      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "CHOIR! CHOIR! CHOIR!Hallelujah: An EPIC Anthem Sing-Along! - The Burlington Performing Arts Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "“Why see a show when you can BE the show!” Choir! Choir! Choir! is the fully interactive, participatory show that turns audience into performer! So get ready to laugh, dance and…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
