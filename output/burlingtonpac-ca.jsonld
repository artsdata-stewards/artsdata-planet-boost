    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Featuring ADRIANNE PIECZONKA, DANIEL VNUKOWSKI, JONELLE SILLS, JUSTIN WELSH and STEPHANE MAYER 2024 marks the 100th anniversary of Rhapsody in Blue, the first composition to successfully combine classical music and jazz.&hellip;"
      }
