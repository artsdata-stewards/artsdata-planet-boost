    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Dancing Storytime Workshop / Danse à l&#8217;heure du compte (Riley Park)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;This Dancing Storytime is for children 8 years and younger and their caregivers. This 45-minute workshop led by Riley Park Fieldhouse artists in residence includes a story and lots of movement games inspired by trees [&hellip;]&lt;/p&gt;\\n"
      }
