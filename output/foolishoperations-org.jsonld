    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Description: With attention to lineages, attribution, and accessibility in improvisation practice, participants will explore Lower Left\\'s Ensemble Thinking: a system of improvisational compositional group scores that increase capacity for collaborative creation. Dancers will explore Ensemble Thinking\\'s [&hellip;]&lt;/p&gt;\\n"
