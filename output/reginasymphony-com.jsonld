  {
    "@id": "_:g1571600",
    "@type": [
      "https://schema.org/BlogPosting"
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "\n\n{\n  \"@context\": \"http://schema.org\",\n  \"@type\": \"Event\",\n  \"name\": \"DANCING QUEEN THE MUSIC OF ABBA\",\n  \"startDate\": \"2025-10-18T19:30\",\n  \"location\": {\n    \"@type\": \"Place\",\n    \"name\": \"Conexus Arts Centre\",\n    \"address\": {\n      \"@type\": \"PostalAddress\",\n      \"streetAddress\": \"200 Lakeshore Drive\",\n      \"addressLocality\": \"Regina\",\n      \"addressRegion\": \"Saskatchewan\",\n      \"postalCode\": \"S4S 7L3\"\n    }\n  },\n  \"image\": \"https://reginasymphony.com/wp-content/uploads/2025/05/2526-Website-Event-Listings-1.png\",\n  \"description\": \"Put on your dancing shoes—this is ABBA like you’ve never heard it before!</SPAN></P>\\n<P class=\\\"cvGsUA direction-ltr align-justify para-style-body\\\"><SPAN class=\\\"OYPEnA font-feature-liga-off font-feature-clig-off font-feature-calt-off text-decoration-none text-strikethrough-none\\\">Get ready for Dancing Queen, an electrifying symphonic tribute to one of the most iconic pop groups of all time. This high-energy evening brings the unforgettable hits of ABBA to life in spectacular style, featuring the powerhouse performers of Jeans ‘n Classics alongside your symphony orchestra.\",\n  \"url\": \"https://purchase.reginasymphony.com/ChooseSeats/2601\",\n  \"performer\": [\n    {\n      \"@type\": \"Person\",\n      \"name\": \"Gordon Gerrard, conductor\"\n    },\n    {\n      \"@type\": \"Person\",\n      \"name\": \"Jean ‘n Classics, guest artists\"\n    }\n  ]\n}\n"
      }
    ]
  },
  {
    "@id": "_:g1571640",
    "@type": [
      "https://schema.org/ImageObject"
    ],
    "https://schema.org/thumbnailUrl": [
      {
        "@id": "https://reginasymphony.com/wp-content/uploads/2025/10/Music-on-the-Road-Moose-Jaw-2526-3-824x1030.webp"
      }
    ]
  },
  {
    "@id": "_:g1571660",
    "@type": [
      "https://schema.org/BlogPosting"
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "DATE: Thursday, December 4, 2025\nTIME: 7:30 pm\nLOCATION: Mae Wilson Theatre\n217 Main St North\nMoose Jaw\n"
      }
    ]
  },
  {
    "@id": "_:g1571700",
    "@type": [
      "https://schema.org/BlogPosting"
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "The Regina Symphony Chamber Players\n"
      }
    ]
  },
  {
    "@id": "_:g1571740",
    "@type": [
      "https://schema.org/BlogPosting"
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "\n\n\n\nA Classical Christmas at the Mae Wilson Theatre in Moose Jaw.\n\n\nThe Regina Symphony Chamber Players are hitting the road to bring the magic of the holidays to Moose Jaw! Join us at the beautiful Mae Wilson Theatre on December 4 at 7:30 pm for A Classical Christmas — an evening filled with festive cheer and timeless music.\n\n\nEnjoy a warm and elegant holiday concert featuring beloved seasonal classics and sparkling chamber works performed by members of your Regina Symphony Orchestra. Celebrate the most wonderful time of the year with the rich sound of live classical music in the heart of downtown Moose Jaw.\n\n\nA perfect way to welcome the holiday season — festive, familiar, and full of joy!\n\n\n\nPart of Music on the Road\n\n\n\n"
      }
    ]
  },
  {
    "@id": "_:g1571780",
    "@type": [
      "https://schema.org/BlogPosting"
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "\n\n\nPROGRAMME\nPyotr Ilyich Tchaikovsky – Waltz from Sleeping Beauty\nFrederick Delius – Three Small Tone Poems • Winter Night (Sleigh Ride)\nClaude Debussy – Children’s Corner – Suite I • Serenade of the Doll • The Little Shepherd • Golliwogg’s Cake-Walk\nClaude Debussy – Children’s Corner – Suite II • Jumbo’s Lullaby • The Snow is Dancing • Doctor Gradus ad Parnassum\nAlexander Borodin – In the Steppes of Central Asia\nAlexander Borodin – Polovtsian Dances • Dance of the Polovtsian Maidens • Polovtsian Dance with Chorus\nPyotr Ilyich Tchaikovsky – Selections from The Nutcracker Suite, Op. 71a • Overture Miniature • Marche • Danse russe: Trépak • Danse arabe • Danse chinoise • Les Mirlitons • Valse des Fleurs\n\n\n\n\n\n"
      }
    ]
  },
  {
    "@id": "_:g1571900",
    "@type": [
      "https://schema.org/ImageObject"
    ],
    "https://schema.org/thumbnailUrl": [
      {
        "@id": "https://reginasymphony.com/wp-content/uploads/2025/09/Dotdigital-Headers-2400-x-800-px-3-1030x343.png"
      }
    ]
  },
  {
    "@id": "http://www.reginasymphony.com/temporary/77c74dc6-dad8-454f-85c5-a1c15c52226d",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g1568020"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://reginasymphony.com/wp-content/uploads/2025/05/2526-Website-Event-Listings-1.png"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://purchase.reginasymphony.com/ChooseSeats/2601"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "_:g1568060"
      },
      {
        "@id": "_:g1568080"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://reginasymphony.com/mj-christmas/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "DANCING QUEEN THE MUSIC OF ABBA"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Put on your dancing shoes—this is ABBA like you’ve never heard it before!</SPAN></P>\n<P class=\"cvGsUA direction-ltr align-justify para-style-body\"><SPAN class=\"OYPEnA font-feature-liga-off font-feature-clig-off font-feature-calt-off text-decoration-none text-strikethrough-none\">Get ready for Dancing Queen, an electrifying symphonic tribute to one of the most iconic pop groups of all time. This high-energy evening brings the unforgettable hits of ABBA to life in spectacular style, featuring the powerhouse performers of Jeans ‘n Classics alongside your symphony orchestra."
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-10-18T19:30:00"
      }
    ]
