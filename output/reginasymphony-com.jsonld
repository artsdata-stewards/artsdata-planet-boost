      {
        "@language": "en",
        "@value": "function insertAcknowledgement() {\n    var paragraph = document.createElement('p');\n    \n    paragraph.textContent = 'The Regina Symphony Orchestra acknowledges that we are on Treaty 4 Territory, which is the traditional territory of the Cree, Saulteaux, Dakota, Nakoda, and Lakota Peoples, and the homeland of the Métis. In the spirit of reconciliation and collaboration, we commit to moving forward in partnership with the Indigenous people who live here and across Canada.';\n    \n    var socketElement = document.getElementById('socket');\n    \n    if (socketElement) {\n        socketElement.appendChild(paragraph);\n    }\n}\n\nwindow.onload = function() {\n  document.getElementById(\"getYear\").innerHTML = new Date().getFullYear();\ninsertAcknowledgement();\n}"
      }
    ]
  },
