  {
    "@id": "_:g1523140",
    "@type": [
      "https://schema.org/BlogPosting"
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "\n\n{\n  \"@context\": \"http://schema.org\",\n  \"@type\": \"Event\",\n  \"name\": \"DANCING QUEEN THE MUSIC OF ABBA\",\n  \"startDate\": \"2025-10-18T19:30\",\n  \"location\": {\n    \"@type\": \"Place\",\n    \"name\": \"Conexus Arts Centre\",\n    \"address\": {\n      \"@type\": \"PostalAddress\",\n      \"streetAddress\": \"200 Lakeshore Drive\",\n      \"addressLocality\": \"Regina\",\n      \"addressRegion\": \"Saskatchewan\",\n      \"postalCode\": \"S4S 7L3\"\n    }\n  },\n  \"image\": \"https://reginasymphony.com/wp-content/uploads/2025/05/2526-Website-Event-Listings-1.png\",\n  \"description\": \"Put on your dancing shoes—this is ABBA like you’ve never heard it before!</SPAN></P>\\n<P class=\\\"cvGsUA direction-ltr align-justify para-style-body\\\"><SPAN class=\\\"OYPEnA font-feature-liga-off font-feature-clig-off font-feature-calt-off text-decoration-none text-strikethrough-none\\\">Get ready for Dancing Queen, an electrifying symphonic tribute to one of the most iconic pop groups of all time. This high-energy evening brings the unforgettable hits of ABBA to life in spectacular style, featuring the powerhouse performers of Jeans ‘n Classics alongside your symphony orchestra.\",\n  \"url\": \"https://purchase.reginasymphony.com/ChooseSeats/2601\",\n  \"performer\": [\n    {\n      \"@type\": \"Person\",\n      \"name\": \"Gordon Gerrard, conductor\"\n    },\n    {\n      \"@type\": \"Person\",\n      \"name\": \"Jean ‘n Classics, guest artists\"\n    }\n  ]\n}\n"
      }
    ]
  },
  {
    "@id": "_:g1523180",
    "@type": [
      "https://schema.org/ImageObject"
    ],
    "https://schema.org/thumbnailUrl": [
      {
        "@id": "https://reginasymphony.com/wp-content/uploads/2025/05/Connect-Instantly-to-8-824x1030.png"
      }
    ]
  },
  {
    "@id": "_:g1523200",
    "@type": [
      "https://schema.org/BlogPosting"
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "DATE: Thursday, October 30, 2025\nTIME: 6:30 pm\nLOCATION: Darke Hall\n2255 College Ave\nRegina, Saskatchewan S4P 0S9\n"
      }
    ]
  },
  {
    "@id": "_:g1523240",
    "@type": [
      "https://schema.org/BlogPosting"
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "Maria Fuller, conductor\n"
      }
    ]
  },
  {
    "@id": "_:g1523280",
    "@type": [
      "https://schema.org/BlogPosting"
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "\n\n\nJoin us for a family-friendly Halloween concert filled with tricks, treats, and toe-tapping tunes. Costumes are encouraged! Whether you’re a pumpkin, princess, or pirate, you’ll fit right in! A hauntingly good time for parents and kids of all ages.\n\n\n\n\n\n"
      }
    ]
  },
  {
    "@id": "_:g1523320",
    "@type": [
      "https://schema.org/BlogPosting"
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "\n\n\nMUSIC FROM:\nThe Mask of ZorroThe Lion KingK Pop Demon Hunters\nPirates of the Caribbean: Curse of the Black Pearl The Little MermaidFrozenTaylor SwiftThe Avengers\n\n\n\n\n\n"
      }
    ]
  },
