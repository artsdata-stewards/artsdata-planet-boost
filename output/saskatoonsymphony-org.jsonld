        "@id": "https://saskatoonsymphony.org/event/christmas-with-the-sso-2/"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://saskatoonsymphony.org/event/christmas-with-the-sso-2/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "A Night at the North Pole"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "A musical Christmas party full of surprises, Holiday hits, nog, and the SSO!"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
  {
    "@id": "https://www.saskatoonsymphony.org/temporary/f7fc1a0a-d127-4f2c-af69-2a15c7b4b805",
    "@type": [
      "https://schema.org/Blog"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://saskatoonsymphony.org/event/christmas-with-the-sso-2/"
      }
    ]
  },
  {
    "@id": "https://www.saskatoonsymphony.org/temporary/cdf2380f-a285-4627-902b-0c2a88240f65",
    "@type": [
      "https://schema.org/CreativeWork"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://saskatoonsymphony.org/event/christmas-with-the-sso-2/"
      }
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "\n\t\t\t\n\n\n7:30PM, Saturday, December 5, 2020\nSaskatoon Symphony Orchestra\n\n\n602 B 51st Street\nSaskatoon, Saskatchewan S7K 7K3\nGoogle Maps Directions\n\n\n$15\nDigital Ticket\n\n\n\nSaskatoon Symphony Orchestra\nWilliam Rowson, conductor \nBy this point, we’re all going to need a little Christmas!\nDon your Christmas sweaters and other gay apparel as the SSO rings in the season with your holiday favourites.\nWilliam Rowson returns to lead his hometown orchestra in a night of Christmas Pops. We’ve tried to pack in as many fun holiday hits as possible!\nThe SSO Brass join the show with some beloved brassy classics.\nWe need a little laughter, so it’s a Christmas Festival that only the SSO can give you!\n \nEach concert will be available for live stream and video on demand through our new Digital Concert Stream.\n[button link=”https://app.arts-people.com/index.php?show=112232″ border=”#5c1b5c”]Buy a Digital Ticket – Livestream[/button]\n[button link=”https://app.arts-people.com/index.php?buy_pass=saso” bg_color=”#5c1b5c”]Subscribe to the Digital Concert Stream[/button]\nWhile we’re on our musical trips there’ll be all sorts of special travel perks and virtual experiences through our InTune Blog!\n♫Listen to Orchestral Christmas Music\n \n\n\n\t\t"
      }
    ]
  },
