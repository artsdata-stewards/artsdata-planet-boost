        "@language": "en",
        "@value": "Sing-Along Messiah"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The SSO's favourite concert of the year!  Enjoy the performances of our Messiah soloists while being part of the music along with a choir of hundreds!"
      }
    ],
