      }
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "\n\t\t\t\n\n\n2:00PM, Sunday, May 11, 2025\nGrosvenor Park Church\n\n\n407 Cumberland Ave S\nSaskatoon, Saskatchewan S7H 2L3\nGoogle Maps Directions\n\n\nFREE EVENT\n\n\n\nCelebrate Mothers’ Day with a Sunday afternoon concert featuring the SSO Chamber Ensemble! Whether you are bringing the moms in your life, your friends, or just looking to enjoy beautiful music, this concert is a delightful way to spend an hour on Sunday, May 11th.\n\n\nThis is a free event.\n\n \n\n\n\n\t\t"
      }
    ]
  },
