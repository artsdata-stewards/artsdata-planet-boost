    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "\n\t\t\t\n\n\n10:00AM, Thursday, October 20, 2022\nSaskatoon Symphony Orchestra\n\n\n602 B 51st Street\nSaskatoon, Saskatchewan S7K 7K3\nGoogle Maps Directions\n\n\n\n\n10:00AM, Friday, October 21, 2022\nSaskatoon Symphony Orchestra\n\n\n602 B 51st Street\nSaskatoon, Saskatchewan S7K 7K3\nGoogle Maps Directions\n\n\n\n\n10:00AM, Saturday, October 22, 2022\nSaskatoon Symphony Orchestra\n\n\n602 B 51st Street\nSaskatoon, Saskatchewan S7K 7K3\nGoogle Maps Directions\n\n\n\n\n10:00AM, Sunday, October 23, 2022\nSaskatoon Symphony Orchestra\n\n\n602 B 51st Street\nSaskatoon, Saskatchewan S7K 7K3\nGoogle Maps Directions\n\n\n\n\n\n\nThursday, Oct 20 to Sunday, Oct 23\n10 AM – 5 PM daily\n602B 51st Street E, Saskatoon, SK S7K 7K3\nEntrance around back with parking available by entrance to the SSO office. There is also street parking available on Miners Ave and 1st Ave N. Please note, you cannot access the sale via the SSO office entrance, you must use the back entrance.\nThe SSO Book & Music Sale is having its annual Sale. We have too much stuff!\n4 days of great deals to help us make room in our warehouse.\nProceeds support the Saskatoon Symphony Orchestra.\nFor more information please visit HERE!\n\n\n\n\t\t"
      }
    ]
  },
