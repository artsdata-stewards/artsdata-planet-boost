  {
    "@id": "https://www.saskatoonsymphony.org/temporary/8c9274f4-c241-402f-adab-1002aff96851",
    "@type": [
      "https://schema.org/CreativeWork"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://saskatoonsymphony.org/event/time-for-toddlers-5/"
      }
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "\n\t\t\t\n\n\n10:00AM, Friday, September 30, 2022\nNutrien Wonderhub\n\n\n950 Spadina Crescent E\nSaskatoon, SK S7K 3H6\nGoogle Maps Directions\n\n\nfrom $12\n\n\n11:15AM, Friday, September 30, 2022\nNutrien Wonderhub\n\n\n950 Spadina Crescent E\nSaskatoon, SK S7K 3H6\nGoogle Maps Directions\n\n\nfrom $12\n\n\n1:30PM, Sunday, October 2, 2022\nNutrien Wonderhub\n\n\n950 Spadina Crescent E\nSaskatoon, SK S7K 3H6\nGoogle Maps Directions\n\n\nfrom $12\n\n\n2:45PM, Sunday, October 2, 2022\nNutrien Wonderhub\n\n\n950 Spadina Crescent E\nSaskatoon, SK S7K 3H6\nGoogle Maps Directions\n\n\nfrom $12\n\n\n\nAll sessions of this event are full.\nTime for Toddlers!\nCounting 1234!\nFriday Sept 30 10:00 am & 11:15 am\nSunday Oct 2 1:30 pm & 2:45 pm\nCounting 1234! – Calling all mini-maestros! Come and count along with the Saskatoon\nSymphony Core Musicians as we explore counting, numbers, and rhythm while moving to music\nfrom Bach, Strauss, and Bizet. We’ll even do some conducting!\nJoin us in the basement of the Nutrien Wonderhub!\nTickets are required for participating children only.\n\n\n\t\t"
      }
    ]
  },
