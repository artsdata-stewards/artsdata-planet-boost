        "@value": "Idea of North"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Jan Lisiecki and Rune Bergmann open the Northern Lights Festival with Grieg's Piano Concerto."
      }
    ],
    "http://schema.org/eventStatus": [
