        "@language": "en",
        "@value": "Thomas Yu with the SSO"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Thomas Yu returns home to perform Saint-Saëns' Egyptian concerto alongside Nicole Lizee's Behind the Sound of Music"
      }
    ],
