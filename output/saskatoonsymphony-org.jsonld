    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Mozart ReReimagined"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "In March of 2020 the artists were ready to fly in and we had this unique collaborative project ready to go....so to bring it to life we've re-reimagined Mozart!\n\nThe SSO teams up with Saskatoon Opera to create a new theatrical work centred around reimagining the music and stories of Mozart.\n\nSaskatchewan composers Kendra Harder, Danika Lorèn, …"
      }
    ],
