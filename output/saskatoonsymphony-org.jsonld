        "@value": "Sleeping Beauty"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "A romantic Valentine's weekend with Maestra Judith Yan and violinist Timothy Chooi. Featuring Tchaikovsky’s The Sleeping Beauty and Bruch's Scottish Fantasy."
      }
    ],
    "http://schema.org/eventStatus": [
