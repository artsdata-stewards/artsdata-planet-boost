    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "\n\t\t\t\n\n\n10:00AM, Friday, September 19, 2025\nNutrien Wonderhub\n\n\n950 Spadina Crescent E\nSaskatoon, SK S7K 3H6\nGoogle Maps Directions\n\n\nSOLD OUT\n\n\n11:15AM, Friday, September 19, 2025\nNutrien Wonderhub\n\n\n950 Spadina Crescent E\nSaskatoon, SK S7K 3H6\nGoogle Maps Directions\n\n\nRegister\n\n\n10:00AM, Saturday, September 20, 2025\nNutrien Wonderhub\n\n\n950 Spadina Crescent E\nSaskatoon, SK S7K 3H6\nGoogle Maps Directions\n\n\nSOLD OUT\n\n\n11:15AM, Saturday, September 20, 2025\nNutrien Wonderhub\n\n\n950 Spadina Crescent E\nSaskatoon, SK S7K 3H6\nGoogle Maps Directions\n\n\nCANCELLED\n\n\n\nCounting 1234! – Calling all mini-maestros! Come and count along the with Saskatoon Symphony Core Musicians as we explore counting, numbers and rhythm while moving to music from Bach, Strauss, and Bizet. We’ll even do some conducting!\nSpecifically designed for your mini-maestro, these parent and child experiences are perfect for your 2- to 4-year-old music lover.\nExplore music through movement, song and dance with SSO musicians. Let the music connect you and your child and send you both on a journey through melody, rhythm, colour, and beautiful sound.\n\n\n\t\t"
      }
    ]
  },
