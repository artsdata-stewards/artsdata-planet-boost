  {
    "@id": "https://www.saskatoonsymphony.org/temporary/38fe2b5d-d493-40eb-8e78-8ad1ce44155f",
    "@type": [
      "https://schema.org/CreativeWork"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://saskatoonsymphony.org/event/music-talk-with-vincent-ho/"
      }
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "\n\t\t\t\n\n\n7:00PM, Tuesday, November 21, 2023\nDervilia Designs\n\n\n465 1st Ave N\nSaskatoon, SK S7K 1X5\nGoogle Maps Directions\n\n\nRSVP\n\n\n\nJoin us for a very special Music Talk with renowned composer Vincent Ho. The SSO is giving the world premiere of his new concerto for saxophone and orchestra on November 25th with Grammy winner Timothy McAllister. The SSO’s Mark Turner talks with Vincent and our conductor Robert Franz ahead of this special performance.\nThis is a free event that requires RSVP.\n\n\n\t\t"
      }
    ]
  },
