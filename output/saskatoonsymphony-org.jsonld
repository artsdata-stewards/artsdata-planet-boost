      }
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "\n\t\t\t\n\n\n7:30PM, Monday, October 27, 2025\nThe Bassment\n\n\n202 4th Ave N\nSaskatoon, SK S7K 0K1\nGoogle Maps Directions\n\n\nSave Your Seats\n\n\n\nJoin some of Saskatoon’s finest singers as they lean into the Halloween week with a villains and bad guys edition of opera pub.\nWe’re back at the Bassment for this fun night of pre-trick or treating!\nThis event is sponsored by Cassandra and James Stinn of the Saskatoon Music Academy.\n\n\n\t\t"
      }
    ]
  },
