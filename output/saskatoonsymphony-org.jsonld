    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Spring Fever"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Maestra Tania Miller joins us to shake off your winter blues with Schumann’s “Spring”. Our own Stephanie Unverricht takes centre stage for Mozart’s Bassoon Concerto paired with some Beethoven and Vaughan Williams."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
  {
    "@id": "https://www.saskatoonsymphony.org/temporary/25f13134-5ba0-4bd8-a7f9-6227baff66f1",
    "@type": [
      "https://schema.org/Blog"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://saskatoonsymphony.org/event/spring-fever/"
      }
    ]
  },
  {
    "@id": "https://www.saskatoonsymphony.org/temporary/06e19a1f-3aa1-4531-bfab-9c9d8523e3e8",
    "@type": [
      "https://schema.org/WPHeader"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://saskatoonsymphony.org/event/spring-fever/"
      }
    ]
  },
  {
    "@id": "https://www.saskatoonsymphony.org/temporary/66107c48-8a0f-4298-b96a-dc4f943a75dd",
    "@type": [
      "https://schema.org/CreativeWork"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://saskatoonsymphony.org/event/spring-fever/"
      }
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "\n\t\t\t\n\n\n7:30PM, Saturday, March 7, 2026\nTCU Place, Sid Buckwold Theatre\n\n\n35 – 22nd Street East\nSaskatoon, SK S7K 0C8\nGoogle Maps Directions\n\n\nSave Your Seats\n\n\nRead The Program\n\nTania Millerconductor\nStephanie Unverrichtbassoon\n\n\nEgmont, Op. 84Ludwig van Beethoven\nFantasia on a Theme by Thomas TallisRalph Vaughan Williams\nBassoon Concerto in B-flat major, K. 191W. A. Mozart\nSymphony No. 1, Op. 38 (“Spring”)Robert Schumann\n\n\nMaestra Tania Miller and the SSO will shake off your winter blues for at least this one March night.\nThe SSO’s own Stephanie Unverricht takes centre stage for Mozart’s joyful and effervescent Bassoon Concerto paired alongside Beethoven’s Egmont Overture and Vaughan Williams’ Fantasia on a Theme by Thomas Tallis.\nSchumann’s first symphony gained its nickname “Spring” as the opening of this joyous work will warm your winter night as spring blooms forth.\nWinter may have you down, but we’ll be here to remind you that soon the world will be turning green again!\nAdd this show to your subscription package and save!\n\n\n\t\t"
      }
    ]
  },
