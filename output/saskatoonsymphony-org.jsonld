      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Don't Stop"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Don't Stop- The Music of Fleetwood Mac with Jeans 'n Classics and the SSO on August 29, 2024 at TCU Place."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
  {
    "@id": "https://www.saskatoonsymphony.org/temporary/ecac0c1a-6de3-4045-a2ef-aae49d420166",
    "@type": [
      "https://schema.org/Blog"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://saskatoonsymphony.org/event/dont-stop/"
      }
    ]
  },
  {
    "@id": "https://www.saskatoonsymphony.org/temporary/b15f22a0-4481-4a03-9d6d-c7958f03b04d",
    "@type": [
      "https://schema.org/CreativeWork"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://saskatoonsymphony.org/event/dont-stop/"
      }
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "\n\t\t\t\n\n\n7:30PM, Thursday, August 29, 2024\nTCU Place, Sid Buckwold Theatre\n\n\n35 – 22nd Street East\nSaskatoon, SK S7K 0C8\nGoogle Maps Directions\n\n\nSave your Seats\n\n\n\nRichard Carnegie, Conductor\nJeans ‘n Classics\nSaskatoon Symphony Orchestra\nWe’re teaming up with our friends at Jeans ‘n Classics to bring another fun night to TCU Place. Join us to dance the night away to some of Fleetwood Mac’s greatest hits including Don’t Stop, Rhiannon, Songbird, Second Hand News and Landslide, just to name a few.\nFleetwood Mac has sold more than 120 million records worldwide, making them one of the world’s best-selling bands. With the voices of Jeans ‘n Classics backed by your orchestra, it’s going to be a fun night out! \n\nFind out what’s happening with your Orchestra! \nSupport your orchestra by donating today!\n\n\nThe Program\nDon’t Stop – The Music of Fleetwood Mac\nRichard Carnegie, conductor\nJeans ‘n Classics\nSaskatoon Symphony Orchestra\nRhiannon\nLittle Lies\nAs Long As You Follow\nSara\nLandslide\nStop Draggin’ My Heart Around\nEverywhere\nSay You Love Me\nDreams\nINTERMISSION\nThe Chain\nYou Make Lovin’ Fun\nHold Me\nOh Daddy\nOver My Head\nLeather And Lace\nBig Love\nSongbird\nDon’t Stop\nThe Artists\n[wp_show_posts id=”13278″]\nClick here to read about your Orchestra!\nThis concert also includes:\nViolin – Kim de Laforest, Evan Friesen, Cherie Jarock, Kayley Grant\nViola – Michael Hrycay\nCello – Terry Sturge\nOboe – Carl Hofmeister\nClarinet – Alyssa Thompson\n \nSpecial Thanks\n\nClick here to learn more about our Partners.\n\nProgram Notes\n[wp_show_posts id=”13291″]\nWhat’s Next\n\nA Change is Gonna Come7:30PM Sat, Apr 11, 2026Save Your SeatsAfter Dark8:00PM Sat, Apr 18, 2026Save Your SeatsThe Traveller7:30PM Sat, May 02, 2026Save Your SeatsJames Ehnes in Recital7:30PM Wed, May 06, 2026Save Your SeatsMothers' Day2:00PM Sun, May 10, 2026FREE EVENTFinding Light7:30PM Sat, May 30, 2026Save Your SeatsCroon8:00PM Mon, Jul 06, 2026Save Your SeatsHarry Potter and the Goblet of Fire™ in Concert1:30PM Sat, Oct 10, 2026Save Your Seats7:30PM Sat, Oct 10, 2026Save Your Seats\n\n\n\n\t\t"
      }
    ]
  },
