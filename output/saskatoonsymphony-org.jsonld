    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Halloween Bash"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "All the Halloween hits with the SSO and conductor Armand Birk."
      }
    ],
    "http://schema.org/eventStatus": [
