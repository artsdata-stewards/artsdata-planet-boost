    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Murdoch Mysteries: Live in Concert"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Lucas Waldin, conductor\n\nJoin us for an electrifying evening that pulls back the curtain on CBC’s hit series Murdoch Mysteries - live in concert with the Saskatoon Symphony Orchestra.\n\nHosted by series star Thomas Craig, this exclusive event explores how music for the series is brought to life with Emmy Award-winning composer Rob Carli. Blending television drama and live orchestral …"
      }
    ],
