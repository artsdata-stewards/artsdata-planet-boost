      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Jeremy Dutcher &amp; the SSO"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The 2018 Polaris Prize winner comes to Saskatoon to share his exceptional artistry with the SSO."
      }
    ],
