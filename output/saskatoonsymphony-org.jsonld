    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "\n\t\t\t\n\n\n10:00AM, Friday, June 6, 2025\nSt John’s Cathedral\n\n\n 816 Spadina Crescent E\nSaskatoon, Saskatchewan S7K 3H4\nGoogle Maps Directions\n\n\nFind Out More\n\n\n10:00AM, Saturday, June 7, 2025\nSt John’s Cathedral\n\n\n 816 Spadina Crescent E\nSaskatoon, Saskatchewan S7K 3H4\nGoogle Maps Directions\n\n\nFind Out More\n\n\n\nIn partnership with the Saskatchewan Children’s Festival, you can visit the butterflies at St. John’s Cathedral.\n\n\n\t\t"
