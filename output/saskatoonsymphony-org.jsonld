    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "It’s time to celebrate the best female artists that Saskatoon has to offer. From pops to rock, jazz to blues, we’re having the likes of Eileen Laverty, Sonia Reid, and more!"
