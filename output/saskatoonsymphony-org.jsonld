    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "\n\t\t\t\n\n\n7:00PM, Wednesday, September 30, 2020\nSaskatoon Symphony Orchestra\n\n\n602 B 51st Street\nSaskatoon, Saskatchewan S7K 7K3\nGoogle Maps Directions\n\n\n\n\n\nJoin the Saskatoon Symphony Society Board of Directors for the Annual General Meeting of the Society.\nAs we enter our 90th season, this AGM will let us take a look back at a challenging and exciting 89th season.\nAll are welcome, but only members of the Society are permitted to vote.\n \nTo accommodate for safety due to the COVID-19 Pandemic, this year’s AGM will be held virtually. Registrants will receive a Zoom Meeting invite ahead of the AGM.\n \nPlease RSVP if you intend to attend:\n\n\n\n\t\t"
      }
    ]
  },
