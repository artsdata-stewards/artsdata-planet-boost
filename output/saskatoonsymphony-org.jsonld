        "@language": "en",
        "@value": "Opening Night - Brahms 4"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Maestro Eric Paetkau leads the SSO through Brahms' stunning fourth symphony.  Cellist Stéphane Tétreault returns after his triumphant 2018 SSO debut!"
      }
    ],
