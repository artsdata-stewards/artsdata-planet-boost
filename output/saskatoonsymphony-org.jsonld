    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Beauty and the Beast"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Experience Disney’s classic Beauty and the Beast on the big screen with a live soundtrack provided by your SSO. With all the character voices you know and love, Beauty and the Beast comes to life in a whole new way with this magical movie in concert. "
      }
    ],
