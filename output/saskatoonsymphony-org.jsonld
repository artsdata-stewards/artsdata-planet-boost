        "@value": "Vivaldi's Four Seasons"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Vivaldi's beloved Four Seasons performed by Véronique Matthieu and the SSO"
      }
    ],
