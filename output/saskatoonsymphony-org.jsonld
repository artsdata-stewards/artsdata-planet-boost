    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "\n\t\t\t\n\n\n2:00PM, Sunday, September 21, 2025\nOnline Event\n\n\n\nRSVP\n\n\n\nThe Saskatoon Symphony Society Board of Directors wishes to invite all patrons to the AGM of the SSO.\nAll interested guests are asked to RSVP.\nAll patrons of the SSO are welcome to attend online – subscribers and donors of $300+ are voting members as per our bylaws, and are welcome to vote at the AGM.\n\n\n\t\t"
      }
