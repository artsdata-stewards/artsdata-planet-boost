      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://saskatoonsymphony.org/wp-content/uploads/2021/08/782-Nicolas-Ellis-opt-3.jpg"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
