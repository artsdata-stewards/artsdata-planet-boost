    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "This musical journey from Sevilla to Isfahan, brings into dialogue the music of the Spanish, Italian and French Renaissance with Persian/Ottoman masterpieces taken from manuscripts unearthed in monasteries and palace libraries such as Topkapi."
      }
    ],
