  {
    "@id": "https://www.saskatoonsymphony.org/temporary/dd0bae60-8651-401c-ab45-cc5581165281",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2021-01-30T19:30:00-06:00"
      }
    ],
