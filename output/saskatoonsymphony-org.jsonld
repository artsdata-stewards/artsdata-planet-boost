      {
        "@language": "en",
        "@value": "Chopin and the New World"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Maestra Tania Miller conducts Dvořák’s New World Symphony and pianist Jerry Hu returns for Chopin's Piano Concerto No.1."
      }
    ],
