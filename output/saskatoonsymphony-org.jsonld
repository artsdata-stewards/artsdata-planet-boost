    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "\n\t\t\t\n\n\n9:00AM, Monday, June 2, 2025\nSt John’s Cathedral\n\n\n 816 Spadina Crescent E\nSaskatoon, Saskatchewan S7K 3H4\nGoogle Maps Directions\n\n\nEntry By Donation\n\n\n9:00AM, Tuesday, June 3, 2025\nSt John’s Cathedral\n\n\n 816 Spadina Crescent E\nSaskatoon, Saskatchewan S7K 3H4\nGoogle Maps Directions\n\n\nEntry By Donation\n\n\n1:00PM, Tuesday, June 3, 2025\nSt John’s Cathedral\n\n\n 816 Spadina Crescent E\nSaskatoon, Saskatchewan S7K 3H4\nGoogle Maps Directions\n\n\nEntry By Donation\n\n\n9:00AM, Wednesday, June 4, 2025\nSt John’s Cathedral\n\n\n 816 Spadina Crescent E\nSaskatoon, Saskatchewan S7K 3H4\nGoogle Maps Directions\n\n\nEntry By Donation\n\n\n1:00PM, Wednesday, June 4, 2025\nSt John’s Cathedral\n\n\n 816 Spadina Crescent E\nSaskatoon, Saskatchewan S7K 3H4\nGoogle Maps Directions\n\n\nEntry By Donation\n\n\n9:00AM, Thursday, June 5, 2025\nSt John’s Cathedral\n\n\n 816 Spadina Crescent E\nSaskatoon, Saskatchewan S7K 3H4\nGoogle Maps Directions\n\n\nEntry By Donation\n\n\n\nJoin us for a yoga class under the butterflies!\nLed by Carla Duval Tyler these classes are entry by donation to the SSO.\n\n\n\t\t"
      }
    ]
  },
