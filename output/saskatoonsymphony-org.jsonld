    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "It's the return of Sing-Along Messiah! With an all-Saskatchewan line of soloists and the SSO Chorus, we continue our favourite tradition where you get to join in the chorus."
      }
    ],
