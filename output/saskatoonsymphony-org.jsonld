    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Four Seasons"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Renowned baroque violinist Julia Wedman returns home to lead the SSO in a celebration of 300 years of Vivaldi’s Four Seasons. Wedman has curated a program that is a perfect start to SSO95!"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
