    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Mozart in Prague"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Stroll the streets of the medieval city through the music of Mozart and Dvorak"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
  {
    "@id": "https://www.saskatoonsymphony.org/temporary/2076a421-2f56-4cd8-b0af-bc04ae25304f",
    "@type": [
      "https://schema.org/Blog"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
