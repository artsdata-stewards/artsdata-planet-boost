    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Carnival of Venice"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Explore the music of Venice's virtuosic Baroque Era"
      }
    ],
