  {
    "@id": "https://www.saskatoonsymphony.org/temporary/278fb149-5425-4f36-87f4-0d43d52776c1",
    "@type": [
      "https://schema.org/WPHeader"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
