    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Music Talk from McNally"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Entering its ninth season, the SSO is  thrilled to again partner with McNally Robinson Booksellers for Music Talk from McNally...and after two years of being virtual, we're thrilled to say that we're back to having an in-person audience!\n\nJoin the SSO's Mark Turner as he interviews our conductors and artistic partners ahead of Masters Series events …"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
