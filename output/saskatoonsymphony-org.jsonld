    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "\n\t\t\t\n\n\n10:00AM, Saturday, March 1, 2025\nSaskatoon Symphony Orchestra\n\n\n602 B 51st Street\nSaskatoon, Saskatchewan S7K 7K3\nGoogle Maps Directions\n\n\nFind Out More\n\n\n10:00AM, Sunday, March 2, 2025\nSaskatoon Symphony Orchestra\n\n\n602 B 51st Street\nSaskatoon, Saskatchewan S7K 7K3\nGoogle Maps Directions\n\n\nFind Out More\n\n\n\nFebruary 15 and 16 books, including history, biography, religion, literature, art and coffee table.\nMarch 1 and 2 music, including DVDs, vinyl, CDs, and print music (Junior and advanced piano, organ, technique, theory, scores, voice, songbooks, etc.)\n\n\n\t\t"
