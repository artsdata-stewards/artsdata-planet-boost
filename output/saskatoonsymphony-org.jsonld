  },
  {
    "@id": "https://www.saskatoonsymphony.org/temporary/2e282770-6967-4ca9-9e2f-6e8028ea53e5",
    "@type": [
      "https://schema.org/CreativeWork"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://saskatoonsymphony.org/event/symphonic-sci-fi/"
      }
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "\n\t\t\t\n\n\n7:30PM, Saturday, April 12, 2025\nTCU Place, Sid Buckwold Theatre\n\n\n35 – 22nd Street East\nSaskatoon, SK S7K 0C8\nGoogle Maps Directions\n\n\nSave Your Seats\n\n\nRead The Program\n\nArmand Birkconductor\nSaskatoon Youth Orchestra\nRichard CarnegieSYO music director\n\n\nOur favourite sci-fi shows and movies would be very different without their iconic soundtracks. We’re highlighting our favourite works from galaxies near and far! With a special guest host to lead the way, it’s going to be out of this world.\nThis show features music from Star Wars, Star Trek, Jurassic Park, The Lord of the Rings, E.T., and more!\nWith an appearance by the Saskatoon Youth Orchestra.\n\n\n\t\t"
      }
    ]
  },
