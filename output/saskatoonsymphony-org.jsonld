        "@language": "en",
        "@value": "Baroque Soul"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Saskatoon’s own Alexa Haynes-Pilon, from her cello, leads the SSO in an evening of early music."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
