      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Sing-Along Messiah"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Join in the chorus with Sing-Along Messiah! "
      }
    ],
    "http://schema.org/eventStatus": [
