      }
    ]
  },
  {
    "@id": "https://www.saskatoonsymphony.org/temporary/b3bbcc3a-3c23-42c4-a4cf-9ab9ba778d1f",
    "@type": [
      "https://schema.org/Blog"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://saskatoonsymphony.org/event/murdoch-mysteries-live-in-concert/"
      }
    ]
  },
  {
    "@id": "https://www.saskatoonsymphony.org/temporary/a71983fc-cd93-4552-bf43-bfd1aab2ee1b",
    "@type": [
      "https://schema.org/WPHeader"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://saskatoonsymphony.org/event/murdoch-mysteries-live-in-concert/"
      }
    ]
  },
  {
    "@id": "https://www.saskatoonsymphony.org/temporary/c26318bf-4245-432d-8cdc-df7bf4424d74",
    "@type": [
      "https://schema.org/CreativeWork"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://saskatoonsymphony.org/event/murdoch-mysteries-live-in-concert/"
      }
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "\n\t\t\t\n\n\n7:30PM, Wednesday, August 27, 2025\nTCU Place, Sid Buckwold Theatre\n\n\n35 – 22nd Street East\nSaskatoon, SK S7K 0C8\nGoogle Maps Directions\n\n\nSave Your Seats\n\n\nRead The Program\n\nLucas Waldin, conductor\nJoin us for an electrifying evening that pulls back the curtain on CBC’s hit series Murdoch Mysteries – live in concert with the Saskatoon Symphony Orchestra.\nHosted by series star Thomas Craig, this exclusive event explores how music for the series is brought to life with Emmy Award-winning composer Rob Carli. Blending television drama and live orchestral performance, witness the craft of how orchestral magic brings pivotal scenes to life. Then, watch the thrilling episode “Murder in F Major” on the big screen, accompanied by a live symphonic score.\nDon’t miss this mesmerizing evening fusing screen and stage – Murdoch Mysteries: Live in Concert is a one-of-a-kind event for the whole family.\nSecure your spot and step into a world where music meets mystery!\n\n\n\t\t"
      }
    ]
  },
