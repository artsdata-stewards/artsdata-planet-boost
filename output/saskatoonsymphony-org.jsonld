      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Masmoudi Quartette"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "A mosaic of classical, jazz, and world music! Thursday February 26, 2026 at The Bassment."
      }
    ],
