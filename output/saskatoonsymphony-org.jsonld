  {
    "@id": "https://www.saskatoonsymphony.org/temporary/3db6eb49-4e74-4c0c-aad8-7f7ea07d6c5b",
    "@type": [
      "https://schema.org/CreativeWork"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://saskatoonsymphony.org/event/mothers-day/"
      }
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "\n\t\t\t\n\n\n2:00PM, Sunday, May 14, 2023\nGrosvenor Park Church\n\n\n407 Cumberland Ave S\nSaskatoon, Saskatchewan S7H 2L3\nGoogle Maps Directions\n\n\nFREE EVENT\n\n\n\nThe Saskatoon Symphony Orchestra’s Chamber Ensemble is celebrating Mother’s Day with a free concert!\nWe had an incredible time with our last free concert at Grosvenor Park United Church and our Chamber Ensemble has put together another great hour of music for your Sunday afternoon.\nThis concert includes our wind quintet performing works by Valerie Coleman and Paul Taffanel. Plus some Elgar for oboe and violin, as well as Elane Fine’s 4 Spring Dances for 2 Violins.\nDoors open at 1:30pm which gives you plenty of time for brunch. The concert’s run time is about one hour.\nThis is an in-person event only – streaming is not available for this concert.\nSee you, and your mom, this Mother’s Day!\n\n\n\t\t"
      }
    ]
  },
