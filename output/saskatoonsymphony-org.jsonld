      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Sask Celebration"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "A musical celebration as big as the prairie sky - we’re excited to have William Rowson, Godwin Friesen, Véronique Mathieu, and the Saskatoon Youth Orchestra join us for this concert"
      }
    ],
    "http://schema.org/eventStatus": [
