    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "\n\t\t\t\n\n\n7:30PM, Sunday, December 29, 2019\nKnox United Church\n\n\n838 Spadina Crescent E\nSaskatoon, SK S7K 3H4\nGoogle Maps Directions\n\n\n\n\n\nThis is the not to be missed concert of the holidays!\nSaskatoon’s vocal talent put on a benefit concert for Saskatoon Opera while they’re “home for the holidays”.\nThere’s an incredible assortment of music from 12 operatic voices, showcasing some of the best loved opera hits!\n\n\n\t\t"
      }
    ]
