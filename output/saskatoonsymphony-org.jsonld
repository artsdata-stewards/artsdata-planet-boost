        "@value": "Dixit"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Handel's Dixit Dominus and other incredible Baroque works with Maestra Cosette Justo Valdés on March 2nd, 2025."
      }
    ],
