    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "\n\t\t\t\n\n\n10:00AM, Saturday, September 14, 2019\nSaskatoon Symphony Orchestra\n\n\n602 B 51st Street\nSaskatoon, Saskatchewan S7K 7K3\nGoogle Maps Directions\n\n\n\n\n\nThe SSO Book and Music Sale is proud to host its second annual SHEET MUSIC ONLY event!\nJust started teaching for the fall and looking for new rep?\nJust started lessons and want to find more?\nNeeding music to give to your students?\nFind a mix of repertoire piano, voice, woodwind, brass, strings, and so much more.\nWe’ll accept cash, cheque, or card.\n\n\n\t\t"
      }
