    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Brahms Requiem"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Music Director Eric Paetkau leads the SSO, Greystones Singers, and Aurora Voce in Brahms’ German Requiem"
      }
    ],
    "http://schema.org/eventStatus": [
      {
