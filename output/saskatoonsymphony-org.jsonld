        "@value": "Rachmaninoff Romance"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Rising star conductor Yue Bao and renowned pianist Lucille Chung in a night of lush romance with the music of Rachmaninoff and Dvořák"
      }
    ],
