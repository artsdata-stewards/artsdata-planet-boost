    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "\n\t\t\t\n\n\n10:00AM, Friday, January 31, 2025\nNutrien Wonderhub\n\n\n950 Spadina Crescent E\nSaskatoon, SK S7K 3H6\nGoogle Maps Directions\n\n\nRegister\n\n\n10:00AM, Saturday, February 1, 2025\nNutrien Wonderhub\n\n\n950 Spadina Crescent E\nSaskatoon, SK S7K 3H6\nGoogle Maps Directions\n\n\nRegister\n\n\n11:15AM, Saturday, February 1, 2025\nNutrien Wonderhub\n\n\n950 Spadina Crescent E\nSaskatoon, SK S7K 3H6\nGoogle Maps Directions\n\n\nRegister\n\n\n\nYou are invited to a surprise birthday party! Join the Saskatoon Symphony Core Musicians as we explore surprises through music, games and movement. Come and help us celebrate with music from Haydn, Mouret, Dvorak and more!\n\n\n\t\t"
      }
    ]
  },
