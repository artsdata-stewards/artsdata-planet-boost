    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Community Screening - Metamorphosis"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "We're showing 4 concert films on the big screen at the Remai Modern! Starting July 10th, join us each Thursday at the Remai for a free viewing of some of our greatest moments of the past season."
      }
    ],
