    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The Saskatoon Symphony Society Board of Directors wishes to invite all patrons to the AGM of the SSO.\n\nAll interested guests are asked to RSVP.\n\nAll patrons of the SSO are welcome to attend online - subscribers and donors of $300+ are voting members as per our bylaws, and are welcome to vote at the AGM."
      }
    ],
