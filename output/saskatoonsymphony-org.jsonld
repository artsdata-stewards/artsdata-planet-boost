    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Handel's Messiah"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Saskatoon's longest-running holiday tradition continues! Handel's Messiah returns to the Saskatoon Symphony Orchestra."
      }
    ],
