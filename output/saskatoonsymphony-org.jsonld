    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Farm Fresh"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "This concert with conductor Judith Yan and Radia is a breath of fresh air. "
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
  {
    "@id": "https://www.saskatoonsymphony.org/temporary/a7cdbaa4-be6b-403a-a00c-8470b6f3aefe",
    "@type": [
      "https://schema.org/Blog"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://saskatoonsymphony.org/event/farm-fresh/"
      }
    ]
  },
  {
    "@id": "https://www.saskatoonsymphony.org/temporary/653c68d6-8190-4a64-9ea8-bb68f8dd9900",
    "@type": [
      "https://schema.org/CreativeWork"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://saskatoonsymphony.org/event/farm-fresh/"
      }
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "\n\t\t\t\n\n\n3:00PM, Sunday, April 2, 2023\nConvocation Hall\n\n\n107 Administration Place\nSaskatoon, Saskatchewan S7N 5A2\nGoogle Maps Directions\n\n\nBuy Your Tickets\n\n\n\nLive stream this performance on ConcertStream.tv\n\nJudith Yan, conductor\nRyan Davis (Radia), viola\n\nOf Glow and Abandon- Ryan Davis*\nAppalachian Spring- Aaron Copland\nSiegfried Idyll, WWV 103 – Richard Wagner\n\nBliss | Refreshed| Energetic\n\nConductor Judith Yan returns to lead a chamber orchestra concert tuned to the sounds of spring. Wagner’s Siegfried Idyll pairs perfectly with Copland’s idyllic Appalachian Spring and you’ll see the viola in a whole new light. Ryan Davis returns with his solo project Radia and a new work for viola, looper pedal, and the SSO!\n*Denotes Canadian Composer\n \nLive stream this performance on ConcertStream.tv\n\nA digital ticket gives you 24-hour access to the stream for $19.99\nSupporter tickets can be purchased for $35 and $50\nSSO Streaming Subscription gives you unlimited access to live streams and concert films on demand\nSupport your orchestra by donating today!\n\n\nThe Program\nFarm Fresh\nJudith Yan, conductor\nRyan Davis | Radia, viola & electronics\nSaskatoon Symphony Orchestra\n\n \nSiegfried Idyll\nRichard Wagner\nOf Glow & Abandon\nI. Dreaming, After All\nII. Blood Orange\nIII. Colour You Like\nIV. Set A Fire In My Snow\nRyan Davis\nAppalachian Spring\nAaron Copland\n \n*Order subject to change, intermission(s) will be announced\nThe Artists\n[wp_show_posts id=”12192″]\nClick here to read about your Orchestra!\nThis concert also includes:\n\nPiano  –  Sofia Mycyk\n\nClick here to learn more about our Partners.\n\nProgram Notes\n[wp_show_posts id=”12193″]\nWhat’s Next\n\nA Change is Gonna Come7:30PM Sat, Apr 11, 2026Save Your SeatsAfter Dark8:00PM Sat, Apr 18, 2026Save Your SeatsThe Traveller7:30PM Sat, May 02, 2026Save Your SeatsJames Ehnes in Recital7:30PM Wed, May 06, 2026Save Your SeatsMothers' Day2:00PM Sun, May 10, 2026FREE EVENTFinding Light7:30PM Sat, May 30, 2026Save Your SeatsCroon8:00PM Mon, Jul 06, 2026Save Your SeatsHarry Potter and the Goblet of Fire™ in Concert1:30PM Sat, Oct 10, 2026Save Your Seats7:30PM Sat, Oct 10, 2026Save Your Seats\n\n\n\n\t\t"
      }
