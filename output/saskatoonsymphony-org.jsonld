  {
    "@id": "https://www.saskatoonsymphony.org/temporary/b7e6dd97-93ca-4147-a12e-75f797f8ef5a",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2021-11-06T19:30:00-06:00"
      }
    ],
    "http://schema.org/location": [
