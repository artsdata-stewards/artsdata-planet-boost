    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "\n\t\t\t\n\n\n7:30PM, Tuesday, December 29, 2020\nOnline Event\n\n\n\n\n\n\nSaskatoon Opera Event\nIt’s now become a holiday tradition in Saskatoon, and we’re thrilled to see our friends at Saskatoon Opera reinventing their Home for the Holidays to adjust to the requirements of the pandemic.\nThe performance will stream online December 29th at 7:30pm.\nThe SSO is proud to partner with Saskatoon Opera to help them live stream the concert.\n \nFor more information…\n\n\n\t\t"
      }
