      }
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "\n\t\t\t\n\n\n10:00AM, Friday, November 28, 2025\nNutrien Wonderhub\n\n\n950 Spadina Crescent E\nSaskatoon, SK S7K 3H6\nGoogle Maps Directions\n\n\nCLASS FULL\n\n\n11:15AM, Friday, November 28, 2025\nNutrien Wonderhub\n\n\n950 Spadina Crescent E\nSaskatoon, SK S7K 3H6\nGoogle Maps Directions\n\n\nRegister\n\n\n10:00AM, Saturday, November 29, 2025\nNutrien Wonderhub\n\n\n950 Spadina Crescent E\nSaskatoon, SK S7K 3H6\nGoogle Maps Directions\n\n\nCLASS FULL\n\n\n11:15AM, Saturday, November 29, 2025\nNutrien Wonderhub\n\n\n950 Spadina Crescent E\nSaskatoon, SK S7K 3H6\nGoogle Maps Directions\n\n\nCLASS FULL\n\n\n\nJoin the Saskatoon Symphony Core Musicians for a walk through a Winter Wonderland to see the Sugar Plum Fairy! Featuring music of Tchaikovsky and other holiday favorites, we’ll celebrate the sparkle of winter and the warmth of the season.\nSpecifically designed for your mini-maestro, these parent and child experiences are perfect for your 2- to 4-year-old music lover.\nExplore music through movement, song and dance with SSO musicians. Let the music connect you and your child and send you both on a journey through melody, rhythm, colour, and beautiful sound.\n\n\n\t\t"
      }
    ]
  },
