      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Everything is Romantic"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Maestro Judith Yan, pianist Angela Cheng, and your SSO bring you some of the most heart-stopping romantic music for your valentines including Tchaikovsky’s Romeo and Juliet and Rachmaninoff’s Piano Concerto No 2."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
  {
    "@id": "https://www.saskatoonsymphony.org/temporary/e4dba5ca-4f25-4e61-afe6-21d053e1c67e",
    "@type": [
      "https://schema.org/Blog"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://saskatoonsymphony.org/event/everything-is-romantic/"
      }
    ]
  },
  {
    "@id": "https://www.saskatoonsymphony.org/temporary/dc3052f8-54cb-4347-8ba9-2ee72bf9aba0",
    "@type": [
      "https://schema.org/WPHeader"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://saskatoonsymphony.org/event/everything-is-romantic/"
      }
    ]
  },
  {
    "@id": "https://www.saskatoonsymphony.org/temporary/b61a1b88-fb5f-4108-a6d8-c8c82c8b2bfe",
    "@type": [
      "https://schema.org/CreativeWork"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://saskatoonsymphony.org/event/everything-is-romantic/"
      }
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "\n\t\t\t\n\n\n7:30PM, Saturday, February 14, 2026\nTCU Place, Sid Buckwold Theatre\n\n\n35 – 22nd Street East\nSaskatoon, SK S7K 0C8\nGoogle Maps Directions\n\n\nSave Your Seats\n\n\nRead The Program\n\nJudith Yanconductor\nAngela Chengpiano\n\n\nLove Theme, Adagio from SpartacusAram Khachaturian\nLyric for StringsGeorge Walker\nRomeo and Juliet, Fantasy OverturePiotr Ilyich Tchaikovsky\nPiano Concerto No 2 in C Minor, Op 18Sergei Rachmaninoff\n\n\nFall in love again and again with a romantic night at the symphony.\nMaestro Judith Yan and your SSO bring you some of the most heart-stopping romantic music for your Valentine’s, from Tchaikovsky’s Romeo and Juliet to Khachaturian’s Love Theme, Adagio from Spartacus.\nPianist Angela Cheng, an SSO favourite artist, is back for the dramatic romance of Rachmaninoff’s Piano Concerto No 2. Often considered the most romantic piece of music ever written, it’s the centrepiece of a night curated for you and your funny valentine.\nAdd this show to your subscription package and save!\n\n\n\t\t"
      }
    ]
  },
