    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Prairie Sons"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Prairie Sons, cellist David Liam Roberts and pianist Godwin Friesen, stop by Saskatoon on March 14, 2025."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
