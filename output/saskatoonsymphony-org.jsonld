    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Mothers' Day Concert"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Our Mothers' Day concert features a brand new work by composer Kendra Harder for the SSO's wind quintet, Mistral 5.\nChamber Series"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
  {
    "@id": "https://www.saskatoonsymphony.org/temporary/109ec7f1-9af7-457d-8e7d-313078a54b48",
    "@type": [
      "https://schema.org/Blog"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
