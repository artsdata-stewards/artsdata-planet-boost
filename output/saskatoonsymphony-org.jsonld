    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Karl Hirzer returns for Handel’s Messiah. We continue Saskatoon’s longest running holiday tradition with an all-Saskatchewan lineup of soloists and the SSO Chorus."
