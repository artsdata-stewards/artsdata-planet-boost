    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "\n\t\t\t\n\n\n7:00PM, Wednesday, September 29, 2021\nOnline Event\n\n\n\n\n\n\nThe SSO is holding the Annual General Meeting of its membership to reflect on season 90 and look ahead to season 91 and beyond. This past season was highlighted by the pivots the organization made to keep making music and connecting with patrons throughout the pandemic.\nMembers will receive the AGM package ahead of the meeting. Due to the pandemic, this meeting will be held online via Zoom to allow for members to safely attend.\n\n\n\t\t"
      }
    ]
