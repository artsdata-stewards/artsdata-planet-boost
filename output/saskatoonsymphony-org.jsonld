  {
    "@id": "https://www.saskatoonsymphony.org/temporary/fe5c8d4c-c913-4fb2-8f7a-85a0cad19e5e",
    "@type": [
      "https://schema.org/CreativeWork"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://saskatoonsymphony.org/event/royal-teddy-bear-tea/"
      }
    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "\n\t\t\t\n\n\n10:00AM, Friday, April 4, 2025\nNutrien Wonderhub\n\n\n950 Spadina Crescent E\nSaskatoon, SK S7K 3H6\nGoogle Maps Directions\n\n\nSOLD OUT\n\n\n11:15AM, Friday, April 4, 2025\nNutrien Wonderhub\n\n\n950 Spadina Crescent E\nSaskatoon, SK S7K 3H6\nGoogle Maps Directions\n\n\nRegister\n\n\n10:00AM, Saturday, April 5, 2025\nNutrien Wonderhub\n\n\n950 Spadina Crescent E\nSaskatoon, SK S7K 3H6\nGoogle Maps Directions\n\n\nSOLD OUT\n\n\n11:15AM, Saturday, April 5, 2025\nNutrien Wonderhub\n\n\n950 Spadina Crescent E\nSaskatoon, SK S7K 3H6\nGoogle Maps Directions\n\n\nRegister\n\n\n\nHear Ye! Hear Ye! You are invited by royal decree to join the Saskatoon Symphony Core Musicians for a Teddy Bear Tea! Bring a stuffie from home and join the fun as we sing and dance to classical music on this special springtime occasion.\n\n\n\t\t"
      }
    ]
  },
