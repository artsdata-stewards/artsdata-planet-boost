    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Come Dancing"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\n\nThe Saskatoon Symphony Orchestra’s Chamber Ensemble is performing a free concert of music that just might make you feel some dance rhythms!\n\nWe had an incredible time with our free concerts at Grosvenor Park United Church last season and our Chamber Ensemble has put together another great hour of music for your Sunday afternoon.\n\nThis concert includes …"
      }
    ],
