  {
    "@id": "http://lemonbucket.com/temporary/d1cbeb92-d0a0-4116-8965-210a616ec40b",
    "@type": [
      "http://schema.org/WebSite"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.lemonbucket.com"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "http://images.squarespace-cdn.com/content/v1/5389dd36e4b0e8a9cc145496/eddb292b-c539-40b8-a151-a0f499476421/Lemon-Logo-w-text-no-bg.png"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "http://lemonbucket.com/shows/2025/6/1/petit-campus-w-less-toches-and-dj-oonga-montreal-qc"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "the lemon bucket orkestra"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><span style=\"font-size:14px\">Self-branded \"Balkan-klezmer-gypsy-party-punk super band\"</span><a target=\"_blank\" href=\"http://www.lemonbucket.com/\">Lemon Bucket Orkestra</a><span style=\"font-size:14px\">&nbsp;entered the Ukrainian crisis this spring with their&nbsp;</span><a href=\"http://exclaim.ca/News/lemon_bucket_orkestra_enter_ukrainian_crisis_with_lemonchiki_project\">Lemonchiki Project</a><span style=\"font-size:14px\">, but now they are turning their attention back on Canada for a lengthy summer tour.&nbsp;</span><br /><br /><span style=\"font-size:14px\">The outing will run throughout the whole summer, starting in the second half of June and stretching until early September. The tour is structured around festival stops, which are interspersed with various other dates. The group will be heading as far west as Vancouver Island and as far east as the Maritimes.</span><br /><br /><span style=\"font-size:14px\">See the schedule below. Note that it includes a hometown send-off show at Lee's Palace in Toronto on June 26.</span><br /><br /><span style=\"font-size:14px\">\"Toronto has been so good to us, and we couldn't ask for a better home,\" said the band's Mark Marczyk in a statement. \"Without the support of the Toronto community, we would never be able to share the music with the rest of the country.\"</span></p>"
      }
    ]
  },
