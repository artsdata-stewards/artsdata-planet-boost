    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Lemon Bucket Orkestra's Fall Into Chaos Tour - Kingston!    TICKET LINK   Get ready, Kingston!  Lemon Bucket Orkestra's  Fall Tour is making a stop at  The Broom Factory  on November 23rd for a night of pure, unadulterated musical chaos.  For over 15 years, this 10-piece Toronto-based juggernaut has"
      }
    ],
