    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "TICKET LINK     Doors - 7pm  Show 8pm    In 2025, Lemon Bucket Orkestra marks 15 years of unstoppable energy and musical innovation. A Toronto icon of folk-party-punk-guerrilla, LBO blends Ukrainian polyphony, driving Balkan rhythms, and touches of hip-hop, punk, and jazz. Inspired by their eclectic"
      }
    ],
