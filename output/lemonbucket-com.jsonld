    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "TICKET LINK    🎃👻 Dress to impress in your Halloween best and get ready for a night you won’t forget at London Brewing Co-op! 🕺💀✨  On October 31st, Sunfest is taking over for a one-of-a-kind Halloween concert. Imagine spine-tingling live music, the city’s finest brews, and a hauntingly fun vibe—"
      }
    ],
