    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "TICKET LINK   DOORS - 7pm  SHOW - 8pm  ADV $30+taxes / DOOR $40  Lemon Bucket is coming back to Montreal to celebrate 15 years with all our friends and family alongside the local Cumbia heroes “Less Toches” and DJ Oonga on the turntables"
      }
    ],
