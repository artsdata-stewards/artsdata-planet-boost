      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Regrettably, due to extended work visa delays and unreliable border crossings, we've had to make the tough call to cancel our US tour dates until further notice. We're so bummed and appreciate your understanding. Ticket holders will receive refunds at the point of purchase. We hope to see you soon"
      }
