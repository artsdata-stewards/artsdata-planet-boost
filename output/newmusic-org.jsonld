    "http://schema.org/caption": [
      {
        "@language": "en",
        "@value": "The Dusk Meridian installation at night. Stumps on puddle shaped platforms are placed alongside a quarter scale log cabin and half scale wooden fire tower. There is a pool of water on the ground that reflects the sculptures, and the area is washed in red and yellow light."
      }
    ]
