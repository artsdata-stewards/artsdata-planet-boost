  {
    "@id": "https://newmusic.org/events/shiki-ku",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Shiki & Kū — Vancouver New Music"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Sep 13, 2025 | Yota Kobayashi, Ryo Kanda, Quartetto Maurice, Rurihiko Hara, Aiko Hatanaka, Mark McGregor | Rooted in the Japanese philosophical concepts of shiki (form, tangible reality) and kū (emptiness, impermanence), the exhibition interweaves spatial sound, generative visuals, and cultural symbolism."
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
