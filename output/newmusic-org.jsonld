  {
    "@id": "https://newmusic.org/events/gushing-at-the-wrong-evergreen",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Gushing at the Wrong Evergreen — a self-guided soundwalk — Vancouver New Music"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "May 30, 2021 | Jorma Kujala | Extending the historical, cultural and socioeconomic exploration begun with False; Flat; Fake – a soundwalk, Gushing at the Wrong Evergreen continues to investigate the resulting detritus when subjective particulate matter collides with human wills, minds and emotions."
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://cdn.prod.website-files.com/66b03ff4d5aa3119fe18638a/6770d122d87ed9c5dfb08f4c_May30-Jorma-Kujala.webp"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ]
  },
