  {
    "@id": "https://newmusic.org/events/intertidal-room",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Intertidal Room – A Soundwalk — Vancouver New Music"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Sep 27, 2020 | Jacek Smolicki | An audio piece intended to be listened to while walking at low tide, solitarily or collectively. It interweaves elements of creative storytelling, historical research creative field recording, and soundscape composition."
      }
    ],
