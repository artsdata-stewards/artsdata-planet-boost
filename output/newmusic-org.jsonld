        "@value": "Alessandro Cortini"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Best known as a member of Nine Inch Nails, Alessandro Cortini has quietly been carving a name for himself in the world of experimental electronic music. The producer, composer, and musician is known for his lush ambient music, full of smoky restraint. "
      }
    ],
