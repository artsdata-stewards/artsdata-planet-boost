  {
    "@id": "https://newmusic.org/events/alessandro-cortini",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Alessandro Cortini — Vancouver New Music"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Mar 07, 2024 | Alessandro Cortini, Alexi Baris | Best known as a member of Nine Inch Nails, Alessandro Cortini has quietly been carving a name for himself in the world of experimental electronic music. The producer, composer, and musician is known for his lush ambient music, full of smoky restraint."
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://cdn.prod.website-files.com/66b03ff4d5aa3119fe18638a/66cbed8137466b4b4b027304_AlessandroCortini%20by%20Emilie%20Elizabeth.jpeg"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ]
  },
