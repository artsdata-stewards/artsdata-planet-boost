  {
    "@id": "https://newmusic.org/events/fall-soundwalks-false-creeks-thunderclouds-of-sounds",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Fall Soundwalks: False Creek’s Thunderclouds of Sounds — Vancouver New Music"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Sep 25, 2022 | Jorma Kujala | This soundwalk invites participants to pause and linger over the sound of one’s presence, ripples of fleeting energies that nonetheless evoke past markers and lives."
      }
    ],
    "http://ogp.me/ns#image": [
      {
