  {
    "@id": "https://newmusic.org/events/parallel-08",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Parallel 08 — Vancouver New Music"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Mar 20, 2027 | Miyama McQueen-Tokita | Koto and bass koto player Miyama McQueen-Tokita brings the rich traditions of Japanese music into dialogue with contemporary composition with this collaborative community project."
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
