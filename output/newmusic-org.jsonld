    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Fall Soundwalks: In Pursuit of Clairaudience — Vancouver New Music"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Sep 26, 2021 | Hildegard Westerkamp | On this walk we will revisit some of Schafer’s early approaches to soundwalking and will test and contemplate their relevance and application."
      }
    ],
