    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "One-Page Score Project — Vancouver New Music"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Jan 23, 2027 | Plastic Acid Orchestra | VNM’s popular One-Page Score Project returns! This dynamic workshop series invites community members to create their own scores using graphic notation, which will then be interpreted and performed by Plastic Acid Orchestra."
      }
    ],
