        "@language": "en",
        "@value": "NDT 1"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "In Everywhere is here, we explore two distinct voices within contemporary dance, both poetic and evocative in their own way. We present a new work by our associate choreographer Marco Goecke, alongside the captivating world of Ties Unseen (2024) by Christos Papadopoulos. 13 May until 5 June, 2027 Amare, Den Haag 13 (premiere), 14, 15&hellip;"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-06-03T20:00:00"
      }
    ]
  },
