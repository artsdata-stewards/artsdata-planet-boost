    "http://schema.org/description": [
      {
        "@language": "nl",
        "@value": "Simon McBurney, Artistiek Directeur van Complicité, en NDT associate choreograaf Crystal Pite creëren samen een drieluik. Het prijswinnende Figures in Extinction [1.0]  (2022) confronteert ons met alles dat stervende is op onze planeet. Deel [2.0]  is een indringend onderzoek naar onze behoefte aan verbinding in een verdeelde wereld en ging in 2024 in première. Nu&hellip;"
      }
    ],
