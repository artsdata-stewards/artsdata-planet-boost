    ],
    "http://schema.org/performer": [
      {
        "@language": "nl",
        "@value": "NDT 1"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "nl",
        "@value": "In Everywhere is here onderzoeken we twee uitgesproken perspectieven binnen de hedendaagse dans; elk poëtisch en beeldend op hun eigen manier. We presenteren een wereldpremière van onze associate choreograaf Marco Goecke en duiken opnieuw in de meeslepende wereld van Ties Unseen (2024) van choreograaf Christos Papadopoulos. 13 mei t/m 5 juni 2027 Amare, Den Haag&hellip;"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-06-03T20:00:00"
      }
