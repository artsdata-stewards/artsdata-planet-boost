      }
    ],
    "http://schema.org/description": [
      {
        "@language": "nl",
        "@value": "Het eerste NDT 2-programma van dit seizoen viert ons verleden en heden vol radicale keuzes en poëtische zeggingskracht. In Blast a universe hernemen we twee iconische werken uit het NDT-repertoire en presenteren we vol trots een wereldpremière van choreograaf Noé Soulier. 22 okt t/m 15 dec 2026 Amare, Den Haag 22 (première), 23, 24 oktober&hellip;"
      }
    ],
