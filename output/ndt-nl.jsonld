  {
    "@id": "https://www.ndt.nl/temporary/f566a474-9aa3-4bb1-8ea7-d21ca8965763",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.ndt.nl/en/agenda/ndt-young-creatives-2/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.ndt.nl/content/uploads/2024/06/2022-NDT-YC©sacha-grootjans-02online-768x432.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g4540240"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "_:g4540260"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.ndt.nl/en/agenda/?where=the-hague"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "NDT Young Creatives Workshop"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Hoe werkt dat eigenlijk, een dansvoorstelling maken? En waar haalt een choreograaf inspiratie vandaan? Kinderen van 8 tot 14 jaar kruipen in de huid van dansers en makers tijdens een losse workshop of een serie van acht zondagen. Ze leren over het creatieve proces, gaan zelf aan de slag met het repertoire van NDT en&hellip;"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-05-31T10:00:00"
      }
    ]
  },
  {
    "@id": "https://www.ndt.nl/temporary/178d37b2-d22d-4851-820b-794bb3d509f3",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.ndt.nl/en/agenda/zo/"
      }
    ],
    "http://schema.org/image": [
