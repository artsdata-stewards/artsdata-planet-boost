      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.ndt.nl/content/uploads/2026/03/A-poem-for-the-world-NDT-2-©Rahi-Rezvani_online-732x432.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g9166100"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "_:g9166120"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.ndt.nl/agenda/page/2/?voorstelling=a-poem-for-the-world"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "nl",
        "@value": "A poem for the world"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "nl",
        "@value": "NDT 2"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "nl",
        "@value": "Het tweede NDT 2-programma van dit seizoen is een ode aan de speelsheid en de menselijkheid die onze dansers kenmerkt. A poem for the world brengt twee geliefde werken van choreograaf Edward Clug en associate choreograaf Crystal Pite samen, beide met livemuziek, naast een wereldpremière van gevierd maker Johan Inger. De voorstellingen worden live begeleid&hellip;"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-05-12T20:00:00"
      }
    ]
  },
