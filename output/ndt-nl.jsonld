  {
    "@id": "https://www.ndt.nl/temporary/33cb730c-ca6f-438e-9058-6ed144ee5fd1",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.ndt.nl/en/agenda/i-dreamt-it-was/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.ndt.nl/content/uploads/2025/03/I-dreamt-it-was-NDT-2-©Rahi-Rezvani_online-420x432.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g4639680"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "_:g4639700"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
