  {
    "@id": "https://www.ndt.nl/temporary/31c38c56-bbdc-472b-bba5-d80d1b581a26",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.ndt.nl/en/agenda/blast-a-universe/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.ndt.nl/content/uploads/2026/03/Blast-a-universe-NDT-2-©Rahi-Rezvani_online-734x432.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "_:g9528480"
