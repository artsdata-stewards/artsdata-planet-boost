    ],
    "http://schema.org/description": [
      {
        "@language": "nl",
        "@value": "I dreamt, it was is een feest voor de zintuigen. NDT-alumni en nieuwe associate choreografen Imre van Opstal &amp; Marne van Opstal zijn terug met een rauwe en emotionele nieuwe creatie die onderzoekt wat er met het lichaam gebeurt als deze verslaafd raakt aan anticiperen en prikkels. Ook zijn geniale makers Sharon Eyal &amp; Gai&hellip;"
      }
    ],
