        "@value": "NDT 1"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "nl",
        "@value": "In Wildsong duik je in de dynamische, surrealistische werelden van twee gerenommeerde makers die de unieke veelzijdigheid van de NDT 1-dansers vieren. Choreograaf Jan Martens creëert zijn eerste wereldpremière voor ons vol uithoudingsvermogen, rebellie en vernieuwende, punkachtige muziek. Ook hernemen we het geliefde en theatrale Horses (2024) van onze associate choreograaf Marcos Morau.  Deze voorstelling&hellip;"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-03-22T15:30:00"
      }
    ]
  },
