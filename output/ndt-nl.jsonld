  {
    "@id": "https://www.ndt.nl/en/agenda/up-and-coming-choreographers/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-en",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#locale:alternate": [
      {
        "@language": "en-en",
        "@value": "nl_NL"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-en",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-en",
        "@value": "Up & Coming Choreographers"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-en",
        "@value": "In a close collaboration between NDT and Korzo, Up & Coming Choreographers offers talented emerging makers the opportunity to create a work for NDT 2. The project serves as a platform to support new voices, experimentation, and exchange, and concludes with performances in the intimate setting of the Korzo theatre in The Hague. For this season, we have invited Rachelle Scott and Tom Weinberger as our Up & Coming Choreographers. These inspiring new voices offer a glimpse into the future of contemporary dance, and we are proud to support their artistic development.   The performances of Up & Coming Choreographers will take place at Korzo Theater in The Hague. Up & Coming Choreographers is a collaboration with Korzo. July 7-11, 2026  Korzo, The Hague July 7, 8, 9, 10, 11* *On 11 July, there are 2 performances: at 3 PM and 8.15 PM Dancers This performance is danced by NDT 2.  See an overview of all NDT 2 dancers Intermissions This performance contains 1 intermission. At this very moment, the duration of the performance is not yet known. This page will be updated closer to the actual performances.  This performance will take place in Korzo Theater, The Hague."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-en",
        "@value": "https://www.ndt.nl/en/agenda/up-and-coming-choreographers/"
      }
