        "@language": "nl",
        "@value": "GONE"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "nl",
        "@value": "NDT 1"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "nl",
        "@value": "“Voordat het besef tot ons doordringt, is alles al verdwenen.” - Benjamin Clementine We zijn verheugd om de eerste avondvullende voorstelling van onze associate choreograaf Marcos Morau te presenteren. Deze wereldpremière nodigt je uit om je volledig onder te dompelen in de fantasierijke wereld van Morau, waar hedendaagse dans en fysiek theater samensmelten tot iets&hellip;"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-02-27T19:45:00"
      }
    ]
  },
