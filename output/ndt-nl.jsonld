    "http://schema.org/performer": [
      {
        "@language": "nl",
        "@value": "NDT 1"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "nl",
        "@value": "In Out of the stillness vieren we de creatieve veelzijdigheid van NDT 1 met twee spannende en uitgesproken makers. We hernemen Gabriela Carrizo’s The missing door (2013), een meeslepend werk waar dans en theater op onheilspellende wijze samensmelten. Ook is Hofesh Shechter terug bij NDT voor een wereldpremière; zijn vierde creatie voor ons. 24 sept&hellip;"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-09-25T19:45:00"
      }
