    "http://schema.org/performer": [
      {
        "@language": "nl",
        "@value": "NDT 1 & NDT 2"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "nl",
        "@value": "Een jaarlijkse NDT-favoriet is Switch: een avond volledig gecureerd, geproduceerd en gechoreografeerd door de dansers van NDT 1 en NDT 2. Switch is meer dan 40 jaar geleden in het leven geroepen door het verlangen van de dansers om zichzelf creatiever en meer experimenteel te kunnen uiten, en nieuwe aspecten van hun artistieke identiteit te&hellip;"
      }
    ],
