      {
        "@type": "http://schema.org/Date",
        "@value": "2026-06-02T20:00:00"
      }
    ]
  },
  {
    "@id": "https://www.ndt.nl/agenda/i-dreamt-it-was/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "nl-nl",
