    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Hoe werkt dat eigenlijk, een dansvoorstelling maken? En waar haalt een choreograaf inspiratie vandaan? Kinderen van 8 tot 14 jaar kruipen in de huid van dansers en makers tijdens een losse workshop of een serie van acht zondagen. Ze leren over het creatieve proces, gaan zelf aan de slag met het repertoire van NDT en&hellip;"
      }
    ],
