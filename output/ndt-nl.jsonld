    "http://schema.org/description": [
      {
        "@language": "nl",
        "@value": "Choreograaf Ohad Naharin, een ongeëvenaarde stem in hedendaagse dans, is terug bij NDT. In  zijn nieuwste creatie ZŌ, gedanst door NDT 1 in de NDT Black Box, vervagen de grenzen tussen publiek en dansers voor een intieme ervaring die zijn weerga niet kent. Op dit moment zijn alle voorstellingen uitverkocht. Zet jezelf op de wachtlijst,&hellip;"
      }
    ],
