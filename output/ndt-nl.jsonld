    ],
    "http://schema.org/description": [
      {
        "@language": "nl",
        "@value": "Elk seizoen geven NDT en Korzo opkomende, talentvolle makers de kans om een werk te creëren voor een intieme setting in Up &amp; Coming Choreographers. Dit project is een springplank voor nieuwe stemmen, experimenten en artistieke uitwisseling. De samenwerking wordt afgesloten met voorstellingen in de sfeervolle theaterzaal van Korzo in Den Haag. Dit seizoen verwelkomen&hellip;"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-07-10T20:15:00"
      }
    ]
