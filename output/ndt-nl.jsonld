      }
    ],
    "http://schema.org/description": [
      {
        "@language": "nl",
        "@value": "Mist is een multidisciplinaire dansfilm, gemaakt in nauwe samenwerking tussen choreograaf Damien Jalet, de Japanse beeldend kunstenaar Kohei Nawa en videograaf Rahi Rezvani. Het werk van Damien Jalet is prikkelend, kinetisch en multidisciplinair. Jalet liet zich inspireren door het Nederlandse landschap; mistbanken, wind en zee worden vertaald naar vloeiende bewegingen van de NDT 1-dansers. \"Gefilmd&hellip;"
      }
    ],
