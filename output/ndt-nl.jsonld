    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": "NDT 1"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "In Out of the stillness, we celebrate the creative dynamism of NDT 1 through two distinct choreographic visions. Hofesh Shechter returns to NDT with a daring world premiere, his fourth creation for the company. We also revisit Gabriela Carrizo's The missing door (2013), a compelling and mysterious fusion of dance and theatre. 24 September until&hellip;"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-12-12T19:45:00"
