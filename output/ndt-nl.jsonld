        "@value": "NDT 2"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "NDT 2’s first programme of the season is a daring reflection on our past and present. In Blast a universe, we revisit two iconic works from NDT’s repertoire by Jiří Kylián and Marco Goecke, and perform an exciting world premiere by the bold choreographic voice of Noé Soulier. 22 October until 15 December 2026 Amare,&hellip;"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-12T19:45:00"
      }
