      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "I dreamt, it was"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": "NDT 2"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "I dreamt, it was is a feast for the senses. NDT alumni and new associate choreographers Imre van Opstal &amp; Marne van Opstal are back with a raw and emotional new creation, exploring what happens to the body when it becomes addicted to anticipation. We are also joined by brilliant makers Sharon Eyal &amp; Gai&hellip;"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-04-01T20:00:00"
      }
    ]
  },
