        "@language": "en",
        "@value": "NDT 2"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "I dreamt, it was is a feast for the senses. NDT alumni and new associate choreographers Imre van Opstal &amp; Marne van Opstal are back with a raw and emotional new creation, exploring how spaces impact us. We are also joined by brilliant makers Sharon Eyal &amp; Gai Behar and their hypnotising, vulnerable, and groovy&hellip;"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-05-30T20:00:00"
      }
