    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.ndt.nl/en/agenda/page/2/?waar=the-hague"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Digital Theatre | Into the Hairy"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": "NDT 1"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "NDT and Sharon Eyal Dance S-E-D have joined forces for this expanded interpretation of Into the Hairy (2023). Originally created for 7 dancers, the piece now brings together two companies in an expanded cast of more than 20 dancers. Into the Hairy tests the limits of contemporary dance by connecting classical dance with the underground&hellip;"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-04-17T00:01:00"
      }
    ]
  },
