    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The second NDT 2 programme of the season is a celebration of the playful and deeply human spirit of our NDT 2 dancers. A poem for the world brings together two much-loved works by associate choreographer Crystal Pite and choreographer Edward Clug, both accompanied by live music, alongside a world premiere by longtime collaborator Johan&hellip;"
      }
    ],
