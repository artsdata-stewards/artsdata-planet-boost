  {
    "@id": "https://www.thekingblackbox.com/event-details/the-glory-of-living-by-rebecca-gilman-2024-05-30-20-00",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "THE GLORY OF LIVING by Rebecca Gilman  | THE KING BLACK BOX"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "\"The Glory of Living,\" by Rebecca Gilman, is a riveting theatrical journey inspired by real-life events & the unsettling truths of true crime. Delving into the darkest corners of human nature, Gilman's narrative courageously confronts themes of abuse, violence, & possibilities or not of redemption."
      }
    ],
