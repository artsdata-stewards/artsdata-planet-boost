  {
    "@id": "https://www.thekingblackbox.com/event-details/bug-by-tracy-letts-2",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "BUG by Tracy Letts   | THE KING BLACK BOX"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "The King Black Box in partnership with Elkabong Theatre Projects\n\nFolie à deux, a rare psychiatric syndrome where delusional beliefs are shared between two closely associated individuals."
      }
    ],
