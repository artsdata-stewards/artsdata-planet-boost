    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "THE GLORY OF LIVING by Rebecca Gilman"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&#010;&quot;The Glory of Living,&quot; by Rebecca Gilman, is a riveting theatrical journey inspired by real-life events &amp; the unsettling truths of true crime. Delving into the darkest corners of human nature, Gilman's narrative courageously confronts themes of abuse, violence, &amp; possibilities or not of redemption."
      }
    ],
