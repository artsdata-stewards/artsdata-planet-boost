    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "PACIFIC BAROQUE ORCHESTRA: Goldberg Variations"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Tue Dec 2, 2:30pm | Bach’s Goldberg Variations—a masterpiece of invention, intricacy, and emotion—takes on new life in this bold reimagining by director and keyboardist Alexander Weimann. Performed by the acclaimed Pacific Baroque Orchestra, this chamber arrangement transforms a solo keyboard icon into a radiant ensemble experience, breathing fresh colour into Bach’s timeless score. Weimann’s orchestration [&hellip;]&lt;/p&gt;\\n"
      }
    ],
