    "https://schema.org/mainContentOfPage": [
      {
        "@language": "en",
        "@value": "\n\n\t\t\t\t\t \n\n                 \t\n\t\n\t\t\n\t\n\t\t1 event found.\t\n\t\n\t\t\n\t\n\n\t\t\n\t\n\n\t\t\n\t\n\n\t\n\n\n\t\t\n[{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Brushstrokes in conversation: A joint exhibition by two friends.\",\"description\":\"&lt;p&gt;This show grew out of friendship, curiosity, and plenty of paint. Brushstrokes in Conversation, celebrates the creative exchange between two artists who paint, laugh, learn, and explore together. The collection invites viewers to witness a dialogue not only between brush and canvas, but between two friends. Lobby open Tuesday to Friday 10:00am-2:00pm and when the [&hellip;]&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/event/lobby-exhibition-brushstrokes-in-conversation/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-12-02T10:00:00-08:00\",\"endDate\":\"2025-12-19T14:00:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Lobby\",\"description\":\"\",\"url\":\"https://artspring.ca/venue/artspring-lobby/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Jose Campbell and Lisa MacLean\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"performer\":\"Organization\"}]\n\n\t\t\n\t{\"slug\":\"organizer\",\"prev_url\":\"\",\"next_url\":\"\",\"view_class\":\"Tribe\\\\Events\\\\Pro\\\\Views\\\\V2\\\\Views\\\\Organizer_View\",\"view_slug\":\"organizer\",\"view_label\":\"Organizer\",\"lookup_folders\":{\"av_tec_v2_templates\":{\"id\":\"av_tec_v2_templates\",\"priority\":5,