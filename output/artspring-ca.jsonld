\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"5 \\u2013 15\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/giss-music-presents-lost-together/2023-01-19/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2022-12-14T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"GISS Music Presents: Four-Star Daydream\",\"description\":\"&lt;p&gt;GISS Music presents their year-end spectacular! Featuring students from the guitar class, GISPA Music, Concert Band, Jazz Band, and Choir. Come celebrate the end of the school year with a bang! With intermission and concessions. BUY TICKETS&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/event/giss-music-presents-four-star-daydream/2023-06-15/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2023-06-15T19:30:00-07:00\",\"endDate\":\"2023-06-15T21:30:00-07:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"GISS Music\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"10 \\u2013 15\",\"priceCurrency\":\"USD\",\"url\":\"ht