      {
        "@language": "en",
        "@value": "\n\n\t\t\t\t\t \n\n                 \t\n\t\n\t\t\n\t\n\t\t18 events found.\t\n\t\n\t\t\n\t\n\n\t\t\n\t\n\n\t\t\n\t\n\n\t\n\n\n\t\t\n[{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Salt Spring Film Festival presents LOVE+WAR\",\"description\":\"&lt;p&gt;Pulitzer Prize-winning photojournalist Lynsey Addario struggles to maintain family life in London while repeatedly risking her life on the frontlines, focusing on how women around the world are affected by war, disaster, political conflict &amp; oppressive regimes. Heart-stopping scenes and astonishing front-page photos are highlights of this National Geographic film, featuring moving accounts of the [&hellip;]&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/event/salt-spring-film-festival-presents-lovewar/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-12-03T19:30:00-08:00\",\"endDate\":\"2025-12-03T21:30:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Salt Spring Film Festival\",\"description\":\"\",\"url\":\"http://saltspringfilmfestival.com\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"http://saltspringfilmfestival.com\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"14 \\u2013 15\",\"priceCurrency\":\"CAD\",\"url\":\"https://artspring.ca/event/salt-spring-film-festival-presents-lovewar/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-09-26T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"CANCELLED\\u2014Creedence Clearwater Relived ~ Bad Moon Riders CCR Tribute Concert\",\"description\":\"&lt;p&gt;EVENT CANCELLED Creedence Clearwater Relived!! Saturday December 6th ArtSpring Theatre. An Amazing night of music and Epic nostalgia as Bad Moon Riders pay tribute to the legendary band, Creedence Clearwater Revival (CCR). The Electrifying Talent of Bad Moon Riders comprised of Members from BTO and Headpins, Deliver ALL the hits, ALL night long! From &quot;Proud [&hellip;]&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/event/creedence-clearwater-relived-bad-moon-riders-ccr-tribute-concert/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-12-06T19:30:00-08:00\",\"endDate\":\"2025-12-06T21:00:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Scotty Dog Entertainment Ltd.\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"44.95\",\"priceCurrency\":\"CAD\",\"url\":\"https://artspring.ca/event/creedence-clearwater-relived-bad-moon-riders-ccr-tribute-concert/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-10-16T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"BEAR GREASE THE MUSICAL\",\"description\":\"&lt;p&gt;Mon Dec 8, Tue Dec 9, 7:30pm |Get ready for two nights only! Bear Grease dares to reimagine the iconic 1972 musical Grease\\u00a0through a bold and comedic Indigenous lens. With a powwow-powered soundtrack and hip-hop flair, this high-energy, all-Indigenous production transforms classic hits into cultural celebration: \\u201cHopelessly Devoted\\u201d becomes a Round Dance, \\u201cBear Grease Lightning\\u201d [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/07/10.jpg\",\"url\":\"https://artspring.ca/event/bear-grease-the-musical/2025-12-08/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-12-08T19:30:00-08:00\",\"endDate\":\"2025-12-08T21:30:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"10 \\u2013 42\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/bear-grease-the-musical/2025-12-08/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-09-01T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"MET OPERA: Andrea Chenier (Giordano)\",\"description\":\"&lt;p&gt;Sat Dec 13, 10am | Giordano\\u2019s passionate tragedy stars tenor Piotr Becza\\u0142a as the virtuous poet who falls victim to the intrigue and violence of the French Revolution. Following their celebrated recent partnership in Giordano\\u2019s Fedora\\u00a0in the 2022\\u201323\\u00a0Live in HD\\u00a0season, Becza\\u0142a reunites with soprano Sonya Yoncheva as Ch\\u00e9nier\\u2019s aristocratic lover, Maddalena di Coigny, with baritone [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/07/4-1.jpg\",\"url\":\"https://artspring.ca/event/met-opera-andrea-chenier-giodano/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-12-13T10:00:00-08:00\",\"endDate\":\"2025-12-13T13:30:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"15 \\u2013 25\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/met-opera-andrea-chenier-giodano/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-08-28T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"GISS Music Presents: Musaic\",\"description\":\"&lt;p&gt;Come kick off Winter Break with GISS Music! Featuring original songs and compositions from the Composition and Production Class and GISPA Music Students, as well as performances from the Choir, Concert Band, Jazz Band and Jazz Combo. Please note - both nights are different nights of music, so to catch all the action you must [&hellip;]&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/event/giss-music-presents-musaic/2025-12-17/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-12-17T19:00:00-08:00\",\"endDate\":\"2025-12-17T21:00:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"GISS Music\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"15\",\"priceCurrency\":\"CAD\",\"url\":\"https://artspring.ca/event/giss-music-presents-musaic/2025-12-17/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-11-08T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Viva Chorale Presents Christmas in Cornwall\",\"description\":\"&lt;p&gt;Come celebrate the holiday season and support our local foodbank with Viva Chorale\\\\'s annual holiday concert fundraiser! This year the choir will sing carols interspersed with a lovely story from the UK: The Mousehole Cat. The tale follows the adventures of Mowzer the cat and her faithful human fisher, Tom Bawcock. This is a traditional [&hellip;]&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/event/viva-chorale-presents-christmas-in-cornwall/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-12-19T19:00:00-08:00\",\"endDate\":\"2025-12-19T21:00:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Viva Chorale!\",\"description\":\"\",\"url\":\"http://vivachoralesaltspring.com/\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"http://vivachoralesaltspring.com/\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"2 \\u2013 25\",\"priceCurrency\":\"CAD\",\"url\":\"https://artspring.ca/event/viva-chorale-presents-christmas-in-cornwall/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-11-08T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"MET OPERA: I Puritani (Bellini)\",\"description\":\"&lt;p&gt;Sat Jan 10, \\u00a010am | For gorgeous melody, spellbinding coloratura, and virtuoso vocal fireworks,\\u00a0I Puritani\\u00a0has few equals. On January 10, the first new Met production of Bellini\\u2019s final masterpiece in nearly 50 years\\u2014a striking staging by Charles Edwards, who makes his company directorial debut after many successes as a set designer\\u2014arrives in cinemas worldwide. The [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/07/5-1.jpg\",\"url\":\"https://artspring.ca/event/met-opera-i-puritani-bellini/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-01-10T10:00:00-08:00\",\"endDate\":\"2026-01-10T14:00:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"15 \\u2013 25\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/met-opera-i-puritani-bellini/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-08-28T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"GISS Theatre&#8217;s Peter Pan\",\"description\":\"&lt;p&gt;Peter Pan - GISS\\u2019s 2nd Story Theatre has been crafting an astounding new production of Peter Pan\\u2014a dynamic, imaginative show you won\\u2019t want to miss. This marks only the second time Grade 9 students have appeared in a 2nd Story production, and the entire ensemble has been working tirelessly to bring this magical world to [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/11/Copy-of-1056-x-480.jpg\",\"url\":\"https://artspring.ca/event/giss-theatres-peter-pan/2026-01-14/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-01-14T19:30:00-08:00\",\"endDate\":\"2026-01-14T21:30:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"GISS Drama\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"15\",\"priceCurrency\":\"CAD\",\"url\":\"https://artspring.ca/event/giss-theatres-peter-pan/2026-01-14/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-11-28T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"VICTORIA BAROQUE: Of Gods &#038; Men\",\"description\":\"&lt;p&gt;Sat Jan 17, 7:30-pm | Metropolitan Opera star soprano Mireille Asselin and acclaimed baritone Jesse Blumberg lead Victoria Baroque on a tour through great love stories of ancient mythology brought to life by the music of Handel, Purcell, and Rameau, with exciting, newly-commissioned Canadian compositions. Founded in 2011 by Finnish-born baroque flutist Soile Stratkauskas, Victoria [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/07/1-2.jpg\",\"url\":\"https://artspring.ca/event/victoria-baroque-of-gods-men/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-01-17T14:30:00-08:00\",\"endDate\":\"2026-01-17T16:30:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"10 \\u2013 42\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/victoria-baroque-of-gods-men/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-09-01T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Salt Spring Film Festival presents EVEREST DARK\",\"description\":\"&lt;p&gt;Behold the breathtaking beauty of Mount Everest as you\\u2018ve never seen it before \\u2013 through the eyes of the Sherpa people who worship the mountain as Chomolungma, the sacred Mother Goddess of the World. In the seven decades since Edmund Hillary &amp; Tenzing Norgay first summited the world\\u2019s highest peak, Everest has become a frozen [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/11/EVEREST-DARK-for-ticket-page-1600-x-900.jpg\",\"url\":\"https://artspring.ca/event/salt-spring-film-festival-presents-everest-dark/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-01-21T19:30:00-08:00\",\"endDate\":\"2026-01-21T21:30:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Salt Spring Film Festival\",\"description\":\"\",\"url\":\"http://saltspringfilmfestival.com\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"http://saltspringfilmfestival.com\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"14 \\u2013 15\",\"priceCurrency\":\"CAD\",\"url\":\"https://artspring.ca/event/salt-spring-film-festival-presents-everest-dark/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-11-19T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Candy Roberts is LARRY\",\"description\":\"&lt;p&gt;Comedy Gold! This show is for women and those who love them. Gear down, Big Rig, we\\u2019re going laughing. Award-winning Canadian Clown Artist Candy Roberts assumes her alter ego in this smart and daring piece about a lovable hoser\\u2019s hilarious attempt at self-improvement. He\\u2019s no \\u201cidiom,\\u201d and when the band doesn\\u2019t show up, tech guy [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/11/2.-ArtSpring-1056x480-pixels.jpg\",\"url\":\"https://artspring.ca/event/candy-roberts-is-larry/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-01-22T19:30:00-08:00\",\"endDate\":\"2026-01-22T20:30:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Candy Roberts\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"29\",\"priceCurrency\":\"CAD\",\"url\":\"https://artspring.ca/event/candy-roberts-is-larry/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-11-27T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"The Fretless\",\"description\":\"&lt;p&gt;Fri Jan 23, 7:30pm | Winners of a Juno Award and global fans alike, Canada\\u2019s genre-defying string quartet The Fretless is reshaping the way audiences hear traditional music. Rooted in fiddle traditions from around the world but arranged with a chamber music sensibility, their sound is intricate, high-energy, and deeply moving. With six albums and [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/07/2-2.jpg\",\"url\":\"https://artspring.ca/event/the-fretless-4/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-01-23T19:30:00-08:00\",\"endDate\":\"2026-01-23T21:30:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"10 \\u2013 42\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/the-fretless-4/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-09-02T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Buzz Brass: Famous Inspirations\",\"description\":\"&lt;p&gt;Sun Jan 25, 2:30pm | With flair, finesse, and fun, Canada\\u2019s renowned Buzz Brass quintet brings classical masterpieces into bold new focus. In Famous Inspirations, the group reimagines beloved works by Debussy, Ravel, Piazzolla, Dvo\\u0159\\u00e1k, and Liszt\\u2014including the iconic Hungarian Rhapsody No. 2 \\u2014through dazzling original arrangements. These turn-of-the-century classics are transformed through the brilliance [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/07/3-2.jpg\",\"url\":\"https://artspring.ca/event/buzz-brass-famous-inspirations/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-01-25T14:30:00-08:00\",\"endDate\":\"2026-01-25T16:30:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo