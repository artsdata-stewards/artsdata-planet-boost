    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Vetta Chamber Music Presents: Concert 5 &#8211; CELEBRATION &#8211; Angela Cheng and the Vetta Chamber Players"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;A poignant finale that reflects on treasured memories while opening doors to a bright future. Join these masterful artists in a celebratory program that spans history and highlights Vetta’s continuing [&hellip;]&lt;/p&gt;\\n"
