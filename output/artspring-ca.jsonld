      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;A warm welcome back to harpist Rita Costanzi, one of Vetta’s original featured artists. Experience her dramatic artistry alongside strings in evocative works that span eras and continents. Marcel Tournier | Vers la source dans le bois for solo harp Alexander Borodin | String Quartet No. 2 in D major Claude Debussy | Danse sacrée [&hellip;]&lt;/p&gt;\\n"
      }
