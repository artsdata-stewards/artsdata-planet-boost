        "@language": "en",
        "@value": "\n\n\t\t\t\t\t \n\n                 \t\n\t\n\t\t\n\t\n\t\t2 events found.\t\n\t\n\t\t\n\t\n\n\t\t\n\t\n\n\t\t\n\t\n\n\t\n\n\n\t\t\n[{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Brushstrokes in conversation: A joint exhibition by two friends.\",\"description\":\"&lt;p&gt;This show grew out of friendship, curiosity, and plenty of paint. Brushstrokes in Conversation, celebrates the creative exchange between two artists who paint, laugh, learn, and explore together. The collection invites viewers to witness a dialogue not only between brush and canvas, but between two friends. Lobby open Tuesday to Friday 10:00am-2:00pm and when the [&hellip;]&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/event/lobby-exhibition-brushstrokes-in-conversation/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-12-02T10:00:00-08:00\",\"endDate\":\"2025-12-19T14:00:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Lobby\",\"description\":\"\",\"url\":\"https://artspring.ca/venue/artspring-lobby/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Jose Campbell and Lisa MacLean\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"PACIFIC BAROQUE ORCHESTRA: Goldberg Variations\",\"description\":\"&lt;p&gt;Tue Dec 2, 2:30pm | Bach\\u2019s\\u00a0Goldberg Variations\\u2014a masterpiece of invention, intricacy, and emotion\\u2014takes on new life in this bold reimagining by director and keyboardist Alexander Weimann. Performed by the acclaimed Pacific Baroque Orchestra, this chamber arrangement transforms a solo keyboard icon into a radiant ensemble experience, breathing fresh colour into Bach\\u2019s timeless score. Weimann\\u2019s orchestration [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/07/9.jpg\",\"url\":\"https://artspring.ca/event/pacific-baroque-orchestra-goldberg-variations/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-12-02T14:30:00-08:00\",\"endDate\":\"2025-12-02T16:30:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Lobby\",\"description\":\"\",\"url\":\"https://artspring.ca/venue/artspring-lobby/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"10 \\u2013 42\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/pacific-baroque-orchestra-goldberg-variations/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-09-01T00:00:00+00:00\"},\"performer\":\"Organization\"}]\n\n\t\t\n\t{\"slug\":\"venue\",\"prev_url\":\"https:\\/\\/artspring.ca\\/venue\\/artspring-lobby\\/?hide_subsequent_recurrences=1&eventDisplay=past\",\"next_url\":\"\",\"view_class\":\"Tribe\\\\Events\\\\Pro\\\\Views\\\\V2\\\\Views\\\\Venue_View\",\"view_slug\":\"venue\",\"view_label\":\"Venue\",\"lookup_folders\":{\"av_tec_v2_templates\":{\"id\":\"av_tec_v2_templates\",\"p