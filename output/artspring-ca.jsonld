    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Sun Apr 19, 2:30pm |Rustic meets refined in this unforgettable concert of classical, folk, and fiddle fire. Guitarist William Coulter and violinist Edwin Huizinga—both celebrated virtuosos in their own right—blend [&hellip;]&lt;/p&gt;\\n"
      }
