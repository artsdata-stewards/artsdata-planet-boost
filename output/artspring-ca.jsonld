  },
  {
    "@id": "https://artspring.ca/temporary/d0683b74-795f-40c9-97af-3dab95d0a523",
    "@type": [
      "https://schema.org/WebPage"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://artspring.ca/organizer/artspring-8/"
      }
    ],
    "https://schema.org/mainContentOfPage": [
      {
        "@language": "en",
        "@value": "\n\n\t\t\t\t\t \n\n                 \t\n\t\n\t\t\n\t\n\t\t18 events found.\t\n\t\n\t\t\n\t\n\n\t\t\n\t\n\n\t\t\n\t\n\n\t\n\n\n\t\t\n[{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"PACIFIC BAROQUE ORCHESTRA: Goldberg Variations\",\"description\":\"&lt;p&gt;Tue Dec 2, 2:30pm | Bach\\u2019s\\u00a0Goldberg Variations\\u2014a masterpiece of invention, intricacy, and emotion\\u2014takes on new life in this bold reimagining by director and keyboardist Alexander Weimann. Performed by the acclaimed Pacific Baroque Orchestra, this chamber arrangement transforms a solo keyboard icon into a radiant ensemble experience, breathing fresh colour into Bach\\u2019s timeless score. Weimann\\u2019s orchestration [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/07/9.jpg\",\"url\":\"https://artspring.ca/event/pacific-baroque-orchestra-goldberg-variations/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-12-02T14:30:00-08:00\",\"endDate\":\"2025-12-02T16:30:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Lobby\",\"description\":\"\",\"url\":\"https://artspring.ca/venue/artspring-lobby/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"10 \\u2013 42\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/pacific-baroque-orchestra-goldberg-variations/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-09-01T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"BEAR GREASE THE MUSICAL\",\"description\":\"&lt;p&gt;Mon Dec 8, Tue Dec 9, 7:30pm |Get ready for two nights only! Bear Grease dares to reimagine the iconic 1972 musical Grease\\u00a0through a bold and comedic Indigenous lens. With a powwow-powered soundtrack and hip-hop flair, this high-energy, all-Indigenous production transforms classic hits into cultural celebration: \\u201cHopelessly Devoted\\u201d becomes a Round Dance, \\u201cBear Grease Lightning\\u201d [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/07/10.jpg\",\"url\":\"https://artspring.ca/event/bear-grease-the-musical/2025-12-08/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-12-08T19:30:00-08:00\",\"endDate\":\"2025-12-08T21:30:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"10 \\u2013 42\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/bear-grease-the-musical/2025-12-08/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-09-01T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"MET OPERA: Andrea Chenier (Giordano)\",\"description\":\"&lt;p&gt;Sat Dec 13, 10am | Giordano\\u2019s passionate tragedy stars tenor Piotr Becza\\u0142a as the virtuous poet who falls victim to the intrigue and violence of the French Revolution. Following their celebrated recent partnership in Giordano\\u2019s Fedora\\u00a0in the 2022\\u201323\\u00a0Live in HD\\u00a0season, Becza\\u0142a reunites with soprano Sonya Yoncheva as Ch\\u00e9nier\\u2019s aristocratic lover, Maddalena di Coigny, with baritone [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/07/4-1.jpg\",\"url\":\"https://artspring.ca/event/met-opera-andrea-chenier-giodano/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-12-13T10:00:00-08:00\",\"endDate\":\"2025-12-13T13:30:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"15 \\u2013 25\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/met-opera-andrea-chenier-giodano/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-08-28T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"MET OPERA: I Puritani (Bellini)\",\"description\":\"&lt;p&gt;Sat Jan 10, \\u00a010am | For gorgeous melody, spellbinding coloratura, and virtuoso vocal fireworks,\\u00a0I Puritani\\u00a0has few equals. On January 10, the first new Met production of Bellini\\u2019s final masterpiece in nearly 50 years\\u2014a striking staging by Charles Edwards, who makes his company directorial debut after many successes as a set designer\\u2014arrives in cinemas worldwide. The [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/07/5-1.jpg\",\"url\":\"https://artspring.ca/event/met-opera-i-puritani-bellini/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-01-10T10:00:00-08:00\",\"endDate\":\"2026-01-10T14:00:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"15 \\u2013 25\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/met-opera-i-puritani-bellini/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-08-28T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"VICTORIA BAROQUE: Of Gods &#038; Men\",\"description\":\"&lt;p&gt;Sat Jan 17, 7:30-pm | Metropolitan Opera star soprano Mireille Asselin and acclaimed baritone Jesse Blumberg lead Victoria Baroque on a tour through great love stories of ancient mythology brought to life by the music of Handel, Purcell, and Rameau, with exciting, newly-commissioned Canadian compositions. Founded in 2011 by Finnish-born baroque flutist Soile Stratkauskas, Victoria [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/07/1-2.jpg\",\"url\":\"https://artspring.ca/event/victoria-baroque-of-gods-men/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-01-17T14:30:00-08:00\",\"endDate\":\"2026-01-17T16:30:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"10 \\u2013 42\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/victoria-baroque-of-gods-men/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-09-01T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"The Fretless\",\"description\":\"&lt;p&gt;Fri Jan 23, 7:30pm | Winners of a Juno Award and global fans alike, Canada\\u2019s genre-defying string quartet The Fretless is reshaping the way audiences hear traditional music. Rooted in fiddle traditions from around the world but arranged with a chamber music sensibility, their sound is intricate, high-energy, and deeply moving. With six albums and [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/07/2-2.jpg\",\"url\":\"https://artspring.ca/event/the-fretless-4/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-01-23T19:30:00-08:00\",\"endDate\":\"2026-01-23T21:30:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"10 \\u2013 42\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/the-fretless-4/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-09-02T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Buzz Brass: Famous Inspirations\",\"description\":\"&lt;p&gt;Sun Jan 25, 2:30pm | With flair, finesse, and fun, Canada\\u2019s renowned Buzz Brass quintet brings classical masterpieces into bold new focus. In Famous Inspirations, the group reimagines beloved works by Debussy, Ravel, Piazzolla, Dvo\\u0159\\u00e1k, and Liszt\\u2014including the iconic Hungarian Rhapsody No. 2 \\u2014through dazzling original arrangements. These turn-of-the-century classics are transformed through the brilliance [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/07/3-2.jpg\",\"url\":\"https://artspring.ca/event/buzz-brass-famous-inspirations/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-01-25T14:30:00-08:00\",\"endDate\":\"2026-01-25T16:30:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"10 \\u2013 42\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/buzz-brass-famous-inspirations/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-09-01T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"COREY PAYETTE: LES FILLES du ROI (The King&#8217;s Daughters)\",\"description\":\"&lt;p&gt;IMMERSIVE EXPERIENCE: A TWO-NIGHT EVENT: FILM SCREENING + LIVE CONCERT FRI JAN 30 | SAT JAN 31 | A moving intersection of Indigenous and feminist storytelling through film, music, and community gathering. Featuring workshops in filmmaking, costume design, Indigenous Circle Gathering and youth choir performances. Corey Payette is an award-winning Anishinaabe composer whose musicals have [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/07/4-2.jpg\",\"url\":\"https://artspring.ca/event/corey-payette-les-filles-du-roi-the-kings-daughters/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-01-30T19:30:00-08:00\",\"endDate\":\"2026-01-30T21:30:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"10 \\u2013 42\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/corey-payette-les-filles-du-roi-the-kings-daughters/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-09-02T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"COREY PAYETTE: CLOSEST THING TO HOME\",\"description\":\"&lt;p&gt;IMMERSIVE EXPERIENCE: A TWO-NIGHT EVENT: FILM SCREENING + LIVE CONCERT FRI JAN 30 | SAT JAN 31 | A moving intersection of Indigenous and feminist storytelling through film, music, and community gathering. Featuring workshops in filmmaking, costume design, Indigenous Circle Gathering and youth choir performances. Corey Payette is an award-winning Anishinaabe composer whose musicals have [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/07/5-2.jpg\",\"url\":\"https://artspring.ca/event/corey-payette-live-concert/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-01-31T19:30:00-08:00\",\"endDate\":\"2026-01-31T21:30:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"10 \\u2013 42\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/corey-payette-live-concert/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-09-02T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Royal Winnipeg Ballet\",\"description\":\"&lt;p&gt;Tue Feb 2, 7:30pm | For the first time on ArtSpring\\u2019s stage, Canada\\u2019s celebrated Royal Winnipeg Ballet presents selections from a compelling double bill. T\\u2019\\u0259l: The Wild Man of the Woods is a bold new work choreographed by Cameron Fraser-Monroe, unfolding a Coast Salish legend through Indigenous storytelling, ballet, and a haunting score by Two-Spirit [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/07/4-3.jpg\",\"url\":\"https://artspring.ca/event/royal-winnipeg-ballet/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-02-03T19:30:00-08:00\",\"endDate\":\"2026-02-03T21:30:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"10 \\u2013 42\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/royal-winnipeg-ballet/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-09-01T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"TAMAR ILANA &#038; VENTANAS\",\"description\":\"&lt;p&gt;SUN FEB 8, 2:30pm | Led by powerhouse vocalist and dancer Tamar Ilana, Ventanas is a vibrant six-piece world music ensemble that weaves together flamenco, Sephardic, Balkan, and original music in a captivating live experience. Singing in over 20 languages\\u2014from Ladino to Romani to Arabic\\u2014the Toronto-based group fuses cultural traditions with contemporary flair, creating a [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/07/6-3.jpg\",\"url\":\"https://artspring.ca/event/tamar-ilana-ventanas/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-02-08T14:30:00-08:00\",\"endDate\":\"2026-02-08T16:30:00-08:00\",\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"10 \\u2013 42\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/tamar-ilana-ventanas/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-09-02T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"MEASHA BRUEGGERGOSMAN-LEE: Zombie Blizzard\",\"description\":\"&lt;p&gt;Immersive Experience Week Feb 14-20, 2025: In concert with Black History Month, engage with a week-long residency celebrating Black artistry and excellence through concerts, open rehearsals, public talks, and educational workshops \\u2013 culminating in a Brueggergosman-Lee\\u2019s Zombie Blizzard as well as a stirring gospel performance with community collaboration. Prepare for Zombie Blizzard, a daring, seven-movement [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/07/11.jpg\",\"url\":\"https://artspring.ca/event/measha-brueggergosman-lee-zombie-blizzard/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-02-17T19:30:00-08:00\",\"endDate\":\"2026-02-17T21:30:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"10 \\u2013 42\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/measha-brueggergosman-lee-zombie-blizzard/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-09-01T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"MEASHA BRUEGGERGOSMAN-LEE: A Special Gospel Concert\",\"description\":\"&lt;p&gt;Immersive Experience Week Feb 14-20, 2025 | In concert with Black History Month, engage with a week-long residency celebrating Black artistry and excellence through concerts, open rehearsals, public talks, and educational workshops \\u2013 culminating in a Brueggergosman-Lee\\u2019s Zombie Blizzard as well as a stirring gospel performance with community collaboration. To close the week, Measha leads [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/07/12.jpg\",\"url\":\"https://artspring.ca/event/measha-brueggergosman-lee-a-special-gospel-concert/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-02-20T19:30:00-08:00\",\"endDate\":\"2026-02-20T21:30:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"10 \\u2013 42\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/measha-brueggergosman-lee-a-special-gospel-concert/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-09-01T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"MYRTLE SISTERS: Same, Same, Different\",\"description\":\"&lt;p&gt;Wed Mar 4, 7:30pm | Tap shoes, twinkling harmonies, and delightful chaos\\u2014Same Same Different\\u00a0is a vaudeville-inspired musical comedy from Vancouver\\u2019s Myrtle Sisters, featuring Salt Spring\\u2019s own Nayana Fielkov. When a trio of identical sisters suddenly discover they\\u2019re not so identical after all, hilarity (and heartfelt lessons) unfold. Through vintage tunes, original songs, and spirited dance [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/07/Myrtle-Sisters_Slide.jpg\",\"url\":\"https://artspring.ca/event/myrtle-sisters-same-same-different/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-03-03T19:30:00-08:00\",\"endDate\":\"2026-03-03T21:30:00-08:00\",\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"10 \\u2013 42\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/myrtle-sisters-same-same-different/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-09-01T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"MICHAEL KAESHAMMER\",\"description\":\"&lt;p&gt;Thu Mar 19, 7:30pm | He\\u2019s back! Beloved by ArtSpring audiences and celebrated worldwide, Michael Kaeshammer is a virtuosic pianist, charismatic performer, and master showman. His concerts are high-octane journeys through jazz, boogie-woogie, pop, and soul\\u2014infused with signature charm, playful improvisation, and unstoppable joy. Whether he\\u2019s lighting up the keys in a driving rhythm or [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/07/8-3.jpg\",\"url\":\"https://artspring.ca/event/michael-kaeshammer-4/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-03-19T19:30:00-07:00\",\"endDate\":\"2026-03-19T21:30:00-07:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"10 \\u2013 42\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/michael-kaeshammer-4/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-07-16T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"BALLET KELONA: Vividus &#8212; Full of Life\",\"description\":\"&lt;p&gt;Mon Mar 23, 7:30pm | After opening ArtSpring\\u2019s 25th Anniversary season to acclaim, Ballet Kelowna returns with Vividus: Full of Life\\u2014a bold, high-energy program featuring three dazzling contemporary works by top Canadian choreographers. Alysa Pires\\u2019\\u00a0Vestigesis a sweeping, cinematic reflection on connection in a chaotic world.\\u00a0The Forever Part\\u00a0by Kirsten Wicklund offers a dreamlike meditation on longing, [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/07/Kelowna-Ballet_Slide.jpg\",\"url\":\"https://artspring.ca/event/ballet-kelona-vividus-full-of-life/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-03-23T19:30:00-07:00\",\"endDate\":\"2026-03-23T21:30:00-07:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"10 \\u2013 42\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/ballet-kelona-vividus-full-of-life/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-09-01T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"FIRE &#038; GRACE\",\"description\":\"&lt;p&gt;Sun Apr 19, 2:30pm |Rustic meets refined in this unforgettable concert of classical, folk, and fiddle fire. Guitarist William Coulter and violinist Edwin Huizinga\\u2014both celebrated virtuosos in their own right\\u2014blend the elegance of Bach and Vivaldi with the foot-stomping spirit of Celtic reels, Appalachian waltzes, Bulgarian dances, and tango. \\u00a0 Fire &amp; Grace is a [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/07/9-2.jpg\",\"url\":\"https://artspring.ca/event/fire-grace/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-04-19T14:30:00-07:00\",\"endDate\":\"2026-04-19T16:30:00-07:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"10 \\u2013 42\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/fire-grace/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-09-01T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"CHENG\\u00b2 DUO WITH JAMES CAMPBELL\",\"description\":\"&lt;p&gt;Tue Apr 28, 7:30 | Siblings Bryan and Silvie Cheng\\u2014known internationally as the Cheng\\u00b2 Duo (pronounced Cheng Squared)\\u2014bring an electrifying chemistry to the stage that transcends classical tradition. Their artistry, praised as \\u201cbrilliant\\u201d (The Sunday Times) and \\u201cabsolutely captivating\\u201d (Pizzicato Magazine), blends youthful energy with technical mastery and emotional depth. JUNO-nominated and celebrated worldwide for [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/07/Cheng-Duo_Slide.jpg\",\"url\":\"https://artspring.ca/event/cheng%c2%b2-duo-with-james-campbell/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-04-28T19:30:00-07:00\",\"endDate\":\"2026-04-28T21:30:00-07:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"10 \\u2013 42\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/cheng%c2%b2-duo-with-james-campbell/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-09-01T00:00:00+00:00\"},\"performer\":\"Organization\"}]\n\n\t\t\n\t{\"slug\":\"organizer\",\"prev_url\":\"https:\\/\\/artspring.ca\\/organizer\\/artspring-8\\/?hide_subsequent_recurrences=1&eventDisplay=past\",\"next_url\":\"https:\\/\\/artspring.ca\\/organizer\\/artspring-8\\/page\\/2\\/?hide_subsequent_recurrences=1\",\"view_class\":\"Tribe\\\\Events\\\\Pro\\\\Views\\\\V2\\\\Views\\\\Organizer_View\",\"view_slug\":\"organizer\",\"view_label\":\"Organizer\",\"lookup_folders\":{\"av_tec_v2_templates\":{\"id\":\"av_tec_v2_templates\",\"