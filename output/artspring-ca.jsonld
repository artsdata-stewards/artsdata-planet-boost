    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "MAKANA YOUTH CHOIRS: Spring Concert"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Fri May 22, 7:00pm | Celebrate the joy of youth music making and come check out the Makana Choir’s Spring concert! As usual with a Makana concert, the choirs learn a variety of repertoire in different styles and languages and cultures. There are some pieces that are quite humorous and others that are thought provoking [&hellip;]&lt;/p&gt;\\n"
      }
    ],
