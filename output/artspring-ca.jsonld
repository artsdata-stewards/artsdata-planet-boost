      {
        "@language": "en",
        "@value": "\n\n\t\t\t\t\t \n\n                 \t\n\t\n\t\t\n\t\n\t\t18 events found.\t\n\t\n\t\t\n\t\n\n\t\t\n\t\n\n\t\t\n\t\n\n\t\n\n\n\t\t\n[{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"GISS MUSIC\",\"description\":\"&lt;p&gt;GISS Music presents two nights of almost entirely original music created in class by GISS students over the duration of the semester. The jazz combo will feature two original works and one arrangement, a classic Summertime and Haitian Fight Song, woven together with beautiful solos by Liam Sinclair and others. The Senior Composition students will [&hellip;]&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/event/giss-music-3/2014-06-11/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2014-06-11T19:30:00-07:00\",\"endDate\":\"2014-06-11T21:00:00-07:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"GISS Music\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"12\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/giss-music-3/2014-06-11/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2014-04-30T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"GISS Music\",\"description\":\"&lt;p&gt;GISS Music presents a night of music by talented local students. The concert features the junior composition class, the mixed choir, GISPA Music students, and Mudd - the newly formed vocal group.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/event/giss-music-4/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2015-01-15T19:30:00-08:00\",\"endDate\":\"2015-01-15T21:00:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"GISS Music\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"14\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/giss-music-4/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2015-01-05T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"GISS MUSIC: YEAR-END SHOW\",\"description\":\"&lt;p&gt;GISS Music\\\\'s year-end show features\\u00a0the hard work of the high school music student\\u00a0choirs and senior composition class with some GISPA music and guitar included\\u00a0for good measure! The show starts at 7:30 p.m. with a draw for prizes in a basket on the first night of two &quot;super phaat sonic treat&quot; runs.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/event/giss-music-year-end-show/2015-06-03/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2015-06-03T19:30:00-07:00\",\"endDate\":\"2015-06-03T20:40:00-07:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"GISS Music\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"12\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/giss-music-year-end-show/2015-06-03/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2015-05-12T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"GISS MUSIC\",\"description\":\"&lt;p&gt;The mid-year Gulf Islands Secondary School\\u00a0Music Department presents a collection of original and cover material by\\u00a0the Junior Composition class with a smoldering bite-size of GISPA music intertwined in the concert. To end the evening\\u00a0listen to\\u00a0a little a cappella royalty with Freddie Mercury\\\\'s Bohemian Rhapsody. Come and enjoy the sonic surprises of these talented young musicians. [&hellip;]&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/event/giss-music-5/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2016-01-21T19:30:00-08:00\",\"endDate\":\"2016-01-21T20:45:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"GISS Music\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"10.00 \\u2013 15\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/giss-music-5/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2015-12-14T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"GISS MUSIC: SPIRITS\",\"description\":\"&lt;p&gt;GISS Music presents Spirits, a really big show comprised of the senior composition class, and selections from the guitar class, choir and GISPA music students. To round off the evening, there will also be a couple of solos. Please note, the show begins at\\u00a07:15 pm&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/event/giss-music-spirits/2016-06-08/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2016-06-08T19:15:00-07:00\",\"endDate\":\"2016-06-08T20:30:00-07:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"GISS Music\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"12\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/giss-music-spirits/2016-06-08/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2016-05-24T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"GISS Music: Mad World\",\"description\":\"&lt;p&gt;It\\\\'s cold out there! Warm up to the sounds of GISS Music department with this\\u00a0one night only performance. The performance includes selections from the Junior composition class, small ensembles, some beautiful solos, choir and GISPA music. Come and take a listen to this talented bunch of musicians.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/event/giss-music-show-4/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2017-01-24T19:00:00-08:00\",\"endDate\":\"2017-01-24T20:30:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"GISS Music\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"GISS Music Year End Performance\",\"description\":\"&lt;p&gt;The GISS music department will give a year end performance named The Parting Glass which will feature The Composition Class, the Choir and Gispa. The talented students always surprise audiences with their diverse tastes and creative musical abilities. It has been a pleasure to work, teach and learn from students in these Gulf Islands. Mr. [&hellip;]&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/event/giss-music-year-end-performance/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2018-06-13T19:30:00-07:00\",\"endDate\":\"2018-06-13T21:00:00-07:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"GISS Music\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"15.00\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/giss-music-year-end-performance/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2018-05-22T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"GLOW &#8211; GISS Music Show\",\"description\":\"&lt;p&gt;BUY TICKETS The GISS Music students have been working hard all semester to prepare a fantastic program for your listening enjoyment! There will be performances by the Concert Band, Concert Choir and we will feature original compositions and arrangements by the Junior Composition Class and GISPA Music Students. Proceeds from ticket sales go towards supporting [&hellip;]&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/event/glow-giss-music-show/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2019-01-21T19:30:00-08:00\",\"endDate\":\"2019-01-21T21:00:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddr