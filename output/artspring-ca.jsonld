    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Parallel Art Show (PAS)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;The Salt Spring National Art Prize (SSNAP) is a biennial, juried competition and exhibition of Canadian contemporary art. Held on Salt Spring Island, BC, SSNAP celebrates and promotes artists from across the country through a major exhibition, significant awards, and national recognition. The Parallel Art Show (PAS) is a juried exhibition showcasing artists from the [&hellip;]&lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
