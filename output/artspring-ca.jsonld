nd\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"GISS Music\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"15.00\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/giss-music-presents-the-weights/2019-06-13/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2019-05-15T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"SIMS/GISS Music Presents: A Not-So-Silent Night\",\"description\":\"&lt;p&gt;BUY TICKETS &nbsp; &nbsp; &nbsp; &nbsp; Come join SIMS and GISS Music students as they present their winter concert repertoire! Night One: Beginner Band, Senior Band, Junior Composition, GISS Jazz, Concert Choir. Night Two: Senior Band, Junior Composition, GISPA Music, SIMS Jazz, CUBA 2020 Students and Concert Choir. Download or print the program in advance [&hellip;]&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/event/sims-giss-music-presents-a-not-so-silent-night/2019-12-19/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2019-12-19T19:30:00-08:00\",\"endDate\":\"2019-12-19T21:30:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"GISS Music\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"5 \\u2013 15\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/sims-giss-music-presents-a-not-so-silent-night/2019-12-19/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2019-11-15T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"GISS Music Presents: Arcadia\",\"description\":\"&lt;p&gt;BUY TICKETS Come celebrate with the GISS Music students as we eagerly present our first live performance in two years! Featuring students from the guitar class, composition class, GISPA music and the GISS jazz combo. ArtSpring terms and conditions of sale (2021-22 season) \\u2022 Proof of vaccination is required for every patron age 12+ attending [&hellip;]&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/event/giss-music-presents-arcadia/2021-12-16/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2021-12-16T19:30:00-08:00\",\"endDate\":\"2021-12-16T21:00:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\