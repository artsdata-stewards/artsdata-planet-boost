      {
        "@language": "en",
        "@value": "Salt Spring Community Showcase!"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Salt Spring Community Showcase 2026, Live at ArtSpring – April 17, 2026 | 7:30 PM One night. Endless talent. All Salt Spring. Get ready for an unforgettable evening of creativity, passion, and performance as ArtSpring RoundTable proudly presents the Salt Spring Community Showcase — a dynamic celebration of the artistic spirit that makes our island [&hellip;]&lt;/p&gt;\\n"
