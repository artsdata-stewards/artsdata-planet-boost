      {
        "@language": "en",
        "@value": "\n\n\t\t\t\t\t \n\n                 \t\n\t\n\t\t\n\t\n\t\t1 event found.\t\n\t\n\t\t\n\t\n\n\t\t\n\t\n\n\t\t\n\t\n\n\t\n\n\n\t\t\n[{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Candy Roberts is LARRY\",\"description\":\"&lt;p&gt;Comedy Gold! This show is for women and those who love them. Gear down, Big Rig, we\\u2019re going laughing. Award-winning Canadian Clown Artist Candy Roberts assumes her alter ego in this smart and daring piece about a lovable hoser\\u2019s hilarious attempt at self-improvement. He\\u2019s no \\u201cidiom,\\u201d and when the band doesn\\u2019t show up, tech guy [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/11/2.-ArtSpring-1056x480-pixels.jpg\",\"url\":\"https://artspring.ca/event/candy-roberts-is-larry/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-01-22T19:30:00-08:00\",\"endDate\":\"2026-01-22T20:30:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Candy Roberts\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"29\",\"priceCurrency\":\"CAD\",\"url\":\"https://artspring.ca/event/candy-rober