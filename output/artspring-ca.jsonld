    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Lobby Exhibition: Seth Berkowitz Presents Open Spaces"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Empty Spaces is a photographic meditation on the social landscape, explored through scenes where human presence is absent but deeply felt. These images—of deserted streets, vacant interiors, and peripheral zones—highlight the traces of daily life and our collective behavior, values, and absences. The work considers emptiness not as void, but as a charged condition—where silence [&hellip;]&lt;/p&gt;\\n"
      }
    ],
