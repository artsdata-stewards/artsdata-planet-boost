  {
    "@id": "https://artspring.ca/temporary/506a2427-19e9-4fa7-9c3a-eca46764fc03",
    "@type": [
      "https://schema.org/WebPage"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
