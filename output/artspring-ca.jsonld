    "https://schema.org/mainContentOfPage": [
      {
        "@language": "en",
        "@value": "\n\n\t\t\t\t\t \n\n                 \t\n\t\n\t\t\n\t\n\t\t1 event found.\t\n\t\n\t\t\n\t\n\n\t\t\n\t\n\n\t\t\n\t\n\n\t\n\n\n\t\t\n[{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"CANCELLED\\u2014Creedence Clearwater Relived ~ Bad Moon Riders CCR Tribute Concert\",\"description\":\"&lt;p&gt;EVENT CANCELLED Creedence Clearwater Relived!! Saturday December 6th ArtSpring Theatre. An Amazing night of music and Epic nostalgia as Bad Moon Riders pay tribute to the legendary band, Creedence Clearwater Revival (CCR). The Electrifying Talent of Bad Moon Riders comprised of Members from BTO and Headpins, Deliver ALL the hits, ALL night long! From &quot;Proud [&hellip;]&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/event/creedence-clearwater-relived-bad-moon-riders-ccr-tribute-concert/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-12-06T19:30:00-08:00\",\"endDate\":\"2025-12-06T21:00:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Scotty Dog Entertainment Ltd.\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"44.95\",\"priceCurrency\":\"CAD\",\"url\":\"https://artsp