        "@language": "en",
        "@value": "\n\n\t\t\t\t\t \n\n                 \t\n\t\n\t\t\n\t\n\t\t18 events found.\t\n\t\n\t\t\n\t\n\n\t\t\n\t\n\n\t\t\n\t\n\n\t\n\n\n\t\t\n[{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Salt Spring Forum Presents Author John Vaillant\",\"description\":\"&lt;p&gt;In his recent book: Fire Weather, John Vaillant tells the story of the 2016 Fort McMurray fire, its shocking power and devastating appetite for destruction. From his research into the fire he chronicles the history of the oil industry, climate science and of fire itself creating a fascinating and terrifying tale. Onstage at the Forum, [&hellip;]&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/event/salt-spring-forum-presents-author-john-vaillant/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-08-29T19:30:00-07:00\",\"endDate\":\"2025-08-29T21:00:00-07:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"20 \\u2013 25\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/salt-spring-forum-presents-author-john-vaillant/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-07-15T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"2025/26 Season Launches\",\"description\":\"&lt;p&gt;TUE SEP 2 | Ticket sales open for members in person on Tuesday September 2, 10am-4pm before being made available to members online at 10am Wednesday. General public sales open Tuesday September 9th. Explore our 100% all-Canadian ArtSpring Presents programming of dance, music, theatre, community workshops and initiatives, and some very special surprise national and [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/07/Sneak-Peek-Launch-Event-Aug-28-2.jpg\",\"url\":\"https://artspring.ca/event/2025-26-season-launch-gala/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-09-02T10:00:00-07:00\",\"endDate\":\"2025-09-02T16:00:00-07:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"MAKANA YOUTH CHOIRS: Fall Term\",\"description\":\"&lt;p&gt;Fridays, Sep 12-Nov 21 |The Makana Choirs are the place to develop healthy singing habits, learn musical literary skills, and put on a concert. All while having fun with friends! Makana is directed by Caroni Young and accompanied by Cicela M\\u00e5nsson. ++ The Makana Kids Class is for singers in grades 2-5. This class is [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2024/08/Slide_Makana3.jpg\",\"url\":\"https://artspring.ca/event/makana-youth-choirs-fall-term-2/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-09-12T15:30:00-07:00\",\"endDate\":\"2025-09-12T17:30:00-07:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Lobby\",\"description\":\"\",\"url\":\"https://artspring.ca/venue/artspring-lobby/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"150\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/makana-youth-choirs-fall-term-2/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-07-22T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"SWEETGRASS ARTS AND MUSIC INDIGENOUS SHOWCASE\",\"description\":\"&lt;p&gt;SAT SEP 13 | 7:00pm | Sweetgrass Arts and Music Indigenous Showcase Presented by Sweetgrass Arts and Music Society in partnership with ArtSpring RoundTable Committee We kick off the night with the soulful sounds of Kai Barrette, a rising local youth artist whose vocals and guitar work promise to stir the heart and set the [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/08/Untitled-design.jpg\",\"url\":\"https://artspring.ca/event/sweetgrassshowcase/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-09-13T19:00:00-07:00\",\"endDate\":\"2025-09-13T22:00:00-07:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"10 \\u2013 30\",\"priceCurrency\":\"CAD\",\"url\":\"https://artspring.ca/event/sweetgrassshowcase/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-08-15T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"CHARLES RICHARD-HAMELIN\",\"description\":\"&lt;p&gt;Fri Sep 26, 7:30pm | Renowned for his poetic touch and commanding presence, Charles Richard-Hamelin is one of Canada\\u2019s most celebrated classical pianists. A silver medalist at the 2015 International Chopin Piano Competition and winner of the Krystian Zimerman Prize, he has since performed with major orchestras around the world under the baton of Yannick [&hellip;]&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/event/charles-richard-hamelin/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-09-26T19:30:00-07:00\",\"endDate\":\"2025-09-26T21:30:00-07:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"10 \\u2013 42\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/charles-richard-hamelin/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-09-01T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"BANFF CENTRE MOUNTAIN FILM FESTIVAL\",\"description\":\"&lt;p&gt;Fri Oct 10, 7pm | Sat Oct 11, 2pm | A sell-out two years in a row! This year, ArtSpring has selected TWO different curated packages of top films including award-winners and audience favourites sure to connect with our community. Traveling to remote vistas, analyzing topical environmental issues, and bringing audiences up-close and personal with [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/07/4.jpg\",\"url\":\"https://artspring.ca/event/banff-centre-mountain-film-festival-2/2025-10-11/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-10-11T14:00:00-07:00\",\"endDate\":\"2025-10-11T17:00:00-07:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"10 \\u2013 20\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/banff-centre-mountain-film-festival-2/2025-10-11/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-09-01T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"ANGELA CHENG: Beloved Treasures\",\"description\":\"&lt;p&gt;Tue Oct 14, 7:30pm | Widely hailed as one of Canada\\u2019s most distinguished pianists, Angela Cheng brings dazzling technique, expressive depth, and a luminous touch to every performance. A gold medalist at the Arthur Rubinstein Piano Masters Competition and the first Canadian to win the Montreal International Piano Competition, Cheng has performed at Carnegie Hall, [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/07/2.jpg\",\"url\":\"https://artspring.ca/event/angela-cheng-prisms/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-10-14T19:30:00-07:00\",\"endDate\":\"2025-10-14T21:30:00-07:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"10 \\u2013 42\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/angela-cheng-prisms/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-09-01T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"HIROMOTO IDA: Vacant Lot\",\"description\":\"&lt;p&gt;Fri Oct 17, 7:30pm |In this poignant and poetic dance-theatre work by Hiromoto Ida (Sh\\u014dgun,\\u00a0The Man in the High Castle) a long-married couple revisits the now-empty lot where their family home once stood. What begins as a tender sharing of memories gradually opens into a meditation on time, impermanence, and the fragility of life itself. [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/07/5.jpg\",\"url\":\"https://artspring.ca/event/hiromoto-ida-vacant-lot/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-10-17T19:30:00-07:00\",\"endDate\":\"2025-10-17T21:30:00-07:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"10 \\u2013 42\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/hiromoto-ida-vacant-lot/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-09-01T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"MET OPERA NOW ON SALE: La Sonnambula (AP)\",\"description\":\"&lt;p&gt;SIX OPERAS NOW ON SALE | First up -- Sat Oct. 18 10am | Following triumphant Live in HD\\u00a0performances in Gounod\\u2019s\\u00a0Rom\\u00e9o\\u00a0et\\u00a0Juliette, Verdi\\u2019s\\u00a0La\\u00a0Traviata, and Donizetti\\u2019s\\u00a0Lucia\\u00a0di\\u00a0Lammermoor, Nadine Sierra summits another peak of the soprano repertoire as Amina, who sleepwalks her way into audiences\\u2019 hearts in Bellini\\u2019s poignant tale of love lost and found. In his new production, [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/07/1.jpg\",\"url\":\"https://artspring.ca/event/met-opera-la-sonnambula-ap/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-10-18T10:00:00-07:00\",\"endDate\":\"2025-10-18T13:30:00-07:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"15 \\u2013 25\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/met-opera-la-sonnambula-ap/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-08-28T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"SSI Spinners &#038; Weavers Fall Exhibition &#038; Sale\",\"description\":\"&lt;p&gt;Salt Spring\\\\'s Weavers and Spinners Guild returns to ArtSpring for its annual fall exhibition and sale from October 23-26. We cordially invite you to drop by to browse for one-of-a-kind gifts or to chat with guild members about their textile passions. This is a dynamic group of textile artisans who handcraft both practical and decorative [&hellip;]&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/event/ssi-spinners-weavers-fall-exhibition-sale/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-10-23T10:00:00-07:00\",\"endDate\":\"2025-10-26T16:00:00-07:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Gallery\",\"description\":\"\",\"url\":\"https://artspring.ca/venue/artspring-gallery/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"FUNNY, YOU DON&#8217;T LOOK AUTISTIC\",\"description\":\"&lt;p&gt;Fri Oct 24, 7:30pm | Part stand-up, part storytelling, and all heart, this sharp solo show by autistic comedian and author Michael McCreary explores the misconceptions and everyday realities of life on the spectrum. Based on his hit memoir, Funny, You Don\\u2019t Look Autistic\\u00a0blends McCreary\\u2019s signature deadpan humour with Green Thumb Theatre\\u2019s legacy of bold, [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/07/6.jpg\",\"url\":\"https://artspring.ca/event/funny-you-dont-look-autistic/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-10-24T19:30:00-07:00\",\"endDate\":\"2025-10-24T21:30:00-07:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"10 \\u2013 42\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/funny-you-dont-look-autistic/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-09-01T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"ArtSpring RoundTable Presents &#8211; Halloween Community Dance\",\"description\":\"&lt;p&gt;Nov 1 2025- Halloween Community Dance featuring Local Motion with a special appearance from Shelder the Electric Clamfish 6:00-9:00 | 6:00 - Crafts, Snacks and Costume contest | 6:30-8:30 - Dance | Entry By Donation Mark your calendars and dust off your dancing shoes \\u2014 because the All-Ages Halloween Dance Party is here, brought to [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/10/RoundTable-Social-Media-1056-x-480-px.jpg\",\"url\":\"https://artspring.ca/event/halloween-community-dance/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-11-01T18:00:00-07:00\",\"endDate\":\"2025-11-01T21:00:00-07:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Gallery\",\"description\":\"\",\"url\":\"https://artspring.ca/venue/artspring-gallery/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"88 STRINGS: Crossover\",\"description\":\"&lt;p&gt;Tue Nov 4, 7:30pm | A meeting of musical worlds, 88 Strings is a remarkable Canadian quartet that blends Chinese, Persian, and Western plucked string instruments into a mesmerizing soundscape. Described by one listener as \\u201cplucked string heaven,\\u201d the ensemble weaves classical, traditional, and newly commissioned works into rich, meditative concerts that feel both ancient [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/07/3.jpg\",\"url\":\"https://artspring.ca/event/88-strings-crossover/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-11-04T19:30:00-08:00\",\"endDate\":\"2025-11-04T21:30:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"10 \\u2013 42\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/88-strings-crossover/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-09-01T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"MET OPERA: La Boh\\u00e8me (Puccini)\",\"description\":\"&lt;p&gt;Sat Nov 8, 10am | With its enchanting setting and spellbinding score, the world\\u2019s most popular opera is as timeless as it is heartbreaking. Franco Zeffirelli\\u2019s picture-perfect production brings 19th-century Paris to the Met stage as Puccini\\u2019s young friends and lovers navigate the joy and struggle of bohemian life. Soprano Juliana Grigoryan is the feeble [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/07/2-1.jpg\",\"url\":\"https://artspring.ca/event/met-opera-la-boheme-puccini/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-11-08T10:00:00-08:00\",\"endDate\":\"2025-11-08T13:30:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"15 \\u2013 25\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/met-opera-la-boheme-puccini/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-08-28T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"JEREMY DUTCHER: Marquee Presentation\",\"description\":\"&lt;p&gt;Sun Nov 16, 7:30-pm | Jeremy Dutcher is more than a musician\\u2014he\\u2019s a cultural guardian, a visionary, and one of the most compelling artistic voices in Canada today. A Two-Spirit song carrier and classically trained tenor of the Neqotkuk (Tobique First Nation) in Eastern Canada, Dutcher bridges the traditional and the contemporary in electrifying ways. [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/07/7.jpg\",\"url\":\"https://artspring.ca/event/jeremy-dutcher-marquee-event/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-11-16T19:30:00-08:00\",\"endDate\":\"2025-11-16T21:30:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"60\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/jeremy-dutcher-marquee-event/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-07-22T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"TAKE THIS WALTZ: Celebrating the Music of Leonard Cohen\",\"description\":\"&lt;p&gt;Wed Nov 19, 7:30pm | Experience Leonard Cohen\\u2019s music like never before in this rich, multidisciplinary tribute from choreographer Idan Cohen and Ne. Sans Opera &amp; Dance. Blending live performance, contemporary dance, and stunning visual design, this evocative performance stars acclaimed Canadian bass-baritone Daniel Okulitch, lauded by Opera News as \\u201cflat-out brilliant,\\u201d alongside versatile dancer/musician [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/07/8.jpg\",\"url\":\"https://artspring.ca/event/take-this-waltz-celebrating-the-music-of-leonard-cohen/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-11-19T19:30:00-08:00\",\"endDate\":\"2025-11-19T21:30:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"10 \\u2013 42\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/take-this-waltz-celebrating-the-music-of-leonard-cohen/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-07-16T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"MET OPERA: Arabella (Strauss)\",\"description\":\"&lt;p&gt;Sat Nov 22, 10am | Strauss\\u2019s elegant romance brings the glamour and enchantment of 19th-century Vienna to cinemas worldwide in a sumptuous production by legendary director Otto Schenk that \\u201cis as beautiful as one could hope\\u201d (The\\u00a0New\\u00a0York\\u00a0Times). Soprano Rachel Willis-S\\u00f8rensen stars as the title heroine, a young noblewoman in search of love on her own [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/07/3-1.jpg\",\"url\":\"https://artspring.ca/event/met-opera-arabella-strauss/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-11-22T10:00:00-08:00\",\"endDate\":\"2025-11-22T14:00:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"15 \\u2013 25\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/met-opera-arabella-strauss/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-08-28T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"MAKANA YOUTH CHOIRS: Fall Concert\",\"description\":\"&lt;p&gt;Sun Nov 23, 2:30pm | Join the members of the Makana choirs as they celebrate the winter season through song! This term\\u2019s concert is all about Winter Spice! From songs of sugar and nutmeg to some exciting music featuring latin rhythms! This concert is a sure way to get you in the mood for the [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/10/Makana-Spring-Concert_Slide2-1056-x-480-px.jpg\",\"url\":\"https://artspring.ca/event/makana-youth-choirs-fall-concert/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-11-23T14:30:00-08:00\",\"endDate\":\"2025-11-23T16:00:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@t