        "@language": "en",
        "@value": "\n\n\t\t\t\t\t \n\n                 \t\n\t\n\t\t\n\t\n\t\t18 events found.\t\n\t\n\t\t\n\t\n\n\t\t\n\t\n\n\t\t\n\t\n\n\t\n\n\n\t\t\n[{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"MAKANA YOUTH CHOIRS: Fall Concert\",\"description\":\"&lt;p&gt;Sun Nov 23, 2:30pm | Join the members of the Makana choirs as they celebrate the winter season through song! This term\\u2019s concert is all about Winter Spice! From songs of sugar and nutmeg to some exciting music featuring latin rhythms! This concert is a sure way to get you in the mood for the [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/10/Makana-Spring-Concert_Slide2-1056-x-480-px.jpg\",\"url\":\"https://artspring.ca/event/makana-youth-choirs-fall-concert/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-11-23T14:30:00-08:00\",\"endDate\":\"2025-11-23T16:00:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"2 \\u2013 10\",\"priceCurrency\":\"CAD\",\"url\":\"https://artspring.ca/event/makana-youth-choirs-fall-concert/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-10-09T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"MET OPERA: Arabella (Strauss)\",\"description\":\"&lt;p&gt;Sat Nov 22, 10am | Strauss\\u2019s elegant romance brings the glamour and enchantment of 19th-century Vienna to cinemas worldwide in a sumptuous production by legendary director Otto Schenk that \\u201cis as beautiful as one could hope\\u201d (The\\u00a0New\\u00a0York\\u00a0Times). Soprano Rachel Willis-S\\u00f8rensen stars as the title heroine, a young noblewoman in search of love on her own [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/07/3-1.jpg\",\"url\":\"https://artspring.ca/event/met-opera-arabella-strauss/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-11-22T10:00:00-08:00\",\"endDate\":\"2025-11-22T14:00:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"15 \\u2013 25\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/met-opera-arabella-strauss/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-08-28T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"TAKE THIS WALTZ: Celebrating the Music of Leonard Cohen\",\"description\":\"&lt;p&gt;Wed Nov 19, 7:30pm | Experience Leonard Cohen\\u2019s music like never before in this rich, multidisciplinary tribute from choreographer Idan Cohen and Ne. Sans Opera &amp; Dance. Blending live performance, contemporary dance, and stunning visual design, this evocative performance stars acclaimed Canadian bass-baritone Daniel Okulitch, lauded by Opera News as \\u201cflat-out brilliant,\\u201d alongside versatile dancer/musician [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/07/8.jpg\",\"url\":\"https://artspring.ca/event/take-this-waltz-celebrating-the-music-of-leonard-cohen/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-11-19T19:30:00-08:00\",\"endDate\":\"2025-11-19T21:30:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"10 \\u2013 42\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/take-this-waltz-celebrating-the-music-of-leonard-cohen/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-07-16T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Vetta Chamber Music Presents: Concert 2 &#8211; STIRRINGS, Harp and Strings\",\"description\":\"&lt;p&gt;A warm welcome back to harpist Rita Costanzi, one of Vetta\\u2019s original featured artists. Experience her dramatic artistry alongside strings in evocative works that span eras and continents. Marcel Tournier | Vers la source dans le bois for solo harp Alexander Borodin | String Quartet No. 2 in D major Claude Debussy | Danse sacr\\u00e9e [&hellip;]&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/event/vetta-chamber-music-presents-concert-2-stirrings-harp-and-strings/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-11-17T14:30:00-08:00\",\"endDate\":\"2025-11-17T16:30:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Vetta\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"30 \\u2013 35\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/vetta-chamber-music-presents-concert-2-stirrings-harp-and-strings/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-04-24T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"JEREMY DUTCHER: Marquee Presentation\",\"description\":\"&lt;p&gt;Sun Nov 16, 7:30-pm | Jeremy Dutcher is more than a musician\\u2014he\\u2019s a cultural guardian, a visionary, and one of the most compelling artistic voices in Canada today. A Two-Spirit song carrier and classically trained tenor of the Neqotkuk (Tobique First Nation) in Eastern Canada, Dutcher bridges the traditional and the contemporary in electrifying ways. [&hellip;]&lt;/p&gt;\\\\n\",\"image\":\"https://artspring.ca/wp-content/uploads/2025/07/7.jpg\",\"url\":\"https://artspring.ca/event/jeremy-dutcher-marquee-event/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2025-11-16T19:30:00-08:00\",\"endDate\":\"2025-11-16T21:30:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"ArtSpring\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"e