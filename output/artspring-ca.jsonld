  {
    "@id": "https://artspring.ca/temporary/c2935968-817a-4b89-928b-0576096f5c93",
    "@type": [
      "https://schema.org/WebPage"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://artspring.ca/organizer/artspring-8/?hide_subsequent_recurrences=1"
