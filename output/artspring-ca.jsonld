cs\":{\"label\":\"Export Outlook .ics file\",\"single_label\":\"Export Outlook .ics file\",\"visible\":true,\"block_slug\":null}},\"display_recurring_toggle\":false,\"_context\":{\"slug\":\"organizer\"},\"text\":\"Loading...\",\"classes\":[\"tribe-common-c-loader__dot\",\"tribe-common-c-loader__dot--third\"]}\n\n\t\t\n\t\t\n\n\t\n\t\n\t\n\n\t\n\t\tGISS Music\t\n\n\n\t\n\t\n\t\t« All Events\t\n\n\n\t\n\t\n\n\t\n\t\tEvents from this organizer\t\n\n\n\t\n\n\t\n\t\n\t\t\n\t\n\t\t\n\t\n\n\t\n\n\n\t\t\n\t\n\t\t\n\t\n\n\t\n\n\t\n\n\n\t\n\tToday\n\n\t\n\t\n\t\t\n\t\t\t\t\t\t\t\n\t\t\t\t\tUpcoming\t\t\t\t\n\t\t\t\t\n\t\t\t\t\tUpcoming\t\t\t\t\n\t\t\t\t\t\n\t\t\t\t\n\t\n\n\t\n\t\n\t\tSelect date.\t\n\t\n\t\n\t\n\t\t\n\t\n\n\t\n\t\n\t\t\n\t\n\n\t\n\n\n\t\n\t\n\t\n\n\n\n\n\t\t\n\t\t\n\n\t\t\t\t\t\t\t\n\t\t\t\t\n\t\n\t\tDecember 2025\t\n\n\n\t\t\t\t\n\n\t\n\t\n\t\t\n\t\t\tWed\t\t\n\t\t\n\t\t\t17\t\t\n\t\n\n\n\t\n\t\t\n\t\t\t\n\t\t\t\n\n\t\t\t\t\n\t\t\t\t\t\n\t\t\n\t\tDecember 17, 2025 @ 7:00 pm - 9:00 pm\t\n\t\n\n\t\n\t\t\n\n\t\n\t\n\t\n\n\t\tGISS Music Presents: Musaic\n\t\n\n\n\t\t\t\t\t\n\t\n\t\tGISS Music Presents: Musaic\t\n\n\t\t\t\t\t\n\t\n\t\tArtSpring - Theatre\t\n\t\n\t\t100 Jackson Avenue, Salt Spring Island, BC, Canada\t\n\t\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\n\tCome kick off Winter Break with GISS Music! Featuring original songs and compositions from the Composition and Production Class and GISPA Music Students, as well as performances from the Choir, Concert Band, Jazz Band and Jazz Combo. Please note - both nights are different nights of music, so to catch all the action you must […]\n\n\t\t\t\t\n\t\n\t\t$15\t\n\n\n\t\t\t\n\t\t\n\t\n\n\n\n\t\t\t\n\t\t\n\n\t\t\n\t\n\t\t\n\t\n\t\t\n\t\n\n\t\t\n\t\t\tPrevious Events\t\t\n\t\n\n\n\t\t\n\t\n\t\tToday\t\n\n\n\t\t\n\t\n\t\t\n\t\t\tNext Events\t\t\n\t\t\n\t\n\n\t\n\n\t\n\n\n\t\t\n\t\n\t\t\n\t\t\t\n\t\t\t\tSubscribe to calendar\t\t\t\n\t\t\t\n\t\n\n\t\t\n\t\t\n\t\t\t\n\t\t\t\t\t\t\t\t\t\n\n\t\n\t\tGoogle Calendar\t\n\n\t\t\t\t\t\t\t\t\t\n\n\t\n\t\tiCalendar\t\n\n\t\t\t\t\t\t\t\t\t\n\n\t\n\t\tOutlook 365\t\n\n\t\t\t\t\t\t\t\t\t\n\n\t\n\t\tOutlook Live\t\n\n\t\t\t\t\t\t\t\t\t\n\n\t\n\t\tExport .ics file\t\n\n\t\t\t\t\t\t\t\t\t\n\n\t\n\t\tExport Outlook .ics file\t\n\n\t\t\t\t\t\t\t\n\t\t\n\t\n\n\n\t\t\n\t\n\n\n\n\t\n\n\n\n\t( function () {\n\t\tvar completed = false;\n\n\t\tfunction initBreakpoints() {\n\t\t\tif ( completed ) {\n\t\t\t\t// This was fired already and completed no need to attach to the event listener.\n\t\t\t\tdocument.removeEventListener( 'DOMContentLoaded', initBreakpoints );\n\t\t\t\treturn;\n\t\t\t}\n\n\t\t\tif ( 'undefined' === typeof window.tribe ) {\n\t\t\t\treturn;\n\t\t\t}\n\n\t\t\tif ( 'undefined' === typeof window.tribe.events ) {\n\t\t\t\treturn;\n\t\t\t}\n\n\t\t\tif ( 'undefined' === typeof window.tribe.events.views ) {\n\t\t\t\treturn;\n\t\t\t}\n\n\t\t\tif ( 'undefined' === typeof window.tribe.events.views.breakpoints ) {\n\t\t\t\treturn;\n\t\t\t}\n\n\t\t\tif ( 'function' !== typeof (window.tribe.events.views.breakpoints.setup) ) {\n\t\t\t\treturn;\n\t\t\t}\n\n\t\t\tvar container = document.querySelectorAll( '[data-view-breakpoint-pointer=\"297c1982-30b2-4e09-8d1e-0683b4e94675\"]' );\n\t\t\tif ( ! container ) {\n\t\t\t\treturn;\n\t\t\t}\n\n\t\t\twindow.tribe.events.views.breakpoints.setup( container );\n\t\t\tcompleted = true;\n\t\t\t// This was fired already and completed no need to attach to the event listener.\n\t\t\tdocument.removeEventListener( 'DOMContentLoaded', initBreakpoints );\n\t\t}\n\n\t\t// Try to init the breakpoints right away.\n\t\tinitBreakpoints();\n\t\tdocument.addEventListener( 'DOMContentLoaded', initBreakpoints );\n\t})();\n\n{\"tvn1\":\"e096ae2736\",\"tvn2\":\"\"}\n\t\t\t\t\t \n\n\t\t\t\t\n\t\t\t\t"
