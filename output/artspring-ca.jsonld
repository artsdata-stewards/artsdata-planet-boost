        "@value": "\n\n\t\t\t\t\t \n\n                 \t\n\t\n\t\t\n\t\n\t\t2 events found.\t\n\t\n\t\t\n\t\n\n\t\t\n\t\n\n\t\t\n\t\n\n\t\n\n\n\t\t\n[{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"An Evening with Liona Boyd\",\"description\":\"&lt;p&gt;The Triumphant Return of Five Time Juno Award Winner Liona Boyd in concert playing guitar and singing with special guest, Michael Savona Liona Boyd, known as &quot;The First Lady of the Guitar&quot; has introduced millions around the world to the art of classical guitar through her concerts, television specials, and twenty three recordings, many of [&hellip;]&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/event/an-evening-with-liona-boyd/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2011-11-21T19:30:00-08:00\",\"endDate\":\"2011-11-21T21:30:59-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Jump Events\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"55\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/an-evening-with-liona-boyd/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2011-11-11T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Liona Boyd: A Winter Fantasy\",\"description\":\"&lt;p&gt;Liona Boyd, accompanied by Andrew Dolson\\u2026 \\u2026two guitars and two voices Special Guests: Salt Spring Elementary Choir will also be performing with Liona and Andrew. Liona Boyd, Andrew Dolson and a Salt Spring Island Children\\\\'s Choir will create a magical evening performing well-loved Christmas music interwoven with Liona\\\\'s original pieces, many of which feature on [&hellip;]&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/event/liona-boyd-a-winter-fantasy/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2016-11-30T19:30:00-08:00\",\"endDate\":\"2016-11-30T21:30:00-08:00\",\"location\":{\"@type\":\"Place\",\"name\":\"ArtSpring &#8211; Theatre\",\"description\":\"&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\\\n\",\"url\":\"https://artspring.ca/venue/artspring-theatre/\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"100 Jackson Avenue\",\"addressLocality\":\"Salt Spring Island\",\"addressRegion\":\"BC\",\"postalCode\":\"V8K 2V8\",\"addressCountry\":\"Canada\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":48.8518017,\"longitude\":-123.5025882},\"telephone\":\"250.537.2102\",\"sameAs\":\"\"},\"organizer\":{\"@type\":\"Person\",\"name\":\"Jump Events\",\"description\":\"\",\"url\":\"\",\"telephone\":\"\",\"email\":\"\",\"sameAs\":\"\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"43\",\"priceCurrency\":\"USD\",\"url\":\"https://artspring.ca/event/liona-boyd-a-winter-fantasy/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2016-10-20T00:00:00+00:00\"},\"performer\":\"Organization\"}]\n\n\t\t\n\t{\"slug\