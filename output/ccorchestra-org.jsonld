  {
    "@id": "https://www.ccorchestra.org/event-details/holiday-cornucopia",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Holiday Cornucopia | CCOrchestra"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "The CCO will be performing Handel, Mozart, Britten, and more! Highlights include our featured soloists, Caitlin Wood, Soprano, and Helen Li, Clarinet, and the premier of . 'Journeys, For Angela Swan', a piece composed by composer and CCO member Andrew McClure."
      }
    ],
    "http://ogp.me/ns#image": [
