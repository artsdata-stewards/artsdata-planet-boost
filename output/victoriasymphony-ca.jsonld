        "@value": "&lt;p&gt;The Victoria Choral Society join acclaimed soloists for the third act of Wagner’s renowned opera Lohengrin.&lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@value": "Organization"
      }
    ],
