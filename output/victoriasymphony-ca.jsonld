      {
        "@value": "The Choir of King&#8217;s College, Cambridge (Rehearsal &#8211; Sold Out)"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;The Choir of King’s College, Cambridge will be joining your Victoria Symphony this spring for a performance of Mozart’s Requiem, which has long sold out. In response to the ongoing demand, we have opened...&lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@value": "Organization"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
