    "http://schema.org/name": [
      {
        "@value": "Christmas Pops with Denzal Sinclaire &#038; Dee Daniels"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Let the holiday magic begin! Jazz legends Dee Daniels &amp; Denzal Sinclaire join the Victoria Symphony for a dazzling evening of festive favourites, from White Christmas to Silent Night. One unforgettable holiday tradition...&lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@value": "Organization"
      }
    ],
