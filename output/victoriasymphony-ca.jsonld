    "http://schema.org/name": [
      {
        "@value": "Kluxen – Strauss&#8217; Four Last Songs"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;In a time of darkness, beauty can still emerge. In the landscape of mid-century politics, war and oppression, Strauss and Shostakovich were both victims of circumstance. In the twilight of his years, Strauss reflected on our walk through life towards death, and beyond. Shostakovich’s Tenth mirrors the terror he experienced under Stalin’s rule, but ultimately his triumph...&lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@value": "Organization"
      }
    ],
