    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;This program celebrates humor, ingenuity,and the blending of styles across three distinct musical voices. HK Gruber’s Manhattan Broadcasts sets the stage with its jazzy energy, and tongue-in-cheek playfulness, drawing on urban soundscapes....&lt;/p&gt;\\n"
      }
