    "http://schema.org/name": [
      {
        "@value": "A Night at the Oscars"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;“The envelope please…” VS rolls out the red carpet to welcome you to an evening of glitz, glamour, and movie music! From spine-tingling thrillers, heart-pounding action films, triumphant moments, and poignant...&lt;/p&gt;\\n"
