    "http://schema.org/name": [
      {
        "@value": "Parker – Beethoven&#8217;s Emperor Concerto"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;The “Emperor Concerto” reigns among Beethoven’s greatest works, especially in the hands of returning piano soloist Jon Kimura Parker. VS also welcomes the recently enthroned Artistic Director of the Vancouver Island Symphony, Cosette Justo Valdés, to lead this regal program. Along with music of Johann Strauss, we also recruit flashy and folksy Hungarian dances by...&lt;/p&gt;\\n"
      }
    ],
