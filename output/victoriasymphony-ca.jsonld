    "http://schema.org/name": [
      {
        "@value": "Celeigh Cardinal &#038; Shawnee Kish with The National Youth Orchestra of Canada"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Two powerhouse voices. One unforgettable afternoon by the water. JUNO-nominated singer-songwriters Celeigh Cardinal and Shawnee Kish join forces with The National Youth Orchestra of Canada for a genre-defying celebration of strength, identity, and transformation—set against the stunning backdrop of Victoria’s Inner Harbour. From the anthemic energy of “Wild Women” and “I Surrender” to the evocative...&lt;/p&gt;\\n"
      }
    ],
