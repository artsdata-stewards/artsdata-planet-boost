    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;We are proud to host a special event as part of Culture Days 2025! Have you ever wondered how to make a violin sing or what it\\'s like to play...&lt;/p&gt;\\n"
      }
    ],
