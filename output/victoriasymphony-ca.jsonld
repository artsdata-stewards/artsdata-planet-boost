    "http://schema.org/name": [
      {
        "@value": "Latin Nights with Sal Ferreras &#038; Adonis Puentes"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;After their crowd-pleasing Symphony SPLASH! debut in 2025, percussionist Sal Ferreras, vocalist Adonis Puentes, and the Latin Jazz Sextet return with irresistible energy, rhythm, and joy. Featuring new works from Adonis Puentes...&lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@value": "Organization"
      }
    ],
