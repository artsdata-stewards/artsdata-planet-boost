        "@value": "Mozart &#038; Martinis"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Urban vibe meets classical flair! Mix and mingle to live classical music with appies, a martini and more.&lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@value": "Organization"
      }
    ],
