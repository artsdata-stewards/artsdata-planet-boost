    "http://schema.org/name": [
      {
        "@value": "Fauré Requiem &#038; Saint-Saëns Organ Symphony (Sold Out)"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;A musical fanfare in a venue like no other! Join VS as we gather the musical community together in Victoria’s magnificent Christ Church Cathedral. The majestic organ built by Helmuth...&lt;/p&gt;\\n"
