    "http://schema.org/name": [
      {
        "@value": "Kluxen &#038; Parker – Mozart &#038; Sibelius"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Internationally acclaimed pianist Jon “Jackie” Kimura Parker—one of Canada’s most beloved and dynamic artists—brings elegance, wit, and sparkle to Mozart’s radiant Jenamy (also known as Jeunehomme) Concerto. Lithuanian composer Raminta Šerkšnytė’s Midsummer Song glows with...&lt;/p&gt;\\n"
