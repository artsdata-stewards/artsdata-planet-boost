    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://victoriasymphony.ca/concerts/category/sidney/list/?eventDisplay=past"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Kluxen &#038; Feng – Strauss Oboe Concerto"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Richard Strauss idolised Mozart – although “modernising” Idomeneo was, perhaps, a step too far! Strauss’s Oboe Concerto is a magical, late-in-life work, played here by VS Principal Michelle Feng. Christian Kluxen also shakes up a three-movement Symphony with a non-Mozartean minuet, and premieres a VS commission from Victoria’s own Anna Höstman. Not included in subscription purchase discount.&lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@value": "Organization"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
