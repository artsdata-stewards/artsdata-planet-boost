    "http://schema.org/name": [
      {
        "@value": "The Choir of King&#8217;s College, Cambridge (Sold Out)"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Founded in the fifteenth century, The Choir of King’s College, Cambridge is undoubtedly one of the world’s best-known choral groups. While the Choir exists primarily to sing the daily services in King’s College Chapel, its worldwide fame and reputation, enhanced by its many recordings, has led to invitations to perform around the globe, and to...&lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
