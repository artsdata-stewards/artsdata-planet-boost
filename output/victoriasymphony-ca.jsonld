    "http://schema.org/name": [
      {
        "@value": "Messiah by Candlelight"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;“Hallelujah!” In 1741, Handel composed his great oratorio Messiah in just three weeks, and its message of hope and redemption has echoed ever since. Victoria’s magnificent Christ Church Cathedral glows with candlelight...&lt;/p&gt;\\n"
      }
    ],
