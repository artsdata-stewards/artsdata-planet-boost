    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Join us August 1st-3rd for a New Orleans-Style Downtown Scranton Jazz Festival! Three days of incredible music with over 80 musicians spanning 20+ venues Summer 2025!&nbsp;The Randy Andys will be featured on August 2nd from 7:00-10:00 pm at Sergei’s Downtown. Free to attend—no tickets necessary!"
      }
