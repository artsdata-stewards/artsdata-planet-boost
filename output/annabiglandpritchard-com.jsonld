  {
    "@id": "https://www.annabiglandpritchard.com/event-details/choralcollage",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Creative Care for Eco-Anxiety: a Choral Collage Workshop"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Tend to ecological grief through expressive arts vehicles such as drawing, writing, mindfulness, and sound-making in a supportive group. Musician and workshop facilitator Anna Bigland-Pritchard will guide you through a supportive, creative afternoon. This is a BC Culture Days event."
      }
    ],
