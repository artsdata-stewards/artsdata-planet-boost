    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Anna Bigland-Pritchard, soprano, performs in heart-touching new ambient opera, \"i am beauty,\" November 21 and 22 at the Baumann Centre. Along with three other soloists and electronics, this stunning verbatim opera-in-development by Rick Waines and MJ Coomber is unlike any opera you've ever seen."
      }
