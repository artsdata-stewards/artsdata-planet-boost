  {
    "@id": "https://www.annabiglandpritchard.com/event-details/restandresonatejanuary26",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Sound Bath and Restorative Yoga in Victoria BC"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "An evening retreat to restore and dream. A small yoga class with head massage and a vocal soundbath at Anja Yoga in Oak Bay. Hosted by Anna Bigland-Pritchard and Roxie Fehr (Across The Water Yoga). Self care in community - featuring a unique vocal looping sound bath, inspiring poetry, supportive yoga with props provided, and guided journalling. Come early for tea!"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
