    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "L’ONJMontréal est très heureux d’accueillir la fabuleuse chanteuse  Caity Gyorgy  dans un deuxième Opus tiré du répertoire du Great American Songbook, cette fois-ci celui de Irving Berlin dans des arrangements originaux réalisés pour  Ella Fitzgerald ."
      }
    ],
