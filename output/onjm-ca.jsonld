    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "En planifiant ce deuxième concert de la Série Solistes, le tromboniste et compositeur Taylor Donaldson a tout d’abord réfléchit à ce qui l'avait attiré vers le jazz et l'écriture de musique pour big band.   EN SAVOIR PLUS…"
      }
    ],
