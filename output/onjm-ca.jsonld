        "@language": "fr-ca",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Sous la direction de Jean-Nicolas Trottier, ce concert rend hommage à Miles Davis (1926-1991), Wayne Shorter, Herbie Hancock, Ron Carter et Tony Williams. L’Orchestre national de jazz salue les moments sublimes que ces virtuoses ont créés de 1962 à 1966 (Miles Smiles) et en actualise la magie."
      }
    ],
