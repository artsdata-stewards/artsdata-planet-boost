    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Cuban Fir e est une œuvre qui a précédé de peu la fin de l’ère du  big band . Composée par Johnny Richards, la suite de sept mouvements a été enregistrée par le Stan Kenton Orchestra en 1956, puis a presque disparu avec le groupe."
      }
    ],
