    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Film Kicks presents Past Lives | Kicking Horse Culture"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Nora and Hae Sung, two deeply connected childhood friends, are wrested apart after Nora's family emigrates from South Korea. Twenty years later, they are reunited for one fateful week as they confront notions of love and destiny."
      }
    ],
