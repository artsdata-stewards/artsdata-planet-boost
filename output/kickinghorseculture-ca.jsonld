  {
    "@id": "https://kickinghorseculture.ca/events/ballet-kelowna/",
    "https://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "https://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Ballet Kelowna \"Resurgence\" | Kicking Horse Culture"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Ballet Kelowna's \"Resurgence\" features a meticulous blend of contemporary and neo-classical works by Canada’s leading dance makers. With the jovially abstract Petrushka by Heather Dotto, Robert Stephen’s beautiful Celestial Mechanics, and Alysa Pires’ vivacious audience favourite MAMBO, this high energy program promises to please our Golden audience once again. Welcome back, Ballet Kelowna!"
      }
    ],
    "https://ogp.me/ns#url": [
      {
        "@language": "en-us",
