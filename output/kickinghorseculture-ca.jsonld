    "http://schema.org/image": [
      {
        "@id": "https://kickinghorseculture.ca/wp-content/uploads/e5864933-605a-40eb-987d-ebb9d491c0da.sized-1000x1000-1.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://kickinghorseculture.ca/events/the-father/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
