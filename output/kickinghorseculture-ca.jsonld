    ],
    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Film Kicks presents It Was Just An Accident | Kicking Horse Culture"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "An unassuming mechanic is reminded of his time in an Iranian prison when he encounters a man he suspects to be his sadistic jailhouse captor. Panicked, he rounds up a few of his fellow ex-prisoners to confirm the man's identity. The film is an ingenious comedy of errors."
      }
    ],
