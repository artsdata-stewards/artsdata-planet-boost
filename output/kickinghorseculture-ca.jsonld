    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Few things are as joyfully invigorating as a hard-hitting brass band, and Toronto’s The Heavyweights Brass Band is about as good as it gets. For well over a decade this take-no-prisoners quintet has been wowing audiences all over North America. Although inspired by the New Orleans tradition, they also incorporate a diversity of influences ranging from contemporary pop hits to neo-soul, R&amp;B and funk classics, and Latin American and Caribbean rhythms.    They have 10 CDs out and their music has been featured in films and on TV; the band itself has performed with such legends as Roger Lewis of the Dirty Dozen Brass Band, Trombone Shorty, and the Soul Rebels. As noted by LatinJazzNet, “There is an irresistible and infectious ebullience that turns and twists each of the songs into musical engines that seem to run on nitroglycerine.” Adored by audiences for their high-impact blend of groove, energy, and virtuosity, these Heavyweights are true champions of dance halls and concert halls. "
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Heavyweights Brass Band with Retrofied"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
