      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
  {
    "@id": "https://kickinghorseculture.ca/events/qairo/",
    "https://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "https://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Qairo | Kicking Horse Culture"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Qairo (pronounced Cairo) is a passionate and innovative septet whose pan-Mediterranean sound combines the fire of flamenco with a heady blend of Turkish micro-tonality, highly charged Balkan rhythms, and spicy Middle Eastern melodies. Singer Alejandro Mendia and dancers Lia Grainger and Deborah “La Caramelita” were part of a popular flamenco ensemble for years before merging […]"
