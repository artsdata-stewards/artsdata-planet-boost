    "http://schema.org/image": [
      {
        "@id": "https://kickinghorseculture.ca/wp-content/uploads/6.-compartment.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://kickinghorseculture.ca/events/film-kicks-presents-compartment-number-6/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://kickinghorseculture.ca/events/film-kicks-presents-compartment-number-6/"
      }
