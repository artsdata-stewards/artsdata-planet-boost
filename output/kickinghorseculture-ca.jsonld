      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
  {
    "@id": "https://kickinghorseculture.ca/events/sarah-hicks-home-in-unexpected-places/",
    "https://ogp.me/ns#locale": [
