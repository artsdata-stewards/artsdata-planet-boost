    "http://schema.org/image": [
      {
        "@id": "https://kickinghorseculture.ca/wp-content/uploads/Jon-Holly-2-BBI-scaled-e1716326860804.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://kickinghorseculture.ca/events/the-kootenay-renegades/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://kickinghorseculture.ca/events/the-kootenay-renegades/"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Award-winning vocalist-bassist Holly Hyatt and vocalist-guitarist Jon Burden have played Golden a few times already, but never like this!     What used to be an internationally acclaimed acoustic blues duo who performed with Harry Manx and Jim Byrnes has transformed into the Kootenay Renegades, a hard-driving and very electric quartet that performs a heady mix of roots and blues as well as catchy rock classics and some tasty originals. With the addition of drummer Steve Wilson and Marty Carter on sax and flute, these four superb musicians plug in and let rip with a powerful blend of blues grit, soul, and fiery rock. Jon is rated an “extraordinary” guitarist by the Smoky Mountain Blues Society, while Holly’s honey-rich vocals “captivate the listener” (Blues Blog USA). Better not miss these guys!    Featuring Local talent: Unusual Suspects"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Kootenay Renegades with Holly Hyatt &#038; Jon Burden"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
