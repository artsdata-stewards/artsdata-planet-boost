        "@value": "article"
      }
    ],
    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Leave No Trace | Kicking Horse Culture"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "This Canadian drama stars Ben Foster and Thomasin McKenzie as a father and daughter surviving off the land in a National Park in Oregon. A great insight into the struggles of those who just want to be left alone."
      }
    ],
