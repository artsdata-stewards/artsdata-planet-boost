      }
    ]
  },
  {
    "@id": "https://kickinghorseculture.ca/events/celeigh-cardinal/",
    "https://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "https://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Celeigh Cardinal | Kicking Horse Culture"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "A multiple-award-winning singer-songwriter, Celeigh Cardinal is indeed a Soul-Folk Songstress from the Northern Prairies. She has emerged as one of the superstars of Canada’s roots music scene. Blessed with a superbly soulful voice that gives life to her songs of insight, honesty, beauty and grace, Celeigh is a riveting live performer. Winner of the 2020 Juno Award for Indigenous Artist of the Year."
      }
    ],
