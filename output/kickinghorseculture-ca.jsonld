    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "After 2 years of involuntary silence, La Cafamore resumes its concerts with piano trios by Arensky and Piazzolla. Carolyn Cameron (violin) is joined by Nina Horvath on piano and Maria Wang on cello, playing Arensky’s piano trio #1 and Piazzolla’s “4 Seasons of Buenos Aires”."
      }
    ],
