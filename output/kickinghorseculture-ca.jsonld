    "http://schema.org/image": [
      {
        "@id": "https://kickinghorseculture.ca/wp-content/uploads/Kate-Braidwood-and-Andrew-Phoenix.-Co-Artistic-Directors-of-Wonderheads-photo-courtesy-of-DesignEgg-1.png"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://kickinghorseculture.ca/events/emberfest-wonderheads/"
      }
