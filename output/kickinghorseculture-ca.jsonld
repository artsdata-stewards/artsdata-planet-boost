    "http://schema.org/image": [
      {
        "@id": "https://kickinghorseculture.ca/wp-content/uploads/3.-E.-Shepherd-es-orange-hat-smaller-scaled.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://kickinghorseculture.ca/events/elizabeth-shepherd/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://kickinghorseculture.ca/events/elizabeth-shepherd/"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Dubbed “a jazz virtuoso with a pop sensibility” by the Globe and Mail, vocalist-pianist Elizabeth Shepherd made a huge splash with her debut CD in 2006 and has never looked back. Now with six Juno nominations and seven acclaimed recordings, Shepherd has continued to creatively blur the boundaries between jazz, R&amp;B, pop, and hip-hop.    She is also the only jazz vocalist to have been long-listed – twice! – for the Polaris Prize, Canada’s most important music award. Shepherd is currently touring in support of Three Things, her COVID-era CD, and her quintet features the versatile and endlessly inventive guitarist Michael Occhipinti, himself a nine-time Juno nominee. Their album Weight of Hope created during the pandemic under the artist name ES:MO is a delightful collection of original tunes and gorgeous and inventive covers of some well known favourites.    Unique, compelling, and exceptionally talented, Shepherd continues to create jazz for a new generation. Don’t miss what USA Today describes as the “soulful coolness” of this riveting performer."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Elizabeth Shepherd with Mellie Jane"
      }
    ],
