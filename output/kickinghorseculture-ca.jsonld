    "http://schema.org/image": [
      {
        "@id": "https://kickinghorseculture.ca/wp-content/uploads/4.-John-Hewitt-and-the-New-Americans-2.png"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://kickinghorseculture.ca/events/john-hewitt-the-new-americans/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://kickinghorseculture.ca/events/john-hewitt-the-new-americans/"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Often called the hardest working musician in Alberta, singer-songwriter and acoustic guitarist John Hewitt hails originally from Ontario but moved west to Edmonton in 2018. For years this old-school troubadour has been averaging 150 shows annually, often solo, travelling over 30,000 km a year to perform at everything from house concerts to festivals.     Most recently he’s been fronting a five-piece called the New Americans, who perform a heartfelt and rootsy mix of anthemic heartland ballads, honky-tonk shuffles, and up-tempo rockers. Influenced equally by contemporary folk and country idioms as much as by 1960s-‘70s stars like Tom Petty, Van Morrison, and the Grateful Dead, this prolific songwriter – he has released an amazing five CDs since 2020 – has the talent and authenticity to enthrall any audience.       Featuring local talent: Katie and the Other Guys"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "John Hewitt &#038; the New Americans"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
