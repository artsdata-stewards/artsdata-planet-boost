      }
    ]
  },
  {
    "@id": "https://kickinghorseculture.ca/events/wildfires/",
    "https://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "https://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "AGOG presents: Wildfires by Suzanne Cooper | Kicking Horse Culture"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Suzanne is a working ceramic artist/potter, Pottery Instructor at the College of the Rockies and occasional writer. She has 20 years experience in those fields, with 15 of them in teaching. She works both functionally and sculpturally, but loves conceptual narratives- both serious and trivial- in both. Suzanne has spent a lot of time in her youth swimming in the often beautiful, but sometimes tumultuous, waters of liberal arts education – BFA programs in Creative writing (UVIC) and Ceramics (AUArts -Alberta University of the Arts and a Diploma program in ceramics, Selkirk College). Yes, she should be a doctor of something by now but, no, she is not. Suzanne is also a diagnosed severe PTSD survivor with years of therapy (both accredited and esoteric/wacky) under her belt. This is not remotely her entire personality - and she does not see herself as a victim anymore - but it is pertinent to this body of work. Her unusual life experiences have made it mandatory that she use pain, beauty, and humour in everything that she does."
      }
    ],
    "https://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://kickinghorseculture.ca/events/wildfires/"
      }
    ],
    "https://ogp.me/ns#site_name": [
