    "http://schema.org/image": [
      {
        "@id": "https://kickinghorseculture.ca/wp-content/uploads/NEW-BACH-POSTER-BC-TOUR-1-1-scaled-e1754583413144.jpg"
      }
    ],
    "http://schema.org/url": [
