    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Called “Canada’s next big thing in down-and-dirty, classic-rockin’ blues guitardom” by the Toronto Star, Garret T. Willie more than lives up to that purple praise."
      }
    ],
    "https://ogp.me/ns#url": [
