    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "KHC presents: Color Me Happy Youth Painting Workshops | Kicking Horse Culture"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Color Me Happy is a guided painting workshop series for youth with local artist Trina Wolfenden. Trina specializes in acrylic painting and she has a special talent for adding in splashes of color and happy into everything she does. She will guide youth through the painting process and encourage them to express their own feelings of \"happy\" and \"joy\". All materials are provided to paint 8\"x10\" acrylic paintings. Each week will be a new theme and a new painting, Trina will base these off of feedback from our young painters."
      }
    ],
    "https://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://kickinghorseculture.ca/events/color-me-happy/"
