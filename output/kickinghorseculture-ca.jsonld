      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://kickinghorseculture.ca/wp-content/uploads/Shooglenifty_July-30.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://kickinghorseculture.ca/events/shooglenifty/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
