    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Let’s hear it for Edmonton’s favourite “good times/indie-rock band.” Major Love includes singer-songwriter Colleen Brown and her frequent collaborators, Scenic Route to Alaska, a sophisticated pop-rock trio. Their recent CD, Live, Laugh, Major Love, was hailed by the Edmonton Journal as “a terrific album of guitar-driven dream pop” and has already produced a dance-happy hit single.     A follow-up to their popular 2018 debut recording, this new disc continues a mood of introspective emotional vulnerability combined with a light-hearted playfulness. Brown has an irresistible onstage persona, and her catchy vocals are suffused with giddy warmth. Combine that with the skillful, energetic musicianship of guitarist/vocalist Trevor Mann, drummer/vocalist Shea Connor, and bassist Murray Wood and Major Love offers audiences a major good time.    Featuring Local talent: Molly Roth"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Major Love"
      }
    ],
    "http://schema.org/eventStatus": [
