    "http://schema.org/image": [
      {
        "@id": "https://kickinghorseculture.ca/wp-content/uploads/4.-AV-Inner-City-AVIC2023-Hi-Res-2023-scaled.jpeg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://kickinghorseculture.ca/events/av-the-inner-city/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://kickinghorseculture.ca/events/av-the-inner-city/"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Hailing from Edmonton’s “inner city” neighbourhood of McCauley, this award-winning sextet makes music that is contagiously fun while being socially provocative. Group founder and lead singer/pianist Ann Vriend smilingly refers to their style as “existentialist gospel,” but it will be instantly and warmly familiar to any fans of Bill Withers, Nina Simone, Ray Charles, Sharon Jones, and Alicia Keys.    Thanks to their passionate singing and rootsy style, so evocative of vintage Stax Records and Muscle Shoals tunes, the band was closing in on a European tour and some serious fame when they were derailed by COVID. Now firmly back on track, and with their new album, Everybody Matters, receiving great reviews, The Inner City is getting radio play from Germany to Australia.    As NOW Magazine said of AV: “She turns soul on its head, belting out delicate introspection in the form of fire.” Don’t miss this one! "
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "AV &#038; The Inner City with Pool Boys"
      }
    ],
