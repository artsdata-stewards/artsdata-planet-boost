    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Although many are familiar with the name Josephine Baker, they likely know little about this African-American woman who rose above racism and poverty to become a gender-bending international cabaret superstar in France. This wildly acclaimed one-woman show performed by Tymisha Harris is an electrifying portrait of one of the most compelling icons of the last century."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Tymisha Harris &#8220;Josephine, a Burlesque Cabaret Dream Play&#8221;"
      }
    ],
