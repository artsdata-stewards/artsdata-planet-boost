    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "An investigating judge struggles with paranoia amid political unrest in Tehran caused by the death of a young woman. When his gun goes missing, he suspects his wife and daughters, imposing harsh measures that fray family ties. This movie was shot entirely in secret."
      }
