    "http://schema.org/image": [
      {
        "@id": "https://kickinghorseculture.ca/wp-content/uploads/Poetry-Workshop-social-posts-1x1-3.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://kickinghorseculture.ca/events/poetry-of-the-seasons-collage-exploration-258/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://kickinghorseculture.ca/events/poetry-of-the-seasons-collage-exploration-258/"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "This immersive two-day workshop is for working artists from all disciplines (writers! musicians! performers! visual artists!). We will delve deep into the creative process, exploring vulnerabilities and embracing risk-taking. Through a series of hands-on activities, from cut-out and blackout poetry to collage and zine-making, participants will discover how poetry can enhance non-linear thinking, ignite creative inspiration, and uncover unexpected connections between ideas and emotions.    The inclusive environment will encourage artists from all fields to share and learn together, fostering a supportive community in the process. Whether you’re a writer, musician, actor, visual artist, or coming from any other creative field, your artistic practice is sure to benefit from this fun and engaging weekend of playful learning."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Unlocked: Poetry as a Gateway to Creativity Workshop"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
  {
