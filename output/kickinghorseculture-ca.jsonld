  {
    "@id": "https://www.kickinghorseculture.ca/temporary/02b8662c-daa5-4d9c-9959-a87c335e6a82",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
