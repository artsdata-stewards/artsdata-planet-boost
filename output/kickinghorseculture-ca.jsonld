        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
  {
    "@id": "https://kickinghorseculture.ca/events/film-kicks-presents-fire-of-love/",
    "https://ogp.me/ns#locale": [
      {
        "@language": "en-us",
