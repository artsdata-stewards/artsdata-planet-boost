    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Masters of their trade, The Lonesome Ace Stringband bring grit, skill and abandon to Americana music, bridging old-time, bluegrass and folk traditions into a seamless hybrid of original material that is at once fresh and timeless."
      }
