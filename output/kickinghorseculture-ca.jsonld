    "http://schema.org/image": [
      {
        "@id": "https://kickinghorseculture.ca/wp-content/uploads/Mamasbroke_35mm_WEB3-e1723496262125.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://kickinghorseculture.ca/events/mamas-broke/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
