    "http://schema.org/image": [
      {
        "@id": "https://kickinghorseculture.ca/wp-content/uploads/Mariel-Buckley-website-image-motel-low-cropped-e1694141720379.jpg"
      }
    ],
    "http://schema.org/url": [
      {
