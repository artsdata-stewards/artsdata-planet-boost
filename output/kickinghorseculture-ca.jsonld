  {
    "@id": "https://www.kickinghorseculture.ca/temporary/61410feb-5f2b-4caa-aed7-a37e7c0db4bc",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/startDate": [
      {
