      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "For more than a decade Vancouver’s Coco Jafro has been defining and refining a uniquely intoxicating blend of jazz, reggae, funk, Latin, soul, and world beat into a dance-happy vibe that drives audiences wild.    Fronted by powerhouse vocalist Karina Morin, this remarkable septet is the master of many beats, unfailingly delivering a dynamic sound overflowing with passion, power, and positivity. With their in-the-pocket grooves and global perspective, Coco Jafro has been getting lots of festival bookings, while their numerous recordings are often heard on the CBC.    One reviewer from SoulandJazzandFunk.com couldn’t resist gushing more than a little: “Eclectic and hard-hitting .  .  . think Santana gigging with Fela Kuti garnished with hints of Sade . . . even the whole Dap Tone thing.”    In short, sounds like one heck of a party!"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Coco Jafro with The A-Muse Troupe"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
