    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Judy Brown is a very talented singer/songwriter/guitarist who was long a major presence on the Toronto scene before she took time off to raise her two children. A move to Nelson in 2016 marked a recommitment to her musical career, which soon led to 2018’s Say It, which showcased her sly lyrics and tongue-in-cheek attitude. This sparkling, well-reviewed collection of 13 original songs won her some new fans, including the Globe and Mail’s Brad Wheeler and CBC Radio’s Errol Nazareth, who praised Brown for “a voice capable of being both gritty and soulful.”    Although primarily a blues-based performer, this rootsy and versatile veteran is a savvy musical chef who tosses tasty dollops of soul, country, and boogie-woogie into the mix. Backed by her kick-ass band, Judy serves up a foot-tapping feast that audiences simply love. Think of her as the embodiment of sass with class."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Judy Brown Band with Carl Trinkwon &#038; The Masters of Nun"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
