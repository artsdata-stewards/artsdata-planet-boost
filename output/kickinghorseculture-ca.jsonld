    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "    The Imaginarium is a place where Positive Futurisms come alive: anything is possible, nothing is off-limits, and creativity flows freely. Whether you want to sketch, paint, sculpt, craft, or just play with texture and color, this is the portal for bringing your ideas to life!      The Imaginarium is a free, inclusive space for artistic exploration and community connection. A space where festival-goers can contribute directly to Emberfest’s collaborative installations and capture the festival’s themes through tangible, participatory art. It is where we play with experimentation, storytelling, and imaginative problem-solving.      The Imaginarium is open from 1 pm - 8 pm on:  January 24th &amp; 25th  January 31st &amp; February 1st  February 7th &amp; 8th  Febraury 14th &amp; 15th"
      }
    ],
    "http://schema.org/name": [
