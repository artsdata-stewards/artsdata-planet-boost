    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Film Kicks presents The Monk and the Gun | Kicking Horse Culture"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "A timely political satire that underscores the fragility of democracy, this film beautifully captures rural Bhutan’s grounding simplicity where peace whispers louder than power. “Delightful” “A great and funny film. An American travels into Bhutan in search of a valuable antique rifle and crosses paths with a young monk who wanders through the serene mountains, instructed by his teacher to make things right again."
      }
    ],
