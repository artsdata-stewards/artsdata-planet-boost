  {
    "@id": "https://www.kickinghorseculture.ca/temporary/a247ccc0-a401-4b28-b41b-92edae0dfba6",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2024-01-12"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2024-02-10"
      }
    ],
