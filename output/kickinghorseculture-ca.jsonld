    ],
    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "The Cave | Kicking Horse Culture"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "A group of animals flee from a vicious forest fire and seek refuge in Bear’s cave. Waiting out the inferno, they reflect on their lives, their lost garden, and their impending doom. These unlikely and singed bedfellows share their stories and take comfort in their newfound community while the fire encroaches."
      }
    ],
