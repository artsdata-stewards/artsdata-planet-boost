    ],
    "http://schema.org/image": [
      {
        "@id": "https://kickinghorseculture.ca/wp-content/uploads/Yes-Yes-Yes-Hero-with-Karin-landscape-photo-by-Andi-Crown-scaled.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://kickinghorseculture.ca/events/yes-yes-yes/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://kickinghorseculture.ca/events/yes-yes-yes/"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "New Zealand’s Eleanor Bishop and Karin McCracken are award-winning theatre makers who create important, socially engaged work that focuses on gender, sex, and violence. Their subject matter is rigorously researched and involves input from audiences as much as from social agencies and academics. They explored the topic of rape culture and consent on college campuses in Jane Doe, which toured internationally from the Edinburgh Fringe to Australia and America. Their latest project, Yes, Yes, Yes, is also about sex and consent; but because it is aimed at teenagers and young adults it includes a major focus on the development of healthy sexual relationships. This new work came out of their experience making and presenting Jane Doe: Bishop and McCracken realized they needed to explore the experiences and perspectives of teens in order to create a work that was honest and reality based, while remaining emotionally powerful theatre. The core of the show presents two very different storylines. In one, “Karin” talks about how she met a guy at a party and slept with him that night – an unplanned sexual encounter that was safe and fun. “Ari,” the other protagonist, goes to a party and is sexually assaulted. This storyline is presented after the fact, and opens up to include video footage of candid interviews with actual students about dating and sex. And at two points during the presentation, audience members can share their thoughts via text messages that will be shared anonymously on screen. Part confession, part documentary, part open conversation, Yes, Yes, Yes will help young people successfully navigate the challenge of understanding consent and desire in the context of a healthy relationship."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "KHC presents: YES YES YES"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
