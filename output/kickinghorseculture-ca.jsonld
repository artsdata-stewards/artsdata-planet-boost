    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Stephanie von Neudegg is a landscape artist born, raised, and currently based in Banff, Alberta. She grew up hiking through meadows and skiing fast. Painting became a substantial part of her life in 2015. “Back Country Brights” is a collection of scenes between the Bow Valley and the Bugaboos. This series is dedicated to her Grandpa – “who gave us our home in the mountains.”"
      }
