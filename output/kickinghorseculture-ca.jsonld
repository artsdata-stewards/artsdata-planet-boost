    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://kickinghorseculture.ca/events/the-general-store-by-nahanni-mckay-and-ben-evely/"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "We are very pleased to welcome Nahanni Mckay and Ben Evely and their exhibit The General Store  September 13- October 12, 2024  Artist Opening Reception September 13, 5:00 - 7:00 pm. Conversation and Q &amp; A with Artist.   Project Description:    Nahanni is a Metis-Cree artist and photographer based in Treaty 7 Territory. Born and raised in the Banff, her creative practice has focused on National Parks in Canada and the human impact on surrounding natural environments as well as the decolonization of land. She uses her art practice to bring awareness of the need to coexist with wildlife to prevent further harm to the land we reside on.    Ben Evely is a visual artist from Banff, Alberta, on Treaty 7 Territory. He primarily works with painting, collage and drawing. He often works collaboratively and on projects in public spaces.  Ben’s process often begins with collage, making digital compositions prior to physical work. Observing the transformations and distortions that happen while merging analog and digital mediums. A common thread in his work is the interplay of organic and synthetic, and human experiences within nature.    Ben currently lives and works on the unceded territories of the Musqueam, Squamish and Tsleil-Waututh Nations, otherwise known as Vancouver, Canada."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "AGOG presents: The General Store by Nahanni Mckay and Ben Evely"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
  {
    "@id": "https://kickinghorseculture.ca/events/robin-allingham_whispers-of-our-world/",
    "https://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "https://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "AGOG presents Robin Allingham: Whispers of our World | Kicking Horse Culture"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Coming to photography later in life, I found that the process of seeing the world through a new lens required a slower pace. With my world slowed, I was able to see and experience more in every moment. Along with the sometimes elusive, fleeting moment of the “perfect” photograph, the all-encompassing experience of the day also remains as an indelible memory in the heart. “Whispers of Our World” is a message, a song, a plea, a whispered secret; the beauty and majesty of our natural world is right in front of us every day and at every turn. We are blessed by the sublime."
      }
    ],
