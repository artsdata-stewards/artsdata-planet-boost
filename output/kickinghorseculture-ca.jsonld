    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "A heartwarming story of four Cree siblings separated in childhood by the Sixties Scoop who reunite after fifty years for a week in Banff. Filmed both in Banff and Golden perhaps locals who were extras in the movie will recognise themselves on the big screen!"
      }
