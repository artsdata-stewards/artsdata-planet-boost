        "@id": "https://kickinghorseculture.ca/wp-content/uploads/ARTIST-WORKSHOPS-SQUARE-3-e1759342382454.png"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://kickinghorseculture.ca/events/halloween-howler/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
