      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Originally inspired by retro 70s psychedelic rock, The Static Shift won their night on CTV's The Launch tv show the same week they played our Civic Centre to a sold out crowd. Now in their early 20s, this power trio is gifted beyond their years.    Walk, bike or drive to the park, but remember to be kind to our Selkirk Hill neighbours when coming and going through the neighbourhood.⁣"
      }
    ],
    "http://schema.org/name": [
