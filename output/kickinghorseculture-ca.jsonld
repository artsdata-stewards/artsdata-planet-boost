    "http://schema.org/url": [
      {
        "@id": "https://kickinghorseculture.ca/events/kiran-ahluwalia-with-olivia-rose/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://kickinghorseculture.ca/events/kiran-ahluwalia-with-olivia-rose/"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Born in India, raised in Canada, and currently based in New York City, the sublimely talented vocalist and composer Kiran Ahluwalia is the poster child for musical multiculturalism. With two JUNOs to her credit, Kiran has always been celebrated as a master of the profound vocal traditions of India and Pakistan (DownBeat praises the “emotional richness” of her singing). Yet these are traditions that she simultaneously honours but also updates in remarkable ways.    Her original compositions, while intensely Indian, have also been influenced by Kiran’s deep delving into the realms of jazz, western blues, soul, and rock, and especially the haunting trance blues of Mali. Over her storied career she has also had memorable collaborations with everyone from fado legends to superstar Celtic fiddler Natalie MacMaster. Appearing with a quintet featuring renowned jazz artist Rez Abbasi on guitar and similarly skilled performers on drums, tabla, and accordion/organ, the boundary-blurring Kiran will take the audience on a unique and enchanting musical journey."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Kiran Ahluwalia with Olivia Rose"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
