    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "When their idyllic life is shattered, both are put into social services. After clashing with their new surroundings, Will and Tom set off on a harrowing journey back to their wild homeland. From the director of Academy Award®- nominated Winter's Bone, critics are hailing this film as \"powerful from start to finish\" (Los Angeles Times)."
      }
    ],
