    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "KHC presents: Mimi o’Bonsawin | Kicking Horse Culture"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Mimi O’Bonsawin is a contemporary roots singer-songwriter born in Northeastern Ontario and is French Canadian & W8banaki (Abénaki), a member of Odanak First-Nation. Through her rhythm and story-driven songs, Mimi’s music embraces the beauty of the Land. The ethereal quality of her music whisks you away with uplifting melodies and introspective lyrics that weave pop sensibilities with acoustic instruments. The layers of percussion and surprising harmonies make you feel the music rather than just hear it. Featuring local talent: Golden Aerials"
      }
    ],
    "https://ogp.me/ns#url": [
