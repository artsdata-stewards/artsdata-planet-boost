    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Kicking Horse Culture is thrilled to welcome professional stilt walker Randall Fraser back to Golden for an immersive two-day stiltwalking workshop. A member of the National Stiltwalkers of Canada, Randall brings years of performance and teaching experience to this hands-on exploration of movement, balance, and character."
      }
