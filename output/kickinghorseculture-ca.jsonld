    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Covid willing, Golden's wildly successful Christmas Craft Faire will return -- after a year off -- on Nov. 26 and 27 at Mt. 7 Rec Plex. For decades now, the Christmas Craft Faire is the kickoff to the Christmas season and the social event of the month. A steady stream of people is the norm coming to chat with and purchase gifts from the 60 or so artisans.    You'll find a variety of outstanding handmade goods at the Faire – ranging from one-of-a-kind jewelry, stationery, clothing and accessories to leather goods, art prints, ceramics, furnishings and much, much more. We attract vendors from all over Alberta and BC each year.    Your admission donation supports KHC's ability to produce the Craft Faire each season ... for the benefit of our local and regional artisans and you our happy shoppers. Thanks!    Admission by donation."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Christmas Craft Faire"
      }
