    "http://schema.org/image": [
      {
        "@id": "https://kickinghorseculture.ca/wp-content/uploads/Shasta_AGOG_Poster_20252026-13-x-19-in.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://kickinghorseculture.ca/events/our-mountains-430/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
