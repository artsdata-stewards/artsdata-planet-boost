      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Valdy, that most amiable and charming of music legends, is the very definition of a national folk icon. For 50 years, guitar in hand, he has commanded stages large and small across Canada and beyond, his soothing purr of a voice equally effective at singing memorable songs or telling tales full of humour, heart, and wisdom.    Long ranked one of our greatest performers, he has an effortless mastery of folk, country, blues, and pop. Talented and prolific, Valdy has recorded 16 albums, won two Junos (plus he’s earned 7 other nominations), and been inducted into the Order of Canada.    Rated “one of the country’s purest and most credible storytellers” by the Toronto Star, when Valdy takes to the stage the audience is guaranteed a perfect combination of emotional warmth and musical magic."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Valdy with School of Rock’s Noise Pollution"
      }
    ],
