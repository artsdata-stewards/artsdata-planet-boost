    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "EmberFest Old Time Jam! | Kicking Horse Culture"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Ready to make some music? Join us for this FREE workshop where everyone—beginners and seasoned players alike—can come together to play tunes and connect through the joy of music. We’ll kick things off with a 30-minute intro session to guide you through how a jam works. Chords and lyrics will be provided, so all you need is your instrument and a basic understanding of how to play it. Whether you’re strumming, plucking, or singing, this is your chance to join the fun and be part of something special. Let’s create music together!"
      }
    ],
