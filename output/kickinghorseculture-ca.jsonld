    "http://schema.org/image": [
      {
        "@id": "https://kickinghorseculture.ca/wp-content/uploads/trio-2-low-scaled.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://kickinghorseculture.ca/events/motus-o-dance-theatre/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
