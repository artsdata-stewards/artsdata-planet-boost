        "@value": "EmberFest Imaginarium: FREE Open Studios | Kicking Horse Culture"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Step into The Imaginarium, Emberfest’s interactive open studio where imagination takes shape in real time! This magical space is stocked with art materials, props, and hands-on activities, guided by local artists and volunteers. Community members of all ages are invited to create, experiment, and collaborate—building pieces that will become part of the festival’s larger pageant and celebrations."
      }
    ],
