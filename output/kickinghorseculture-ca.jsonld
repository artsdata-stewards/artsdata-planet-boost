    "http://schema.org/image": [
      {
        "@id": "https://kickinghorseculture.ca/wp-content/uploads/Our-Fragile-Environment-AGOG-exhibit-artist-feature-crop.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://kickinghorseculture.ca/events/our-fragile-environment/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
