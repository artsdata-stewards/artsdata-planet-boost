    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "AGOG is very pleased to welcome the Golden Visual Arts Society back to AGOG for a new exhibit called \"Our Town.\" The members wrote to us saying, \"This is a collection of artwork depicting the community we love. Our inspiration was taken from the town we live in, many of us being long time residents of Golden and Area A.\"    AGOG is hosting an opening reception Friday evening October 21 at 5pm with the artists in attendance. They will be pleased to show you around and tell you about the works on display. We invite all Golden art lovers to come on out and enjoy this reception with these local artists.    We couldn't just choose one painting for our exhibit poster, so we chose two -- one by Martin Olson and the other by Krys Sikora -- and made posters with each.    Artists exhibiting in this show are:  Denys Bardarson, Fern Drysdale, Sheelagh England, Denise English, Dan Griesdale, Becky Leonty, Martin Olson, Joyce Priest, Bev Shumlich, Krys Sikora, Phyllis Twa, Brenda Bernat."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "AGOG presents &#8220;Our Town&#8221; Golden Visual Arts Society"
      }
    ],
