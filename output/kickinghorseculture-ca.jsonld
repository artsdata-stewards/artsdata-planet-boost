    "http://schema.org/image": [
      {
        "@id": "https://kickinghorseculture.ca/wp-content/uploads/6.-The-Carolines-—-1-1-scaled.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://kickinghorseculture.ca/events/the-carolines/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://kickinghorseculture.ca/events/the-carolines/"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Fronted by three superb singers, Alberta’s The Carolines offer all the delights of old-time country music delivered with gorgeous harmonies and toe-tapping flair. From classic tunes by Patsy Cline and Buck Owens to the sassier sounds of the Dixie Chicks and other contemporary performers, The Carolines have been delighting audiences for over seven years.    The charismatic trio of singers – Chloe Albert, Lesley Pelletier, and Katie Perman – all have their own solo CDs . . . and a remarkable ability to execute complex vocal arrangements with thrilling confidence. And the band, comprising electric guitarist Chris Tabbert, upright bassist Paul Bergeron, and drummer Matt Grier, are deeply schooled musicians who perform with energy and finesse.    Notes Harold Wollin of the Blue Chair Café: “The Carolines are so in tune with each other, you would think the Andrews and Pointer Sisters were in the room!” "
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Carolines with Katie, Martha and the Other Guys"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
