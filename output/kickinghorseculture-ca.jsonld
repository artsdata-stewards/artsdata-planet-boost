      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Slow-moving and gripping this is a movie with superb acting and stunning photography. In the late 19th century a young Danish priest travels to a remote part of Iceland to build a church and photograph its people. But the deeper he goes into the unforgiving landscape, the more he strays from his purpose, his mission and morality."
      }
    ],
