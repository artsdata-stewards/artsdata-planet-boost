    ],
    "http://schema.org/url": [
      {
        "@id": "https://kickinghorseculture.ca/events/james-zimmer-art/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://kickinghorseculture.ca/events/james-zimmer-art/"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Born in Calgary, Alberta, James has been creating art since he could hold a crayon. From a very young age he has forever had the dream of becoming an artist and has strived to reach that goal through constant practice at his craft. Spending countless hours in his studio, James is constantly developing his techniques to further himself as the artist he strives to be. Whether through his own personal practice, or the mentors around him, James is continuously learning and developing as an artist as well as a person.    James has been dropping into AGOG since he was about 12 years old to talk with our curator Tammy Prather and share his latest art work. James is still a teenager and this will be James's first show! Needless to say, from what you will see in this amazing exhibit, this will be the first of many.    Come to our Artist's Reception on Friday October 20 to welcome this young artist and talk to him about his artwork ... and you can say \"I was there.\""
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "AGOG presents James Zimmer Art"
      }
    ],
