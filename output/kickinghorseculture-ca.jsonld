        "@value": "article"
      }
    ],
    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "AGOG presents Sarah Hicks: Home in Unexpected Places | Kicking Horse Culture"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "AGOG presents Sarah Hicks: Home in Unexpected Places. Artis Opening Reception Friday July 5 from 5:00 - 7:00pm Sarah Hicks is a place-based artist that uses a fluid wash of acrylic and watercolour to capture dreamscapes of the vast Canadian landscape. As an artist, her goal is to capture the breathtaking beauty of the natural world we live and recreate in in her paintings to share with others. Sarah believes that our connection to the environment is a vital part of our existence, and it is her hope that her work will inspire others to cherish and protect it."
      }
    ],
    "https://ogp.me/ns#url": [
