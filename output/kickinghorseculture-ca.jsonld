    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "AGOG presents \"A Sense of Place\" Sarah Osadetz | Kicking Horse Culture"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "\"With this exhibit my intention is to share some of the iconic landscapes we can visit, experience and appreciate close to Golden. We are gifted by beauty. My choices are based on both recent and childhood experiences that have shaped my conscious and unconscious choices to reside in East Kootenay. To me, being outside and in the backcountry is where I feel most at home.\""
      }
    ],
