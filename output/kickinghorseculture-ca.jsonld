    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "KHC presents: J.S Bach's Long Walk in the Snow | Kicking Horse Culture"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Storyteller Tom Allen's chamber musical is an evocative telling of a 400km tale Johann Sebastian Bach took as a teenager, with music drawn both from Bach's own works and also the music he would have heard on his travels. With a star-studded line-up of great Canadian musicians, this captivating combination of music and story-telling captures the life and times of one of the greatest composers of all time."
      }
    ],
