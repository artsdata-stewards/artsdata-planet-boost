        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "This 2-hour creative workshop offers hands-on collage activities exploring seasonal shifts through poetic expression. Participants will create collages of images, words, and cut-out poetry, delving into themes of gratitude, abundance, and transition inspired by the autumn equinox. Individuals of all ages and skill levels are welcome for a fun and inclusive experience of artistic expression and exploration."
      }
    ],
