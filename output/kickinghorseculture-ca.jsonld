    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "A three-time Maple Blues Award nominee, singer-pianist Jenie Thai revels in old-school soul and blues-drenched barrelhouse boogie-woogie. With her three-octave vocal range and kick-ass keyboard skills, Jenie invariably leaves any audience yelling for more. She was the opening act for Downchild Blues Band on their 50th anniversary tour in 2019, and has several CDs out.    Her latest, Night on Fire, inspired renowned CBC broadcaster Holger Petersen to describe Jenie as “a mature beyond her years, singer, keyboard player and songwriter.” This is one tough road warrior, who has toured all over North America and played literally thousands of gigs, from small clubs to Massey Hall and the New York Jazz Forum Arts Festival (and, yes, there were standing ovations!). Jenie can melt your heart with a tender ballad or burn the house down as she powers through a hard-rocking classic blues. Mostly, though, she just loves to perform – and the audience invariably loves her right back."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Jenie Thai Band with Infinity Solstice"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
