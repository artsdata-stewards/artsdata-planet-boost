    "http://schema.org/image": [
      {
        "@id": "https://kickinghorseculture.ca/wp-content/uploads/Miscellany-of-Folk.-2.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://kickinghorseculture.ca/events/miscellany-of-folk/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://kickinghorseculture.ca/events/miscellany-of-folk/"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Miscellany Of Folk is a captivating touring act that brings together three exceptional musicians hailing from Ireland and Newfoundland. Celebrated multi-instrumentalist Billy Sutton (Harbour Grace in Newfoundland), joins forces with accordion maestro Benny McCarthy (Co. Waterford in Ireland), known for his work with Danú. Rounding out the trio is Eddie Costello, a singing powerhouse and guitarist from the historic county of Tipperary in Ireland.    Their amiable performance is set to take you on an heartwarming and lucid musical journey through the vast world of folk music that offers a powerful and well-arranged repertoire of thoughtfully crafted songs and foot-stomping instrumental music.    United by their deep love for music and their shared passion for creating new arrangements and sounds, they collectively bring a fresh perspective to the folk genre. Their dynamic and intimate concerts are filled with emotion, colour and fun. The band's acoustic sound blends the tones of accordion, fiddle, guitar, bodhran, mandola, resonant vocals, and sweet harmonies.  “Having known of the lads work in other contexts and bands over the years I was genuinely blown away by their live concert performance, effortless tunes, passionate songs and an easy going relaxed rapport with the audience. I came away humming tunes and knowing a lot more about folk and traditional music, in my book that's a win. Miscellany of Folk is now on my radar for 2023.” - Sean Laffey-IRISH MUSIC MAGAZINE"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "KHC presents: Miscellany Of Folk at the Parson Hall"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
  {
    "@id": "https://kickinghorseculture.ca/events/emberfest-old-time-jam/",
    "https://ogp.me/ns#locale": [
