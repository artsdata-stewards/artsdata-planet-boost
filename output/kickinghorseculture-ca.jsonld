    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "AGOG is very proud to welcome long-time Columbia Valley resident Jane Tevelein Doel and her exhibit Signs for Life to the gallery on September 9. We are hosting an opening reception for Jane and invite the Golden community to come celebrate the opening of this exhibit and congratulate Jane between 5 and 7pm. Starting around 5:30pm Jane will speak about the exhibit and answer your questions. All are most welcome!"
      }
