    "http://schema.org/image": [
      {
        "@id": "https://kickinghorseculture.ca/wp-content/uploads/ARTIST-WORKSHOPS-SQUARE-2-e1747253874596.png"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://kickinghorseculture.ca/events/color-me-happy/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://kickinghorseculture.ca/events/color-me-happy/"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "There are 3 sessions available for this workshop and 10 spots are available for each session:    May 28: ages 6-12    June 4: ages 6-18    June 11: ages 6-18 (plus a pizza party at 5:45 pm!)    Entry is free, but we encourage a $5 - $15 donation to attend this workshop. All proceeds will go towards a celebration for youth to show off their work at a pizza party! The pizza party will be on June 11th at 5:45 pm (any youth who have attended one or more of the workshops are welcome to join the pizza party - bring your finished paintings! We'll set up a gallery to show case everyone's work).    &nbsp;    About Trina    Trina Wolfenden is a Golden girl who was born and raised in the beautiful Columbia Valley. Living here has given her endless inspiration for art and creativity. Looking at the world through an artist's eye is a wonderful gift and she loves to share how she sees life through painting: bright, fun and showcasing the mountains and valley she loves.    \"Making art and painting is my favorite way to express my joy and love for nature. I love every sunset, every river, sky, mountain, and find beauty in every day. I paint the world through my optimistic eye and add splashes of happy and color into every painting.\""
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "KHC presents: Color Me Happy Youth Painting Workshops"
      }
    ],
