    "http://schema.org/image": [
      {
        "@id": "https://kickinghorseculture.ca/wp-content/uploads/6.-OKAN_TORONTO-SUMMER-2022_Ksenija-Hotic-8.jpeg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://kickinghorseculture.ca/events/okan/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
