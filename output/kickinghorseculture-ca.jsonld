    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Poetry of the Seasons: Collage Exploration Workshop | Kicking Horse Culture"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "This workshop with Stéphanie Filion will be on Thursday, September 19th, 2024. Please be at the Civic Centre (806 10th Ave S, Golden, BC) at 4:45pm; the workshop will start promptly at 5:00pm and will run until 7:00pm. If you’re able, please bring a pair of scissors and 2-3 magazines that you’re willing to cut up and share with others. You may also want to bring a favorite pen. We look forward to seeing you on Thursday, September 19th!"
      }
    ],
