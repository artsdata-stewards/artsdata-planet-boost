    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "KHC presents: La Mitchin di Mitchif | Kicking Horse Culture"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "V’ni Dansi presents La Mitchin di Mitchif, an evening of Indigenous contemporary dance. Inspired by cultural ancestral knowledge of Mitchif plant medicines, this international collaboration between Vancouver's V’ni Dansi and Santa Fe's Dancing Earth celebrates people's connection to earth and highlights the importance of plant medicine in Indigenous cultures. In this collaboration, dance artists and audiences will reignite their connection to the land and the healing that comes from Mother Earth and all that she provides."
      }
    ],
    "https://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://kickinghorseculture.ca/events/la-mitchin-di-mitchif/"
      }
    ],
