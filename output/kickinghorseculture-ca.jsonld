    "http://schema.org/url": [
      {
        "@id": "https://kickinghorseculture.ca/events/russell-decarle/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://kickinghorseculture.ca/events/russell-decarle/"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Best known as the lead vocalist and bassist of iconic Canadian country-roots band Prairie Oyster, Russell deCarle always had musical interests that extended far beyond pure country. With his burnished crooner’s voice and savvy song-writing skills he has carved out an impressive post-Oyster career, as measured by his three best-selling CDs and many, many sold-out shows delighting fans all across the country and beyond.    Alongside his more familiar slow-burning countrified classics and dance-worthy western swing tunes, deCarle also performs everything from southern soul and torchy ballads to timeless R&amp;B and blues songs. Currently touring in a quartet featuring two of Canada’s best guitarists – longtime bandmate Steve Briggs and the amazing and versatile Paul Pigat – the man with the handsomely lived-in voice and memorable yodel can captivate any audience with ease.    No stranger to Golden -- he was featured prominently in the 2011 New Year's celebrations for the re-opening of the Civic Centre -- Russell can be relied on to provide a country-plus evening of quietly electrifying delight."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Russell deCarle with Carl Trinkwon &#038; The Masters of Nun"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
