      {
        "@language": "en-us",
        "@value": "KHC presents: Scenic Route to Alaska | Kicking Horse Culture"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Scenic Route to Alaska is a powerhouse in the Canadian indie-rock scene, blending rootsy charm with modern indie-rock edge. With over 12 million streams, extensive international tours, and a #1 single on CBC Radio, the Edmonton-based trio has built a loyal fanbase worldwide. Their 7th studio album, Lasts Forever, released in 2024, showcases their evolution with a self-produced, authentic, and emotionally resonant sound. With a track record of heartfelt music and memorable live performances, Scenic Route to Alaska continues to connect deeply with audiences at home and abroad. Featuring local talent: Mellie Jane Miller"
      }
    ],
