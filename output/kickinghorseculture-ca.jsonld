  {
    "@id": "https://www.kickinghorseculture.ca/temporary/3c1f8791-e68d-4c65-8f5c-99ff17093223",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-04-09T12:30:00-07:00"
      }
    ],
