    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Golden's wildly successful Christmas Craft Faire will be back again this year on Nov. 24 and 25 at Mt. 7 Rec Plex. For decades now, the Christmas Craft Faire is the kickoff to the Christmas season and the social event of the month. A steady stream of people is the norm coming to chat with and purchase gifts from the more than 60 artists, artisans, and crafters."
      }
    ],
