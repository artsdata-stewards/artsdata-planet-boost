    "http://schema.org/image": [
      {
        "@id": "https://kickinghorseculture.ca/wp-content/uploads/9.-the-mcdades-photo-promo-2021-2-scaled.jpeg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://kickinghorseculture.ca/events/the-mcdades/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
