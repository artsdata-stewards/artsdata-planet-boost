    "http://schema.org/image": [
      {
        "@id": "https://kickinghorseculture.ca/wp-content/uploads/7.-3951agassizCousin_Harley.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://kickinghorseculture.ca/events/cousin-harley/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://kickinghorseculture.ca/events/cousin-harley/"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Originally classically trained, Vancouver’s sublimely talented Paul Pigat has long been a versatile guitarist who is equally skilled at jazz, rockabilly, western swing, surf, and other idioms. Plus he’s a great singer with a warm baritone voice. Although he regularly plays in several bands, most fans know – and love – him as “Cousin Harley,” Paul’s redneck alter ego and the driving force behind an electrifying and unforgettable rockabilly trio.    After seven albums and 20 years of blistering live performances, Paul continues to offer a foot-stomping master class in hillbilly heroics. Joyfully anarchic, the Cousin Harley trio takes lucky audiences on a high-octane joy ride through irresistible musical terrain – everything from vintage jump blues and hot-rod rockabilly to twangy country classics.    If you’re smart you’ll hitch a ride when these bad boys rumble into town!"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Cousin Harley with The Jumping Rodents"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
