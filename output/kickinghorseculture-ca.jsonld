    "http://schema.org/image": [
      {
        "@id": "https://kickinghorseculture.ca/wp-content/uploads/Sabrina-Curtis-Instagram.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://kickinghorseculture.ca/events/rewired_sab_curtis/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
