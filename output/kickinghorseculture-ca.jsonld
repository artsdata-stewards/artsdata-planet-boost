    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "KHC presents Great Lake Swimmers & Elliot Brood BALLADS & BADLANDS tour | Kicking Horse Culture"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Get ready, Golden- Two powerhouse bands. One electric night. Great Lake Swimmers weave hypnotic folk with a groove that pulls you in, while Elliott BROOD brings their signature stomp-and-strum energy that will have the whole room on its feet. This is roots music that hits the heart — and the dance floor."
      }
    ],
