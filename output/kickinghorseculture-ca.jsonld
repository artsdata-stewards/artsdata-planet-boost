    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Hold onto your seat—this year marks 50 years of adventure with the Banff Centre Mountain Film and Book Festival, and the Banff World Tour is bringing the celebration to you! Get ready for adrenaline-fueled action, breathtaking landscapes, and stories that stir the soul. From first ascents and whitewater thrills to personal triumphs and impossible journeys, this year’s lineup is a tribute to half a century of pushing boundaries and living boldly."
      }
    ],
