      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Tina Leon, formerly known as Marie-Christine, is a singer-songwriter and musician from Montreal, Quebec. She began playing the piano at the age of five, performing at age twelve, and at age twenty landed a role in the music revue Generation Motown where she played hundreds of live shows. Her success in the revue opened up opportunities for working with artists such as Stevie Wonder, who is featured on her track, “Keep On Running,” and singing live on stage alongside Lionel Ritchie. Featuring local talent: Finni Jobin"
      }
    ],
