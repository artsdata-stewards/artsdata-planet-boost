    "http://schema.org/image": [
      {
        "@id": "https://kickinghorseculture.ca/wp-content/uploads/2022-01-14_Koyczan_stitch-v4-3046-copy.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://kickinghorseculture.ca/events/shane-koyczan/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
