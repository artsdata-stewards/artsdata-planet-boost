    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Golden District Arts Council Society (aka KHC) is holding the June 2020 - May 2021 Annual General Meeting at 5pm Mountain time Wednesday Nov. 17, 2021 at the Civic Centre - also available on Zoom. Memberships available at Art Gallery of Golden - Call (250) 344-6186. All Members can vote."
      }
