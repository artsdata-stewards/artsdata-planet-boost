    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Formed in 2017 on Vancouver Island, The Unfaithful Servants quickly earned a reputation as a must-see act thanks to their virtuosity and fresh approach to the bluegrass tradition. With high-harmony vocals, sparkling instrumental flourishes, and some great between-song storytelling, these Servants are original and exciting.     American-born mandolin maestro Jesse Cobb has recorded with Béla Fleck, performed at The Grand Ole Opry, and been Grammy nominated. Group co-founder Dylan Stone, a restlessly creative singer/songwriter/guitarist, has similarly imposing credentials. Newer members fiddler Quin Etheridge and bassist Louis Rudner possess musical skills that have further expanded the group’s impact. Praised by a CBC Radio host for its “gorgeous harmonies and fine songwriting, beautiful instrumental interplay, and some seriously rippin’ solos,” this dazzling acoustic quartet is once again on the road and creating serious buzz.     Featuring Local talent: Sarah Osadetz"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Unfaithful Servants"
      }
    ],
