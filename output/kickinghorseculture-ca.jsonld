    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "KHC invites you to our Annual General Meeting on November 27 at the Art Gallery of Golden. Along with the annual review of our programs, financial updates, and election of new directors, we promise an evening of connecting and celebration of art and culture!  It's a perfect opportunity to learn more about KHC, discover ways to get involved, and support our vibrant arts community. Refreshments will be provided, and good company is guaranteed.  This AGM reviews our June 1, 2023 through May 31, 2024 fiscal year.  Documents coming soon as they are finalized.    June 2023 / May 2024    Meeting Agenda        Review of the past year’s activities    Presentation of the annual budget    Report from the Executive and Artistic Director    Report from the Board    Election of board members    Kick-off of the holiday art gallery showcase      June 2023 / May 2024 GDAC Financials: KHC-GDAC 2023-2024 Cox &amp; Co Financial Statements    Report from the Executive and Artistic Director    Passionate about governance and leadership? Consider joining the KHC Board of Directors.  Learn more HERE"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "GDAC / KHC Annual General Meeting Nov, 27 2024"
      }
    ],
