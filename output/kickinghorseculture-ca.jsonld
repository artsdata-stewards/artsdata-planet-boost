    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Film Kicks presents Compartment Number 6 | Kicking Horse Culture"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "A young Finnish woman escapes an enigmatic love affair in Moscow by boarding a train to the arctic port of Murmansk. Forced to share the long ride and a tiny sleeping car with a larger than life Russian miner, the unexpected encounter leads the occupants of Compartment Number 6 to face major truths about human connection."
      }
    ],
