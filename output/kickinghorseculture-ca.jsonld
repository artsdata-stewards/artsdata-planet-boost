      {
        "@language": "en-us",
        "@value": "Samantha Martin & Delta Sugar with Steve Marriner | Kicking Horse Culture"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Never less than electrifying, award-winners Samantha Martin and Delta Sugar combine retro soul, southern gospel, and classic R&B in an unforgettable showcase of funky passion. Led by fiery lead vocals, these powerhouse performers bring foot-stomping delight to every dance floor. Special guest Steve Marriner just added."
      }
    ],
