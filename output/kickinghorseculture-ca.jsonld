    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Born in the Southern Caribbean island group of Guadeloupe but based in Montreal for over 20 years, Malika Tirolien is a Grammy nominated vocalist and songwriter whose fluid combination of R&amp;B, soul, roots Caribbean, jazz, and hip hop has earned her international attention. After wowing the critics for her work with Snarky Puppy in 2013 she soon released her debut album, Sur La Voie Ensoleillée. Within a year she was lead singer and co-leader of Bokanté, a nine-piece supergroup that was nominated for best World Album at the 2020 Grammys.    The ever-creative Malika is currently hard at work on a solo project, having just released Higher, the second CD in a so-called tetralogy exploring the four elements of earth, air, fire, and water that began with Sur La Voie. Featuring an intoxicating musical fusion that Malika calls “Highsoul,” it is a showcase for the warmth, power, and passionate musicality of this exceptional artist whose performances have been called “electrifying” and “stunning.”"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Malika Tirolien with Ricky Diamonds"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
