    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "One of KHC’s most popular annual events is the Banff Mountain Film Festival World Tour, a “highlights reel” that showcases the most thrilling aspects of mountain culture set in the world’s most pristine, beautifully remote locales. Whether you yearn for intense action sequences or inspiring environmental commentary, these films are a unique window into amazing adventures, exotic cultures, and stirring visits to far-off lands. This one always sells out, so get your tickets early!"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Banff Mountain Film Festival World Tour"
