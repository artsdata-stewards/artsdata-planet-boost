      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Toronto-based jazz-pop vocalist and songwriter Steven Taetz is an internationally acclaimed star whose effortlessly hip performance style has sparked standing ovations from Carnegie Hall to Korea’s Blue Room (and all across Canada). “Whether tender and romantic or sharp and sassy, [Taetz] is a unique, arresting talent,” writes JazzTimes Magazine.     An electrifying performer and inspired song interpreter, Steven has the charm of Harry Connick Jr. and the genre-straddling chops of Michael Bublé. And from sly originals to well-chosen standards, his repertoire is both fresh and timeless. “Taetz is truly hip,” writes vocalist and author Lynn René Bayley. “I could listen to him all night long.” Backed up by a swinging three-piece for his Golden concert, this consummate crooner with the marvelous baritone and charismatic stage presence will thrill any crowd.     Featuring Local talent: Echoes of Rock!"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Steven Taetz"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
  {
