    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "For 30 years Vancouver’s The Paperboys have wowed audiences literally around the world with their amazing fusion of folk, Celtic, bluegrass, ska, soca, zydeco, and African highlife. This six-piece powerhouse is unbeatable on stage and guaranteed to make you dance your head off."
      }
