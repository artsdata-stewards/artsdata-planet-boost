    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Celebrate 50 Years of Live Performance in East Vancouver  You’re invited to attend The Cultch’s 50th Anniversary OPEN HOUSE! Whether you’re a Cultch fan or new to what we do, we’d love to see you!  Enjoy free snacks, take a tour of our three theatres, and get an exclusive behind-the-scenes look at our upcoming season.  Mimosas will be pouring. Fun will be had. Kids are welcome."
      }
    ],
    "http://schema.org/name": [
      {
