  {
    "@id": "https://thecultch.com/event/juliet-and-romeo/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-ca",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Juliet and Romeo | Dance, Theatre, Comedy | APR 29–MAY 03"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "In this hilarious, heartfelt dance/theatre reimagining, Romeo and Juliet didn’t die…even worse, they got married. APR 29–MAY 03"
      }
    ],
    "http://ogp.me/ns#url": [
