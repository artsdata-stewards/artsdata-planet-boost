      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Société francophone de Maillardville in partnership with RésoSanté C.-B offers you the Café Info Workshop to share friendly moments and learn a little more about vaccination with a health care provider. Coffee and small bites will be served. Meeting: January 28, 2025 - 1:00 p.m. to 3:00 p.m. Location: 938 Brunette Ave #200, Coquitlam, BC [&hellip;]&lt;/p&gt;\\n"
      }
