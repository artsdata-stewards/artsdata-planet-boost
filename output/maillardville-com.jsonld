    "http://schema.org/name": [
      {
        "@value": "Atelier Service Canada &#8211; Juin 2025"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Cet atelier en ligne sera offert en partenariat avec Service Canada. Lors de la séance, des représentants de Service Canada seront présents pour partager des ressources utiles et fournir des informations pratiques en français sur le Régime canadien de soins dentaires. Date et heure: Jeudi 19 juin 2025 (de 16 h 30 à 18 h) [&hellip;]&lt;/p&gt;\\n"
      }
    ],
