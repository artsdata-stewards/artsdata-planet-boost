    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;TEA EVENT / THÉ DE L\\'AMITIÉ POUR LES 50+ The Société francophone de Maillardville invites you to a friendly Christmas themed High Tea Event. &nbsp; 🫖 Date: Sunday, December  21st, 2025 📍 Location: Société francophone de Maillardville 938 Brunette Avenue, Unit 200, Coquitlam 🕐 Time: 1:00 p.m. to 3:00 p.m. ☕ Limited to 15 participants. [&hellip;]&lt;/p&gt;\\n"
      }
