    "http://schema.org/name": [
      {
        "@value": "Les Petits Matins"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;La Société francophone de Maillardville est fière et ravie de s\\'associer à la Fédération des parents francophones de C.-B. pour lancer cette nouvelle activité. Ces rencontres gratuites sont dédiées aux parents et à leurs enfants (0 à 5 ans). Au programme : histoires, comptines et jeux pour les enfants, tandis que les parents auront l\\'occasion [&hellip;]&lt;/p&gt;\\n"
      }
    ],
