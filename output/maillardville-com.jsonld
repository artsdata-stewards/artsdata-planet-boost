    "http://schema.org/name": [
      {
        "@value": "Les petits matin December 10"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Les petits matins are back! Join us for a fun and educational morning of family activities! For families with children aged 0 to 5. Date: December 10th Time: 10:30 a.m. to 12:00 p.m. Come share a moment of fun, discovery, and laughter with other Francophone families in a friendly atmosphere. Location: Société francophone de Maillardville [&hellip;]&lt;/p&gt;\\n"
      }
    ],
