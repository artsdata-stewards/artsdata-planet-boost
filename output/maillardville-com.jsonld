    "http://schema.org/name": [
      {
        "@value": "5-7 Franco &#8211; Novembre"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;🇫🇷 5 à 7 FRANCO – NOVEMBRE Rejoignez-nous pour des échanges amicaux entre francophones, francophiles et toute personne intéressée par la francophonie, chaque troisième vendredi du mois. Au menu : moments de plaisir, un verre de vin et quelques bouchées. Prochaine rencontre : vendredi 21 novembre, de 17 h à 19 h. Lieu : Société [&hellip;]&lt;/p&gt;\\n"
      }
    ],
