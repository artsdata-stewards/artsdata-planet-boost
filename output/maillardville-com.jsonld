    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Venez célébrer avec nous le 116ᵉ anniversaire de Maillardville! Nous invitons les francophones, les francophiles et toutes les personnes intéressées par la francophonie à se joindre à nous pour un 5 à 7 festif. Date : Vendredi 26 septembre 2025 Heure : 17 h à 19 h Lieu : Société francophone de Maillardville 9338, avenue [&hellip;]&lt;/p&gt;\\n"
      }
