    "http://schema.org/name": [
      {
        "@value": "Exposition &#8211; Maquettes de ponts"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Venez admirer le talent de nos jeunes bâtisseurs ! La Société francophone de Maillardville est fière de présenter les maquettes de ponts créées par les élèves de 4e et 5e années de l’École des Pionniers-de-Maillardville.Une exposition qui célèbre la créativité, l’ingéniosité et la fierté de notre relève francophone ! 📍 Lieu : 938 Brunette Ave [&hellip;]&lt;/p&gt;\\n"
      }
    ],
