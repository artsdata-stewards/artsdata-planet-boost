    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Come celebrate with us the 116th Anniversary of Maillardville! We invite francophones, francophiles, and everyone interested in French culture to join us for a festive 5 à 7. Date: Friday, September 26, 2025 Time: 5 PM to 7 PM Location: Société francophone de Maillardville 9338 Brunette Avenue, Unit 2000, Coquitlam RSVP: Register here We can’t [&hellip;]&lt;/p&gt;\\n"
      }
