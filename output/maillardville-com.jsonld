    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;The Société francophone de Maillardville invites you to celebrate the holiday season with us. Join us for a warm and friendly gathering where families, neighbors, and francophone community members can meet, connect, and enjoy a joyful afternoon together. Santa Claus will be there to meet the children, take lovely family photos, and share a warm [&hellip;]&lt;/p&gt;\\n"
      }
