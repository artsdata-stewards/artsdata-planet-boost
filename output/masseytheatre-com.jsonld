    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Hidden Fragments: Layers of Discovery"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;This exhibition occurs in conjunction with a workshop in the Massey artist studios, and showcases six artists who share a similar process in creating mixed media art. They work on canvas and cradled panels using paper, paint, and other materials. The artists met at a workshop where they discovered new methods of working with discarded &lt;/p&gt;\\n"
      }
    ]
  },
