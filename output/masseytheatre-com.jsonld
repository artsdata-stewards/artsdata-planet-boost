    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Presented by the Vancouver Welsh Men’s Choir and Winter Harp Back for our annual Christmas concert at Massey Theatre, the Vancouver Welsh Men’s Choir will share the stage with the magical sounds of Winter Harp, in performances both separate and combined. The tenor, baritone and bass voices of the VWMC will be led by Music &lt;/p&gt;\\n"
      }
    ]
  },
