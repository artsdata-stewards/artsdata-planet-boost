    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Debra McKenzie: For My Sanity and Yours"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Debra’s work in “For My Sanity and Yours” come from the natural environment in their purest form. McKenzie demonstrates her “hand” through sandblasting carving, burnishing, waxing painting her assemblages. In altering found objects Debra sees herself simply assisting Mother Nature’s work and primarily drawing on inspiration from empirical sources. Her practice is also influenced by &lt;/p&gt;\\n"
      }
    ]
  },
