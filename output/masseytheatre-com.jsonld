    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;The 6th Annual Leigh Brandt Muscle Classic Bodybuilding &amp; Fitness Show kicks off the 2019 Competitive Season for the Canadian Physique Alliance. Amateur competitors from across British Columbia will compete in bodybuilding,fitness,figure,physique,classic physique &amp; bikini classes in order to earn their top 3 placing to qualify to compete at a ProAM National Event. Hosted by &lt;/p&gt;\\n"
      }
    ]
  },
