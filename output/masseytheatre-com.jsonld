    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;We are thrilled to announce The Boom Booms as the initial concert for our Fall 2020 Concerts programming. With only 50 tickets available for each performance, their high-energy music is guaranteed to get you up dancing with your bubble. Four shows! October 16 @ 7:00 pm and 9:30 pm and October 17 @ 7:00 pm &lt;/p&gt;\\n"
