    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Like Buttah: The Barbra Streisand Tribute Show | Massey Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "PRESENTED BY MICHAEL VAN DEN BOS Few figures in today’s world of entertainment have earned the hallmark of “living legend.” However, one performer virtually owns that label, whose remarkable award-winning career spans six decades of stage, screen, and recording work: singer, actress, and film director Barbra Streisand. Classic film scholar Michael Van Den Bos returns […]"
      }
    ],
