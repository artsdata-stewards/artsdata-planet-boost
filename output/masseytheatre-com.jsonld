      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The Westcoast Iron Vancity Showdown Fitness + Performance Weekend returns to the Massey Theatre for another exciting year. Bringing the best in CPA natural fitness, BCPA Powerlifting, and arm-wrestling from the Vancouver Armwrestling Club to the Lower Mainland, this event offers something for everyone. All of the action takes place starting at 10AM, featuring amateur athletes […]"
      }
    ],
