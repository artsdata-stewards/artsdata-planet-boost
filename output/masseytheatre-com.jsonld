    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Artist Statement: Nature has always been a place of refuge and inspiration for me and is often where I like to paint, in the mountains, forests and by the ocean. Most recently, however, I have found a new refuge in my colours, placing them with emotion onto the canvas in gestures large and small. These […]"
      }
