    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Kismet in Concert Style"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;The New Westminster Symphony Orchestra and Royal City Musical Theatre Presents Kismet in Concert Style. This is the first time these incredible organizations have collaborated on a presentation (and hopefully not the last), and it\\'s sure to be magical. About Kismet With three Tony Awards (including Best Musical), a television version and an MGM smash film, Kismet &lt;/p&gt;\\n"
      }
    ]
  },
