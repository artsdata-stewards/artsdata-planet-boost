    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The Massey Theatre and Laughter Zone 101 present award winning actor and comedian Shaun Majumder for his newest standup show, The LOVE Tour. In 2019, beloved comedian and performer Shaun Majumder brought his complex tour de force HATE to Massey Theatre, much of it in response to living amid rampant Trumpism and the rise of hate he was witnessing in […]"
      }
