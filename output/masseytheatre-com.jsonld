    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Artist Statement For the past 40 years, I have turned again and again to the solace and the threat of land.  Early paintings explored wilderness unmarked by even a telephone wire.  Later I stopped looking from afar—moved closer to the landscape as though I lived within it—and painted it with its indicators of human, animal […]"
      }
    ],
