  {
    "@id": "https://www.masseytheatre.com/event/the-rocket-man-a-tribute-to-elton-john/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
