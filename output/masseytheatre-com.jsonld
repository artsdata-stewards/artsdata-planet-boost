    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "The Joe Cocker Experience | Massey Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "“The Joe Cocker Experience” was born after hearing singer Larry Brennan perform.  Larry was lucky to be born with a singing voice much like Joe Cocker’s – his mannerisms are very similar too – it’s fantastic! The next step was to build the band around Larry, and after a grinding vetting process, an incredibly tight […]"
      }
    ],
