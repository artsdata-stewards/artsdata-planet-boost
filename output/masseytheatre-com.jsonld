    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;The West Coast Tap Dance Collective presents Time Steps, May 27th @ The Massey Theatre. &nbsp; Time Steps is an all-tap-dancing show featuring professional and amateur tap dancers and live music. &nbsp; Each year West Coast Tap recognizes National Tap Dance Day, the birthday of Bill ‘Bojangles’ Robinson, with a celebration that brings the local &lt;/p&gt;\\n"
      }
    ]
