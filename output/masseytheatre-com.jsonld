    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Swinging On A Star: The Bing Crosby Tribute Show"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Presented By Massey Theatre Society 150 minutes, including 15-minute intermission Two show dates: November 13 at 7pm; November 15 at 2pm Classic film scholar and crooner connoisseur Michael van den Bos pays tribute to the legacy of legendary singer and Academy Award-winning actor BING CROSBY. By way of curated clips from classic films and vintage &lt;/p&gt;\\n"
      }
    ]
  },
