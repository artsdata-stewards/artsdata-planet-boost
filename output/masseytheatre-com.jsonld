    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Vancity Showdown"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;The Westcoast Iron Vancity Showdown Fitness + Performance Weekend returns to the Massey Theatre for another exciting year. Bringing the best in CPA natural fitness, BCPA Powerlifting, and arm-wrestling from the Vancouver Armwrestling Club to the Lower Mainland, this event offers something for everyone. All of the action takes place starting at 10AM, featuring amateur athletes &lt;/p&gt;\\n"
      }
    ]
  },
