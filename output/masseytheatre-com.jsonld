    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Vivaldi’s Four Seasons – Vancouver Symphony Orchestra in concert"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;The VSO’s traditional presentation of Vivaldi’s timeless classic, The Four Seasons, comes to Massey Theatre in New Westminster. Repertoire of performance includes Hasse Sinfonia in G minor, Telemann Concerto for Flute and Violin in E minor*, Geminiani/Corelli Concerto grosso No. 12 in D minor, La folia.&lt;/p&gt;\\n"
      }
    ]
  },
