    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Festival del Humor"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;El 1er festival del Humor en New Westminster, British Columbia, Canada.  Ven y disfrutar 3 hrs. de buen humor y reir a carcajadas con nuestros invitados ,profecionales de la comedia en la TVMexicana . Nora Velazquez (CHABELITA),  Ricardo Hill (EL TEACHER) y Alex Del Castillo compartiran contigo mucho entretenimiento y diversion absoluta. No te lo &lt;/p&gt;\\n"
      }
    ]
  },
