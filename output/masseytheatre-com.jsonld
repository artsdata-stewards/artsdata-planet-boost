    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "New Westminster Secondary School’s Musical Theatre Program – School’s Out Productions – proudly presents Disney’s Beauty and the Beast from February 26-29 at Massey Theatre. This “tale as old as time” is sure to wow audiences with its colourful and dazzling display of fantastical dance numbers, comedic banter, and crowd-pleasing music. The story emphasizes the […]"
      }
