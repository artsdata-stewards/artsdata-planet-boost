    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;BUY TICKETS Pre-order your refreshments for pre-show and intermission here! &nbsp; Ticket Prices: Adults: $37 (plus service charges) Student/Senior: $20 (plus service charges) Buy four tickets and get one free! Call the box office at 604-521-5050 for more information. &nbsp; The 13th Annual Mushtari Begum Festival of Indian Classical Music and Dance returns to the Massey &lt;/p&gt;\\n"
      }
    ]
