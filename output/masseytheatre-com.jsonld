    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;We welcome you to our PULSE community to enjoy an afternoon or evening of Dance.  Come and share our year end showcase with us! SHOWTIMES Company Recital Resurgence: June 17th @ 6:00 pm General Program Recital Resurgence: June 18th @ 6:00 pm&lt;/p&gt;\\n"
