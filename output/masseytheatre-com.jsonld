    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The Arts Council and the Massey Theatre present Colette as part of Last Monday at the Movies. After moving to Paris, author Sidonie-Gabrielle Colette agrees to ghostwrite a semi-autobiographical novel for her husband. Its success soon inspires her to fight for creative ownership and overcome the societal constraints of the early 20th century. Colette stars […]"
      }
    ],
