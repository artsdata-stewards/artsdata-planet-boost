    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Beneath the Surface by Jerry Stochansky | Massey Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The exhibition features a series of photographs that are part of the artist’s ongoing practice of burying film in the ground and allowing it to decay, symbolizing the impermanence of everything around us. It shows the transformation of the former image into something new that stands on its own with remnants of the original image. […]"
      }
