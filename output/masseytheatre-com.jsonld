    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Inside/Outward | Massey Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Weirdly distorted and morphing figures in confusing spaces. Patterned marks, raw colours and contrasts, shifting perspective, layers and history of making. Paintings that represent people and spaces but also reference the flatness of surface. The subject of human interaction is fascinating. For an introverted person, meeting other people is often fraught with anxiety. This anxiety […]"
      }
    ],
