    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Métis Jigging | Massey Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Learn the basics of Métis jigging with Charlene Wilson in this exciting workshop for all ages, and then enjoy a fun session of social dancing. Métis jigging has observable similarities to the traditional dances of Quebec and Canadian Maritime communities of British Isles heritage."
      }
    ],
