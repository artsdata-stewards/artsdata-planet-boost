    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "A JOURNEY | Massey Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "An award from an annual local contest rekindled Shameem’s passion for painting in watercolours. Shameem Khan’s watercolours in the show, called “A Journey” were painted over the course of one year. The works transport viewers around the globe, from the sun-drenched plazas and cafes in Italy and Spain, to the grey, wet streets of London. […]"
      }
    ],
