    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;The NWSS Music Department is proud to present our Annual Winter Concert, featuring Concert Bands, Jazz Bands, String Ensemble, and special guest the Royal City Concert Band. A fun night of music! Come on out and watch/hear some of New Westminster\\'s most talented young people perform!&lt;/p&gt;\\n"
