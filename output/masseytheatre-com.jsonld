    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "PRESENTED BY AMIKA KUSHWAHA AND CASSIUS KHAN Lineup announced! 100% Canadian! We are excited to present Canada’s Premiere Indian Classical Music and Dance event, the 11th Annual Mushtari Begum Festival of Indian Classical Music and Dance. The MBF is taking place on Saturday, September 24th 2022 at 7pm featuring the Kathak/Harmonium maestra Amika Kushwaha, who […]"
      }
    ],
