    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Anamnesis | Massey Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Anamnesis examines a romantic story through the shattered lens of nostalgia, highlighting how today’s foreboding future affects how we perceive the past. The work invites audiences to see the Massey Theatre in a new way, overturning expectations and challenging the stability of perception in the 21st Century.   Anamnesis is an unconventional piece of theatre. […]"
      }
    ],
