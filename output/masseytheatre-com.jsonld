  {
    "@id": "https://www.masseytheatre.com/event/omid-live-in-concert/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Omid Live in Concert | Massey Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
