    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Vivaldi’s Four Seasons – Vancouver Symphony Orchestra in concert | Massey Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The VSO’s traditional presentation of Vivaldi’s timeless classic, The Four Seasons, comes to Massey Theatre in New Westminster. Repertoire of performance includes Hasse Sinfonia in G minor, Telemann Concerto for Flute and Violin in E minor*, Geminiani/Corelli Concerto grosso No. 12 in D minor, La folia."
      }
    ],
    "http://ogp.me/ns#url": [
