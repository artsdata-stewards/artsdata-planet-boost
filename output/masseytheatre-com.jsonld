    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Métis Jigging"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Learn the basics of Métis jigging with Charlene Wilson in this exciting workshop for all ages, and then enjoy a fun session of social dancing. Métis jigging has observable similarities to the traditional dances of Quebec and Canadian Maritime communities of British Isles heritage.&lt;/p&gt;\\n"
      }
    ]
  },
  {
    "@id": "https://www.masseytheatre.com/event/you-used-to-call-me-marie-by-tai-amy-grauman/",
