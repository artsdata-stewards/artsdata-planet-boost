    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Morissette Amon is taking the world by storm, her next stop is Canada. See the beauty of a Phoenix Rising through the vocals of Amon, who has stunned an audience of 67 million through her covers. Joined by Frankie Cena, Mr. World Canada as host and guest performer. For tickets, please contact Ivy (Surrey) at &lt;/p&gt;\\n"
      }
    ]
