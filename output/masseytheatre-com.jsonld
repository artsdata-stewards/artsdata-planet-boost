    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "PRESENTED BY THE DIAMOND MINE AGENCY Every idea on Steve-O’s Bucket List was so ill-advised, he never expected to go through with any of them. Until it was time to prepare for this tour. Not only are the stunts more ridiculous than what you already know Steve-O for, he did them all, and made a […]"
      }
