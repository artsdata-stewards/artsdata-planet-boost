    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;NWSS Dance Presents Spring 2022 Dance Shows! &nbsp; Lost in the Jungle Our Senior dancers have created our own dance interpretation of the recent Jumanji movies. Our characters begin their story in detention, considering how they ended up in this predicament. After finding an old, dusty video game console, the students escape detention only to &lt;/p&gt;\\n"
      }
