    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Morisette Amon | Massey Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Morissette Amon is taking the world by storm, her next stop is Canada. See the beauty of a Phoenix Rising through the vocals of Amon, who has stunned an audience of 67 million through her covers. Joined by Frankie Cena, Mr. World Canada as host and guest performer. For tickets, please contact Ivy (Surrey) at […]"
      }
    ],
