    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Presented by Eighth &amp; Eight Creative Spaces 150 minutes, includes 15-minute intermission Two show dates: May 7, 2026 at 7pm; May 9, 2026 at 2pm Classic film scholar and musical hepcat Michael van den Bos is your host for a rhythmic retrospective revue of all that jazz in the movies. From the hot ‘n’ swinging to &lt;/p&gt;\\n"
      }
