    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Ticket prices: Adult: $24 (plus s/c) Student/Children: $22 (plus s/c) Showtimes: March 5 - 7:00pm March 6 - 7:00pm March 7 - 7:00pm March 8 - 2:00pm &amp; 7:00pm Running time: 2hrs, 35mins, including intermission BUY TICKETS Pre-order your pre-show and intermission treats here! &nbsp; Presented NWSS Musical Theatre Mamma Mia!  Here we go again!  &lt;/p&gt;\\n"
      }
    ]
  },
