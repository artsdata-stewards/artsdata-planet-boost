    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The Royal Canadian Theatre Company is back to the Massey Theatre with another traditional British Panto, written and directed by the indomitable Ellie King. The apple crop has failed for the past five years which is a disaster for the famous strudel makers of the little village of Unterstrudel, situated somewhere between Austria and Hungary. […]"
      }
