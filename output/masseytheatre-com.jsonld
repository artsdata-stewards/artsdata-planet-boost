    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "12th Annual Mushtari Begum Festival"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;PRESENTED BY AMIKA KUSHWAHA AND CASSIUS KHAN The 12th Annual Mushtari Begum Festival of Indian Classical Music and Dance returns to Massey Theatre as one of the premiere festivals celebrating Indian Classical Music and Dance. The MBF features Kathak/Harmonium maestra Amika Kushwaha, dazzling the audience stupendous footwork patterns and blinding pirouettes, Ghazal/Tabla Wizard Cassius Khan &lt;/p&gt;\\n"
      }
    ]
  },
