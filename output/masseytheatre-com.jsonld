    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;The NWSS Dance Department introduces their end of semester Dance Show. The senior dancers present &quot;Get A Clue,&quot; a show loosely based on the popular whodunit board game &quot;Clue&quot;. Come join our high school students who have to solve the mystery, complete with hip hop, suspects and intrigue! The junior dancers present &quot;Welcome to the &lt;/p&gt;\\n"
      }
    ]
  },
