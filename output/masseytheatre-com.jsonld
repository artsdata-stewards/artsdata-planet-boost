    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Where Planted | Massey Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Featuring work by Melissa H. Clark Either a statement or a question, I want to evoke with my art exhibition, asking where I am planted yet knowing I am here. Topophilia, a sense of place, has been a term I have regarded in my work since being introduced to it in university. Memories of home […]"
      }
    ],
