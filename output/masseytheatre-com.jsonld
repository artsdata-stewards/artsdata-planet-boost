    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "DanceForce Recital Showcase &#8211; Show 1"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;DanceForce studio invites you to join them for their 11th Annual Recital Showcase.  Celebrate the talented dancers from DanceForce. as they perform many of their award winning routines from the 2022/23 season.  The Showcase will feature dancers from 2-18yrs of age in a multitude of  dance disciplines: Jazz, Ballet, Musical Theatre, Contemporary, Acrobatics, Lyrical, Hip &lt;/p&gt;\\n"
      }
    ]
  },
