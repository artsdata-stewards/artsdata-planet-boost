    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;A brand new one of a kind show, that takes the audience through chronological Music History, Trivia &amp; Memories of the 50’s &amp; 60’s. The show features an energetic live band, amazing front singers and dancers transforming and re-living thru two decades of music, costumes, trends and dancing with video imagery in the background. The &lt;/p&gt;\\n"
      }
    ]
  },
