    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "VERT-I-Go Dance Experience"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Presented by Global Dance Services VERT-I-Go Dance Experience: Welcome to our Zero Waste, Pre-season Dance Event - A dance festival for the whole dancer, featuring injury prevention, mental health workshops and movement activities. In lieu of medals and trophies a donation has been made to the World Wildlife Federation animal conservation efforts. Pre-order your refreshments &lt;/p&gt;\\n"
      }
    ]
  },
