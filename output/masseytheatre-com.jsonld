    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Snow Queen: A Frozen Adventure"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;By Crystal Weltzin Presented by Royal Canadian Theatre Company Lesa and Anna navigate sisterhood in Arendella as they enter adulthood and their lives begin to change. Will they welcome the new challenges and come closer together or grow apart in the face of struggle and constant disagreement? Traditional British Panto at its rambunctious best! Sparkling, &lt;/p&gt;\\n"
      }
    ]
  },
  {
