    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "10th Annual Mushtari Begum Festival"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;We are excited to present Canada\\'s Premiere Indian Classical Music and Dance event, the 10th Anniversary Mushtari Begum Festival of Indian Classical Music and Dance. The MBF features the Ghazal/Tabla artiste Cassius Khan, Harmonium maestra Amika Kushwaha  and Violin Maestro Kaushik Sivaramakrishnan where Cassius Khan will present a tribute of choice classical ghazals and Tabla. &lt;/p&gt;\\n"
      }
    ]
  },
