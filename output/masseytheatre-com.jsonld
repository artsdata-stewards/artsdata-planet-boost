    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The Lunacy Phases is a 5-day physical and imaginative dance-based, creative, thorough self exploration. Pertaining to each individual’s own authentic movement and honouring where they are, and what they have, no matter what their dance background is. No labels. This project is a creative/freestyle based progressive for youth who want to discover their own sensation […]"
      }
