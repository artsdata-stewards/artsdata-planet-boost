    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;June 15 at 7:30 pm and June 17 at 1:00 pm We welcome you to our PULSE community to enjoy an afternoon or evening of Dance.  Come and share our year end showcase with us! Tickets are available starting June 2, 2018. &nbsp; &nbsp;&lt;/p&gt;\\n"
      }
