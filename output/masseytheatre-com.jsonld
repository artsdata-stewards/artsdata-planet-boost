    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "O Christmas Tea: A British Comedy"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Fans of Monty Python, Mr. Bean, and Dr. Seuss… Grab your teacups! Off-Broadway Comedians and 3-time IMPRESARIO Award-Winners (London) James &amp; Jamesy return with their outrageously funny and brilliantly inventive Christmas comedy classic O Christmas Tea — an astonishing show that delights thousands of hearts every holiday season. When catastrophe strikes at James and Jamesy’s &lt;/p&gt;\\n"
      }
    ]
  },
