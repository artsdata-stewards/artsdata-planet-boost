    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Due to the increased health concerns globally and in our communities, the Solidarity Concert for Unist’ot’en is being postponed to a later date to be determined. This difficult decision was guided not only by global reports, but from trusted voices in the Indigenous health community for the concern of our most vulnerable community members’ immune &lt;/p&gt;\\n"
      }
