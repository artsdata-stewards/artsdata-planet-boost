  {
    "@id": "https://www.masseytheatre.com/event/la-mereidylle-2/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
