    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Rihla - From Roots to Dreams | Massey Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The word Rihla means ‘journey’ in Arabic. Through dance, music, drama and multimedia, Rihla will take the audience on a journey from Mawlana Sultan Mohamed Shah’s Diamond Jubilee, through to Mawlana Hazar Iman’s recent Diamond Jubilee. Rihla tells the story behind our Jamat’s “Canadian Mosaic”. It showcases the rich diversity and unique stories of migration, […]"
      }
    ],
