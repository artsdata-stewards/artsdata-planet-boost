    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Artist Statement: Photography was my earliest entry into the creative arts and that was soon followed by music. My piano studies took over and, after earning a performance degree, I worked as a professional musician for several years in Toronto. Over the years, my career has taken several paths, from an agent for musicians to a manager &lt;/p&gt;\\n"
      }
