    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "PRESENTED BY MICHAEL VAN DEN BOS Run time: 135 minutes, includes intermission Legendary Hollywood movie star and musical performer JUDY GARLAND is the whole, wonderful show when classic film historian Michael van den Bos presents an over-the-rainbow event celebrating all the joy of Judy in a retrospective revue of her dynamic career.  Michael has curated a collection of glorious […]"
      }
