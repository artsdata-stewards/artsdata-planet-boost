    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;The word Rihla means \\'journey\\' in Arabic. Through dance, music, drama and multimedia, Rihla will take the audience on a journey from Mawlana Sultan Mohamed Shah\\'s Diamond Jubilee, through to Mawlana Hazar Iman\\'s recent Diamond Jubilee. Rihla tells the story behind our Jamat\\'s &quot;Canadian Mosaic&quot;. It showcases the rich diversity and unique stories of migration, &lt;/p&gt;\\n"
      }
