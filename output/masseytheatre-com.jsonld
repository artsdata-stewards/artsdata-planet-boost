    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Last Monday at the Movies: The Tomorrow Man"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Arts Council of New Westminster and Massey Theatre present The Tomorrow Man as part of Last Monday at the Movies. Ed Hemsler spends his life preparing for a disaster that may never come. Ronnie Meisner spends her life shopping for things she may never use. In a small town somewhere in America, these two people &lt;/p&gt;\\n"
      }
    ]
  },
