    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Artist Statement This body of work illustrates how art reveals states of human emotions and can be used as a therapeutic process. The series of drawings guides you through emotional states we go through in times of transition. Our moods can go from anger, fear, and agitation to acceptance, peace and even happiness. These drawings […]"
      }
