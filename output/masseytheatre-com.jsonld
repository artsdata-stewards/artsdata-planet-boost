    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Debra McKenzie: For My Sanity and Yours | Massey Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Debra’s work in “For My Sanity and Yours” come from the natural environment in their purest form. McKenzie demonstrates her “hand” through sandblasting carving, burnishing, waxing painting her assemblages. In altering found objects Debra sees herself simply assisting Mother Nature’s work and primarily drawing on inspiration from empirical sources. Her practice is also influenced by […]"
      }
    ],
