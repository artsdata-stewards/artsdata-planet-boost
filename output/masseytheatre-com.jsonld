    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Summer Days by Larry Tillyer"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Larry Tillyer was born in Victoria, B.C. and moved with his family to Vancouver when he was a small boy. Larry is a self taught artist who began his odyssey of painting in 1987. Larry started painting after a successful career in music playing with the likes of Bill Haley &amp; The Comets, Ivory Joe &lt;/p&gt;\\n"
      }
    ]
  },
