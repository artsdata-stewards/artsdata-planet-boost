    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "A WONDERHEADS Christmas Carol"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Praised by the CBC as “Pure magic” and the Globe and Mail as “Powerful, surprising and moving,” acclaimed theatrical imagineers the WONDERHEADS present their delightfully captivating reimagining of Charles Dickens’ A Christmas Carol, with giant masks, whimsical puppets, and wondrous theatrical invention. A feast for the eyes, ears, heart and funny bone, this astonishing production &lt;/p&gt;\\n"
      }
    ]
  },
