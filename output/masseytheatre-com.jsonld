    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;The Massey Theatre opened in 1949 as British Columbia’s largest theatre, at the time, with 1,260 seats. Since then, its lights have shone on thousands of performances and has become a cherished space to experience the arts. The Massey hosts large scale musicals, international music and dance performances, symphonies, choirs, ballets and more. With a &lt;/p&gt;\\n"
      }
