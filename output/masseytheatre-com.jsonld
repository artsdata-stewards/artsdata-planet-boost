    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Flame New West Reignited: The After Dark Edition"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Come to the Plaskett Gallery for an evening of true storytelling, music and art! This edition of The Flame will feature a few &quot;Adult Content&quot; stories, so expect some foul language and mature content. Storytellers Include: Noreen Murphy Jay Brazeau Melanie L. Walker Wong Wing-Siu Japhy Ryder Sterling James Marylee Stephenson Peter Jorgenson Katey Wright &lt;/p&gt;\\n"
      }
    ]
  },
