    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "New West Symphony Orchestra Mother's Day Concert: Viva Espana. | Massey Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Beautiful music for everyone this week before Mother’s Day. This year’s concert is of evocative favourites from sunny Spain, entitled Viva España.  The concert includes such popular numbers as de Falla’s Ritual Fire Dance, Chabrier’s España, and Bizet’s Carmen Suite No. 2 in the first half.  The Ritual Fire Dance is known for its supernatural […]"
      }
    ],
