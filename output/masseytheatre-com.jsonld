    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Port Moody School of Dance Showcase"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Port Moody School of Dance showcase! A year end dance performance showcase.  The dancers have been working hard for the past 10 months to put on this wonderful show.  Featured dance styles include jazz, hip hop, tap, lyrical, ballet, stage and contemporary. Senior 65+ Children 3 - 12 Matinee performance 12 pm Evening performance 5 &lt;/p&gt;\\n"
      }
    ]
  },
