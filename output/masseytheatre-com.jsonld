      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Do you think Grease is the word? “BEAR GREASE” is a hilarious, indigenous twist on the musical “Grease”. It features an all indigenous cast starring: Crystle Lightning (Canadian Screen Award Winner for Best Lead Actress “Trickster”) and MC RedCloud (Former World Record holder for “Longest Freestyle Rap”). Come with your singing voices ready to rock […]"
      }
    ],
