    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Massey Presents: Kid Koala The Storyville Mosquito"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;MASSEY PRESENTS KID KOALA THE STORYVILLE MOSQUITO November 25 @ 7:30 PM and November 26 @ 2:00 PM Kid Koala The Storyville Mosquito is performed, filmed, projected and scored on stage at each performance. Each show is a unique experience. The story: A young mosquito leaves his small town in the country to seek fame &lt;/p&gt;\\n"
      }
    ]
