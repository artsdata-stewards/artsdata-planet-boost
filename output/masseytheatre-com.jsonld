    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;The Natural Westcoast Iron Vancity Showdown is a fitness, figure, bikini, bodybuilding, physique, classic physique, a figure event governed by the Canadian Physique Alliance (CPA). Featuring the best natural athletes in western Canada, this level 1 show qualifies athletes for the Natural Canadian Championships held in Toronto. Come out and support these incredible athletes as &lt;/p&gt;\\n"
      }
