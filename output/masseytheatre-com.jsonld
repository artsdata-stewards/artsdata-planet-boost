    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Live show presented by Gurinder Sodhi and Paradox Entertainment. There are live performances by Indian Idol season 10 winner Salman Ali and talented finalists Nitin Kumar, Avanti Patel and Ankush Bharadwaj will make this pre new year and Christmas bash party a memorable evening of music by refreshing the soul stirring memories. &nbsp; For tickets, &lt;/p&gt;\\n"
      }
