    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Presented by Caravan World Rhythms Legendary Ethno-Chaos group from Kyiv After selling out their last three concerts in Vancouver, DakhaBrakha returns with their spectacular musical and visual performance to the superb Massey Theatre, bringing their powerful message of resistance and solidarity for Ukraine. “With their otherworldly singing and self-described ethno-chaos sounds, this Ukrainian quartet mesmerized […]"
      }
