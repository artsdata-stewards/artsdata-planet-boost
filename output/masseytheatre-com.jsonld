    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Broadway Goes Hollywood"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Presented By Eighth and Eight Creative Spaces Running time: 150 min., includes 15-minute intermission Two show dates: January 22, 2026 at 7pm; January 24, 2026 at 2pm Hollywood’s embrace of Broadway bedazzlement goes back to the advent of sound films when the movies began to sing and dance. Critically acclaimed and audience pleasing musical theatre &lt;/p&gt;\\n"
      }
    ]
  },
