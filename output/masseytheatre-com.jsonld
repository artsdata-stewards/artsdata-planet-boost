    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Ticket prices: Admission: $19.00 plus s/c BUY TICKETS Pre-order your refreshments for pre-show and intermission here!   Presented by Global Dance Services Inc. The Synergy Showdown Finals is the event finale. After four incredible days of dance qualifying routines will take the stage once more and compete for the title of Showdown Champion. "
      }
