    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;PRESENTED BY BACKSTAGE VENTURES Catch 10Q, celebrating A-list diva and Queen of Teleserye and Movie Theme Songs, Angeline Quinto, as she hits the 10 year milestone in Philippine music industry. Performing with her is one of the Philippine\\'s most popular R&amp;B trio composed of  Bugoy Drilon , Daryl Ong and Michael Pangilinan, more popularly known &lt;/p&gt;\\n"
      }
    ]
