    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Kena and Ziki live very different lives in Nairobi. Kena works in her father\\'s shop and awaits the start of nursing school, while Ziki passes the days hanging out with her friends and making up dance routines. Their paths cross when their fathers run against each other for seats in the County Assembly, and they &lt;/p&gt;\\n"
      }
