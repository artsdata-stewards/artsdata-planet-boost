    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;PRESENTED BY MILLENIAL EVENTS Shark Tank season 2 host one of the best performers on Amazon Prime Video`s Comicstaan S 01 Rahul Dua is one of the brightest young comics in the country today. Combining small town charm with big city disillusionment, Rahul’s comedy is as funny as it is relevant. And with a beard &lt;/p&gt;\\n"
      }
