    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Ticket prices: $15 (plus s/c) BUY TICKETS Pre-order your refreshments for pre-show and intermission here! &nbsp; &nbsp; Presented by New Westminster Secondary School Music Department New Westminster Secondary School Music Department’s biggest event of the year! Featuring concert bands, jazz bands, choir and strings! Don’t miss this last chance to see what musical pursuits these &lt;/p&gt;\\n"
      }
    ]
