    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Maharashtrachi Hasyajatra"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Ticket prices: Red $59.00 (plus s/c) Blue $49.00 (plus s/c) Purple $39.00 (plus s/c) Grey $29.00 (plus s/c) BUY TICKETS Pre-order your pre-show refreshments here! &nbsp; Presented by Avishkar Arts Maharashtrachi Hasyajatra (MHJ) is an Indian Marathi-language comedy show airing on Sony Marathi TV. In this show popular Marathi actors and professional comedians perform skits &lt;/p&gt;\\n"
      }
    ]
  },
