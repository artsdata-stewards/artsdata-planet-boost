    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Ticket prices: Adult $32.25 (plus s/c) Senior/Student $28.25 (plus s/c) Family Pack (4 tickets) $119 (plus s/c) Showtimes: Fri Jan 3 at 7:30pm Sat Jan 4 at 2:00pm &amp; 6:30pm* Sun Jan 5 at 2:00pm Relaxed performance* Saturday, January 4th at 6:30pm A sensory-friendly show for everyone to enjoy, with ASL interpreters on the right &lt;/p&gt;\\n"
      }
    ]
