    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;DanceForce. studio invites you to join them for their Recital Showcase.  Celebrate the talented dancers from DanceForce. as they perform many of their award winning routines from their 2024/25 season.  The Showcase will feature dancers from 2-18yrs of age in a multitude of  dance disciplines: Jazz, Ballet, Musical Theatre, Contemporary, Acrobatics, Lyrical, Hip Hop &amp; &lt;/p&gt;\\n"
      }
    ]
  },
