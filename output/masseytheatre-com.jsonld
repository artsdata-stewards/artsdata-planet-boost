    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Celebration 50: Say it Loud Gay is Proud"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;In July of 1969 the Canadian government took its first legislative steps towards decriminalising homosexuality in Canada. This was a result of activism by the LGBTQ community over the course of the late 60s. The very next day in the US, the Stonewall riots spontaneously sparked spelling the end of legal oppression of homosexuals in that country.  &lt;/p&gt;\\n"
      }
    ]
  },
