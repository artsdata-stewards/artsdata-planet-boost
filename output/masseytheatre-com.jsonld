    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Metis Pairing by Nicci Battilana and Monique Hurteau"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Presented in partnership with Savage Society, Métis Pairing highlights local Indigenous artists Nicci Battilana and Monique Hurteau, who work in an eclectic variety of mediums and styles. The vibrant exhibition combines an exciting array of colours, forms, and textures to create a stunning visual feast which will shatter preconceived notions about Métis art and expression.&lt;/p&gt;\\n"
      }
    ]
  },
