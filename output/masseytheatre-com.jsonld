    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Ticket prices: *All princes include service charges and taxes Morning show: $57.04 Evening show: $71.04 BUY TICKETS &nbsp; Presented by Xtreme Promotions CPA Show Promoters Dean &amp; Leigh Brandt of X-treme Promotionsare proud to present the 2025 Vancouver Fall Classic at Massey Theatre. This is a OPEN regional show open to all competitiors across Canada. &lt;/p&gt;\\n"
      }
