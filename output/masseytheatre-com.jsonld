    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Ticket prices: All prices include service charges and taxes VIP: $108.00 Orchestra: $88.00 &nbsp; BUY TICKETS Pre-order your pre-show refreshments here! &nbsp; Presented by PNA Philippine Nurses Association of British Columbia  &quot;From the Heart, For the Heart&quot; A night with Maestro REY VALERA for his Valentine 2026 Canada Tour. The Original Filipino Music (OPM) &quot;Hugot &lt;/p&gt;\\n"
      }
    ]
