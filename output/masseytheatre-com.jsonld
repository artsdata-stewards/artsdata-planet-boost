    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "VSO Traditional Christmas"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;The annual holiday tradition returns to the Massey Theatre this Christmas! Celebrate the season with family and friends as you gather to hear your favourite carols and Christmas music sung by guest soloists and performed live by the Vancouver Symphony Orchestra, conducted by David Bui. Beloved host Christopher Gaze will delight with his characteristic antics &lt;/p&gt;\\n"
      }
    ]
