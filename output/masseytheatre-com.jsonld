    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The New Westminster Symphony Orchestra and the Richmond Academy of Dance proudly present their 18th Annual Christmas Dance Concert.  On Friday, December 8 at 7:30 pm, join the NWSO and the talented young dancers of the Richmond Academy of Dance at the Massey Theatre for your seasonal music favourites and selections from Tchaikovsky’s The Nutcracker.  […]"
      }
    ],
