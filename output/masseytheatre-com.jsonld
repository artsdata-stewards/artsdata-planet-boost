    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Artist Stanley Mishkin Artist Statement: The picture postcard of Vancouver is portrayed as a 21st century city set against the background of the scenic Coast Mountains. Stroll amid the canyons of the downtown office and condominium towers and there are but fleeting glimpses of this mountain vista so prized among its inhabitants. In the streetscapes […]"
      }
    ],
