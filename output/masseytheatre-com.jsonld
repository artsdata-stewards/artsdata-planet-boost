    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Presented by Royal City Youth Ballet Experience the magic of The Nutcracker this holiday season with RCYB\\'s full length ballet, featuring a cast of 100+ dedicated and enthusiastic dancers under the direction of Keitha Campeau. Performing to Peter Ilyich Tchaikovsky\\'s beautiful music, this traditional ballet has beautiful sets designed by Jean Claude Olivier and extravagant, &lt;/p&gt;\\n"
      }
