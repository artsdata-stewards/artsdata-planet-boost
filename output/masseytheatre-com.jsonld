    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "NWSS June Revue Concert and Awards"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;It’s been two years since the New Westminster Secondary Music Department ensembles have been able to celebrate the end-of-the-year with the traditional June Revue Concert and Awards. But this year, they are back!! This concert has been a tradition at NWSS for decades, and students and staff are thrilled to be bringing the music back &lt;/p&gt;\\n"
      }
    ]
