    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Open Space Saturdays is an outdoor arts and community space activating the outdoor areas around Massey Theatre. Open Space Saturdays will run every summer Saturday from 11am to 10pm This Saturday\\'s programming includes... 11 am-3 pm: Kids activities including a selections of fun giant board games and outdoor games such as Jenga, ping pong and &lt;/p&gt;\\n"
