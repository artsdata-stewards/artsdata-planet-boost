    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Joe Cocker Experience"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;“The Joe Cocker Experience” was born after hearing singer Larry Brennan perform.  Larry was lucky to be born with a singing voice much like Joe Cocker’s – his mannerisms are very similar too - it’s fantastic! The next step was to build the band around Larry, and after a grinding vetting process, an incredibly tight &lt;/p&gt;\\n"
      }
    ]
  },
