    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Legends Show: A Tribute to Roy and Elvis"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Ticket prices: General: $57 (plus s/c) BUY TICKETS Pre-order your refreshments for pre-show and intermission here! &nbsp; Presented by Paquette Productions &quot;Legends Show&quot; brings you some of North America\\'s most exciting performers live on stage. Accompanied by the “Rockin’ Royals Band”, this show will feature the most incredible Tributes to Roy Orbison and Elvis Presley. &lt;/p&gt;\\n"
      }
    ]
