        "@language": "en-us",
        "@value": "NWSO Mother's Day Concert | Massey Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "​MAY 8 2016 Sunday 2:00 pm The Merry Wives of Windsor Overture ( Nicolai ) Symphony No. 2 ( Borodin ) Introduction & Allegro ( Schumann ) Rhapsody in Blue ( Gershwin )"
      }
    ],
    "http://ogp.me/ns#url": [
