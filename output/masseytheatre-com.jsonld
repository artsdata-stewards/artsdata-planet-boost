    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Quayside Voices presents The Real Group"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Quayside Voices, with support from the Massey Theatre Society and New Westminster Secondary School, is pleased to present The Real Group! The Real Group is a professional a cappella ensemble from Sweden, in constant development since its formation in 1984. The Real Group is one of the leading forces in the world of vocal music &lt;/p&gt;\\n"
      }
    ]
  },
