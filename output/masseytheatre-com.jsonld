    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Echoes of Georgia: Iverioni&#8217;s Premiere Performance in Vancouver"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Presented by Iverioni Experience the heartbeat of Georgia in Vancouver! Immerse yourself in the rich culture and vibrant energy of Georgia as the renowned folk dance and chant ensemble \\'Iverioni\\' takes center stage for their first solo live concert in Vancouver Date: Friday, December 15, 2023 Time: 7:00 PM Venue: Massey Theatre, 735 8th Ave. &lt;/p&gt;\\n"
      }
    ]
  },
