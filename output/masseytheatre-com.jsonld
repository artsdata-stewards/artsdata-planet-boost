    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;January 2018 Skookum Indigenous Arts Programming Presented by Savage Society &amp; Massey Theatre With the support of Vancouver Foundation Key dates Jan 4 – 30             Mixed Reviews – The Art of Carrielynn Victor &amp; Bracken Hanuse Corlett in Plaskett Gallery Jan 4                     Mixed Reviews – Opening Reception with Ronnie Dean  Harris, Valeen Jules &lt;/p&gt;\\n"
      }
    ]
  },
  {
    "@id": "https://www.masseytheatre.com/event/rumble-indians-rocked-world/",
    "http://ogp.me/ns#locale": [
      {
