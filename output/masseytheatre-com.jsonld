    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "La Mére/Idylle | Massey Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "We often live in a world of carefully assembled identities and projections. We smile and tell certain stories in certain ways. Our interior realities can be more challenging (and hold so much more potential), should we have the opportunity to examine and give them weight and form. La Mére/Idyll is a series of paintings that challenge […]"
      }
    ],
