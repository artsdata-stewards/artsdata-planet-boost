    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Parvaz Homay is a traditional Persian singer who has performed previously on many famous stages globally, including Canada. In recent years, he has been working with many Italian classical music masters to merge the Eastern traditional music with Western classical music. He is going to perform on stage of Massey Theatre with symphony orchestra musicians […]"
      }
