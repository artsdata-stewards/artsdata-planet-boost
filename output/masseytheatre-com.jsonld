    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Where Planted"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Featuring work by Melissa H. Clark Either a statement or a question, I want to evoke with my art exhibition, asking where I am planted yet knowing I am here. Topophilia, a sense of place, has been a term I have regarded in my work since being introduced to it in university. Memories of home &lt;/p&gt;\\n"
      }
    ]
  },
