    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Presented by Rock.It Boy Entertainment TICKETS ON SALE MARCH 22nd! Rock.It Boy Entertainment presents BURTON CUMMINGS UnPlugged: the Hits, like you’ve never heard them before Wednesday, May 24 at the Massey Theatre, 735 8th Avenue in New Westminster. Tickets are $89.50 (plus service charges) at the Massey Theatre. Charge by phone at 604-521-5050 or online &lt;/p&gt;\\n"
      }
