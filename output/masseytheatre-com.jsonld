    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;In a story depicted in oil painted animation, a young man comes to the last hometown of painter Vincent van Gogh to deliver the troubled artist\\'s final letter and ends up investigating his final days there. No other artist has attracted more legends than Vincent van Gogh. Variously labelled a martyr, a lustful satyr, a &lt;/p&gt;\\n"
      }
