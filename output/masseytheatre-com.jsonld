    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Presented By Eighth and Eight Creative Spaces Running time: 150 min., includes 15-minute intermission January 22, 2026 at 7pm Hollywood’s embrace of Broadway bedazzlement goes back to the advent of sound films when the movies began to sing and dance. Critically acclaimed and audience pleasing musical theatre productions such as SHOW BOAT, GUYS AND DOLLS, &lt;/p&gt;\\n"
      }
    ]
