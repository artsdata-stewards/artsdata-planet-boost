    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "presented by VaughnCo Entertainment RUMOURS, The Ultimate Fleetwood Mac Tribute Show VaughnCo Entertainment is proud to present “Rumours” The Ultimate Fleetwood Mac tribute show based in Los Angeles, California. The group recreates the legendary band in its youthful heyday from 1975-1979. “It’s been said imitation is the sincerest form of flattery. I say THANK YOU!”- Richard Dashut, Record Producer – Fleetwood Mac albums including Rumours, Tusk, Live, Mirage, Tango […]"
      }
