    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "PRESENTED BY MICHAEL VAN DEN BOS Inspired by the enormously popular multi-Academy Award nominated 2022 biopic Elvis directed by Baz Lurhmann and starring Austin Butler, classic film scholar Michael Van Den Bos presents an epic exploration of Elvis Presley’s comet-streaking musical career by way of film and vintage T.V. clips. Elvis’s emergence at the forefront […]"
      }
