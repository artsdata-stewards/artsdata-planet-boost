    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Ticket prices: General: $38 (plus s/c) BUY TICKETS Pre-order your refreshments for pre-show and intermission here! &nbsp; Presented by Richmond Academy of Dance &quot;Dance into Christmas&quot; with Richmond Academy of Dance\\'s festive evening featuring Guest Pas de Deux couple from Les Grands Ballets Canadiens in The Nutcracker. Enjoy specially choreographed works, live musicians, and soprano &lt;/p&gt;\\n"
      }
    ]
