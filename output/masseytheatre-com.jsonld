    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;In the Plaskett Gallery @ Massey Theatre March 1st to 30th 2018 Portraits Gabor Gasztonyi BA, MPA Photographer, author, filmmaker. Gabor specialty is Black and White Photography, fine art prints, Studio Portraiture and documentary filmmaking. For him, photography is thinking about what to photograph and trying to preserve it knowing that the whole process is &lt;/p&gt;\\n"
      }
    ]
