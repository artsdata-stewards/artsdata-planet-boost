    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Pulse Dance: Colour Your World and Explore"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;We welcome you to our PULSE community to enjoy an afternoon or evening of Dance.  Come and share our year end showcase with us! &nbsp; Colour Your World, June 22, 2019 1:00pm General admission $15 plus services charge Student admission $12 plus services charge &nbsp; Explore, June 22, 2019 5:00pm General admission $22 plus service &lt;/p&gt;\\n"
      }
    ]
  },
