    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "DanceForce studio invites you to join them for their 11th Annual Recital Showcase.  Celebrate the talented dancers from DanceForce. as they perform many of their award winning routines from the 2022/23 season.  The Showcase will feature dancers from 2-18yrs of age in a multitude of  dance disciplines: Jazz, Ballet, Musical Theatre, Contemporary, Acrobatics, Lyrical, Hip […]"
      }
