    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Royal City Youth Ballet&#8217;s The Nutcracker"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Experience the magic of the Nutcracker this holiday season with the Royal City Youth Ballet\\'s full length ballet now celebrating their 29th season! Featuring a cast of 70+ dedicated and enthusiastic dancers under the artistic direction of Camilla Fishwick-Kellogg.  There are magical soldiers, dueling mice, a Sugar Plum Fairy, along with audience favourites Snowflakes, Snow King &lt;/p&gt;\\n"
      }
    ]
  },
