      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Áila, returning home emotionally tender and exhausted from a difficult appointment with her OB-GYN, finds a terrified, barefoot and heavily pregnant Rosie shivering out in the rain. Clearly in need, Rosie is paralyzed: caught between escaping her violent boyfriend heard screaming from across the street and having nowhere to go. Frightened by the escalating danger, […]"
      }
    ],
