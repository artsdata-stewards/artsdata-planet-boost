    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Spice Wannabe &#8211; The Spice Girls Tribute"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Ticket prices: All prices include service charges and taxes Regular: $65.00 &nbsp; BUY TICKETS Pre-order your refreshments for pre-show and intermission here! &nbsp; Presented by Paquette Productions “SPICE WANNABE” is bringing us back to the 90’s with their high energy show, paying tribute to the best selling girl group of all time The Spice Girls! &lt;/p&gt;\\n"
      }
    ]
  },
