    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Last Monday at the Movies: Colette"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;The Arts Council and the Massey Theatre present Colette as part of Last Monday at the Movies. After moving to Paris, author Sidonie-Gabrielle Colette agrees to ghostwrite a semi-autobiographical novel for her husband. Its success soon inspires her to fight for creative ownership and overcome the societal constraints of the early 20th century. Colette stars &lt;/p&gt;\\n"
      }
    ]
  },
