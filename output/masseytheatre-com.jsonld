    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Presented by Rock.It Boy Entertainment From the prairies of Saskatchewan to sharing the stage with arguably the greatest and most influential guitarists of all time, COLIN JAMES still remembers the words of advice given to him by the late, great, Stevie Ray Vaughan; “I’m opening doors for you –walk through them.” James has taken those &lt;/p&gt;\\n"
      }
