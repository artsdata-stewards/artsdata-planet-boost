    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Since 1978, Sharon Hampson and Bram Morrison have been pre-eminent in all aspects of family entertainment across North America as members of the trio “Sharon, Lois & Bram”. Together, the threesome produced over twenty recordings, beginning with their iconic ‘One Elephant, Deux Elephants’, three song-books, six national TV specials, sixty-five episodes of The Elephant Show, […]"
      }
