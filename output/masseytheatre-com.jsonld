    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The New Westminster Symphony Orchestra concert"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;The orchestra, led by conductor Jin “Jack” Zhang, is presenting a May 7 concert at 2 p.m. at the Massey Theatre. The concert opens with music by German master Richard Wagner, with the Prelude and Liebestod from Wagner’s greatest love story, Tristan and Isolde. The second offering on the program is music by Bizet, the &lt;/p&gt;\\n"
      }
    ]
  },
