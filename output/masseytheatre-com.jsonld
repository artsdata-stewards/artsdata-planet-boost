    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Tiffany Reid: Sea in Me"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Artist Statement: As humans we are fascinated by the ocean. There is such beauty in its calming presence, powerful momentum, and unpredictable force. Water inspires, intimidates, and humbles the human spirit. It creates peace and wonder all at the same time speaking to our sense of taste, touch, and hearing. You can’t help but elicit &lt;/p&gt;\\n"
      }
    ]
  },
