    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Like Buttah: The Barbra Streisand Tribute Show"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;PRESENTED BY MICHAEL VAN DEN BOS Few figures in today’s world of entertainment have earned the hallmark of &quot;living legend.&quot; However, one performer virtually owns that label, whose remarkable award-winning career spans six decades of stage, screen, and recording work: singer, actress, and film director Barbra Streisand. Classic film scholar Michael Van Den Bos returns &lt;/p&gt;\\n"
      }
    ]
