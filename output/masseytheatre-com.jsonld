    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "A NEW PLAY People with Disabilities Transforming Attitudes about and Experiences with Employment Collectively created by artists with disabilities and the team that brought you Romance, Relationships & Rights! ABOUT THE PLAY: People with disabilities deserve to work! Follow the dramatized stories of individuals with disabilities (self-advocates) and their experiences navigating employment. Get a glimpse […]"
      }
