    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Beneath the Surface by Jerry Stochansky"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;The exhibition features a series of photographs that are part of the artist’s ongoing practice of burying film in the ground and allowing it to decay, symbolizing the impermanence of everything around us. It shows the transformation of the former image into something new that stands on its own with remnants of the original image. &lt;/p&gt;\\n"
      }
    ]
  },
