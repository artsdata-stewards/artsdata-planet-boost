    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Canadian Superstars: A Tribute to Michael Buble and Celine Dion"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Moon Coin Productions Presents the ‘Canadian Superstars’ celebrating the music of Canada’s 2 biggest Stars, Celine Dion &amp; Michael Buble’! Coming to The Massey Theatre on Saturday Dec 7, 2019! The show stars the charismatic Adam Lucas as Michael Buble’ and powerhouse vocalist Tiffany Desrosiers as Celine Dion. Together with a full live band and &lt;/p&gt;\\n"
      }
    ]
