    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Elvis and The Rise of Rock &#038; Roll"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;PRESENTED BY MICHAEL VAN DEN BOS Inspired by the enormously popular multi-Academy Award nominated 2022 biopic Elvis directed by Baz Lurhmann and starring Austin Butler, classic film scholar Michael Van Den Bos presents an epic exploration of Elvis Presley’s comet-streaking musical career by way of film and vintage T.V. clips. Elvis’s emergence at the forefront &lt;/p&gt;\\n"
      }
    ]
  },
