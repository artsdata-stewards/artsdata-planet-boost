      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Presented by NWSS Dance Join the NWSS Dance program as they celebrate almost 20 years of Dance Shows at the Massey Theatre! &nbsp; Senior Dancers Present &quot;Wreck-It Ralph&quot;. Arcade-game character Wreck-It Ralph is tired of always being the “Bad Guy”. After decades of seeing all the glory go to his “Good Guy” opponent, Fix-It Felix, Ralph &lt;/p&gt;\\n"
      }
    ]
