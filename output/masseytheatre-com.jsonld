    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Ticket prices: Adults $55 (plus s/c) Seniors/Youth $45 (plus s/c) BUY TICKETS Pre-order your refreshments for pre-show and intermission here! &nbsp; Presented by Ice Cap Entertainment Attention Beatles fans! Join us Tuesday May 27 at 7:30pm at Massey Theatre in New Westminster. Travel through time - From early Ed Sullivan to Let it be, you’ll &lt;/p&gt;\\n"
      }
    ]
