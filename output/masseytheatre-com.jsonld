    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Presented by Paquette Productions &quot;Legends Show&quot; brings you some of North America\\'s most exciting performers live on stage. Accompanied by the “Rockin’ Royals Band”, this show will feature the most incredible Tributes to Hank Williams, Johnny Cash, Roy Orbison and Elvis Presley. Hank Williams: starring Zachary Stevenson. More than a country singer, Hank Williams was &lt;/p&gt;\\n"
      }
