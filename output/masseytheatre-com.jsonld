    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Presented by: Paquette Productions DIRECT FROM THE UK! Following an incredible sold out tour, Walk Right Back returns to stages in 2024 by popular demand. From the producers of smash hit show That’ll Be The Day, this phenomenal production tells the story of the most successful musical duo of all time – The Everly Brothers. […]"
      }
