    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Shaun Majumder&#8217;s HATE Tour"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;The Massey Theatre and Laughter Zone 101 present award winning actor and comedian Shaun Majumder for his newest standup show, HATE. In HATE, Shaun uses his quick wit to tackle distressing themes of intolerance and prejudice with unrelenting humour. Shaun hails from Burlington, Newfoundland (population 350). He has starred in the Farrelly Brothers Fox comedy Unhitched in &lt;/p&gt;\\n"
      }
    ]
