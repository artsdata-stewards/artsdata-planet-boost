    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "The Sounds of Christmas | Massey Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "New Westminster’s most popular Christmas concert returns to Massey Theatre again this year. The Vancouver Welsh Men’s Choir and Winter Harp combine to provide a magical celebration of the Christmas season. Music songs and stories to invoke a concert of traditional Christmas memories."
      }
    ],
