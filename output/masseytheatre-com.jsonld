    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Tiffany Reid: Sea in Me | Massey Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Artist Statement: As humans we are fascinated by the ocean. There is such beauty in its calming presence, powerful momentum, and unpredictable force. Water inspires, intimidates, and humbles the human spirit. It creates peace and wonder all at the same time speaking to our sense of taste, touch, and hearing. You can’t help but elicit […]"
      }
    ],
