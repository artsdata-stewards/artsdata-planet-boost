    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "NWSS Music&#8217;s Annual Winter Concert"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;New Westminster Secondary School Music Department presents NWSS Music’s Annual Winter Concert New Westminster Secondary School Music Department\\'s biggest event of the year! Featuring concert bands, jazz bands, a mass choir and strings! Don’t miss this last chance to see what musical pursuits these high school students have explored through the year. Alumni are invited &lt;/p&gt;\\n"
      }
    ]
  },
  {
