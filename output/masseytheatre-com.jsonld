    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Cuba Vibra! | Massey Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Cuba sings, dances and lives! This show highlights in an attractive, colorful and dynamic way, a tour of Cuba, its roots, its dances and its music; protagonists of the precise movement and the incalculable cadence: bulerías, seguidilla, chachachá, mambo, rumba, conga, bolero, feeling, all the rhythms that make the heart vibrate and fill the soul. […]"
      }
    ],
