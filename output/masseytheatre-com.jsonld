    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "La Mére/Idylle"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;We often live in a world of carefully assembled identities and projections. We smile and tell certain stories in certain ways. Our interior realities can be more challenging (and hold so much more potential), should we have the opportunity to examine and give them weight and form. La Mére/Idyll is a series of paintings that challenge &lt;/p&gt;\\n"
      }
    ]
  },
