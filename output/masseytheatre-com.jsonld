    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Australian Bee Gees Show &#8211; A Tribute to the Bee Gees"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Presented by Paquette Productions Direct from Las Vegas! It\\'s Saturday Night Fever every night with &quot;The Australian Bee Gees Show - A Tribute to the Bee Gees&quot;. One of the most successful and adored acts in musical history is recreated live in concert. You\\'ll hear hits like, &quot;Staying Alive&quot;, &quot;You Should Be Dancing,&quot; &quot;How Deep &lt;/p&gt;\\n"
      }
    ]
  },
