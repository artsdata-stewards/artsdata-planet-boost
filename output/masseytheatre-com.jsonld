    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;The VSO Holiday tradition returns with singing, storytelling, and plenty of holiday cheer. Join conductor Karl Hirzer and host Christopher Gaze for this festive favourite. Shows December 4th at 4:00 pm and December 4th at 7:30 pm&lt;/p&gt;\\n"
