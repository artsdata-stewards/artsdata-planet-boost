    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Last Monday at the Movies: The Woman Who Loves Giraffes"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;In 1956, four years before Jane Goodall ventured into the world of chimpanzees and seven years before Dian Fossey left to work with mountain gorillas – in fact, before anyone, man or woman had made such a trip – 23-year-old Canadian biologist, Anne Innis Dagg, made an unprecedented solo journey to South Africa to become &lt;/p&gt;\\n"
      }
    ]
  },
