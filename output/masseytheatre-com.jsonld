    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Ticket prices: Student: $22 (plus s/c) General Admission: $27 (plus s/c) BUY TICKETS &nbsp; Presented by PULSE Dance Centre Get ready for an unforgettable evening as PULSE Dance Centre proudly presents our General Program Year End Recital! We are bursting with pride for every dancer and can’t wait to share these spectacular moments with you! &lt;/p&gt;\\n"
      }
