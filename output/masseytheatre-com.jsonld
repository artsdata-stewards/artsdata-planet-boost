    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;A woman who has a talent for assembling jigsaw puzzles sneaks away from her suburban town and goes to New York City, where she partners with a man for a puzzle tournament in Atlantic City. As she experiences independence for the first time, she begins to view her value and the pieces of her own &lt;/p&gt;\\n"
      }
