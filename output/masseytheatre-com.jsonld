    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Royal City Musical Theatre presents Crazy for You"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;For its 31st season, Royal City Musical Theatre presents: Crazy For You. The story in a nutshell: stage struck Bobby Child (Todd Talbot) works as a banker but has a desire to be a singer/dancer on Broadway and spends his off hours practicing dance routines. He is sent to Nevada to foreclose on a theatre &lt;/p&gt;\\n"
      }
    ]
