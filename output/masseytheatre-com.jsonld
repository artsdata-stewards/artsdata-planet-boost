    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;CONTENT WARNING: The Heterosexuals contains some light cursing and sexual content. This is a 14+ event. Written &amp; Performed By Johnnie McNamara Walker Tour-de-force writer/performer Johnnie McNamara Walker presents his newest, most personal, and most provocative solo show to date: a deep-dive into the shocking world of Heterosexuality! THEY WALK AMONG US! But where did &lt;/p&gt;\\n"
      }
