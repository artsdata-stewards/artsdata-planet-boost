    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Open Space Saturdays: Kin Balam"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;The first performance as part of Open Space Saturdays is Kin Balam. This performance takes place outdoors on the Massey Theatre outdoor space. Kin Balam, the path of the jaguar (Indigenous Maya/Lenca) is an unprecedented, groundbreaking musical project of world music, comprising of virtuoso Flamenco guitar, Afro Latin rhythms, Indigenous (Meso-American) instrumentation, Hip Hop of &lt;/p&gt;\\n"
      }
    ]
