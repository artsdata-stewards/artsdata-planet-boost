    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Vancouver Thunderbird Chorus 70ish Anniversary Celebration"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;The Vancouver Thunderbird Chorus proudly presents their  70ish Anniversary Celebration highlighted by the championship Lions Gate Chorus, our own 2nd Inversion Quartet, the Thunderbird Chorus and featuring from Stockholm Sweden the 2012 World Champion Quartet, The Ringmasters. It promises to be an evening of outstanding harmony and the joy of singing. All safety regulations in &lt;/p&gt;\\n"
      }
    ]
