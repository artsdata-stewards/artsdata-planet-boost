      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Hosted by Massey Theatre Artist-in-Residence Allan Morgan and his Drag Team, this interactive screening will let you experience the cult classic film like never before. The hosts will lead sing-a-longs to the sick’ning soundtrack, re-enact iconic moments live during the film, and bring the Massey Theatre auditorium to fabulous life with interventions and activations that &lt;/p&gt;\\n"
      }
    ]
