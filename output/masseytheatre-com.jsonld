    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Metis Pairing by Nicci Battilana and Monique Hurteau | Massey Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Presented in partnership with Savage Society, Métis Pairing highlights local Indigenous artists Nicci Battilana and Monique Hurteau, who work in an eclectic variety of mediums and styles. The vibrant exhibition combines an exciting array of colours, forms, and textures to create a stunning visual feast which will shatter preconceived notions about Métis art and expression."
      }
    ],
    "http://ogp.me/ns#url": [
