    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "New Westminster Symphony Orchestra: Do I Hear a Waltz?"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;The New Westminster Symphony kicks off its 76th consecutive season with “Do I Hear A Waltz?’ and Other Dance Classics ; a concert of music that according to Symphony President John Davies will have you at least tapping your toes if it doesn’t have you out of your seat and dancing. Maestro Jin Zhang has &lt;/p&gt;\\n"
      }
    ]
  },
  {
    "@id": "https://www.masseytheatre.com/event/metis-pairing-by-nicci-battilana-and-monique-hurteau/",
    "http://ogp.me/ns#locale": [
