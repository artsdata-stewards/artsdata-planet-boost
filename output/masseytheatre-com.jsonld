    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;PRESENTED BY NWSS MUSICAL THEATRE Once upon a time in a land far, far away, there lived a green ogre who was seemingly happy. However, when a life-changing journey introduces him to a princess, a best friend, and a few misfits during his travels, he discovers what true happiness actually is. Shrek the Musical explores &lt;/p&gt;\\n"
      }
