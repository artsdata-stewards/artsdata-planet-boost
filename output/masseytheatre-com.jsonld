    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Tri-City Dance Centre FINALE 2023"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Presented by Tri-City Dance Celebrating 24 years of dance! Join us on June 3 at 2pm or 6pm as our dancers ages 4-18 perform ballet, jazz, lyrical jazz, tap, hip hop, acrobatics, musical theatre and contemporary routines!&lt;/p&gt;\\n"
      }
    ]
  },
  {
