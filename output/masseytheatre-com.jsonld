    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "A Toast To 75 Years"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;On December 16, 1949, the first performance was on the Massey Theatre stage and what a day it was! We will be having a community gathering to kick off a year of celebrations of 75 years of Massey Theatre on December 16. From 6-9pm, the Makers Alley will be open featuring local artisan and makers &lt;/p&gt;\\n"
      }
    ]
  },
