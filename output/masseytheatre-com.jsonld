    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;MASSEY PRESENTS Tom Jackson-Stories Songs and Santa Causes Tom Jackson kickstarts the holiday season with grace, style, and quirky festivity that many have enjoyed for decades. Expect an evening of original music, sing-along tunes, and signature Christmas music from this master storyteller. Tom has travelled coast to coast to coast with The Huron Carole for &lt;/p&gt;\\n"
      }
