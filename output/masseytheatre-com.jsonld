    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;The year is 1613, and Shakespeare is acknowledged as the greatest writer of the age. But disaster strikes when his renowned Globe Theatre burns to the ground. Devastated, Shakespeare returns to Stratford, where he must face a troubled past and a neglected family. Haunted by the death of his only son, Hamnet, he struggles to &lt;/p&gt;\\n"
      }
    ]
