    "http://schema.org/name": [
      {
        "@value": "Les Illusionnistes  - Récital de magie"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Rescapé d’un music hall des années 20, un couple de télépathes dysfonctionnel livre un croisement unique de prouesses de magie actuelle et d'un concert de femme-orchestre aux instruments inusités. Lévitations, disparitions, évasion et télépathie: un duo captivant, classique et spectaculaire qui saura envouter toute la famille!"
      }
    ],
