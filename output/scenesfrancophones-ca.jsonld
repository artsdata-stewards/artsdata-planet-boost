    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://scenesfrancophones.ca/spectacles/quen-dit-raton-aureo-et-lunette-12122"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Qu'en dit raton? - Auréo et Lunette"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Monsieur Crapulet, marchand avare et cupide, vend paisiblement ses légumes au marché, jusqu’au jour où le Docteur Alèse s’installe à côté de son kiosque pour vendre ses « boissons énergisantes ». Alarmé à la perspective de sa ruine, Crapulet cherche par tous les moyens à se débarrasser de ce nouvel arrivant. Jusqu’où ira-t-il? Inconscient de cette menace, le Docteur Alèse espère trouver en ces lieux les solutions à ses soucis. Auréo, son fils, aimerait bien l’aider lorsqu'il croise Lunette, fille de Crapulet, qui rompt sa solitude. Les enfants réconcilieront-ils leurs parents rivaux?"
      }
    ],
    "http://schema.org/isAccessibleForFree": [
      {
        "@value": "True"
      }
    ],
