    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://scenesfrancophones.ca/spectacles/justin-guitard-de-nature-mature-12158"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Justin Guitard -"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Justin Guitard est de retour au printemps 2026 avec un nouvel album, son troisième en carrière. Après avoir exploré les thèmes de l’image de soi et avoir exprimé l’envie de demeurer jeune toute sa vie, l’artiste assume maintenant pleinement son âge et la maturité qui vient avec…ou pas ! Ses fidèles complices de toujours seront de la partie et Justin vous prépare un troisième spectacle qui comprendra les grands succès de ses deux premiers albums, mais aussi plusieurs nouvelles chansons de son plus récent album à venir au printemps."
      }
    ],
    "http://schema.org/isAccessibleForFree": [
      {
        "@value": "True"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
