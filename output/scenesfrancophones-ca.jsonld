    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://scenesfrancophones.ca/spectacles/cirque-kalabante-afrique-en-cirque-8809"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Cirque Kalabanté -"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Le spectacle Afrique En Cirque symbolise la force, l'agilité et la joie de vivre de la jeunesse africaine. Une poignée d'acrobates audacieux, accompagnés de leurs musiciens, évoluent au rythme trépidant des djembés de Guinée avec des chorégraphies et des acrobaties authentiques et originales. Au son mélodieux de la kora, Yamoussa Bangoura nous transporte dans un lieu où la diversité des arts traditionnels africains est mise en lumière et combinée à la virtuosité d'un spectacle de cirque moderne nord-américain.\r\n\r\nKalabanté Productions a été créé par Yamoussa Bangoura, un artiste multidisciplinaire d'origine guinéenne. Le rêve à long terme de Yamoussa était de fonder une école des arts du cirque et de diriger sa propre compagnie multidisciplinaire spécialisée dans les arts africains. En tant que directeur de la compagnie, il développe ses propres spectacles qui, depuis plusieurs années, attirent de plus en plus l'attention et la reconnaissance de la communauté des arts du cirque du Québec et du monde entier."
      }
    ],
    "http://schema.org/isAccessibleForFree": [
      {
        "@value": "True"
      }
    ],
