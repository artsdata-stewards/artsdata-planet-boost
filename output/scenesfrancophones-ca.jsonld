      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Créations In Vivo - Vaches, the musical"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Comédie musicale féministe, PATENTEUSES revisite avec humour le centenaire de La Patente, un ordre secret catholique masculin fondé en 1926 en Ontario français pour défendre le français entre hommes. Dans un style campy-country-pop, des femmes s’organisent autrement et transforment la tradition en fête collective, où elles font entendre leurs propres patentes. Entre cabaret rural, stand-up et satire politique, le spectacle célèbre une réécriture joyeuse, queer et intergénérationnelle du pouvoir. Parce qu’il est temps de faire du bruit autrement."
      }
    ],
    "http://schema.org/isAccessibleForFree": [
      {
        "@value": "True"
      }
    ],
