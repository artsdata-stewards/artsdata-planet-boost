    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://scenesfrancophones.ca/spectacles/michel-rivard-apres-va-ou-12371"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "MICHEL RIVARD -"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Durant les deux semaines ( symboliques ) que dure la magnifique floraison du magnolia qui illumine la fenêtre de sa chambre, «l'homme qui me ressemble» ( 74 ans ) se questionne sur sa vie, avant et après la mort, en confrontant ses doutes et ses certitudes.\r\n\r\n Entre un rendez-vous médical et le choix d'une urne dans un catalogue, entre un premier amour et une marche en forêt avec son petit-fils de sept ans, «l'homme qui me ressemble» monologue, poétise et chante sa recherche du «plus-grand-que-soi»."
      }
    ],
    "http://schema.org/isAccessibleForFree": [
      {
        "@value": "True"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
