    "http://schema.org/name": [
      {
        "@value": "Buscadero -"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Un nouveau groupe de musique BUSCADERO, émerge de la scène artistique offrant une prise moderniste sur la musique country. Fondé par quatre musiciens talentueux, Brandon Girouard, Maxime Renaud, Noah Rivard et Martin Rocheleau ce quatuor dégage une énergie exceptionnelle sur la scène. Leurs rythmes entraînants, sons distinctifs et paroles évocatrices vous réservent une soirée inoubliable, avec l'avenir prometteur devant eux, BUSCADERO continue de repousser les frontières de la musique country."
      }
    ],
    "http://schema.org/isAccessibleForFree": [
      {
        "@value": "True"
      }
    ],
