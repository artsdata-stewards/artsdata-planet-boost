    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://scenesfrancophones.ca/spectacles/francois-massicotte-massicotte-80-12055"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Francois Massicotte - Massicotte 8.0!"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "François Massicotte, l’humoriste établi apprécié de tous qui cumule plus de 35 ans d’expérience en humour, est de retour sur scène avec son 8e one-man-show : 8.0!\r\n\r\nAvec son sens du timing unique, François aborde des thèmes unificateurs à travers lesquels tous se reconnaissent, tels que la famille, le couple, la parentalité, la vieillesse et plus encore, avec humour et dérision. À travers ses aventures et histoires savoureuses, ce père de cinq enfants nous entraîne dans le tourbillon de la famille moderne avec son énergie scénique contagieuse! Doté d’un talent naturel, François s’assume, s’anime et nous transporte dans le tourbillonnement fou de la vie contemporaine. 8.0!, pour se reconnaître et en rire!"
      }
    ],
    "http://schema.org/isAccessibleForFree": [
      {
        "@value": "True"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
