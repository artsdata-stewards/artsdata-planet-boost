      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Waahli"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Waahli est un artiste montréalais d’origine haïtienne dont la musique est un vibrant mélange de hip-hop, afrobeat, reggae et funk haïtien. Sa démarche artistique singulière est profondément ancrée dans ses origines et son identité plurielle. Il interprète ses chansons en anglais, français et créole haïtien. Sur scène, il est accompagné de 3 musiciens avec qui il partage une complicité exceptionnelle, créant une énergie contagieuse. Il ne se contente pas de livrer une performance musicale : il interagit avec son public, l’invite à participer et à vivre une expérience inoubliable."
      }
    ],
    "http://schema.org/isAccessibleForFree": [
      {
        "@value": "True"
      }
