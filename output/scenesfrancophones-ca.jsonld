      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Boucar Diouf -"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Vous ne verrez plus la cohabitation entre le chien, le chat et l’humain de la même façon après avoir assisté au spectacle de Boucar Diouf intitulé Trois prédateurs et un bungalow. Ici, la biologie rencontre l’histoire et la culture dans une exploration à la fois drôle, instructive et touchante. Vous sortirez du spectacle la rate bien dilatée en vous disant: «Je ne verrai plus le chien et le chat de la même façon.»"
      }
    ],
    "http://schema.org/isAccessibleForFree": [
      {
        "@value": "True"
      }
    ],
