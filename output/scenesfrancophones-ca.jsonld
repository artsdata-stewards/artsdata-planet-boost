    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://scenesfrancophones.ca/spectacles/jessy-lindsay-12640"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Jessy Lindsay - J'explose"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "La franco-ontarienne Jessy Lindsay vous propose un spectacle pop-groovy entraînant et rafraîchissant qui inspire tout public à danser librement au battement de leur propre coeur. Ses paroles authentiques et mélodies accrocheuses incitent une réflexion sur les réalités actuelles des jeunes femmes queers. Elle explore, en particulier les thèmes d'identité, l'appartenance, la réclamation de soi et le « queer joy ». Ce spectacle férocement groovy marque le début d’une époque remplie de confiance, d’écoute de soi et de musique libératrice pour l’artiste. Plongez vivement dans son univers coloré !"
      }
    ],
    "http://schema.org/isAccessibleForFree": [
      {
        "@value": "True"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
