      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://scenesfrancophones.ca/spectacles/grand-poney-onoff-11924"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Grand Poney - ON/OFF"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "ON / OFF met en scène un quintette d'interprètes en action sur un dispositif étonnant, un tapis de course. Cinq interprètes évoluent dans un espace restreint où le mouvement devient à la fois contraint et spectaculaire. Le spectacle explore des thèmes tels que le dépassement de soi, la liberté, l’identité, le vivre-ensemble et la complexité des émotions humaines. Le tapis symbolise le passage de l’enfance à l’âge adulte. Les interprètes, tantôt en maîtrise, tantôt dépassés, cherchent leur place dans le monde à travers un dialogue constant entre corps, machine et espace."
      }
    ],
    "http://schema.org/isAccessibleForFree": [
      {
        "@value": "True"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
