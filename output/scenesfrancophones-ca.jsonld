      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Waahli -"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Waahli est un artiste montréalais d’origine haïtienne qui puise son inspiration dans une enfance bercée par les mélodies traditionnelles. C’est toutefois à travers la culture hip-hop qu’il trouve pleinement sa voix et développe un style unique et captivant. Avec ses rythmes ancestraux, ses performances électrisantes et ses textes incisifs, Waahli propose un hip-hop alternatif qui fait voyager aux quatre coins du monde. Sur scène, il captive le public par son énergie contagieuse, sa présence généreuse et sa célébration de la diversité culturelle."
      }
    ],
    "http://schema.org/isAccessibleForFree": [
