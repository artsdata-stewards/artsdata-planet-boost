  {
    "@id": "https://www.gabriolatheatrecentre.ca/event-details-registration/sixpoints",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Sixpoints | Gabriola Theatre Cen"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Join us for a night of creativity and dancing! Sixpoints is an immersive mix of electronica and live music with an intense performance of vocal art forms. Opening with the Gabriola Micro Synth Orchestra and closing with the awesome dance beats of DJ Ron Sakolsky and his Fools Paradise Sound System."
      }
    ],
