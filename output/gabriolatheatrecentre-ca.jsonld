    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "“Hansen turns anything and everything into a puppet and makes it funny.”  Watch as Ingrid Hansen performs a live puppet film before your very eyes, using only household objects, a camera, and her bare hands.  &#010;Thank you to the Port Theatre for Sponsorship of Epidermis Circus and The Baby Tyler Show"
      }
