    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Ta Daa The Elf Christmas Show"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Ta Daa the Elf is a gentle, fun-loving, elf who sings, dances, tap dances and mimes her way through all sorts of crazy antics. Ta Daa talks on a cell a &quot;hot line&quot; to Santa. He asks the audience to sing his favourite songs like ‘Red Sock Soup’ and ‘Rudolph the Red Nosed Reindeer” "
      }
    ],
