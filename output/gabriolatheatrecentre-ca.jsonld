  {
    "@id": "https://www.gabriolatheatrecentre.ca/event-details-registration/naomi-shore",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Naomi Shore | Gabriola Theatre Cen"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "<p>Naomi Shore is an indie-folk, singer songwriter from Northern BC. Her live performances are both contemplative and clever; vulnerable songwriting is buoyed by surging vocals as smooth and full as deep water. After seven years as one half of the Western Canadian Award winning folk roots duo ‘Twin Peaks’ Naomi is now touring her solo project and promoting her second full length record ‘Stability’.</p>\n<p></p>\n<p>For this storyteller, crafting music has become more than her trade, it’s a way to process her life, to send a searching hand out through the mists of a melody and connect with the world.</p>"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://static.wixstatic.com/media/c5d671_709ebb47aee34c07b736e441bdb3747a~mv2.jpg/v1/fill/w_3600,h_2400,al_c,q_90/c5d671_709ebb47aee34c07b736e441bdb3747a~mv2.jpg"
      }
    ],
