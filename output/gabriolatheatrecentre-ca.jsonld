    "@id": "https://www.gabriolatheatrecentre.ca/event-details-registration/transgender-day-of-visibility",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Transgender Day of Visibility  | Gabriola Theatre Cen"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Transgender + non-binary people & their allies invite you to attend TDOV 2026!\nThrough music, art, and spoken words the Transgender community will share their many contributions to this world. \nTogether as a community we can honour inclusivity by simply showing up with an open heart and open mind!"
      }
