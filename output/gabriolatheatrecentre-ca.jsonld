  {
    "@id": "https://www.gabriolatheatrecentre.ca/event-details-registration/ta-daa-the-elf-christmas-show",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Ta Daa The Elf Christmas Show | Gabriola Theatre Cen"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "Ta Daa the Elf is a gentle, fun-loving, elf who sings, dances, tap dances and mimes her way through all sorts of crazy antics. Ta Daa talks on a cell a \"hot line\" to Santa. He asks the audience to sing his favourite songs like ‘Red Sock Soup’ and ‘Rudolph the Red Nosed Reindeer”"
      }
    ],
