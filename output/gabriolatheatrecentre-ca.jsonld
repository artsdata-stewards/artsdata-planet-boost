    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "The Unfaithful Servants have gained a reputation in Western Canada as a must-see act. With an original and exciting approach to acoustic music, the group serves up explosive instrumentals, compelling story-telling and high-powered vocals."
