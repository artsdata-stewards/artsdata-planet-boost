  {
    "@id": "https://www.gabriolatheatrecentre.ca/event-details-registration/citizen-chen",
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Citizen Chen | Gabriola Theatre Cen"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "One Immigrant. One Mic. \nOne Hell of a Story.\n\nGTC is proud to present Citizen Chen as part of May’D on Gabriola!\n\nKicking off Citizen Chen’s Island Tour and launching Scarlet for her 24 Edinburg Fringe shows ! We could not be more proud! Supporting local artists makes everything we do more special!"
      }
    ],
