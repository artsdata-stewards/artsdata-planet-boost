    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "La pièce qui tourne mal"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "L’humour britannique s’invite au TNM! Après avoir conquis les publics londoniens, puis new-yorkais, la version française de The play that goes wrong de Henry Lewis, Jonathan Sayer et Henry Shields, s‘amène sur notre scène à l’été 2026. Avec cette pièce, les producteurs André Robitaille et Mario Provencher ont réussi le coup de maître de présenter au public québécois LE SPECTACLE qu’ils rêvaient de produire. La traduction de ce classique de la comédie anglaise a été confiée à Normand Chouinard et sera dirigée par André Robitaille."
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
