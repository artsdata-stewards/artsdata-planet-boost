    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Classique(s)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Les classiques sont-ils condamnés à n’être que de somptueux tombeaux culturels ? Faut-il les dynamiter pour que leurs éclats tranchent dans le vif du réel ? Une création de Fanny Britt et Mani Soleymanlou, produite par Théâtre du Nouveau Monde, Orange Noyée et Théâtre français du CNA, avec la collaboration de Le Diamant."
      }
    ],
