  {
    "@id": "https://tnm.qc.ca/2024-2025/une-fete-denfants",
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Une fête d'enfants | Théâtre du Nouveau Monde"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Michel Marc Bouchard confie au metteur en scène Florent Siaud sa plus récente création, portée par les talents redoutables d’un trio électrisant : François Arnaud, Iannicko N’Doua et Sylvie Drapeau."
      }
    ],
