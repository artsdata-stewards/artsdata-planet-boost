      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Abonnement | Saison 2025-2026"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Cette ultime saison programmée par Lorraine Pintal s’articule comme une grande fresque sociale, afin de rejoindre les préoccupations d’une société appelée à se réinventer."
      }
    ],
