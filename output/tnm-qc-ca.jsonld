    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Afin de donner toute son ampleur à cette production d’une exceptionnelle envergure, dix-sept interprètes de tous horizons contribuent à lui donner sa pleine et nécessaire dimension épique."
      }
