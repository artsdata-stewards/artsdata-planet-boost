    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://tnm.qc.ca/2025-2026/que-notre-joie-demeure%23"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Que notre joie demeure"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "En portant à la scène le roman de Kev Lambert, Maxime Carbonneau et Laurence Dauphinais donnent une urgence aux questions brutales qu’il soulève. Et pour incarner la fascinante Céline Wachowski : nulle autre qu’Anne Dorval!"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr"
      }
    ],
    "http://schema.org/typicalAgeRange": [
      {
        "@language": "fr",
        "@value": "12-99"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "PT3H"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
  {
    "@id": "https://tnm.qc.ca/2024-2025/la-femme-qui-fuit",
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "La femme qui fuit | Théâtre du Nouveau Monde"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Dès sa parution en 2015, le roman biographique d’Anaïs Barbeau-Lavalette a bouleversé des dizaines de milliers de lectrices et de lecteurs… Avec une foisonnante distribution de 19 interprètes, dont Catherine De Léan, Alexia Bürger entreprend un ambitieux travail collectif afin que les corps transforment la scène du TNM en un vaste tableau automatiste."
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://admin.tnm.qc.ca/storage/2024-2025/visuels/spectacles/fond_lafemmequifuit_catherine.jpg"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr",
        "@value": "https://tnm.qc.ca/2024-2025/la-femme-qui-fuit"
      }
    ]
  },
