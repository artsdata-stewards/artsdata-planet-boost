    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://tnm.qc.ca/2025-2026/hosanna-ou-la-sheherazade-des-pauvres%23tournee"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Hosanna ou la Shéhérazade des pauvres"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Aujourd’hui, les drag queens font partie de notre culture populaire. Mais, il y a cinquante ans, qu’est-ce que cela impliquait pour un homme que de se vêtir comme une femme ? En public ! Le metteur en scène Maxime Robin réussit un tour de force : à la fois raconter les avancées fragiles d’un groupe social et l’histoire profondément émouvante d’un homme blessé par ses propres rêves en plus d'avoir l’idée lumineuse d’accorder le rôle d’Hosanna âgé à Luc Provost qui, par son personnage de Mado Lamotte, a fait entrer les drag queens dans notre quotidien."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr"
      }
    ],
    "http://schema.org/typicalAgeRange": [
      {
        "@language": "fr",
        "@value": "14-99"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "PT2H"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
  {
    "@id": "https://tnm.qc.ca/2024-2025/classiques",
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Classique(s) | Théâtre du Nouveau Monde"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Les classiques sont-ils condamnés à n’être que de somptueux tombeaux culturels dans lesquels on ensevelit les spectateurs sous le poids des siècles? Faut-il les dynamiter pour que leurs éclats tranchent dans le vif du réel? Fanny Britt et Mani Soleymanlou en compagnie de Louise Cardinal, Martin Drainville, Kathleen Fortin, Julie Le Breton, Jean-Moïse Martin, Benoit McGinnis et Madeleine Sarr se penchent sur ces questions."
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://admin.tnm.qc.ca/storage/2024-2025/visuels/spectacles/fond_classiques.jpg"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr",
        "@value": "https://tnm.qc.ca/2024-2025/classiques"
      }
    ]
  },
