    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://tnm.qc.ca/2024-2025/deux-femmes-en-or"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Deux femmes en or"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Après l’immense succès connu à La Licorne, voilà que Charlotte Aubin, Isabelle Brouillette, Sophie Desmarais, Steve Laplante et Mathieu Quesnel débarquent au TNM dans cette savoureuse relecture du film culte des années 1970."
      }
    ]
  },
  {
    "@id": "https://tnm.qc.ca/2024-2025/cher-journal",
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Cher journal; une mutation | Théâtre du Nouveau Monde"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Au cœur d’une forêt d’arbres et de racines, de corps substrats champignonesques, comme une plongée impudique dans la psyché de son autrice Pénélope Deraîche-Dallaire, de ses fantasmes et de ses peurs, cette performance révèle un point de vue kaléidoscopique de l’identité d’une personne socialement reconnue comme femme."
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://admin.tnm.qc.ca/storage/social_images/cherjournal_courriel_1200x800.jpg"
      }
    ],
