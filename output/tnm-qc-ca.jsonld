    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "L'auteur et comédien Steve Gagnon, ainsi que  le metteur en scène français Vincent Goethals, qui fréquente la dramaturgie québécoise depuis plus de vingt-cinq ans, ont créé un spectacle envoûtant qui a tout bien enthousiasmé le public en France et au Québec."
      }
    ],
