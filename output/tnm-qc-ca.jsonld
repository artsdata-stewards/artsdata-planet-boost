    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Anne Dorval et Steve Gagnon reviennent sur la scène du TNM pour faire revivre la brûlante histoire d’amour entre Maria Casarès et Albert Camus. EN RAPPEL — Six représentations seulement !"
      }
