    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Macbeth"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Robert Lepage prend à bras-le-corps la traduction québécoise de Michel Garneau et transpose l’action dans l’impitoyable univers des motards. Shakespeare, comme toujours, nous aide à comprendre le monde dans lequel nous vivons. Les motards sont à la fois un produit, un condensé et un miroir grossissant des violences politiques et sociales de notre temps."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr"
      }
    ],
