    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://tnm.qc.ca/2024-2025/othello%23"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Othello"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Pour sa première mise en scène au TNM, Didier Lucien s’attaque à la plus haletante des tragédies de Shakespeare, dans une adaptation de Jean-Marc Dalpé. Il travaillera avec deux remarquables comédiens pour jouer Othello et Iago: Rodley Pitt et Lyndz Dantiste."
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
  {
    "@id": "https://tnm.qc.ca/2024-2025/pierre-lapointe-chansons-demodees-pour-ceux-qui-ont-le-coeur-abime",
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Pierre Lapointe — Chansons démodées pour ceux qui ont le cœur abimé"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Déjà par son titre, le nouveau spectacle de Pierre Lapointe promet. C’est pour accompagner son nouvel album, 10 chansons démodées pour ceux qui ont le cœur abimé qu’il a créé cet écrin magnifique. Des arrangements soignés, un décor déroutant et toujours cette façon singulière qu’il a d’occuper la scène, oscillant sans cesse entre un sens de l’humour corrosif et une puissante charge mélancolique."
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://admin.tnm.qc.ca/storage/social_images/pierre_lapointe_2025_rs.jpg"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr",
        "@value": "https://tnm.qc.ca/2024-2025/pierre-lapointe-chansons-demodees-pour-ceux-qui-ont-le-coeur-abime"
      }
    ]
  },
