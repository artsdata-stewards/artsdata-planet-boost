    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;h3 style=&quot;font-weight: 400;&quot;&gt;&lt;b&gt;&lt;strong style=&quot;font-style: inherit;&quot;&gt;FULL THROTTLE FEVER&lt;/strong&gt;&lt;/b&gt;&lt;/h3&gt;  &lt;h3 style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;&lt;em style=&quot;font-weight: inherit;&quot;&gt;&lt;b&gt;&lt;strong style=&quot;font-style: inherit;&quot;&gt;featuring&lt;/strong&gt;&lt;/b&gt;&lt;/em&gt;&lt;/i&gt;&lt;/h3&gt;  &lt;h3 style=&quot;font-weight: 400;&quot;&gt;&lt;b&gt;&lt;strong style=&quot;font-style: inherit;&quot;&gt;PUNCH DRUNK CABARET&lt;/strong&gt;&lt;/b&gt;&lt;/h3&gt;  &nbsp;  &lt;p style=&quot;font-weight: 400;&quot;&gt;Outkasts Car Club car show - 6:00-8:30                                                                                                                                            Boneyard Racers - 9:00                                                                                                                                                                          Punch Drunk Cabaret 9:30&lt;/p&gt;    &lt;h4 style=&quot;font-weight: 400;&quot;&gt;Why just watch a show when you can become part of it? Punch Drunk Cabaret is a high energy mix of rockabilly swing, glam blues and 80&#039;s era anthemic rock, where the audience can expect spirited sing-a-longs.&lt;/h4&gt;  &lt;h4&gt;They are a MANLUK THEATRE favorite!!!&lt;/h4&gt;  &lt;h4&gt;This multi-award winning, festival favourite is touring in support of their latest single, &lt;i&gt;&lt;em style=&quot;font-weight: inherit;&quot;&gt;Shot Out From a Cannon&lt;/em&gt;&lt;/i&gt; with a string of festival dates across Western Canada.   This year, as part of the NASCAR excitement at Edmonton International Raceway (Wetaskiwin location) PDC will perform FULL THROTTLE FEVER and the theme for this year&#039;s show is cars!!!&lt;/h4&gt;  &lt;h4 style=&quot;font-weight: 400;&quot;&gt;But wait, there will be more... you will see the Award Winning Short Film BONEYARD RACERS on the Big Screen with the music of PUNCH DRUNK CABARET on the soundtrack!&lt;/h4&gt;  Tickets $32"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "PUNCH DRUNK CABARET - FULL THROTTLE FEVER!  - Summer Event"
      }
    ],
