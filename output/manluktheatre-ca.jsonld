      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://manluktheatre.ca/whats-on/princesses-414-735-109-262-319-881-481-622-751-772-526/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://manluktheatre.ca/whats-on/princesses-414-735-109-262-319-881-481-622-751-772-526/"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;div dir=&quot;ltr&quot;&gt;    Join us for this community-wide screening of the award-winning film &lt;em&gt;Kímmapiiyipitssini: The Meaning of Empathy.&lt;/em&gt; Don&#039;t miss this community gathering around one of the most urgent issues in Wetaskiwin. The film will begin at 6:30 pm but we encourage you to arrive earlier for snacks and refreshments.    The film follows filmmaker Elle-Máijá Tailfeathers as she creates an intimate portrait of her community and the impacts of the drug poisoning epidemic. Witness the change brought by community members, first responders and medical professionals as they struggle against the ongoing substance-use crisis.    6:00 pm - Doors open, snacks, and refreshments  6:30pm - Introduction and film  8:30pm - Panel discussion and audience Q + A    &lt;/div&gt;"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Story Money Impact Film Debut"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
