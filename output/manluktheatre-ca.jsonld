    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Join us as we launch our new season with a bang! On September 23rd, we announce this seasons productions, with an exclusive show of our own. MURDER at the MANLUK will be shown only one time this year. Don't miss your chance to solve the mystery of whodunit. and remember... Love never dies. September 23,"
      }
