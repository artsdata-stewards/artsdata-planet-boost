      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
  {
    "@id": "https://manluktheatre.ca/whats-on/wes-barker-540-674-675-684-916/",
    "https://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "https://ogp.me/ns#site_name": [
      {
        "@language": "en-us",
        "@value": "Manluk Theatre - Manluk Theatre for The Performing Arts"
      }
    ],
    "https://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Bach, Beethoven, And The Beatles – A concert by candlelight - Manluk Theatre"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Experience a magical evening where classical meets iconic. Surrounded by the warm glow of candlelight, a string quartet and pianist breathe new life into the timeless works of Bach and Beethoven—alongside reimagined favourites from The Beatles. A high-class fusion of brilliance and nostalgia. Due to popular demand, we’ve added another Candlelight Show! Our December 6th performance"
      }
    ],
    "https://ogp.me/ns#url": [
      {
