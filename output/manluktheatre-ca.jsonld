    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "We are dancing for the fun of it! Studio-S and its dancers are offering a year end show featuring all of their dances that they have worked on this Season. Come enjoy and celebrate all of their hard work! April 12th at 1:00pm, at the Manluk Theatre."
      }
