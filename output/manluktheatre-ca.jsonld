    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p data-start=&quot;108&quot; data-end=&quot;174&quot;&gt;&lt;strong data-start=&quot;108&quot; data-end=&quot;174&quot;&gt;A Night of Timeless Glamour — The 1920s themed Manluk Theatre Annual Gala&lt;/strong&gt;&lt;/p&gt;  &lt;p data-start=&quot;176&quot; data-end=&quot;471&quot;&gt;Step back into the roaring 1920s for an unforgettable evening of music, elegance, and celebration. Join us in your finest flapper dresses, fedoras, and vintage glamour as the sensational &lt;strong data-start=&quot;363&quot; data-end=&quot;388&quot;&gt;Battle River Big Band&lt;/strong&gt;—an 18-piece big band—fills the room with the bold, brassy sounds of a bygone era.&lt;/p&gt;  &lt;p data-start=&quot;473&quot; data-end=&quot;719&quot;&gt;Sip on classic cocktails, sway to swing and jazz, and be among the first to witness the grand reveal of our upcoming theatre season. This is more than a gala—it&#039;s a dazzling celebration of artistry, community, and the golden age of entertainment.&lt;/p&gt;  &lt;p data-start=&quot;721&quot; data-end=&quot;793&quot;&gt;Let the rhythm carry you away… and don’t forget to dress to impress!&lt;/p&gt;"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "1920’s Gala"
      }
    ],
