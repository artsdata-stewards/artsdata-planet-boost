    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "When Willie MacCrimmon, cobbler and bereaved widower, muses aloud that he would give anything to skip his curling team in the MacDonald Brier, the devil (A traveling salesperson who deals in wholesale souls and retail sin) suddenly appears an makes him an offer. Wullie makes a counter offer, and one of the greatest matches in"
      }
