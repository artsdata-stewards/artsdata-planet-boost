    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "MARANGO PIE - Manluk Theatre"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "JANUARY 15, 2023 MALANKA featuring: Marengo Pie! We're going to start the year 2023 by celebrating Malanka with our first concert! Join us for Malanka! Enjoy the music of Marango Pie in celebration of Ukrainian New Year - MALANKA! Malanka (Ukrainian New Year’s Eve) is traditionally celebrated in the middle of January. It is rich in"
      }
    ],
