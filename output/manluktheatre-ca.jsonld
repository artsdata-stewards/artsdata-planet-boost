    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p data-start=&quot;108&quot; data-end=&quot;174&quot;&gt;Twilight Time celebrates the soulful music of the world-renowned legendary group, The Platters as well as performing the top hits of the Doo-wop era.&lt;/p&gt;"
