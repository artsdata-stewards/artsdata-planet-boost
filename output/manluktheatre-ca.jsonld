    "http://schema.org/image": [
      {
        "@id": "https://manluktheatre.ca/wp-content/uploads/2023/08/20231026_152012.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://manluktheatre.ca/whats-on/acapellaafternoon/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://manluktheatre.ca/whats-on/acapellaafternoon/"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;div style=&quot;text-align: center;&quot;&gt;  &lt;p style=&quot;font-weight: 400;&quot;&gt;Acapella Afternoon&lt;/p&gt;  &lt;p style=&quot;font-weight: 400;&quot;&gt;&lt;em&gt;&lt;strong&gt;Grove City Chorus and Chance! Quartet&lt;/strong&gt;&lt;/em&gt;&lt;/p&gt;  &lt;p style=&quot;font-weight: 400;&quot;&gt;‘&lt;strong&gt;Lookin’ for Love?&lt;/strong&gt;’ - &lt;strong&gt;Come and enjoy an afternoon concert filled with the A Cappella Barbershop Harmony of Grove City Chorus, Chance! (women’s quartet) and 4inAccord (men’s quartet), while they explore with you the many-faceted phenomenon of Love&lt;/strong&gt;!&lt;/p&gt;  &lt;p style=&quot;font-weight: 400;&quot;&gt;Grove City Chorus is an extraordinary group of gentlemen who gather together in celebration of their love for barbershop harmony. They currently have a number of enthusiastic members from the greater Edmonton area who meet weekly for a harmony filled, sociable evening preparing for performances and competitions. They are a non-profit chapter of The Barbershop Harmony Society (BHS) open to all men who love to sing and harmonize in the Barbershop A Cappella style of music. For more information or to book them for your event, go to &lt;a href=&quot;https://ebhchorus.ca/&quot; data-saferedirecturl=&quot;https://www.google.com/url?q=https://ebhchorus.ca/&amp;source=gmail&amp;ust=1704992411155000&amp;usg=AOvVaw0hA2hIwP9iRKxKvJUHFZd7&quot;&gt; Edmonton Barbershop Harmony Chorus – aka Grove City Chorus (ebhchorus.ca)&lt;/a&gt;.&lt;/p&gt;  &lt;p style=&quot;font-weight: 400;&quot;&gt;Chance! is a female barbershop quartet from the Edmonton region.  Singing together for over 15 years has provided them wonderfully rewarding, comical and touching experiences. Chance! made them Sisters, Hearts made them Friends, Singing is a gift they give each other; sharing it with an audience is a bonus’. Go to &lt;a href=&quot;https://www.albertanorthernlightschorus.com/quartets/chance&quot; data-saferedirecturl=&quot;https://www.google.com/url?q=https://www.albertanorthernlightschorus.com/quartets/chance&amp;source=gmail&amp;ust=1704992411155000&amp;usg=AOvVaw0v_oyaQ1I9rBBhl6pFt5iu&quot;&gt;Chance Quartet — Alberta Northern Lights Chorus&lt;/a&gt; for more information or to book them for your event.&lt;/p&gt;    &lt;/div&gt;"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Acapella Afternoon"
      }
    ],
