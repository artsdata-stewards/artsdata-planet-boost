      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Gramps and Gran yearn for the romance of their younger days while their daughter-in-law, Paulette, and her husband deal with his lack of interest in the bedroom. Meanwhile, Paulette’s daughter, Jacqui, is being coached by her Aunt Jean on how to dress to attract men. This uproarious comedy provides a social commentary against the background of Valentine’s Day."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Dangers of VD - (Valentines Day)"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
