    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "SPY! Is based on the true story of Spaniard, Juan Pujol Garcia, code named “Garbo”, a secret double agent during World War II. He is called the greatest spy and the greatest liar in history. How did this meek, unskilled chicken farmer become the scourge of the Nazi regime?      He is both James Bond and Inspector Clouseau. His story was classified as top secret for decades after the war. But now his odyssey begs to be told in a hilarious, and gripping world debut musical!"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "SPY! The Glorious Mind of Agent Garbo"
      }
    ],
