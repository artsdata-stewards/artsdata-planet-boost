    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Phoenix Productions takes us on a musical theatre adventure with Maiden Melody and Radical Rhythm as they attempt to save their town from the Sorcerer of Silence. On their quest to the Castle of Composition, they pass through the Dessert of Doo-wop, the Ocean of Opera, and the terrible terrain of Tango, meeting musical friends and foes along the way. Their journey teaches them about new kinds of music, overcoming obstacles, and the importance of working together.    Adult tickets - $15    Childrens tickets - $12    Available show dates:  &lt;ul&gt;    &lt;li&gt;Friday March 14th at 7:00&lt;/li&gt;    &lt;li&gt;Saturday March 15th at 7:00&lt;/li&gt;    &lt;li&gt;Sunday March 16th at 2:00&lt;/li&gt;  &lt;/ul&gt;"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Musicville"
      }
    ],
    "http://schema.org/eventStatus": [
