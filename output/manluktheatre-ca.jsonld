    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Set in a saloon in a western mining camp in the 1850&#039;s, a prospector has hit it rich and hoards his gold. A spunky and rausous musical featuring a mix of jazz, blues, rock, folk and country western styles.    Directed by Marlene Schoonmaker. Music Direction by Barb Ganske.    Event Dates:  Friday, May 3rd at 7:30pm  Saturday May 4th at 7:30pm  Sunday May 5th at 2:00pm (Matinee)  Friday May 10th at 7:30pm  Saturday May 11th at 7:30pm  Sunday May 12th at 2:00pm (Matinee)"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Gold Dust"
      }
    ],
