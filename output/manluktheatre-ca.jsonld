      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Bud \"the stud\" gets his hands on some untested Venusia pills. He attempts to \"entertain\" three women but the gals swap his Viagra with the Venusia and we soon discover that it has a strange effect on men! Directed by Marlene Schoonmaker and Rick Bolstad Event Dates: Friday, November 17th at 7:30pm Saturday November 18th"
      }
    ],
