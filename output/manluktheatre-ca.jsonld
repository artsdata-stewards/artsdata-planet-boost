    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Blackpool is a folk band from Westerose Alberta Canada. Their original and cover material ranges from straight ahead rockin’ country blues to harmonic and lyrical folk songs. Entertaining stories are told about and between songs. This will be an unprecedented afternoon of great entertainment."
      }
    ],
