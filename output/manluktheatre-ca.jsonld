    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;div dir=&quot;ltr&quot;&gt;We are dancing for the fun of it!&lt;/div&gt;  &lt;div dir=&quot;ltr&quot;&gt;Studio-S and its dancers are offering a year end show featuring all of their dances that they have worked on this Season. Come enjoy and celebrate all of their hard work!&lt;/div&gt;  &lt;div dir=&quot;ltr&quot;&gt;April 12th at 1:00pm, at the Manluk Theatre.&lt;/div&gt;"
      }
    ],
