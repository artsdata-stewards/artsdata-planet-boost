        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Join us in the front lobby for a fun, casual night of Karaoke. The Canteen will be open for drinks and snacks, and the lyrics projected onto the front wall - so sing along! From classic favourites to Disney specials to Broadway and beyond, this night is sure to entertain.    The best part - Cover is only $2.    **FAMILY FRIENDLY**    &nbsp;    &nbsp;"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Karaoke Night!"
      }
    ],
