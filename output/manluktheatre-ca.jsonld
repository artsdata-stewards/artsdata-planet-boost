    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Join Margreet van Jansen as she talks about the most difficult time of her life - losing her only child and learning to live with grief. Is life possible after such devastation?    Margreet talks about her personal journey through the darkness back to light. In life both darkness and light are always present – but even during our darkest times, there is light – and life.    Margreet will be launching her newest book, “Life After Vincent.” The afternoon will include book signing and Q&amp;A with the Author."
      }
    ],
