      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;div&gt;&lt;span style=&quot;color: #444444;&quot;&gt;Wes Barker is Canada&#039;s funniest magician! Wild tricks, hilarious stories, incredible feats, and amazing antics. It&#039;s a show like you’ve never experienced. As seen on America’s Got Talent, Ellen, Big Trick Energy, Syfy, MTV, and Penn &amp; Teller: Fool Us (which he won!). Wes will have you laughing at a crazy true story one moment and be blowing your mind the next. He reinvents what it means to be a comedy magician. Come join Wes on a wild and ridiculous ride of amazement, trickery, and moments that leave you thinking What the heck?!&lt;/span&gt;&lt;/div&gt;  &lt;div&gt;&lt;span style=&quot;color: #444444;&quot;&gt; &lt;/span&gt;&lt;/div&gt;  &lt;div&gt;&lt;i&gt;&lt;span style=&quot;color: #444444;&quot;&gt;Coarse language and mature subject matter, Age 16+ Recommended.&lt;/span&gt;&lt;/i&gt;&lt;/div&gt;"
      }
    ],
