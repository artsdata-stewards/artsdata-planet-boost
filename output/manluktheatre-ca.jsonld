    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Set in a saloon in a western mining camp in the 1850's, a prospector has hit it rich and hoards his gold. A spunky and rausous musical featuring a mix of jazz, blues, rock, folk and country western styles. Directed by Marlene Schoonmaker. Music Direction by Barb Ganske. Event Dates: Friday, May 3rd at 7:30pm"
      }
    ],
