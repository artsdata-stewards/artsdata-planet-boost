        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;div dir=&quot;auto&quot;&gt;The Grunch tells the story of Rudy Grunch, a grumpy 6th grader who always feels like an outsider. When the entire school gets excited about the annual school musical, he comes up with a perfect plan to ruin it for everyone; he&#039;ll steal the sets, costumes and lights the night before it opens. Inspired by Dr. Suess&#039;s The Grinch who Stole Christmas, and every musical ever known!!&lt;/div&gt;  &lt;div dir=&quot;auto&quot;&gt;&lt;/div&gt;  &lt;div dir=&quot;auto&quot;&gt;Performed by local youth from Phoenix Academy for Theatre Arts,  this fun musical may just inspire you to join your local community theatre group!!&lt;/div&gt;  &lt;div dir=&quot;auto&quot;&gt;&lt;/div&gt;  &lt;div dir=&quot;auto&quot;&gt;Ticket Prices -&lt;/div&gt;  &lt;div dir=&quot;auto&quot;&gt;ADULT - $22&lt;/div&gt;  &lt;div dir=&quot;auto&quot;&gt;STUDENT - $10&lt;/div&gt;  &lt;div dir=&quot;auto&quot;&gt;CHILD (under 5) - $0&lt;/div&gt;  &lt;div dir=&quot;auto&quot;&gt;SENIORS - $10&lt;/div&gt;"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Grunch - Presented by Phoenix Productions"
      }
    ],
