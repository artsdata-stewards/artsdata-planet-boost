    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p data-start=&quot;140&quot; data-end=&quot;453&quot;&gt;Join us for an unforgettable evening at the Manluk Theatre as we celebrate our past, present, and future with live music, community, and a shared vision for sustainability. Built in 1905 as a coal-burning energy plant, the theatre later moved to hydro power—and now, we’re raising funds to go solar!&lt;/p&gt;  &lt;p data-start=&quot;455&quot; data-end=&quot;856&quot;&gt;This special fundraising event features two incredible bands, Buckshot and The Cod Tongues, performing live for a night of energy, fun, and connection. Tickets are $20 online (+$2 fee) or $20 minimum at the door, with a donation box available for additional contributions. All proceeds will help bring solar power to the theatre and support its ongoing mission as a cultural hub.&lt;/p&gt;  &lt;p data-start=&quot;858&quot; data-end=&quot;991&quot;&gt;Be part of our full circle moment—celebrate history, enjoy amazing music, and help light the way to a brighter, greener future!&lt;/p&gt;"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Full Circle Fundraiser Show"
      }
    ],
