    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p data-start=&quot;108&quot; data-end=&quot;174&quot;&gt;Experience a magical evening where classical meets iconic. Surrounded by the warm glow of candlelight, a string quartet and pianist breathe new life into the timeless works of Bach and Beethoven—alongside reimagined favourites from The Beatles. A high-class fusion of brilliance and nostalgia.&lt;/p&gt;  &lt;p data-start=&quot;134&quot; data-end=&quot;390&quot;&gt;Due to popular demand, we’ve added another Candlelight Show! &lt;br data-start=&quot;202&quot; data-end=&quot;205&quot; /&gt;Our December 6th performance sold out so quickly, we couldn’t resist adding an encore! — join us Sunday, December 7th at 2pm for an unforgettable afternoon of music and magic.&lt;/p&gt;"
      }
    ],
