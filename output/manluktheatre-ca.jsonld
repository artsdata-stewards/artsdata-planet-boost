    "http://schema.org/image": [
      {
        "@id": "https://manluktheatre.ca/wp-content/uploads/2024/02/MICHAEL-BUBLE-SCOTT-KEO-OFFICIAL-2023-PIC.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://manluktheatre.ca/whats-on/twin-flames-278/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://manluktheatre.ca/whats-on/twin-flames-278/"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p style=&quot;font-weight: 400;&quot;&gt;Phoenix based Scott Keo&#039;s jaw dropping ability to duplicate the look, style and sound of Michael Bublé didn&#039;t happen overnight. As a guitar player, drummer and singer, Scott had played both solo and in bands. In 2005, he came across a copy of “Home” by Michael Bublé. He suddenly thought “my own voice is very similar. Scott&#039;s Michael Bublé tribute was a hit out of the box, taking him well beyond weddings, to concerts, festivals, theatres, and eventually to Las Vegas. For a lover of classic songs, what he fondly calls the “Tropicana vibe”, and the excitement of performing on stage, it&#039;s a dream come true.&lt;/p&gt;"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Michael BubléTribute - Scott Keo as Michael Bublé"
      }
    ],
