    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p data-start=&quot;116&quot; data-end=&quot;579&quot;&gt;Join us for a wild and wicked screening of &lt;em data-start=&quot;202&quot; data-end=&quot;233&quot;&gt;The Rocky Horror Picture Show&lt;/em&gt;—celebrating its &lt;strong data-start=&quot;250&quot; data-end=&quot;270&quot;&gt;50th anniversary&lt;/strong&gt; as the ultimate cult classic full of camp, chaos, and fishnet flair. Costumes and callbacks are absolutely encouraged, so bring your sass, your sequins, and your sense of adventure. Whether you&#039;re a seasoned Frank-N-Furter fan or a curious first-timer, this is one cinematic experience you’ll never forget. Let’s make this a night to thrill, chill, and fulfill!&lt;/p&gt;  &lt;p data-start=&quot;108&quot; data-end=&quot;174&quot;&gt;&lt;/p&gt;"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Rocky Horror Picture Show Movie Viewing"
      }
