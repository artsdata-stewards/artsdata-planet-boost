    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "A Christmas Benefit Concert for Jacob - Manluk Theatre"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "This Christmas Benefit Concert is a chance for the community to assist a little boy and his family. Jacob was diagnosed with CLN1 Batten disease at the age of 4 years old. He was born a typical child but as he grows older more symptoms of his diagnosis come to light. He went from doing what most"
      }
