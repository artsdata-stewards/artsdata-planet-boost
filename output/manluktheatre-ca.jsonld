    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Stand Up comedy with Ken Valgardson - Manluk Theatre"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "This rural Alberta based Comedian has performed in comedy clubs across Canada and has entertained the troops in the middle east. Don't miss the laughs as he makes his debut on the Manluk stage! \"Ken was already headlining clubs when I first started. He was killing me then, and he kills me now.\" -Brent Butt"
      }
    ],
