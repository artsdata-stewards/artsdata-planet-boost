  {
    "@id": "https://manluktheatre.ca/whats-on/story-in-my-pocket-428/",
    "https://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "https://ogp.me/ns#site_name": [
      {
        "@language": "en-us",
        "@value": "Manluk Theatre - Manluk Theatre for The Performing Arts"
      }
    ],
    "https://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Sex Please, We’re Sixty! - Manluk Theatre"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Bud \"the stud\" gets his hands on some untested Venusia pills. He attempts to \"entertain\" three women but the gals swap his Viagra with the Venusia and we soon discover that it has a strange effect on men! Directed by Marlene Schoonmaker and Rick Bolstad Event Dates: Friday, November 17th at 7:30pm Saturday November 18th"
