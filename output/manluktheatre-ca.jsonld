    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Let’s celebrate the beauty of the past at The Old Trunk by Diaphanous Designs. This event will be more than just stunning garments, it will be a journey through fashion history. Capturing your attention through original re-imagined garments on the runway.    Our runway show will be a tribute to the rich tapestry of aged fashion. We want our attendees to feel the memories associated with vintage clothes. From youthful ages of digging through their loved ones old closets, trunks, and treasures. Bring back these memories and remake new ones at this event.    In addition to our runway show, we are thrilled to host a handful of vendors. These vendors have curated a selection of handmade items and clothing for attendees to purchase."
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Old Trunk Fashion Show"
      }
    ],
