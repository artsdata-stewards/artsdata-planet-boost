    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Fire and Ice – A Concert by Candlelight - Manluk Theatre"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Local artists showcase their amazing talents, bringing a selection of winter themed music to this exciting new concept show. A celebration of winter featuring music by: The Chamber Ensemble - Angie Ganley - Ken Mastel - Dean and Megan Pezderic with Becky Moonen - Jane Gusdal"
      }
    ],
