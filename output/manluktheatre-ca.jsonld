    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "When Willie MacCrimmon, cobbler and bereaved widower, muses aloud that he would give anything to skip his curling team in the MacDonald Brier, the devil (A traveling salesperson who deals in wholesale souls and retail sin) suddenly appears an makes him an offer. Wullie makes a counter offer, and one of the greatest matches in curling history is on!    Directed by Ken Mastel    Available Show Dates  &lt;ul&gt;    &lt;li&gt;February 7th at 7:30&lt;/li&gt;    &lt;li&gt;February 8th at 7:30&lt;/li&gt;    &lt;li&gt;February 9th at 2:00&lt;/li&gt;    &lt;li&gt;February 14th at 7:30&lt;/li&gt;    &lt;li&gt;February 15th at 7:30&lt;/li&gt;    &lt;li&gt;February 16th at 2:00&lt;/li&gt;  &lt;/ul&gt;"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Black Bonspiel of Wullie McCrimmon"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
