    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://manluktheatre.ca/whats-on/charlie-jacobson-band/"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Alberta musician, songwriter and multi-instrumentalist,  Charlie Jacobson is bringing his own brand of blues to the  people.  Jacobson has backed up — and been backed by — Canadian  blues giants, including Kenny “Blues Boss” Wayne, Russell  Jackson, David Vest and Donald Ray Johnson.  Charlie’s guitar appears to be part of his body when he’s on  stage, like a third arm. It is not uncommon to see him  weaving throughout crowds and jumping from drum kit to  table, while singing his heart out, and never losing a note on  the guitar.    &nbsp;"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Charlie Jacobson Band"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
