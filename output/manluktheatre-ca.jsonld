    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Wes Barker – Comedy Magic! - Manluk Theatre"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Wes Barker is Canada's funniest magician! Wild tricks, hilarious stories, incredible feats, and amazing antics. It's a show like you’ve never experienced. As seen on America’s Got Talent, Ellen, Big Trick Energy, Syfy, MTV, and Penn & Teller: Fool Us (which he won!). Wes will have you laughing at a crazy true story one moment"
      }
    ],
