    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Salle Maurice O'Bready - Show One Productions"
      },
      {
        "@language": "fr-ca",
        "@value": "Salle Maurice O'Bready"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "La salle Maurice-O'Bready est une salle de spectacle de haut niveau située à l'Université de Sherbrooke..."
      },
      {
        "@language": "fr-ca",
        "@value": "La salle Maurice-O'Bready est une salle de spectacle de renom située à l'Université de Sherbrooke, à Sherbrooke, au Québec. Reconnue pour son acoustique impressionnante et sa conception architecturale raffinée, la salle est une destination de choix pour les concerts, les productions théâtrales, les spectacles de danse et les événements culturels majeurs. Grâce à sa scène spacieuse et à ses excellentes lignes de visibilité, elle accueille régulièrement des artistes de renom dans le cadre de concerts, de productions théâtrales et de spectacles de danse."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://showoneproductions.ca/fr/venue/salle-maurice-obready/"
      }
