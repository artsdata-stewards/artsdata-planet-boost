    "http://ogp.me/ns#title": [
      {
        "@language": "ru-ru",
        "@value": "Театр Казино дю Лак-Леами - Show One Productions"
      },
      {
        "@language": "ru-ru",
        "@value": "Théâtre du Casino du Lac-Leamy"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "ru-ru",
        "@value": "Théâtre du Casino du Lac-Leamy - это ведущее развлекательное заведение, расположенное в Гатино, Квебек,..."
      },
      {
        "@language": "ru-ru",
        "@value": "Théâtre du Casino du Lac-Leamy - это ведущее развлекательное заведение, расположенное в Гатино, Квебек, на территории знаменитого комплекса Casino du Lac-Leamy. Известный своей высококлассной атмосферой и отточенными стандартами производства, театр принимает широкий спектр концертов, комедийных шоу, музыкальных представлений и специальных мероприятий с участием лучших местных и международных артистов."
      }
    ],
