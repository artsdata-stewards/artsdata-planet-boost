      {
        "@language": "fr-ca",
        "@value": "Place des Arts - Théâtre Maisonneuve"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le Théâtre Maisonneuve accueille chaque année de nombreux spectacles de danse, d'humour et de théâtre, ainsi que des artistes..."
      },
      {
        "@language": "fr-ca",
        "@value": "Le Théâtre Maisonneuve accueille chaque année de nombreux spectacles de danse, d'humour et de théâtre, ainsi que des artistes du monde entier. D'une capacité de près de 1 500 places, il crée des liens intimes entre les artistes et le public. Les Grands Ballets Canadiens, Danse Danse, le Festival International de Jazz de Montréal, les Francos de Montréal et bien d'autres..."
      }
    ],
    "http://ogp.me/ns#url": [
