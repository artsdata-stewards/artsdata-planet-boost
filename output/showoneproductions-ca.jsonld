      {
        "@language": "fr-ca",
        "@value": "Le Masonic - Show One Productions"
      },
      {
        "@language": "fr-ca",
        "@value": "La maçonnerie"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le Masonic est un lieu légendaire de spectacles et d'événements situé au sommet de Nob Hill à..."
      },
      {
        "@language": "fr-ca",
        "@value": "Le Masonic est une salle de spectacle et d'événements légendaire située au sommet de Nob Hill à San Francisco, en Californie. Achevé à l'origine en 1958 et modernisé par la suite, le lieu est connu pour son architecture du milieu du siècle, ses vues panoramiques sur la ville et ses capacités de production ultramodernes. Le Masonic accueille une gamme éclectique d'événements, y compris des concerts majeurs, des spectacles de comédie,"
      }
    ],
