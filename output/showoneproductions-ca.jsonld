    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "The Vancouver Playhouse is a renowned performing arts venue located in the heart of downtown…"
      },
      {
        "@language": "en-ca",
        "@value": "The Vancouver Playhouse is a renowned performing arts venue located in the heart of downtown Vancouver. Long recognized as a cultural landmark, it has played a significant role in the city’s artistic life, hosting a wide range of theatrical productions, concerts, comedy shows, and spoken-word performances.\nWith its intimate auditorium and excellent sightlines, the Playhouse"
      }
