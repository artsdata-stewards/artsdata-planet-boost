    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le Copernicus Center est un centre culturel et artistique de premier plan situé dans le quartier Jefferson de Chicago...."
      },
      {
        "@language": "fr-ca",
        "@value": "Le Copernicus Center est un centre culturel et artistique de premier plan situé dans le quartier de Jefferson Park à Chicago. Connu pour son design distinctif inspiré du château royal de Varsovie, le centre est un symbole de l'héritage polonais et de la fierté culturelle. Son théâtre principal accueille une grande variété d'événements, notamment des concerts et des productions théâtrales,"
      }
    ],
    "http://ogp.me/ns#url": [
