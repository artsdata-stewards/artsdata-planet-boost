    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "New Theatre Cardiff - Show One Productions"
      },
      {
        "@language": "fr-ca",
        "@value": "Nouveau théâtre de Cardiff"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le New Theatre de Cardiff, au Royaume-Uni, est l'un des théâtres les plus emblématiques et historiques du Pays de Galles...."
      },
      {
        "@language": "fr-ca",
        "@value": "Le New Theatre de Cardiff, au Royaume-Uni, est l'une des salles de spectacle les plus emblématiques et les plus historiques du pays de Galles. Situé sur Park Place, au cœur de la ville, il est une pierre angulaire de la vie culturelle de Cardiff depuis son ouverture en 1906. Le théâtre est connu pour son architecture baroque édouardienne saisissante et ses grandes salles de spectacle."
      }
    ],
    "http://ogp.me/ns#url": [
      {
