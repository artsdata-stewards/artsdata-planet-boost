    "http://ogp.me/ns#title": [
      {
        "@language": "ru-ru",
        "@value": "Новый театр Кардиффа - Show One Productions"
      },
      {
        "@language": "ru-ru",
        "@value": "Новый театр Кардиффа"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "ru-ru",
        "@value": "Новый театр в Кардиффе, Великобритания, является одним из самых знаковых и исторических..."
      },
      {
        "@language": "ru-ru",
        "@value": "Новый театр в Кардиффе (Великобритания) - одно из самых знаковых и исторических мест Уэльса. Расположенный на Парк-Плейс в самом центре города, он является краеугольным камнем культурной жизни Кардиффа с момента своего открытия в 1906 году. Театр известен своей поразительной архитектурой в стиле эдвардианского барокко и грандиозным"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "ru-ru",
        "@value": "https://showoneproductions.ca/ru/venue/new-theatre-cardiff/"
      }
