    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le Moore Theatre est l'une des salles de spectacle les plus historiques et les plus appréciées de Seattle, située..."
      },
      {
        "@language": "fr-ca",
        "@value": "Le Moore Theatre est l'une des salles de spectacle les plus historiques et les plus appréciées de Seattle, située au cœur du quartier des théâtres de la ville. Ouvert en 1907, c'est le plus ancien théâtre en activité à Seattle. Il est connu pour son design élégant du début du XXe siècle et son atmosphère intime. Le Moore Theatre accueille un large éventail de"
      }
    ],
