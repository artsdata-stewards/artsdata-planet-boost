    "http://ogp.me/ns#description": [
      {
        "@language": "ru-ru",
        "@value": "Sala Sinfónica - это главный концертный зал в легендарном Аудиторио де Тенерифе, одном из..."
      },
      {
        "@language": "ru-ru",
        "@value": "The Sala Sinfónica is the principal concert hall within the iconic Auditorio de Tenerife, one of Spain’s most architecturally celebrated cultural landmarks. Designed by renowned architect Santiago Calatrava, the building’s dramatic, wave-like silhouette has become a symbol of Santa Cruz de Tenerife. The Sala Sinfónica is specifically conceived for large-scale symphonic performances, offering outstanding"
      }
    ],
