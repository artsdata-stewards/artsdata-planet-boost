    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Originally The New Theatre, it opened on Boxing Day, 1912. It went through several iterations,…"
      },
      {
        "@language": "en-ca",
        "@value": "Originally The New Theatre, it opened on Boxing Day, 1912. It went through several iterations, being renamed once before becoming the Opera House in 1920. It's also been used for different functions; as a cinema in WW2, then a bingo hall before reopening as a theatre again in 1984. Since, it has hosted magnificent"
      }
    ],
