    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le Vancouver Playhouse est une salle de spectacle renommée située au cœur du centre-ville...."
      },
      {
        "@language": "fr-ca",
        "@value": "Le Vancouver Playhouse est une salle de spectacle renommée située au cœur du centre-ville de Vancouver. Reconnu depuis longtemps comme un point de repère culturel, il joue un rôle important dans la vie artistique de la ville, en accueillant un large éventail de productions théâtrales, de concerts, de spectacles comiques et de performances orales."
      }
    ],
