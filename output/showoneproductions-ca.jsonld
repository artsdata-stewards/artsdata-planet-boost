    "http://ogp.me/ns#title": [
      {
        "@language": "ru-ru",
        "@value": "Театр Жиль-Виньо - Show One Productions"
      },
      {
        "@language": "ru-ru",
        "@value": "Théâtre Gilles-Vigneault"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "ru-ru",
        "@value": "Театр Жиль-Виньо - это современный культурный центр, расположенный в Сен-Жероме, Квебек. Известен своими превосходными..."
      },
      {
        "@language": "ru-ru",
        "@value": "Театр Жиль-Виньо - это современный культурный центр, расположенный в Сен-Жероме, Квебек. Известный своей превосходной акустикой и элегантным дизайном, театр принимает широкий спектр концертов, театральных постановок, танцевальных выступлений и культурных мероприятий. Благодаря удобным креслам и современному техническому оснащению, театр предлагает интимную, но профессиональную обстановку, которая создает тесную связь между"
      }
    ],
