    "http://ogp.me/ns#title": [
      {
        "@language": "ru-ru",
        "@value": "Театры Элгин и Винтер Гарден - Show One Productions"
      },
      {
        "@language": "ru-ru",
        "@value": "Театры Элгин и Винтер Гарден"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "ru-ru",
        "@value": "Театры \"Элгин\" и \"Винтер Гарден\" - это два театра в Торонто, Онтарио,..."
      },
      {
        "@language": "ru-ru",
        "@value": "Театры Элгин и Винтер Гарден - это пара театров в Торонто, Онтарио, Канада. Театр \"Зимний сад\" расположен на семь этажей выше театра \"Элгин\". Это последние сохранившиеся эдвардианские театры в мире. Изначально они были построены в 1913 году как флагман театральной сети Маркуса Лью. Здание"
      }
    ],
