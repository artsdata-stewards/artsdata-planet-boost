    "http://ogp.me/ns#description": [
      {
        "@language": "ru-ru",
        "@value": "Театр Мура - одно из самых исторических и любимых мест проведения концертов в Сиэтле, расположенное..."
      },
      {
        "@language": "ru-ru",
        "@value": "Театр \"Мур\" - одно из самых исторических и любимых мест исполнительских искусств Сиэтла, расположенное в самом сердце театрального района города. Открытый в 1907 году, он является старейшим действующим театром в Сиэтле и известен своим элегантным дизайном начала XX века и интимной атмосферой. В театре Мура проходит широкий спектр"
      }
    ],
