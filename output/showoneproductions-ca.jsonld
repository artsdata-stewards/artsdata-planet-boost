    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "The Salle Ludger-Duvernay, located within the historic Monument-National in downtown Montréal, is a distinguished cultural…"
      },
      {
        "@language": "en-ca",
        "@value": "The Salle Ludger-Duvernay, located within the historic Monument-National in downtown Montréal, is a distinguished cultural venue with deep roots in Québec’s artistic heritage. As part of one of Canada’s most iconic performing arts institutions, the hall has long been a gathering place for theatre, music, comedy, and spoken-word performances.\nThe venue is known for its"
      }
