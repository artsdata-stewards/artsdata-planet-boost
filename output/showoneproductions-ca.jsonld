      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "ru-ru",
        "@value": "Театр Сабан - Show One Productions"
      },
      {
        "@language": "ru-ru",
        "@value": "Saban Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "ru-ru",
        "@value": "Театр Сабан - это культовый и элегантный зал исполнительских искусств, расположенный в Беверли-Хиллз,..."
      },
      {
        "@language": "ru-ru",
        "@value": "Театр Сабан - это культовый и элегантный центр исполнительских искусств, расположенный в Беверли-Хиллз, штат Калифорния. Первоначально открытый в 1930 году и прекрасно отреставрированный, театр славится своей архитектурой в стиле ар-деко, величественными интерьерами и великолепной акустикой. Здесь проводятся самые разнообразные мероприятия, включая концерты, кинопремьеры, телевизионные показы, комедийные шоу и специальные мероприятия."
      }
    ],
