    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le Meridian Hall (anciennement Sony Centre for the Performing Arts) est une salle de spectacle..."
      },
      {
        "@language": "fr-ca",
        "@value": "Le Meridian Hall (anciennement Sony Centre for the Performing Arts) est une salle de spectacle majeure à Toronto, Ontario, Canada. Le Meridian Hall est le plus grand théâtre à sièges souples du Canada. Le centre a ouvert ses portes sous le nom de O'Keefe Centre le 1er octobre 1960 et a accueilli une variété d'attractions et de stars internationales."
      }
    ],
