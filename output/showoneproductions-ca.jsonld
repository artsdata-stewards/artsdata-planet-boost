    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "The National Arts Centre stands as a cornerstone of Canada’s artistic life, bringing together performers,…"
      },
      {
        "@language": "en-ca",
        "@value": "The National Arts Centre stands as a cornerstone of Canada’s artistic life, bringing together performers, creators, and audiences in an inspiring setting in Ottawa. Its location along the Rideau Canal and near Parliament Hill underscores its role as a national cultural institution.\nFeaturing multiple performance halls, the NAC showcases an extensive range of artistic disciplines,"
      }
    ],
