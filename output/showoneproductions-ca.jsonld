    "http://ogp.me/ns#title": [
      {
        "@language": "ru-ru",
        "@value": "Центр исполнительских искусств Броварда - Show One Productions"
      },
      {
        "@language": "ru-ru",
        "@value": "Broward Center for the Performing Arts"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "ru-ru",
        "@value": "Центр исполнительских искусств Броварда - один из главных культурных центров Южной Флориды,..."
      },
      {
        "@language": "ru-ru",
        "@value": "Центр исполнительских искусств Броварда - один из главных культурных центров Южной Флориды, расположенный вдоль живописной реки Нью-Ривер в центре Форт-Лодердейла. Известный своей поразительной архитектурой на берегу реки и помещениями мирового класса, Центр принимает впечатляющий спектр представлений, включая бродвейские туры, концерты, балет, оперу, комедии и семейные программы. С несколькими"
      }
    ],
