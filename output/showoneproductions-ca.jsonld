    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "ru-ru",
        "@value": "Зал Мориса О'Бриди - Show One Productions"
      },
      {
        "@language": "ru-ru",
        "@value": "Зал Мориса О'Бриди"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "ru-ru",
        "@value": "Salle Maurice-O'Bready - это выдающийся зал исполнительских искусств, расположенный в Университете Шербрука в..."
      },
      {
        "@language": "ru-ru",
        "@value": "Salle Maurice-O'Bready - это выдающийся зал исполнительских искусств, расположенный в Шербрукском университете в Шербруке, Квебек. Известный своей впечатляющей акустикой и изысканным архитектурным дизайном, зал служит главным местом для проведения концертов, театральных постановок, танцевальных выступлений и крупных культурных мероприятий. Благодаря просторной сцене и отличной видимости он регулярно принимает знаменитых"
      }
    ],
    "http://ogp.me/ns#url": [
