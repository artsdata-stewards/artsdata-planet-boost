  {
    "@id": "https://showoneproductions.ca/venue/place-des-arts-theatre-maisonneuve/?eventDisplay=past",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-ca",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Place des Arts — Théâtre Maisonneuve - Show One Productions"
      },
      {
        "@language": "en-ca",
        "@value": "Place des Arts — Théâtre Maisonneuve"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Every year, Théâtre Maisonneuve welcomes numerous dance, comedy and theatre shows, as well as artists…"
      },
      {
        "@language": "en-ca",
        "@value": "Every year, Théâtre Maisonneuve welcomes numerous dance, comedy and theatre shows, as well as artists from all over the world. With a seating capacity of nearly 1,500, it creates intimate connections between performers and audiences. Les Grands Ballets Canadiens, Danse Danse, the Festival Internationale de Jazz de Montréal, the Francos de Montréal and many"
