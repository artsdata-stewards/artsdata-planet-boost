    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le Centre national des Arts est la pierre angulaire de la vie artistique canadienne, réunissant artistes,..."
      },
      {
        "@language": "fr-ca",
        "@value": "Le Centre national des Arts, pierre angulaire de la vie artistique canadienne, réunit les artistes, les créateurs et le public dans un cadre inspirant à Ottawa. Son emplacement le long du canal Rideau et près de la colline du Parlement souligne son rôle d'institution culturelle nationale. Doté de plusieurs salles de spectacle, le CNA présente un large éventail de disciplines artistiques,"
      }
    ],
