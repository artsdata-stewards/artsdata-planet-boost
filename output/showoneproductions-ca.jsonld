    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "A l'origine, le New Theatre a ouvert ses portes le lendemain de Noël 1912. Il a connu plusieurs itérations,..."
      },
      {
        "@language": "fr-ca",
        "@value": "A l'origine, le New Theatre a ouvert ses portes le lendemain de Noël 1912. Il a connu plusieurs itérations, a été rebaptisé une fois avant de devenir l'Opera House en 1920. Il a également été utilisé pour différentes fonctions : cinéma pendant la Seconde Guerre mondiale, puis salle de bingo avant de rouvrir en tant que théâtre en 1984. Depuis, il a accueilli de magnifiques"
      }
    ],
