    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le Saban Theatre est une salle de spectacle emblématique et élégante située à Beverly Hills,..."
      },
      {
        "@language": "fr-ca",
        "@value": "Le Saban Theatre est une salle de spectacle emblématique et élégante située à Beverly Hills, en Californie. Ouvert à l'origine en 1930 et magnifiquement restauré, le théâtre est réputé pour son architecture Art déco, ses intérieurs grandioses et son acoustique exceptionnelle. Il accueille une grande variété d'événements, notamment des concerts, des premières de films, des enregistrements télévisés, des spectacles comiques et des événements spéciaux."
      }
    ],
