      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "La Sala Sinfónica est la principale salle de concert de l'emblématique Auditorio de Tenerife,..."
      },
      {
        "@language": "fr-ca",
        "@value": "La Sala Sinfónica est la principale salle de concert de l'emblématique Auditorio de Tenerife, l'un des sites culturels les plus célèbres d'Espagne sur le plan architectural. Conçue par l'architecte de renom Santiago Calatrava, la silhouette spectaculaire du bâtiment, qui ressemble à une vague, est devenue un symbole de Santa Cruz de Tenerife. La Sala Sinfónica est spécialement conçue pour des représentations symphoniques de grande envergure, offrant une qualité d'écoute exceptionnelle."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://showoneproductions.ca/fr/venue/auditorio-de-tenerife-sala-sinfonica/"
