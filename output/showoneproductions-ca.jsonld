      {
        "@language": "fr-ca",
        "@value": "Le Broward Center for the Performing Arts est l'une des principales destinations culturelles du sud de la Floride,..."
      },
      {
        "@language": "fr-ca",
        "@value": "Le Broward Center for the Performing Arts est l'une des principales destinations culturelles du sud de la Floride. Il est situé le long de la pittoresque New River, dans le centre-ville de Fort Lauderdale. Réputé pour son architecture fluviale remarquable et ses installations de classe mondiale, le centre accueille une gamme impressionnante de spectacles, notamment des tournées de Broadway, des concerts, des ballets, des opéras, des comédies et des programmes pour la famille. Avec plusieurs"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://showoneproductions.ca/fr/venue/broward-center-for-the-performing-arts/"
      }
    ],
