    "http://ogp.me/ns#title": [
      {
        "@language": "ru-ru",
        "@value": "Центр \"Коперник\" - Show One Productions"
      },
      {
        "@language": "ru-ru",
        "@value": "Copernicus Center"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "ru-ru",
        "@value": "Центр Коперника - это выдающееся место проведения культурных и исполнительских мероприятий, расположенное в чикагском районе Джефферсон..."
      },
      {
        "@language": "ru-ru",
        "@value": "Центр \"Коперник\" - это выдающийся центр культуры и исполнительского искусства, расположенный в районе Джефферсон-парк в Чикаго. Известный своим уникальным дизайном, вдохновленным Королевским замком в Варшаве, Центр является символом польского наследия и культурной гордости. В его главном театре проводятся самые разнообразные мероприятия, включая концерты, театральные постановки,"
      }
    ],
    "http://ogp.me/ns#url": [
