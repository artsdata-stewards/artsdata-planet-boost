        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "ru-ru",
        "@value": "Национальный центр искусств - Show One Productions"
      },
      {
        "@language": "ru-ru",
        "@value": "National Arts Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "ru-ru",
        "@value": "Национальный центр искусств является краеугольным камнем художественной жизни Канады, объединяя исполнителей,..."
      },
      {
        "@language": "ru-ru",
        "@value": "Национальный центр искусств является краеугольным камнем художественной жизни Канады, объединяя исполнителей, творцов и зрителей в вдохновляющем месте в Оттаве. Его расположение вдоль канала Ридо и рядом с Парламентским холмом подчеркивает его роль как национального культурного учреждения. Располагая несколькими залами для выступлений, NAC демонстрирует широкий спектр художественных дисциплин,"
      }
    ],
    "http://ogp.me/ns#url": [
