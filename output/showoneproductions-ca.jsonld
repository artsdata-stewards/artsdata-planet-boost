  {
    "@id": "https://showoneproductions.ca/ru/venue/le-diamant/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "ru-ru",
        "@value": "ru_RU"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "ru-ru",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "ru-ru",
        "@value": "Ле Диамант - Show One Productions"
      },
      {
        "@language": "ru-ru",
        "@value": "Ле Диамант"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "ru-ru",
        "@value": "Le Diamant - это современная, поражающая своей архитектурой площадка для выступлений, расположенная в самом центре..."
      },
      {
        "@language": "ru-ru",
        "@value": "Le Diamant - это современное и поражающее своей архитектурой место для проведения представлений, расположенное в самом центре Квебека. Открытая в 2019 году, площадка была перестроена из исторического здания в современное многопрофильное пространство, предназначенное в первую очередь для циркового искусства, театра, музыки и инновационных сценических постановок. Его смелый дизайн органично сочетает элементы наследия с передовыми"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "ru-ru",
        "@value": "https://showoneproductions.ca/ru/venue/le-diamant/"
      }
