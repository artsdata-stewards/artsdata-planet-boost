    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le Théâtre du Casino du Lac-Leamy est un lieu de divertissement de premier plan situé à Gatineau, au Québec,..."
      },
      {
        "@language": "fr-ca",
        "@value": "Le Théâtre du Casino du Lac-Leamy est une salle de spectacles de premier plan située à Gatineau, au Québec, dans le célèbre complexe du Casino du Lac-Leamy. Reconnu pour son atmosphère haut de gamme et ses normes de production soignées, le théâtre accueille une grande variété de concerts, de spectacles d'humour, de spectacles musicaux et d'événements spéciaux mettant en vedette des artistes locaux et internationaux de premier plan."
      }
    ],
