    "http://ogp.me/ns#title": [
      {
        "@language": "ru-ru",
        "@value": "Масон - Show One Productions"
      },
      {
        "@language": "ru-ru",
        "@value": "The Masonic"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "ru-ru",
        "@value": "Масонский\" - это легендарное место проведения концертов и мероприятий, расположенное на вершине Ноб-Хилл в..."
      },
      {
        "@language": "ru-ru",
        "@value": "Масонский\" - легендарное место проведения концертов и мероприятий, расположенное на вершине холма Ноб в Сан-Франциско, штат Калифорния. Первоначально построенный в 1958 году и впоследствии модернизированный, он известен своей поразительной архитектурой середины века, панорамными видами на город и самыми современными производственными возможностями. В \"Масоне\" проводятся самые разнообразные мероприятия, включая крупные концерты, комедийные шоу,"
      }
    ],
