    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "The Elgin and Winter Garden Theatres are a pair of stacked theatres in Toronto, Ontario,…"
      },
      {
        "@language": "en-ca",
        "@value": "The Elgin and Winter Garden Theatres are a pair of stacked theatres in Toronto, Ontario, Canada. The Winter Garden Theatre is seven storeys above the Elgin Theatre.\nThey are the last surviving Edwardian stacked theatres in the world. The pair were originally built as the flagship of Marcus Loew’s theatre chain in 1913. The building"
      }
