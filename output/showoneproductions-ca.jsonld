    "http://ogp.me/ns#title": [
      {
        "@language": "ru-ru",
        "@value": "Ричмондский театр - Show One Productions"
      },
      {
        "@language": "ru-ru",
        "@value": "Ричмондский театр"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "ru-ru",
        "@value": "Ричмондский театр - это поистине прекрасное здание с заслуженной репутацией качественного и зрелищного театра....."
      },
      {
        "@language": "ru-ru",
        "@value": "Ричмондский театр - это поистине прекрасное здание с заслуженной репутацией качественного и зрелищного театра. Существует множество способов насладиться этим особенным историческим зданием, построенным в 1899 году по проекту знаменитого театрального архитектора Фрэнка Матчама. Ричмондский театр работает в партнерстве с The Richmond Theatre Trust Ltd, зарегистрированной благотворительной организацией."
      }
    ],
