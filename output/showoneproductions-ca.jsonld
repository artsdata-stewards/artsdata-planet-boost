      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "ru-ru",
        "@value": "Оперный театр Манчестера - Show One Productions"
      },
      {
        "@language": "ru-ru",
        "@value": "Оперный театр Манчестера"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "ru-ru",
        "@value": "Первоначально Новый театр открылся в Боксинговый день 1912 года. Он пережил несколько итераций,..."
      },
      {
        "@language": "ru-ru",
        "@value": "Первоначально Новый театр открылся в Боксинговый день 1912 года. Он пережил несколько переименований, один раз был переименован, а в 1920 году стал Оперным театром. Он также использовался для различных целей: как кинотеатр во время Второй мировой войны, затем как зал для игры в бинго, а затем снова открылся как театр в 1984 году. С тех пор в нем проходили великолепные"
      }
    ],
    "http://ogp.me/ns#url": [
