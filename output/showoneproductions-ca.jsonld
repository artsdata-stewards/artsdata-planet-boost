    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Le Diamant - Show One Productions"
      },
      {
        "@language": "fr-ca",
        "@value": "Le Diamant"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le Diamant est une salle de spectacle contemporaine à l'architecture remarquable, située au cœur de..."
      },
      {
        "@language": "fr-ca",
        "@value": "Le Diamant est une salle de spectacles contemporaine à l'architecture remarquable située au cœur de la ville de Québec. Inauguré en 2019, le lieu a été revitalisé à partir d'un bâtiment historique pour devenir un espace artistique moderne et multidisciplinaire dédié principalement aux arts du cirque, au théâtre, à la musique et aux productions scéniques novatrices. Son design audacieux allie harmonieusement des éléments patrimoniaux à des productions scéniques d'avant-garde."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://showoneproductions.ca/fr/venue/le-diamant/"
      }
    ],
