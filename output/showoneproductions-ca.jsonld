    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le Théâtre Gilles-Vigneault est un lieu culturel moderne situé à Saint-Jérôme, au Québec. Reconnu pour son excellente..."
      },
      {
        "@language": "fr-ca",
        "@value": "Le Théâtre Gilles-Vigneault est un lieu culturel moderne situé à Saint-Jérôme, au Québec. Reconnu pour son excellente acoustique et son design élégant, le théâtre accueille un large éventail de concerts, de productions théâtrales, de spectacles de danse et d'événements culturels. Avec ses sièges confortables et ses installations techniques à la fine pointe de la technologie, il offre un cadre à la fois intime et professionnel qui crée un lien solide entre le public et les artistes."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
