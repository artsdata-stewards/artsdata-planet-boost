    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le Richmond Theatre est un bâtiment vraiment magnifique qui jouit d'une réputation bien méritée en termes de qualité et de divertissement. ...."
      },
      {
        "@language": "fr-ca",
        "@value": "Le Richmond Theatre est un bâtiment d'une grande beauté qui jouit d'une réputation bien méritée en matière de qualité et de divertissement. Il existe de nombreuses façons de profiter de ce bâtiment historique très spécial, construit en 1899 et conçu par le célèbre architecte de théâtre Frank Matcham. Le Richmond Theatre travaille en partenariat avec le Richmond Theatre Trust Ltd, une organisation caritative enregistrée."
      }
    ],
