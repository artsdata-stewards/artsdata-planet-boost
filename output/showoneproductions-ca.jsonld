    "http://ogp.me/ns#title": [
      {
        "@language": "ru-ru",
        "@value": "Королевский театр - Show One Productions"
      },
      {
        "@language": "ru-ru",
        "@value": "Kings Theatre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "ru-ru",
        "@value": "Kings Theatre - это историческое и архитектурное место для проведения концертов, расположенное в районе Флэтбуш..."
      },
      {
        "@language": "ru-ru",
        "@value": "Kings Theatre - это исторический и архитектурный центр исполнительских искусств, расположенный в районе Флэтбуш в Бруклине, Нью-Йорк. Первоначально открытый в 1929 году и тщательно отреставрированный до своего былого величия, театр славится своими богатыми интерьерами, грандиозным фойе и исключительной акустикой. Сегодня в Kings Theatre проходят разнообразные концерты, комедии"
      }
    ],
    "http://ogp.me/ns#url": [
