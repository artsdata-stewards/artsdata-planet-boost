    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Kings Theatre - Show One Productions"
      },
      {
        "@language": "fr-ca",
        "@value": "Théâtre des rois"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le Kings Theatre est une salle de spectacle historique à l'architecture étonnante située dans le quartier de Flatbush...."
      },
      {
        "@language": "fr-ca",
        "@value": "Le Kings Theatre est une salle de spectacle historique à l'architecture étonnante située dans le quartier de Flatbush à Brooklyn, New York. Ouvert à l'origine en 1929 et méticuleusement restauré pour retrouver sa grandeur d'antan, le théâtre est célèbre pour ses intérieurs ornés, son grand hall d'entrée et son acoustique exceptionnelle. Aujourd'hui, le Kings Theatre accueille une programmation variée de concerts, de comédies et de spectacles."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://showoneproductions.ca/fr/venue/kings-theatre/"
      }
