    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Kings Theatre is a historic and architecturally stunning performing arts venue located in the Flatbush…"
      },
      {
        "@language": "en-ca",
        "@value": "Kings Theatre is a historic and architecturally stunning performing arts venue located in the Flatbush neighborhood of Brooklyn, New York. Originally opened in 1929 and meticulously restored to its former grandeur, the theater is celebrated for its ornate interiors, grand lobby, and exceptional acoustics. Today, Kings Theatre hosts a diverse lineup of concerts, comedy"
      }
