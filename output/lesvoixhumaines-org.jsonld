    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Viol adventure &#8211; CANCELED"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The pandemic allowed Susie Napper and Mélisande Corriveau to offer a creation residency to 8 professional musicians. An ideal opportunity to explore the musical universe of the viola da gamba and consort music. Following this residency, we are proud to present the final concert with 2, 3, 4, 5 and 8 viols on stage!"
      }
    ]
  },
  {
    "@id": "_:g13025120",
    "@type": [
      "http://schema.org/Person"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://lesvoixhumaines.org/en/evenement/viol-adventure/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Les Voix humaines"
      }
    ],
