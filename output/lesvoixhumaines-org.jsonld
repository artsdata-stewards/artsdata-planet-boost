    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p class=hautcalendrier\"><span class=\"\"emphase\"\">Henry &amp; William Lawes, Purcell, Simpson &amp; Jenkins</span><br /> <span class=\"\"normal\"\">Charles Daniels, t&eacute;nor, Sylvain Bergeron, luth,</span><br /><span class=\"\"normal\"\"> Susie Napper &amp; Margaret Little, violes de gambe</span><br /><span class=\"\"normal\"\">9 f&eacute;vrier 2014, 19h</span><br /><br /><span class=\"\"normal\"\">College Heights SDA Church, Lacombe, Alberta</span><br /><a href=\"\"http://www.cauc.ca/music/sundayatseven\"\">http://www.cauc.ca/music/sundayatseven</a></p><p class=\"hautcalendrier\"><a></a><tt>avec l&rsquo;aide du Conseil des arts et des lettres du Qu&eacute;bec<br /> et du Conseil des Arts du Canada</tt></p></span>"
