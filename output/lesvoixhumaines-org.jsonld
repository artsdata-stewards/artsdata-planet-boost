    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p><span class=\"emphase\">de Johann Sebastian Bach</span><br /> Le Consort de violes des Voix humaines&nbsp;:<br /> Margaret Little, M&eacute;lisande Corriveau, Felix Deak &amp; Susie Napper<br /> 24 octobre 2013 &agrave; 19h30<br /> <br /> Chapelle Saint-Louis, 4230, rue Drolet (au nord de la rue Rachel Est), Montr&eacute;al<br />Billets: 30$ r&eacute;gulier / 15$ &eacute;tudiants &amp; 65+<br /><b><span class=\"\"emphase\"\">R&eacute;servations :</span> 514-845-7171 ou <a href=\"\"mailto:&#x69;&#x6e;&#x66;&#x6f;&#x40;&#x6c;&#x65;&#x73;&#x76;&#x6f;&#x69;&#x78;&#x68;&#x75;&#x6d;&#x61;&#x69;&#x6e;&#x65;&#x73;&#x2e;&#x6f;&#x72;&#x67;\"\">&#x69;&#x6e;&#x66;&#x6f;&#x40;&#x6c;&#x65;&#x73;&#x76;&#x6f;&#x69;&#x78;&#x68;&#x75;&#x6d;&#x61;&#x69;&#x6e;&#x65;&#x73;&#x2e;&#x6f;&#x72;&#x67;</a></b></p><b><a href=\"\"mailto:&#x69;&#x6e;&#x66;&#x6f;&#x40;&#x6c;&#x65;&#x73;&#x76;&#x6f;&#x69;&#x78;&#x68;&#x75;&#x6d;&#x61;&#x69;&#x6e;&#x65;&#x73;&#x2e;&#x6f;&#x72;&#x67;\"\"></a></b></span>"
