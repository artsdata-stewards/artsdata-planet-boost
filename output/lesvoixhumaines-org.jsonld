    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p><span class=\"emphase\">Henry &amp; William Lawes, Purcell, Simpson &amp; Jenkins</span><br /> Charles Daniels, t&eacute;nor, Sylvain Bergeron, luth,<br /> Susie Napper &amp; Margaret Little, violes de gambe<br />14 f&eacute;vrier 2015 &agrave; 20h</p><p>The Academy of Early Music<br />Christ Church Cranbrook, Bloomfield Hills, Michigan<br /><span class=\"\"petit\"\">avec l&rsquo;aide du Conseil des arts du Canada et du Conseil des arts et des lettres du Qu&eacute;bec</span></p></span>"
      }
