    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p>30 janvier 2010 &agrave; 19h30<br/><span class=\"emphase\">Marais, Sainte-Colombe, Rameau, Leb&egrave;que, Couperin</span><br/>Susie Napper et Margaret Little, violes de gambe<br/><br/>The Chamber Music Society of St-Cloud<br/>Atonement Lutheran Church 1144 North 29th Avenue, Saint-Cloud Minnesota, USA<br/>Renseignements: 320-253-3883 - <a href=\"\"http://www.chambermusicstcloud.org\"\">www.chambermusicstcloud.org</a> <br/><span class=\"hautcalendrier\">avec laide du Conseil des arts et des lettres du Qu&eacute;bec</span></p><!--EndFragment--></span>"
