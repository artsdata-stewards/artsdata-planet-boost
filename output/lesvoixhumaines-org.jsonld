  {
    "@id": "https://lesvoixhumaines.org/temporary/f7782a06-1fbd-42b6-83ec-d98a4f56796a",
    "@type": [
      "https://schema.org/WebPage"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
