    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p class=Normal1\"><span class=\"\"emphase\"\">Celebrating John Dowland&rsquo;s 450</span><sup class=\"\"emphase\"\">th</sup><span class=\"\"emphase\"\"> anniversary!</span><br />Susie Napper &amp; Margaret Little, viols, Nigel North, lute<br />Karen Zaidan &amp; Myra Berrub, sopranos, and Daniel Gillis, counter-tenor<br />26 September 2013 at 7 pm<br /><br /><tt><span class=\"\"normal\"\">NWT International Lute Festival</span><br /></tt>St Joseph&rsquo;s Cathedral, Fort Smith, NWT, Canada<br />Information&nbsp;: <a href=\"\"http://www.nwtlutefest.com/Hay_River_Early_Music_Society/Home.html\"\">http://www.nwtlutefest.com/Hay_River_Early_Music_Society/Home.html</a><br /><tt><span style=\"\"font-size: 10px;\"\">with the help of the <tt><span style=\"\"font-size: 10px;\"\"><span style=\"\"font-size: 10px;\"\">Canada Council for the Arts</span></span></tt></span></tt></p></span>"
      }
    ]
  },
  {
