    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p><span class=\"emphase\">Purcell, Gershwin, Vigneault, Vivaldi, Kosma&hellip;</span><br />Chansons, danses et fantaisies sur le th&egrave;me des saisons<br /> Suzie Leblanc, soprano, et le Consort de violes des Voix humaines&nbsp;:<br /> Margaret Little, M&eacute;lisande Corriveau, Felix Deak et Susie Napper<br /> 22 f&eacute;vrier 2014 &agrave; 20h<br /> <br /> &Eacute;glise Ste-Victoire, Victoriaville, Qu&eacute;bec<br /> Renseignements&nbsp;: 819-751-4515<i> - </i><a href=\"\"http://www.diffusionmomentum.com\"\">http://www.diffusionmomentum.com</a></p></span>"
      }
    ]
  },
  {
