    "http://ogp.me/ns#title": [
      {
        "@language": "fr-fr",
        "@value": "Bach : Métamorphoses - Les Voix humaines"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "Ce programme enchaîne des canons du répertoire ainsi que des œuvres moins connues du grand maître et de son entourage... métamorphosées!   J. S. Bach a passé sa vie à transformer ses propres œuvres et à arranger la musique de compositeurs qu’il admirait. Avec beaucoup de plaisir - et une bonne dose d’humilité - nous avons suivi l’exemple du maître et créé un programme unique qui se veut un hommage à la fois à son extraordinaire musique et à son cercle musical."
      }
    ],
    "http://ogp.me/ns#url": [
