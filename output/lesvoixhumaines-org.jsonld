    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Ercole, Cupido, Furiae e Apollo"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<strong>La libre, passionnée et élégante virtuosité de la musique de chambre italienne du XVII<sup>e </sup>siècle.</strong>\r\n\r\nAvec Davide Monti (Italie), David Greenberg, Maria Cleary (Irlande), Antoine Malette-Chénier et le Consort des Voix humaines.\r\n\r\n<strong>Présenté dans le cadre du Festival Montréal Baroque</strong>"
      }
    ]
