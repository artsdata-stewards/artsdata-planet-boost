      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-fr",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-fr",
        "@value": "Les invasions barbares! - Les Voix humaines"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "Les Britanniques et les Français, de véritables envahisseurs barbares, ont pillé de nombreux pays pour leur propre profit au cours des 17e et 18e siècles, laissant des traces de leur culture pour la postérité! On trouve par exemple des opéras de Rameau en Haïti, et de nombreux vestiges musicaux britanniques et français au Canada, en Inde et dans les Caraïbes. Les violes retrouvées dans les murs d’un hôpital de Québec sont extraordinaires… Venez découvrir les airs barbares favoris des Voix humaines.    Oeuvres de Couperin, Hume, Locke, Marais et Sainte-Colombe"
      }
    ],
    "http://ogp.me/ns#url": [
