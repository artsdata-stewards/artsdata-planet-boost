    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>October 17, 2010 at 7:30 pm<br/><span class=\"emphase\">Marais, Sainte-Colombe, Forqueray, Purcell, Jenkins</span><br/>Wieland Kuijken, Susie Napper &amp; Margaret Little, violas da gamba,<br/>Eric Milnes, harpsichord</p><p>Forbidden City Concert Hall<br/>Zhongshan Park, Beijing, China<br/>Information: <a href=\"\"http://www.fcchbj.com/ticket/206\"\">http://www.fcchbj.com/ticket/206</a><br/><span class=\"hautcalendrier\">with the help of the Conseil des arts et des lettres du Qu&eacute;bec</span><br/></p></span>"
      }
