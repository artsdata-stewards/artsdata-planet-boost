      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p><span class=\"emphase\">Henry &amp; William Lawes, Purcell, Simpson &amp; Jenkins</span><br /> Charles Daniels, tenor, Sylvain Bergeron, lute,<br /> Susie Napper &amp; Margaret Little, violas da gamba<br /> January 16, 2013 at 8 pm <br /> <br /> Salle d&#39;Youville, Soci&eacute;t&eacute; du Palais Montcalm, Qu&eacute;bec<br /> Information&nbsp;: <a href=\"\"http://www.palaismontcalm.ca/programmation/tenor-charles-daniels-les-voix-humaines-815\"\">Soci&eacute;t&eacute; duPalais Montcalm<br /></a><span style=\"\"font-size: 10px;\"\">with the help of the &nbsp;Conseil des arts et des lettres du Qu&eacute;bec<br /><span style=\"\"font-size: 10px;\"\">and the Canada Council for the Arts</span><br /></span></p><p></p></span>"
      }
    ]
  },
  {
    "@id": "https://lesvoixhumaines.org/temporary/ec80ecc5-7205-41a4-b1fa-bb6829e6b8a0",
