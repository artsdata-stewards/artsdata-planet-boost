    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "PERCHANCE TO DREAME"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p class=normal\"><span class=\"\"emphase\"\">Henry &amp; William Lawes, Purcell, Simpson &amp; Jenkins</span><br />Charles Daniels, t&eacute;nor, Sylvain Bergeron, luth,<br />Susie Napper &amp; Margaret Little, violes de gambe<br />16 janvier 2013 &agrave; 20h<br /><br />Salle d&#39;Youville, Soci&eacute;t&eacute; du Palais Montcalm, Qu&eacute;bec<br /><span class=\"\"normal\"\">Renseignements&nbsp;: <a href=\"\"http://www.palaismontcalm.ca/programmation/tenor-charles-daniels-les-voix-humaines-815\"\">Soci&eacute;t&eacute; du Palais Montcalm</a></span><br /><span style=\"\"text-decoration: underline;\"\"></span><span style=\"\"font-size: 10px;\"\">avec l&rsquo;aide du Conseil des arts et des lettres du Qu&eacute;bec<br /><span style=\"\"font-size: 10px;\"\">et du Conseil des Arts du Canada</span><br /></span></p></span>"
      }
    ]
  },
  {
    "@id": "https://lesvoixhumaines.org/temporary/1ad9aca3-2bf2-4035-8a61-f45b90caae43",
    "@type": [
