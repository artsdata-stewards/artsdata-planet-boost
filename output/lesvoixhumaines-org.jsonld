    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>August 24, 2010 at 2&nbsp;:30 pm<br/><span class=\"emphase\">Discover the viola da gamba with Louis the 14th</span><br/>Susie Napper &amp; Margaret Little, violas da gamba<br/><br/>Festival baroque de Sabl&eacute; sur Sarthe<br/>Castle Stables, Sabl&eacute;-sur-Sarthe, France<br/>Information:<a href=\"\"http://www.sablesursarthe.fr/pages/vivre-a-sable/culture/festival-baroque.php\"\"> www.sablesursarthe.fr/pages/vivre-a-sable/culture/festival-baroque.php</a>&nbsp;<br/><span class=\"hautcalendrier\">with the help of the Conseil des arts et des lettres du Qu&eacute;bec</span></p></span>"
      }
    ]
