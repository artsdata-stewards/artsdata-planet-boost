    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p class=Normal1\"><span class=\"\"emphase\"\">Purcell, Gershwin, Vigneault, Vivaldi, Kosma&hellip;</span><br />Songs, dances and fantasias celebrating the seasons<br /> <tt class=\"\"normal\"\">Suzie Leblanc, soprano</tt><span class=\"\"normal\"\">, and </span><tt class=\"\"normal\"\">Les Voix humaines Consort of viols:</tt><br /> <tt class=\"\"normal\"\">Margaret Little, M&eacute;lisande Corriveau, Felix Deak &amp; Susie Napper<br /></tt>November 28, 2013 at 8 pm<br /><br />Salle Desjardins-Telus, Rimouski, Qu&eacute;bec<br />Information&nbsp;: <a href=\"\"http://www.spectart.com/programmation/artiste.php?di=504\"\">http://www.spectart.com/programmation/artiste.php?di=504</a></p></span>"
      }
    ]
  },
  {
    "@id": "https://lesvoixhumaines.org/temporary/32ba97e8-a98e-49b4-9f64-c56c9f7f605d",
