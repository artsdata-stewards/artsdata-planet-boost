    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<table style=width: 100%;\" border=\"\"0\"\" cellpadding=\"\"0\"\" cellspacing=\"\"0\"\"><tbody><tr><td valign=\"\"top\"\"><p><span class=\"\"emphase\"\">by Johann Sebastian Bach</span><br /> Les Voix humaines Consort of viols:<br /> Margaret Little, M&eacute;lisande Corriveau, Felix Deak &amp; Susie Napper<br /> October 24, 2013 at 7&nbsp;:30 pm<br /> <br /> Chapelle Saint-Louis, 4230, rue Drolet (north of Rachel East), Montreal<br />Tickets: 30$ regular / 15$ students &amp; 65+<br /><b><span class=\"\"emphase\"\">Information &amp; reservation:</span> <b><span class=\"\"emphase\"\"><b>514-845-7171 or</b></span></b> <a href=\"\"mailto:&#x69;&#x6e;&#x66;&#x6f;&#x40;&#x6c;&#x65;&#x73;&#x76;&#x6f;&#x69;&#x78;&#x68;&#x75;&#x6d;&#x61;&#x69;&#x6e;&#x65;&#x73;&#x2e;&#x6f;&#x72;&#x67;\"\">&#x69;&#x6e;&#x66;&#x6f;&#x40;&#x6c;&#x65;&#x73;&#x76;&#x6f;&#x69;&#x78;&#x68;&#x75;&#x6d;&#x61;&#x69;&#x6e;&#x65;&#x73;&#x2e;&#x6f;&#x72;&#x67;</a></b></p></td></tr></tbody></table></span>"
