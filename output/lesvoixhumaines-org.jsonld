    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<strong>John Dowland’s “Lachrimae or Seven Teares”</strong>\r\n\r\nPre-concert lecture at 6&nbsp;:45 pm\r\n\r\nThe programme includes a new piece by Stacey Brown for 5 viols&nbsp;: <em>Lachrimae &amp; Galiard</em>, commissioned by Early Music Vancouver for Les Voix humaines.\r\n\r\n<strong>Valley Concert Society</strong>"
      }
    ]
