    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p><span class=normal\"><span class=\"\"emphase\"\">Henry &amp; William Lawes, Purcell, Simpson &amp; Jenkins<br /></span>Charles Daniels, t&eacute;nor, Sylvain Bergeron, luth,<br />Susie Napper &amp; Margaret Little, violes de gambe<br /></span>19 janvier 2013 &agrave; 20h, conf&eacute;rence &agrave; 19h30<br /> <br /> Early Music Voices<br /> Christ Church Elbow Park, Calgary, Alberta<br /> Renseignements:<a href=\"\"http://www.earlymusicvoices.ca/concerts.html\"\"> Early Music Voices</a><a href=\"\"http://www.earlymusicvoices.ca\"\"><br /></a><span style=\"\"font-size: 10px;\"\">avec l&rsquo;aide du Conseil des arts et des lettres du Qu&eacute;bec<br /><span style=\"\"font-size: 10px;\"\">et du Conseil des Arts du Canada</span><br /></span></p></span>"
