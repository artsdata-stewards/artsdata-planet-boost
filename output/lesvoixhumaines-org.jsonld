  {
    "@id": "https://lesvoixhumaines.org/temporary/0391ab21-a680-4225-a5dc-aba2ac0f8711",
    "@type": [
      "https://schema.org/WebPage"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
