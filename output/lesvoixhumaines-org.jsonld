    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p class=normal\"><span class=\"\"emphase\"\">Marais, Sainte-Colombe, Couperin, Rameau, Corrette<br /></span>Susie Napper et Margaret Little, violes de gambe<br />8 novembre 2012 &agrave; 18h<br /><br />Fondation Arte Musica<br />Salle Bourgie, 1339, rue Sherbrooke Ouest, Montreal<br /><span class=\"\"normal\"\">Renseignements: </span><a href=\"\"http://www.mbam.qc.ca/aujourdhui?dateFrom=2012%2F06%2F12&amp;dateTo=2013%2F07%2F31&amp;eventType=Music&amp;filterSelection=82897|82903#/evenement/-/evenement-detail/1221\"\">fondationartemusica.ca</a></p></span>"
      }
