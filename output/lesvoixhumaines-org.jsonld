    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>January 29, 2010 at 7 :30 pm<br /><span class=\"emphase\">Lambert, Le Camus, Dowland, Purcell, Hidalgo, Hume, Sainte-Colombe, Marais, Couperin</span><br />Catherine Webster, soprano<br />Susie Napper &amp; Margaret Little, violas da gamba<br />Sylvain Bergeron, lute and baroque guitar<br /><br />St-Croix Concert Series<br />Trinity Lutheran Church <br />115 N 4th St. Stillwater, Minnesota, USA<br />Information : 651-430-3528 - <a href=\"\"http://www.stcroixconcertseries.org&nbsp;\"\">www.stcroixconcertseries.org&nbsp;</a><br /><span class=\"hautcalendrier\">with the help of the Conseil des arts et des lettres du Qu&eacute;bec</span><br type=\"\"_moz\"\" /></p></span>"
      }
    ]
  },
  {
