    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p class=Normal1\"><span class=\"\"emphase\"\">En c&eacute;l&eacute;bration du 450e anniversaire de naissance de John Dowland</span><br />Susie Napper et Margaret Little, violes de gambe, Nigel North, luth<br />Karen Zaidan &amp; Myra Berrub, sopranos, Daniel Gillis, haute-contre<br />28 septembre 2013 &agrave; 19h30<br /><br /><tt><span class=\"\"normal\"\">NWT International Lute Festival</span><br /></tt>The Northern Arts and Culture Centre, 4701 - 52 Ave, Yellowknife, NWT, Canada<br />Renseignements: <a href=\"\"http://www.nwtlutefest.com/Hay_River_Early_Music_Society/Home.html\"\">http://www.nwtlutefest.com/Hay_River_Early_Music_Society/Home.html</a><br /><tt class=\"\"petit\"\">avec l&rsquo;aide du Conseil des Arts du Canada</tt></p></span>"
      }
