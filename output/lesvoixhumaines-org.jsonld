    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>French consort music by Moulinié, du Caurroy, Charpentier, Dumont, Couperin &amp; Roberday;<br />world premiere of a compositions by Maurice-Gaston Du Berger for Les Voix humaines.</p>\r\n<p>Les Voix humaines Consort:<br />Margaret Little, Mélisande Corriveau, Felix Deak &amp; Susie Napper, viols; Antoine Malette-Chénier, <span id=\"result_box\" class=\"short_text\" lang=\"en\"><span class=\"\">baroque harp</span></span></p>\r\n<p><img class=\"alignleft size-medium wp-image-18429\" src=\"https://lesvoixhumaines.org/wp-content/uploads/2017/04/CCFA_RGB_colour_f-300x55.jpg\" alt=\"\" width=\"300\" height=\"55\" /></p>"
      }
    ]
