  {
    "@id": "https://lesvoixhumaines.org/temporary/46cd7c48-0ad3-4e50-b532-f05e77fbcaef",
    "@type": [
      "https://schema.org/WebPage"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
