    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p class=normal\"><span class=\"\"emphase\"\">Henry &amp; William Lawes, Purcell, Simpson &amp; Jenkins</span><tt> </tt><tt><br /></tt>Charles Daniels, tenor, Sylvain Bergeron, lute,<br />Susie Napper &amp; Margaret Little, violas da gamba<br />February 4, 2014 at 8 pm<br /><br />Crescent Fort Rouge United Church<br />525 Wardlaw Avenue &amp; Nassau Street N. Winnipeg, Manitoba<br /><a href=\"\"http://www.cameratanova.com/12/\"\">http://www.cameratanova.com/12/</a></p><p class=\"hautcalendrier\"><tt>with the help of the Conseil des arts et des lettres du Qu&eacute;bec<br /> and the Canada Council for the Arts</tt></p></span>"
      }
    ]
  },
  {
