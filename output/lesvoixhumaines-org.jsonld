  {
    "@id": "https://lesvoixhumaines.org/temporary/e3cc54bb-e8b2-4998-bbee-af9463b6a091",
    "@type": [
      "https://schema.org/WebPage"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
