    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p class=normal\"><span class=\"\"emphase\"\">Henry &amp; William Lawes, Purcell, Simpson &amp; Jenkins</span><tt class=\"\"emphase\"\"> </tt><tt><br /></tt>Charles Daniels, tenor, Sylvain Bergeron, lute,<br />Susie Napper &amp; Margaret Little, violas da gamba<br />February 1, 2004 at 8 pm<br /><br />Almonte Old Town Hall<br />14 Bridge St., Almonte, Ontario<br /><a href=\"\"http://www.almonteinconcert.com\"\">http://www.almonteinconcert.com</a></p><p class=\"hautcalendrier\"><tt>with the help of the Conseil des arts et des lettres du Qu&eacute;bec<br /> and the Canada Council for the Arts</tt></p></span>"
      }
