    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<div class=\"clearfix block block-layout-builder block-field-blocknodeevenementfield-description\">\r\n<div class=\"content\">\r\n<div class=\"clearfix text-formatted field field--name-field-description field--type-text-long field--label-hidden field__item\">\r\n\r\nThe Brits and French plundered many a country for their own gain during the 17th and 18th centuries and these barbaric invaders often left traces of their cultures for posterity! A choice of the best barbaric tunes from the Empire!\r\n\r\n</div>\r\n</div>\r\n</div>\r\n<div class=\"clearfix block block-layout-builder block-field-blocknodeevenementfield-repertoire\">\r\n<div class=\"content\">\r\n<div class=\"clearfix text-formatted field field--name-field-repertoire field--type-text-long field--label-hidden field__item\">\r\n\r\nHume, Locke, Couperin, Marais and Sainte-Colombe\r\n\r\n</div>\r\n</div>\r\n</div>"
