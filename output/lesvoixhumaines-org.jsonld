    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p><span class=\"emphase\">Henry &amp; William Lawes, Purcell, Simpson &amp; Jenkins</span><br /> Charles Daniels, t&eacute;nor, Fred Jacobs, luth,<br /> Susie Napper &amp; Margaret Little, violes de gambe<br /><br />15 octobre 2016 &agrave; 20h30<br /> Festival Terpsichore<br />Salle Erard - 13 rue du Mail - Paris 2&egrave;me - M&eacute;tro Bourse ou Sentier<br /> <a href=\"\"http://www.terpsichoreparis.com/voix-humaines\"\">http://www.terpsichoreparis.com/voix-humaines</a></p></span>"
