      {
        "@language": "en",
        "@value": "<p>Come celebrate François Couperin’s birthday with Susie &amp; Margaret!</p>\r\n<p><strong>Couperin, Marais &amp; Rameau</strong></p>\r\n<p><strong>Private salon in downtown Montreal<br />Thursday May 31 at 7 pm</strong></p>\r\n<p>Wine and Susie’s Delicacies<br />Tickets: $50 tax included<br /><strong>30 seats – <u>reserve now!</u></strong></p>"
      }
