    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "<p><p>27 f&eacute;vrier 2010 &agrave; 20h<br /><span class=\"emphase\">Chansons et fantaisies pour violes de Henry Purcell<br /></span>Catherine Webster, soprano<br />Le Consort de violes des Voix humaines:<br />Margaret Little, M&eacute;lisande Corriveau, Elin S&ouml;derstr&ouml;m, Susie Napper<br /><br />Auditorium d&#39;Alma<br />850 rue B&eacute;gin, Alma&nbsp; <br />Renseignements : (418) 669-5135 - <a href=\"\"http://www.auditoriumalma.com/\"\">www.auditoriumalma.com/</a> <br /><span class=\"\"petit\"\">avec l\"\"aide du Conseil des arts et des lettres du Qu&eacute;bec</span></p><p>&nbsp;</p></p></span>"
      }
    ]
