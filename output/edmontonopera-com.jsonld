    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Opera’s bad boy returns to Edmonton in a new production of  Don Giovanni , the crowning masterpiece of Mozart's Italian repertoire. This opera combines elements of tragedy, comedy, and the supernatural with Mozart's genius score to create a riveting live theatre experience!"
      }
    ],
