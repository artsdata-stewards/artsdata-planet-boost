    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Arrive at the picturesque University of Alberta Botanic Garden for an unforgettable celebration of summer at Opera al Fresco! You can enjoy snacks, a selection of wines, and performances of opera & musical theatre favourites at four stages, including the spectacular Aga Khan Garden."
      }
    ],
