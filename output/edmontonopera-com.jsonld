    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Enjoy a wine &amp; cheese reception followed by a lively panel discussion about Edmonton Opera's production of&nbsp; Hansel &amp; Gretel.  Our panelists will talk about Engelbert Humperdinck’s music, the original Brothers Grimm story, and the importance of folklore. Admission is free!"
      }
    ],
