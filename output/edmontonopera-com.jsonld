    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Edmonton Opera invites teachers to discover the magic of opera with an evening of learning and entertainment at the final dress rehearsal of  Don Giovanni!&nbsp; Get a glimpse at this spectacular art form and find out how it can become an essential part of your students' experience at school."
      }
