    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Discover the magic of opera at a special 5-day summer camp! Students in grades 4-6 will explore the different art forms that come together in opera through the story of Mozart’s  The Magic Flute ."
      }
