    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Students can enjoy the final dress rehearsal of  Lilies (Les Feluettes)&nbsp; at the Jubilee this fall! The subject matter of this opera touches on Canadian/Quebecois culture, religion, and art history in an incredible live theatrical experience. Bring your class to the most exciting field trip"
      }
