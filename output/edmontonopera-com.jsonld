    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Enjoy performances of spoken word poetry, theatre, French opera, and Franco-Albertan music in the heart of Edmonton's French Quarter! This free, family-friendly francophone arts showcase is presented jointly by Edmonton Opera and L'UniThéâtre, Alberta's only professional francophone theatre."
      }
