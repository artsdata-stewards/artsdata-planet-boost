    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Join us for an interactive panel discussion that will examine Mozart's masterpiece  Don Giovanni  through the lens of #MeToo, featuring panelists Paula Simons from  Edmonton Journal , soprano Whitney Sloan, musicologist Stephan Bonfield, and Sexual Assault Centre of Edmonton's Annette Klevgaard."
      }
    ],
