    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Member School Inquiry Project Discovery Day: Tour/Rehearsal Observation &#8211; March 24 Learning Session &#8211; March 31 Learning Day: Workshops/Job Shadows &#8211; April 13 For: Member School, Grades 5&amp;6 This day will introduce students to the world of the theatre beyond performance and the actors they see on stage. By observing a wide range of people, [&hellip;]"
      },
