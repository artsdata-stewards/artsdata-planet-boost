    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Writers’ Bloc Grade 7-12 Downtown Toronto Tuesdays from 6PM-8PM, Fall & Winter Theatre for youth by youth! Students learn numerous script-building skills in order to write their own play. The student playwrights will exchange feedback as they workshop drafts of their scripts, receive dramaturgical input from professional theatre artists on staff, and interview YPT playwrights […]"
      }
