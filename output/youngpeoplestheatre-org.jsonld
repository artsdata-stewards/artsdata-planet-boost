    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Everyone&#8217;s a Critic"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;James and the Giant Peach Post-Show Q&amp;A Friday, March 3, 2017 10:15AM Performance Recognizing that the most common assignment given to students in connection with their visit to YPT is a play review, we developed, in collaboration with Jon Kaplan of NOW Magazine, a post-show Q&amp;A specifically about the art of writing reviews. Jon Kaplan [&hellip;]&lt;/p&gt;\\n"
      }
    ],
