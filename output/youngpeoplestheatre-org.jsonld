    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "SHSM Arts &#038; Culture Industry Workshop: Technical Theatre"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;SHSM Arts &amp; Culture Industry Workshop: Technical Theatre Specialist High Skills Majors (SHSM) help students meet the requirements of the Ontario Secondary School Diploma (OSSD), while focusing on a career path that matches their interests and skills. Read more about SHSM here. YPT is facilitating a SHSM workshop in November, 2017 - see below for details. [&hellip;]&lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": "Organization"
      }
    ],
