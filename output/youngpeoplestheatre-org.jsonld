    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Gr. 3-5B Drama Class (Online)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Gr. 3-5B Drama Class (Online) Saturdays (Sept. 25 – Nov. 20) 11AM – 12PM By engaging in imaginative games and improvisation exercises, exploring their voices and creative ways to express themselves physically, participants will deepen their drama skills. This term focuses on vocal and physical expression, improvisation, self-expression and confidence. (60 minutes) Learn More "
      }
    ],
