    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "During YPT&#8217;s Summer Drama Camp, students will be provided with a backstage tour of Young People&#8217;s Theatre. Times may vary, but each Monday, three tours of 16 students will be taken on a behind-the-scenes tour of YPT."
      },
