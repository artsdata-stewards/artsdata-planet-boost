    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Shakespeare Monologues Gr. 9-12 Wednesdays (Oct. 14-Dec. 2) 4:30PM – 6:30PM In this class, participants will explore a variety of Shakespearean monologues. They will be encouraged to find play and complexity in Shakespeare’s language, learning how to break down his speech into clear beats that are a joy to speak. Through exercises, text analysis and [&hellip;]"
      }
