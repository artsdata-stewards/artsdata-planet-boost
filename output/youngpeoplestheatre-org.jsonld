    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;YPT will facilitate a drama workshop with parents and toddlers at the Macaulay Child Development Centre – Jane Street Hub location. The Macaulay Child Development Centre is a multi-service, child care and family support agency. YPT\\'s Schools &amp; Community Programs Manager, Amber Ebert, will be leading this workshop.&lt;/p&gt;\\n"
      }
