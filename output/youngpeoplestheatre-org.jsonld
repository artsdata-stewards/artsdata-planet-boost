    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Young People’s Theatre is pleased to partner with The Hincks-Dellcrest Centre – Gail Appel Institute to present &quot;A Primer on Borderline Personality Disorder&quot; Parent Seminar, with Frank Yeomans MD, PhD, on March 7. Borderline Personality Disorder (BPD) is a common, and commonly misunderstood, condition that affects from 1.8 to 2 percent of the population. The [&hellip;]&lt;/p&gt;\\n"
      }
