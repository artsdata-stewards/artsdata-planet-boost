    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Family Day Drama Workshop"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;James and the Giant Peach - Family Day Drama Workshop Join us on Monday, February 20 for a pre-show drama workshop for the whole family! Led by Resident Artist Educator Ramona Gilmour–Darling, participants will learn about the story of James and the Giant Peach and work together to create new Roald Dahl-inspired characters and worlds! The workshop fee is [&hellip;]&lt;/p&gt;\\n"
      }
    ],
