    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "The YPT Artist Educators Training is open to all artists interested in arts education and with a desire to further develop their pedagogical skills through practical training. Both novice and experienced Artist Educators are welcome. This program will provide professional development for those working in school and community settings across arts disciplines, but with a focus on theatre."
      }
