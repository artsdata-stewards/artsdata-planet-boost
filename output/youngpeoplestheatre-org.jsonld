    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Tell Me That Story Again - FREE TRIAL CLASS The Indigenous Tradition of Oral Storytelling Grade 5-8 July 17, 2019 | 5PM - 6PM Please email Emily Langer, Drama School Coordinator, at elanger@youngpeoplestheatre.ca to attend our FREE TRIAL CLASS on July 17. Class Description: Artist Educators Lindy Kinoshameg, from Wikwemikoong Unceded First Nation, and Leslie McCue, from [&hellip;]&lt;/p&gt;\\n"
      }
