    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "YPT provides weekly Drama Time program for infants, toddlers and their caregivers at The Syme Woolner Neighbourhood & Family Centre in York/Weston. The weekly, hour-long programs explore a particular theme through reading, dramatization, song and craft making."
      }
    ],
