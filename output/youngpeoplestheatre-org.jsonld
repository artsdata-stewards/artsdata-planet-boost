    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Cultural Gym: Creating Character Through Movement An actor&#8217;s instrument is their body. In this fun and lively workshop YPT Resident Artist Educator Melinda Little will introduce physical theatre techniques to explore how your body can be a fantastic resource for creating a character. Date: Wed, March 23rd – 6:00pm to 7:00pm Participants: We welcome children [&hellip;]"
      },
