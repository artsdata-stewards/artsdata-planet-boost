    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Sprucecourt Playwriting Festival"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Sprucecourt Playwriting Festival The grade 4 and 5 students at Sprucecourt Public School have been hard at work writing their own short plays with the support of a professional playwright-in-residence. In May, YPT will stage readings of their plays with professional actors here at the theatre. This is just one of many ongoing enrichment projects [&hellip;]&lt;/p&gt;\\n"
      }
    ],
