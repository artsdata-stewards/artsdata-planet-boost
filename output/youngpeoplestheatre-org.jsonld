    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Storytellers Series: Pamela Mordecai"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Storytellers Series: Pamela Mordecai Gather the little ones in your life to watch as novelist, poet and playwright Pamela Mordecai tells three captivating Jamaican folktales! Recommended for ages 4-8, these clever stories include &quot;Anansi and the Birds&quot;, &quot;How All the Stories Came to be Called Anansi Stories&quot; and &quot;Don\\'t Trouble Trouble Until Trouble Troubles You&quot;. [&hellip;]&lt;/p&gt;\\n"
      }
    ],
