    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "TDSB Playwriting Festival With a focus on playwriting, students will discover and share their own voice and will practically apply what they learn by creating short plays of their own. These plays will then be shared with their peers, teachers, families and artists in a culminating festival day. Through facilitated sessions, small group instruction and [&hellip;]"
      },
