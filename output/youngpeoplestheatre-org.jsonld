        "@language": "en",
        "@value": "Reading Room &#8211; SickKids Hospital"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The Reading Room Program at SickKids YPT works in partnership with the SickKids Family Programs team to facilitate The YPT Reading Room Residency, a series of weekly workshops focused on creative play for children from 0-6 years of age. This residency is based on another program run by YPT with Parent Resources, a family drop-in centre located [&hellip;]"
      }
