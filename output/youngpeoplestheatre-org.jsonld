    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Selected community groups, teachers and other education professionals are invited to join us for a special preview performance of Jacob Two-Two Meets the Hooded Fang. A pre-show panel discussion with question &amp; answer session is included. Light refreshments will be served. Invited guests can RSVP at 416.862.2222. If you would like your organization to be [&hellip;]&lt;/p&gt;\\n"
