    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Count Me In! (Gr. 1-2) Online Thursdays (Oct. 14 – Dec. 2) 5:15PM – 6:15PM This after-school class for students in Gr. 1 &amp; 2 develops numeracy through improvisation and drama games. Developed with the Gr. 1 &amp; 2 Ontario Curriculum learning goals in mind, students will have fun navigating a series of stories that [&hellip;]"
      }
