    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Want to learn more about our Community Volunteer program and various opportunities to get involved with YPT this fall? Join us for an information evening on Thursday, September 15 at 6pm. The evening will include an overview of our programs, a tour of the theatre, and an opportunity to ask questions. Registration is required for [&hellip;]&lt;/p&gt;\\n"
