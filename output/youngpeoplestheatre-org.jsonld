    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Seussical Family Drama Workshop"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Seussical Family Drama Workshop Join us on Sunday, November 20th for a pre-show drama workshop for the whole family led by Resident Artist Educator Marjie Chud. Participants will learn about the story of Seussical and work together to create new Seussical-inspired characters and worlds! The workshop fee is $2 per participant. Pre-registration is required and [&hellip;]&lt;/p&gt;\\n"
      }
    ],
