    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Baby Drama Time is a new interactive drama, movement and music class for a caregiver or parent to enjoy with the baby in their life! Expanding on YPT’s hugely successful work with theatre for babies, each term will explore a particular theme through sensory play, storytelling, and song. Meet new parents and enjoy a relaxed [&hellip;]"
      }
