        "@language": "en",
        "@value": "Community Preview &#8211; The Adventures of Pinocchio"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Community Preview - The Adventures of Pinocchio At special Community Preview evenings, we offer complimentary tickets to teachers and other members of the community in order to provide them a sneak-peek at selected productions throughout the season. The evening includes a pre-show reception and a post-show question and answer period. Join us for a great night [&hellip;]&lt;/p&gt;\\n"
      }
    ],
