    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Instant Post-Show Workshop"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Instant Post-Show Workshop Grade 8-12 1PM - 3PM Throughout the season, YPT offers hour-long pre- and post-show Companion Workshops in connection with our productions, in which students engage with the specific themes and ideas of a particular show while developing specialized drama skills. This pre-show workshop is focused on YPT\\'s presentation of Instant. Instant Written by [&hellip;]&lt;/p&gt;\\n"
      }
    ],
