    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Family Shelter Program"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Family Shelter Program YPT’s Family Shelter Program is a weekly drama-based program for children (aged 6 to 11) living at a City of Toronto shelter with their mothers. Delivered by a YPT Resident Artist Educator, this program uses facilitated play and drama activities to explore the themes of self-esteem, confidence building and positive self-expression."
      }
    ],
