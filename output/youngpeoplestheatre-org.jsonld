    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Munschtime! Member School Workshop Throughout the season, YPT offers hour-long pre- and post-show Companion Workshops in connection with our productions, in which students engage with the specific themes and ideas of a particular show while developing specialized drama skills. YPT’s pre- and post-show workshops in April and May are focused on its presentation of Munschtime!. Munschtime! [&hellip;]&lt;/p&gt;\\n"
      }
