    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Boys With Cars &#8211; A Forum"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Boys With Cars - A Forum Join us Wednesday, March 8, 2017 6PM to 8PM Young People’s Theatre (165 Front Street East) ON THE MAINSTAGE MAR 23-APR 1, 2017 RECOMMENDED FOR GRADES 8 TO 12 | AGES 13 &amp; UP Boys With Cars explores issues around unchecked male privilege, female empowerment and what constitutes consent – [&hellip;]&lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
