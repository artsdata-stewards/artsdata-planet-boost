    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Session #1 Cultural Gym: Building Story Through Improv with Herbie Barnes Cultural Gym is an opportunity for both children and adults to exercise their creative muscles. Come challenge yourself in new ways and be part of an artistic community! These fun, fast-paced sessions will use ensemble-based exercises focusing on the creation and development of new characters [&hellip;]"
      },
