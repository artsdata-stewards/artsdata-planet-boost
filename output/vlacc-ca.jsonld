  {
    "@id": "https://vlacc.ca/events/folil-trafun-joining-roots-festival/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
