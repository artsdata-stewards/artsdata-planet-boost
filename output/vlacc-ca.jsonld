  {
    "@id": "https://vlacc.ca/events/latin-american-short-stories-reading-group-june/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Latin American Short Stories Reading Group - June - VLACC"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Join us on Tuesday, June 11 at 6:30 pm, in the Conference Room of Britannia Community Centre (1661 Napier St) for a discussion on the stories \"Guatemala,\" \"Now That I Recall,\" and \"Treasure\" by the Guatemalan author Miguel Ángel Asturias as we commemorate the 50th anniversary of his death."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://vlacc.ca/events/latin-american-short-stories-reading-group-june/"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en-us",
        "@value": "VLACC"
      }
    ],
    "article:modified_time": [
