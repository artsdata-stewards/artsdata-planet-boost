  {
    "@id": "https://vlacc.ca/events/open-doors-to-art-exhibition-visit-with-yaimel-lopez-at-the-bag/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
