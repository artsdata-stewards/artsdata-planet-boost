  {
    "@id": "https://vlacc.ca/events/explore-latin-american-culture-spring-break-camp/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "SOLD OUT - Explore Latin American Culture - Spring Break Camp - VLACC"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "For kids with age at least 6 years but less than 10 years. In partnership with the Britannia Community Centre and Words in Motion Spanish Language, we're excited to present a Latin American-inspired Spring Break Camp from March 18th to 22nd. During the week, participants will explore music, language, arts & crafts, dance, and food in a variety of activities. Also we will have a few guest artists. There will be time for outdoor fun and making friends. Please pack a lunch, nut-free snacks, and bring a water bottle. Dress for the weather with hat and sunscreen."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://vlacc.ca/events/explore-latin-american-culture-spring-break-camp/"
      }
    ],
