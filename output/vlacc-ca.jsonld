    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Re:Location Season 2 Online Premiere - Episode 1 with Andy Alvarez - VLACC"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Re:Location Season 2 profiles five talented Latin American artists as they navigate the complexities of their careers while staying connected to their cultural roots. Each short documentary offers an intimate look at their challenges and triumphs, reflecting on how their experiences in Canada have shaped their artistic identities.We will release a new documentary monthly on our YouTube channel. This season features five mid-career Latin American artists, sharing their journeys, challenges, and strengths."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
