        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Latin American Short Stories Reading Group - March - VLACC"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Join us on Tuesday, March 14 at 6:30 pm, at the Conference Room (1661 Napier St, Vancouver) for a discussion on the stories \"Woman Hollering Creek\" (1991) by Chicana author Sandra Cisneros (1954- ) and \"Back to the Land\" (2014) by Mexican author Laia Jufresa (1983- ). Professor Tamara Mitchell will facilitate the discussion."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://vlacc.ca/events/latin-american-short-stories-reading-group-march/"
