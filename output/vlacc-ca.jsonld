  {
    "@id": "https://vlacc.ca/events/kairos-blanket-excercise-with-hubert-barton-and-catalina-parra/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
