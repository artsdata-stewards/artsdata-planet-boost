        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Let's Hear It For Yaletown - Latin American Tunes - VLACC"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Attention all Latin music lovers! VLACC is thrilled to curate three days of music for Let's Hear It For Yaletown, featuring lots of FREE music and dance powered by local talents. Join us at the events, brought together by the Yaletown Business Improvement Association and supported by the Yaletown Brewing Company, and discover many fabulous artists in our community! You can also learn to dance to Latin rhythms during intermissions for FREE. Stay cool in Yaletown this summer with some hot music that will get your feet moving and your body grooving!"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://vlacc.ca/events/lets-hear-it-for-yaletown-latin-american-tunes/"
      }
    ],
