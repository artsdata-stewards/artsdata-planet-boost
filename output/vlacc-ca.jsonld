    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "VLACC is pleased to present a reading group open to anyone interested in short stories written by Latin American authors.Join us on Tuesday, April 9 at 6:30 pm, in the Conference Room (1661 Napier St) for a discussion on the stories \"Continuity of Parks\" and \"Axolotl\" by the Argentine author Julio Cortázar as we commemorate the 40th anniversary of his death."
      }
    ],
