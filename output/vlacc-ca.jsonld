    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Join us online on Tuesday, April 15th for a unique exhibition visit with Salvadorian artist Osvaldo Ramirez. His work will be exhibited in the same space as Francisco Goya in the Vancouver Art Gallery! This session is part of our ongoing series \"Open Doors to Art.\""
      }
