  {
    "@id": "https://vlacc.ca/events/new-spanish-cinema-memories-of-my-father-screening/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
