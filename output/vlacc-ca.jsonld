        "@language": "en",
        "@value": "Latin American Short Stories Reading Group with Alessandra Santos - VLACC"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "This gathering, in the style of a book club, offers a welcoming space for thoughtful discussion, collective reflection, and connection through literature. No prior knowledge of Latin American literature is required."
      }
    ],
