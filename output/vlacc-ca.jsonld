    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "\"Día de Muertos\" | Interdisciplinary Embodiment Workshop - VLACC"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Join us for \"Día de Muertos\" | Interdisciplinary Embodiment Workshop, a unique celebration of Mexican culture and a heartfelt tribute to our departed loved ones. Guided by the talented facilitators Carla Alcántara and Marco Esccer, this event invites you to engage in the art of crafting as we create an Altar de Muertos, a powerful symbol of remembrance and connection."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://vlacc.ca/events/dia-de-muertos-interdisciplinary-embodiment-workshop/"
      }
    ],
