  {
    "@id": "https://vlacc.ca/events/nepantla-magia-ancestral-studio-showing-with-salome-nieto-and-julio-medi/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
