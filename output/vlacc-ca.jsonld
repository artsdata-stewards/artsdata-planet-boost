    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Art Talk - Resistencias: Music, Art, and Politics in Latin America - VLACC"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "During the sixties and seventies, many Latin American countries faced one of the darkest periods in their recorded history. Military dictatorships in Argentina, Brazil, and Chile –to name only a few– targeted the youth as a potential threat to their imposing goals. This was a context of global revolutions, activism, and confrontations that, albeit the harsh levels of oppression, managed to subtly use art without any boundaries, integrating the visual, the written, and the auditive."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "en",
        "@value": "en-US"
      }
    ]
  },
