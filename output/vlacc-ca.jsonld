        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "\"Samba Experience\" | Dance workshop with Carine Fortunato - VLACC"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Embark on an exhilarating journey into the heart of Samba with the guidance of Carine Fortunato, the visionary director of Samba Fusion on Saturday, November 18 at 6:00 p.m. at the Britannia Community Centre. With pulsating rhythms and rich cultural fusion of the foundational steps of \"samba no pé,\" immerse yourself in the vibrant history and significance of this Afro-Brazilian dance that arose from the spirited favelas of Brazil."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://vlacc.ca/events/samba-experience-dance-workshop-with-carine-fortunato/"
