        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Folil Trafün (Joining Roots) Festival - Connecting Through Indigenous Films from Latin America - VLACC"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Folil trafün (Joining roots) is a showcase of Indigenous and Afro-diaspora films from Latin America (with English subtitles), followed by dialogues to deepen understanding of the films and their relationship with local realities. We will also provide culturally relevant food, from the ʷməθkʷəy̓əm Nation to share. The showcase will launch with  two-hybrid (online and in-person) screenings at the UBC Campus."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://vlacc.ca/events/folil-trafun-joining-roots-festival/"
      }
