    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Novalima and Empanadas Ilegales"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "From Lima, Peru, Novalima fuses traditional Afro-Peruvian rhythms with electronic, dub, reggae, salsa, and global beats. With six acclaimed albums, a Latin Grammy nomination and multiple performances at top festivals worldwide, Novalima has become a pioneer in modern Afro-Peruvian music. Their music bridges cultural and generational gaps, uniting audiences through infectious rhythms and a deep [&hellip;]"
      },
      {
