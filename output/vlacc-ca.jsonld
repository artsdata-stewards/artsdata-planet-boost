        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "New Spanish Cinema: 'Memories of My Father' Screening - VLACC"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Directed by award-winning Spanish filmmaker Fernando Trueba, 'Memories of My Father' is based on the memoir by Héctor Abad Faciolince ('Forgotten We’ll Be'), recounting his relationship with his father, the Colombian medical practitioner, professor, and human rights activist Héctor Abad Gómez.His activist journey underscores an unwavering commitment to what he deems the five basic human rights: air, water, food, shelter, and affection, making him a revered figure on the streets of Medellín, Colombia."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://vlacc.ca/events/new-spanish-cinema-memories-of-my-father-screening/"
      }
    ],
