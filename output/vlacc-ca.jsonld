    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Settlers (Los Colonos): Film Screening - VLACC"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "On the year we commemorate the 50th anniversary of the Chilean military coup, we joined VIFF to bring you a recent Chilean movie, The Settlers (los Colonos). In 1893, Segundo, a Chilean mestizo; MacLennan, an English army captain; and Bill, an American mercenary, embark on an expedition on horseback to delimit and reclaim the lands that the State has granted to José Menéndez. What appears to be an administrative expedition turns into a violent hunt for Onas, the natives of the Tierra del Fuego archipelago."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "en",
        "@value": "en-US"
      }
    ]
  },
