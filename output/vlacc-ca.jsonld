  {
    "@id": "https://vlacc.ca/events/im-still-here-ainda-estou-aqui-film-screening/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
