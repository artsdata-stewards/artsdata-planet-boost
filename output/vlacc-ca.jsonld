    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Latin American Reading Group | Latin Expressions Special Edition - VLACC"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Join us on Wednesday, October 16, at 6:30 pm at the SFU Vancouver Campus - Belzberg Library as we dive into the poems \"Meeting with my father in the orchard,\" \"Meeting with my mother in the old kitchen,\" \"The ghost of a dog,\" \"Like a dog,\"  and \"I always dream of a place that is some other place,\" by the renowned Mexican writer Homero Aridjis. The discussion will be led by George McWhirter and Carmen Rodríguez, who will guide us through the intricate themes and cultural insights of Aridjis’s work."
      }
    ],
