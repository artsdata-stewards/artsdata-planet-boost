    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Join us on Tuesday, November 12, from 6:30 to 8:00 pm at the Britannia Community Centre’s Conference Room for a lively discussion of Woman on the Riverbank and Frogs (2019) from the book Songs for the Flames by Juan Gabriel Vásquez. The session will be facilitated by Professor Pilar Riaño-Alcalá."
      }
