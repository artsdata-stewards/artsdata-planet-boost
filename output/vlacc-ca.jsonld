    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Misplacement, impermanence, a constant need for intercultural dialogue, and a longing for belonging. These are some conditions immigrating artists experience while in transit in so-called &#8220;Canada&#8221;. Join interdisciplinary artists Faune Ybarra [&hellip;]"
      }
    ],
