        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Verano de Colores II [IN SPANISH] - VLACC"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Join us on Saturday, August 19, from 11:00 am to 12:30 pm at Victoria Park (1425 Victoria Dr., Vancouver) to celebrate Spanish lenguage.Ana Lorena Pérez (Ecuador) y Maria Helena Morales (Colombia), along with their special guest, Rocío Quevedo (México), will be facilitating a series of traditional games, handcrafts, a puppet show and movement activities. These activities will include traditional Latin American music for kids."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://vlacc.ca/events/verano-de-colores-2/"
