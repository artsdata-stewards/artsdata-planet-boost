  {
    "@id": "https://vlacc.ca/events/verao-de-cores-brasileiras-in-portuguese/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Verão de Cores Brasileiras - In Portuguese - VLACC"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Join us for a fantastic summer event brought to you by VLACC, perfect for kids who want to connect with Brazilian culture. Come and have fun with your family at Verão de Cores Brasileiras, featuring three amazing workshops! Create your own Abayomi doll, listen to enchanting stories, participate in traditional Brazilian games, and learn unique Capoeira moves. Bring your mat and chair, and get ready for a day full of culture and fun! This event will be presented in Portuguese.Kids up to 10 years old will be grouped by age and rotate through the activities to ensure everyone enjoys each workshop to the fullest. This is a FREE event, and each child needs their own ticket. If a family member plans to join with 2 kids, please make sure to get 2 tickets. There is no need to register adults; just make sure each child has a ticket. Please send your child's name and age in advance to: thaisbouez@gmail.com."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://vlacc.ca/events/verao-de-cores-brasileiras-in-portuguese/"
      }
    ],
