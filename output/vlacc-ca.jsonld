        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Mural Walking Tour - Latin American Edition - VLACC"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "A special mural tour created by the Vancouver Mural Festival. Please join VMF's Co-founder Adrian Sinclair for an in-person mural tour in the Mount Pleasant neighbourhood, which now features over 100 murals. The tour starts with a cup of Latin American coffee, and the route is specially designed to highlight murals by artists of Mexican heritage. Hear about the behind-the-scenes stories and the meanings behind the artwork, and learn about the world of mural making."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://vlacc.ca/events/mural-walking-tour-latin-american-edition/"
      }
    ],
