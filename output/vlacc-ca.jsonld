  {
    "@id": "https://vlacc.ca/events/lets-hear-it-for-yaletown-latin-american-tunes/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
