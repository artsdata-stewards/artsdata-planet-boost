      {
        "@language": "en-us",
        "@value": "Latin American Short Stories Reading Group - November - VLACC"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Join us on Tuesday, November 14 at 6:30 pm, at the Conference Room (1661 Napier St, Vancouver) for a discussion on the stories \"The Mystery of Survival\" by Alicia Gaspar de Alba (1993) and \"Mouthful of Birds\" (2009) by Samantha Schweblin. Facilitated by Professor Tamara Mitchell."
      }
    ],
