        "@language": "en-us",
        "@value": "Sounds of Cuba: An Evening of Hot Cuban Music with Miguelito Valdés - VLACC"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Let's raise the roof of the York Theatre in a program of exciting music from Cuba, with local talent led by Miguelito Valdés, known from Omara Portuondo and Buena Vista Social Club projects."
      }
    ],
