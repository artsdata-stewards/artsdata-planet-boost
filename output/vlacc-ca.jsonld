  {
    "@id": "https://vlacc.ca/events/mural-walking-tour-latin-american-edition/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
