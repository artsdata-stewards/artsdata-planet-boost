    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Re:Location Season 2 Premiere - VLACC"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Join us for the Premiere of Re:Location Season 2. You are invited to an exclusive screening of Re:Location Season 2, followed by a Q&A with the featured artists and directors. This new season continues the journey begun in 2023, showcasing the vibrant and evolving presence of Latin American culture in Canada through the eyes of five mid-career artists."
      }
    ],
