    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Celebrating international authors and discovering writers from different cultures is one of the many highlights of the Festival, and this year we delve into works from Latin American writers. Each offers fascinating, heady insight into the lives of women."
      }
    ],
