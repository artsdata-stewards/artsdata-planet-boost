    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Learn the foundations of traditional Cuban dances, Mambo, Cha cha chá, and Conga in this first series of six workshops. Afro-Cuban dancer and instructor Yula Vostretsova, will provide an inclusive and relaxing environment to explore movement while having fun."
      }
