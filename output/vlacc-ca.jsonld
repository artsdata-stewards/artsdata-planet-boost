  {
    "@id": "https://vlacc.ca/events/tertulia-corrido-and-narcocorrido-unique-mexican-musical-styles/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
