        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Tertulia “Corrido and narcocorrido: Unique Mexican musical styles.\" - VLACC"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "This talk approaches the \"corrido\" as a unique Mexican musical genre: what is the origin of \"corridos\"?, why and when were \"corridos\" first sung? Also, we`ll talk about this musical genre evolution, themes, and how it morphed into a new sub-genre: the so-called \"narcocorrido\" –which deals with drug cartel issues."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://vlacc.ca/events/tertulia-corrido-and-narcocorrido-unique-mexican-musical-styles/"
      }
    ],
