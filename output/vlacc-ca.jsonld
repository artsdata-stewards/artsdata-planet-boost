    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Join us for Folil Trafün (Joining Roots) festival showcases! Folil Trafün channels the power of films and dialogue to discuss themes of Indigenous Contested Lands and Rights of Nature. The showcases will explore how film and photography can advance the truth, reconciliation, and decolonization process within UBC and other communities."
      }
