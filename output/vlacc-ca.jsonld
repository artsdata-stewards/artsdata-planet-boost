    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Latin American Short Stories Reading Group - December - VLACC"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Join us on Tuesday, December 12 at 6:30 pm, at the Conference Room (1661 Napier St, Vancouver) for a discussion on the seven short stories by Luís Fernando Veríssimo: \"The cockroach\" (1994), \"The return\" (1990), \"The apocalyptic hen\" (1990), \"English detective story\" (1990), \"Metaphysics\" (1990), \"Really good\" (1991), and \"ABC\" (1990). Facilitated by Professor Alessandra Santos."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://vlacc.ca/events/latin-american-short-stories-reading-group-december/"
