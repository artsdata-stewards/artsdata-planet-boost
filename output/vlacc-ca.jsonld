    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Vessels: A Visual Journey Through Latin America’s Open Veins | Screening and Talkback - VLACC"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Join us for a powerful evening of art, memory, and conversation as we present the Vancouver premiere of Vessels, an animated short film by Cuban artist Yaimel López, with music composition and sound design by Alexandre Klinke."
      }
    ],
