        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Kairos Blanket Exercise with Hubert Barton and Catalina Parra - VLACC"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "VLACC is thrilled to bring back our series, “Indigenous Experiences in Canada and Latin America – Working Towards Reconciliation” with the Kairos Blanket Exercise. Join us on Saturday, Sept 21, at 3:30 pm, at SFU. Dive into a unique, hands-on experience that uses Indigenous ways of learning to explore the history we share as Indigenous and non-Indigenous people in Canada. From the days before contact through the making of treaties, the challenges of colonization, and the spirit of resistance, you’ll get to walk through it all—literally!"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://vlacc.ca/events/kairos-blanket-excercise-with-hubert-barton-and-catalina-parra/"
      }
    ],
